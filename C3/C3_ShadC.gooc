#gool ShadC 29 1

#include "..\\Includes\\goolstdlib.gooc"
//gooc -c 3 -r pal "C3\C3_ShadC.gooc" "C3\Out\C3_ShadC.nsentry"
//gooc -c 3 -r pal -h "Includes\C3_ShadC.gooh" "C3\C3_ShadC.gooc" "C3\Out\C3_ShadC.nsentry"

#anim SHADOW       [Sha0V] [Sha0G] 01 0 2
#anim SHADOW_NIGHT [1004I] [1003I] 10 0 2

#fraganim WILLY_VIDO [Cr30T] 2
#frag 0x141414 0 1 4 0 0 64 256 64 -200 -200 200 200
#frag 0x141414 0 1 4 0 0 64 256 64 -210 -210 210 210

#iflev 6
#fraganim BOSS_VIDO [Tin1T] 2
#frag 0x141414 0 1 3 7 0 64 1 1 -200 -200 200 200
#frag 0x141414 0 1 3 7 0 64 1 1 -210 -210 210 210
#eliflev 3
#fraganim BOSS_VIDO [Din3T] 2
#frag 0x141414 0 1 3 7 0 64 1 1 -200 -200 200 200
#frag 0x141414 0 1 3 7 0 64 1 1 -210 -210 210 210
#eliflev 3
#fraganim BOSS_VIDO [Ntr1T] 2
#frag 0x141414 0 1 3 7 0 64 1 1 -200 -200 200 200
#frag 0x141414 0 1 3 7 0 64 1 1 -210 -210 210 210
#eliflev 7
#fraganim BOSS_VIDO [Neo2T] 2
#frag 0x141414 0 1 3 7 0 64 1 1 -200 -200 200 200
#frag 0x141414 0 1 3 7 0 64 1 1 -210 -210 210 210
#else
#fraganim BOSS_VIDO [1008I] 2
#frag 0x141414 0 1 3 7 0 64 1 1 -200 -200 200 200
#frag 0x141414 0 1 3 7 0 64 1 1 -210 -210 210 210
#endif

#spawn S_SHADOW                   ShadowInit
#spawn S_SHADOW_STATIONARY        ShadowStationary
#spawn S_2                        __s_2
#spawn S_SHADOW_GROUND            ShadowStationaryGround
#spawn S_SHADOW_NIGHT             ShadowInit
#spawn S_ANIMATED_SHADOW_GROUND   ShadowStationaryGround
#spawn S_SHADOW_ZONE              Shadow_Zone
#spawn S_WILLY_VIDO               Shadow_VIDO
#spawn S_BOSS_VIDO                Shadow_VIDO
#spawn S_WILLY_VIDO_GROUND        Shadow_VIDO
#spawn S_BOSS_VIDO_GROUND         Shadow_VIDO

var mem1, mem2, mem3, mem4, mem5, mem6, mem7, mem8, mem9
var mem10, mem11, mem12, mem13, mem14, mem15, mem16, mem17, mem18
var mem19, mem20, mem21, mem22, mem23, ShadowLastY, ShadowBaseY, ShadowScale, ShadowZMod
var mem28, ShadowMaxScale, ShadowMinY, ShadowAnim

state ShadowInit {
    stateflag 0x1
    statusc 0x2
    code(hdif, scale, zdif) {
        ShadowZMod = zdif
        SetScale(scale)
        ShadowMaxScale = scale
        SetRot(0deg)
        parent -> field_60 = 0
        groundy = hdif
        ShadowMinY = -0x7FFFFFFF
        statusb = 0x400 | FLAG_HAS_SHADOW
        changestate(Shadow)

    }
}

state Shadow {
    stateflag 0x1
    statusc 0x2
    trans => sub ShadowTransDefault
    code() {
        if (spawn == S_SHADOW_NIGHT) {
            setanim(SHADOW_NIGHT)
        }
        else {
            setanim(SHADOW)
        }
        do {
            field_60 = 0
            if (parent -> scalex < 0S) {
                playframe_m(field_60)
            }
            else {
                playframe_nm(field_60)
            }
        } while (1)
    }
}

sub ShadowTransDefault() __trans {
    zindex = parent -> zindex + ShadowZMod
    ShadowLastY = y
    statusb &= ~FLAG_INVISIBLE
    x = parent -> x
    z = parent -> z
    y = parent -> y + groundy
    projectobjshadow(null)
    projectzoneshadow(null)
    field_61 = eventaccepted
    if (eventaccepted && (parent -> statusb & FLAG_HAS_SHADOW) &&
        !(parent -> statusa & 0x800000) && !(parent -> statusb & FLAG_INVISIBLE)) {
        if (abs(ShadowLastY - vecy) > 0.5m) {
            y = vecy
        }
        else {
            y = seek(ShadowLastY, vecy, 0.1m)
        }
        parent -> field_63 = y
    }
    else {
        parent -> field_63 = -0x7FFFFFFF
        statusb |= FLAG_INVISIBLE
    }
    if (((field_61 & 0x3F0) >> 4) == 4) {
        parent -> statusa &= ~0x800000
    }
    if (parent -> statusa & FLAG_GROUNDLAND) {
        y = parent -> y
    }
    x = parent -> x
    z = parent -> z
    roty = parent -> roty
    scaley = ShadowMaxScale - (abs(y - parent -> y) >> 8)
    if (scaley < 0.5S) {
        scaley = 0.5S
    }
    scalez = scaley
    scalex = scaley
}

state ShadowStationary {
    stateflag 0x1
    statusc 0x2
    event => sub ShadowEventStationary
    trans => sub ShadowTransStationary
    code(hdif, scale, zdif) {
        if (spawn == S_SHADOW_NIGHT || spawn == S_ANIMATED_SHADOW_GROUND) {
            setanim(SHADOW_NIGHT)
        }
        else {
            setanim(SHADOW)
        }
        ShadowBaseY = hdif
        parent -> field_60 = 0
        ShadowScale = scale
        ShadowZMod = zdif
        do {
            ShadowPlayFrame()
        } while (1)
    }
}

sub ShadowEventStationary(e, a) {
    if (e == Event21) {
        accev()
        ShadowBaseY = a[0]
    }
    accevcstate(Kill, e == Event12)
    if (e == EventDespawn) {
        accev()
        ClearVIDOShadowLinks(0)
    }
}

sub ShadowTransStationary() __trans {
    nofirst {
        zindex = parent -> zindex + ShadowZMod
        x = parent -> x
        y = parent -> y + ShadowBaseY
        z = parent -> z
        rotx = degseek(0deg, parent -> rotx, 300deg)
        roty = parent -> roty
        rotz = parent -> rotz
        scalex = (parent -> scalex * ShadowScale) >> 12
        scaley = (parent -> scaley * ShadowScale) >> 12
        scalez = (parent -> scalez * ShadowScale) >> 12
        if (parent -> statusb & FLAG_HAS_SHADOW) {
            statusb = 0
        }
        else {
            statusb = FLAG_INVISIBLE
        }
    }
}

state Shadow_Zone {
    stateflag 0x1
    statusc 0x2
    code() {
        statusb = 0x400 | FLAG_HAS_SHADOW
        do {
            CopyParentTrans()
            projectzoneshadow(null)
            playnull()
        } while (1)
    }
}

state ShadowStationaryGround {
    stateflag 0x1
    statusc 0x2
    code => state ShadowStationary
    event => sub ShadowEventStationary
    trans => sub ShadowTransStationaryGround
}

sub ShadowTransStationaryGround() __trans {
    nofirst {
        zindex = parent -> zindex + ShadowZMod
        x = parent -> x
        y = ShadowBaseY
        z = parent -> z
        rotx = degseek(0deg, parent -> rotx, 300deg)
        roty = parent -> roty
        rotz = parent -> rotz
        scalex = (parent -> scalex * ShadowScale) >> 12
        scaley = (parent -> scaley * ShadowScale) >> 12
        scalez = (parent -> scalez * ShadowScale) >> 12
    }
}

state Shadow_VIDO {
    stateflag 0x1
    statusc 0x2
    code(hdif, scale, zdif) {
        ShadowZMod = zdif
        SetScale(scale)
        ShadowMaxScale = scale
        parent -> field_60 = 0
        groundy = hdif
        ShadowMinY = -0x7FFFFFFF
        statusb = 0x400 | FLAG_HAS_SHADOW
        if (spawn == S_WILLY_VIDO || spawn == S_WILLY_VIDO_GROUND) {
            GLOBAL_115 = self
            ShadowAnim = getanim(WILLY_VIDO)
        }
        else {
            GLOBAL_186 = self
            ShadowAnim = getanim(BOSS_VIDO)
        }
        if (spawn == S_WILLY_VIDO_GROUND || spawn == S_BOSS_VIDO_GROUND) {
            ShadowBaseY = hdif
            ShadowScale = scale
            settrans(ShadowTransStationaryGround)
            ShadowTransStationaryGround()
            setevent(ShadowEventStationary)
        }
        else {
            settrans(ShadowTransDefault)
            ShadowTransDefault()
        }
        do {
            if (parent -> animseq) {
                rotx = 90deg
                roty = parent -> roty
                rotz = roty
                vfx = (vfx & 0xFFFFFF00) | 0x3
                if (modb > 0x999) {
                    modb = 0x999
                }
                animseq = ShadowAnim
                playframe(0)
            }
            else {
                playnull()
            }
        } while (1)
    }
}

sub ClearVIDOShadowLinks(a) {
    if (self == GLOBAL_115) {
        GLOBAL_115 = 0
    }
    if (self == GLOBAL_186) {
        GLOBAL_186 = 0
    }
}

state Kill {
    stateflag 0x20
    statusc 0x0
    code => sub ClearVIDOShadowLinks
}
