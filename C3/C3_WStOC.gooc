        }
        else if (icon == 2) {
            setanim(ICON_DINGO)
        }
        else if (icon == 3) {
            setanim(ICON_NTRO)
        }
        else if (icon == 4) {
            setanim(ICON_NGIN)
        }
        else {
            setanim(ICON_CORTEX_1)
        }
        sleepframe(0)
    }
}

state Kill { // 15
    stateflag 0x20
    statusc 0
    code() {}
}

