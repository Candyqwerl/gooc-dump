        }
        sleepframe(0)
    }
}

sub FollowBackgroundPanel() { // S-1305
    x = creator -> x
    y = creator -> y
    x += PanelOffsetX
    y += PanelOffsetY
}

state Reward_Icon { // 12
    stateflag 0x1
    statusc 0
    event => state TimeTrial_Panel
    code(px, py, boss, level) {
        SetTrans(px, py, 0)
        zindex = 0x66
        SetVFX2D()
        SetScale(0x28D, 0x40E, 0x1000)
        if (var icon = boss; icon == 1) {
            setanim(ICON_TINY)
            y += 9.0
        }
        else if (icon == 2) {
            setanim(ICON_DINGO)
            y += 2.0
        }
        else if (icon == 3) {
            setanim(ICON_NTRO)
            y += 9.0
        }
        else if (icon == 4) {
            setanim(ICON_NGIN)
            y += 1.0
            x -= 3.0
        }
        else if (icon == 5) {
            setanim(ICON_CORTEX_1)
        }
        else if (icon == 6) {
            setanim(ICON_CORTEX_2)
        }
        else if (level == LEVEL_MakinWaves || level == LEVEL_TellNoTales || level == LEVEL_SkiCrazed || level == LEVEL_OrientExpress || level == LEVEL_MidnightRun || level == LEVEL_ByeByeBlimps) {
            setanim(ICON_COCO)
            y -= 4.0
        }
        else {
            setanim(ICON_CRASH)
            x -= 2.0
            y -= 7.0
        }
        PanelOffsetX = x - creator -> x
        PanelOffsetY = y - creator -> y
        settrans(FollowRewardPanel)
        sleepframe(0)
    }
}

sub FollowRewardPanel() { // S-1393
    x = creator -> x
    y = creator -> y
    x += PanelOffsetX
    y += PanelOffsetY
}

state Reward_Panel { // 13
    stateflag 0x1
    statusc 0
    code(px, py, boss, level, linked) {
        SetTrans(px, py, 0)
        RewardBoss = boss
        RewardLevel = level
        CollectedRewards = linked
        PreviousX = x
        PreviousY = y
        SetVFX2D()
        zindex = 0x60
        CrystalIcon = 0
        FirstGemIcon = 0
        SecondGemIcon = 0
        RelicIcon = 0
        CrystalTransfer = 0
        FirstGemTransfer = 0
        SecondGemTransfer = 0
        RelicTransfer = 0
        spawn(WStOC, S_BACKGROUND, 1, x, y, 0x706, 0x243)
        spawn(WStOC, S_REWARD_ICON, 1, x - 0x3C00, y, RewardBoss, level)
        SetColor2(0xE07, -0x3E3, 0x6A2)
        CheckItemPool(level >> 8, SAVEDCRYSTALPOOL1, SAVEDCRYSTALPOOL2)
        if (misc) {
            if (!RewardBoss) {
                spawn2(DispC, DispC_S_INVENTORY, 1, ID_CRYSTAL + level, x - 18.0, y, 32)
                CrystalIcon = objectspawned
            }
        }
        else {
            if (RewardBoss && !(level == LEVEL_EggipusRex || level == LEVEL_Area51 || level == LEVEL_HotCoco || level == LEVEL_SkiCrazed || level == LEVEL_RingsOfPower)) {
                spawn2(DispC, DispC_S_INVENTORY, 1, ID_CRYSTAL + level, x - 18.0, y, 32)
                CrystalIcon = objectspawned
            }
        }
        {
            var icon, upper, lower, gem, first, second
            CollectedGemCount = 0
            var0 = level
            GetGemID()
            icon = misc
            if (icon) {
                gem = icon - ID_GEM
                CheckItemPool(gem >> 8, SAVEDGEMPOOL1, SAVEDGEMPOOL2)
                if (misc) {
                    CollectedGemCount += 1
                    if (!RewardBoss) {
                        second = 1
                    }
                }
                else if (RewardBoss) {
                    second = 1
                }
            }
            CheckItemPool(level >> 8, SAVEDGEMPOOL1, SAVEDGEMPOOL2)
            if (misc) {
                CollectedGemCount += 1
                if (!RewardBoss) {
                    first = 1
                }
            }
            else if (RewardBoss) {
                first = 1
            }
            upper = 0
            lower = 0
            if (first && second) {
                lower = -0xBDA
                upper = 0x97B
            }
            SetColor2(0xE56, 0x3E3, 0x5EF)
            if (first) {
                spawn2(DispC, DispC_S_INVENTORY, 1, ID_GEM + level, x + 22.0, y + upper, 32)
                FirstGemIcon = objectspawned
            }
            if (second) {
                spawn2(DispC, DispC_S_INVENTORY, 1, icon, x + 22.0, y + lower, 32)
                SecondGemIcon = objectspawned
            }
        }
        var0 = 0
        CheckItemPool(level >> 8, GLOBAL_175, GLOBAL_176)
        if (misc) { var0 += 1 } 
        CheckItemPool(level >> 8, GLOBAL_177, GLOBAL_178)
        if (misc) { var0 += 2 }
        SetColor2(0xD4E, 0, 0x8E4)
        if (var0) {
            if (!RewardBoss) {
                if (var relic = var0; relic == 1) {
                    spawn2(DispC, DispC_S_INVENTORY, 1, ID_RELIC_SAPP + level, x + 66.0, y, 32)
                    RelicIcon = objectspawned
                }
                else if (relic == 2) {
                    spawn2(DispC, DispC_S_INVENTORY, 1, ID_RELIC_GOLD + level, x + 66.0, y, 32)
                    RelicIcon = objectspawned
                }
                else {
                    spawn2(DispC, DispC_S_INVENTORY, 1, ID_RELIC_PLAT + level, x + 66.0, y, 32)
                    RelicIcon = objectspawned
                }
            }
        }
        else if (RewardBoss) {
            spawn2(DispC, DispC_S_INVENTORY, 1, ID_RELIC_SAPP + level, x + 66.0, y, 32)
            RelicIcon = objectspawned
        }
        settrans(UpdateRewardPanel)
        sleepnull()
    }
    event(e, a) {
        accevcstate(Kill, e == Event1 && interrupter != self)
        accevif (e == Event14) {
            if (var reward = a[0]; reward >= 399.0) {
                if (reward == ID_RELIC_GOLD + RewardLevel || reward == ID_RELIC_PLAT + RewardLevel) {
                    if (RelicIcon) {
                        collider = RelicIcon
                        save (x, y, z) {
                            x = collider -> x
                            y = collider -> y
                            z = collider -> z
                            spawn(9, 52, 2, collider -> colr1 >> 1, collider -> colg1 >> 1, collider -> colb1 >> 1, 1.0, 0x666)
                            sendevent(Event1, collider)
                            RelicIcon = 0
                        }
                    }
                    if (CollectedRewards) {
                        collider = CollectedRewards
                        sendevent(Event82, collider, reward)
                    }
                }
                else if (RelicIcon) {
                    collider = RelicIcon
                    if (collider -> stalltime == reward) {
                        RelicTransfer = reward
                    }
                }
                if (reward == ID_RELIC_SAPP + RewardLevel) {
                    sendevent(Event83, parent, 2)
                }
                else if (reward == ID_RELIC_GOLD + RewardLevel) {
                    sendevent(Event83, parent, 3)
                }
                else {
                    sendeventif(Event83, parent, reward == ID_RELIC_PLAT + RewardLevel, 0)
                }
            }
            else if (reward >= ID_GEM) {
                if (FirstGemIcon) {
                    collider = FirstGemIcon
                    if (collider -> stalltime == reward) {
                        FirstGemTransfer = reward
                        if (CollectedRewards) {
                            collider = CollectedRewards
                            sendevent(Event81, collider)
                        }
                    }
                }
                if (SecondGemIcon) {
                    collider = SecondGemIcon
                    if (collider -> stalltime == reward) {
                        SecondGemTransfer = reward
                        if (CollectedRewards) {
                            collider = CollectedRewards
                            sendevent(Event81, collider)
                        }
                    }
                }
            }
            else if (reward >= ID_CRYSTAL) {
                if (CrystalIcon) {
                    collider = CrystalIcon
                    if (collider -> stalltime == reward) {
                        CrystalTransfer = reward
                    }
                }
            }
        }
        accevif (e == Event81) {
            CollectedGemCount += 1
            FirstGemTransfer = 1
            SecondGemTransfer = 1
        }
        accevif (e == Event82) {
            if (RelicIcon) {
                collider = RelicIcon
                sendevent(Event1, collider)
            }
            SetColor2(0xD4E, 0x000, 0x8E4)
            spawn2(DispC, DispC_S_INVENTORY, 1, a[0], x + 66.0, y, 48)
            RelicIcon = objectspawned
        }
    }
}

sub UpdateRewardPanel() { // S-2161
    if (CrystalTransfer || RelicTransfer || FirstGemTransfer || SecondGemTransfer || x != PreviousX || y != PreviousY) {
        PreviousX = x
        PreviousY = y
        if (CrystalIcon) {
            interrupter = CrystalIcon
            if (CrystalTransfer) {
                interrupter -> x = x - 18.0
                interrupter -> y = seek(interrupter -> y, y - 0x3684, -0x45C)
            }
            else {
                interrupter -> x = x - 18.0
                interrupter -> y = y
            }
        }
        if (RelicIcon) {
            interrupter = RelicIcon
            if (RelicTransfer) {
                interrupter -> x = x + 66.0
                interrupter -> y = seek(interrupter -> y, y - 0x3684, -0x45C)
            }
            else {
                interrupter -> x = x + 66.0
                interrupter -> y = y
            }
        }
        if (FirstGemIcon || SecondGemIcon) {
            var upper, lower
            if (RewardBoss) {
                if (FirstGemTransfer) {
                    if (SecondGemTransfer) {
                        upper = -0x2D09
                        lower = -0x425E
                    }
                    else if (CollectedGemCount) {
                        upper = -0x2D09
                        lower = -0xBDA
                    }
                    else {
                        upper = -0x3684
                        lower = 0
                    }
                }
                else if (SecondGemTransfer) {
                    if (CollectedGemCount) {
                        upper = 0x97B
                        lower = -0x425E
                    }
                    else {
                        lower = -0x3684
                        upper = 0
                    }
                }
                else {
                    upper = 0
                    lower = 0
                    if (FirstGemIcon && SecondGemIcon) {
                        lower = -0xBDA
                        upper = 0x97B
                    }
                }
            }
            else {
                if (CollectedGemCount < 2) {
                    upper = 0
                    lower = 0
                }
                else {
                    upper = 0x97B
                    lower = -0xBDA
                }
            }
            if (FirstGemIcon) {
                interrupter = FirstGemIcon
                interrupter -> x = x + 22.0
                interrupter -> y = seek(interrupter -> y, y + upper, -0x45C)
            }
            if (SecondGemIcon) {
                interrupter = SecondGemIcon
                interrupter -> x = x + 22.0
                interrupter -> y = seek(interrupter -> y, y + lower, -0x45C)
            }
        }
    }
}

state Boss_Icon { // 14
    stateflag 0x1
    statusc 0
    event => state TimeTrial_Panel
    code(px, py, boss) {
        SetTrans(px, py, 0)
        zindex = 0x66
        SetVFX2D()
