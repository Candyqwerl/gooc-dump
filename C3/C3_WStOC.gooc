state Relic_Requirement_Panel { // 5
    stateflag 0x1
    statusc 0
    event => state TimeTrial_Panel
    code(px, py, boss, level) {
        DisplayLevel = level
        SetTrans(px, py, 0)
        SetVFX2D()
        zindex = 96
        spawn(WStOC, S_BACKGROUND, 1, x, y, 0x706, 0x522)
        {
            var frame
            SetTextLanguage(frame, 42.0, 43.0, 44.0, 45.0, 46.0)
            spawn(WStOC, S_TEXT, 1, x - 1.0, y + 38.0, frame, 0, 1, 0, 0, 0)
            SetTextLanguage(frame, 47.0, 48.0, 49.0, 50.0, 51.0)
            spawn(WStOC, S_TEXT, 1, x - 1.0, y - 22.0, frame, 0, 1, 0, 0, 0)
        }
        if (var l = level; l == LEVEL_SkiCrazed) {
            SetVec(5, 0, 0)
        }
        else if (l == LEVEL_HangEmHigh) {
            SetVec(10, 0, 0)
        }
        else if (l == LEVEL_Area51) {
            SetVec(15, 0, 0)
        }
        else if (l == LEVEL_FutureFrenzy) {
            SetVec(20, 0, 0)
        }
        else if (l == LEVEL_RingsOfPower) {
            SetVec(25, 0, 0)
        }
        else if (l == LEVEL_HotCoco) {
            SetVec(0, 0, 0)
        }
        else {
            SetVec(0, 0, 0)
        }
        spawn(WStOC, S_RELIC_COUNT, 1, level, vecx, x - 1.0, y + 16.0)
        sleepnull()
    }
}

state Relic_Count_Text { // 6
    stateflag 0x10001
    statusc 0
    event => state TimeTrial_Panel
    code(level, count, px, py) {
        SetVFX2D()
        statusb = FLAG_STRING_CENTER
        zindex = 102
        SetRot(0deg)
        SetTrans(px, py, 0)
        TextDefaultScale()
        TextDefaultColor()
        PanelOffsetX = x - creator -> x
        PanelOffsetY = y - creator -> y
        spawn2(DispC, DispC_S_INVENTORY, 1, ID_RELIC_SAPP + level, x + 0x1400, y - 16.0, 0x20)
        RelicIcon = objectspawned
        spawn(WStOC, S_TEXT, 1, x - 4.0, y - 8.0, 0x3400, -1, 1, count, 0, 0)
        settrans(UpdateRelicRequirementPos)
        sleepnull()
    }
}

sub UpdateRelicRequirementPos() { // S-920
    x = creator -> x
    y = creator -> y
    x += PanelOffsetX
    y += PanelOffsetY
    interrupter = RelicIcon
    interrupter -> x = x + 0x1400
    interrupter -> y = y - 16.0
}

state Display_Text { // 7
    stateflag 0x1
    statusc 0
    event => state TimeTrial_Panel
    code(px, py, frame, align, follow, first, second, third) {
        SetTrans(px, py, 0)
        TextDefaultScale()
        TextDefaultColor()
        zindex = 235
        SetVFX2D()
        setanim(TEXT)
        if (!align) {
            statusb |= FLAG_STRING_CENTER
        }
        else if (align < 0) {
            statusb |= 0x200000
        }
        if (follow) {
            PanelOffsetX = x - creator -> x
            PanelOffsetY = y - creator -> y
            settrans(FollowTextPanel)
        }
        do (var v1, v2, v3) {
            v3 = first
            v2 = second
            v1 = third
            playframe(frame)
        } while (1)
    }
}

sub FollowTextPanel() { // S986
    x = creator -> x
    y = creator -> y
    x += PanelOffsetX
    y += PanelOffsetY
}

state Record_Time { // 8
    stateflag 0x10001
    statusc 0
    event => state TimeTrial_Panel
    code(level, rank, px, py) {
        SetVFX2D()
        statusb = FLAG_STRING_CENTER
        TextDefaultColor()
        zindex = 235
        SetRot(0deg)
        SetTrans(px, py, 0)
        TextDefaultScale()
        PanelOffsetX = x - creator -> x
        PanelOffsetY = y - creator -> y
        settrans(FollowRecordPanel)
        var ticks, name0, name1, v6
        getrank(level + rank, ticks, name0, name1)
        v6 = 0
        if ((!ticks || !name0) && rank < 3) {
            if (var place = rank; place == 0) {
                name0 = 0x545331
            }
            else if (place == 1) {
                name0 = 0x444E32
            }
            else if (place == 2) {
                name0 = 0x445233
            }
        }
        if (ticks > 0x464F && rank < 3) {
            ticks = 0x464F
        }
        do {
            if (rank == 3) {
                if (time(50) < 25) {
                    var high = (name0 >> 24) & 0xFF
                    var next = (name0 >> 16) & 0xFF
                    setanim(TEXT)
                    playframe(53.0)
                }
                else {
                    var p = name1
                    var s = (ticks / 25) % 60
                    var m = ticks / 1500
                    var n = name0 & 0xFFFF
                    setanim(TEXT)
                    playframe(54.0)
                    
                }
            }
            else {
                var c = (ticks % 25) * 100 / 25
                var s = (ticks / 25) % 60
                var m = ticks / 1500
                var n = &name0
                setanim(TEXT)
                playframe(55.0)
            }
        } while (1)
    }
}

sub FollowRecordPanel() { // S-1094
    x = creator -> x
    y = creator -> y
    x += PanelOffsetX
    y += PanelOffsetY
}

state TargetTime_Init { // 9
    stateflag 0x10001
    statusc 0
    event => state TimeTrial_Panel
    code(level, relic, px, py) {
        DisplayLevel = level
        TargetRelic = relic
        SetVFX2D()
        statusb = FLAG_STRING_CENTER
        zindex = 235
        SetRot(0deg)
        SetTrans(px, py, 0)
        TextDefaultScale()
        PanelOffsetX = x - creator -> x
        PanelOffsetY = y - creator -> y
        RelicIcon = 0
        changestate(TargetTime_Show)
    }
}

state TargetTime_Show { // 10
    stateflag 0x10001
    statusc 0
    code() {
        if (TargetRelic == 3 && !(GLOBAL_150 & 0x200000)) {
            TargetRelic = 0
        }
        if (!TargetRelic) {
            RelicIcon = 0
            sleepnull()
        }
        GetTargetTime(DisplayLevel)
        var target
        if (var relic = TargetRelic; relic == 1) {
            SetColor1(0x00, 0xA5, 0xFF)
            SetColor2(0x00, 0xA5, 0xFF)
            SetColor3(0x00, 0xA5, 0xFF)
            SetColor4(0x00, 0xA5, 0xFF)
            target = SapphireTarget
            spawn2(DispC, DispC_S_INVENTORY, 1, ID_RELIC_SAPP + DisplayLevel, x - 0x3A00, y - 8.0, 8)
            RelicIcon = objectspawned
        }
        else if (relic == 2) {
            SetColor1(0xD8, 0xD2, 0x09)
            SetColor2(0xD8, 0xD2, 0x09)
            SetColor3(0xD8, 0xD2, 0x09)
            SetColor4(0xD8, 0xD2, 0x09)
            target = GoldTarget
            spawn2(DispC, DispC_S_INVENTORY, 1, ID_RELIC_GOLD + DisplayLevel, x - 0x3A00, y - 8.0, 8)
            RelicIcon = objectspawned
        }
        else {
            SetColor1(0xFF, 0xED, 0xE9)
            SetColor2(0xFF, 0xED, 0xE9)
            SetColor3(0xFF, 0xED, 0xE9)
            SetColor4(0xFF, 0xED, 0xE9)
            target = PlatinumTarget
            spawn2(DispC, DispC_S_INVENTORY, 1, ID_RELIC_PLAT + DisplayLevel, x - 0x3A00, y - 8.0, 8)
            RelicIcon = objectspawned
        }
        settrans(UpdateTargetTimePos)
        do {
            var c = (target % 25) * 100 / 25
            var s = (target / 25) % 60
            var m = target / 1500
            setanim(TEXT)
            playframe(56.0)
        } while (1)
    }
    event(e, a) {
        accevcstate(Kill, e == Event1 && interrupter != self)
        accevif (e == Event83) {
            if (RelicIcon) {
                collider = RelicIcon
                save (x, y, z) {
                    x = collider -> x
                    y = collider -> y
                    z = collider -> z
                    spawn(9, 52, 2, collider -> colr1 >> 1, collider -> colg1 >> 1, collider -> colb1 >> 1, 1.0, 0x666)
                    sendevent(Event1, collider)
                    RelicIcon = 0
                }
            }
            TargetRelic = a[0]
            accevcstate(TargetTime_Show)
        }
    }
}

sub UpdateTargetTimePos() { // S-1262
    x = creator -> x 
    y = creator -> y
    x += PanelOffsetX
    y += PanelOffsetY
    interrupter = RelicIcon
    if (interrupter) {
        interrupter -> x = x - 0x3A00
        interrupter -> y = y - 8.0
    }
}

