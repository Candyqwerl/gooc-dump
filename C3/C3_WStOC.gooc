state Display_Init { // 0
    stateflag 0x1
    statusc 0
    code(boss) {
        BossIndex = boss
        changestate(Display_Wait)
    }
}

sub GetLevelName() {
    misc = 0
    if (misc == LEVEL_WarpRoom)       misc = 1.0;
    if (misc == LEVEL_ToadVillage)    misc = 2.0;
    if (misc == LEVEL_UnderPressure)  misc = 3.0;
    if (misc == LEVEL_OrientExpress)  misc = 4.0;
    if (misc == LEVEL_BoneYard)       misc = 5.0;
    if (misc == LEVEL_MakinWaves)     misc = 6.0;
    if (misc == LEVEL_GeeWiz)         misc = 7.0;
    if (misc == LEVEL_HangEmHigh)     misc = 8.0;
    if (misc == LEVEL_HogRide)        misc = 9.0;
    if (misc == LEVEL_TombTime)       misc = 11.0;
    if (misc == LEVEL_MidnightRun)    misc = 12.0;
    if (misc == LEVEL_DinoMight)      misc = 13.0;
    if (misc == LEVEL_DeepTrouble)    misc = 14.0;
    if (misc == LEVEL_HighTime)       misc = 15.0;
    if (misc == LEVEL_RoadCrash)      misc = 16.0;
    if (misc == LEVEL_DoubleHeader)   misc = 17.0;
    if (misc == LEVEL_Sphynxinator)   misc = 18.0;
    if (misc == LEVEL_ByeByeBlimps)   misc = 19.0;
    if (misc == LEVEL_TellNoTales)    misc = 20.0;
    if (misc == LEVEL_FutureFrenzy)   misc = 21.0;
    if (misc == LEVEL_TombWader)      misc = 22.0;
    if (misc == LEVEL_GoneTomorrow)   misc = 23.0;
    if (misc == LEVEL_OrangeAsphalt)  misc = 24.0;
    if (misc == LEVEL_FlamingPassion) misc = 25.0;
    if (misc == LEVEL_MadBombers)     misc = 26.0;
    if (misc == LEVEL_BugLite)        misc = 27.0;
    if (misc == LEVEL_SkiCrazed)      misc = 28.0;
    if (misc == LEVEL_Area51)         misc = 29.0;
    if (misc == LEVEL_RingsOfPower)   misc = 30.0;
    if (misc == LEVEL_HotCoco)        misc = 31.0;
    if (misc == LEVEL_EggipusRex)     misc = 32.0;
    if (misc == LEVEL_BossTiny)       misc = 33.0;
    if (misc == LEVEL_BossDingodile)  misc = 34.0;
    if (misc == LEVEL_BossNTropy)     misc = 35.0;
    if (misc == LEVEL_BossNGin2)      misc = 36.0;
    if (misc == LEVEL_BossCortex2)    misc = 37.0;
}

sub GetGemID() {
    misc = 0
    if (v0 == LEVEL_BoneYard)         misc = 301.0;
    if (v0 == LEVEL_HangEmHigh)       misc = 302.0;
    if (v0 == LEVEL_TombTime)         misc = 303.0;
    if (v0 == LEVEL_DinoMight)        misc = 304.0;
    if (v0 == LEVEL_DeepTrouble)      misc = 305.0;
    if (v0 == LEVEL_HighTime)         misc = 306.0;
    if (v0 == LEVEL_Sphynxinator)     misc = 307.0;
    if (v0 == LEVEL_FutureFrenzy)     misc = 308.0;
    if (v0 == LEVEL_TombWader)        misc = 309.0;
    if (v0 == LEVEL_GoneTomorrow)     misc = 310.0;
    if (v0 == LEVEL_FlamingPassion)   misc = 311.0;
    if (v0 == LEVEL_BugLite)          misc = 312.0;
    if (v0 == LEVEL_Area51)           misc = 313.0;
    if (v0 == LEVEL_RingsOfPower)     misc = 314.0;
}

state Display_Wait { // 1
    stateflag 0x1
    statusc 0
    code() {
        cascadeevent(Event1, self)
        sleepnull()
    }
    event(e, a) {
        accevif (e == Event78) {
            DisplayLevel = a[0]
            RequestedLevel = DisplayLevel
        }
        accevcstate(Display_Show, e == Event78 && DisplayLevel)
    }
}

state Display_Show { // 2
    stateflag 0x1
    statusc 0
    code() {
        cascadeevent(Event1, self)
        playnull()
        if (DisplayLevel == LEVEL_BossCortex2 || DisplayLevel == LEVEL_BossNGin2 || DisplayLevel == LEVEL_BossNTropy || DisplayLevel == LEVEL_BossDingodile || DisplayLevel == LEVEL_BossTiny) {
            IsBossLevel = 1
        }
        else {
            IsBossLevel = 0
        }
        var0 = DisplayLevel
        GetLevelName()
        UpperElement = 0
        CollectedPanel = 0
        RightPanel = 0
        spawn(WStOC, S_TEXT, 1, 0, 0x9A12, misc, 0, 0, 0, 0, 0)
        TitleText = objectspawned
        if (IsBossLevel) {
            spawn(WStOC, S_BOSS_ICON, 1, 192.0, 0x9A12, BossIndex)
            UpperElement = objectspawned
        }
        else {
            spawn(WStOC, S_REWARDS, 1, -368.0, 0x1097, 0, DisplayLevel, 0)
            CollectedPanel = objectspawned
            spawn(WStOC, S_REWARDS, 1, -368.0, 0x471C, BossIndex, DisplayLevel, CollectedPanel)
            UpperElement = objectspawned
            var locked, relics, bit
            if (GLOBAL_119 & 0x200) {
                bit = 63
                while (bit >= 0) {
                    CheckItemPool(bit, GLOBAL_175, GLOBAL_176)
                    if (!misc) {
                        CheckItemPool(bit, GLOBAL_177, GLOBAL_178)
                    }
                    if (misc) {
                        relics += 1
                    }
                    bit -= 1
                }
                if (var level = DisplayLevel; level == LEVEL_SkiCrazed) {
                    SetVec(5, 0, 0)
                }
                else if (level == LEVEL_HangEmHigh) {
                    SetVec(10, 0, 0)
                }
                else if (level == LEVEL_Area51) {
                    SetVec(15, 0, 0)
                }
                else if (level == LEVEL_FutureFrenzy) {
                    SetVec(20, 0, 0)
                }
                else if (level == LEVEL_RingsOfPower) {
                    SetVec(25, 0, 0)
                }
                else if (level == LEVEL_HotCoco) {
                    SetVec(0, 0, 0)
                }
                else {
                    SetVec(0, 0, 0)
                }
                if (relics < vecx) {
                    locked = 1
                }
            }
            if (locked) {
                spawn(WStOC, S_RELIC_REQUIREMENT, 1, 368.0, 0x2BDA, BossIndex, DisplayLevel)
                RightPanel = objectspawned
            }
            else {
                CheckItemPool(DisplayLevel >> 8, SAVEDCRYSTALPOOL1, SAVEDCRYSTALPOOL2)
                if (misc || (GLOBAL_119 & 0x200)) {
                    spawn(WStOC, S_TIME_TRIAL, 1, 368.0, 0x2BDA, BossIndex, DisplayLevel)
                    RightPanel = objectspawned
                }
            }
        }
        settrans(DisplayTrans)
        setevent(DisplayEvent)
        sleepnull()
    }
    event(e, a) {
        accevif (e == Event78) {
            RequestedLevel = a[0]
        }
        accevif (e == Event83) {
            cascadeevent(Event83, self, a[0])
        }
    }
}

sub DisplayEvent(e, a) { // S-351
    if (e == Event78) {
        accev()
        RequestedLevel = a[0]
    }
    if (e == Event14) {
        accev()
        if (UpperElement && !IsBossLevel) {
            collider = UpperElement
            sendevent(Event14, collider, a[0])
        }
    }
    if (e == Event83) {
        accev()
        cascadeevent(Event83, self, a[0])
    }
}

sub DisplayTrans() { // S-372
    interrupter = TitleText
    interrupter -> y = seek(interrupter -> y, 0x7425, spd(0x97b4))
    if (IsBossLevel) {
        interrupter = UpperElement
        interrupter -> y = seek(interrupter -> y, 0x5555, spd(0x112F6))
    }
    else {
        if (RightPanel) {
            interrupter = RightPanel
            interrupter -> x = seek(interrupter -> x, 160.0, spd(832.0))
        }
        interrupter = UpperElement
        interrupter -> x = seek(interrupter -> x, -160.0, spd(832.0))
        interrupter = CollectedPanel
        interrupter -> x = seek(interrupter -> x, -160.0, spd(832.0))
    }
    if (distance(player, DIST_NO_Y) >= 8.89m, !(player -> stateflag & 0x2000)) {
        RequestedLevel = 0
    }
    changestateifn(Display_Hide, DisplayLevel == RequestedLevel)
}

state Display_Hide { // 3
    stateflag 0x1
    statusc 0
    code() {
        sleepnull()
    }
    event(e, a) {
        accevif (e == Event78) {
            RequestedLevel = a[0]
        }
    }
    trans {
        if (IsBossLevel) {
            interrupter = UpperElement
            interrupter -> y = seek(interrupter -> y, 0x9A12, spd(0x112F6))
        }
        else {
            if (RightPanel) {
                interrupter = RightPanel
                interrupter -> x = seek(interrupter -> x, 368.0, spd(832.0))
            }
            interrupter = UpperElement
            interrupter -> x = seek(interrupter -> x, -368.0, spd(832.0))
            interrupter = CollectedPanel
            interrupter -> x = seek(interrupter -> x, -368.0, spd(832.0))
        }
        interrupter = TitleText
        interrupter -> y = seek(interrupter -> y, 0x9A12, spd(0x97B4))
        if (interrupter -> y == 0x9A12) {
            DisplayLevel = RequestedLevel
            if (DisplayLevel) {
                changestate(Display_Show)
            }
            else {
                changestate(Display_Wait)
            }
        }
    }
}

inline sub SetTextLanguage(frame, de, es, it, fr, en) {
    if (var lang = GLOBAL_151; lang == LANG_DE) {
        frame = de
    }
    else if (lang == LANG_ES) {
        frame = es
    }
    else if (lang == LANG_IT) {
        frame = it
    }
    else if (lang == LANG_FR) {
        frame = fr
    }
    else {
        frame = en
    }
}

state TimeTrial_Panel { // 4
    stateflag 0x1
    statusc 0
    code(px, py, boss, level) {
        DisplayLevel = level
        SetTrans(px, py, 0)
        SetVFX2D()
        zindex = 96
        {
            var relic
            CheckItemPool(level >> 8, GLOBAL_175, GLOBAL_176)
            if (misc) { relic += 1 }
            CheckItemPool(level >> 8, GLOBAL_177, GLOBAL_178)
            if (misc) { relic += 2 }
            {
                var frame
                SetTextLanguage(frame, 37.0, 38.0, 39.0, 40.0, 41.0)
                spawn(WStOC, S_TEXT, 1, x - 1.0, y + 37.0, frame, 0, 1, 0, 0, 0)
            }
            if (!relic || relic == 1 || ((GLOBAL_150 & 0x200000) && relic == 2)) {
                spawn(WStOC, S_BACKGROUND, 1, x, y - 8.0, 0x706, 0x60D)
                spawn(WStOC, S_TARGET_TIME, 1, DisplayLevel, relic + 1, x - 1.0, y + 17.0)
                spawn(WStOC, S_RECORD_TIME, 1, DisplayLevel, 0, x - 1.0, y - 4.0)
                spawn(WStOC, S_RECORD_TIME, 1, DisplayLevel, 1, x - 1.0, y - 21.0)
                spawn(WStOC, S_RECORD_TIME, 1, DisplayLevel, 2, x - 1.0, y - 38.0)
            }
            else {
                spawn(WStOC, S_BACKGROUND, 1, x, y - 1.0, 0x706, 0x540)
                spawn(WStOC, S_RECORD_TIME, 1, DisplayLevel, 0, x - 1.0, y + 10.0)
                spawn(WStOC, S_RECORD_TIME, 1, DisplayLevel, 1, x - 1.0, y - 7.0)
                spawn(WStOC, S_RECORD_TIME, 1, DisplayLevel, 2, x - 1.0, y - 24.0)
            }
        }
        sleepnull()
    }
    event(e, a) {
        accevcstate(Kill, e == Event1 && interrupter != self)
    }
}

