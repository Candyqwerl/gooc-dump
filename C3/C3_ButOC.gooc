state Button_Init { // 0
    stateflag 0x4004281
    statusc 0x0
    code(level, obj, arg, yaw) {
        TargetLevel = level
        WarpEffectOBJ = obj
        ButtonVar4 = arg
        roty = yaw
        playnull()
        playnull()
        if (spawn == S_BUTTON_L1) {
            ButtonNumber = 1
            AppearAnim = getanim(BUTTON_L1_APPEAR)
            PressAnim = getanim(BUTTON_L1_PRESS)
            DisappearAnim = getanim(BUTTON_L1_DISAPPEAR)
            PressedAnim = getanim(BUTTON_L1_PRESSED)
        }
        else if (spawn == S_BUTTON_L2) {
            ButtonNumber = 2
