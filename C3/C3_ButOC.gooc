            PressAnim = getanim(BUTTON_S4_PRESS)
            DisappearAnim = getanim(BUTTON_S4_DISAPPEAR)
            PressedAnim = getanim(BUTTON_S4_PRESSED)
        }
        else if (spawn == S_BUTTON_S5) {
            ButtonNumber = 30
            AppearAnim = getanim(BUTTON_S5_APPEAR)
            PressAnim = getanim(BUTTON_S5_PRESS)
            DisappearAnim = getanim(BUTTON_S5_DISAPPEAR)
            PressedAnim = getanim(BUTTON_S5_PRESSED)
        }
        else if (spawn == S_BUTTON_S6) {
            ButtonNumber = 36
            AppearAnim = getanim(BUTTON_S6_APPEAR)
            PressAnim = getanim(BUTTON_S6_PRESS)
            DisappearAnim = getanim(BUTTON_S6_DISAPPEAR)
            PressedAnim = getanim(BUTTON_S6_PRESSED)
        }
        if (!GLOBAL_170) {
            if (0x1000000 & GLOBAL_150) {
                GLOBAL_170 = 1
            }
            else if (((GLOBAL_175 | (GLOBAL_177 | (GLOBAL_179 | GLOBAL_181))) \ -0x400) &&
                (((GLOBAL_176 | (GLOBAL_178 | (GLOBAL_180 | GLOBAL_182))) \ 63) &&
                    (((SAVEDGEMPOOL1 | GEMPOOL1) \ -2) &&
                        ((SAVEDGEMPOOL2 | GEMPOOL2) \ 0x7C00003F)))) {
                            GLOBAL_170 = 2
                            GLOBAL_150 |= 0x1000000
                        }
            else {
                GLOBAL_170 = 1
            }
        }
        if (GLOBAL_170 == 2 && ButtonNumber != 35) {
            KillEntity()
            changestate(Kill)
        }
        if (ButtonNumber >= 31) {
            WarpRoomNumber = ButtonNumber - 30
        }
        else {
            WarpRoomNumber = ((ButtonNumber - 1) / 5) + 1
        }
        {
            var required, crystals, table, defeated, visited, offset, low, high
            required = WarpRoomNumber * 5
            low = SAVEDCRYSTALPOOL1 | CRYSTALPOOL1
            high = SAVEDCRYSTALPOOL2 | CRYSTALPOOL2
            misc = 0
            CountPoolBits(low)
            CountPoolBits(high)
            crystals = misc
            if (crystals > required || (WarpRoomNumber == 6 && (1 & GLOBAL_150))) {
                table = AllButtonPositions[0]
            }
            else {
                table = LevelButtonPositions[0]
                if (required == crystals) {
                    if (var room = WarpRoomNumber; room == 1) {
                        if (0x40 & GLOBAL_27) {
                            defeated = 1
                        }
                        if (0x10000 & GLOBAL_150) {
                            visited = 1
                        }
                    }
                    else if (room == 2) {
                        if (0x8 & GLOBAL_27) {
                            defeated = 1
                        }
                        if (0x20000 & GLOBAL_150) {
                            visited = 1
                        }
                    }
                    else if (room == 3) {
                        if (0x10 & GLOBAL_27) {
                            defeated = 1
                        }
                        if (0x40000 & GLOBAL_150) {
                            visited = 1
                        }
                    }
                    else if (room == 4) {
                        if (0x20 & GLOBAL_27) {
                            defeated = 1
                        }
                        if (0x80000 & GLOBAL_150) {
                            visited = 1
                        }
                    }
                    else if (room == 5) {
                        if (0x80 & GLOBAL_27) {
                            defeated = 1
                        }
                        if (0x100000 & GLOBAL_150) {
                            visited = 1
                        }
                    }
                    if (defeated || visited) {
                        table = AllButtonPositions[0]
                    }
                    else {
                        table = BossButtonPositions[0]
                    }
                }
            }
            if (GLOBAL_170 == 2) {
                table = BossButtonPositions[0]
            }
            offset = ((ButtonNumber - 1) * 3) << 8
            x = table[offset]
            y = table[offset + 1.0]
            z = table[offset + 2.0]
            unless ((x | y) | z) {
                KillEntity()
                changestate(Kill)
            }
            table = AllButtonPositions[0]
            offset = ((((WarpRoomNumber - 1) * 5) + 2) * 3) << 8
            RoomCenterX = table[offset]
            RoomCenterY = table[offset + 1.0]
            RoomCenterZ = table[offset + 2.0]
        }
        zindex = 26
        statusb = FLAG_COLLIDABLE | FLAG_SOLID_TOP | 0x400000
        SetVec(RoomCenterX, RoomCenterY, RoomCenterZ)
        var0 = distance(vecx, player, DIST_NO_Y)
        if (var0 >= 10.5m) {
            changestate(Button_Hidden)
        }
        else {
            changestate(Button_Appear)
        }
    }
}

sub CalculateCompletionPercent() { // S-518
    var completed, clear, sapphire, gold, platinum
    var bits0 = SAVEDCRYSTALPOOL1
    var bits1 = SAVEDCRYSTALPOOL2
    misc = 0
    CountPoolBits(GLOBAL_27)
    CountPoolBits(GLOBAL_28)
    completed = misc
    misc = 0
    CountPoolBits(bits0)
    CountPoolBits(bits1)
    vecy = misc
    bits0 = SAVEDGEMPOOL1
    bits1 = SAVEDGEMPOOL2
    misc = 0
    CountPoolBits(bits0)
    CountPoolBits(bits1)
    vecx = misc
    bits1 &= 0x7C000000
    misc = 0
    CountPoolBits(bits1)
    clear = vecx - misc
    misc = 0
    CountPoolBits(GLOBAL_150 & 0xFFFF)
    vecz = misc
    sapphire = 0
    gold = 0
    platinum = 0
    bits0 = GLOBAL_175
    bits1 = GLOBAL_177
    CountRelics(bits1, bits0, platinum, gold, sapphire)
    bits0 = GLOBAL_176
    bits1 = GLOBAL_178
    CountRelics(bits1, bits0, platinum, gold, sapphire)
    var0 = vecy + (vecx + (vecz + (platinum + (gold + sapphire))))
    if (GLOBAL_27 & 0x40) {
        var0 += 1
    }
    if (GLOBAL_27 & 0x8) {
        var0 += 1
    }
    if (GLOBAL_27 & 0x10) {
        var0 += 1
    }
    if (GLOBAL_27 & 0x20) {
        var0 += 1
    }
    if (GLOBAL_27 & 0x80) {
        var0 += 1
    }
    bits0 = GLOBAL_175 | GLOBAL_177
    bits1 = GLOBAL_176 | GLOBAL_178
    if (!(bits0 \ -0x400 && bits1 \ 63 && SAVEDGEMPOOL1 \ -2 && SAVEDGEMPOOL2 \ 0x7C00003F)) {
        if (var0 > 99) {
            var0 = 99
        }
    }
}

state Button_Appear { // 1
    stateflag 0x4004281
    statusc 0x0
    code() {
        if (ButtonNumber >= 31) {
            var0 = 0
        }
        else {
            var0 = (ButtonNumber - 1) % 5
        }
        if (var0 == 0) {
            playnull(8)
        }
        else if (var0 == 1) {
            playnull(4)
        }
        else if (var0 == 2) {
            playnull(0)
        }
        else if (var0 == 3) {
            playnull(2)
        }
        else if (var0 == 4) {
            playnull(6)
        }
        else if (var0 == 5) {
            playnull(10)
        }
        animseq = AppearAnim
        playframes(0.0, 15.0)
        changestate(Button_Idle)
    }
}

state Button_Disappear { // 2
    stateflag 0x4004281
    statusc 0x0
    code() {
        if (ButtonNumber >= 31) {
            var0 = 0
        }
        else {
            var0 = (ButtonNumber - 1) % 5
        }
        if (var0 == 0) {
            playframe(animframe, 4)
        }
        else if (var0 == 1) {
            playframe(animframe, 2)
        }
        else if (var0 == 2) {
            playframe(animframe, 0)
        }
        else if (var0 == 3) {
            playframe(animframe, 0)
        }
        else if (var0 == 4) {
            playframe(animframe, 2)
        }
        else if (var0 == 5) {
            playframe(animframe, 4)
        }
        animseq = DisappearAnim
        playframes(0.0, 8.0)
        changestate(Button_Hidden)
    }
}

state Button_Hidden { // 3
    stateflag 0x4004281
    statusc 0x0
    code() {
        sleepnull()
    }
    trans {
        SetVec(RoomCenterX, RoomCenterY, RoomCenterZ)
        var0 = distance(vecx, player, DIST_NO_Y)
        changestateif(Button_Appear, var0 <= 10m)
    }
}

state Button_Idle { // 4
    stateflag 0x4004281
    statusc 0x0
    code() {
        animseq = PressAnim
        sleepframe(0)
    }
    trans {
        var0 = distance(player, DIST_NO_Y)
        if (var0 <= 0.9m) {
            changestateif(Button_Press, y - 0.5m < player -> y && player -> y < y + 0.5m)
        }
        SetVec(RoomCenterX, RoomCenterY, RoomCenterZ)
        var0 = distance(vecx, player, DIST_NO_Y)
        changestateif(Button_Disappear, var0 >= 10.5m)
    }
}

