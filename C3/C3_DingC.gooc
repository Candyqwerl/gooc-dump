            sleepanim(0, WALL_SHADOW_1)
        }
        else if (temp == 1) {
            sleepanim(0, WALL_SHADOW_2)
        }
        else {
            sleepanim(0, WALL_SHADOW_3)
        }
    }
    event(e, a) {
        accevcstate(Kill, e == Event1)
    }
    trans {
        roty = creator -> roty
        var0 = (23.44 - (creator -> y >> 8) << 12) / 23.44
        var0 = sin(var0 >> 2)
