        soundplay([Di53A], 1V)
        groundy = ground
        zindex = creator -> zindex
        zindex += 9
        getvert(vtrans, creator, 0)
        vely = -((((y - groundy) * 25) / 25) - 45m)
        velx = (px - x) / 25
        velz = (pz - z) / 25
        roty = atan(px - x, pz - z)
        rotz = roty
        spawn(DingC, S_FIREBALL_LIGHT, 1, px, py, pz)
        statusb = FLAG_COLLIDABLE
        changestate(Fireball_Flying)
    }
}

state Fireball_Flying { // 36
