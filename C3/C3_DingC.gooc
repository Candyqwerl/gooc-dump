var AimAngle, FlameLength, WallBurnLength, WallEventAccepted, FlameHitPlayer, PlayerDistance, VolleyShotIndex, IceController, WallsCleared, AimOffset, 
    SavedFlags, AimLeadFrames, VolleyBaseAngle, VolleyTurn, FightDeathCount, WallSectorB, WallSegmentsLeft, IceLightX, IceLightZ, WallShadowOBJ

expr ExplosionExitTimer  = SavedFlags
expr InnerWallAngle      = IceController
expr MiddleWallAngle     = WallsCleared
expr OuterWallAngle      = AimOffset
expr InnerWallMask       = SavedFlags
expr MiddleWallMask      = AimLeadFrames
expr OuterWallMask       = VolleyBaseAngle
expr WallAngleOffset     = VolleyShotIndex
expr WallFirstLanding    = VolleyTurn
expr WallSectorA         = FightDeathCount
expr WallLayer           = field_63
expr FlameStopping       = VolleyShotIndex
expr FlameFadeAmount     = IceController
expr FlamePreviousX      = VolleyShotIndex
expr FlamePreviousY      = IceController
expr FlamePreviousZ      = WallsCleared
expr FlameOlderX         = AimOffset
expr FlameOlderY         = VolleyTurn
expr FlameOlderZ         = FightDeathCount
expr DingoSpeechOBJ      = field_62
expr ShotDeathThreshold  = var0
expr PentaCenterDistance = var0

/* Angle offset / death count limit pairs (each volley ends with 0x1869F) */
/* OG pool offs: 0x11C[0], 0x160[17], 0x1E4[50] */
array DingoVolleyShots = {
    0x000, 16,
    0x200, 16,
    0x400, 16,
    0x600, 16,
    0x800, 16,
    0xA00, 13,
    0xC00, 10,
    0xE00, 7,
    0x1869F,
    
    0x000, 16,
    -0x200, 16,
    -0x400, 16,
    -0x600, 16,
    -0x800, 16,
    -0xA00, 16,
    -0xC00, 16,
    -0xE00, 16,
    -0x100, 16,
    -0x300, 16,
    -0x500, 13,
    -0x700, 13,
    -0x900, 10,
    -0xB00, 10,
    -0xD00, 7,
    -0xF00, 7,
    0x1869F,
    
    0x000, 16,
    0x71, 16,
    0x200, 16,
    0x271, 16,
    0x400, 16,
    0x471, 16,
    0x600, 16,
    0x671, 16,
    0x800, 16,
    0x871, 16,
    0xA00, 13,
    0xA71, 13,
    0xC00, 10,
    0xC71, 10,
    0xE00, 7,
    0xE71, 7,
    0x1869F
}

state Dingo_Init { // 0
    stateflag 0x4081
    statusc 0
    code() {
        zindex = 24
        FlameLength = 0
        WallBurnLength = 0
        FlameHitPlayer = 0
        spawn(DingC, S_ICE_CONTROLLER, 1)
        IceController = objectspawned
        health = 3
        spawn(BosBC, BosBC_S_HEALTH_TICK, 1, health << 8, 3)
        GLOBAL_150 |= 0x20000
        playnull()
        FightDeathCount = SECTIONDEATHCOUNT >> 8
        if (GLOBAL_27 & 0x8) {
            FightDeathCount = 0
        }
        if (!!GLOBAL_105) {
            FightDeathCount = 0
        }
        if (FightDeathCount > 15) {
            FightDeathCount = 15
        }
        spawn(DingC, S_FLAMES, 1, 0)
        spawn(DingC, S_FLAMES, 1, 1)
        spawn(DingC, S_FLAMES, 1, 2)
        statusb = FLAG_COLLIDABLE | FLAG_SOLID_ALL
        if (!RESPAWNCOUNT) {
            changestate(Dingo_Intro)
        }
        else {
            roty = CAMROTY
            changestate(Dingo_Restart)
        }
    }
}

state Dingo_Intro { // 1
    stateflag 0x4081
    statusc 0
    code() {
        roty = 90deg
        DingoSpeechOBJ = 0
        onstateexit(DingoIntroExit)
        if (SFXVOL) {
            if (var lang = GLOBAL_151; lang == LANG_FR) {
                spawn2(9, 44, 1, [F003O], [F013O], [F023O], 3.0, 1000s, 8.0)
                DingoSpeechOBJ = objectspawned
            }
            else if (lang == LANG_DE) {
                spawn2(9, 44, 1, [G003O], [G013O], [G023O], 3.0, 1000s, 8.0)
                DingoSpeechOBJ = objectspawned
            }
            else if (lang == LANG_IT) {
                spawn2(9, 44, 1, [I003O], [I013O], [I023O], 3.0, 1000s, 8.0)
                DingoSpeechOBJ = objectspawned
            }
            else if (lang == LANG_ES) {
                spawn2(9, 44, 1, [S003O], [S013O], [S023O], 3.0, 1000s, 8.0)
                DingoSpeechOBJ = objectspawned
            }
            else {
                spawn2(9, 44, 1, [E003O], [E013O], [E023O], 3.0, 1000s, 8.0)
                DingoSpeechOBJ = objectspawned
            }
        }
        do { playanim(0, DINGO_INTRO_1) } until (frametime - statetime >= 4s)
        interrupter = DingoSpeechOBJ
        sendevent(EventTriggered, interrupter)
        DingoSpeechOBJ = 0
        do { playanim(0, DINGO_INTRO_1) } until (frametime - statetime >= 4.5s)
        playframes(DINGO_INTRO_1, 0.0, 97.0)
        setanim(DINGO_INTRO_2, -1.0)
        do {
            animframe += 1.0
            if (animframe == 48.0) {
                soundpitch(3.625)
                soundplay([fs80A], 1V)
            }
            playframe()
        } while (animframe + 1.0 <= 97.0)
        changestate(Dingo_Trigger_Walls)
    }
    event(e, a) {
        accevcstate(Dingo_Restart, e == Event67)
    }
    trans {
        nofirst {
            if (animseq == getanim(DINGO_INTRO_2) && animframe >= 34.0 && animframe <= 48.0) {
                roty = seek(roty, 180deg, 6.45deg)
            }
        }
    }
}

sub DingoIntroExit() {} // S-137

inline sub SoundDingoFootstep() {
    soundpitch(3.625)
    soundplay([fs80A], 1V)
}

state Dingo_Trigger_Walls { // 2
    stateflag 0x4081
    statusc 0
    event => state Dingo_VolleyStart
    code() {
        changestateif(Dingo_Victory, player -> stateflag & 0x20)
        setanim(DINGO_PHASE_TRANS)
        setanim(DINGO_PHASE_TRANS, -1.0)
        do {
            animframe += 1.0
            if (animframe == 24.0) {
                SoundDingoFootstep()
            }
            else if (animframe == 38.0) {
                spawn(DingC, S_GREEN_FLAME, 1)
            }
            else if (animframe == 40.0) {
                interrupter = IceController
                sendevent(Event83, interrupter)
            }
            playframe()
        } while (animframe + 1.0 <= 84.0)
        SoundDingoFootstep()
        if (var phase = health; phase == 3) {
            VolleyShotIndex = 3
        }
        else if (phase == 2) {
            VolleyShotIndex = 5
        }
        else {
            VolleyShotIndex = 7
        }
        changestate(Dingo_VolleyStart)
    }
}

state Dingo_Restart { // 3
    stateflag 0x4081
    statusc 0
    event => state Dingo_VolleyStart
    code() {
        changestateif(Dingo_Victory, player -> stateflag & 0x20)
        interrupter = IceController
        sendevent(Event84, interrupter)
        playframes(DINGO_CHANGE_MODE, 0.0, 47.0)
        playframes(DINGO_RELOAD_1, 0.0, 23.0)
        if (var phase = health; phase == 3) {
            VolleyShotIndex = 3
        }
        else if (phase == 2) {
            VolleyShotIndex = 5
        }
        else {
            VolleyShotIndex = 7
        }
        changestate(Dingo_VolleyStart)
    }
}

state Dingo_VolleyStart { // 4
    stateflag 0x4081
    statusc 0
    code() {
        playframes(DINGO_SHOOT_UP_START, 0.0, 37.0)
        VolleyShotIndex = 0
        VolleyBaseAngle = roty
        changestate(Dingo_VolleyFire)
    }
    event(e, a) {
        accevif (e == Event85) {
            WallsCleared = 1
        }
        accevcstate(Dingo_Attacked, e == EventSpinHit || e == EventJumpedOn || e == EventSlamHit || e == EventSlideHit || e == EventHitInvincible)
    }
    trans {
        once {
            WallsCleared = false
            var table
            if (var phase = health; phase == 3) {
                table = DingoVolleyShots[0]
                VolleyTurn = 75deg
                AimOffset = -90deg
            }
            else if (phase == 2) {
                table = DingoVolleyShots[17]
                VolleyTurn = 75deg
                AimOffset = 90deg
            }
            else {
                table = DingoVolleyShots[50]
                VolleyTurn = 75deg
                AimOffset = -90deg
            }
            AimAngle = table[0]
        }
        VolleyBaseAngle = atan2(player -> trans) + AimOffset
        roty = degseek(roty, VolleyBaseAngle + AimAngle, 240deg)
        changestateif(Dingo_Victory, player -> stateflag & 0x20)
    }
}

state Dingo_VolleyFire { // 5
    stateflag 0x4081
    statusc 0
    event => state Dingo_VolleyStart
    code() {
        playframes(DINGO_SHOOT_UP, 0.0, 15.0)
        sleep()
    }
    trans {
        once {
            var table, index
            if (var phase = health; phase == 3) {
                table = DingoVolleyShots[0]
            }
            else if (phase == 2) {
                table = DingoVolleyShots[17]
            }
            else {
                table = DingoVolleyShots[50]
            }
            do {
                index = (VolleyShotIndex << 1) << 8
                VolleyShotIndex += 1
                AimAngle = table[ index ]
                changestateif(Dingo_VolleyStop, AimAngle == 0x1869F)
                ShotDeathThreshold = table[index + 1.0]
                if (FightDeathCount < ShotDeathThreshold) {
                    break
                }
            } while (1)
            AimAngle += VolleyBaseAngle
        }
        changestateif(Dingo_Victory, player -> stateflag & 0x20)
        roty = degseek(roty, AimAngle, VolleyTurn)
        if (roty == AimAngle) {
            {
                var dx, dz, radius
                radius = distance(player, DIST_NO_Y | DIST_EXACT) >> 8
                dx = (radius * sin(roty)) >> 4
                dz = (radius * cos(roty)) >> 4
                spawn(DingC, S_FIREBALL, 1, dx, player -> y, dz, 0)
            }
            changestate(Dingo_VolleyFire)
        }
    }
}

state Dingo_VolleyStop { // 6
    stateflag 0x4081
    statusc 0
    event => state Dingo_VolleyStart
    code() {
        playframes(DINGO_SHOOT_UP_STOP, 0.0, 27.0)
        changestate(Dingo_SweepStart)
    }
    trans {
        changestateif(Dingo_Victory, player -> stateflag & 0x20)
    }
}

state Dingo_SweepStart { // 7
    stateflag 0x4081
    statusc 0
    event => state Dingo_VolleyStart
    code() {
        playframes(DINGO_CHANGE_MODE, 0.0, 47.0)
        changestate(Dingo_TrackPlayer)
    }
    trans { 
        once {
            if (var phase = health; phase == 3) {
                AimLeadFrames = 25
            }
            else if (phase == 2) {
                AimLeadFrames = 20
            }
            else {
                AimLeadFrames = 17
            }
        }
        changestateif(Dingo_Victory, player -> stateflag & 0x20)
    }
}

state Dingo_TrackPlayer { // 8
    stateflag 0x4081
    statusc 0
    event => state Dingo_VolleyStart
    code() {
        do {
            playframes(DINGO_STEP_1, 0.0, 13.0)
            SoundDingoFootstep()
            changestateif(Dingo_AimFirst, abs(degdist(roty, AimAngle)) <= 2)
            playframes(DINGO_STEP_2, 0.0, 12.0)
            SoundDingoFootstep()
            changestateif(Dingo_AimSecond, abs(degdist(roty, AimAngle)) <= 2)
        } while (1)
    }
    trans {
        once {
            AimOffset = 0
            field_63 = atan2(player -> trans)
        }
        changestateif(Dingo_Victory, player -> stateflag & 0x20)
        var v1, v2
        var angle, lead
        var v3, v4, v5, v6
        angle = atan2(player -> trans)
        lead = degdist(field_63, angle) * AimLeadFrames
        field_63 = angle
        AimOffset = seek(AimOffset, lead, 20)
        AimAngle = angle + AimOffset
        roty = degseek(roty, AimAngle, 100deg)
    }
}

state Dingo_AimFirst { // 9
    stateflag 0x4081
    statusc 0
    event => state Dingo_VolleyStart
    code() {
        if (var phase = health; phase == 3) {
            playframes(DINGO_AIM_1, 0.0, 13.0)
        }
        else if (phase == 2) {
            playframes(DINGO_AIM_2, 0.0, 9.0)
        }
        else {
            playanim(0, DINGO_AIM_3)
            playanim(1, DINGO_AIM_3)
            playanim(2, DINGO_AIM_3)
            playanim(3, DINGO_AIM_3)
            playanim(4, DINGO_AIM_3)
            playanim(4, DINGO_AIM_3)
            playanim(5, DINGO_AIM_3)
            playanim(6, DINGO_AIM_3)
        }
        changestate(Dingo_FireFlamethrower)
    }
    trans {
        changestateif(Dingo_Victory, player -> stateflag & 0x20)
    }
}

state Dingo_AimSecond { // 10
    stateflag 0x4081
    statusc 0
    event => state Dingo_VolleyStart
    code() {
        SoundDingoFootstep()
        if (var phase = health; phase == 3) {
            playframes(DINGO_AIM_4, 0.0, 13.0)
        }
        else if (phase == 2) {
            playframes(DINGO_AIM_5, 0.0, 9.0)
        }
        else {
            playanim(0, DINGO_AIM_6)
            playanim(1, DINGO_AIM_6)
            playanim(2, DINGO_AIM_6)
            playanim(3, DINGO_AIM_6)
            playanim(4, DINGO_AIM_6)
            playanim(4, DINGO_AIM_6)
            playanim(5, DINGO_AIM_6)
            playanim(6, DINGO_AIM_6)
        }
        changestate(Dingo_FireFlamethrower)
    }
    trans {
        changestateif(Dingo_Victory, player -> stateflag & 0x20)
    }
}

state Dingo_FireFlamethrower { // 11
    stateflag 0x4081
    statusc 0
    event => state Dingo_VolleyStart
    code() {
        playanim(0, DINGO_SHOOT_READY)
        AimAngle = roty
        spawn(DingC, S_FLAMETHROWER, 1, roty)
        playanim(0, DINGO_FLAME_SHOOT_1)
        playanim(1, DINGO_FLAME_SHOOT_1)
        playframes(DINGO_FLAME_SHOOT_3, 0.0, 17.0)
        playanim(0, DINGO_FLAME_SHOOT_2)
        playanim(1, DINGO_FLAME_SHOOT_2)
        playanim(2, DINGO_FLAME_SHOOT_2)
        playanim(2, DINGO_FLAME_SHOOT_2)
        soundpitch(3.625)
        soundplay([fs80A], 1V)
        playanim(0, DINGO_SHOOT_STOP)
        playanim(1, DINGO_SHOOT_STOP)
        playanim(2, DINGO_SHOOT_STOP)
        playanim(3, DINGO_SHOOT_STOP)
        playanim(4, DINGO_SHOOT_STOP)
        playanim(4, DINGO_SHOOT_STOP)
        playanim(5, DINGO_SHOOT_STOP)
        playanim(6, DINGO_SHOOT_STOP)
        if (player -> stateflag & 0x20) {
            playframes(DINGO_RELOAD_2, 0.0, 22.0)
            changestate(Dingo_Victory)
        }
        settrans(CheckDingoVictory)
        CheckDingoVictory()
        if (WallsCleared) {
            playframes(DINGO_RELOAD_2, 0.0, 22.0)
            changestate(Dingo_Trigger_Walls)
        }
        changestate(Dingo_TrackPlayer)
    }
    trans {
        once {
            FlameHitPlayer = 0
        }
        changestateif(Dingo_Victory, !FlameHitPlayer && player -> stateflag & 0x20)
    }
}

sub CheckDingoVictory() { // S-554
    changestateif(Dingo_Victory, player -> stateflag & 0x20)
}

state Dingo_Victory { // 12
    stateflag 0x4081
    statusc 0
    code() {
        cascadeevent(Event88, self)
        FlameLength = 0
        WallBurnLength = 0
        playframes(DINGO_WIN_1, 0.0, 9.0)
        do {
            setanim(DINGO_WIN_2, -1.0)
            do {
                animframe += 1.0
                if (animframe == 15.0 || animframe == 35.0) {
                    SoundDingoFootstep()
                }
                playframe()
            } while (animframe + 1.0 <= 37.0)
        } while (1)
    }
    trans {
        roty = spd(roty, 130deg)
    }
}

state Dingo_Attacked { // 13
    stateflag 0x4081
    statusc 0
    code() {
        statusb |= FLAG_COLLIDABLE
        SoundPitchDefault(0.295)
        sounddecay(8.4s + 1)
        soundsetup(7, self, 8)
        soundplay([Bp10A], 1V)
        if (GLOBAL_151 == 5.0) {
            if (rand(2)) {
                SoundPitchDefault(0.23)
                sounddecay(8.2s)
                soundsetup(8, self, 8)
                soundplay([1130I], 1V)
            }
            else {
                SoundPitchDefault(0.34)
                sounddecay(8.2s)
                soundsetup(8, self, 8)
                soundplay([1131I], 1V)
            }
        }
        GLOBAL_101 = 2
        GLOBAL_100 = 0xFF
        cascadeevent(Event88, self)
        FlameLength = 0
        WallBurnLength = 0
        setanim(DINGO_ATTACKED_1)
        setanim(DINGO_ATTACKED_1, -1.0)
        do {
            animframe += 1.0
            if (animframe == 13.0) {
                soundpitch(2.903)
                soundplay([fs80A], 1.2V)
                spawn(9, 21, 1, -1.0, 0, 0, 0, 4S, 0, 24, 2)
            }
            else if (animframe == 26.0) {
                soundpitch(2.903)
                soundplay([fs80A], 0.6V)
                spawn(9, 21, 1, -1.0, 0, 0, 0, 48.0, 0, 24, 2)
            }
            else if (animframe == 43.0) {
                soundpitch(0x6e4)
                soundplay([Di43A], 1.28V)
            }
            playframe()
        } while (animframe + 1.0 <= 60.0)
        setanim(DINGO_ATTACKED_2, -1.0)
        do {
            animframe += 1.0
            if (animframe == 8.0 || animframe == 29.0 || animframe == 46.0 || animframe == 57.0) {
                soundpitch(6.892)
                soundplay([Di43A], 1.28V)
            }
            playframe()
        } while (animframe + 1.0 <= 61.0)
        spawn(DingC, S_TANK_EXPLOSION, 1)
        if (GLOBAL_151 == 5.0) {
            if (rand(2)) {
                SoundPitchDefault(0.23)
                sounddecay(8.2s)
                soundsetup(8, self, 8)
                soundplay([1130I], 1V)
            }
            else {
                SoundPitchDefault(0.34)
                sounddecay(8.2s)
                soundsetup(8, self, 8)
                soundplay([1131I], 1V)
            }
        }
        playframes(DINGO_EXPLODE_1, 0.0, 11.0)
        health -= 1
        changestateif(Dingo_Defeated, health <= 0)
        interrupter = IceController
        sendevent(Event83, interrupter)
        setanim(DINGO_EXPLODE_2, -1.0)
        do {
            animframe += 1.0
            if (animframe == 14.0) {
                soundpitch(2.54)
                soundsetup(7, self, 8)
                soundplay([fs80A], 1V)
            }
            playframe()
        } while (animframe + 1.0 <= 29.0)
        setanim(DINGO_RECOVER_1, -1.0)
        do {
            animframe += 1.0
            if (animframe == 32.0) {
                soundpitch(4.715)
                soundsetup(6, self, 8)
                soundplay([HSh3A], 1V)
            }
            playframe()
        } while (animframe + 1.0 <= 35.0)
        playanim(0, DINGO_RECOVER_2)
        playanim(1, DINGO_RECOVER_2)
        playanim(2, DINGO_RECOVER_2)
        playanim(2, DINGO_RECOVER_2)
        setanim(DINGO_RECOVER_3, -1.0)
        do {
            animframe += 1.0
            if (animframe == 36.0) {
                soundpitch(2.903)
                soundplay([fs80A], 1.2V)
            }
            playframe()
        } while (animframe + 1.0 <= 41.0)
        changestate(Dingo_VolleyStart)
    }
}

state Dingo_Defeated { // 14
    stateflag 0x4004081
    statusc 0x80010
    code() {
        cascadeevent(Event89, self)
        GAMEFLAGS |= -0x80000000
        DingoSpeechOBJ = 0
        if (SFXVOL) {
            if (var lang = GLOBAL_151; lang == LANG_FR) {
                spawn2(9, 44, 1, [F103O], [F113O], [F123O], [E133O], 4.0, 1000s, 8.0)
                DingoSpeechOBJ = objectspawned
            }
            else if (lang == LANG_DE) {
                spawn2(9, 44, 1, [G103O], [G113O], [G123O], [E133O], 4.0, 1000s, 8.0)
                DingoSpeechOBJ = objectspawned
            }
            else if (lang == LANG_IT) {
                spawn2(9, 44, 1, [I103O], [I113O], [I123O], [E133O], 4.0, 1000s, 8.0)
                DingoSpeechOBJ = objectspawned
            }
            else if (lang == LANG_ES) {
                spawn2(9, 44, 1, [S103O], [S113O], [S123O], [E133O], 4.0, 1000s, 8.0)
                DingoSpeechOBJ = objectspawned
            }
            else {
                spawn2(9, 44, 1, [E103O], [E113O], [E123O], [E133O], 4.0, 1000s, 8.0)
                DingoSpeechOBJ = objectspawned
            }
        }
        playframes(DINGO_EXPLODE_3, 0.0, 13.0)
        soundpitch(2.54)
        soundsetup(7, self, 8)
        soundplay([fs80A], 1V)
        setanim(DINGO_DEFEATED_1, -1.0)
        do {
            animframe += 1.0
            if (animframe == 28.0) {
                interrupter = DingoSpeechOBJ
                sendevent(EventTriggered, interrupter)
            }
            playframe()
        } while (animframe + 1.0 <= 67.0)
        spawn(DingC, S_PENTA_RETURN, 1)
        playframes(68.0, 75.0)
        unless (player -> stateflag & 0x20) {
            if (GLOBAL_160 & 0x2) {
                field_61 = true
            }
            else {
                field_61 = false
                SavedFlags = GLOBAL_160
                save (x, y, z) {
                    {
                        var angle
                        angle = CAMROTY - 45deg
                        x = (6.25 * sin(angle)) >> 4
                        z = (6.25 * cos(angle)) >> 4
                    }
                    y = 300.0
                    spawn2(FruiC, FruiC_S_FRUIT_HOP, 1, 701.0, 0)
                }
            }
        }
        changestate(Dingo_Dead)
    }
}

state Dingo_Dead { // 15
    stateflag 0x4081
    statusc 0
    code() {
        playframes(DINGO_DEFEATED_2, 0.0, 11.0)
        sleep()
    }
    event(e, a) {
        accevcstate(Dingo_Dead, e == EventTriggered
            || e == EventJumpedOn 
            || e == EventSlamHit
            || e == EventHit 
            || e == EventFling 
            || e == EventHitInvincible 
            || e == EventSpinHit
            || e == EventSlideHit)
    }
    trans {
        unless (player -> stateflag & 0x20) {
            if (SavedFlags != GLOBAL_160 || field_61) {
                SavedFlags = GLOBAL_160
                if (field_61) {
                    var0 = 0
                }
                else {
                    var0 = 701.0
                }
                spawn2(WEfOC, WEfOC_S_WARP_OUT, 1, 5m, 0, 9.5m, 16m, 2S, var0)
                creator = objectspawned
                field_61 = 0
            }
        }
    }
}

state Tank_Explosion { // 16
    statusc 0
    code() {
        SetTrans(0, 0, 0)
        soundpitch(3.625)
        sounddecay(10s)
        soundsetup(8, self, 8)
        soundplay([tnt0A], 1V)
        ExplosionExitTimer = 0
        zindex = creator -> zindex
        SetScale(2.5S)
        if (!SHAKEY) {
            SHAKEY = 15.0
        }
        setanim(EXPLOSION_1)
        setanim(EXPLOSION_1, -1.0)
        do {

            animframe += 1.0
            if (animframe == 0) {
                broadcastevent(Event87, 0, 0)
            }
            else if (animframe == 3.0) {
                broadcastevent(Event87, 0, 1)
            }
            else if (animframe == 6.0) {
                broadcastevent(Event87, 0, 2)
            }
            else if (animframe == 7.0) {
                if (distance(player, DIST_NO_Y | DIST_EXACT) <= 6.1m) {
                    vecx = player -> x
                    vecz = player -> z
                    sendevent(Event59, player, 0x27874A, 12m, miscfunc(vecx, self, 1, 2))
                }
                else if (creator -> health) {
                    settrans(KeepPlayerOutsideExplosion)
                }
            }
            else if (animframe >= 33.0 && animframe <= 42.0) {
                moda = 16.0 * (animframe - 32.0) / 10.0
            }
            playframe()
        } while (animframe + 1.0 <= 42.0)
        sleepnull()
    }
    event(e, a) {
        accevif (e == Event89) {
            ExplosionExitTimer = 25
        }
    }
}

sub KeepPlayerOutsideExplosion() { // S-983
    if (ExplosionExitTimer) {
        ExplosionExitTimer -= 1
        changestateif(Kill, ExplosionExitTimer <= 0)
    }
    if (distance(player, DIST_NO_Y | DIST_EXACT) <= 6.1m) {
        var0 = atan2(player -> trans)
        player -> x = (0x988 * sin(var0)) >> 4
        player -> z = (0x988 * cos(var0)) >> 4
    }
}

state IceController_Init { // 17
    statusc 0
    code() {
        zindex = creator -> zindex
        zindex += 10
        SetTrans(0, 0, 0)
        InnerWallAngle = 0
        MiddleWallAngle = 0
        OuterWallAngle = 0
        IceLightX = -0xEB6
        IceLightZ = 0x172
        InnerWallMask = 0
        MiddleWallMask = 0
        OuterWallMask = 0
        changestate(IceController_Wait)
    }
}

inline sub ConstrainPlayerToArena() {
    PlayerDistance = distance(player, DIST_NO_Y | DIST_EXACT)
    if (PlayerDistance > 8.322m) {
        {
            var angle
            angle = atan2(player -> trans)
            player -> x = (13.0 * sin(angle)) >> 4
            player -> z = (13.0 * cos(angle)) >> 4
        }
        PlayerDistance = 8.322m
    }
}

state IceController_Wait { // 18
    statusc 0
    code() {
        sleepnull()
    }
    event(e, a) {
        accevcstate(IceController_DropWalls, e == Event83)
        accevcstate(IceController_CreateWalls, e == Event84)
    }
    trans {
        ConstrainPlayerToArena()
    }
}

state IceController_DropWalls { // 19
    statusc 0
    code() {
        InnerWallMask = 0xFF
        spawn(DingC, S_ICE_WALL, 1, 0, 0.0, 1, 1)
        spawn(DingC, S_ICE_WALL, 1, 0, 4.0, 1, 0)
        spawn(DingC, S_ICE_WALL, 1, 0, 8.0, 1, 0)
        spawn(DingC, S_ICE_WALL, 1, 0, 12.0, 1, 0)
        playnull(5)
        MiddleWallMask = 0xFF
        spawn(DingC, S_ICE_WALL, 1, 1, 0.0, 1, 1)
        spawn(DingC, S_ICE_WALL, 1, 1, 4.0, 1, 0)
        spawn(DingC, S_ICE_WALL, 1, 1, 8.0, 1, 0)
        spawn(DingC, S_ICE_WALL, 1, 1, 12.0, 1, 0)
        playnull(5)
        OuterWallMask = 0xFF
        spawn(DingC, S_ICE_WALL, 1, 2, 0.0, 1, 1)
        spawn(DingC, S_ICE_WALL, 1, 2, 4.0, 1, 0)
        spawn(DingC, S_ICE_WALL, 1, 2, 8.0, 1, 0)
        spawn(DingC, S_ICE_WALL, 1, 2, 12.0, 1, 0)
        changestate(IceController_Active)
    }
    trans {
        ConstrainPlayerToArena()
    }
}

state IceController_CreateWalls { // 20
    statusc 0
    code() {
        InnerWallMask = 0xFF
        spawn(DingC, S_ICE_WALL, 1, 0, 0.0, 0, 0)
        spawn(DingC, S_ICE_WALL, 1, 0, 4.0, 0, 0)
        spawn(DingC, S_ICE_WALL, 1, 0, 8.0, 0, 0)
        spawn(DingC, S_ICE_WALL, 1, 0, 12.0, 0, 0)
        MiddleWallMask = 0xFF
        spawn(DingC, S_ICE_WALL, 1, 1, 0.0, 0, 0)
        spawn(DingC, S_ICE_WALL, 1, 1, 4.0, 0, 0)
        spawn(DingC, S_ICE_WALL, 1, 1, 8.0, 0, 0)
        spawn(DingC, S_ICE_WALL, 1, 1, 12.0, 0, 0)
        OuterWallMask = 0xFF
        spawn(DingC, S_ICE_WALL, 1, 2, 0.0, 0, 0)
        spawn(DingC, S_ICE_WALL, 1, 2, 4.0, 0, 0)
        spawn(DingC, S_ICE_WALL, 1, 2, 8.0, 0, 0)
        spawn(DingC, S_ICE_WALL, 1, 2, 12.0, 0, 0)
        changestate(IceController_Active)
    }
}

state IceController_Active { // 21
    statusc 0
    code() {
        sleepnull()
    }
    event(e, a) {
        accevif (e == Event87) {
            var layer
            layer = a[0]
            if (var temp = layer; temp == 0) {
                InnerWallMask = 0
            }
            else if (temp == 1) {
                MiddleWallMask = 0
            }
            else {
                OuterWallMask = 0
            }
        }
    }
    trans {
        once {
            broadcastevent(Event89, 0)
        }
        WallBurnLength = creator -> WallBurnLength
        ConstrainPlayerToArena()
        if (!(frametime - statetime >= 2.5s) && PlayerDistance <= 6.1m) {
            var0 = atan2(player -> trans)
            player -> x = (0x988 * sin(var0)) >> 4 
            player -> z = (0x988 * cos(var0)) >> 4
        }
        InnerWallAngle = spd(InnerWallAngle, 1.0) % 360deg
        MiddleWallAngle = spd(MiddleWallAngle, -0x12A) % 360deg
        OuterWallAngle = spd(OuterWallAngle, 0x155) % 360deg
        {
            var angle
            angle = atan2(player -> trans)
            if (PlayerDistance >= 2m && PlayerDistance <= 3.4m) {
                var0 = ((angle - InnerWallAngle) % 360deg) >> 9
                if (InnerWallMask & (1 << var0)) {
                    cascadeevent(Event82, self, 0, var0)
                }
            }
            if (PlayerDistance >= 3.6m && PlayerDistance <= 4.4m) {
                var0 = ((angle - MiddleWallAngle) % 360deg) >> 9
                if (MiddleWallMask & (1 << var0)) {
                    cascadeevent(Event82, self, 1, var0)
                }
            }
            if (PlayerDistance >= 4.6m && PlayerDistance <= 6m) {
                var0 = ((angle - OuterWallAngle) % 360deg) >> 9
                if (OuterWallMask & (1 << var0)) {
                    cascadeevent(Event82, self, 2, var0)
                }
            }
        }
        {
            var angle, s, c
            angle = CAMROTY
            s = sin(angle)
            c = cos(angle)
            IceLightZ = ((0x172 * c) - (-0xEB6 * s)) >> 12
            IceLightX = ((0x172 * s) + (-0xEB6 * c)) >> 12
        }
        if (WallBurnLength) {
            AimAngle = creator -> AimAngle
            if (WallBurnLength >= 1m) {
                var0 = ((AimAngle - InnerWallAngle) % 360deg) >> 9
                if (InnerWallMask & (1 << var0)) {
                    WallEventAccepted = 0
                    cascadeevent(Event81, self, 0, var0)
                    if (WallEventAccepted) {
                        InnerWallMask ^= (1 << var0)
                    }
                }
            }
            if (WallBurnLength >= 2m) {
                var0 = ((AimAngle - MiddleWallAngle) % 360deg) >> 9
                if (MiddleWallMask & (1 << var0)) {
                    WallEventAccepted = 0
                    cascadeevent(Event81, self, 1, var0)
                    if (WallEventAccepted) {
                        MiddleWallMask ^= (1 << var0)
                    }
                }
            }
            if (WallBurnLength >= 3m) {
                var0 = ((AimAngle - OuterWallAngle) % 360deg) >> 9
                if (OuterWallMask & (1 << var0)) {
                    WallEventAccepted = 0
                    cascadeevent(Event81, self, 2, var0)
                    if (WallEventAccepted) {
                        OuterWallMask ^= (1 << var0)
                    }
                }
            }
        }
        if (!InnerWallMask && !MiddleWallMask && !OuterWallMask) {
            sendevent(Event85, creator)
            changestate(IceController_Wait)
        }
    }
}

state IceWall_Init { // 22
    statusc 0
    code(layer, angle, fall, shadow) {
        WallLayer = layer
        WallAngleOffset = angle
        WallSectorA = ((angle % 360deg) >> 10) << 1
        WallSectorB = WallSectorA - 1
        if (WallSectorB < 0) {
            WallSectorB = 7
        }
        WallSegmentsLeft = 2
        WallShadowOBJ = 0
        vfx = (vfx & 0xFFFFFF00) | 0xA
        vfx = (vfx & 0xFF00FFFF) | 0x30000
        moda = 4.0
        if (var temp = WallLayer; temp == 0) {
            SetColor1(0x80, 0x00, 0xFF)
        }
        else if (temp == 1) {
            SetColor1(0x63, 0xF0, 0x00)
        }
        else {
            SetColor1(0x0A, 0x24, 0xE6)
        }
        zindex = creator -> zindex
        if (fall) {
            y = 6000.0
            vely = 0
            WallFirstLanding = 1
            if (shadow) {
                spawn(DingC, S_ICE_SHADOW, 1, WallLayer)
                WallShadowOBJ = objectspawned
            }
            changestate(IceWall_Falling)
        }
        else {
            y = 0
            vely = 0
            changestate(IceWall_Active)
        }
    }
}

inline sub UpdateIceWallTransform() {
    IceLightX = creator -> IceLightX
    IceLightZ = creator -> IceLightZ
    SetColor2(IceLightX, 0x61F, IceLightZ)
    if (var layer = WallLayer; layer == 0) {
        InnerWallAngle = creator -> InnerWallAngle
        roty = InnerWallAngle + WallAngleOffset
    }
    else if (layer == 1) {
        MiddleWallAngle = creator -> MiddleWallAngle
        roty = MiddleWallAngle + WallAngleOffset
    }
    else {
        OuterWallAngle = creator -> OuterWallAngle
        roty = OuterWallAngle + WallAngleOffset
    }
}

sub UpdateFallingIceWall() { // S-1399
    vely = spd(vely, -35m)
    y = spd(y, vely)
    if (y <= 0) {
        if (WallFirstLanding) {
            WallFirstLanding = 0
            if (!SHAKEY) {
                SHAKEY = 4.0
            }
            if (!WallAngleOffset) {
                SoundPitchDefault(0.43)
                soundsetup(7, self, 8)
                soundplay([Di33A], 1V)
            }
        }
        else if (!WallAngleOffset) {
            SoundPitchDefault(0.34)
            soundsetup(7, self, 8)
            soundplay([Di23A], 1V)
        }
        y = 0
        vely = -vely >> 2
        if (abs(vely) < 100.0) {
            interrupter = WallShadowOBJ
            sendevent(Event1, interrupter)
            WallShadowOBJ = 0
            changestate(IceWall_Active)
        }
    }
    UpdateIceWallTransform()
}

state IceWall_Falling { // 23
    statusc 0
    trans => sub UpdateFallingIceWall
    code() {
        if (var temp = WallLayer; temp == 0) {
            InnerWallMask = creator -> InnerWallMask
            if (InnerWallMask & (1 << WallSectorA)) {
                if (InnerWallMask & (1 << WallSectorB)) {
                    sleepanim(0, WALL_INNER_1)
                }
                else {
                    sleepanim(0, WALL_INNER_3)
                }
            }
            else {
                sleepanim(0, WALL_INNER_2)
            }
        }
        else if (temp == 1) {
            MiddleWallMask = creator -> MiddleWallMask
            if (MiddleWallMask & (1 << WallSectorA)) {
                if (MiddleWallMask & (1 << WallSectorB)) {
                    sleepanim(0, WALL_MIDDLE_1)
                }
                else {
                    sleepanim(0, WALL_MIDDLE_3)
                }
            }
            else {
                sleepanim(0, WALL_MIDDLE_2)
            }
        }
        else {
            OuterWallMask = creator -> OuterWallMask
            if (OuterWallMask & (1 << WallSectorA)) {
                if (OuterWallMask & (1 << WallSectorB)) {
                    sleepanim(0, WALL_OUTER_1)
                }
                else {
                    sleepanim(0, WALL_OUTER_3)
                }
            }
            else {
                sleepanim(0, WALL_OUTER_2)
            }
        }
    }
    event(e, a) {
        if (e == Event81) {
            var layer, sector
            layer = a[0]
            sector = a[1.0]
            if (layer == WallLayer && WallSegmentsLeft > 0 && (sector == WallSectorA || sector == WallSectorB)) {
                interrupter -> WallEventAccepted = 1
                WallSegmentsLeft -= 1
                if (sector == WallSectorA) {
                    spawn(DingC, S_ICE_BREAK, 1, WallLayer, roty, 1)
                }
                else {
                    spawn(DingC, S_ICE_BREAK, 1, WallLayer, roty, 0)
                }
                if (WallSegmentsLeft) {
                    accevcstate(IceWall_Active)
                }
                else {
                    accevcstate(IceWall_Destroyed)
                }
            }
            else {
                rejevret()
            }
        }
        if (e == Event87) {
            var layer, mask
            layer = a[0]
            if (layer == WallLayer && WallSegmentsLeft > 0) {
                interrupter -> WallEventAccepted = 1
                WallSegmentsLeft = 0
                if (var temp = WallLayer; temp == 0) {
                    InnerWallMask = creator -> InnerWallMask
                    mask = InnerWallMask
                }
                else if (temp == 1) {
                    MiddleWallMask = creator -> MiddleWallMask
                    mask = MiddleWallMask
                }
                else if (temp == 2) {
                    OuterWallMask = creator -> OuterWallMask
                    mask = OuterWallMask
                }
                if (mask & (1 << WallSectorA)) {
                    spawn(DingC, S_ICE_BREAK, 1, WallLayer, roty, 1)
                }
                if (mask & (1 << WallSectorB)) {
                    spawn(DingC, S_ICE_BREAK, 1, WallLayer, roty, 0)
                }
                accevcstate(IceWall_Destroyed)
            }
            else {
                rejevret()
            }
        }
        if (e == Event82) {
            var layer, sector, radius, angle
            layer = a[0]
            sector = a[1.0]
            if (layer == WallLayer && WallSegmentsLeft > 0 && (sector == WallSectorA || sector == WallSectorB) && y <= player -> y + 1m && player -> y - y <= 3.5m) {
                zindex = creator -> zindex
                PlayerDistance = creator -> PlayerDistance
                angle = atan2(player -> trans)
                if (var temp = WallLayer; temp == 0) {
                    if (PlayerDistance > 2.7m) {
                        radius = 3.4m
                        zindex -= 6
                    }
                    else {
                        radius = 2m
                        zindex += 6
                    }
                }
                else if (temp == 1) {
                    if (PlayerDistance > 4m) {
                        radius = 4.4m
                        zindex -= 6
                    }
                    else {
                        radius = 3.6m
                        zindex += 6
                    }
                }
                else if (PlayerDistance > 5.3m) {
                    radius = 6m
                    zindex -= 1
                }
                else {
                    radius = 4.6m
                    zindex += 6
                }
                interrupter -> WallEventAccepted = 1
                player -> x = ((radius >> 8) * sin(angle)) >> 4
                player -> z = ((radius >> 8) * cos(angle)) >> 4
            }
            else {
                rejevret()
            }
        }
    }
}

state IceWall_Active { // 24
    statusc 0
    code => state IceWall_Falling
    event => state IceWall_Falling
    trans {
        UpdateIceWallTransform()
    }
}

state IceWall_Destroyed { // 25
