        FlamePreviousX = x
        FlamePreviousY = y
        FlamePreviousZ = z
        setanim(FLAMES)
        if (var type = field_63; type == 0) {
            animframe = 0
            soundpitch(5.442)
            sounddecay(10.18s)
            soundcount(0xFFFF)
