            sleepframes(FIREBALL, 0.0, 16.0)
        }
        else {
            if (animseq != getanim(FIREBALL_SHADOW)) {
                setanim(FIREBALL_SHADOW, -1.0)
            }
            while (animframe < 7.0) {
                playframe(animframe + 1.0)
            }
            do {
                playanim(0, FIREBALL_SHADOW)
                playanim(1, FIREBALL_SHADOW)
                playanim(2, FIREBALL_SHADOW)
                playanim(2, FIREBALL_SHADOW)
                playanim(3, FIREBALL_SHADOW)
                playanim(4, FIREBALL_SHADOW)
                playanim(5, FIREBALL_SHADOW)
                playanim(6, FIREBALL_SHADOW)
            } while (1)
        }
    }
    trans {
        changestateif(FlameProjectile_Impact, frametime - statetime >= 37)
        x = spd(x, velx)
        y = spd(y, vely)
        z = spd(z, velz)
    }
}

