        vecx = x + velx
        vecy = y + (vely / 25)
        vecz = z + velz
        rotx = atan2_3d(self, vecx)
        SetTrans(vecx, vecy, vecz)
        changestateif(Fireball_Impact, y <= groundy)
        vely = spd(vely, -90m)
    }
}

