state Flamethrower_Flames { // 44
    stateflag 0x4081
    statusc 0
    code() {
        if (animseq != getanim(FLAMES)) {
            setanim(FLAMES, -1.0)
        }
        while (animframe < 31.0) {
            playframe(animframe + 1.0)
        }
        sleepframes(FLAMES, 0.0, 31.0)
    }
    trans {
        if (var type = field_63; type == 0) {
            getvert(vtrans, creator, 0)
            y += 0.2m
        }
        else if (type == 1) {
            SetTrans(FlamePreviousX, FlamePreviousY, FlamePreviousZ)
            getvert(vvec, creator, 0)
            FlamePreviousX = vecx
            FlamePreviousY = vecy
            FlamePreviousZ = vecz
            y += 0.25m
            moda = 4.0
        }
        else {
            SetTrans(FlameOlderX, FlameOlderY, FlameOlderZ)
            FlameOlderX = FlamePreviousX
            FlameOlderY = FlamePreviousY
            FlameOlderZ = FlamePreviousZ
            getvert(vvec, creator, 0)
            FlamePreviousX = vecx
            FlamePreviousY = vecy
            FlamePreviousZ = vecz
            moda = 8.0
            y += 0.3m
        }
    }
}

state Footprint { // 45
    stateflag 0x20001
    code(offset, angle, size) {
        troty = angle
        vectransf2(vtrans, vtrans, offset, 0, 0)
        scalex = size
        scaley = abs(size)
        vfx = (vfx & 0xFFFFFF00) | 0x3
        scalez = 1S
        rotx = 90deg
        rotz = roty
        zindex = 24
        playanim(0, FOOTPRINT, 29)
        settrans(FootprintFade)
        sleepanim(0, FOOTPRINT, 52)
    }
}

sub FootprintFade() { // S-2415
    moda = seek(moda, 16.0, 0.64)
    changestateif(Kill, moda == 16.0)
}

state Willy_Breath_Vapor { // 46
    stateflag 0x10001
    code(vertex) {
        do {
            start :
            if (var mode = getfield(creator, offsetof(VolleyTurn)); mode == 0) { // creator (player) -> mem14
                if (creator -> speed > 3m) {
                    if (time(8)) {
                        playnull()
                        goto start;
                    }
                }
                else if (time(50)) {
                    playnull()
                    goto start;
                }
            }
            else if (mode == 2) {
                if (time(3)) {
                    playnull()
                    goto start;
                }
            }
            else if (mode == 3) {
                playnull()
                goto start;
            }
            unless (creator -> stateflag & 0x2000 || creator -> stateflag & 0x20) {
                getvert(vtrans, creator, vertex)
                y -= 28.0
                troty = parent -> roty
                setvel(1m)
                x -= velx >> 3
                z -= velz >> 3
                if (abs(degdist(CAMROTY, creator -> roty)) < 90deg) {
                    zindex = 70
                }
                else {
                    zindex = -50
                }
                spawn(9, 21, 1, -1.0, velx, 1.5m, velz, 9.6, 0, zindex, 19)
            }
            playnull()
        } while (1)
    }
}

state Penta_IntroInit { // 47
    stateflag 0x4081
    statusc 0
    code() {
        if (!!RESPAWNCOUNT) {
            KillEntity()
            changestate(Kill)
        }
        zindex = 26
        pathprog = 0
        calcpath(pathprog)
        {
            var ahead
            ahead = pathprog + 5.0
            calcpath(ahead, vvec)
        }
        troty = atan(vecx - x, vecz - z)
        roty = troty
        statusb = 0x14000000
        groundy = 0
        field_60 = 0
        spawn(ShadC, ShadC_S_BOSS_VIDO, 1, 0, 2.6S, 2)
        changestate(Penta_Intro)
    }
    event(e, a) {
        if (e == Event67) {
            KillEntity()
            GLOBAL_186 = 0
            accevcstate(Kill)
        }
    }
}

inline sub SoundPentaFootstep(volume) {
    soundpitch((25.6 + rand(3.2)) * 0.23 >> 8)
    soundplay([fs80A], volume)
}

inline sub PlayFramesPenta(anim, start, end, soundframe, volume) {
    setanim(anim, start)
    do {
        animframe += 1.0
        if (animframe == soundframe) {
            SoundPentaFootstep(volume)
        }
        playframe()
    } while (animframe + 1.0 <= end)
}

state Penta_Intro { // 48
    stateflag 0x4081
    statusc 0
    event => state Penta_IntroInit
    code() {
        do (var i = 0) {
            SoundPentaFootstep(0.3V)
            PlayFramesPenta(PENTA_INTRO_1, -1.0, 24.0, 12.0, 0.4V)
        } while ({ i += 1.0 }; i < 3.0)
        SoundPentaFootstep(0.3V)
        setanim(PENTA_INTRO_2, -1.0)
        do {
            animframe += 1.0
            if (animframe == 12.0) {
                SoundPentaFootstep(0.3V)
            }
            else if (animframe == 25.0) {
                SoundPentaFootstep(0.4V)
            }
            playframe()
        } while (animframe + 1.0 <= 28.0)
        playanim(0, PENTA_COWER_1)
        playanim(1, PENTA_COWER_1)
        playanim(2, PENTA_COWER_1)
        playanim(3, PENTA_COWER_1)
        playanim(3, PENTA_COWER_1)
        PlayFramesPenta(PENTA_INTRO_3, -1.0, 15.0, 3.0, 0.3V)
        SoundPentaFootstep(0.4V)
        playframes(PENTA_INTRO_4, 0.0, 23.0)
        playframes(PENTA_COWER_2, 0.0, 13.0)
        sleep()
    }
    trans {
        nofirst {
            if (pathprog < 148.0) {
                pathprog = spd(pathprog, 30.0)
                calcpath(pathprog)
                {
                    var ahead
                    ahead = pathprog + 5.0
                    if (ahead < 148.0) {
                        calcpath(ahead, vvec)
                        troty = atan(vecx - x, vecz - z)
                    }
                }
                statetime = frametime
            }
            else {
                changestateif(Penta_Escape, frametime - statetime >= 3.5s)
            }
            roty = degseek(roty, troty, 360deg)
        }
    }
}

state Penta_Escape { // 49
    stateflag 0x4081
    statusc 0
    event => state Penta_IntroInit
    code() {
        playanim(0, PENTA_INTRO_5)
        playanim(1, PENTA_INTRO_5)
        playanim(2, PENTA_INTRO_5)
        playanim(2, PENTA_INTRO_5)
        do {
            SoundPentaFootstep(0.3V)
            PlayFramesPenta(PENTA_INTRO_6, -1.0, 9.0, 5.0, 0.4V)
        } while (1)
    }
    trans {
        pathprog = spd(pathprog, 25.0)
        if (pathprog >= pathlen) {
            KillEntity()
            GLOBAL_186 = 0
            changestate(Kill)
        }
        calcpath(pathprog)
        {
            var ahead
            ahead = pathprog + 5.0
            if (ahead < pathlen) {
                calcpath(ahead, vvec)
                troty = atan(vecx - x, vecz - z)
            }
        }
        roty = degseek(roty, troty, 360deg)
    }
}

state Penta_Return { // 50
    stateflag 0x4081
    statusc 0
    code() {
        zindex = 24
        roty = atan2(player -> trans) + 45deg
        x = (15.625 * sin(roty)) >> 4 
        z = (15.625 * cos(roty)) >> 4 
        y = 0
        roty += 180deg
        velx = (9.375 * sin(roty)) >> 4 
        velz = (9.375 * cos(roty)) >> 4 
        vely = 0
        changestate(Penta_ApproachDingo)
    }
}

state Penta_ApproachDingo { // 51
    stateflag 0x4081
    statusc 0
    code() {
        do {
            SoundPentaFootstep(0.3V)
            PlayFramesPenta(PENTA_INTRO_6, -1.0, 9.0, 5.0, 0.4V)
            changestateif(Penta_JumpOnDingo, distance(x, self, 10) <= 4m)
        } while (1)
    }
    trans {
        x = spd(x, velx)
        z = spd(z, velz)
    }
}

state Penta_JumpOnDingo { // 52
    stateflag 0x4081
    statusc 0
    code() {
        playframes(PENTA_WIN_1, 0.0, 10.0)
        sleep()
    }
    trans {
        once {
            speed = distance(x, self, 11)
            speed /= 11
            speed += 1
            groundy = 2.55m
            vely = -((((y - groundy) * 25) / 11) - (19.8m + 1))
        }
        PentaCenterDistance = distance(x, self, 11)
        if (PentaCenterDistance <= speed) {
            x = 0
            z = 0
        }
        else {
            troty = miscfunc(x, self, 1, 2) + 180deg
            velx = ((speed >> 8) * sin(troty)) >> 4
            velz = ((speed >> 8) * cos(troty)) >> 4
            x += velx
            z += velz
        }
        y = spd(y, vely)
        if (vely < 0 && y < groundy) {
            y = groundy
            changestate(Penta_BounceOnDingo)
        }
        vely = spd(vely, -90m)
        if (distance(player, DIST_NO_Y | DIST_EXACT) <= 1m) {
            var0 = atan2(player -> trans)
            player -> x = (1.565 * sin(var0)) >> 4
            player -> z = (1.565 * cos(var0)) >> 4
        }
    }
}

state Penta_BounceOnDingo { // 53
    stateflag 0x4081
    statusc 0
    code() {
        statusb = FLAG_COLLIDABLE | FLAG_SOLID_SIDES
        setanim(PENTA_WIN_2)
        do {
            sendevent(EventTriggered, creator)
            setanim(PENTA_WIN_2, -1.0)
            do {
                animframe += 1.0
                if (animframe == 2.0) {
                    SoundPentaFootstep(0.5V)
                    spawn(9, 21, 1, -1.0, 0, 0, 0, 1.2S, 0, 40, 2)
                }
                playframe()
            } while (animframe + 1.0 <= 24.0)
        } while (1)
    }
    trans {
        if (animseq == getanim(PENTA_WIN_2) && (animframe >= 14.0 && animframe <= 24.0)) {
            roty = (roty + 4.75deg) % 360deg
        }
        if (distance(player, DIST_NO_Y | DIST_EXACT) <= 1m) {
            var0 = atan2(player -> trans)
            player -> x = (1.565 * sin(var0)) >> 4
            player -> z = (1.565 * cos(var0)) >> 4
        }
    }
}

state Kill { // 54
    statusc 0
    code() {}
}