        accevcstate(Kill, e == Event88)
    }
    trans {
        getvert(vtrans, creator, 0)
        getvert(vvec, creator, 1.0)
        var dz = vecz - z
        var dx = vecx - x
        var angle
        angle = atan(dx, dz)
        roty = angle % 360deg
        angle = -angle
        var reach = (((dz >> 8) * cos(angle)) >> 4) - (((dx >> 8) * sin(angle)) >> 4)
        rotx = atan(y - vecy, reach) % 360deg
        rotz = 0
    }
}

state Fireball_Init { // 35
