    }
}

state IceWall_Break { // 28
    statusc 0
    code(layer, angle, side) {
        roty = angle
        zindex = creator -> zindex
        vfx = (vfx & 0xFFFFFF00) | 0xA
        vfx = (vfx & 0xFF00FFFF) | 0x30000
        moda = 4.0
        IceLightX = creator -> IceLightX
        IceLightZ = creator -> IceLightZ
        SetColor2(IceLightX, 0x61F, IceLightZ)
        SoundPitchDefault(0.295)
        soundsetup(6, self, 8)
        soundplay([Di13A], 0.85V)
        if (var temp = layer; temp == 0) {
            SetColor1(0x80, 0x00, 0xFF)
        }
        else if (temp == 1) {
            SetColor1(0x63, 0xF0, 0x00)
        }
        else {
            SetColor1(0x0A, 0x24, 0xE6)
        }
        if (var temp = layer; temp == 0) {
            if (side) {
                playframes(WALL_INNER_BREAK_2, 0.0, 30.0)
            }
            else {
                playframes(WALL_INNER_BREAK_1, 0.0, 30.0)
            }
        }
        else if (temp == 1) {
            if (side) {
                playframes(WALL_MIDDLE_BREAK_2, 0.0, 30.0)
            }
            else {
                playframes(WALL_MIDDLE_BREAK_1, 0.0, 30.0)
            }
        }
        else {
            if (side) {
                playframes(WALL_OUTER_BREAK_2, 0.0, 30.0)
            }
            else {
                playframes(WALL_OUTER_BREAK_1, 0.0, 30.0)
            }
        }
    }
}

state Flamethrower_Init { // 29
    statusc 0x32
    code(angle) {
        roty = angle
        soundpitch(5.442)
        sounddecay(10s)
        soundsetup(8, self, 8)
        soundplay([Di63A], 1V)
        vfx = (vfx & 0xFF00FFFF) | 0x20000
        zindex = creator -> zindex
        FlameStopping = 0
        FlameFadeAmount = 16.0
        changestate(Flamethrower_Active)
    }
}

state Flamethrower_Active { // 30
    statusc 0x32
    code() {
        setanim(FLAME_RED)
        playframes(FLAME_RED, 0.0, 6.0)
        spawn(DingC, S_FLAMETHROWER_IMPACT, 1)
        playframes(FLAME_RED, 7.0, 37.0)
        FlameLength = 0
        WallBurnLength = 0
        creator -> FlameLength = FlameLength
        creator -> WallBurnLength = WallBurnLength
    }
    event(e, a) {
        accevif (e == Event88) {
            FlameStopping = 1
        }
    }
    trans {
        getvert(vtrans, creator, 0)
        unless (STATUS_FIRSTFRAME) {
            var0 = animframe
            if (var0 > 6.0) {
                var0 = 6.0
            }
            FlameLength = ((var0 >> 8) * 10m) / 6
            if (animseq == getanim(FLAME_RED) && animframe <= 24.0) {
                WallBurnLength = FlameLength
            }
            else {
                WallBurnLength = 0
            }
            if (animframe >= 7.0 && animframe <= 23.0) {
                {
                    var c, s, dx, dz
                    dx = player -> x - x >> 8
                    dz = player -> z - z >> 8
                    c = cos(-roty)
                    s = sin(-roty)
                    vecz = ((dz * c) - (dx * s)) >> 4
                    vecx = ((dz * s) + (dx * c)) >> 4
                }
                vecy = (player -> y + 1m) - y
                if (vecz >= 0m && abs(vecx) <= 0.5m && abs(vecy) <= 3.5m) {
                    sendevent(EventBurn, player, 100.0)
                    if (eventaccepted) {
                        creator -> FlameHitPlayer = 1
                    }
                }
            }
            if (FlameStopping) {
                FlameFadeAmount = seek(FlameFadeAmount, 0, 3.2)
                moda = 16.0 - FlameFadeAmount
                changestateifn(Flamethrower_Stop, FlameFadeAmount)
            }
            creator -> FlameLength = FlameLength
            creator -> WallBurnLength = WallBurnLength
        }
    }
}

state Flamethrower_Stop { // 31
    statusc 0x32
    code() {
        FlameLength = 0
        WallBurnLength = 0
        creator -> FlameLength = FlameLength
        creator -> WallBurnLength = WallBurnLength
        WaitChildNull()
    }
}

