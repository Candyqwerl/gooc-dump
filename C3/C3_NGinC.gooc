event EventHit => sub IgnoreHitEvent

var SavedTrans, NGinVar2, NGinVar3, NGinVar4, AttackIndex, PartIndex, ActiveParts, OffsetX, OffsetY
var OffsetZ, FightPhase, RecoilY, RecoilSpeed, RecoilRoll, NGinSpeechOBJ, LastBrokenVertex, EngineVoice

expr PART_BOOSTERS          = 0x2
expr PART_LEFT_GUN          = 0x4
expr PART_RIGHT_GUN         = 0x8
expr PART_MECH_ROCKET_1     = 0x10
expr PART_MECH_ROCKET_2     = 0x20
expr PART_PLASMA_1          = 0x100
expr PART_PLASMA_2          = 0x200
expr PART_SHIP_ROCKET_1     = 0x400
expr PART_SHIP_ROCKET_2     = 0x800
expr PART_SHIP_ROCKET_3     = 0x1000
expr PART_SHIP_ROCKET_4     = 0x2000
expr PART_ORB               = 0x4000
expr PART_CORE_ROCKET       = 0x8000
expr PART_MECH_ALL          = 0x803E
expr PART_MECH_WEAPONS      = 0x803C
expr PART_MECH_ROCKETS      = 0x8030
expr PART_MACHINE_GUNS      = 0xC
expr PART_PLASMA_LAUNCHERS  = 0x300
expr PART_SHIP_ROCKETS      = 0x3C00
expr PART_SHIP_WEAPONS      = 0x7F00

expr PathSpeed        = NGinVar2
expr PathEnd          = NGinVar3
expr PathStart        = NGinVar4
expr AttachmentVertex = NGinVar2
expr AimVertex        = NGinVar3
expr AimYawOffset     = NGinVar4
expr RemainingParts   = yzapproach
expr OrbHealth        = yzapproach
expr ActiveRockets    = field_63
expr FollowDistance   = groundy
expr DockAttached     = var0
expr PowerID          = var0
expr FireAgain        = var0
expr HitConfirmed     = var0
expr SmokeDirection   = var0
expr DebrisSpin       = var0
expr MotorVoice       = field_60

inline sub PlayPartHitSound() {
    if (!rand(2)) {
        SoundPitchDefault()
        soundsetup(7, self, 8)
        soundplay([CB2jA], 1V)
    }
    else {
        SoundPitchDefault()
        soundsetup(7, self, 8)
        soundplay([CB3jA], 1V)
    }
}

inline sub TakePartDamage(damage) {
    unless (stateflag & 0x2) {
        SavedTrans = tpc
        settrans(BeginDamageFlash)
        stateflag |= 0x2
        health -= damage
        if (interrupter) {
            interrupter -> HitConfirmed = true
        }
        PlayPartHitSound()
    }
}

inline sub HandleMachineGunHit(e, a) {
    if (e == EventHit, parent -> animseq == getanim(NGIN_FIRE_LEFT_HOLD) || parent -> animseq == getanim(NGIN_FIRE_RIGHT_HOLD)) {
        accev()
        TakePartDamage(a[0])
    }
}

inline sub TryDestoryPart(e, a, hp) {
    accevcstate(Part_Destroy, hp <= 0 || (e == Event12 ? ((1 << PartIndex) & a[0]) : 0))
}

inline sub CheckMechWeapons() {
    if (!FightPhase) {
        unless (ActiveParts & PART_MECH_WEAPONS) {
            FightPhase += 1.0
            AttackIndex = 0
            changestate(Boss_SelectAttack)
        }
    }
}

inline sub FaceCamera() {
    vecx = CAMTRANSX
    vecy = CAMTRANSY
    vecz = CAMTRANSZ
    roty = atan2(self, vecx)
}

inline sub FollowLauncherVertices() {
    zindex = parent -> zindex
    CopyParentRot()
    getvert(vtrans, parent, AttachmentVertex)
    getvert(vvec, parent, AimVertex)
}

inline sub PlayExplosionSound(sound) {
    soundsetup(7, self, 8)
    sounddecay(10.16s)
    SoundPitchDefault()
    soundsetup(0, self, 5)
    soundplay(sound, 1V)
}

state Boss_Init { // 0
    stateflag 0x2001
    statusc 0x0
    code() {
        soundpitch(4.715)
        soundsetup(7, self, 8)
        sounddecay(10.2s)
        soundplay([Ng45A], 0.5V)
        EngineVoice = voice
        GLOBAL_126 = self
        GLOBAL_150 |= 0x80000
        if (GLOBAL_27 & 0x20) {
            SECTIONDEATHCOUNT = 0
        }
        RemainingParts = 5.0
        spawn2(BosBC, BosBC_S_HEALTH_TICK, 1, RemainingParts, 0)
        PartIndex = 0
        FightPhase = 0
        AttackIndex = 0
        OffsetX = 0
        OffsetY = 0
        OffsetZ = 0
        statusb = FLAG_NO_CAMERA_CLIP | 0x100000
        health = 0
        RecoilY = 0
        RecoilSpeed = 0m
        RecoilRoll = 0deg
        vfx = (vfx & 0xFFFFFF00) | 0x5
        ActiveRockets = 0
        zindex = -60
        SetColor1(0x80, 0x80, 0x80)
        FollowDistance = 25m
        if (!RESPAWNCOUNT) {
            NGinSpeechOBJ = 0
            if (SFXVOL) {
                if (var lang = GLOBAL_151; lang == LANG_FR) {
                    spawn2(9, 44, 1, [F005O], [F015O], 2.0, 0s, 8.0)
                    NGinSpeechOBJ = objectspawned
                }
                else if (lang == LANG_DE) {
                    spawn2(9, 44, 1, [G005O], [G015O], 2.0, 0s, 8.0)
                    NGinSpeechOBJ = objectspawned
                }
                else if (lang == LANG_IT) {
                    spawn2(9, 44, 1, [I005O], [I015O], 2.0, 0s, 8.0)
                    NGinSpeechOBJ = objectspawned
                }
                else if (lang == LANG_ES) {
                    spawn2(9, 44, 1, [S005O], [S015O], 2.0, 0s, 8.0)
                    NGinSpeechOBJ = objectspawned
                }
                else {
                    spawn2(9, 44, 1, [E005O], [E015O], 2.0, 0s, 8.0)
                    NGinSpeechOBJ = objectspawned
                }
            }
        }
        changestate(Mech_Init)
    }
}

sub HandlePartEvent(e, a) {
    if (e == EventHit) {
        accev()
        unless (stateflag & 0x2) {
            SavedTrans = tpc
            settrans(BeginDamageFlash)
            stateflag |= 0x2
            health -= a[0]
            if (interrupter) {
                interrupter -> HitConfirmed = true
            }
            unless (rand(2)) {
                SoundPitchDefault()
                soundsetup(7, self, 8)
                soundplay([CB2jA], 1V)
            }
            else {
                SoundPitchDefault()
                soundsetup(7, self, 8)
                soundplay([CB3jA], 1V)
            }
        }
    }
    TryDestoryPart(e, a, health)
}


state Mech_Init { // 1
    stateflag 0x3
    statusc 0x0
    code() {
        ActiveParts = PART_MECH_ALL
        spawn2(NGinC, S_MECH_BOOSTERS)
        spawn2(NGinC, S_CORE_LAUNCHER, 1, 15, 8.0)
        spawn2(NGinC, S_MACHINE_GUN_ARM, 1, 2, 0.0, 1.0)
        spawn2(NGinC, S_MACHINE_GUN_ARM, 1, 3, 2.0, 3.0)
        spawn2(NGinC, S_ROCKET_LAUNCHER, 1, 4, 4.0, 6.0)
        spawn2(NGinC, S_ROCKET_LAUNCHER, 1, 5, 5.0, 7.0)
        PathStart = 0
        PathEnd = 30.0
        PathSpeed = 4.0
        playanim(0, NGIN_STANCE)
        playanim(0, NGIN_STANCE)
        playanim(0, NGIN_STANCE)
        changestate(Boss_SelectAttack)
    }
    event(e, a) {
        accevif (e == Event7) {
            RemainingParts -= 1.0
            ActiveParts &= ~a[0]
            LastBrokenVertex = interrupter -> AttachmentVertex
        }
    }
}

sub ClearDamageFlash() { 
    moda = 0 
}

sub BeginDamageFlash() {
    moda = 16.0
    onstateexit(ClearDamageFlash)
    call(SavedTrans)
    tpc = pc + 8
}

sub EndDamageFlash() {
    moda = 0
    hpc = 0
    call(SavedTrans)
    tpc = SavedTrans
    stateflag &= ~0x2
}

sub FollowLoopingPath() {
    save (vecx, vecy, vecz, groundy) {
        pathprog = spd(pathprog, PathSpeed)
        if (pathprog >= PathEnd) {
            pathprog = pathprog - (PathEnd - PathStart)
        }
        calcpath(pathprog, vvec)
        OffsetX = vecx
        OffsetY = vecy
        OffsetZ = vecz
    }
}

sub FollowClampedPath() {
    save (vecx, vecy, vecz, groundy) {
        pathprog = spd(pathprog, PathSpeed)
        if (pathprog >= PathEnd) {
            pathprog = PathEnd
        }
        calcpath(pathprog, vvec)
        OffsetX = vecx
        OffsetY = vecy
        OffsetZ = vecz
    }
}

sub ApplyBossMotion() {
    x += OffsetX
    y += OffsetY
    z += OffsetZ
    RecoilSpeed = spd(RecoilSpeed, 40m)
    RecoilY = spd(RecoilY, RecoilSpeed)
    if (RecoilY >= 0) {
        RecoilY = 0
        RecoilSpeed = 0
    }
    y += RecoilY
    rotz = degseek(rotz, RecoilRoll, 45deg)
    if (rotz == RecoilRoll) {
        RecoilRoll = 0
    }
    misc = EngineVoice > 0
    if (misc) {
        sp = EngineVoice
        soundcheck(sp)
        misc = misc != -1
    }
    if (misc) {
        voice = EngineVoice
        soundfadev(0.5V, voice, 0)
    }
    else {
        soundpitch(4.715)
        soundsetup(7, self, 8)
        sounddecay(10.2s)
        soundplay([Ng45A], 0.5V)
        EngineVoice = voice
    }
}

sub FollowPlayerFlight() {
    x = player -> vecx
    y = player -> vecy
    z = player -> vecz
    z -= FollowDistance
    unless (stateflag & 0x2000) {
        y += cos(GAMETICK << 7) << 4
    }
}

sub FireMechRockets(period, limit) {
    if (ActiveRockets >= limit) {
        return
    }
    unless (time(period)) {
        if (ActiveParts & PART_MECH_ROCKET_1) {
            cascadeevent(Event81, self, PART_MECH_ROCKET_1)
        }
        else if (ActiveParts & PART_MECH_ROCKET_2) {
            cascadeevent(Event81, self, PART_MECH_ROCKET_2)
        }
        else if (ActiveParts & PART_CORE_ROCKET) {
            cascadeevent(Event81, self, PART_CORE_ROCKET)
        }  
    }
    else unless (time(period, period / 3)) {
        if (ActiveParts & PART_MECH_ROCKET_2) {
            cascadeevent(Event81, self, PART_MECH_ROCKET_2)
        }
        else if (ActiveParts & PART_CORE_ROCKET) {
            cascadeevent(Event81, self, PART_CORE_ROCKET)
        }
        else if (ActiveParts & PART_MECH_ROCKET_1) {
            cascadeevent(Event81, self, PART_MECH_ROCKET_1)
        }
    }
    else unless (time(period, (period << 1) / 3)) {
        if (ActiveParts & PART_CORE_ROCKET) {
            cascadeevent(Event81, self, PART_CORE_ROCKET)
        }
        else if (ActiveParts & PART_MECH_ROCKET_1) {
            cascadeevent(Event81, self, PART_MECH_ROCKET_1)
        }
        else if (ActiveParts & PART_MECH_ROCKET_2) {
            cascadeevent(Event81, self, PART_MECH_ROCKET_2)
        }
    }
}

state Boss_SelectAttack { // 2
    stateflag 0x3
    statusc 0x0
    event => state Mech_Init
    code() {
        do {
            if (var phase = FightPhase; phase == 0) {
                if (var attack = AttackIndex % 7.0; attack == 0) {
                    changestate(Mech_Move, PART_MECH_ROCKETS, -6m, -6m, 0)
                }
                else if (attack == 1.0) {
                    changestate(Mech_Move, PART_MECH_ROCKETS, 6m, -6m, 0)
                }
                else if (attack == 2.0) {
                    changestate(Mech_Move, PART_MECH_ROCKETS, 6m, 0, 0)
                }
                else if (attack == 3.0) {
                    changestate(Mech_Move, PART_MACHINE_GUNS, -5m, 0, 0)
                }
                else if (attack == 4.0) {
                    changestate(Mech_FireMachineGun, 0)
                }
                else if (attack == 5.0) {
                    changestate(Mech_Move, PART_MACHINE_GUNS, 5m, -6m, 0)
                }
                else {
                    changestateif(Mech_FireMachineGun, attack == 6.0, 1.0)
                }
            }
            else if (phase == 1.0) {
                if (var attack = AttackIndex % 2.0; attack == 0) {
                    changestate(Mech_Move, 0, 0, 0, 0)
                }
                else {
                    changestateif(Mech_Transform, attack == 1.0)
                }
            }
            else if (phase == 2.0) {
                if (var attack = AttackIndex % 5.0; attack == 0) {
                    changestate(Ship_FirePlasma, 0)
                }
                else if (attack == 1.0) {
                    changestate(Ship_FireOrb, 0)
                }
                else if (attack == 2.0) {
                    changestate(Ship_FirePlasma, 1)
                }
                else if (attack == 3.0) {
                    changestate(Ship_FireRockets)
                }
                else {
                    changestateif(Ship_FireOrb, attack == 4.0, 1)
                }
            }
            else if (phase == 3.0) {
                var attack = AttackIndex % 1.0
                changestateifn(Boss_Defeated, attack)
            }
        } while (1)
    }
}

state Mech_Move { // 3
    stateflag 0x3
    statusc 0x0
    event => state Mech_Init
    code(mask, tx, ty, tz) {
        if (mask && !(ActiveParts & mask)) {
            AttackIndex += 1.0
            changestate(Boss_SelectAttack)
        }
        velx = tx - OffsetX
        vely = ty - OffsetY
        velz = tz - OffsetZ
        misc5(velx, 6m)
        settrans(UpdateMechMove)
        do {
            {
                var limit = 2.0
                unless (ActiveParts & PART_RIGHT_GUN) {
                    limit += 1.0
                }
                unless (ActiveParts & PART_LEFT_GUN) {
                    limit += 1.0
                }
                FireMechRockets(3s, limit)
            }
            if (animseq != getanim(NGIN_STANCE)) {
                setanim(NGIN_STANCE, -1.0)
            }
            playframe((animframe + 1.0) % 10.0)
        } until (OffsetX == tx && OffsetY == ty && OffsetZ == tz)
        AttackIndex += 1.0
        changestate(Boss_SelectAttack)
    }
}

sub UpdateMechMove(mask, tx, ty, tz) __trans {
    if (buttonpress(PAD_R2) && DEBUG) {
        cascadeevent(Event12, self, PART_MECH_WEAPONS)
    }
    CheckMechWeapons()
    FollowPlayerFlight()
    OffsetX = seek(OffsetX, tx, spd(velx))
    OffsetY = seek(OffsetY, ty, spd(vely))
    OffsetZ = seek(OffsetZ, tz, spd(velz))
    ApplyBossMotion()
}

state Mech_FireMachineGun { // 4
    stateflag 0x1
    statusc 0x0
    event => state Mech_Init
    trans => sub UpdateMechIdle
    code(left) {
        CheckMechWeapons()
        if (left) {
            SetVel(-7m, 0m, 0m)
        }
        else {
            SetVel(7m, 0m, 0m)
        }
        if ((left || !(ActiveParts & PART_RIGHT_GUN)) && (ActiveParts & PART_LEFT_GUN)) {
            playframes(NGIN_FIRE_LEFT_START, 0.0, 29.0)
            cascadeevent(Event81, self, PART_LEFT_GUN)
            do (var loops = 0) { playframes(NGIN_FIRE_LEFT_HOLD, 0.0, 19.0) } while ({ loops += 1.0 }; loops < 3.0)
            settrans(UpdateMechStrafe)
            do (var loops = 0) { playframes(NGIN_FIRE_LEFT_HOLD, 0.0, 19.0) } while ({ loops += 1.0 }; loops < 3.0)
            cascadeevent(Event82, self, PART_LEFT_GUN)
            settrans(UpdateMechIdle)
            do (var loops = 0) { playframes(NGIN_FIRE_LEFT_HOLD, 0.0, 19.0) } while ({ loops += 1.0 }; loops < 3.0)
            playframes(NGIN_FIRE_LEFT_STOP, 0.0, 28.0)
        }
        else if ((!left || !(ActiveParts & PART_LEFT_GUN)) && (ActiveParts & PART_RIGHT_GUN)) {
            playframes(NGIN_FIRE_RIGHT_START, 0.0, 29.0)
            cascadeevent(Event81, self, PART_RIGHT_GUN)
            do (var loops = 0) { playframes(NGIN_FIRE_RIGHT_HOLD, 0.0, 19.0) } while ({ loops += 1.0 }; loops < 3.0)
            settrans(UpdateMechStrafe)
            do (var loops = 0) { playframes(NGIN_FIRE_RIGHT_HOLD, 0.0, 19.0) } while ({ loops += 1.0 }; loops < 3.0)
            cascadeevent(Event82, self, PART_RIGHT_GUN)
            settrans(UpdateMechIdle)
            do (var loops = 0) { playframes(NGIN_FIRE_RIGHT_HOLD, 0.0, 19.0) } while ({ loops += 1.0 }; loops < 3.0)
            playframes(NGIN_FIRE_RIGHT_STOP, 0.0, 28.0)
        }
        AttackIndex += 1.0
        changestate(Boss_SelectAttack)
    }
}

sub UpdateMechIdle() {
    FollowPlayerFlight()
    ApplyBossMotion()
    unless (stateflag & 0x2) {
        changestateif(Mech_ArmDestroyed, animseq == getanim(NGIN_FIRE_LEFT_HOLD) && !(ActiveParts & PART_LEFT_GUN))
        changestateif(Mech_ArmDestroyed, animseq == getanim(NGIN_FIRE_RIGHT_HOLD) && !(ActiveParts & PART_RIGHT_GUN))
    }
}

sub UpdateMechStrafe() {
    FollowPlayerFlight()
    OffsetX = spd(OffsetX, velx)
    OffsetY = spd(OffsetY, vely)
    OffsetZ = spd(OffsetZ, velz)
    ApplyBossMotion()
    FireMechRockets(5s, 2.0)
    changestateif(Mech_ArmDestroyed, animseq == getanim(NGIN_FIRE_LEFT_HOLD) && !(ActiveParts & PART_LEFT_GUN))
    changestateif(Mech_ArmDestroyed, animseq == getanim(NGIN_FIRE_RIGHT_HOLD) && !(ActiveParts & PART_RIGHT_GUN))
}

state Mech_ArmDestroyed { // 5
    stateflag 0x3
    statusc 0x0
    event => state Mech_Init
    trans => sub UpdateMechIdle
    code() {
        if (animseq == getanim(NGIN_FIRE_LEFT_START) || animseq == getanim(NGIN_FIRE_LEFT_HOLD) || animseq == getanim(NGIN_FIRE_LEFT_STOP)) {
            playframes(NGIN_LEFT_BREAK, 0.0, 29.0)
        }
        else {
            playframes(NGIN_RIGHT_BREAK, 0.0, 29.0)
        }
        AttackIndex += 1.0
        changestate(Boss_SelectAttack)
    }
}

state Mech_Transform { // 6
    stateflag 0x2003
    statusc 0x0
    code() {
        spawn2(NGinC, S_SHIP_DOCK)
        voice = EngineVoice
        soundfadet(2s, voice)
        soundfadev(1V, voice, 2)
        soundpitch(4.895)
        soundsetup(0, self, 8)
        soundplay([Ng95A], 1V)
        setanim(NGIN_MECH_TRANS_1, 91.0)
        do {
            animframe -= 1.0
            if (animframe == 84.0 || animframe == 79.0 || animframe == 74.0) {
                soundpitch(6.528)
                soundsetup(0, self, 8)
                soundplay([Ng95A], 1V)
            }
            if (animframe == 64.0) {
                soundpitch(1.45)
                soundsetup(0, self, 8)
                soundplay([Nga5A], 1V)
                soundpitch(1.45)
                soundsetup(0, self, 8)
                soundplay([Nga5A], 1V)
            }
            playframe()
        } while (animframe - 1.0 >= 0)
        cascadeevent(Event12, self, PART_BOOSTERS)
        spawn2(NGinC, S_DETACHED_BOOSTER, 1, 0x7, 0)
        spawn2(NGinC, S_DETACHED_BOOSTER, 1, 0x6, 1.0)
        sendevent(Event58, player)
        do { playframesback(9.0, 0.0) } until (pathprog >= 22.0)        
        voice = EngineVoice
        soundfadet(1s, voice)
        soundfadev(0.5V, voice, 2)
        ins72(0x100, 0x200)
        playframesback(NGIN_MECH_TRANS_3, 78.0, 0.0)
        soundpitch(4.0)
        soundsetup(0, self, 8)
        sounddecay(7.96s)
        soundplay([Tl15A], 1V)
        soundpitch(4.0)
        soundsetup(0, self, 8)
        sounddecay(7.96s)
        soundplay([Tl15A], 1V)
        do { playframe() } until (DockAttached)
        RemainingParts = 7.0
        spawn2(BosBC, BosBC_S_HEALTH_TICK, 1, RemainingParts, 0)
        statusb &= ~0x100000
        spawn2(NGinC, S_PLASMA_LAUNCHER, 1, 9, 0, 1.0, -90deg, 1)
        spawn2(NGinC, S_PLASMA_LAUNCHER, 1, 8, 2.0, 3.0, -90deg, -1)
        spawn2(NGinC, S_ROCKET_LAUNCHER, 1, 10, 4.0, 5.0)
        spawn2(NGinC, S_ROCKET_LAUNCHER, 1, 11, 6.0, 7.0)
        spawn2(NGinC, S_ROCKET_LAUNCHER, 1, 12, 8.0, 9.0)
        spawn2(NGinC, S_ROCKET_LAUNCHER, 1, 13, 10.0, 11.0)
        spawn2(NGinC, S_ORB_LAUNCHER, 1, 14, 12.0, 13.0)
        ActiveParts |= PART_SHIP_WEAPONS
        ActiveRockets = 0
        FightPhase += 1.0
        AttackIndex = 0
        changestate(Boss_SelectAttack)
    }
    event(e, a) {
        accevif (e == EventTriggered) {
            DockAttached = true
        }
    }
    trans {
        once {
            PathSpeed = 5.0
            PathEnd = 35.0
            PathStart = 0
            pathprog = PathStart
            vely = 0s
        }
        FollowPlayerFlight()
        FollowClampedPath()
        vely = spd(vely, 30m)
        if (vely > 40m) {
            vely = 40m
        }
        player -> vecy = seek(player -> vecy, 120m, spd(vely))
        ApplyBossMotion()
    }
}

state ShipDock_Wait { // 7
    stateflag 0x2003
    statusc 0x0
    code() {
        playnull(25)
        changestate(ShipDock_Attach)
    }
}

state ShipDock_Attach { // 8
    stateflag 0x2003
    statusc 0x0
    code() {
        SetRot(0deg)
        do { playframes(NGIN_SHIP_DOCK, 0.0, 10.0) } until (pathprog == PathEnd)
        soundpitch(2.54)
        soundsetup(0, self, 8)
        sounddecay(8s)
        soundplay([Ng75A], 1V)
        soundpitch(2.54)
        soundsetup(0, self, 8)
        sounddecay(8s)
        soundplay([Ng75A], 1V)
        playframes(NGIN_SHIP_DOCK_LOCK, 0.0, 14.0)
        sendevent(EventTriggered, parent)
        playframe()
    }
    trans {
        once {
            PathSpeed = 5.0
            PathEnd = 65.0
            PathStart = 36.0
            pathprog = PathStart
            groundy = parent -> groundy
            entity = parent -> entity
            pathlen = parent -> pathlen
            zindex = parent -> zindex
            OffsetX = 0
            OffsetY = 0
            OffsetZ = 0
            RecoilY = 0
            RecoilSpeed = 0
            RecoilRoll = 0
        }
        FollowPlayerFlight()
        FollowClampedPath()
        ApplyBossMotion()
    }
}

state Ship_FireRockets { // 9
    stateflag 0x3
    statusc 0x0
    event => state Mech_Init
    code() {
        if (ActiveParts & PART_SHIP_ROCKETS) {
            do (var start = frametime) {
                FireShipRockets(5s)
                UpdateShipAttack()
            } while (frametime - start < 10s)
        }
        AttackIndex += 1.0
        changestate(Boss_SelectAttack)
    }
    trans {
        FollowPlayerFlight()
        OffsetX = seek(OffsetX, cos(GAMETICK << 5) * 0x60, spd(10m))
        rotz = degseek(rotz, -((sin(GAMETICK << 5) * 0x60) >> 10), 180deg)
        ApplyBossMotion()
    }
}

sub FireShipRockets(period) {
    unless (time(period)) {
        if (ActiveParts & PART_SHIP_ROCKET_1) {
            cascadeevent(Event81, self, PART_SHIP_ROCKET_1)
        }
        else if (ActiveParts & PART_SHIP_ROCKET_2) {
            cascadeevent(Event81, self, PART_SHIP_ROCKET_2)
        }
        else if (ActiveParts & PART_SHIP_ROCKET_3) {
            cascadeevent(Event81, self, PART_SHIP_ROCKET_3)
        } 
        else if (ActiveParts & PART_SHIP_ROCKET_4) {
            cascadeevent(Event81, self, PART_SHIP_ROCKET_4)
        } 
    }
    else unless (time(period, period >> 2)) {
        if (ActiveParts & PART_SHIP_ROCKET_2) {
            cascadeevent(Event81, self, PART_SHIP_ROCKET_2)
        }
        else if (ActiveParts & PART_SHIP_ROCKET_3) {
            cascadeevent(Event81, self, PART_SHIP_ROCKET_3)
        }
        else if (ActiveParts & PART_SHIP_ROCKET_4) {
            cascadeevent(Event81, self, PART_SHIP_ROCKET_4)
        } 
        else if (ActiveParts & PART_SHIP_ROCKET_1) {
            cascadeevent(Event81, self, PART_SHIP_ROCKET_1)
        }
    }
    else unless (time(period, period >> 1)) {
        if (ActiveParts & PART_SHIP_ROCKET_3) {
            cascadeevent(Event81, self, PART_SHIP_ROCKET_3)
        }
        else if (ActiveParts & PART_SHIP_ROCKET_4) {
            cascadeevent(Event81, self, PART_SHIP_ROCKET_4)
        }
        else if (ActiveParts & PART_SHIP_ROCKET_1) {
            cascadeevent(Event81, self, PART_SHIP_ROCKET_1)
        } 
        else if (ActiveParts & PART_SHIP_ROCKET_2) {
            cascadeevent(Event81, self, PART_SHIP_ROCKET_2)
        }
    }
    else unless (time(period, (period * 3) >> 2)) {
        if (ActiveParts & PART_SHIP_ROCKET_4) {
            cascadeevent(Event81, self, PART_SHIP_ROCKET_4)
        }
        else if (ActiveParts & PART_SHIP_ROCKET_1) {
            cascadeevent(Event81, self, PART_SHIP_ROCKET_1)
        }
        else if (ActiveParts & PART_SHIP_ROCKET_2) {
            cascadeevent(Event81, self, PART_SHIP_ROCKET_2)
        } 
        else if (ActiveParts & PART_SHIP_ROCKET_3) {
            cascadeevent(Event81, self, PART_SHIP_ROCKET_3)
        }
    }
}

sub FireShipPlasma(side) {
    if (side == 1) {
        if (ActiveParts & PART_PLASMA_1) {
            cascadeevent(Event81, self, PART_PLASMA_1)
        }
        else if (ActiveParts & PART_PLASMA_2) {
            cascadeevent(Event81, self, PART_PLASMA_2)
        }
    }
    else if (side == 2) {
        if (ActiveParts & PART_PLASMA_2) {
            cascadeevent(Event81, self, PART_PLASMA_2)
        }
        else if (ActiveParts & PART_PLASMA_1) {
            cascadeevent(Event81, self, PART_PLASMA_1)
        }
    }
}

sub FireShipOrb(period) {
    unless (time(period)) {
        cascadeevent(Event81, self, PART_ORB)
    }
}

sub UpdateShipAttack() {
    if (buttonpress(PAD_R2) && DEBUG) {
        cascadeevent(Event12, self, ActiveParts)
    }
    unless (ActiveParts & PART_SHIP_WEAPONS) {
        FightPhase += 1.0
        AttackIndex = 0
        changestate(Boss_SelectAttack)
    }
    if (animseq != getanim(NGIN_SHIP_BODY)) {
        setanim(NGIN_SHIP_BODY, -1.0)
    }
    playframe((animframe + 1.0) % 10.0)
}

state Ship_FirePlasma { // 10
    stateflag 0x3
    statusc 0x0
    event => state Mech_Init
    trans => state Ship_FireRockets
    code(repeat) {
        if ((ActiveParts & PART_PLASMA_LAUNCHERS) && (!repeat || SECTIONDEATHCOUNT < 3.0)) {
            UpdateShipAttack()
            FireShipPlasma(2)
            do (var start = frametime) {
                UpdateShipAttack()
            } while (frametime - start < 1s)
            FireShipPlasma(1)
            do (var start = frametime) {
                UpdateShipAttack()
            } while (frametime - start < 1s)
        }
        AttackIndex += 1.0
        changestate(Boss_SelectAttack)
    }
}

state Ship_FireOrb { // 11
    stateflag 0x3
    statusc 0x0
    event => state Mech_Init
    trans => state Ship_FireRockets
    code(repeat) {
        if ((ActiveParts & PART_ORB) && (!repeat || SECTIONDEATHCOUNT < 2.0)) {
            cascadeevent(Event81, self, PART_ORB)
            do (var start = frametime) {
                FireShipRockets(20s)
                UpdateShipAttack()
            } while (frametime - start < 8s)
        }
        AttackIndex += 1.0
        changestate(Boss_SelectAttack)
    }
}

state Boss_Defeated { // 12
    stateflag 0x23
    statusc 0x0
    code() {
        GAMEFLAGS |= -0x80000000
        spawn2(NGinC, S_MECH_SPARKS_FIRST)
        spawn2(NGinC, S_MECH_DAMAGE_SMOKE, 1, LastBrokenVertex)
        playframes(NGIN_MECH_DYING_1, 0.0, 54.0)
        spawn2(NGinC, S_SHIP_DEBRIS, 1, 14.0, -0x2B551, 0x206E1, 0x2D000)
        spawn2(NGinC, S_SHIP_DEBRIS, 1, 15.0, 0x3513D, 0x1540A, 0x2BE8F)
        spawn2(NGinC, S_SHIP_DEBRIS, 1, 16.0, 0x12551, 0x38D14, -0x11C3D)
        spawn2(NGinC, S_SHIP_DEBRIS, 1, 17.0, 0x2877A, -0x25285, -0x1677A)
        spawn2(NGinC, S_SHIP_DEBRIS, 1, 18.0, -0x1D551, -0x32CE1, 0x7FD7)
        spawn2(NGinC, S_SHIP_DEBRIS, 1, 19.0, -0x3A033, 0xDB51, -0x6E1)
        spawn2(NGinC, S_SHIP_DEBRIS, 1, 20.0, -0x8DAE, -0x34E7A, 0x1FA51)
        spawn2(NGinC, S_SHIP_DEBRIS, 1, 21.0, 0x22A7A, -0x29ACC, 0x2D000)
        statusb |= 0x100000
        health = 31
        vfx = (vfx & 0xFFFFFF00) | 0x1
        spawn(NGinC, S_MECH_EXPLOSION)
        spawn(NGinC, S_MECH_EXPLOSION_BODY)
        playframe()
        vfx &= 0xFFFFFF00
        soundsetup(0, self, 8)
        soundpitch(6.528)
        soundplay([Ng95A], 1V)
        soundsetup(0, self, 8)
        soundpitch(4.895)
        soundplay([Ng95A], 1V)
        setanim(NGIN_MECH_DYING_2, 0.0)
        do {
            animframe += 1.0
            if (animframe == 9.0) {
                soundpitch(3.263)
                soundsetup(0, self, 8)
                soundplay([Ng95A], 1V)
            }
            playframe()
        } while (animframe + 1.0 <= 17.0)
        spawn2(NGinC, S_MECH_SPARKS_SECOND)
        playframes(18.0, 39.0)
        statusb &= ~0x100000
        spawn2(NGinC, S_NGIN_EJECT, 1, 0)
        spawn2(NGinC, S_MECH_DEBRIS, 1, 1.0, -0x1FF7A, -0x2BEB, 0x3751)
        spawn2(NGinC, S_MECH_DEBRIS, 1, 2.0, 0x1A6AE, -0x13C3D, 0x11951)
        spawn2(NGinC, S_MECH_DEBRIS, 1, 3.0, 0x17CEB, -0x21270, -0x16D3D)
        spawn2(NGinC, S_MECH_DEBRIS, 1, 4.0, -0x10685, -0x28C00, -0x134C2)
        spawn2(NGinC, S_MECH_DEBRIS, 1, 5.0, -0x23F66, -0x116E1, -0x33DC2)
        spawn2(NGinC, S_MECH_DEBRIS, 1, 6.0, 0x1E60A, -0x617A, -0x2B9F5)
        spawn2(NGinC, S_MECH_DEBRIS, 1, 7.0, -0x1400, 0x3C00, -0x31814)
        spawn2(NGinC, S_MECH_DEBRIS, 1, 8.0, 0, 0xC800, 0)
        vfx = (vfx & 0xFFFFFF00) | 0x1
        playframe()
        playnull()
        NGinSpeechOBJ = 0
        if (SFXVOL) {
            if (var lang = GLOBAL_151; lang == LANG_FR) {
                spawn2(9, 44, 1, [F105O], [F115O], 2.0, 0s, 8.0)
                NGinSpeechOBJ = objectspawned
            }
            else if (lang == LANG_DE) {
                spawn2(9, 44, 1, [G105O], [G115O], 2.0, 0s, 8.0)
                NGinSpeechOBJ = objectspawned
            }
            else if (lang == LANG_IT) {
                spawn2(9, 44, 1, [I105O], [I115O], 2.0, 0s, 8.0)
                NGinSpeechOBJ = objectspawned
            }
            else if (lang == LANG_ES) {
                spawn2(9, 44, 1, [S105O], [S115O], 2.0, 0s, 8.0)
                NGinSpeechOBJ = objectspawned
            }
            else {
                spawn2(9, 44, 1, [E105O], [E115O], 2.0, 0s, 8.0)
                NGinSpeechOBJ = objectspawned
            }
        }
        playnull(42)
        playnull(42)
        if (GLOBAL_160 & 0x8) {
            PowerID = 0
        }
        else {
            PowerID = 703.0
            spawn2(FruiC, FruiC_S_FRUIT_AUTO, 1, 703.0, 0)
        }
        interrupter = player -> field_63
        sendevent(Event12, interrupter, 0)
        playnull(42)
        if (PowerID) {
            spawn2(BosBC, BosBC_S_REWARD_DESC, 1, PowerID)
            do { playnull() } until (buttonbuffer(PAD_TRIANGLE))
        }
        if (!(PREVBOXCOUNT & 0x2000), SFXVOL) {
            GLOBAL_190 = 0x200
            GLOBAL_191 = 17
        }
        sendevent(EventWarp, player, PowerID)
        sleepnull()
    }
    trans {
        FollowPlayerFlight()
        ApplyBossMotion()
    }
}

