state ShipDebris_Fly { // 19
    stateflag 0x1
    statusc 0x0
    code(vertex, vx, vy, vz) {
        statusb = FLAG_PHYSICS_ENGINE | FLAG_NO_CAMERA_CLIP
        vfx = (vfx & 0xFFFFFF00) | 0x5
        getvert(vtrans, creator, vertex)
        spawn(9, 4, 1, 0, 6)
        PlayPartExplosionSound()
        velx = vx << 2
        vely = vy << 2
        if (var part = vertex; part == 14.0) {
            sleepanim(0, NGIN_SHIP_PART_1)
        }
        else if (part == 15.0) {
            sleepanim(0, NGIN_SHIP_PART_2)
        }
        else if (part == 16.0) {
            sleepanim(0, NGIN_SHIP_PART_3)
        }
        else if (part == 17.0) {
            sleepanim(0, NGIN_SHIP_PART_4)
        }
        else if (part == 18.0) {
            sleepanim(0, NGIN_SHIP_PART_5)
        }
        else if (part == 19.0) {
            sleepanim(0, NGIN_SHIP_PART_6)
        }
        else if (part == 20.0) {
            sleepanim(0, NGIN_SHIP_PART_7)
        }
        else if (part == 21.0) {
            sleepanim(0, NGIN_SHIP_PART_8)
        }
    }
    trans {
        once {
            if (!rand(2)) {
                DebrisSpin = 180deg
            }
            else {
                DebrisSpin = -180deg
            }
        }
        z = parent -> z
    }
}

sub PlayPartExplosionSound() {
    if (var r = rand(4); r == 0) {
        PlayExplosionSound([Ngc5A])
    }
    else if (r == 1) {
        PlayExplosionSound([Ngd5A])
    }
    else if (r == 2) {
        PlayExplosionSound([Nge5A])
    }
    else if (r == 3) {
        PlayExplosionSound([Ngf5A])
    }
}

state MechDebris_Fly { // 20
    stateflag 0x1
    statusc 0x0
    code(vertex, vx, vy, vz) {
        statusb = FLAG_PHYSICS_ENGINE | FLAG_NO_CAMERA_CLIP
        vfx = (vfx & 0xFFFFFF00) | 0x5
        getvert(vtrans, creator, vertex)
        if (!!rand(2)) {
            spawn(9, 4, 1, 0, 6)
        }
        spawn(NGinC, S_PART_EXPLOSION)
        velx = vx << 2
        vely = vy << 2
        PlayPartExplosionSound()
        if (var part = vertex; part == 1.0) {
            sleepanim(0, NGIN_MECH_PART_1)
        }
        else if (part == 2.0) {
            sleepanim(0, NGIN_MECH_PART_2)
        }
        else if (part == 3.0) {
            sleepanim(0, NGIN_MECH_PART_3)
        }
        else if (part == 4.0) {
            sleepanim(0, NGIN_MECH_PART_4)
        }
        else if (part == 5.0) {
            sleepanim(0, NGIN_MECH_PART_5)
        }
        else if (part == 6.0) {
            sleepanim(0, NGIN_MECH_PART_6)
        }
        else if (part == 7.0) {
            sleepanim(0, NGIN_MECH_PART_7)
        }
        else if (part == 8.0) {
            playframes(NGIN_MECH_PART_BREAK, 0.0, 17.0)
        }
    }
    trans {
        once {
            if (!rand(2)) {
                DebrisSpin = 180deg
            }
            else {
                DebrisSpin = -180deg
            }
        }
        z = parent -> z
        rotz = spd(rotz, DebrisSpin)
    }
}

state MechBoosters_Follow { // 21
    stateflag 0x1
    statusc 0x0
    code() {
        PartIndex = 1
        vfx = parent -> vfx
        do {
            CopyParentRot()
            CopyParentTrans()
            zindex = parent -> zindex
            zindex -= 30
            if (parent -> animseq == getanim(NGIN_FIRE_RIGHT_START)) {
                setanim(NGIN_MECH_BOOSTER_2)
            }
            else if (parent -> animseq == getanim(NGIN_FIRE_RIGHT_HOLD)) {
                setanim(NGIN_MECH_BOOSTER_3)
            }
            else if (parent -> animseq == getanim(NGIN_FIRE_RIGHT_STOP)) {
                setanim(NGIN_MECH_BOOSTER_4)
            }
            else if (parent -> animseq == getanim(NGIN_FIRE_LEFT_START)) {
                setanim(NGIN_MECH_BOOSTER_5)
            }
            else if (parent -> animseq == getanim(NGIN_FIRE_LEFT_HOLD)) {
                setanim(NGIN_MECH_BOOSTER_6)
            }
            else if (parent -> animseq == getanim(NGIN_FIRE_LEFT_STOP)) {
                setanim(NGIN_MECH_BOOSTER_7)
            }
            else if (parent -> animseq == getanim(NGIN_LEFT_BREAK)) {
                setanim(NGIN_MECH_BOOSTER_9)
            }
            else if (parent -> animseq == getanim(NGIN_RIGHT_BREAK)) {
                setanim(NGIN_MECH_BOOSTER_8)
            }
            else if (parent -> animseq == getanim(NGIN_STANCE)) {
                setanim(NGIN_MECH_BOOSTER_1)
            }
            else if (parent -> animseq == getanim(NGIN_MECH_TRANS_1)) {
                setanim(NGIN_MECH_BOOSTER_0)
            }
            playframe(parent -> animframe)
        } while (1)
    }
    event(e, a) {
        accevcstate(Part_Destroy, (e == Event12 ? ((1 << PartIndex) & a[0]) : 0))
    }
}

state MechBooster_Detach { // 22
    stateflag 0x1
    statusc 0x0
    code(part, vertex) {
        PartIndex = part
        vfx = parent -> vfx
        zindex = parent -> zindex
        zindex -= 30
        roty += 180deg
        getvert(vtrans, parent, vertex)
        statusb = FLAG_PHYSICS_ENGINE
        velx = 3m
        vely = 3m
        velz = player -> speed
        if (!vertex) {
            scalex = -scalex
            velx = -velx
        }
        playanim(0, NGIN_MECH_BOOSTER_A, 42)
        playanim(0, NGIN_MECH_BOOSTER_A, 42)
        playanim(0, NGIN_MECH_BOOSTER_A, 42)
        playanim(0, NGIN_MECH_BOOSTER_A, 42)
        changestate(Part_Destroy)
    }
}

state CoreLauncher_Init { // 23
    stateflag 0x2001
    statusc 0x0
    code(part, vertex) {
        PartIndex = part
        AttachmentVertex = vertex
        health = 10
        vfx = (vfx & 0xFFFFFF00) | 0x1 
        changestate(CoreLauncher_Idle)
    }
}

state CoreLauncher_Idle { // 24
    stateflag 0x1
    statusc 0x0
    code() {
        sleepanim(0, CORE_HITBOX)
    }
    event(e, a) {
        accevif (e == EventHit) {
            TakePartDamage(a[0])
            spawn(9, 46, 1, 20, 45, 2, 0, 0)
            parent -> health = 30
        }
        TryDestoryPart(e, a, health)
        accevcstate(CoreLauncher_Fire, (e == Event81 ? ((1 << PartIndex) & a[0]) : 0))
    }
    trans {
        unless (stateflag & 0x2) {
            parent -> health = time(16)
        }
        getvert(vtrans, parent, AttachmentVertex)
    }
}

state CoreLauncher_Fire { // 25
    stateflag 0x1
    statusc 0x0
    trans => state CoreLauncher_Idle
    code() {
        spawn2(NGinC, S_ROCKET, 1, 0)
        playanim(0, CORE_HITBOX)
        changestate(CoreLauncher_Idle)
    }
    event(e, a) {
        accevif (e == EventHit) {
            TakePartDamage(a[0])
            spawn(9, 46, 1, 20, 45, 2, 0, 0)
        }
        TryDestoryPart(e, a, health)
    }
}

state RocketLauncher_Init { // 26
    stateflag 0x2001
    statusc 0x0
    code(part, base, tip) {
        PartIndex = part
        AttachmentVertex = base
        AimVertex = tip
        SetColor1(0x80, 0x80, 0x80)
        health = 20
        changestate(RocketLauncher_Idle)
    }
}

state RocketLauncher_Idle { // 27
    stateflag 0x1
    statusc 0x0
    code() {
        sleepanim(0, ROCKET_LAUNCHER_OPEN)
    }
    event(e, a) {
        TryDestoryPart(e, a, health)
        accevcstate(RocketLauncher_Fire, (e == Event81 ? ((1 << PartIndex) & a[0]) : 0))
    }
    trans {
        FollowLauncherVertices()
        rotz = atan2(self, vecx)
        roty = rotz - 90deg
        rotx = atan2_3d(self, vecx)
    }
}

state RocketLauncher_Fire { // 28
    stateflag 0x1
    statusc 0x0
    trans => state RocketLauncher_Idle
    code() {
        FireAgain = false
        playframes(ROCKET_LAUNCHER_OPEN, 0.0, 10.0)
        do {
            spawn2(NGinC, S_ROCKET, 1, 0)
            playframes(ROCKET_LAUNCHER_FIRE, 0.0, 19.0)
            playframe(animframe, 21)
            if (!FireAgain) { goto exit }
            FireAgain = false
        } while (1)
        exit :
        playframes(ROCKET_LAUNCHER_CLOSE, 0.0, 8.0)
        changestate(RocketLauncher_Idle)
    }
    event(e, a) {
        accevif (e == EventHit) {
            TakePartDamage(a[0])
        }
        TryDestoryPart(e, a, health)
        accevif ((e == Event81 ? ((1 << PartIndex) & a[0]) : 0)) {
            FireAgain = true
        }
    }
}

state Rocket_Fly { // 29
    stateflag 0x1
    statusc 0x0
    event => sub HandlePartEvent
    code(vertex) {
        interrupter = GLOBAL_126
        interrupter -> ActiveRockets += 1.0
        soundpitch(4.0)
        sounddecay(8s)
        soundsetup(8, self, 8)
        soundplay([Ng35A], 1V)
        SetColor1(0x80, 0x80, 0x80)
        getvert(vtrans, parent, vertex)
        velx = 0
        vely = 0
        vfx = (vfx & 0xFFFFFF00) | 0x5
        velz = 6m
        if (x > parent -> x + 1m) {
            velx = 15m
        }
        if (x < parent -> x - 1m) {
            velx = -15m
        }
        health = 4 - (SECTIONDEATHCOUNT >> 9)
        if (health < 2) {
            health = 2
        }
        trotz = 0x177000
        SetRot(0deg)
        setanim(ROCKET)
        do {
            var vx = player -> x - x
            var vy = player -> y - y
            var vz = 0
            changestateif(Rocket_HitPlayer, z > player -> z - 2m && abs(vx) < 1m && abs(vy) < 1m, 10.0)
            misc5(vx, 6m)
            velx = seek(velx, vx, spd(15m))
            x = spd(x, velx)
            vely = seek(vely, vy, spd(15m))
            y = spd(y, vely)
            z = spd(z, velz + player -> speed)
            animframe = (animframe + 1.0) % 10.0
            playframe()
        } until (z > player -> z + 0.5m)
        do (var start = frametime) {
            x = spd(x, velx)
            y = spd(y, vely)
            z = spd(z, velz + player -> speed)
            animframe = (animframe + 1.0) % 10.0
            playframe()
        } while (frametime - start < 5)
        interrupter = GLOBAL_126
        interrupter -> ActiveRockets -= 1.0
    }
}

state Rocket_HitPlayer { // 30
    stateflag 0x20
    statusc 0x0
    code(damage) {
        interrupter = GLOBAL_126
        interrupter -> ActiveRockets -= 1.0
        sendevent(EventHit, player, damage)
        statusb = 0
        spawn(9, 40, 1, 0, 6)
        WaitChildNull()
    }
}

state OrbLauncher_Init { // 31
    stateflag 0x2001
    statusc 0x0
    code(part, base, tip) {
        PartIndex = part
        vfx = (vfx & 0xFFFFFF00) | 0x5
        AttachmentVertex = base
        AimVertex = tip
        SetColor1(0x80, 0x80, 0x80)
        health = 20
        changestate(OrbLauncher_Idle)
    }
}

state OrbLauncher_Idle { // 32
    stateflag 0x1
    statusc 0x0
    code() {
        sleepanim(0, ORB_LAUNCHER_OPEN)
    }
    event(e, a) {
        accevif (e == EventHit) {
            TakePartDamage(a[0])
        }
        TryDestoryPart(e, a, health)
        accevcstate(OrbLauncher_Open, (e == Event81 ? ((1 << PartIndex) & a[0]) : 0))
    }
    trans {
        FollowLauncherVertices()
        rotx = 0deg
        roty = atan2(self, vecx) - 90deg
        rotz = atan2_3d(self, vecx)
    }
}

state OrbLauncher_Open { // 33
    stateflag 0x41
    statusc 0x0
    event => sub HandlePartEvent
    trans => state OrbLauncher_Idle
    code() {
        playframes(ORB_LAUNCHER_OPEN, 0.0, 15.0)
        changestate(OrbLauncher_Fire)
    }
}

state OrbLauncher_Fire { // 34
    stateflag 0x41
    statusc 0x0
    event => sub HandlePartEvent
    trans => state OrbLauncher_Idle
    code() {
        spawn(NGinC, S_ORB, 1, 0)
        playframes(ORB_LAUNCHER_FIRE, 0.0, 14.0)
        changestate(OrbLauncher_Close)
    }
}

state OrbLauncher_Close { // 35
    stateflag 0x1
    statusc 0x0
    event => sub HandlePartEvent
    trans => state OrbLauncher_Idle
    code() {
        playframesback(ORB_LAUNCHER_OPEN, 15.0, 0.0)
        changestate(OrbLauncher_Idle)
    }
}

state Orb_Fly { // 36
    stateflag 0x41
    statusc 0x0
    code(vertex) {
        soundpitch(4.0)
        sounddecay(8s)
        soundsetup(8, self, 8)
        soundplay([Ng65A], 1V)
        getvert(vtrans, parent, vertex)
        velx = 0
        vely = 0
        vfx = (vfx & 0xFFFFFF00) | 0x5
        velz = 2m + player -> speed
        statusb = FLAG_PHYSICS_ENGINE | 0x100000
        OrbHealth = 10
        SetRot(0deg)
        stalltime = 0
        var0 = 32
        do {
            {
                var vx = player -> x - x
                var vy = player -> y - y
                var vz = 0
                misc5(vx, 1m)
                velx = seek(velx, vx, spd(10m))
                x = spd(x, velx)
                vely = seek(vely, vy, spd(10m))
                y = spd(y, vely)
                stalltime = (stalltime + 1) % var0
            }
            unless (GAMETICK % 8) {
                var0 -= 1
                if (var0 < 1) {
                    var0 = 1
                }
            }
            changestateif(Part_Destroy, parent -> stateflag & 0x20)
            if (animseq != getanim(ORB)) {
                setanim(ORB, -1.0)
            }
            animframe = (animframe + 1.0) % 61.0
            playframe()
        } until (z > player -> z)
        changestate(Orb_Explode)
    }
    event(e, a) {
        accevif (e == EventHit) {
            unless (stateflag & 0x2) {
                OrbHealth -= a[0]
                if (interrupter) {
                    interrupter -> HitConfirmed = true
                }
                PlayPartHitSound()
            }
        }
        TryDestoryPart(e, a, OrbHealth)
    }
}

state Orb_Explode { // 37
    stateflag 0x41
    statusc 0x0
    code() {
        var radius
        statusb = FLAG_NO_CAMERA_CLIP
        SetRot(0deg)
        GLOBAL_101 = 25
        GLOBAL_100 = 0x99
        setanim(ORB_EXPLODE, -1.0)
        do {
            animframe += 1.0
            z = player -> z
            FaceCamera()
            radius = spd(radius, 8m)
            if (radius > 4m) {
                radius = 4m
            }
            sendeventif(EventHit, player, abs(x - player -> x) + abs(y - player -> y) < radius, 1.0)
            playframe()
        } while (animframe + 1.0 <= 29.0)
    }
}

state PlasmaLauncher_Init { // 38
    stateflag 0x2001
    statusc 0x0
    code(part, base, tip, yaw, side) {
        PartIndex = part
        AimYawOffset = yaw
        vfx = (vfx & 0xFFFFFF00) | 0x5
        AttachmentVertex = base
        AimVertex = tip
        SetColor1(0x80, 0x80, 0x80)
        health = 20 - (SECTIONDEATHCOUNT * 3.0)
        if (health < 10) {
            health = 10
        }
        if (parent -> FightPhase == 2.0) {
            SetScale(1.25S)
        }
        scalex *= side
        changestate(PlasmaLauncher_Idle)
    }
}

state PlasmaLauncher_Idle { // 39
    stateflag 0x1
    statusc 0x0
    code() {
        sleepanim(0, PLASMA_LAUNCHER_OPEN)
    }
    event(e, a) {
        accevcstate(PlasmaLauncher_Open, (e == Event81 ? ((1 << PartIndex) & a[0]) : 0))
        accevcstate(Part_Destroy, (e == Event12 ? ((1 << PartIndex) & a[0]) : 0))
    }
    trans {
        FollowLauncherVertices()
        rotx = degseek(0deg, atan2_3d(self, player -> x), 375deg)
        roty = degseek(atan2(self, vecx) + AimYawOffset, atan2(player -> trans), 750deg)
        rotz = atan2_3d(self, vecx)
    }
}

state PlasmaLauncher_Open { // 40
    stateflag 0x41
    statusc 0x0
    trans => state PlasmaLauncher_Idle
    code() {
        playframes(PLASMA_LAUNCHER_OPEN, 0.0, 15.0)
        changestate(PlasmaLauncher_Fire)
    }
    event(e, a) {
        accevcstate(Part_Destroy, (e == Event12 ? ((1 << PartIndex) & a[0]) : 0))
    }
}

state PlasmaLauncher_Fire { // 41
    stateflag 0x41
    statusc 0x0
    event => sub HandlePartEvent
    trans => state PlasmaLauncher_Idle
    code() {
        spawn(NGinC, S_PLASMA_BALL, 1, 0)
        playframes(PLASMA_LAUNCHER_FIRE, 0.0, 17.0)
        playanim(15, PLASMA_LAUNCHER_OPEN, 42)
        playframe(animframe, 42)
        changestate(PlasmaLauncher_Close)
    }
}

state PlasmaLauncher_Close { // 42
    stateflag 0x1
    statusc 0x0
    event => state PlasmaLauncher_Open
    trans => state PlasmaLauncher_Idle
    code() {
        playframesback(PLASMA_LAUNCHER_OPEN, 15.0, 0.0)
        changestate(PlasmaLauncher_Idle)
    }
}

state PlasmaBall_Fly { // 43
    stateflag 0x41
    statusc 0x0
    code(vertex) {
        soundpitch(2.54)
        sounddecay(8s)
        soundsetup(8, self, 8)
        soundplay([Ng55A], 1V)
        SetScale(1S)
        getvert(vtrans, parent, vertex)
        vfx = (vfx & 0xFFFFFF00) | 0x5
        velx = player -> x - x
        vely = player -> y - y
        velz = player -> z - z
        misc5(velx, 20m)
        statusb = FLAG_PHYSICS_ENGINE
        velz += player -> speed
        do {
            FaceCamera()
            if (animseq != getanim(PLASMA_BALL)) {
                setanim(PLASMA_BALL, -1.0)
            }
            animframe = (animframe + 1.0) % 11.0
            playframe()
        } until (z > player -> z + 4m)
    }
    trans {
        changestateif(PlasmaBall_HitPlayer, distance(player) < 2m, 6.0)
    }
}

state PlasmaBall_HitPlayer { // 44
    stateflag 0x20
    statusc 0x0
    code(damage) {
        sendevent(EventHit, player, damage)
        statusb = 0
        spawn(9, 40, 1, 0, 6)
        WaitChildNull()
    }
}

state MachineGunArm_Init { // 45
    stateflag 0x2001
    statusc 0x0
    code(part, base, tip) {
        PartIndex = part
        vfx = (vfx & 0xFFFFFF00) | 0x5
        AttachmentVertex = base
        AimVertex = tip
        SetColor1(0x80, 0x80, 0x80)
        health = 15
        spawn2(NGinC, S_MACHINE_GUN, 1, 0)
        changestate(MachineGunArm_Idle)
    }
}

state MachineGunArm_Idle { // 46
    stateflag 0x1
    statusc 0x0
    code() {
        sleepanim(0, MACHINE_GUN_ARM)
    }
    event(e, a) {
        accevcstate(MachineGunArm_Fire, (e == Event81 ? ((1 << PartIndex) & a[0]) : 0))
        accevcstate(Part_Destroy, (e == Event12 ? ((1 << PartIndex) & a[0]) : 0))
    }
    trans {
        zindex = parent -> zindex
        getvert(vtrans, parent, AttachmentVertex)
        getvert(vvec, parent, AimVertex)
        rotx = atan2_3d(self, vecx)
        if (abs(rotx) > 45deg) {
            roty = parent -> roty
        }
        else {
            roty = atan2(self, vecx)
        }
        rotz = 0deg
    }
}

state MachineGunArm_Fire { // 47
    stateflag 0x1
    statusc 0x0
    trans => state MachineGunArm_Idle
    code() {
        trotx = 0deg
        soundpitch(0.653)
        soundfadet(2s, self)
        soundpitch(3.263, self, 2)
        soundcount(0xFFFF, self, 2)
        sounddecay(9.6s, self, 2)
        soundsetup(7, self, 2, 8)
        soundplay([Ng15A], 0.6V)
        MotorVoice = voice
        do {
            trotx = seek(trotx, 720deg, spd(360deg))
            trotz = spd(trotz, trotx)
            playanim(0, MACHINE_GUN_ARM)
        } until (trotx == 720deg)
        stateflag |= 0x40
        spawn2(NGinC, S_MACHINE_GUN_BULLETS, 1, 1.0)
        do {
            trotz = spd(trotz, trotx)
            if (animseq != getanim(MACHINE_GUN_ARM)) {
                setanim(MACHINE_GUN_ARM, -1.0)
            }
            playframe((animframe + 1.0) % 15.0)
        } while (1)
    }
    event(e, a) {
        HandleMachineGunHit(e, a)
        TryDestoryPart(e, a, health)
        accevcstate(MachineGunArm_Stop, (e == Event82 ? ((1 << PartIndex) & a[0]) : 0))
    }
}


state MachineGunArm_Stop { // 48
    stateflag 0x1
    statusc 0x0
    trans => state MachineGunArm_Idle
    code() {
        soundfadet(3s, MotorVoice)
        soundpitch(3.2, MotorVoice, 3)
        soundfadev(0V, MotorVoice, 3)
        do {
            trotx = seek(trotx, 0deg, spd(180deg))
            trotz = spd(trotz, trotx)
            playanim(0, MACHINE_GUN_ARM)
        } until (trotx == 0deg)
        changestate(MachineGunArm_Idle)
    }
    event(e, a) {
        HandleMachineGunHit(e, a)
        TryDestoryPart(e, a, health)
    }
}

state MachineGun_Follow { // 49
    stateflag 0x1
    statusc 0x0
    code(vertex) {
        movetolist(5.0, self)
        SetColor1(0, 0, 0)
        do {
            rotx = creator -> rotx
            roty = creator -> roty
            zindex = creator -> zindex
            vfx = creator -> vfx
            rotz = creator -> trotz
            moda = creator -> moda
            getvert(vtrans, creator, vertex)
            playanim(0, MACHINE_GUN)
        } until (creator -> stateflag & 0x20)
    }
}

state MachineGunBullets_Fire { // 50
    stateflag 0x41
    statusc 0x0
    __transargs
    code(vertex) {
        movetolist(5.0, self)
        soundpitch(5.805)
        soundcount(0xFFFF)
        sounddecay(9.6s)
        soundsetup(8, self, 8)
        soundplay([Ng25A], 1V)
        playframes(BULLET, 0.0, 8.0)
        while (creator -> stateflag & 0x40) {
            playanim(9, BULLET)
            playanim(10, BULLET)
        }
        soundfadet(0.2s, voice)
        soundfadev(0V, voice, 2)
        playframes(BULLET, (animframe + 1.0) - 1.0, 20.0)
    }
    trans {
        getvert(vtrans, creator, vertex)
        sendeventif(EventHit, player, abs(x - player -> x) < 2m && abs(y - player -> y) < 2m, 2.0)
    }
}

state PartExplosion_Play { // 51
    stateflag 0x41
    statusc 0x0
    code() {
        movetolist(3.0, self)
        PlayPartExplosionSound()
        soundsetup(0, voice, 5)
        GLOBAL_101 = 2
        GLOBAL_100 = 0xFF
        statusb = FLAG_NO_CAMERA_CLIP
        SetRot(0deg)
        SetScale(1S)
        playframes(PART_BREAK_EXPLOSION, 0.0, 19.0)
    }
    trans {
        if (frametime - statetime >= 8) {
            moda = seek(moda, 16.0, 0x1EB)
        }
    }
}

state Part_Destroy { // 52
    stateflag 0x20
    statusc 0x0
    code() {
        if (spawn == S_MACHINE_GUN_ARM || spawn == S_ROCKET_LAUNCHER || spawn == S_PLASMA_LAUNCHER || spawn == S_CORE_LAUNCHER || spawn == S_ORB_LAUNCHER) {
            spawn(NGinC, S_PART_EXPLOSION)
            sendevent(Event7, creator, 1 << PartIndex)
        }
        statusb = 0
        spawn(9, 40, 1, getins(SetDebrisAppearance), 6)
        if (spawn == S_ROCKET_LAUNCHER) {
            parent -> RecoilSpeed = -20m
            if (var part = PartIndex; part == 12) {
                parent -> RecoilRoll = 8deg
            }
            else if (part == 11) {
                parent -> RecoilRoll = -8deg
            }
            else if (part == 4 || part == 13) {
                parent -> RecoilRoll = 15deg
            }
            else {
                parent -> RecoilRoll = -15deg
            }
            playframes(ROCKET_LAUNCHER_BREAK, 0.0, 14.0)
        }
        else if (spawn == S_MACHINE_GUN_ARM) {
            playframes(MACHINE_GUN_ARM_BREAK, 0.0, 17.0)
        }
        else if (spawn == S_ORB_LAUNCHER) {
            playframes(ORB_LAUNCHER_BREAK, 0.0, 17.0)
        }
        else if (spawn == S_PLASMA_LAUNCHER) {
            playframes(PLASMA_LAUNCHER_BREAK, 0.0, 17.0)
        }
        else if (spawn == S_CORE_LAUNCHER) {
            parent -> health = 31
        }
        else if (spawn == S_ROCKET) {
            GLOBAL_101 = 2
            GLOBAL_100 = 0x7F
            interrupter = GLOBAL_126
            interrupter -> ActiveRockets -= 1.0
        }
        else if (spawn == S_ORB) {
            GLOBAL_101 = 5
            GLOBAL_100 = 0x99
        }
        WaitChildNull()
    }
}

sub SetDebrisAppearance() {
    if (spawn == 0x9002B) {
        SetColor1(0x80, 0x32, 0x00)
        rotx = 90deg
        vecx = CAMTRANSX
        vecy = CAMTRANSY
        vecz = CAMTRANSZ
        rotz = atan2(self, vecx)
    }
}

sub IgnoreHitEvent() {}
