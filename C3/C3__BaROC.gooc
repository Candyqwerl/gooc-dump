inline sub GetCameraTrans() {
    vecx = CAMTRANSX
    vecz = CAMTRANSZ
}

inline sub FollowRacerPath() {
    save (pathlen, entity) {
        pathlen = creator -> pathlen
        entity = creator -> entity
        calcpath(pathprog, vtrans)
        var pitch
        pitch = pathprog + (PathSpeed << 1)
        if (pitch >= TrackLength) {
            pitch -= TrackLength - 1
        }
        calcpath(pitch, vvec)
        pitch = 0
        var turn, roll
        {
            var dz = vecz - z
            var dx = vecx - x
            var yaw
            yaw = atan(dx, dz)
            turn = yaw & 0xFFF
            yaw = -yaw
            var lz = (((dz >> 8) * cos(yaw)) >> 4) - (((dx >> 8) * sin(yaw)) >> 4)
            pitch = atan(y - vecy, lz) & 0xFFF
            roll = 0
            turn = degdist(roty, turn) >> 3
        }
        if (abs(turn) > 7.2deg) {
            if (turn >= 0deg) {
                turn = 7.2deg
            }
            else {
                turn = -7.2deg
            }
        }
        roty += turn
        yzapproach += ((turn * 50) - yzapproach) >> 5
        pitch = degdist(rotx, pitch) >> 3
        if (abs(pitch) > 7.2deg) {
            if (pitch >= 0deg) {
                pitch = 7.2deg
            }
            else {
                pitch = -7.2deg
            }
        }
        rotx += pitch
    }
}

inline sub UpdateRingSegment() {
    {
        var table, index
        table = RingPositions
        index = CurrentRing - 1
        if (index < 0) {
            index = 0
        }
        index = (index * 3) << 8
        PreviousRingX = table[ index ] << 8
        PreviousRingZ = table[index + 2.0] << 8
        index = CurrentRing
        if (index >= RingCount) {
            index = RingCount - 1
        }
        index = (index * 3) << 8
        NextRingX = table[ index ] << 8
        NextRingZ = table[index + 2.0] << 8
        SegmentYaw = atan(NextRingX - PreviousRingX, NextRingZ - PreviousRingZ)
    }
    SegmentLength = (((NextRingZ - PreviousRingZ) >> 8) * cos(-SegmentYaw)) - (((NextRingX - PreviousRingX) >> 8) * sin(-SegmentYaw)) >> 12
    if (SegmentLength <= 0) {
        SegmentLength = 1
    }
    x = NextRingX
    z = NextRingZ
}

inline sub UpdateRacerRingProgress() {
    var table, index
    table = RingPathProgress
    index = NextRing - 1
    if (index < 0) {
        index = 0
    }
    PreviousRingProgress = table[index << 8]
    index = NextRing
    if (index >= RacerRingCount) {
        index = RacerRingCount - 1
    }
    NextRingProgress = table[index << 8]
}

inline sub CheckRingCrossing() {
    var px, pz
    RingCrossed = false
    px = (player -> x - x) >> 8
    pz = (player -> z - z) >> 8
    {
        var yc, ys
        yc = cos(-roty)
        ys = sin(-roty)
        vecz = ((pz * yc) - (px * ys)) >> 4
        vecx = ((pz * ys) + (px * yc)) >> 4
        vecy = player -> y - y
        RingClearance = abs(vecy) + abs(vecx)
    }
    if (RingClearance < 9.5m) {
        px = vecx >> 8
        RingDistanceSquared = (px * px) + ((vecy >> 8) * (vecy >> 8))
        if (RingDistanceSquared <= ((4.75m >> 8) * (4.75m >> 8))) {
            if (vecz >= 0) {
                pz = 1
            }
            else {
                pz = -1
            }
            if (PlayerSide && PlayerSide != pz) {
                RingCrossed = 1
            }
            PlayerSide = pz
        }
        else {
            PlayerSide = 0
        }
    }
    else {
        PlayerSide = 0
    }
}

state BaronRail_Init { // 0
    stateflag 0x1
    statusc 0x0
    code(owner, place) {
        RacePosition = place + 1
        spawn(BaROC, S_TEXT)
        PositionTextOBJ = objectspawned
        playnull()
        playnull()
        if (owner) {
            creator = objectget(owner)
        }
        if (!creator) {
            KillEntity()
            changestate(Kill)
        }
        changestate(BaronRail_Race)
    }
}

state BaronRail_Race { // 1
    stateflag 0x1
    statusc 0x0
    code() {
        sleepnull()
    }
    event(e, a) {
        accevif (e == Event14) {
            RacePosition = a[0]
            save (creator) {
                creator = PositionTextOBJ
                sendevent(EventTriggered, creator)
            }
        }
        accevif (e == EventRaceFinish) {
            if (RacePosition <= 1) {
                unless (SAVEDGEMPOOL1 & 0x200) {
                    unless (GEMPOOL1 & 0x200) {
                        spawn2(FruiC, FruiC_S_FRUIT_AUTO, 1, 309.0, 0)
                    }
                }
            }
            else {
                miscfunc(null, player, 23, 12)
            }
            sendevent(EventWarp, player, 0)
        }
    }
    trans {
        PlayerProgress = creator -> PlayerProgress
    }
}

state BaronRacer_Init { // 2
    stateflag 0x1
    statusc 0x0
    code(owner, start, cruise, rings, order, rolls, deaths, slow) {
        pathprog = start
        CruiseSpeed = cruise
        RacerRingCount = rings
        RacerOrder = order
        RollRingMask = rolls
        playnull()
        playnull()
        playnull()
        DeathCount = SECTIONDEATHCOUNT >> 8
        if (!GLOBAL_105, !(SAVEDGEMPOOL1 & 0x200), !(GEMPOOL1 & 0x200)) {
            DeathCount = 0
        }
        if (DeathCount) {
            if (DeathCount > deaths) {
                DeathCount = deaths
            }
            CruiseSpeed += (slow - CruiseSpeed) * DeathCount / deaths
        }
        PathSpeed = CruiseSpeed
        if (owner) {
            creator = objectget(owner)
        }
        if (!creator) {
            KillEntity()
            changestate(Kill)
        }
        TrackLength = creator -> pathlen
        vfx = (vfx & 0xFFFFFF00) | 0x5
        zindex = 0
        AheadOfPlayer = 1
        BoostFrames = 0
        Rolling = false
        speed = 256G
        BoostTarget = speed
        animframe = 0
        save (pathlen, entity) {
            pathlen = creator -> pathlen
            entity = creator -> entity
            calcpath(pathprog, vtrans)
            var look
            look = pathprog + (PathSpeed << 1)
            if (look >= TrackLength) {
                look = TrackLength - 1
            }
            calcpath(look, vvec)
            var dz = vecz - z
            var dx = vecx - x
            var yaw
            yaw = atan(dx, dz)
            roty = yaw % 360deg
            yaw = -yaw
            var lz = (((dz >> 8) * cos(yaw)) >> 4) - (((dx >> 8) * sin(yaw)) >> 4)
            rotx = atan(y - vecy, lz) % 360deg
            rotz = 0deg
        }
        {
            var table
            table = RingPathProgress
            NextRing = 0
            while (pathprog >= table[NextRing << 8]) {
                NextRing += 1
            }
        }
        UpdateRacerRingProgress()
        if (RollRingMask & (1 << NextRing)) {
            RollStartProgress = NextRingProgress - (PathSpeed * 12 / 25)
        }
        else {
            RollStartProgress = 99999G
        }
        changestate(BaronRacer_Race)
    }
}

state BaronRacer_Race { // 3
    stateflag 0x1
    statusc 0x0
    code() {
        while (1) {
            if (CameraDistance < 85m) {
                if (Rolling && !animframe) {
                    animframe = 1.0
                }
                if (CameraDistance >= 25m) {
                    setanim(VON_LABASS_LOW)
                }
                else if (CameraDistance >= 15m) {
                    setanim(VON_LABASS_MID)
                }
                else {
                    setanim(VON_LABASS_HIGH)
                }
                playframe()
                if (Rolling) {
                    animframe += 1.0
                    if (animframe > 50.0) {
                        animframe = 0
                        Rolling = 0
                    }
                }
            }
            else {
                playnull()
                animframe = 0
            }
        }
    }
    event(e, a) {
        accevcstate(BaronRacer_Finish, e == EventRaceFinish)
    }
    trans {
        GetCameraTrans()
        CameraDistance = distance(vecx, self, DIST_NO_Y)
        PathSpeed = (CruiseSpeed * speed) >> 16
        pathprog = spd(pathprog, PathSpeed)
        if (pathprog >= TrackLength) {
            pathprog -= TrackLength - 1
            changestate(BaronRacer_FlyAway)
        }
        if (pathprog >= RollStartProgress) {
            RollStartProgress = 99999G
            Rolling += 1
        }
        FollowRacerPath()
        if (pathprog >= NextRingProgress) {
            NextRing += 1
            UpdateRacerRingProgress()
            if (NextRing >= RacerRingCount) {
                sendeventif(Event14, creator, !AheadOfPlayer, RacerOrder + 2)
                changestate(BaronRacer_FlyAway)
            }
            if (RollRingMask & (1 << (NextRing - 1))) {
                BoostTarget = 1.28m
            }
            else {
                BoostTarget = 0.96m
            }
            BoostFrames = 62
            soundpitch(5.444)
            sounddecay(6.4s)
            soundplay([Br3jA], 0.9V)
            if (RollRingMask & (1 << NextRing)) {
                RollStartProgress = NextRingProgress - (PathSpeed * 12 / 25)
            }
            else {
                RollStartProgress = 99999G
            }
        }
        RacerProgress = (NextRing << 8) + (((pathprog - PreviousRingProgress) << 8) / (NextRingProgress - PreviousRingProgress))
        PlayerProgress = creator -> PlayerProgress
        if (AheadOfPlayer && PlayerProgress >= RacerProgress) {
            AheadOfPlayer = 0
            sendevent(Event14, creator, RacerOrder + 1)
        }
        if (!AheadOfPlayer && PlayerProgress < RacerProgress) {
            AheadOfPlayer = 1
            sendevent(Event14, creator, RacerOrder + 2)
        }
        if (BoostFrames) {
            BoostFrames -= 1
            speed = seek(speed, BoostTarget, 0x1EB8)
            if (CameraDistance < 35m, !(frametime & 3)) {
                if (RollRingMask & (1 << (NextRing - 1))) {
                    spawn(BarOC, BarOC_S_BOOST, 1, 1, (frametime & 4) << 8)
                }
                else {
                    spawn(BarOC, BarOC_S_BOOST, 1, 0, (frametime & 4) << 8)
                }
            }
        }
        else {
            speed = seek(speed, 256G, 0xF5C)
        }
        rotz = yzapproach
        if (distance(player) < 0.7m, distance(player, DIST_EXACT) < 0.7m) {
            player -> collider = self
        }
    }
}

state BaronRacer_Finish { // 4
    stateflag 0x1
    statusc 0x0
    code() {
        pathprog = spd(pathprog, PathSpeed)
        if (pathprog >= TrackLength) {
            pathprog = pathprog - (TrackLength - 1)
            changestate(BaronRacer_FlyAway)
        }
        changestate(BaronRacer_FlyAway)
    }
}

state BaronRacer_FlyAway { // 5
    stateflag 0x1
    statusc 0x0
    code() {
        while (1) {
            if (animframe) {
                animframe += 1.0
                if (animframe > 50.0) {
                    animframe = 0
                }
            }
            if (CameraDistance >= 25m) {
                setanim(VON_LABASS_LOW)
            }
            else if (CameraDistance >= 15m) {
                setanim(VON_LABASS_MID)
            }
            else {
                setanim(VON_LABASS_HIGH)
            }
            playframe()
        }
    }
    trans {
        GetCameraTrans()
        CameraDistance = distance(vecx, self, DIST_NO_Y)
        if (CameraDistance >= 85m, abs(degdist(atan2(self, vecx), CAMROTY)) > 75deg) {
            KillEntity()
            changestate(Kill)
        }
        FollowRacerPath()
        pathprog = spd(pathprog, PathSpeed)
        if (pathprog >= TrackLength) {
            pathprog -= TrackLength - 1
        }
        rotz = yzapproach
        if (distance(player) < 0.7m, distance(player, DIST_EXACT) < 0.7m) {
            player -> collider = self
        }
    }
}

state RingMaster_Init { // 6
    stateflag 0x1
    statusc 0x0
    code(rings) {
        RingCount = rings
        CurrentRing = 0
        playnull()
        UpdateRingSegment()
        creator = GLOBAL_97
        changestate(RingMaster_Race)
    }
}

state RingMaster_Race { // 7
    stateflag 0x1
    statusc 0x0
    code() {
        sleepnull()
    }
    event(e, a) {
        if (e == Event81) {
            CurrentRing += 1
            UpdateRingSegment()
            broadcastevent(Event82, 0, CurrentRing)
            if (CurrentRing >= RingCount) {
                broadcastevent(EventRaceFinish, 0)
                sendevent(Event20, creator, 0)
                accevcstate(RingMaster_Finished)
            }
            accevret()
        }
    }
    trans {
        sendevent(Event15, creator, self)
        vecx = (player -> x - PreviousRingX) >> 8
        vecz = (player -> z - PreviousRingZ) >> 8
        SegmentProgress = ((vecz * cos(-SegmentYaw)) - (vecx * sin(-SegmentYaw))) >> 4
        if (SegmentProgress < 0) {
            SegmentProgress = 0
        }
        SegmentProgress >>= 8
        if (SegmentProgress >= SegmentLength) {
            SegmentProgress = SegmentLength - 1
        }
        PlayerProgress = (CurrentRing << 8) + ((SegmentProgress << 8) / SegmentLength)
    }

}

state RingMaster_Finished { // 8
    stateflag 0x1
    statusc 0x0
    code() {
        sleepnull()
    }
}

state Ring_Init { // 9
    stateflag 0x1
    statusc 0x0
    code(index, rings, owner, yaw) {
        RingIndex = index
        RingCount = rings
        roty = yaw
        playnull()
        playnull()
        if (owner) {
            creator = objectget(owner)
        }
        if (!creator) {
            KillEntity()
            changestate(Kill)
        }
        SetScale(0.45S)
        zindex = 0
        statusb = FLAG_NO_CAMERA_CLIP
        if (!RingIndex) {
            spawn(BaROC, S_RING_FLAG, 1, 0)
            spawn(BaROC, S_HINT_SHADOW, 1)
        }
        else if (RingIndex == RingCount - 1) {
            spawn(BaROC, S_RING_FLAG, 1, 1)
        }
        animframe = 0
        changestate(Ring_SelectDetail)
    }
}

state Ring_SelectDetail { // 10
    stateflag 0x1
    statusc 0x0
    code() {
        CurrentRing = creator -> CurrentRing
        GetCameraTrans()
        RingCameraDistance = distance(vecx, self, DIST_NO_Y)
        changestateif(Ring_Hidden, RingCameraDistance >= 120m)
        if (RingCameraDistance > 110m) {
            changestateif(Ring_Fade, abs(degdist(atan2(self, vecx), CAMROTY)) < (75deg + 1))
        }
        if (RingIndex == CurrentRing) {
            if (RingCameraDistance >= 16m) {
                changestate(Ring_ActiveFar)
            }
            else {
                changestate(Ring_ActiveNear)
            }
        }
        else {
            if (RingCameraDistance >= 16m) {
                changestate(Ring_InactiveFar)
            }
            else {
                changestate(Ring_InactiveNear)
            }
        }
    }
}

state Ring_InactiveNear { // 11
    stateflag 0x1
    statusc 0x0
    code() {
        CurrentRing = creator -> CurrentRing
        if (RingIndex == CurrentRing + 1) {
            while (1) {
                GetCameraTrans()
                CameraAngle = atan2(self, vecx)
                if (abs(degdist(CameraAngle, CAMROTY)) < (75deg + 1)) {
                    RingCameraDistance = distance(vecx, self, DIST_NO_Y)
                    if (RingCameraDistance >= 16m) {
                        playanim(0, RING_NEXT_NEAR)
                        changestate(Ring_InactiveFar)
                    }
                    playanim(0, RING_NEXT_NEAR)
                }
                else {
                    playnull()
                }
            }
        }
        else {
            while (1) {
                GetCameraTrans()
                if (abs(degdist(atan2(self, vecx), CAMROTY)) < (75deg + 1)) {
                    RingCameraDistance = distance(vecx, self, DIST_NO_Y)
                    if (RingCameraDistance >= 16m) {
                        playanim(0, RING_INACTIVE_NEAR)
                        changestate(Ring_InactiveFar)
                    }
                    playanim(0, RING_INACTIVE_NEAR)
                }
                else {
                    playnull()
                }
            }
        }
    }
    event(e, a) {
        if (e == Event82) {
            accevcstate(Ring_ActiveNear, RingIndex == a[0])
            accevcstate(Ring_InactiveNear, RingIndex == a[0] + 1)
        }
    }
    trans {
        if (STATUS_FIRSTFRAME) {
            PlayerSide = 0
        }
        CheckRingCrossing()
        if (RingCrossed) {
            soundpitch(4.0)
            sounddecay(8s)
            soundplay([Br1jA], 1V)
        }
    }
}

state Ring_InactiveFar { // 12
    stateflag 0x1
    statusc 0x0
    code() {
        CurrentRing = creator -> CurrentRing
        if (RingIndex == CurrentRing + 1) {
            while (1) {
                GetCameraTrans()
                if (abs(degdist(atan2(self, vecx), CAMROTY)) < (75deg + 1)) {
                    RingCameraDistance = distance(vecx, self, DIST_NO_Y)
                    if (RingCameraDistance < 16m) {
                        playanim(0, RING_NEXT_MID)
                        changestate(Ring_InactiveNear)
                    }
                    if (RingCameraDistance >= 35m) {
                        changestateif(Ring_SelectDetail, RingCameraDistance > 110m)
                        playanim(0, RING_NEXT_FAR)
                    }
                    else {
                        playanim(0, RING_NEXT_MID)
                    }
                }
                else {
                    playnull()
                }
            }
        }
        else {
            while (1) {
                GetCameraTrans()
                if (abs(degdist(atan2(self, vecx), CAMROTY)) < (75deg + 1)) {
                    RingCameraDistance = distance(vecx, self, DIST_NO_Y)
                    if (RingCameraDistance < 16m) {
                        playanim(0, RING_INACTIVE_MID)
                        changestate(Ring_InactiveNear)
                    }
                    if (RingCameraDistance >= 35m) {
                        playanim(0, RING_INACTIVE_FAR)
                    }
                    else {
                        playanim(0, RING_INACTIVE_MID)
                    }
                }
                else {
                    playnull()
                }
            }
        }
    }
    event(e, a) {
        if (e == Event82) {
            accevcstate(Ring_ActiveFar, RingIndex == a[0])
            accevcstate(Ring_InactiveFar, RingIndex == a[0] + 1)
        }
    }
}

state Ring_ActiveNear { // 13
    stateflag 0x1
    statusc 0x0
    code() {
        while (1) {
            GetCameraTrans()
            CameraAngle = atan2(self, vecx)
            if (abs(degdist(CameraAngle, CAMROTY)) < (75deg + 1)) {
                setanim(RING_ACTIVE_NEAR)
                animframe += 1.0
                if (animframe >= 40.0) {
                    animframe = 0
                }
                RingCameraDistance = distance(vecx, self, DIST_NO_Y)
                if (RingCameraDistance >= 16m) {
                    playframe()
                    changestate(Ring_ActiveFar)
                }
                playframe()
            }
            else {
                playnull()
            }
        }
    }
    trans {
        if (STATUS_FIRSTFRAME) {
            moda = 0
            PlayerSide = 0
        }
        CheckRingCrossing()
        changestateif(Ring_Passed, RingCrossed)
    }

}

state Ring_ActiveFar { // 14
    stateflag 0x1
    statusc 0x0
    code() {
        moda = 0
        while (1) {
            GetCameraTrans()
            if (abs(degdist(atan2(self, vecx), CAMROTY)) < (75deg + 1)) {
                setanim(RING_ACTIVE_FAR)
                animframe += 1.0
                if (animframe >= 40.0) {
                    animframe = 0
                }
                RingCameraDistance = distance(vecx, self, DIST_NO_Y)
                if (RingCameraDistance < 16m) {
                    playframe()
                    changestate(Ring_ActiveNear)
                }
                changestateif(Ring_SelectDetail, RingCameraDistance > 110m)
                playframe()
            }
            else {
                playnull()
            }
        }
    }
}

state Ring_Passed { // 15
    stateflag 0x1
    statusc 0x0
    code() {
        soundpitch(5.444)
        sounddecay(8s)
        soundplay([Br2jA], 1V)
        sendevent(Event81, creator)
        sendevent(Event60, player, 0)
        interrupter = objectget(ClockBalloonOBJ)
        sendevent(Event3, interrupter, 100.0)
        entitysetspawn(ClockBalloonOBJ, 0)
        interrupter = GLOBAL_11
        sendeventif(EventTriggered, interrupter, interrupter)
        changestate(Ring_InactiveFar)
    }
}

state Ring_Fade { // 16
    stateflag 0x1
    statusc 0x0
    code() {
        if ((RingIndex == CurrentRing) | (RingIndex == CurrentRing + 1)) {
            while (1) {
                CameraAngle = atan2(self, vecx)
                if (abs(degdist(CameraAngle, CAMROTY)) < (75deg + 1)) {
                    moda = (((stalltime - 110m) >> 8) << 12) / 0xFA0
                    playanim(0, RING_NEXT_FADE)
                }
                else {
                    playnull()
                }
            }
        }
        else {
            while (1) {
                CameraAngle = atan2(self, vecx)
                if (abs(degdist(CameraAngle, CAMROTY)) < (75deg + 1)) {
                    moda = (((stalltime - 110m) >> 8) << 12) / 0xFA0
                    playanim(0, RING_INACTIVE_FADE)
                }
                else {
                    playnull()
                }
            }
        }
    }
    event(e, a) {
        if (e == Event82) {
            accevcstate(Ring_Fade, RingIndex == a[0] || RingIndex == a[0] + 1)
        }
    }
    trans {
        if (STATUS_FIRSTFRAME) {
            CurrentRing = creator -> CurrentRing
        }
        GetCameraTrans()
        stalltime = distance(vecx, self, DIST_NO_Y)
        changestateif(Ring_Hidden, stalltime >= 120m)
        changestateif(Ring_SelectDetail, stalltime < 110m)
    }

}

state Ring_Hidden { // 17
    stateflag 0x1
    statusc 0x0
    code() {
        do {
            GetCameraTrans()
            RingCameraDistance = distance(vecx, self, DIST_NO_Y)
            changestateif(Ring_SelectDetail, RingCameraDistance < 120m)
            playnull()
        } while (1)
    }
}

state RingFlag_Init { // 18
    stateflag 0x1
    statusc 0x0
    code(finish) {
        FinishFlag = finish
        zindex = creator -> zindex
        CopyCreatorRot()
        RingIndex = creator -> RingIndex
        statusb = FLAG_NO_CAMERA_CLIP
        changestate(RingFlag_Wave)
    }
}

state RingFlag_Wave { // 19
    stateflag 0x1
    statusc 0x0
    code() {
        if (FinishFlag) {
            animframe = 0
            while (1) {
                GetCameraTrans()
                if (distance(vecx, self, DIST_NO_Y) < 110m, abs(degdist(atan2(self, vecx), CAMROTY)) < (75deg + 1)) {
                    animframe += 1.0
                    if (animframe >= 27.0) {
                        animframe = 0
                    }
                    setanim(FINISH_RING)
                    playframe()
                }
                else {
                    playnull()
                }
            }
        }
        else {
            while (1) {
                GetCameraTrans()
                if (distance(vecx, self, DIST_NO_Y) < 110m, abs(degdist(atan2(self, vecx), CAMROTY)) < (75deg + 1)) {
                    animframe += 1.0
                    if (animframe >= 27.0) {
                        animframe = 0
                    }
                    setanim(START_RING)
                    playframe()
                }
                else {
                    playnull()
                }
            }
        }
    }
    event(e, a) {
        accevcstate(Kill, e == Event82 && RingIndex < a[0])
    }
}

state PositionText_Init { // 20
    stateflag 0x10001
    statusc 0x2
    code() {
        playnull()
        SetVFX2D()
        statusb = FLAG_STRING_CENTER
        TextDefaultColor()
        zindex = 165
        SetRot(0deg)
        SetScale(0x146, 0x207, 0x1000)
        spawn(BaROC, S_FLAG)
        SetTrans(-192.0, -77.0, 0.0)
        RacePosition = creator -> RacePosition
        changestate(PositionText_Display, creator -> RacePosition)
    }
}

state PositionText_Display { // 21
    stateflag 0x10001
    statusc 0x2
    trans => sub AnimatePositionText
    code(rank) {
        do {
            if (var lang = GLOBAL_151; lang == LANG_DE) {
                var v1 = rank
                playanim(0, POSITION_TEXT)
            }
            else if (lang == LANG_IT || lang == LANG_ES) {
                var v1 = rank
                playanim(1, POSITION_TEXT)
            }
            else if (lang == LANG_FR) {
                if (rank == 1) {
                    playanim(2, POSITION_TEXT)
                }
                else {
                    var v1 = rank
                    playanim(3, POSITION_TEXT)
                }
            }
            else if (rank == 1) {
                playanim(4, POSITION_TEXT)
            }
            else if (rank == 2) {
                playanim(5, POSITION_TEXT)
            }
            else if (rank == 3) {
                playanim(6, POSITION_TEXT)
            }
            else {
                var v1 = rank
                playanim(7, POSITION_TEXT)
            }
        } while (1)
    }
    event(e, a) {
        accevif (e == EventTriggered) {
            settrans(AnimatePositionText)
        }
    }
}

sub AnimatePositionText(rank) __trans {
    once {
        TargetScaleX = 0xA3
        TargetScaleY = 0x104
    }
    scalex = seek(scalex, TargetScaleX, 43)
    scaley = seek(scaley, TargetScaleY, 69)
    if (scalex == TargetScaleX) {
        scaley = TargetScaleY
        if (scalex == 0x146) {
            tpc = 0
        }
        else {
            rank = creator -> RacePosition
            TargetScaleX = 0x146
            TargetScaleY = 0x207
        }
    }
}

state Checkered_Flag { // 22
    stateflag 0x10001
    statusc 0x0
    code() {
        SetVFX2D()
        zindex = 160
        SetRot(0deg)
        SetScale(1.2S, 1S, 0.875S)
        SetTrans(-192.0, -94.0, 0.0)
        do {
            playanim(0, CHECKERED_FLAG_1)
            playanim(1, CHECKERED_FLAG_2)
            playanim(2, CHECKERED_FLAG_3)
            playanim(3, CHECKERED_FLAG_4)
            playanim(4, CHECKERED_FLAG_5)
            playanim(5, CHECKERED_FLAG_6)
            playanim(6, CHECKERED_FLAG_7)
            playanim(7, CHECKERED_FLAG_8)
        } while (1)
    }
}

state RollHintShadow_Init { // 23
    stateflag 0x1
    statusc 0x0
    code() {
        zindex = creator -> zindex
        CopyCreatorRot()
        RingIndex = creator -> RingIndex
        spawn(BaROC, S_HINT)
        changestate(RollHintShadow_Visible)
    }
}

state RollHintShadow_Visible { // 24
    stateflag 0x1
    statusc 0x0
    code() {
        sleepanim(0, ROLL_HINT_SHADOW)
    }
    event(e, a) {
        accevcstate(Kill, e == Event82 && RingIndex < a[0])
    }
    trans {
        GetCameraTrans()
        RingCameraDistance = distance(vecx, self, DIST_NO_Y)
        if (RingCameraDistance >= 120m) {
            changestate(RollHintShadow_Hidden)
        }
        else if (RingCameraDistance > 110m) {
            field_60 = (((120m - RingCameraDistance) >> 8) << 12) / 0xFA0
        }
        else if (RingCameraDistance >= 16m) {
            field_60 = 16.0
        }
        else if (RingCameraDistance > 10m) {
            field_60 = (((RingCameraDistance - 10m) >> 8) << 12) / 0x960
        }
        else {
            changestate(RollHintShadow_Hidden)
        }
        moda = 16.0 - field_60
    }

}

state RollHintShadow_Hidden { // 25
    stateflag 0x1
    statusc 0x0
    code() {
        field_60 = 0
        sleepnull()
    }
    event(e, a) {
        accevcstate(Kill, e == Event82 && RingIndex < a[0])
    }
    trans {
        GetCameraTrans()
        RingCameraDistance = distance(vecx, self, DIST_NO_Y)
        changestateif(RollHintShadow_Visible, RingCameraDistance > 10m && RingCameraDistance < 120m)
    }
}

state RollHint_Init { // 26
    stateflag 0x1
    statusc 0x0
    code() {
        zindex = creator -> zindex
        CopyCreatorRot()
        RingIndex = creator -> RingIndex
        zindex += 2
        changestate(RollHint_Display)
    }
}

state RollHint_Display { // 27
    stateflag 0x1
    statusc 0x0
    code() {
        do {
            vecx = creator -> field_60 // TODO: vecx is actually field_60 here but ce is being a bitch. change later
            if (vecx) {
                moda = 16.0 - vecx
                playanim(0, ROLL_HINT)
            }
            else {
                playnull()
            }
        } while (1)
    }
}

state Kill { // 28
    stateflag 0x1
    statusc 0x0
    code() {}
}
