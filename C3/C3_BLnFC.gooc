#gool BLnFC 48 2

#include "..\\Includes\\goolstdlib.gooc"
//gooc -c 3 -r pal "C3\C3_BLnFC.gooc" "C3\Out\C3_BLnFC.nsentry"

#sprite FLARES [Ba3jT]
#tex 0xC0C0C0 0 3 7 9 288 16 16 16
#tex 0x808080 0 3 7 9 288 16 16 16
#tex 0xC0C0C0 0 3 8 9 704 64 64 64
#tex 0x808080 0 3 9 9 832 96 32 32
#tex 0xD0D0D0 0 3 9 9 832 96 32 32
#tex 0xC0C0C0 0 3 10 9 384 24 8 8
#tex 0xC0C0C0 0 3 11 9 304 16 16 16
#tex 0xC0C0C0 0 3 12 9 768 64 64 64
#tex 0xC0C0C0 0 3 13 9 832 64 32 32

#spawn S_MASTER    Flare_Init
#spawn S_SLAVE     Flare_Slave

var FlareVar1, FlareVar2, FlareVar3, FlareVar4, FlareVar5, FlareVar6, FlareVar7, FlareVar8, FlareVar9
var FlareVar10, FlareVar11, LightX, LightY, LightZ, LightPitch, LightYaw, FlareVar17, FlareAlpha
var PitchFalloff, YawFalloff, FlareScreenAngle, RotateFlare, GlareActive

state Flare_Init {
    stateflag 0x1
    statusc 0x2
    code() {
        if (!!GLOBAL_106) {
            return
        }
        GAMEFLAGS |= 0x800000
        LightX = 0
        LightY = 800m
        LightZ = -2400m
        LightPitch = 0deg
        LightYaw = 0deg
        FlareVar17 = 0
        GlareActive = 0
        SetVFX2D()
        TextDefaultScale()
        SetRot(0deg)
        spawn(BLnFC, S_SLAVE, 1, 1.0, -3.0,  0.0)
        spawn(BLnFC, S_SLAVE, 1, 2.0, -2.0,  1.0)
        spawn(BLnFC, S_SLAVE, 1, 3.0,  2.0,  3.0)
        spawn(BLnFC, S_SLAVE, 1, 4.0,  2.2,  4.0)
        spawn(BLnFC, S_SLAVE, 1, 5.0,  6.0,  5.0)
        spawn(BLnFC, S_SLAVE, 1, 6.0,  8.0,  6.0)
        spawn(BLnFC, S_SLAVE, 1, 7.0,  11.0, 7.0)
        spawn(BLnFC, S_SLAVE, 1, 8.0,  12.0, 8.0)
        spawn(BLnFC, S_SLAVE, 1, 0.0,  0.0,  2.0)
        changestate(Flare_Master)
    }
}

state Flare_Master {
    stateflag 0x400001
    statusc 0x2
    code() {
        sleepnull()
    }
    event(e, a) {
        if (e == Event80 || e == Event19) {
            GAMEFLAGS &= ~0x800000
            accevcstate(Flare_Stop)
        }
    }
    trans {
        FlareAlpha = 0
        YawFalloff = abs(degdist(CAMROTY, LightYaw))
        if (YawFalloff > 90deg) {
            return
        }
        x = LightX - CAMTRANSX
        y = LightY - CAMTRANSY
        z = LightZ - CAMTRANSZ
        var0 = abs(x) + (abs(y) + abs(z))
        while (var0 > 40m) {
            if (var0 > 5m) {
                x >>= 3
                y >>= 3
                z >>= 3
            }
            else {
                x >>= 1
                y >>= 1
                z >>= 1
            }
            var0 = abs(x) + (abs(y) + abs(z))
        }
        vecx = CAMTRANSX
        vecy = CAMTRANSY
        x += CAMTRANSX
        y += CAMTRANSY
        z += CAMTRANSZ
        vecz = CAMTRANSZ
        LightPitch = atan2_3d(self, vecx)
        PitchFalloff = abs(degdist(CAMROTX, LightPitch)) << 1
        if (PitchFalloff > 90deg) {
            PitchFalloff = 90deg
        }
        YawFalloff <<= 1
        if (YawFalloff > 90deg) {
            YawFalloff = 90deg
        }
        if (PitchFalloff < 90deg) {
            FlareAlpha = (cos(PitchFalloff) * cos(YawFalloff)) >> 12
            if (FlareAlpha >= 7.5) {
                var0 = ((FlareAlpha - 7.5) * 20) >> 8
                if (var0 > 1.0) {
                    var0 = 1.0
                }
                if (var0 < 0) {
                    var0 = 0
                }
                var0 += 32
                if (!(player -> stateflag & 0x20)) {
                    GAMEFLAGS |= 0x800000
                    FADECONTROL = var0
                    GlareActive = 1
                }
            }
            else if (GlareActive) {
                if (!(player -> stateflag & 0x20)) {
                    FADECONTROL = 0
                    GlareActive = 0
                }
            }
        }
        if (FlareAlpha) {
            moveto2d(null, 0, 0)
            FlareScreenAngle = atan(y, x)
            vely = (((-y) << 1) + (((-y) << 1) >> 2)) / 12
            velx = (((-x) << 1) + (((-x) << 1) >> 2)) / 12
        }
    }
}

state Flare_Slave {
    stateflag 0x1
    statusc 0x2
    __transargs
    code(type, offset, frame) {
        sleepframe(frame)
    }
    trans {
        if (STATUS_FIRSTFRAME) {
            zindex = 4000
            setanim(FLARES)
            RotateFlare = false
            SetVFX2D()
            if (type == 0) {
                scalex = 0x40E
                scaley = 0x40E
            }
            else if (type == 1.0) {
                scalex = 0x103
                scaley = 0x103
                RotateFlare = 1
            }
            else if (type == 2.0) {
                scalex = 0x103
                scaley = 0x103
                RotateFlare = 1
            }
            else if (type == 3.0) {
                scalex = 0x207
                scaley = 0x207
            }
            else if (type == 4.0) {
                scalex = 0x103
                scaley = 0x103
            }
            else if (type == 5.0) {
                scalex = 0x81
                scaley = 0x81
            }
            else if (type == 6.0) {
                scalex = 0x103
                scaley = 0x103
            }
            else if (type == 7.0) {
                scalex = 0x40E
                scaley = 0x40E
            }
            else if (type == 8.0) {
                scalex = 0x207
                scaley = 0x207
            }
        }
        FlareAlpha = creator -> FlareAlpha
        if (FlareAlpha) {
            x = creator -> x
            y = creator -> y
            z = creator -> z
            velx = creator -> velx
            vely = creator -> vely
            velz = creator -> velz
            FlareScreenAngle = creator -> FlareScreenAngle
            x += (velx * offset) >> 8
            y += (vely * offset) >> 8
            if (RotateFlare) {
                rotz = FlareScreenAngle + 45deg
            }
            moda = 16.0 - FlareAlpha
            statusb &= ~FLAG_INVISIBLE
        }
        else {
            statusb |= FLAG_INVISIBLE
        }
    }
}

state Flare_Stop {
    stateflag 0x20
    statusc 0x0
    code() {
        GAMEFLAGS &= ~0x800000
    }
}
