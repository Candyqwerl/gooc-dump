event EventHit           => state Fruit_Collect
event EventSpinHit       => state Fruit_Fling
event EventHitInvincible => state Fruit_Collect
event Event12            => state Kill

expr FRUIT_ID_POWER    = 700.0
expr RELIC_ID_PLATINUM = 600.0
expr RELIC_ID_GOLD     = 500.0
expr RELIC_ID_SAPPHIRE = 400.0
expr FRUIT_ID_NUMBERS  = 110.0

expr FRUIT_ID_GEM      = 300.0
expr FRUIT_ID_CRYSTAL  = 200.0
expr FRUIT_ID_NONE     = 106.0
expr FRUIT_ID_DOCTOR   = 102.0
expr FRUIT_ID_1UP      = 97.0
expr FRUIT_ID_WUMPA    = 76.0

var FruitAmount, FruitFrame, FruitGroundY, FruitEvent,
    FruitCounted, FruitParentDoctorID, FruitDetached,
    FruitParentID, FruitVar9, FruitVar10, FruitTransFunc

expr FruitReward = FruitVar9
expr FruitItemID = FruitVar10
expr BazookaAimLimitX = FruitVar9
expr BazookaAimLimitY = FruitVar10
expr BazookaNoTargetLock = stalltime

state Fruit_Wumpa { // 0
    code(flags) {
        if (GLOBAL_173 && LEVEL != LEVEL_EggipusRex) {
            KillEntity()
            return
        }
        vecy = flags
        FruitInit(76.0, 0)
    }
}

state Fruit_None { // 1
    code() {
        FruitInit(106.0, 0)
    }
}

state Pickup_Willy { // 2
    code(flags) {
        if (GLOBAL_173) {
            KillEntity()
            return
        }
        vecy = flags
        if (vecy & 0x1) {
            vfx = (vfx & 0xFFFFFF00) | 0x1
        }
        if (entitygetstate(3)) {
            FruitInit(76.0, 0)
        }
        else {
            FruitInit(97.0, id)
        }
    }
}

state Pickup_Doctor { // 3
    code() {
        FruitInit(102.0, -1)
    }
}

state Crystal { // 4
    code(item_id, nx, ny, nz, cr, cg, cb) {
        SetColor1(cr, cg, cb)
        SetColor2(nx, ny, nz)
        if (item_id) {
            FruitItemID = item_id
        }
        else {
            FruitItemID = LEVEL
        }
        CheckItemPool(FruitItemID >> 8, SAVEDCRYSTALPOOL1, SAVEDCRYSTALPOOL2)
        v0 = misc
        CheckItemPool(FruitItemID >> 8, CRYSTALPOOL1, CRYSTALPOOL2)
        field_61 = misc
        unless (entitygetstate(3), v0, field_61) {
            unless (LEVEL == LEVEL_HotCoco 
                || LEVEL == LEVEL_SkiCrazed
                || LEVEL == LEVEL_TellNoTales
                || LEVEL == LEVEL_MakinWaves
                || LEVEL == LEVEL_RingsOfPower
                || LEVEL == LEVEL_MadBombers
                || LEVEL == LEVEL_ByeByeBlimps) {
                    spawn(ShadC, ShadC_S_SHADOW, 1, 0, 1S, 0)
                }
            FruitInit(200.0, id)
        }
        KillEntity()
    }
}

state Gem { // 5
    code(item_id, nx, ny, nz) {
        SetColor2(nx, ny, nz)
        if (item_id) {
            FruitItemID = item_id
        }
        else {
            FruitItemID = LEVEL
        }
        CheckItemPool(FruitItemID >> 8, SAVEDGEMPOOL1, SAVEDGEMPOOL2)
        v0 = misc
        CheckItemPool(FruitItemID >> 8, GEMPOOL1, GEMPOOL2)
        field_61 = misc
        if (!(entitygetstate(3) || v0 || field_61) || LEVEL == LEVEL_GameWin2) {
            FruitInit(300.0, id)
        }
        KillEntity()
    }
}

expr GEM_RED    = 58.0
expr GEM_GREEN  = 59.0
expr GEM_PURPLE = 60.0
expr GEM_BLUE   = 61.0
expr GEM_YELLOW = 62.0

sub SetGemColor(reward) { // S-166
    if (reward == GEM_RED) {
        SetColor1(0x6C, 0x08, 0x08)
        setanim(GEM_1)
    }
    else if (reward == GEM_GREEN) {
        SetColor1(0x08, 0x6C, 0x08)
        setanim(GEM_3)
    }
    else if (reward == GEM_PURPLE) {
        SetColor1(0x6C, 0x08, 0x6C)
        setanim(GEM_4)
    }
    else if (reward == GEM_BLUE) {
        SetColor1(0x00, 0x00, 0x80)
        if (animseq != getanim(GEM_1)) {
            scalex = scalex * 1.2 >> 8
            scaley = scaley * 0.6 >> 8
            scalez = scalez * 1.2 >> 8
        }
        setanim(GEM_1)
    }
    else if (reward == GEM_YELLOW) {
        SetColor1(0x80, 0x80, 0x00)
        if (animseq != getanim(GEM_1)) {
            scalex = scalex * 0.9 >> 8
            scaley = scaley * 1.2 >> 8
            scalez = scalez * 0.9 >> 8
        }
        setanim(GEM_1)
    }
    else {
        SetColor1(0x78, 0x78, 0x8A)
        setanim(GEM_1)
    }
    moda = 4.0
    SetColor2(0x00, 0x259, 0xFD4)
}

sub SetRelicColor(reward) { // S-236
    if (reward >= RELIC_ID_PLATINUM) {
        SetColor1(0xFF, 0xED, 0xE9)
    }
    else if (reward >= RELIC_ID_GOLD) {
        SetColor1(0xD8, 0xD2, 0x09)
    }
    else {
        SetColor1(0x20, 0xA5, 0xFF)
    }
    SetColor2(-0xBFF, 0xA26, -0x302)
    moda = 4.0
}

inline sub FruitPlayNextFrame() {
    if (FruitReward <= 96.0) {
        animframe = (animframe + 1.0) % 14.0
        playframe()
    }
    else {
        playframe(FruitFrame)
    }
}

sub FruitHop(p) { // S-256
    if (p) {
        save (statusb, groundy) {
            statusb = FLAG_PHYSICS_ENGINE | FLAG_GRAVITY | FLAG_SOLID_GROUND | 0x100000
            groundy = FruitGroundY
            vely = p
            if (FruitReward == 96.0) {
                velx = randi(-0.75m, 0.75m)
                velz = randi(-0.75m, 0.75m)
            }
            FruitPlayNextFrame()
            FruitPlayNextFrame()
            FruitPlayNextFrame()
            do { FruitPlayNextFrame() } until (STATUS_GROUNDLAND)
        }
    }
}

inline sub FruitUpdateFloat(p, c) {
    playframe()
    y += (sin((p * 360deg + 180deg) / 62) * 0.0125m >> 12) + c * (1m / 102400)
}

state Fruit_Idle { // 6
    stateflag 0x201
    statusc 0
    code() {
        if (FruitReward >= FRUIT_ID_CRYSTAL) {
            statusc |= 0x1000000
        }
        do (var v1, v2 = FruitGroundY + 0.3m) {
            y = v2
            FruitUpdateFloat(0, -4)
            FruitUpdateFloat(1, 1)
            FruitUpdateFloat(2, -17)
            FruitUpdateFloat(3, -9)
            FruitUpdateFloat(4, -5)
            FruitUpdateFloat(5, -10)
            FruitUpdateFloat(6, -20)
            FruitUpdateFloat(7, -9)
            FruitUpdateFloat(8, -25)
            FruitUpdateFloat(9, -21)
            FruitUpdateFloat(10, -16)
            FruitUpdateFloat(11, -25)
            FruitUpdateFloat(12, -21)
            FruitUpdateFloat(13, -30)
            FruitUpdateFloat(14, -25)
            FruitUpdateFloat(15, -9)
            FruitUpdateFloat(16, -14)
            FruitUpdateFloat(17, -29)
            FruitUpdateFloat(18, -23)
            FruitUpdateFloat(19, -25)
            FruitUpdateFloat(20, -17)
            FruitUpdateFloat(21, -21)
            FruitUpdateFloat(22, -14)
            FruitUpdateFloat(23, -23)
            FruitUpdateFloat(24, -9)
            FruitUpdateFloat(25, -24)
            FruitUpdateFloat(26, -8)
            FruitUpdateFloat(27, -9)
            FruitUpdateFloat(28, -7)
            FruitUpdateFloat(29, -1)
            FruitUpdateFloat(30, 7)
            FruitUpdateFloat(31, -8)
            FruitUpdateFloat(32, 0)
            FruitUpdateFloat(33, 6)
            FruitUpdateFloat(34, 9)
            FruitUpdateFloat(35, 7)
            FruitUpdateFloat(36, 23)
            FruitUpdateFloat(37, 8)
            FruitUpdateFloat(38, 23)
            FruitUpdateFloat(39, 14)
            FruitUpdateFloat(40, 21)
            FruitUpdateFloat(41, 17)
            FruitUpdateFloat(42, 25)
            FruitUpdateFloat(43, 23)
            FruitUpdateFloat(44, 30)
            FruitUpdateFloat(45, 15)
            FruitUpdateFloat(46, 9)
            FruitUpdateFloat(47, 26)
            FruitUpdateFloat(48, 31)
            FruitUpdateFloat(49, 23)
            FruitUpdateFloat(50, 27)
            FruitUpdateFloat(51, 18)
            FruitUpdateFloat(52, 22)
            FruitUpdateFloat(53, 27)
            FruitUpdateFloat(54, 11)
            FruitUpdateFloat(55, 23)
            FruitUpdateFloat(56, 13)
            FruitUpdateFloat(57, 7)
            FruitUpdateFloat(58, 11)
            FruitUpdateFloat(59, 20)
            FruitUpdateFloat(60, 2)
            FruitUpdateFloat(61, 7)
            playframe()
        } while (1)
    }
    event(e, a) {
        rejevret(FruitReward >= FRUIT_ID_CRYSTAL && (e == EventSpinHit || e == EventHit || e == EventHitInvincible))
        accevcstate(Fruit_Collect, (e == EventHit || e == EventHitInvincible || e == Event2 || e == EventSlamHit) && a[0] == 0)
        accevcstate(Fruit_Fling, ((e == EventHit || e == EventHitInvincible || e == Event14) || (e == Event66 && LEVEL != LEVEL_EggipusRex)) && a[0])
        if (e == EventDespawn) {
            if (distance(player) < 5m) {
                gamefunc4(self)
            }
        }
        accevcstate(Kill, e == Event1 || e == Event19)
    }
    trans {
        changestateif(Fruit_Collect, !STATUS_FIRSTFRAME && collider, 0)
        if (FruitReward <= 96.0) {
            animframe = (animframe + 1.0) % 14.0
        }
        else {
            animframe = FruitFrame
        }
        call(FruitTransFunc)
    }
}

sub FruitTransRotate() { // S-585
    roty = spd(roty, 45deg)
}

state Fruit_Collect { // 7
    stateflag 0x2
    statusc 0
    code() {
        KillEntity()
        FruitCounted = 1.0
        if (FruitAmount) {
            sendeventif(Event42, player, !(spawn == S_FRUIT_AUTO || FruitReward >= FRUIT_ID_CRYSTAL), 0)
            if (FruitReward == FRUIT_ID_DOCTOR) {
                changestate(Doctor_Collect)
            }
            else if (FruitReward == FRUIT_ID_CRYSTAL || FruitReward == FRUIT_ID_GEM || FruitReward == RELIC_ID_SAPPHIRE || FruitReward == RELIC_ID_GOLD || FruitReward == RELIC_ID_PLATINUM || FruitReward == FRUIT_ID_POWER) {
                if (FruitReward == FRUIT_ID_CRYSTAL) {
                    spawn(9, 63, 1, -1.0, 0, 1m, 0.6S, 50, FruitReward + FruitItemID)
                }
                else {
                    spawn(9, 63, 1, -1.0, 0, 1m, 0.8S, 50, FruitReward + FruitItemID)
                }
                if (FruitParentID) {
                    entitysetstate(FruitParentID, 3)
                }
            }
            else if (FruitReward == FRUIT_ID_1UP) {
                if (FruitParentID && !(GLOBAL_119 & 0x2000 && BONUSSTATE != BONUS_COMPLETED)) {
                    entitysetstate(FruitParentID, 5)
                }
            }
            SetVFX2D()
            moveto2d()
            if (FruitReward >= FRUIT_ID_CRYSTAL) {
                scalex <<= 4
                scaley <<= 4
                scalez <<= 4
                if (FruitReward >= RELIC_ID_SAPPHIRE - 1.0 && FruitReward < FRUIT_ID_POWER) {
                    zindex = 200
                }
                else {
                    zindex = 350
                }
            }
            else {
                zindex = 4000
            }
            vecx = (scalex / (FruitAmount >> 8)) >> 3
            vecy = (scaley / (FruitAmount >> 8)) >> 3
            vecz = (scalez / (FruitAmount >> 8)) >> 3
            while (FruitAmount) {
                changestateif(Fruit_Goto_HUD, FruitAmount == 1.0)
                spawn2(FruiC, S_FRUIT_GOTO_HUD, 1)
                FruitCounted += 1.0
                FruitAmount -= 1.0
                if (FruitAmount) {
                    FruitPlayNextFrame() 
                    FruitPlayNextFrame() 
                    FruitPlayNextFrame() 
                    FruitPlayNextFrame() 
                }
            }
            statusb = FLAG_INVISIBLE
            FruitPlayNextFrame() 
        }
    }
    trans {
        nofirst {
            scalex -= vecx
            scaley -= vecy
            scalez -= vecz
        }
    }
}

state Doctor_Collect { // 8
    stateflag 0x2
    code() {
        creator = player -> creator
        sendevent(Event6, creator, self, FruitParentDoctorID)
        if (!eventaccepted) {
            if (spawn == S_FRUIT_AUTO) {
                return
            }
            else {
                changestate(Fruit_Idle)
            }
        }
        KillEntity()
    }
}

state Fruit_Fling { // 9
    stateflag 0x2
    code() {
        KillEntity()
        if (!rand(3)) {
            troty = GAMEDIR + randi(-50deg, 50deg)
        }
        else {
            troty = rand(360deg)
        }
        speed = 10m
        statusb = FLAG_PHYSICS_ENGINE
        zindex = 0
        soundpitch(4.0)
        sounddecay(5.8s - 1)
        soundplay([spa0A], 0.25V)
        do {
            FruitPlayNextFrame()
        } until (frametime - statetime >= 2s)
    }
    trans {
        if (!STATUS_FIRSTFRAME) {
            y += 0.2m
            speed += 2m
            setvel(speed)
        }
    }
}

inline sub SetFruitScale(sx, sy, sz) {
    if (!vecx) {
        vecx = 1S
    }
    scalex = sx * vecx >> 12
    scaley = sy * vecx >> 12
    scalez = sz * vecx >> 12
}

inline sub SetScaleWumpa() {
    SetFruitScale(0.675S, 0.84375S, 1.2S)
    y += 0.45m
}

inline sub SetScale1Up() {
    SetFruitScale(1.8S, 1.125S, 1.6S)
    y += 0.6m
}

inline sub SetScaleFruitNone() {
    SetFruitScale(0.9S, 1.125S, 1.6S)
    y += 0.6m
}

inline sub SetFruitAnim(anim, frame) {
    setanim(anim)
    FruitFrame = frame
}

expr WillC_S_WILLY = 0x000000
expr ZeppC_S_REWARD_BALLOON = 0x240003
expr CocoC_S_COCO = 0x540000

sub FruitInit(item_id, parent_id) { // S-798
    if (parent -> spawn == WillC_S_WILLY || parent -> spawn == ZeppC_S_REWARD_BALLOON || parent -> spawn == CocoC_S_COCO) {
        FruitDetached = false
    }
    else {
        FruitDetached = true
    }
    FruitTransFunc = 0
    FruitParentID = parent_id
    y += 0.2m
    FruitGroundY = y
    SetVel(0m)
    SetRot(0deg)
    
    if (item_id < 30.0) return;
    if (item_id == 100.0) item_id = (x ^ ((y << 2) ^ (z >> 3))) % 97.0;
    if (item_id == 101.0) item_id = (x ^ ((y << 2) ^ (z >> 3))) % 18.0 + 76.0;

    SetZindexField(32)
    statusb = FLAG_COLLIDABLE | 0x4000000
    SetFruitScale(0.7S, 0.7S, 0.7S)
    FruitAmount = 1.0
    
    if (item_id <= 76.0) {
        setanim(FRUIT_WUMPA, rand(14.0))
        FruitReward = FRUIT_ID_WUMPA
        SetScaleWumpa()
        if (vecy & 4.0) {
            scalez = 4S
        }
    }
    else if (item_id < 96.0) {
        if (spawn == S_FRUIT_AUTO) {
            SetScaleWumpa()
            if (vecy & 4.0) {
                scalez = 4S
            }
            FruitReward = FRUIT_ID_NONE
            SetFruitAnim(FRUIT_WUMPA, 0)
            FruitAmount = ((96.0 - item_id) >> 1) + 1.0 & -1.0
        }
        else {
            do (var fruit = 0) {
                spawn2(FruiC, S_FRUIT_HOP, 1, 96.0, 0)
            } while ({ fruit += 1.0 }; fruit < ((96.0 - item_id) >> 1) + 1.0)
            playnull()
            return
        }
    }
    else if (item_id < 97.0) {
        animframe = rand(14.0)
        SetScaleWumpa()
        SetFruitAnim(FRUIT_WUMPA, 0)
        FruitReward = 96.0
    }
    else if (item_id <= 97.0) {
        SetFruitAnim(PICKUP_WILLY, 0)
        SetScale1Up()
        FruitReward = FRUIT_ID_1UP
    }
    else if (item_id == 102.0) {
        FruitParentDoctorID = FruitParentID
        FruitParentID = 0
        SetFruitAnim(PICKUP_DOCTOR, 0)
        SetScale1Up()
        FruitReward = FRUIT_ID_DOCTOR
    }
    else if (item_id == 106.0) {
        FruitAmount = 20.0
        SetFruitAnim(FRUIT_WUMPA, 0)
        SetScaleFruitNone()
        FruitReward = FRUIT_ID_NONE
    }
    else if (item_id >= 700.0) {
        FruitTransFunc = getins(FruitTransRotate)
        SetFruitScale(1S, 1S, 1S)
        y += 1.5m
        setanim(POWER)
        FruitReward = FRUIT_ID_POWER
        FruitFrame = 0
        FruitItemID = item_id - FRUIT_ID_POWER
        statusb |= 0x100000
        stalltime = FruitItemID >> 8
        soundpitch(0x4B7)
        soundsetup(0, self, 11)
        sounddecay(0xF0)
        soundsetup(0, self, 8)
        soundplay([Pu10A], 1V)
    }
    else if (item_id >= 399.0) {
        vfx = (vfx & 0xFFFFFF00) | 0xA
        vfx = (vfx & 0xFF00FFFF) | 0x30000
        FruitTransFunc = getins(FruitTransRotate)
        SetRelicColor(item_id)
        SetFruitScale(1S, 1S, 1S)
        SetFruitAnim(RELIC, 0)
        FruitReward = (item_id / 100.0) * 100.0
        FruitItemID = item_id - FruitReward
        zindex = 100
    }
    else if (item_id >= 300.0) {
        vfx = (vfx & 0xFFFFFF00) | 0xA
        vfx = (vfx & 0xFF00FFFF) | 0x30000
        FruitTransFunc = getins(FruitTransRotate)
        if (spawn == S_FRUIT_HOP || spawn == S_FRUIT_AUTO) {
            FruitDetached = false
            FruitItemID = item_id - FRUIT_ID_GEM
            FruitReward = FRUIT_ID_GEM
        }
        if (spawn != S_GEM) {
            SetColor2(0x000, 0x61F, 0xEC8)
        }
        SetFruitScale(1S, 1S, 1S)
        SetGemColor(FruitItemID)
        FruitReward = FRUIT_ID_GEM
        FruitFrame = 0
    }
    else if (item_id >= 200.0) {
        vfx = (vfx & 0xFFFFFF00) | 0xA
        vfx = (vfx & 0xFF00FFFF) | 0x30000
        if (spawn == S_FRUIT_HOP || spawn == S_FRUIT_AUTO) {
            FruitItemID = LEVEL
        }
        FruitTransFunc = getins(FruitTransRotate)
        if (spawn != S_CRYSTAL) {
            SetColor1(0x00, 0x80, 0x00)
            SetColor2(-0xCCC, -0x800, 0x000)
        }
        moda = 4.0
        setanim(CRYSTAL)
        FruitFrame = 0
        SetFruitScale(1S, 1S, 1S)
        FruitReward = FRUIT_ID_CRYSTAL
        if (LEVEL != LEVEL_IntroEN) {
            spawn(DispC, DispC_S_CRYSTAL_GLOW, 1, 1)
        }
    }
    else if (item_id >= 110.0 && GLOBAL_173) {
        setanim(FLYING_NUMBERS)
        FruitFrame = item_id - 111.0
        SetFruitScale(0.6S, 0.6S, 1S)
        y += 0.6m
        FruitReward = FRUIT_ID_NUMBERS
        FruitItemID = item_id - FRUIT_ID_NUMBERS
    }
    else {
        return
    }
    if (FruitDetached) {
        movetolist(3.0, self)
    }
    if (spawn == S_FRUIT_AUTO) {
        statusc &= ~0x12
        changestate(Fruit_Collect, 0)
    }
    else if (spawn == S_FRUIT_HOP) {
        FruitHop(12.64912m)
        statusc &= ~0x12
        changestate(Fruit_Idle)
    }
    else {
        changestate(Fruit_Idle)
    }
}

state Fruit_Generic { // 10
    statusc 0x12
    code => sub FruitInit
    event(e, a) {
        if (e == EventDespawn) {
            if (distance(player) < 5m) {
                gamefunc4(self)
            }
        }
    }
}

state Fruit_Bonus_Dead { // 11
    stateflag 0x10001
    code(item_id) {
        movetolist(3.0, self)
        SetVFX2D()
        if (item_id == 97.0) {
            SetFruitAnim(PICKUP_WILLY, 0)
            FruitReward = FRUIT_ID_1UP
        }
        else if (item_id == 76.0) {
            setanim(FRUIT_WUMPA, rand(14.0))
            FruitReward = FRUIT_ID_WUMPA
        }
        groundy = y - 0.075m
        statusb = FLAG_PHYSICS_ENGINE
        vely = 0.7m + rand(0.1m)
        if (x < 0m) {
            velx = rand(0.375m)
            velz = rand(0.375m)
        }
        else {
            velx = -rand(0.375m)
            velz = -rand(0.375m)
        }
        do {
            FruitPlayNextFrame()
        } until (y < groundy)
    }
    trans {
        vely = spd(vely, -1.25m)
    }
}

inline sub Set1UpVel(v) {
    setvel(v)
    if (abs(velx) < 2.0) {
        velx = 2.0
    }
    if (abs(vely) < 2.0) {
        vely = 2.0
    }
}

state Fruit_Goto_HUD { // 12
    stateflag 0x10001
    code() {
        movetolist(3.0, self)
        SetVFX2D()
        field_62 = false
        if ((GLOBAL_119 & 0x2000 && BONUSSTATE != BONUS_COMPLETED) && BONUSSTATE != BONUS_CURRENT) {
            return
        }
        var0 = 0
        if (spawn == S_FRUIT_GOTO_HUD) {
            if ((creator -> vfx & 0xFF) != 6) {
                moveto2d()
            }
            FruitReward = getfield(creator, offsetof(FruitReward))
            animseq = creator -> animseq
            animframe = creator -> animframe
            FruitFrame = getfield(creator, offsetof(FruitFrame))
            FruitCounted = getfield(creator, offsetof(FruitCounted))
            FruitAmount = 1.0
            vecz = 0.1S
        }
        else if (spawn == S_WUMPA_BONUS_GOTO_HUD) {
            setanim(FRUIT_WUMPA, rand(14.0))
            FruitFrame = animframe
            FruitReward = FRUIT_ID_WUMPA
            FruitCounted = 1.0
            FruitAmount = 1.0
            vecz = 0.1S
        }
        else if (spawn == S_1UP_GOTO_HUD) {
            if ((creator -> vfx & 0xFF) != 6) {
                moveto2d()
            }
            SetFruitAnim(PICKUP_WILLY, 0)
            scalex <<= 1
            FruitReward = FRUIT_ID_1UP
            FruitAmount = 1.0
            FruitCounted = FruitAmount
            vecz = scalex
        }
        else {
            vecz = scalex
        }
        if (FruitReward == FRUIT_ID_CRYSTAL || FruitReward == FRUIT_ID_GEM || FruitReward == RELIC_ID_SAPPHIRE || FruitReward == RELIC_ID_GOLD || FruitReward == RELIC_ID_PLATINUM || FruitReward == FRUIT_ID_POWER) {
            FruitEvent = Event16
            creator = PICKUPDISPLAY
            if (FruitReward >= FRUIT_ID_POWER) {
                nop()
            }
            else {
                soundpitch(3.625)
                soundsetup(0, self, 11)
                sounddecay(9.6s)
                soundplay([1up0A], 0.9V)
            }
            soundsetup(0, voice, 5)
            vecz = 1S
            FruitAmount = FruitReward + FruitItemID
            if (FruitReward == FRUIT_ID_GEM && (FruitItemID < 10.0 || FruitItemID >= 58.0)) {
                var0 = 301.0
            }
            else {
                var0 = FruitReward
            }
            vecy = -102.0
        }
        else if (FruitReward == FRUIT_ID_1UP) {
            FruitEvent = Event17
            soundpitch(3.625)
            soundsetup(0, 11)
            sounddecay(9.6s)
            soundplay([1up0A], 0.5V)
            soundsetup(0, voice, 5)
            if (BONUSSTATE == BONUS_CURRENT) {
                field_62 = true
                creator = BONUSLIFECOUNTER
                vecz = 0.1S
            }
            else {
                creator = LIFEDISPLAY
                vecz = 0.2S
            }
            if (BONUSSTATE == BONUS_CURRENT) {
                vecy = creator -> y
            }
            else {
                vecy = 102.0
            }
        }
        else if (FruitReward == FRUIT_ID_NUMBERS) {
            FruitEvent = Event16
            creator = GLOBAL_187
            vecy = creator -> y
            FruitAmount = FruitReward + FruitItemID
        }
        else {
            if (spawn == S_FRUIT_AUTO) {
                FruitEvent = Event36
            }
            else {
                FruitEvent = Event2
            }
            soundsetup(0, 11)
            soundpitch((16.0 + (0.8 * (FruitCounted - 1.0) >> 8)) * 0.23 >> 8)
            sounddecay(2.58s)
            soundplay([frt0A], 0.35V)
            soundsetup(0, voice, 5)
            if (BONUSSTATE == BONUS_CURRENT) {
                field_62 = true
                creator = BONUSFRUITCOUNTER
                if (FruitReward <= 96.0) {
                    vecz = 0.05S
                }
            }
            else {
                creator = FRUITDISPLAY
                if (FruitReward <= 96.0) {
                    vecz = 0.1S
                }
            }
            if (BONUSSTATE == BONUS_CURRENT) {
                vecy = creator -> y
            }
            else {
                vecy = 102.0
            }
        }
        if (FruitReward == FRUIT_ID_1UP) {
            LIFEICONTRANSX -= 50.0
            vecx = LIFEICONTRANSX
            troty = atan2(self, vecx)
            Set1UpVel(2.25m)
            do { FruitPlayNextFrame() } until (x >> 8 == vecx >> 8 && y >> 8 == vecy >> 8)
            do (var i = 0) {
                sendevent(EventHit, creator, 0)
                playframe(FruitFrame, 0.1s)
                vfx = (vfx & 0xFFFFFF00) | 1
                playframe(FruitFrame, 0.1s)
                vfx = (vfx & 0xFFFFFF00) | 6
            } while ({ i += 1.0 }; i < 6.0)

            if (LIFEICONTRANSX == vecx) {
                LIFEICONTRANSX = 100.0
            }
        }
        sendevent(Event32, creator, v0, FruitParentID)
        vecx = creator -> x
        troty = atan2(self, vecx)
        Set1UpVel(FruitReward == FRUIT_ID_1UP ? 0.75m : 2.25m)
        unless (FruitReward == FRUIT_ID_NUMBERS && !(creator -> stateflag & 0x100000)) {
            do { FruitPlayNextFrame() } until (x >> 8 == vecx >> 8 && y >> 8 == vecy >> 8)
        }
        sendeventif(FruitEvent, player, !(field_62 && BONUSSTATE != BONUS_CURRENT), FruitAmount)
    }
    event(e, a) {
        accevif (e == Event41) {
            if (FruitReward == FRUIT_ID_1UP, LIFECOUNT < 99.0) {
                LIFECOUNT += 1.0
            }
        }
    }
    trans {
        if (!STATUS_FIRSTFRAME) {
            x = seek(x, vecx, spd(velx))
            y = seek(y, vecy, spd(vely))
            if (scalex > vecz) {
                scalex = scalex * 0.9 >> 8
                scaley = scaley * 0.9 >> 8
            }
            else if (scalex < vecz - 0.08) {
                scalex = scalex * 1.1 >> 8
                scaley = scaley * 1.1 >> 8
            }
        }
    }
}

state Kill { // 13
    stateflag 0x22
    statusc 0x22
    code() {}
}

state Warp_Rewards { // 14
    __transargs
    trans => sub WarpRewardRotate
    code(item_id, nx, ny, nz, cr, cg, cb) {
        settrans(WarpRewardDock)
        WarpRewardDock()
        if (item_id >= RELIC_ID_SAPPHIRE - 1.0) {
            SetRelicColor(item_id)
            SetScale(0.65S)
            setanim(RELIC)
        }
        else if (item_id >= FRUIT_ID_GEM) {
            SetScale(0.6S)
            SetGemColor(item_id - FRUIT_ID_GEM)
        }
        else if (item_id >= FRUIT_ID_CRYSTAL) {
            SetScale(0.65S)
            spawn(DispC, DispC_S_CRYSTAL_GLOW, 1, 0)
            setanim(CRYSTAL)
        }
        SetColor2(nx, ny, nz)
        vfx = (vfx & 0xFFFFFF00) | 0xA
        vfx = (vfx & 0xFF00FFFF) | 0x30000
        moda = 4.0
        zindex = 53
        player = creator
        player -> var0 = self
        SetVec(x, y, z)
        vecy += 20m
        statusb |= FLAG_INVISIBLE
        playframe(0)
        statusb &= ~FLAG_INVISIBLE
        sleepframe(0)
    }
    event(e, a) {
        if (e == EventTriggered) {
            settrans(WarpRewardGotoSlot)
        }
        if (e == Event79) {
            accevcstate(Kill, a[0] != item_id)
        }
    }    
}

sub WarpRewardRotate() { // S-1690
    roty = spd(roty, 90deg)
}

sub WarpRewardDock(item_id, nx, ny, nz, cr, cg, cb) __trans { // S-1963
    once {
        if (item_id < FRUIT_ID_GEM) {
            spawn(DispC, DispC_S_CRYSTAL_GLOW, 1, 0)
        }
    }
    getvert(vtrans, player, 0)
    WarpRewardRotate()
}

sub WarpRewardGotoSlot(item_id, nx, ny, nz, cr, cg, cb) __trans { // S-1701
    once {
        velx = (vecx - x) * 1s / 2s
        vely = (vecy - y) * 1s / 2s
        velz = (vecz - z) * 1s / 2s
        statetime = frametime
        statusb = FLAG_PHYSICS_ENGINE
        spawn(9, 63, 1, -1.0, 0, 0, 0.8S, 100, item_id)
        spawn(9, 52, 2, colr1 >> 1, colg1 >> 1, colb1 >> 1, 1.0, 0.6S)
    }
    if (frametime - statetime >= 2s) {
        statusb = 0
        settrans(WarpRewardRotate)
    }
    WarpRewardRotate()
}

state Bazooka_Projectile { // 15
    stateflag 0x1400001
    code(vertex, target_x, target_y, target_z, target) {
        interrupter = target
        if (target) {
            field_61 = interrupter -> id
            trotx = interrupter -> x
            troty = interrupter -> y
            trotz = interrupter -> z
        }
        else {
            field_61 = 0
        }
        creator = 0
        SetFruitScale(0x67A, 0x819, 0x1000)
        y += 0.2m
        SetRot(0deg, 0deg, rand(360deg))
        statusb = FLAG_PHYSICS_ENGINE
        zindex = 32
        vfx = (vfx & 0xFFFF00FF) | 0x400
        getvert(vtrans, parent, vertex)
        movetolist(5.0, self)
        SetVec(x, y, z)
        velx = target_x - x
        vely = target_y - y
        velz = target_z - z
        var0 = distance(velx, self, 9)
        misc5(velx, 20m)
        animframe = rand(14.0)
        setanim(FRUIT_WUMPA)
        soundpitch(3.263)
        soundplay([Cg10A], 1V)
        do {
            broadcastevent(EventHit, 4, 0)
            if (eventaccepted) {
                spawn(9, 28, 1, -1.0, 200.0, 0.2m, 60, 1)
                changestate(Bazooka_Projectile_Impact)
            }
            if (distance(vecx, self, 0) > var0, interrupter == target, field_61, interrupter -> id == field_61) {
                if (distance(trotx, interrupter, 0) < 1m) {
                    sendevent(EventHit, interrupter, 0)
                    if (eventaccepted) {
                        spawn(9, 28, 1, -1.0, 200.0, 0.2m, 60, 1)
                        changestate(Bazooka_Projectile_Impact)
                    }
                }
            }
            rotz = spd(rotz, 360deg)
            animframe = (animframe + 1.0) % 14.0
            playframe()
        } until (frametime - statetime >= 8s)
    }
    event(e, a) {
        accevcstate(Bazooka_Projectile_Impact, e == EventTriggered)
        accevcstate(Bazooka_Projectile_Kill, e == Event1)
    }
}

state Bazooka_Projectile_Kill { // 16
    stateflag 0x400001
    statusc 0x22
    code() {}
}

state Bazooka_Projectile_Impact { // 17
    stateflag 0x400001
    statusc 0x22
    code() {
        spawn(9, 40, 1, 0, 1)
        WaitChildNull()
    }
}

state Bazooka_Aim { // 18
    stateflag 0x10001
    statusc 0
    __transargs
    code(arg, aim_x, aim_y, aim_z) {
        soundpitch(0.36)
        soundcount(0xFFFF)
        sounddecay(10.18s)
        soundsetup(0, self, 8)
        soundplay([Cg30A], 1V)
        BazookaNoTargetLock = false
        SetColor1(0xFF, 0x00, 0x00)
        SetColor3(0x00, 0x00, 0x00)
        SetScale(1S)
        SetRot(0deg)
        zindex = 133
        trotz = 0
        troty = 0
        aim_x = 0
        aim_y = 0
        aim_z = 0
        speed = 0
        creator = 0
        if (LEVEL == LEVEL_BoneYard || LEVEL == LEVEL_DinoMight) {
            BazookaAimLimitX = 31.0
            BazookaAimLimitY = 20.0
        }
        else {
            BazookaAimLimitX = 36.0
            BazookaAimLimitY = 24.0
        }
        save (trotx, troty, trotz) {
            trotx = 0
            troty = player -> troty
            trotz = 0
            vecx = player -> x
            vecy = player -> y
            vecz = player -> z
            vectransf2(vvec, vvec, 4m, 0, 0)
        }
        moveto2d(null, vvec, vvec) 
        aim_x = vecx / -9
        aim_y = vecy / 9
        do (var v1, v2, v3) {
            BazookaUpdateAim()
            save (trotx, troty, trotz) {
                trotx = -CAMROTX
                troty = CAMROTY + 180deg
                trotz = troty
                SetTrans(0, 0, 0)
                vectransf2(vtrans, vvel, 0.1m, aim_x, aim_y)
            }
            x = CAMTRANSX + (velx << 4)
            y = CAMTRANSY + (vely << 4)
            z = CAMTRANSZ + (velz << 4)
            checkzonecollision(5)         
            var0 = eventaccepted
            if (!var0) {
                playnull()
            }
            else {
                interrupter = var0
                if (!(var0 & 1), !(interrupter -> statusc & 0x2 && !(interrupter -> stateflag & 0x1000000)), !(interrupter -> statusc & 0x1000000)) { 
                    if (BazookaNoTargetLock) {
                        soundpitch(2.903)
                        soundsetup(0, self, 8)
                        soundplay([Cg20A], 1V)
                    }
                    BazookaNoTargetLock = false
                    moda = 16.0
                    creator = interrupter
                }
                else {
                    BazookaNoTargetLock = true
                    moda = 0
                    creator = 0
                }
                getvert(vtrans, parent, 0)
                trotz = atan2_3d(self, vecx)
                troty = atan2(player, vecx)
                colr1 = 100 + rand(155)
                ins81(x, vecx) // draw laser between vtrans and vvec
                SetTrans(vecx, vecy, vecz)
                if (z < player -> z, abs(x - player -> x) < 1.5m, y > player -> y - 0.4m, y < player -> y + 2.5m) {
                    zindex = 40
                }
                else {
                    zindex = 133
                }
                playanim(0, BAZOOKA_CROSSHAIR)
            }
        } while (1)
    }
    event(e, a) {
        accevcstate(Kill, e == Event12)
        rejevret()
    }
}

sub BazookaUpdateAim(arg, aim_x, aim_y, aim_z) __trans { // S-2006
    var input_x = GLOBAL_161
    var input_y = GLOBAL_162
    if (dirhold(PAD_NONE)) {
        speed = seek(speed, 0.0, 12.0)
        input_x = 0
        input_y = 0
    }
    else {
        speed = seek(speed, 40.0, 12.0)
    }
    aim_y = spd(aim_y, (input_y * -speed) >> 7)
    aim_x = spd(aim_x, (input_x * -speed) >> 7)
    if (aim_x < -BazookaAimLimitX) {
        aim_x = -BazookaAimLimitX
    }
    else if (aim_x > BazookaAimLimitX) {
        aim_x = BazookaAimLimitX
    }
    if (aim_y < -BazookaAimLimitY) {
        aim_y = -BazookaAimLimitY
    }
    else if (aim_y > BazookaAimLimitY) {
        aim_y = BazookaAimLimitY
    }
}

state Willy_Bazooka { // 19
    stateflag 0x10000
    statusc 0x3C22
    code() {
        statusb = FLAG_ROT_Y
        trotx = 720deg
        yzapproach = 360deg
        if ((LEVEL == LEVEL_GoneTomorrow || LEVEL == LEVEL_FutureFrenzy) && ZONEFLAGS & 0x800) {
            spawn(77, 11, 1) // FutOC-11 (Reflection)
        }
        playframes(WILLY_BAZOOKA_EQUIP, 0.0, 10.0)
        spawn2(FruiC, S_BAZOOKA_AIM, 1, 2.0, 0, 0, 0)
        setfield(parent, 78.0, misc) // parent -> mem15
        if (!misc) {
            sendevent(Event21, parent, 0x9E1D2)
            statusc = 0
            changestate(Kill)
        }
        do {
            playanim(0, WILLY_BAZOOKA_SHOOT)
            if (buttonpress(PAD_CIRCLE) && !var0) {
                interrupter = getfield(parent, 78.0) // parent -> mem15
                vectransf(vtrans, vvec, 16m, 0, 0)
                vecx -= x
                vecy -= y
                vecz -= z
                spawn(FruiC, S_BAZOOKA_PROJECTILE, 1, 2.0, interrupter -> x, interrupter -> y, interrupter -> z, interrupter -> creator)
                do (var particles = 0) {
                    spawn(9, 21, 1, 1.0, vecx / -2 + randi(-1m, 1m), vecy / -2 + randi(-1m, 1m), vecz / -2 + randi(-1m, 1m), 0.6S, 0, 160, 19)
                } while ({ particles += 1.0 }; particles < 5.0)
                spawn(9, 21, 1, 1.0, vecx / -8, vecy / -8, vecz / -8, 0.4S, 2.4, 160, 81)
                playframes(WILLY_BAZOOKA_SHOOT, 1.0, 7.0)
            }
        } until (var0)
        playframesback(WILLY_BAZOOKA_EQUIP, 10.0, 0.0)
        setfield(parent, 79.0, 0) // parent -> mem16
        playframe()
    }
    event(e, a) {
        if (e == Event12) {
            statusc = 0
            accevcstate(Kill)
        }
        accevif (e == Event14) {
            var0 = true
        }
    }
    trans {
        getvert(vtrans, parent, 0)
        troty = parent -> troty
        vecx = parent -> vecx
        vecy = parent -> vecy
        vecz = parent -> vecz
        vfx = parent -> vfx
        rotz = roty
        zindex = parent -> zindex + 20
        interrupter = getfield(parent, 78.0) // parent -> mem15
        if (interrupter) {
            trotz = interrupter -> trotz
            troty = interrupter -> troty
            if (trotz < -60deg) {
                trotz = -60deg
            }
            else if (trotz > 80deg) {
                trotz = 80deg
            }
        }
        rotx += degdist(rotx, trotz) >> 1
        modb = parent -> modb
    }
}