#spawn S_HEALTH_TICK  Health_Tick
#spawn S_HEALTH       Health
#spawn S_REWARD_DESC  Reward_Description
#spawn S_BACKGROUND   Background

var mem1, mem2, mem3, mem4, mem5, mem6, mem7,
    mem8, mem9, mem10, mem11,
    TextTitleFrame, TextLine1Frame, TextLine2Frame, TextLine3Frame, TextLine4Frame

expr POWER_ID_SUPER_BODY_SLAM = 700.0
expr POWER_ID_DOUBLE_JUMP = 701.0
expr POWER_ID_DEATH_TORNADO_SPIN = 702.0
expr POWER_ID_FRUIT_BAZOOKA = 703.0
expr POWER_ID_SPEED_SHOES = 704.0

state Health { // 0
    statusc 0
    code(h) {
        statusb = creator -> statusb
        vfx = creator -> vfx
        health = creator -> health
        zindex = creator -> zindex - 1
        SetScale(0x146, 0x103, 0x1000)
        setanim(BOSS_HUD)
        x = creator -> vecx + (creator -> x + 31.0 * (h >> 8))
        y = creator -> y + creator -> vecy
        while (h < health) {
            health = creator -> health
            playframe(h + 1.0)
        }
        do (var i = 0) {
            playnull()
            setanim(BOSS_HUD)
            playframe(h + 1.0, 2)
            i += 1.0
        } while (i < 6.0)
    }
}

state Health_Tick { // 1
    statusc 0
    __transargs
    code(boss_health, format) {
        movetolist(1.0, self)
        zindex = 50
        SetTrans(-220.0, 82.9609375, 0.0)
        SetRot(0deg)
        SetVFX2D()
        while (GLOBAL_119 & 4.0 || GLOBAL_106) {
            playnull()
        }
        vecx = 39.0
        SetScale(0x28D, 0x40E, 0x1000)
        if (var level = LEVEL; level == LEVEL_BossTiny) {
            vecy = 15.0
            vecx = 28.0
        }
        else if (level == LEVEL_BossDingodile) {
            vecx = 36.0
        }
        else if (level == LEVEL_BossNTropy) {
            vecx = 34.0
        }
        else if (level == LEVEL_BossNGin2) {
            vecy = -0x38E
            vecx = 37.0
        }
        else if (level == LEVEL_BossCortex2) {
            scalex = 0x2DF
            y = -0x7097
            vecx = 30.0
            vecy += 0x5ED
        }
        do (var i = 0) {
            spawn2(BosBC, S_HEALTH, 1, i)
            i += 1.0
        } while (i < boss_health)
        while (stalltime) {
            playanim(0, BOSS_HUD)
        }
    }
    trans {
        if (LEVEL == LEVEL_BossNGin2) {
            health = creator -> yzapproach
        }
        else {
            health = creator -> health
        }
        if (format == 1) {
            health = boss_health - (health << 8)
        }
        else if (format == 2) {
            health = boss_health - health
        }
        else if (format == 3) {
            health <<= 8
        }
    }
}

state Reward_Description { // 2
    statusc 0
    code(reward) {
        movetolist(1.0, self)
        SetScale(0xA3, 0x103, 0x1000)
        SetTrans(0.0, 87.0, 0.0)
        zindex = 200
        SetRot(0deg)
        TextLine3Frame = 0
        TextLine4Frame = 0
        var0 = 50
        if (var r = reward; r == POWER_ID_SUPER_BODY_SLAM) {
            if (var lang = GLOBAL_151; lang == LANG_DE) {
                TextTitleFrame = 0.0
                TextLine1Frame = 1.0
                TextLine2Frame = 2.0
                TextLine3Frame = 3.0
            }
            else if (lang == LANG_ES) {
                TextTitleFrame = 4.0
                TextLine1Frame = 5.0
                TextLine2Frame = 6.0
                TextLine3Frame = 7.0
                TextLine4Frame = 8.0
            }
            else if (lang == LANG_IT) {
                TextTitleFrame = 9.0
                TextLine1Frame = 10.0
                TextLine2Frame = 11.0
                TextLine3Frame = 12.0
                TextLine4Frame = 13.0
            }
            else if (lang == LANG_FR) {
                TextTitleFrame = 14.0
                TextLine1Frame = 15.0
                TextLine2Frame = 16.0
                TextLine3Frame = 17.0
                TextLine4Frame = 18.0
            }
            else {
                TextTitleFrame = 19.0
                TextLine1Frame = 20.0
                TextLine2Frame = 21.0
                TextLine3Frame = 22.0
                TextLine4Frame = 23.0
            }
        }
        else if (r == POWER_ID_DOUBLE_JUMP) {
            if (var lang = GLOBAL_151; lang == LANG_DE) {
                TextTitleFrame = 24.0
                TextLine1Frame = 25.0
                TextLine2Frame = 26.0
                TextLine3Frame = 27.0
                TextLine4Frame = 28.0
            }
            else if (lang == LANG_ES) {
                TextTitleFrame = 29.0
                TextLine1Frame = 30.0
                TextLine2Frame = 31.0
                TextLine3Frame = 32.0
            }
            else if (lang == LANG_IT) {
                TextTitleFrame = 33.0
                TextLine1Frame = 34.0
                TextLine2Frame = 35.0
                TextLine3Frame = 36.0
                TextLine4Frame = 13.0
            }
            else if (lang == LANG_FR) {
                TextTitleFrame = 37.0
                TextLine1Frame = 38.0
                TextLine2Frame = 39.0
                TextLine3Frame = 40.0
                TextLine4Frame = 41.0
            }
            else {
                TextTitleFrame = 42.0
                TextLine1Frame = 43.0
                TextLine2Frame = 21.0
                TextLine3Frame = 44.0
                TextLine4Frame = 45.0
            }
        }
        else if (r == POWER_ID_DEATH_TORNADO_SPIN) {
            if (var lang = GLOBAL_151; lang == LANG_DE) {
                TextTitleFrame = 46.0
                TextLine1Frame = 47.0
                TextLine2Frame = 48.0
                TextLine3Frame = 49.0
                TextLine4Frame = 50.0
            }
            else if (lang == LANG_ES) {
                TextTitleFrame = 51.0
                TextLine1Frame = 52.0
                TextLine2Frame = 53.0
                TextLine3Frame = 54.0
                TextLine4Frame = 55.0
            }
            else if (lang == LANG_IT) {
                TextTitleFrame = 56.0
                TextLine1Frame = 57.0
                TextLine2Frame = 58.0
                TextLine3Frame = 59.0
            }
            else if (lang == LANG_FR) {
                TextTitleFrame = 60.0
                TextLine1Frame = 61.0
                TextLine2Frame = 62.0
                TextLine3Frame = 63.0
                TextLine4Frame = 64.0
            }
            else {
                TextTitleFrame = 65.0
                TextLine1Frame = 66.0
                TextLine2Frame = 67.0
                TextLine3Frame = 68.0
            }
        }
        else if (r == POWER_ID_FRUIT_BAZOOKA) {
            var0 = 200
            if (var lang = GLOBAL_151; lang == LANG_DE) {
                TextTitleFrame = 69.0
                TextLine1Frame = 70.0
                TextLine2Frame = 71.0
                TextLine3Frame = 72.0
                TextLine4Frame = 73.0
            }
            else if (lang == LANG_ES) {
                TextTitleFrame = 74.0
                TextLine1Frame = 75.0
                TextLine2Frame = 76.0
                TextLine3Frame = 77.0
                TextLine4Frame = 78.0
            }
            else if (lang == LANG_IT) {
                TextTitleFrame = 79.0
                TextLine1Frame = 80.0
                TextLine2Frame = 81.0
                TextLine3Frame = 82.0
                TextLine4Frame = 83.0
            }
            else if (lang == LANG_FR) {
                TextTitleFrame = 84.0
                TextLine1Frame = 85.0
                TextLine2Frame = 86.0
                TextLine3Frame = 87.0
                TextLine4Frame = 88.0
            }
            else {
                TextTitleFrame = 89.0
                TextLine1Frame = 90.0
                TextLine2Frame = 91.0
                TextLine3Frame = 92.0
                TextLine4Frame = 93.0
            }
        }
        else if (r == POWER_ID_SPEED_SHOES) {
            if (var lang = GLOBAL_151; lang == LANG_DE) {
                TextTitleFrame = 94.0
                TextLine1Frame = 95.0
                TextLine2Frame = 96.0
                TextLine3Frame = 97.0
            }
            else if (lang == LANG_ES) {
                TextTitleFrame = 98.0
                TextLine1Frame = 99.0
                TextLine2Frame = 100.0
            }
            else if (lang == LANG_IT) {
                TextTitleFrame = 101.0
                TextLine1Frame = 102.0
                TextLine2Frame = 103.0
            }
            else if (lang == LANG_FR) {
                TextTitleFrame = 104.0
                TextLine1Frame = 105.0
                TextLine2Frame = 106.0
                TextLine3Frame = 107.0
            }
            else {
                TextTitleFrame = 108.0
                TextLine1Frame = 109.0
                TextLine2Frame = 110.0
                TextLine3Frame = 111.0
            }
        }
        spawn2(BosBC, S_BACKGROUND, 1, x, y - 73.0, 0x1327, 0x8E0, var0)
        spawn2(DispC, DispC_S_MENU_TEXT, 1, getanim(TEXT), TextTitleFrame, 0, 0, 3, 4.0, 37.0)
        spawn2(DispC, DispC_S_MENU_TEXT, 1, getanim(TEXT), TextLine1Frame, 0, -37.0, 3, 0, 37.0)
        spawn2(DispC, DispC_S_MENU_TEXT, 1, getanim(TEXT), TextLine2Frame, 0, -56.0, 3, 0, 37.0)
        if (TextLine3Frame) {
            spawn2(DispC, DispC_S_MENU_TEXT, 1, getanim(TEXT), TextLine3Frame, 0, -75.0, 3, 0, 37.0)
        }
        if (TextLine4Frame) {
            spawn2(DispC, DispC_S_MENU_TEXT, 1, getanim(TEXT), TextLine4Frame, 0, -94.0, 3, 0, 37.0)
        }
        if (var lang = GLOBAL_151; lang == LANG_DE) {
            TextTitleFrame = 112.0
        }
        else if (lang == LANG_ES) {
            TextTitleFrame = 113.0
        }
        else if (lang == LANG_IT) {
            TextTitleFrame = 114.0
        }
        else if (lang == LANG_FR) {
            TextTitleFrame = 115.0
        }
        else {
            TextTitleFrame = 116.0
        }
        spawn2(DispC, DispC_S_MENU_TEXT, 1, getanim(TEXT), TextTitleFrame, 0, -125.0, 3, 7.0, 37.0)
        until (buttonpress(PAD_TRIANGLE)) {
            playnull()
        }
        sendevent(Event21, player, 0)
    }
}

state Background { // 3
    statusc 0
    __transargs
    code(px, py, sx, sy, zm) {
        SetTrans(px, py, 0)
        SetScale(sx, sy, 0)
        SetVFX2D()
        sleepanim(0, BACKGROUND)
    }
    trans {
        zindex = parent -> zindex - zm
    }
}


