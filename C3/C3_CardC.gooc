sub DeleteNameChar() { // S-4339
    save (var0, vecx) {
        GetNameLength()
        NameOffset = var0
        if (NameOffset) {
            var0 = 0
            NameOffset -= 1
            WriteNameByte()
        }
    }
}

sub RefreshKeyboard() { // S-4350
    if (KeyboardObject) {
        interrupter = KeyboardObject
        sendevent(Event1, interrupter)
        KeyboardObject = 0
    }
    if (BackspaceObject) {
        interrupter = BackspaceObject
        sendevent(Event1, interrupter)
        BackspaceObject = 0
    }
    spawn2(CardC, S_MENU_TEXT, 1, ITEM_STATIC, -99.0, 32.0, 223.0, 2, 0xA3, 0x103, 0, 0)
    KeyboardObject = objectspawned
    spawn2(CardC, S_MENU_TEXT, 1, ITEM_BACKSPACE, -3.0, -19.0, 224.0, 2, 0xA3, 0x103, 0, 0)
    BackspaceObject = objectspawned
}

sub NavigateKeyboard() { // S-4373
    var direction = var0
    var previous = SelectedItem
    var row = KeyboardRow
    var column = KeyboardColumn
    NavigationTable = KeyboardMap
    ApplyNavigation()
    if (SelectedItem != previous || KeyboardRow != row || KeyboardColumn != column) {
        var0 = 1
    }
    else {
        var0 = 0
    }
}

sub ApplyNavigation() { // S-4391
    var table = NavigationTable
    var direction = var0
    var offset, item, column, row, colmatch, rowmatch
    do {
        item = (table[offset >> 2] << ((3 - ((offset >> 8) & 3)) << 3)) >> 24
        if (!item) {
            var0 = 1
            break
        }
        column = (table[(offset + 1.0) >> 2] << ((3 - (((offset + 1.0) >> 8) & 3)) << 3)) >> 24
        row = (table[(offset + 2.0) >> 2] << ((3 - (((offset + 2.0) >> 8) & 3)) << 3)) >> 24
        if (column == -1) {
            colmatch = KeyboardColumn
        }
        else {
            colmatch = column
        }
        if (row == -1) {
            rowmatch = KeyboardRow
        }
        else {
            rowmatch = row
        }
        if (SelectedItem == item && KeyboardColumn == colmatch && KeyboardRow == rowmatch) {
            offset += (direction * 3) + 3.0
            SelectedItem = (table[offset >> 2] << ((3 - ((offset >> 8) & 3)) << 3)) >> 24
            var0 = (table[(offset + 1.0) >> 2] << ((3 - (((offset + 1.0) >> 8) & 3)) << 3)) >> 24
            if (var0 >= 0) {
                KeyboardColumn = var0
            }
            var0 = (table[(offset + 2.0) >> 2] << ((3 - (((offset + 2.0) >> 8) & 3)) << 3)) >> 24
            if (var0 >= 0) {
                KeyboardRow = var0
            }
            var0 = 0
            break
        }
        offset += 15.0
    } while (1)
}

state Card_Cursor { // 16
    stateflag 0x1
    statusc 0x0
    code() {
        sleepnull()
    }
    event(e, a) {
        accevcstate(Display_Kill, e == Event1)
    }
    trans {
        once {
            SelectedItem = ITEM_NONE
            BlinkItem = ITEM_NONE
            HighlightSlot = 0
            SelectedSlot = 0
        }
        PreviousColumn = KeyboardColumn
        PreviousRow = KeyboardRow
        PreviousItem = SelectedItem
        PrevKeyboardState = KeyboardState
        KeyboardColumn = creator -> KeyboardColumn
        KeyboardRow = creator -> KeyboardRow
        SelectedItem = creator -> SelectedItem
        KeyboardState = creator -> KeyboardState
        if (KeyboardColumn != PreviousColumn || KeyboardRow != PreviousRow || SelectedItem != PreviousItem || KeyboardState != PrevKeyboardState) {
            cascadeevent(Event1, self)
            var px, py, frame, unused
            if (SelectedItem == ITEM_KEYBOARD) {
                px = (KeyboardColumn << 13) - 196.0
                if (var row = KeyboardRow; row == 0) {
                    py = 33.0
                    if (var column = KeyboardColumn; column == 0) {
                        frame = 4.0
                    }
                    else if (column == 1) {
                        frame = 5.0
                    }
                    else if (column == 2) {
                        frame = 6.0
                    }
                    else if (column == 3) {
                        frame = 7.0
                    }
                    else if (column == 4) {
                        frame = 8.0
                    }
                    else if (column == 5) {
                        frame = 9.0
                    }
                    else if (column == 6) {
                        frame = 10.0
                    }
                }
                else if (row == 1) {
                    py = 16.0
                    if (var column = KeyboardColumn; column == 0) {
                        frame = 11.0
                    }
                    else if (column == 1) {
                        frame = 12.0
                    }
                    else if (column == 2) {
                        frame = 13.0
                    }
                    else if (column == 3) {
                        frame = 14.0
                    }
                    else if (column == 4) {
                        frame = 15.0
                    }
                    else if (column == 5) {
                        frame = 16.0
                    }
                    else if (column == 6) {
                        frame = 17.0
                    }
                }
                else if (row == 2) {
                    py = 0
                    if (var column = KeyboardColumn; column == 0) {
                        frame = 18.0
                    }
                    else if (column == 1) {
                        frame = 19.0
                    }
                    else if (column == 2) {
                        frame = 20.0
                    }
                    else if (column == 3) {
                        frame = 21.0
                    }
                    else if (column == 4) {
                        frame = 22.0
                    }
                    else if (column == 5) {
                        frame = 23.0
                    }
                    else if (column == 6) {
                        frame = 24.0
                    }
                }
                else if (row == 3) {
                    py = -17.0
                    if (var column = KeyboardColumn; column == 0) {
                        frame = 25.0
                    }
                    else if (column == 1) {
                        frame = 26.0
                    }
                    else if (column == 2) {
                        frame = 27.0
                    }
                    else if (column == 3) {
                        frame = 28.0
                    }
                    else if (column == 4) {
                        frame = 29.0
                    }
                    else if (column == 5) {
                        frame = 30.0
                    }
                }
                if (frame) {
                    spawn2(CardC, S_MENU_TEXT, 1, ITEM_KEYBOARD, px, py, frame, 3, 0xA3, 0x103, 0, 0)
                }
            }
        }
    }
}

state Card_Exit { // 17
    stateflag 0x1
    statusc 0x2
    code() {
        ReleaseIcons()
        GAMEFLAGS &= ~0x200000
        deloadfile([Cr30T])
        deloadfile([Cr20T])
        GLOBAL_74 = 1.0
        if (GameLoaded) {
            GLOBAL_131 = 0
            playnull(2)
            FadeToBlack()
            WaitFadeNull()
            loadlevel(LEVEL_WarpRoom)
        }
        sendevent(Event14, parent, self)
        deloadfile([ic12D])
        deloadfile([ic22D])
    }
}

state Card_Text { // 18
    stateflag 0x1
    statusc 0x0
    code(item, px, py, frame, mode, scax, scay, align, value) {
        DisplayItem = item
        py = (py << 8) / 216
        SetTrans(px, py, 0)
        TextMode = mode
        SetScale(scax, scay, 0)
        TextDefaultColor()
        if (TextMode == 3) {
            zindex = 600
            TextMode = 2
        }
        else {
            zindex = 200
        }
        SetVFX2D()
        setanim(TEXT)
        if (!align) {
            statusb |= FLAG_STRING_CENTER
        }
        else if (align < 0) {
            statusb |= 0x200000
        }
        if (scax > 0xA3) {
            invincible = FONT_BIG
        }
        TextTrans()
        settrans(TextTrans)
        var arg
        do {
            arg = value
            playframe(frame)
        } while (1)
    }
    event(e, a) {
        accevcstate(Display_Kill, e == Event1)
    }
}

sub TextTrans() { // S-4753
    SelectedItem = creator -> SelectedItem
    BlinkItem = creator -> BlinkItem
    HighlightSlot = creator -> HighlightSlot
    if (HighlightSlot) {
        SelectedSlot = creator -> SelectedSlot
        if (DisplayItem - ITEM_SLOT1 == SelectedSlot >> 8) {
            SelectedItem = DisplayItem
        }
    }
    if (BlinkItem == DisplayItem && ((frametime - statetime) % 12 > 6)) {
        statusb |= FLAG_INVISIBLE
    }
    else {
        statusb &= ~FLAG_INVISIBLE
    }
    if (TextMode == 2) {
        if (SelectedItem == DisplayItem) {
            if (frametime & 3) {
                SetTextColor(0x1FF, 0x190, 0x000, 0x1FF, 0x000, 0x000)
            }
            else {
                SetTextColor(0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF)
            }
        }
        else {
            SetTextColor(0xA0, 0x8B, 0x60, 0xA0, 0x60, 0x6)
        }
    }
    else if (TextMode == 1) {
        if (SelectedItem == DisplayItem) {
            if (frametime & 3) {
                SetTextColor(0x1FF, 0x190, 0x000, 0x1FF, 0x000, 0x000)
            }
            else {
                SetTextColor(0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF)
            }
        }
        else if ((frametime & 31) == 15) {
            SetTextColor(0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF)
        }
        else {
            SetTextColor(0x1FF, 0x190, 0x00, 0x1FF, 0x00, 0x00)
        }
    }
}

state Card_Info { // 19
    stateflag 0x1
    statusc 0x0
    code(current) {
        do (var px, py, item, slot, pass) {
            slot = 0
            do {
                if (current) {
                    item = ITEM_SLOT1
                    px = 30
                    py = 48
                }
                else {
                    if (var choice = slot; choice == 0) {
                        item = ITEM_SLOT1
                        px = -81
                        py = 48
                    }
                    else if (choice == 1.0) {
                        item = ITEM_SLOT2
                        px = -81
                        py = -8
                    }
                    else if (choice == 2.0) {
                        item = ITEM_SLOT3
                        px = 143
                        py = 48
                    }
                    else if (choice == 3.0) {
                        item = ITEM_SLOT4
                        px = 143
                        py = -8 
                    }
                }
                if (pass) {
                    if (current) {
                        var0 = CURRENTLEVEL
                        GetLevelIcon()   
                    }
                    else {
                        var0 = GLOBAL_94[(slot * 0x164) + 0x200]
                    }
                    spawn2(CardC, S_CARD_ICON, 1, ITEM_STATIC, (px - 104) << 8, (py - 32) << 8, slot, var0)
                    if (GLOBAL_94[(slot * 0x164) + 0x100] && !current) {
                        spawn2(CardC, S_MENU_TEXT, 1, item, px << 8, (py - 18) << 8, slot, 2, 0xA3, 0x103, 0, 0)
                    }
                    else {
                        if (current) {
                            var0 = GLOBAL_23
                            if (var0) {
                                misc = 225.0
                            }
                            else {
                                misc = 226.0
                            }
                            spawn2(CardC, S_MENU_TEXT, 1, item, px << 8, py << 8, misc, 2, 0xA3, 0x103, 0, var0)
                        }
                        else {
                            spawn2(CardC, S_MENU_TEXT, 1, item, px << 8, py << 8, slot, 2, 0xA3, 0x103, 0, 0)
                        }
                        if (current) {
                            var0 = -1
                        }
                        else {
                            var0 = slot
                        }
                        GetSaveStats(var0)
                        spawn2(CardC, S_MENU_TEXT, 1, item, (px - 01) << 8, (py - 16) << 8, 227.0, 2, 0xA3, 0x103, -1, var0)
                        spawn2(CardC, S_MENU_TEXT, 1, item, (px + 48) << 8, (py - 16) << 8, 228.0, 2, 0xA3, 0x103, -1, CrystalCount)
                        spawn2(CardC, S_MENU_TEXT, 1, item, (px - 17) << 8, (py - 32) << 8, 228.0, 2, 0xA3, 0x103, -1, GemCount)
                        spawn2(CardC, S_MENU_TEXT, 1, item, (px + 48) << 8, (py - 32) << 8, 228.0, 2, 0xA3, 0x103, -1, RelicCount)
                        spawn2(DispC, DispC_S_INVENTORY, 1, REWARD_CRYSTAL, (px + 62) << 8, ((py - 23) << 8 << 8) / 0xD8, 8)
                        spawn2(DispC, DispC_S_INVENTORY, 1, REWARD_GEM,     (px - 02) << 8, ((py - 41) << 8 << 8) / 0xD8, 8)
                        spawn2(DispC, DispC_S_INVENTORY, 1, REWARD_RELIC,   (px + 62) << 8, ((py - 40) << 8 << 8) / 0xD8, 64)
                    }
                }
                else {
                    spawn2(CardC, S_CARD_BG, 1, ITEM_STATIC, (px - 31) << 8, (py - 25) << 8)
                }
                slot += 1.0
                if (current || slot >= 4.0) { break }
            } while (1)
            if (pass) { break }
            pass = 1
        } while (1)
        sleepnull()
    }
    event(e, a) {
        accevcstate(Display_Kill, e == Event1)
    }
    trans {
        SelectedItem = creator -> SelectedItem
        BlinkItem = creator -> BlinkItem
        HighlightSlot = creator -> HighlightSlot
        SelectedSlot = creator -> SelectedSlot
        SaveIcon1 = creator -> SaveIcon1
        SaveIcon2 = creator -> SaveIcon2
        SaveIcon3 = creator -> SaveIcon3
        SaveIcon4 = creator -> SaveIcon4
    }
}

state Card_Icon { // 20
    stateflag 0x1
    statusc 0x0
    code(item, px, py, frame, icon) {
        DisplayItem = item
        py = (py << 8) / 0xD8
        SetTrans(px, py, 0)
        SetScale(0x28D, 0x40E, 0x0)
        SetVFX2D()
        zindex = 400
        if (var slot = frame; slot == 0) {
            IconHandle = creator -> SaveIcon1
        }
        else if (slot == 1.0) {
            IconHandle = creator -> SaveIcon2 
        }
        else if (slot == 2.0) {
            IconHandle = creator -> SaveIcon3
        }
        else if (slot == 3.0) {
            IconHandle = creator -> SaveIcon4
        }
        if (icon >= 19) {
            icon -= 19
        }
        if (IconHandle) {
            ins76(IconHandle, icon << 8)
            ins77(frame, misc, IconHandle, 0)
        }
        setanim(SAVE_ICON)
        sleepframe(frame)
    }
    event(e, a) {
        accevcstate(Display_Kill, e == Event1)
    }
}

state Card_Background { // 21
    stateflag 0x1
    statusc 0x0
    code(px, py) {
        py = (py << 8) / 0xD8
        SetTrans(px, py, 0)
        SetScale(0x8B3, 0x35C, 0x0)
        SetVFX2D()
        zindex = 100
        setanim(BACKGROUND)
        sleepframe(0.0)
    }
    event(e, a) {
        accevcstate(Display_Kill, e == Event1)
    }
}

state Card_Name { // 22
    stateflag 0x1
    statusc 0x0
    code(item, px, py) {
        NameWord0 = creator -> NameWord0
        NameWord1 = creator -> NameWord1
        NameWord2 = creator -> NameWord2
        NameWord3 = creator -> NameWord3
        NameWord4 = creator -> NameWord4
        spawn2(CardC, S_MENU_TEXT, 1, ITEM_STATIC, px, py, 225.0, 0, 0xA3, 0x103, 1, &NameWord0)
        sleepnull()
    }
    event(e, a) {
        accevcstate(Display_Kill, e == Event1)
    }
}

state Display_Kill { // 23
    stateflag 0x1
    statusc 0x0
    code() {}
}
