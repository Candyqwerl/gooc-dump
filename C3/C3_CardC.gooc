    setval(GLOBAL_94, (SelectedSlot * 0x164) + 0x700, NameWord4)
}

sub GenerateSaveID() { // S-677
    do {
        var0 = rand(0xF423F)
        if (var0 && (var0 != GLOBAL_159 && var0 != GLOBAL_94[10 << 8] && var0 != GLOBAL_94[366 << 8] && var0 != GLOBAL_94[722 << 8] && var0 != GLOBAL_94[1728 << 8])) {
            break
        }
    } while (1)
}

sub SpawnSaveStats() { // S-710
    {
        var current = var0
        var0 = current
        AllocateIcons()
        spawn2(CardC, S_CARD_INFO, 1, current)
        var0 = objectspawned
    }
    var summaries = var0
    interrupter = child -> sibling
    while (interrupter) {
        if (interrupter -> spawn == S_CARD_INFO) {
            break
        }
        interrupter = interrupter -> sibling
    }
    if (interrupter) {
        player = summaries
        child = player -> sibling
        player -> sibling = interrupter -> sibling
        interrupter -> sibling = player
    }
}

sub GetLevelIcon() { // S-732
    var level, table, idx, candidate
    level = var0
    table = LevelSaveIconMap
    do {
        candidate = table[idx]
        if (!candidate) {
            var0 = 0
            break
        }
        if (candidate == level) {
            var0 = table[idx + 1.0]
            break
        }
        idx += 2.0
    } while (1)
}

sub AllocateIcons() { // S-754
    var icon, vido
    var current = var0
    var slot
    ReleaseIcons()
    do {
        if (current) {
            var0 = CURRENTLEVEL
            GetLevelIcon()
            icon = var0
        }
        else {
            icon = GLOBAL_94[(slot * 0x164) + 0x200]
        }
        vido = [ic12D]
        if (icon >= 19) {
            icon -= 19
            vido = [ic22D]
        }
        if (slot == 0.0) {
            SaveIcon1 = ins74(vido, null)
        }
        else if (slot == 1.0) {
            SaveIcon2 = ins74(vido, null)
        }
        else if (slot == 2.0) {
            SaveIcon3 = ins74(vido, null)
        }
        else if (slot == 3.0) {
            SaveIcon4 = ins74(vido, null)
        }
        slot += 1.0
        if (current || slot >= 4.0) {
            break
        }
    } while (1)
}

sub ReleaseIcons() { // S-805
    if (SaveIcon4) {
        ins75(SaveIcon4, null)
        SaveIcon4 = 0
    }
    if (SaveIcon3) {
        ins75(SaveIcon3, null)
        SaveIcon3 = 0
    }
    if (SaveIcon2) {
        ins75(SaveIcon2, null)
        SaveIcon2 = 0
    }
    if (SaveIcon1) {
        ins75(SaveIcon1, null)
        SaveIcon1 = 0
    }
}

