inline sub SetCardTitle(fr, es, en) {
    if (var lang = GLOBAL_151; lang == LANG_FR) {
        TextFrame1 = fr
    }
    else if (lang == LANG_ES) {
        TextFrame1 = es
    }
    else {
        TextFrame1 = en
    }
}

inline sub SetTextLanguage1(fr, de, it, es, en) {
    if (var lang = GLOBAL_151; lang == LANG_FR) {
        TextFrame1 = fr
    }
    else if (lang == LANG_DE) {
        TextFrame1 = de
    }
    else if (lang == LANG_IT) {
        TextFrame1 = it
    }
    else if (lang == LANG_ES) {
        TextFrame1 = es
    }
    else {
        TextFrame1 = en
    }
}

inline sub SetTextLanguage2(fr1, fr2, de1, de2, it1, it2, es1, es2, en1, en2) {
    if (var lang = GLOBAL_151; lang == LANG_FR) {
        TextFrame1 = fr1
        TextFrame2 = fr2
    }
    else if (lang == LANG_DE) {
        TextFrame1 = de1
        TextFrame2 = de2
    }
    else if (lang == LANG_IT) {
        TextFrame1 = it1
        TextFrame2 = it2
    }
    else if (lang == LANG_ES) {
        TextFrame1 = es1
        TextFrame2 = es2
    }
    else {
        TextFrame1 = en1
        TextFrame2 = en2
    }
}

inline sub SetTextLanguage3(fr1, fr2, fr3, de1, de2, de3, it1, it2, it3, es1, es2, es3, en1, en2, en3) {
    if (var lang = GLOBAL_151; lang == LANG_FR) {
        TextFrame1 = fr1
        TextFrame2 = fr2
        TextFrame3 = fr3
    }
    else if (lang == LANG_DE) {
        TextFrame1 = de1
        TextFrame2 = de2
        TextFrame3 = de3
    }
    else if (lang == LANG_IT) {
        TextFrame1 = it1
        TextFrame2 = it2
        TextFrame3 = it3
    }
    else if (lang == LANG_ES) {
        TextFrame1 = es1
        TextFrame2 = es2
        TextFrame3 = es3
    }
    else {
        TextFrame1 = en1
        TextFrame2 = en2
        TextFrame3 = en3
    }
}

inline sub SelectSaveSlot() {
    if (SelectedItem == ITEM_SLOT1) {
        SelectedSlot = 0
    }
    else if (SelectedItem == ITEM_SLOT2) {
        SelectedSlot = 1.0
    }
    else if (SelectedItem == ITEM_SLOT3) {
        SelectedSlot = 2.0
    }
    else if (SelectedItem == ITEM_SLOT4) {
        SelectedSlot = 3.0
    }
}

inline sub CheckCardStatus(error) {
    if (GLOBAL_59 & 2) {
        ErrorType = error
        cascadeevent(Event1, self)
        changestate(Card_Error)
    }
    if (GLOBAL_59 & 4) {
        cascadeevent(Event1, self)
        changestate(Card_Check)
    }
}

inline sub OpenCardMenu() {
    if (DirectLoad) {
        changestate(Card_Load)
    }
    else {
        if (PreferLoad) {
            SelectedItem = ITEM_LOAD
        }
        else {
            SelectedItem = ITEM_SAVE
        }
        changestate(Card_Main)
    }
}

inline sub CardMenuEventCommon(e, a) {
    if (e == Event1 && interrupter != self) {
        accev()
        cascadeevent(Event1, self)
        changestate(Card_Exit)
    }
}

inline sub SoundButtonNavigate() {
    soundpitch(0x7F)
    sounddecay(0xF0)
    soundsetup(0, self, 8)
    soundplay([Mb10A], 1V)
}

inline sub SoundButtonConfirm() {
    soundpitch(4.0)
    sounddecay(0xF0)
    soundsetup(0, self, 8)
    soundplay([tal0A], 0.8V)
    soundsetup(0, voice, 5)
}

state Card_Init { // 0
    stateflag 0x1
    statusc 0x2
    code(load) {
        if (GLOBAL_89 != 99) {
            CURRENTLEVEL = GLOBAL_89
        }
        DirectLoad = load
        PreferLoad = load
        GLOBAL_74 = 0
        BlinkItem = ITEM_NONE
        HighlightSlot = 0
        KeyboardState = 0
        loadfile([ic12D])
        loadfile([ic22D])
        SaveIcon1 = 0
        SaveIcon2 = 0
        SaveIcon3 = 0
        SaveIcon4 = 0
        GameLoaded = 0
        GLOBAL_80 = getanim(TEXT)
        GLOBAL_81 = getanim(COCO_ICON)
        loadfile([Cr30T])
        loadfile([Cr20T])
        SetRot(0deg)
        playnull(21)
        miscfunc(0, player, 10, 15)
        GAMEFLAGS |= 0x200000
        changestate(Card_Check)
    }
}

sub GetSaveStats(slot) { // S-35
    var levels, clear, bosses, sapphire, gold, platinum
    if (slot < 0) {
        var pool1 = SAVEDCRYSTALPOOL1
        var pool2 = SAVEDCRYSTALPOOL2
        misc = 0
        CountPoolBits(GLOBAL_27)
        CountPoolBits(GLOBAL_28)
        levels = misc
        misc = 0
        CountPoolBits(pool1)
        CountPoolBits(pool2)
        CrystalCount = misc
        pool1 = SAVEDGEMPOOL1
        pool2 = SAVEDGEMPOOL2
        misc = 0
        CountPoolBits(pool1)
        CountPoolBits(pool2)
        GemCount = misc
        pool2 &= 0x7C000000
        misc = 0
        CountPoolBits(pool2)
        clear = GemCount - misc
        misc = 0
        CountPoolBits(GLOBAL_150 & 0xFFFF)
        bosses = misc
        sapphire = 0
        gold = 0
        platinum = 0
        pool1 = GLOBAL_175
        pool2 = GLOBAL_177
        CountRelics(pool2, pool1, platinum, gold, sapphire)
        pool1 = GLOBAL_176
        pool2 = GLOBAL_178
        CountRelics(pool2, pool1, platinum, gold, sapphire)
        var0 = CrystalCount + (GemCount + (bosses + (platinum + (gold + sapphire))))
        if (GLOBAL_27 & 0x40) { var0 += 1 }
        if (GLOBAL_27 & 0x08) { var0 += 1 }
        if (GLOBAL_27 & 0x10) { var0 += 1 }
        if (GLOBAL_27 & 0x20) { var0 += 1 }
        if (GLOBAL_27 & 0x80) { var0 += 1 }
        pool1 = GLOBAL_175 | GLOBAL_177
        pool2 = GLOBAL_176 | GLOBAL_178
        if (!(pool1 \ -0x400 && pool2 \ 63 && SAVEDGEMPOOL1 \ -2 && SAVEDGEMPOOL2 \ 0x7C00003F)) {
            if (var0 > 99) {
                var0 = 99
            }
        }
    }
    else {
        var pool1 = GLOBAL_94[(slot * 0x164) + 0x1300]
        var pool2 = GLOBAL_94[(slot * 0x164) + 0x1400]
        misc = 0
        CountPoolBits(GLOBAL_94[(slot * 0x164) + 0x1100])
        CountPoolBits(GLOBAL_94[(slot * 0x164) + 0x1200])
        levels = misc
        misc = 0
        CountPoolBits(pool1)
        CountPoolBits(pool2)
        CrystalCount = misc
        pool1 = GLOBAL_94[(slot * 0x164) + 0x1500]
        pool2 = GLOBAL_94[(slot * 0x164) + 0x1600]
        misc = 0
        CountPoolBits(pool1)
        CountPoolBits(pool2)
        GemCount = misc
        pool2 &= 0x7C000000
        misc = 0
        CountPoolBits(pool2)
        clear = GemCount - misc
        misc = 0
        CountPoolBits(GLOBAL_94[((slot * 0x164) + 0x1000)] & 0xFFFF)
        bosses = misc
        sapphire = 0
        gold = 0
        platinum = 0
        pool1 = GLOBAL_94[(slot * 0x164) + 0x1700]
        pool2 = GLOBAL_94[(slot * 0x164) + 0x1900]
        CountRelics(pool2, pool1, platinum, gold, sapphire)
        pool1 = GLOBAL_94[(slot * 0x164) + 0x1800]
        pool2 = GLOBAL_94[(slot * 0x164) + 0x1A00]
        CountRelics(pool2, pool1, platinum, gold, sapphire)
        var0 = CrystalCount + (GemCount + (bosses + (platinum + (gold + sapphire))))
        if (GLOBAL_94[(slot * 0x164) + 0x1100] & 0x40) { var0 += 1 }
        if (GLOBAL_94[(slot * 0x164) + 0x1100] & 0x08) { var0 += 1 }
        if (GLOBAL_94[(slot * 0x164) + 0x1100] & 0x10) { var0 += 1 }
        if (GLOBAL_94[(slot * 0x164) + 0x1100] & 0x20) { var0 += 1 }
        if (GLOBAL_94[(slot * 0x164) + 0x1100] & 0x80) { var0 += 1 }
        pool1 = GLOBAL_94[(slot * 0x164) + 0x1700] | GLOBAL_94[(slot * 0x164) + 0x1900]
        pool2 = GLOBAL_94[(slot * 0x164) + 0x1800] | GLOBAL_94[(slot * 0x164) + 0x1A00]
        if (!(pool1 \ -0x400 && pool2 \ 63 && GLOBAL_94[(slot * 0x164) + 0x1500] \ -2 && GLOBAL_94[(slot * 0x164) + 0x1600] \ 0x7C00003F)) {
            if (var0 > 99) {
                var0 = 99
            }
        }
    }
    RelicCount = sapphire + (gold + platinum)
}

sub ReadNameByte() { // S-554
    var word
    if (var0 < 4)       { word = NameWord0 }
    else if (var0 < 8)  { word = NameWord1 }
    else if (var0 < 12) { word = NameWord2 }
    else if (var0 < 16) { word = NameWord3 }
    else if (var0 < 20) { word = NameWord4 }
    var0 = word << (-8 * (var0 & 3)) & 0xFF
}

sub WriteNameByte() { // S-581
    var mask = 0xFF
    var value = var0
    var shift
    shift = (NameOffset & 3) << 3
    value <<= shift
    mask = ~(mask << shift)
    if (NameOffset < 4) {
        NameWord0 = (NameWord0 & mask | value)
    }
    else if (NameOffset < 8) {
        NameWord1 = (NameWord1 & mask | value)
    }
    else if (NameOffset < 12) {
        NameWord2 = (NameWord2 & mask | value)
    }
    else if (NameOffset < 16) {
        NameWord3 = (NameWord3 & mask | value)
    }
    else if (NameOffset < 20) {
        NameWord4 = (NameWord4 & mask | value)
    }
}

sub GetNameLength() { // S-621
    var len
    do {
        var0 = len
        ReadNameByte()
        if (!var0) {
            break
        }
        len += 1
    } while (1)
    var0 = len
}

sub CountNameChars() { // S-632
    var count, index
    do {
        var0 = index
        ReadNameByte()
        if (!var0) {
            break
        }
        index += 1
        if (var0 != 0xBC && var0 != 0xBD) {
            count += 1
        }
    } while (1)
    var0 = count
}

sub StoreSaveName() { // S-651
    setval(GLOBAL_94, (SelectedSlot * 0x164) + 0x300, NameWord0)
    setval(GLOBAL_94, (SelectedSlot * 0x164) + 0x400, NameWord1)
