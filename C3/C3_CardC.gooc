state Card_Main { // 11
    stateflag 0x1
    statusc 0x2
    code() {
        var load = 1
        var delete = 1
        var unformat = 1
        var buttons = 5
        HighlightSlot = 0
        var0 = 1
        SpawnSaveStats()
        if (GLOBAL_94[1 << 8] && GLOBAL_94[357 << 8] && GLOBAL_94[713 << 8] && GLOBAL_94[1069 << 8]) {
            load = 0
            delete = 0
            buttons -= 2
            if (SelectedItem == ITEM_LOAD || SelectedItem == ITEM_DELETE) {
                SelectedItem = ITEM_SAVE
            }
        }
        if (!DEBUG) {
            unformat = 0
            buttons -= 1
        }
        unless (SelectedItem == ITEM_LOAD || SelectedItem == ITEM_SAVE || SelectedItem == ITEM_DELETE || SelectedItem == ITEM_EXIT) {
            SelectedItem = ITEM_SAVE
        }
        SetTextLanguage1(
            171.0,
            172.0,
            173.0,
            174.0, 
            175.0)
        spawn2(CardC, S_MENU_TEXT, 1, ITEM_MENU_TITLE, 0, 85.0, TextFrame1, 0, 0xA3, 0x103, 0, 0)
        MenuRowY = -7.0
        if (load) {
            SetTextLanguage1(
                176.0,
                177.0,
                178.0,
                179.0,
                180.0
            )
            spawn2(CardC, S_MENU_TEXT, 1, ITEM_LOAD, 0, MenuRowY, TextFrame1, 2, 0xA3, 0x103, 0, 0)
        }
        MenuRowY -= 19.0
        SetTextLanguage1(
            181.0,
            182.0,
            183.0,
            184.0,
            185.0
        )
        spawn2(CardC, S_MENU_TEXT, 1, ITEM_SAVE, 0, MenuRowY, TextFrame1, 2, 0xA3, 0x103, 0, 0)
        MenuRowY -= 19.0
        if (delete) {
            SetTextLanguage1(
                186.0,
                187.0,
                188.0,
                189.0,
                190.0
            )
            spawn2(CardC, S_MENU_TEXT, 1, ITEM_DELETE, 0, MenuRowY, TextFrame1, 2, 0xA3, 0x103, 0, 0)
            MenuRowY -= 19.0
        }
        if (unformat) {
            SetTextLanguage1(
                191.0,
                192.0,
                193.0,
                194.0,
                195.0
            )
            spawn2(CardC, S_MENU_TEXT, 1, ITEM_UNFORMAT, 0, MenuRowY, TextFrame1, 2, 0xA3, 0x103, 0, 0)
            MenuRowY -= 19.0
        }
        SetTextLanguage1(
            76.0,
            77.0,
            78.0,
            79.0,
            80.0
        )
        spawn2(CardC, S_MENU_TEXT, 1, ITEM_EXIT, 0, MenuRowY, TextFrame1, 2, 0xA3, 0x103, 0, 0)
        MenuRowY -= 19.0
        playnull(5)
        do {
            if (dirpress(PAD_N)) {
                SoundButtonNavigate()
                if (SelectedItem == ITEM_LOAD) {
                    SelectedItem = ITEM_EXIT
                }
                else if (SelectedItem == ITEM_SAVE) {
                    if (load) {
                        SelectedItem = ITEM_LOAD
                    }
                    else {
                        SelectedItem = ITEM_EXIT
                    }
                }
                else if (SelectedItem == ITEM_DELETE) {
                    SelectedItem = ITEM_SAVE
                }
                else if (SelectedItem == ITEM_UNFORMAT) {
                    if (delete) {
                        SelectedItem = ITEM_DELETE
                    }
                    else {
                        SelectedItem = ITEM_SAVE
                    }
                }
                else if (SelectedItem == ITEM_EXIT) {
                    if (unformat) {
                        SelectedItem = ITEM_UNFORMAT
                    }
                    else if (delete) {
                        SelectedItem = ITEM_DELETE
                    }
                    else {
                        SelectedItem = ITEM_SAVE
                    }
                }
            }
            if (dirpress(PAD_S)) {
                SoundButtonNavigate()
                if (SelectedItem == ITEM_LOAD) {
                    SelectedItem = ITEM_SAVE
                }
                else if (SelectedItem == ITEM_SAVE) {
                    if (delete) {
                        SelectedItem = ITEM_DELETE
                    }
                    else if (unformat) {
                        SelectedItem = ITEM_UNFORMAT
                    }
                    else {
                        SelectedItem = ITEM_EXIT
                    }
                }
                else if (SelectedItem == ITEM_DELETE) {
                    if (unformat) {
                        SelectedItem = ITEM_UNFORMAT
                    }
                    else {
                        SelectedItem = ITEM_EXIT
                    }
                }
                else if (SelectedItem == ITEM_UNFORMAT) {
                    SelectedItem = ITEM_EXIT
                }
                else if (SelectedItem == ITEM_EXIT) {
                    if (load) {
                        SelectedItem = ITEM_LOAD
                    }
                    else {
                        SelectedItem = ITEM_SAVE
                    }
                }
            }
            if (buttonpress(PAD_START | PAD_X)) {
                SoundButtonConfirm()
                break
            }
            playnull()
        } while (1)
        cascadeevent(Event1, self)
        if (SelectedItem == ITEM_LOAD) {
            changestate(Card_Load)
        }
        else if (SelectedItem == ITEM_SAVE) {
            changestate(Card_Save)
        }
        else if (SelectedItem == ITEM_DELETE) {
            changestate(Card_Delete)
        }
        else if (SelectedItem == ITEM_UNFORMAT) {
            changestate(Card_Unformat)
        }
        else {
            changestateif(Card_Exit, SelectedItem == ITEM_EXIT)
        }
    }
    event(e, a) {
        CardMenuEventCommon(e, a)
    }
    trans {
        CheckCardStatus(1)
    }
}

