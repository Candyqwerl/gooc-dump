state NTropy_TriggerPlatforms { // 7
    stateflag 0x40040C1
    statusc 0x0
    code(layout, brief) {
        voice = TimeVoice
        soundfadet(0.4s, voice)
        soundfadev(1V, voice, 2)
        if (animseq == getanim(NTROPY_STAND_UP) || animseq == getanim(NTROPY_TRANSITION) || animseq == getanim(NTROPY_INTRO_3)) {
            playframes(NTROPY_TRIGGER_PLATFORMS_1, 25.0, 37.0)
        }
        else {
            playframes(NTROPY_TRIGGER_PLATFORMS_1, 0.0, 37.0)
        }
        spawn(90, 5, 1, 5.0, 0.0)
        playanim(0, NTROPY_TRIGGER_PLATFORMS_2)
        playanim(1, NTROPY_TRIGGER_PLATFORMS_2)
        playanim(2, NTROPY_TRIGGER_PLATFORMS_2)
        playanim(3, NTROPY_TRIGGER_PLATFORMS_2)
        playanim(3, NTROPY_TRIGGER_PLATFORMS_2)
        if (layout > 10) {
            if (SECTIONDEATHCOUNT <= 4.0) {
                layout += 1 + rand(3)
            }
            else if (SECTIONDEATHCOUNT <= 9.0) {
                layout += 2 + rand(3)
            }
            else if (SECTIONDEATHCOUNT <= 14.0) {
                layout += 3 + rand(3)
            }
            else {
                layout += 4 + rand(3)
            }
        }
        PlatformLayout = layout
        {
            var low, high
            save (var0, field_61) {
                GetPlatformMasks(PlatformLayout)
                low = PlatformMaskLow
                high = PlatformMaskHigh
            }
            sendevent(Event83, creator, low, high)
            soundpitch(5.805)
            soundsetup(7, self, 8)
            sounddecay(8s)
            soundplay([NT44A], 1V)
        }
        if (brief) {
            playframes(NTROPY_KNEEL_1, 5.0, 16.0)
        }
        else {
            playframes(NTROPY_KNEEL_1, 5.0, 37.0)
        }
        AttackStep += 1.0
        changestate(NTropy_SelectAttack)
    }
}

state NTropy_Transition { // 8
    stateflag 0x40040C1
    statusc 0x0
    code(layout) {
        {
            var low, high
            save (var0, field_61) {
                PlatformLayout = layout
                GetPlatformMasks(PlatformLayout)
                low = PlatformMaskLow
                high = PlatformMaskHigh
            }
            sendevent(Event84, creator, low, high, 0)
        }
        voice = TimeVoice
        soundfadet(5, voice)
        soundfadev(1V, voice, 2)
        SoundNTropyWarp()
        playframes(NTROPY_TRANSITION, 0.0, 37.0)
        vfx &= 0xFF00FFFF
        moda = 0
        sendevent(Event21, player, 0)
        FightPhase += 1.0
        AttackStep = 0
        changestate(NTropy_SelectAttack)
    }
    trans {
        once {
            vfx = (vfx & 0xFF00FFFF) | 0x70000
            moda = 16.0
            setanim(NTROPY_STAND_1, 0.0)
        }
        unless (GLOBAL_119 & 0x8000000) {
            settrans(BeginWarpIn)
        }
        BeginWarpIn()
    }
}

sub BeginWarpIn() { // S-877
    FADECONTROL = 0
    settrans(UpdateWarpIn)
    UpdateWarpIn()
}

sub UpdateWarpIn() { // S-881
    moda = seek(moda, 0, 109)
    if (!moda) {
        tpc = 0
        vfx &= 0xFF00FFFF
    }
}

state NTropy_Attacked { // 9
    stateflag 0x4004083
    statusc 0x0
    code() {
        SoundNTropyAttacked()
        SoundPitchDefault(0.294)
        sounddecay(8.4s + 1)
        soundsetup(7, self, 8)
        soundplay([Bp10A], 1V)
        GLOBAL_101 = 2
        GLOBAL_100 = 0xFF
        health -= 1.0
        changestateif(NTropy_Death, health <= 0)
        statusb &= ~FLAG_COLLIDABLE
        EnemyFlingSetDir(0x80000)
        setvel(3m)
        statusb |= FLAG_PHYSICS_ENGINE
        troty += 180deg
        roty = troty
        soundpitch(4.0)
        sounddecay(8s)
        soundsetup(6, self, 8)
        soundplay([NT84A], 1V)
        playframes(NTROPY_ATTACKED, 0.0, 9.0)
        statusb &= ~FLAG_PHYSICS_ENGINE
        playanim(10, NTROPY_ATTACKED)
        sendevent(Event34, player, 0)
        GAMEFLAGS |= 0x800000
        ins72(0, 0x1000)
        settrans(BeginWarpOut)
        playanim(11, NTROPY_ATTACKED)
        playframes(12.0, 41.0)
        FadeToBlack()
        voice = TimeVoice
        soundfadet(0.2s, voice)
        soundfadev(0.05V, voice, 2)
        playframes(41.0, 47.0)
        until (FADECONTROL == -1) {
            playframe()
        }
        ins72(0, 0x1000)
        save (y) {
            calcpath(0, vtrans)
        }
        troty = 0
        roty = troty
        y += 50m
        statusb |= FLAG_COLLIDABLE
        sendevent(EventTriggered, creator)
        player -> y = y
        player -> x = -player -> x
        player -> z = -player -> z
        player -> troty += 180deg
        player -> roty += 180deg
        ins72(0x400, 0x100)
        playframe()
        UpdateTextureGroups(FightPhase + 1.0)
        FadeFromBlack()
        changestate(NTropy_Transition, PlatformLayout + 100)
    }
}

sub BeginWarpOut() __trans { // S-1037
    once {
        vfx = (vfx & 0xFF00FFFF) | 0x70000
        moda = 0
    }
    if (GLOBAL_119 & 0x8000000) {
        settrans(UpdateWarpOut)
    }
    UpdateWarpOut()
}

sub BeginWarpOutFade() __trans { // S-1048
    once {
        FADECONTROL = 0
    }
    UpdateWarpOut()
}

sub UpdateWarpOut() { // S-1052
    moda = seek(moda, 16.0, 148)
    if (moda == 16.0) {
        tpc = 0
        vfx &= 0xFF00FFFF
        animseq = 0
    }
}

state NTropy_Death { // 10
    stateflag 0x40040A3
    statusc 0x0
    code() {
        KillEntity()
        GAMEFLAGS |= -0x80000000
        NTropySpeechOBJ = 0
        if (SFXVOL) {
            if (var lang = GLOBAL_151; lang == LANG_FR) {
                spawn2(9, 44, 1, [F104O], [F114O], [F124O], 3.0, 1000s, 8.0)
                NTropySpeechOBJ = objectspawned
            }
            else if (lang == LANG_DE) {
                spawn2(9, 44, 1, [G104O], [G114O], [G124O], 3.0, 1000s, 8.0)
                NTropySpeechOBJ = objectspawned
            }
            else if (lang == LANG_IT) {
                spawn2(9, 44, 1, [I104O], [I114O], [I124O], 3.0, 1000s, 8.0)
                NTropySpeechOBJ = objectspawned
            }
            else if (lang == LANG_ES) {
                spawn2(9, 44, 1, [S104O], [S114O], [S124O], 3.0, 1000s, 8.0)
                NTropySpeechOBJ = objectspawned
            }
            else {
                spawn2(9, 44, 1, [E104O], [E114O], [E124O], 3.0, 1000s, 8.0)
                NTropySpeechOBJ = objectspawned
            }
        }
        soundpitch(4.0)
        soundsetup(7, self, 8)
        sounddecay(8s)
        soundplay([NT14A], 1V)
        voice = TimeVoice
        soundfadet(15, voice)
        soundfadev(0.3V, voice, 3)
        EnemyFlingSetDir(0x80000)
        setvel(3m)
        statusb |= FLAG_PHYSICS_ENGINE
        troty += 180deg
        roty = troty
        playframes(NTROPY_DEATH, 0.0, 9.0)
        statusb &= ~FLAG_PHYSICS_ENGINE
        playframes(10.0, 22.0)
        interrupter = NTropySpeechOBJ
        sendevent(EventTriggered, interrupter)
        playframe(animframe, 42)
        playframes(NTROPY_DEAD, 0.0, 11.0)
        soundpitch(4.715)
        soundsetup(7, self, 8)
        sounddecay(8s)
        soundplay([NT34A], 0.8V)
        playframes(NTROPY_WARPOUT_1, 0.0, 11.0)
        voice = TimeVoice
        soundfadet(0.1s, voice)
        soundfadev(0V, voice, 3)
        spawn(NTroC, S_WARPOUT)
        playframes(NTROPY_WARPOUT_2, 0.0, 24.0)
        if (GLOBAL_160 & 0x4) {
            PowerupAlreadyOwned = true
        }
        else {
            save (x, y, z) {
                PowerupAlreadyOwned = false
                y += 2m
                spawn2(FruiC, FruiC_S_FRUIT_HOP, 1, 702.0, 0)
            }
        }
        var0 = GLOBAL_160
        statetime = frametime
        do {
            if (var0 != GLOBAL_160 || (PowerupAlreadyOwned && frametime - statetime >= 1s)) {
                if (!(PREVBOXCOUNT & 0x4000) && SFXVOL) {
                    GLOBAL_190 = 2.0
                    GLOBAL_191 = 14
                }
                if (PowerupAlreadyOwned) {
                    ExitReward = 0
                }
                else {
                    ExitReward = 702.0
                }
                spawn2(WEfOC, WEfOC_S_WARP_OUT, 1, 5m, 0m, 9.5m, 16m, 2S, ExitReward)
                creator = objectspawned
                PowerupAlreadyOwned = false
                var0 = GLOBAL_160
            }
            if (animseq != getanim(NTROPY_WARPOUT_3)) {
                setanim(NTROPY_WARPOUT_3, -1.0)
            }
            playframe((animframe + 1.0) % 12.0)
        } while (1)
        GLOBAL_186 = 0
    }
}

state NTropy_Victory { // 11
    stateflag 0x4004083
    statusc 0x0
    code() {
        if (animseq == getanim(NTROPY_WAIT_FOR_ORB)) {
            playframes(NTROPY_WIN_2, 0.0, 11.0)
        }
        else if (animseq == getanim(NTROPY_WAIT_FOR_LAZER)) {
            playframes(NTROPY_WIN_1, 0.0, 11.0)
        }
        playframes(NTROPY_LAUGH, 0.0, 37.0)
        sleepframes(NTROPY_STAND_2, 0.0, 11.0)
    }
}

state Time_Fork { // 12
    stateflag 0x1
    statusc 0x2
    code() {
        statusb = FLAG_NO_CAMERA_CLIP
        playnull()
        ForkVerticesReady = false
        vfx = (vfx & 0xFFFFFF00) | 0xA
        moda = 4.0
        SetColor1(0xC8, 0xBE, 0xB2)
        do {
            start :
            SetColor2(-0xF26, -0x4A5, 0x23F)
            if (!parent -> animseq
                || parent -> animseq == getanim(NTROPY_DEAD)
                || parent -> animseq == getanim(NTROPY_WARPOUT_1)
                || parent -> animseq == getanim(NTROPY_WARPOUT_2)
                || parent -> animseq == getanim(NTROPY_WARPOUT_3)) {
                    playnull()
                    ForkVerticesReady = false
                    goto start;
                }
            else if (parent -> animseq == getanim(NTROPY_PREPARE_ORB)) {
                setanim(TIME_FORK_1)
            }
            else if (parent -> animseq == getanim(NTROPY_FIRE_ORB)) {
                SetColor1(0xFF, 0x60, 0x14)
                SetColor2(0x135, 0xDB9, 0x823)
                setanim(TIME_FORK_2)
            }
            else if (parent -> animseq == getanim(NTROPY_WAIT_FOR_ORB)) {
                setanim(TIME_FORK_3)
            }
            else if (parent -> animseq == getanim(NTROPY_PREPARE_LAZER)) {
                setanim(TIME_FORK_4)
            }
            else if (parent -> animseq == getanim(NTROPY_STAND_1)) {
                setanim(TIME_FORK_5)
            }
            else if (parent -> animseq == getanim(NTROPY_FIRE_LAZER)) {
                SetColor1(0xFF, 0xB6, 0x5C)
                SetColor2(0x135, 0xDB9, 0x823)
                setanim(TIME_FORK_6)
            }
            else if (parent -> animseq == getanim(NTROPY_WAIT_FOR_LAZER)) {
                setanim(TIME_FORK_7)
            }
            else if (parent -> animseq == getanim(NTROPY_TRIGGER_PLATFORMS_1)) {
                setanim(TIME_FORK_8)
            }
            else if (parent -> animseq == getanim(NTROPY_TRIGGER_PLATFORMS_2)) {
                SetColor1(0x5C, 0xB6, 0xFF)
                SetColor2(0x135, 0xDB9, 0x823)
                setanim(TIME_FORK_9)
            }
            else if (parent -> animseq == getanim(NTROPY_KNEEL_1)) {
                setanim(TIME_FORK_9)
            }
            else if (parent -> animseq == getanim(NTROPY_KNEEL_2)) {
                setanim(TIME_FORK_0)
            }
            else if (parent -> animseq == getanim(NTROPY_STAND_UP)) {
                setanim(TIME_FORK_A)
            }
            else if (parent -> animseq == getanim(NTROPY_ATTACK_PLAYER_1)) {
                setanim(TIME_FORK_B)
            }
            else if (parent -> animseq == getanim(NTROPY_ATTACK_PLAYER_2)) {
                SetColor1(0xFF, 0xB6, 0x5C)
                SetColor2(0x135, 0xDB9, 0x823)
                setanim(TIME_FORK_B)
            }
            else if (parent -> animseq == getanim(NTROPY_TRANSITION)) {
                setanim(TIME_FORK_M)
            }
            else if (parent -> animseq == getanim(NTROPY_DEATH)) {
                SetVel(-1m, 0.5m, -0.5m)
                statusb |= FLAG_PHYSICS_ENGINE
                setanim(TIME_FORK_D)
            }
            else if (parent -> animseq == getanim(NTROPY_LAUGH)) {
                setanim(TIME_FORK_E)
            }
            else if (parent -> animseq == getanim(NTROPY_STAND_2)) {
                setanim(TIME_FORK_F)
            }
            else if (parent -> animseq == getanim(NTROPY_WIN_1)) {
                setanim(TIME_FORK_G)
            }
            else if (parent -> animseq == getanim(NTROPY_WIN_2)) {
                setanim(TIME_FORK_H)
            }
            else if (parent -> animseq == getanim(NTROPY_INTRO_1)) {
                if (((parent -> vfx >> 16) & 0xFF) == 7 && parent -> animframe <= 25.0) {
                    setanim(TIME_FORK_N)
                }
                else {
                    SetColor1(0xC8, 0xBE, 0xB2)
                    setanim(TIME_FORK_I)
                }
            }
            else if (parent -> animseq == getanim(NTROPY_INTRO_2)) {
                setanim(TIME_FORK_J)
            }
            else if (parent -> animseq == getanim(NTROPY_INTRO_3)) {
                setanim(TIME_FORK_K)
            }
            else if (parent -> animseq == getanim(NTROPY_ATTACKED)) {
                if (((parent -> vfx >> 16) & 0xFF) == 7) {
                    setanim(TIME_FORK_L)
                }
                else {
                    SetColor1(0xFF, 0xFF, 0xFF)
                    setanim(TIME_FORK_C)
                }
            }
            animframe = parent -> animframe
            zindex = parent -> zindex
            CopyParentRot()
            CopyParentTrans()
            if (((parent -> vfx >> 16) & 0xFF) == 7) {
                vfx = (vfx & 0xFF00FFFF) | 0x70000
                SetColor1(0, 0, 0)
                moda = parent -> moda
            }
            else {
                vfx = (vfx & 0xFF00FFFF) | 0x40000
                colr1 = seek(colr1, 0xC8, 0x14)
                colg1 = seek(colg1, 0xBE, 0x14)
                colb1 = seek(colb1, 0xB2, 0x14)
            }
            if (ForkVerticesReady) {
                save (rotx, roty, rotz) {
                    getvert(vtrot, self, 1.0)
                    getvert(vvec, self, 2.0)
                    getvert(vvel, self, 3.0)
                    getvert(vrot, self, 0.0)
                    trotx -= rotx
                    vecx -= rotx
                    velx -= rotx
                    troty -= roty
                    vecy -= roty
                    vely -= roty
                    trotz -= rotz
                    vecz -= rotz
                    velz -= rotz
                }
            }
            ForkVerticesReady = true
            playframe()
        } while (1)
    }
    event(e, a) {
        accevif (e == Event67) {
            SetColor1(0xC8, 0xBE, 0xB2)
        }
    }
}

state Warpout_Shockwave { // 13
    stateflag 0x1
    statusc 0x2
    code() {
        playframes(WARPOUT_SHOCKWAVE, 0.0, 25.0)
        sleep()
    }
}

state Intro_Clock { // 14
    stateflag 0x1
    statusc 0x2
    code() {
        zindex = 32
        while (parent -> animframe < 29.0) {
            playanim(0, INTRO_CLOCK)
        }
        playframes(INTRO_CLOCK, 0.0, 63.0)
        zindex = -20
        playframes(64.0, 79.0)
        playnull(3)
        if (!SHAKEY) {
            SHAKEY = 10.0
        }
    }
    event(e, a) {
        accevcstate(Kill, e == Event67)
    }
}

sub UpdateTextureGroups(group) {
    if (group == 0) {
        loadfile2([Ntr3T])
        loadfile2([Ntr4T])
        loadfile2([Ntr5T])
        deloadfile([Ntr3T])
        deloadfile([Ntr4T])
        deloadfile([Ntr5T])
    }
    else if (group == 1.0) {
        loadfile2([Ntc3T])
        loadfile2([Ntc4T])
        loadfile2([Ntc5T])
        deloadfile([Ntc3T])
        deloadfile([Ntc4T])
        deloadfile([Ntc5T])
    }
    else if (group == 2.0) {
        loadfile2([Nta3T])
        deloadfile([Nta3T])
        loadfile2([Nta4T])
        deloadfile([Nta4T])
    }
}

state Kill { // 15
    stateflag 0x20
    statusc 0x0
    code() {}
}


