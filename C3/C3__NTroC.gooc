#spawn S_NTROPY     NTropy_Intro
#spawn S_FORK       Time_Fork
#spawn S_WARPOUT    Warpout_Shockwave
#spawn S_CLOCK      Intro_Clock

event Event1 => state Kill

var FightPhase, AttackStep, PlatformLayout, TimeVoice, NTropySpeechOBJ

expr ActiveOrbs          = var0
expr PlatformMaskLow     = var0
expr PlatformMaskHigh    = field_61
expr PowerupAlreadyOwned = field_61
expr ExitReward          = var0
expr ForkVerticesReady   = var0

inline sub SoundNTropyWarp() {
    soundpitch(4.0)
    sounddecay(8s)
    soundsetup(6, self, 8)
    soundplay([NTa4A], 1V)
}

inline sub SoundNTropyAttacked() {
    soundpitch(4.715)
    sounddecay(8s)
    soundsetup(7, self, 8)
    soundplay([NT24A], 1V)
}

state NTropy_Intro { // 0
    stateflag 0x4004081
    statusc 0x2
    code() {
        UpdateTextureGroups(0)
        SetScale(1.5S)
        zindex = 32
        GLOBAL_150 |= 0x40000
        if (GLOBAL_27 & 0x10) {
            SECTIONDEATHCOUNT = 0
        }
        health = 3.0
        spawn(BosBC, BosBC_S_HEALTH_TICK, 1, 3.0, 0)
        spawn2(NTroC, S_FORK)
        statusb = FLAG_ROT_Y | FLAG_COLLIDABLE | FLAG_SOLID_SIDES | FLAG_SOLID_TOP | FLAG_NO_CAMERA_CLIP | FLAG_HAS_SHADOW | FLAG_STALL
        trotx = 360deg
        field_60 = 0
        spawn(ShadC, ShadC_S_BOSS_VIDO, 1, 0, 2S, 0)
        spawn2(90, 0)
        creator = objectspawned
        FightPhase = 0
        AttackStep = 0
        soundpitch(4.715)
        sounddecay(10.2s)
        soundsetup(6, self, 8)
        soundcount(0xFFFF)
        soundplay([NT74A], 0.1V)
        TimeVoice = voice
        if (!RESPAWNCOUNT) {
            spawn(NTroC, S_CLOCK)
            playnull(1)
            playnull(1)
            playnull(1)
            playnull(19)
            NTropySpeechOBJ = 0
            if (SFXVOL) {
                if (var lang = GLOBAL_151; lang == LANG_FR) {
                    spawn2(9, 44, 1, [F004O], [F014O], 2.0, 1000s, 8.0)
                    NTropySpeechOBJ = objectspawned
                }
                else if (lang == LANG_DE) {
                    spawn2(9, 44, 1, [G004O], [G014O], 2.0, 1000s, 8.0)
                    NTropySpeechOBJ = objectspawned
                }
                else if (lang == LANG_IT) {
                    spawn2(9, 44, 1, [I004O], [I014O], 2.0, 1000s, 8.0)
                    NTropySpeechOBJ = objectspawned
                }
                else if (lang == LANG_ES) {
                    spawn2(9, 44, 1, [S004O], [S014O], 2.0, 1000s, 8.0)
                    NTropySpeechOBJ = objectspawned
                }
                else {
                    spawn2(9, 44, 1, [E004O], [E014O], 2.0, 1000s, 8.0)
                    NTropySpeechOBJ = objectspawned
                }
            }
            onstateexit(ClearWarpEffect)
            vfx = (vfx & 0xFF00FFFF) | 0x70000
            moda = 16.0
            SoundNTropyWarp()
            soundpitch(4.715)
            sounddelay(1.32s)
            sounddecay(8s)
            soundsetup(7, self, 8)
            soundplay([NT64A], 1V)
            playframes(NTROPY_INTRO_1, 0.0, 96.0)
            SoundNTropyAttacked()
            SoundNTropyAttacked()
            soundpitch(3.302)
            soundsetup(7, self, 8)
            sounddelay(0.7s)
            soundplay([Bp10A], 1V)
            setanim(NTROPY_INTRO_2, -1.0)
            do {
                animframe += 1.0
                if (animframe == 24.0) {
                    interrupter = NTropySpeechOBJ
                    sendevent(EventTriggered, interrupter)
                    NTropySpeechOBJ = 0
                }
                playframe()
            } while (animframe + 1.0 <= 98.0)
            playframes(NTROPY_INTRO_3, 0.0, 24.0)
        }
        changestate(NTropy_SelectAttack)
    }
    event(e, a) {
        accevcstate(NTropy_SelectAttack, e == Event67)
    }
    trans {
        moda = seek(moda, 0, 0.64)
        if (!moda) {
            vfx &= 0xFF00FFFF
        }
    }
}

sub ClearWarpEffect() { // S-153
    vfx &= 0xFF00FFFF
    moda = 0
}

state NTropy_SelectAttack { // 1
    stateflag 0x4004081
    statusc 0x0
    code() {
        if (TimeVoice > 0) {
            sp = TimeVoice
            soundcheck(sp)
        }
        if (TimeVoice > 0 && misc != -1) {
            voice = TimeVoice
            soundfadet(0.4s, voice)
            soundfadev(1V, voice, 2)
        }
        else {
            soundpitch(4.715)
            sounddecay(10.2s)
            soundsetup(6, self, 8)
            soundcount(0xFFFF)
            soundplay([NT74A], 0.1V)
            TimeVoice = voice
        }
        do {
            if (var phase = FightPhase; phase == 0) {
                if (var step = AttackStep % 7.0; step == 0.0) {
                    changestate(NTropy_TriggerPlatforms, 1, 1.0)
                }
                else if (step == 1.0) {
                    changestate(NTropy_FireOrb, 1.0)
                }
                else if (step == 2.0) {
                    changestate(NTropy_FireLazer, 0)
                }
                else if (step == 3.0) {
                    changestate(NTropy_FireLazer, 3.0)
                }
                else if (step == 4.0) {
                    changestate(NTropy_FireLazer, 2.0)
                }
                else if (step == 5.0) {
                    changestate(NTropy_TriggerPlatforms, 40, 0.0)
                }
                else {
                    changestateif(NTropy_DazedRecover, step == 6.0, 6s)
                }
            }
            else if (phase == 1.0) {
                if (var step = AttackStep % 8.0; step == 0) {
                    changestate(NTropy_TriggerPlatforms, 2, 1.0)
                }
                else if (step == 1.0) {
                    changestate(NTropy_FireOrb, 2.0)
                }
                else if (step == 2.0) {
                    changestate(NTropy_FireLazer, 0.0)
                }
                else if (step == 3.0) {
                    changestate(NTropy_FireLazer, 0.0)
                }
                else if (step == 4.0) {
                    changestate(NTropy_FireLazer, 3.0)
                }
                else if (step == 5.0) {
                    changestate(NTropy_FireLazer, 0.0)
                }
                else if (step == 6.0) {
                    changestate(NTropy_TriggerPlatforms, 50, 0.0)
                }
                else {
                    changestateif(NTropy_DazedRecover, step == 7.0, 5s)
                }
            }
            else if (phase == 2.0) {
                if (var step = AttackStep % 9.0; step == 0) {
                    changestate(NTropy_TriggerPlatforms, 3, 1.0)
                }
                else if (step == 1.0) {
                    changestate(NTropy_FireOrb, 3.0)
                }
                else if (step == 2.0) {
                    changestate(NTropy_FireLazer, 2.0)
                }
                else if (step == 3.0) {
                    changestate(NTropy_FireLazer, 3.0)
                }
                else if (step == 4.0) {
                    changestate(NTropy_FireLazer, 0)
                }
                else if (step == 5.0) {
                    changestate(NTropy_FireLazer, 2.0)
                }
                else if (step == 6.0) {
                    changestate(NTropy_FireLazer, 2.0)
                }
                else if (step == 7.0) {
                    changestate(NTropy_TriggerPlatforms, 60, 0.0)
                }
                else {
                    changestateif(NTropy_DazedRecover, step == 8.0, 4s)
                }
            }
        } while (1)
    }
}

state NTropy_Wait { // 2
    stateflag 0x4004081
    statusc 0x0
    code(count) {
        troty = 0
        do (var i = 0) {
            playframes(NTROPY_STAND_1, 0.0, 24.0)
        } while ({ i += 1.0 }; i < count)
        AttackStep += 1.0
        changestate(NTropy_SelectAttack)
    }
}

state NTropy_DazedRecover { // 3
    stateflag 0x1
    statusc 0x0
    code(len) {
        troty = 0
        do (var start = frametime) {
            if (animseq != getanim(NTROPY_KNEEL_2)) {
                setanim(NTROPY_KNEEL_2, -1.0)
            }
            playframe((animframe + 1.0) % 17.0)
        } while (frametime - start < len)
        playframes(NTROPY_STAND_UP, 0.0, 16.0)
        changestateif(NTropy_AttackPlayer, distance(player) < 6m)
        AttackStep += 1.0
        changestate(NTropy_SelectAttack)
    }
    event(e, a) {
        accevcstate(NTropy_Attacked, e == EventJumpedOn || e == EventSpinHit || e == EventSlideHit || e == EventSlamHit || e == EventHit)
    }
    trans {
        sendevent(EventHit, collider, 100.0)
    }
}

state NTropy_AttackPlayer { // 4
    stateflag 0x41
    statusc 0x0
    code() {
        troty = atan2(player -> trans)
        trotx = 360deg
        playframes(NTROPY_ATTACK_PLAYER_1, 0.0, 12.0)
        soundpitch(5.805)
        soundsetup(7, self, 8)
        sounddecay(8s)
        soundplay([NT44A], 1V)
        playanim(13, NTROPY_ATTACK_PLAYER_2)
        spawn(90, 5, 1, 4.0, 1)
        spawn(90, 5, 1, 4.0, 2)
        playframes(13.0, 24.0)
        playframes(NTROPY_ATTACK_PLAYER_1, 25.0, 29.0)
        changestateif(NTropy_Victory, player -> stateflag & 0x8000000)
        AttackStep += 1.0
        changestate(NTropy_SelectAttack)
    }
}

state NTropy_FireOrb { // 5
    stateflag 0x40040C1
    statusc 0x0
    code(count) {
        playframes(NTROPY_PREPARE_ORB, 0.0, 28.0)
        ActiveOrbs = 0
        do (var i = 0) {
            spawn2(90, 2, 1, 4.0, 5.0)
            if (objectspawned) {
                ActiveOrbs += 1.0
            }
            playframes(NTROPY_FIRE_ORB, 0.0, 11.0)
            playframes(NTROPY_WAIT_FOR_ORB, 0.0, 24.0)
        } while ({ i += 1.0 }; i < count)

        while (ActiveOrbs) {
            if (animseq != getanim(NTROPY_WAIT_FOR_ORB)) {
                setanim(NTROPY_WAIT_FOR_ORB, -1.0)
            }
            playframe((animframe + 1.0) % 25.0)
            changestateif(NTropy_Victory, player -> stateflag & 0x8000000)
            changestateif(NTropy_AttackPlayer, distance(player) < 6m)
        }
        troty = 0deg
        playframes(NTROPY_PREPARE_LAZER, 0.0, 33.0)
        AttackStep += 1.0
        changestate(NTropy_SelectAttack)
    }
    event(e, a) {
        accevif (e == EventTriggered) {
            ActiveOrbs -= 1.0
        }
    }
}

state NTropy_FireLazer { // 6
    stateflag 0x40040C1
    statusc 0x0
    code(dir) {
        spawn(90, 4, 1, 4.0, dir)
        spawn(90, 4, 1, 5.0, dir)
        playframes(NTROPY_FIRE_LAZER, 0.0, 7.0)
        spawn(90, 3, 1, dir)
        playframes(8.0, 11.0)
        playframes(NTROPY_WAIT_FOR_LAZER, 0.0, 24.0)
        changestateif(NTropy_Victory, player -> stateflag & 0x8000000)
        changestateif(NTropy_AttackPlayer, distance(player) < 6m)
        playframes(0.0, 12.0)
        AttackStep += 1.0
        changestate(NTropy_SelectAttack)
    }
}

