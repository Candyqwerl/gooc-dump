#anim TAZ_JUMP_1               [Tj16V] [TT16G] 01 1 2
#anim TAZ_JUMP_2               [Tj26V] [TT16G] 09 1 2
#anim TAZ_JUMP_3               [Tj36V] [TT16G] 19 1 2
#anim TAZ_JUMP_4               [Tj46V] [TT16G] 02 1 2
#anim TAZ_JUMP_5               [Tj56V] [TT16G] 18 1 2
#anim TAZ_TRIDENT_STUCK_1      [Tj66V] [TT16G] 26 1 2
#anim TAZ_TRIDENT_STUCK_2      [Tj76V] [TT16G] 29 1 2
#anim TAZ_TRIDENT_STUCK_3      [Tj86V] [TT16G] 33 1 2
#anim TAZ_TRIDENT_UNSTUCK      [Tj96V] [TT16G] 52 1 2
#anim TAZ_ROAR_1               [Tt16V] [TT16G] 38 1 2
#anim TAZ_ROAR_2               [Tt26V] [TT16G] 17 1 2
#anim TAZ_ROAR_3               [Tt36V] [TT16G] 10 1 2
#anim TAZ_PULL_TRIDENT         [Tja6V] [TT16G] 07 1 2
#anim TAZ_RECOVER_2            [Tjb6V] [TT16G] 32 1 2 
#anim TAZ_GRAB_TRIDENT_2       [Tp16V] [TT16G] 34 1 2
#anim TAZ_DEFEATED             [Td16V] [TT16G] 45 1 2
#anim TAZ_ATTACKED             [Tjc6V] [TT26G] 07 1 2
#anim TAZ_RECOVER_1            [Tjd6V] [TT26G] 32 1 2
#anim TAZ_JUMP_RETREAT         [Tje6V] [TT26G] 18 1 2
#anim TAZ_JUMP_RETREAT_LAND    [Tjf6V] [TT26G] 22 1 2
#anim TAZ_GRAB_TRIDENT_1       [Tp26V] [TT26G] 48 1 2
#anim TRIDENT_BREAK            [Tjg6V] [TT36G] 21 1 2
#anim TAZ_INTRO_BREAK_CHAINS_1 [Ti16V] [TT46G] 138 1 2
#anim TAZ_INTRO_BREAK_CHAINS_2 [Ti26V] [TT46G] 138 1 2
#anim PILLAR_LEFT              [Ti36V] [TT56G] 138 1 2
#anim PILLAR_RIGHT             [Ti46V] [TT56G] 138 1 2
#anim LION_RUN                 [TSw6V] [TSw6G] 14 1 2
#anim LION_EAT                 [TS26V] [TSw6G] 55 1 2
