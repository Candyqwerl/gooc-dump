#spawn S_SIGN_CURVE       Sign_Spawn
#spawn S_SIGN_CURVE_HARD  Sign_Spawn
#spawn S_SKYBOX           SkyBox
#spawn S_FENCE            Fence_Spawn
#spawn S_TURBO_PAD        Turbo_Pad_Spawn
