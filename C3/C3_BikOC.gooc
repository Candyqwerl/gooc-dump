#spawn S_PIT_GRABBER      Pit_Grabber
#spawn S_GAS_SIGN         Sign_Sound
#spawn S_GAS              Gas_Station_Sounds
#spawn S_DINER_SIGN       Sign_Sound
#spawn S_DINER            __s_13
#spawn S_ENTROPHY         Sign_Sound
