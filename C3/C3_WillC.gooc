                animframe += 1.0
                if (animframe == 18.0 || animframe == 23.0 || animframe == 41.0) {
                    soundpitch(3.12)
                    sounddecay(3.2s)
                    soundplay(SOUND_FOOTSTEP_DEFAULT, 0x999)
                }
                playframe()
            } while (animframe + 1.0 <= 55.0)
            mem47 = 0
            if (GLOBAL_10 == 3.0) {
                SaveCollectedRewards()
                var0 = 200.0
                field_61 = CRYSTALPOOL1
                while (field_61) {
                    until (field_61 & 1) {
                        AdvancePool()
                    }
                    PlayerGiveRewards(coco, var0)
                    AdvancePool()
                }
                var0 = 0xE800
                field_61 = CRYSTALPOOL2
                while (field_61) {
                    until (field_61 & 1) {
                        AdvancePool()
                    }
                    PlayerGiveRewards(coco, var0)
                    AdvancePool()
                }
                var0 = 0x12C00
                field_61 = GEMPOOL1
                while (field_61) {
                    until (field_61 & 1) {
                        AdvancePool()
                    }
                    PlayerGiveRewards(coco, var0)
                    mem47 = 1.0
                    AdvancePool()
                }
                var0 = 0x14C00
                field_61 = GEMPOOL2
                while (field_61) {
                    until (field_61 & 1) {
                        AdvancePool()
                    }
                    PlayerGiveRewards(coco, var0)
                    mem47 = 1.0
                    AdvancePool()
                }
                {
                    var bits1 = GLOBAL_179
                    var bits2 = GLOBAL_181
                    var level, tier
                    while (bits1 | bits2) {
                        until ((bits1 | bits2) & 1) {
                            bits1 = bits1 >> 1 & 0x7FFFFFFF
                            bits2 = bits2 >> 1 & 0x7FFFFFFF
                            level += 1.0
                        }
                        if (bits2 & 1) {
                            if (bits1 & 1) {
                                tier = 0x25800
                            }
                            else {
                                tier = 0x1F400
                            }
                        }
                        else {
                            tier = 0x19000
                        }
                        PlayerGiveRewards(coco, tier + level)
                        mem47 = 1.0
                        bits1 = bits2 >> 1 & 0x7FFFFFFF
                        bits2 = bits2 >> 1 & 0x7FFFFFFF
                        level += 1.0
                    }
                }
                {
                    var bits1 = GLOBAL_180
                    var bits2 = GLOBAL_182
                    var level, tier
                    while (bits1 | bits2) {
                        until ((bits1 | bits2) & 1) {
                            bits1 = bits1 >> 1 & 0x7FFFFFFF
                            bits2 = bits2 >> 1 & 0x7FFFFFFF
                            level += 1.0
                        }
                        if (bits2 & 1) {
                            if (bits1 & 1) {
                                tier = 0x25800
                            }
                            else {
                                tier = 0x1F400
                            }
                        }
                        else {
                            tier = 0x19000
                        }
                        PlayerGiveRewards(coco, tier + (level + 0x2000))
                        mem47 = 1.0
                        bits1 = bits2 >> 1 & 0x7FFFFFFF
                        bits2 = bits2 >> 1 & 0x7FFFFFFF
                        level += 1.0
                    }
                }
            }
            if (coco) {
                DeloadAnim([Sic2V], [Si12G])
                DeloadAnim([Sid2V], [Si12G])
            }
            else {
                DeloadAnim([Cw22V], [Cr10G])
                DeloadAnim([Cw52V], [Cr10G])
            }
        }
        else if (GLOBAL_10 == 3.0) {
            SaveCollectedRewards()
        }
        CRYSTALPOOL1 = 0
        CRYSTALPOOL2 = 0
        GEMPOOL1 = 0
        GEMPOOL2 = 0
        GLOBAL_179 = 0
        GLOBAL_180 = 0
        GLOBAL_181 = 0
        GLOBAL_182 = 0
        broadcastevent(Event79, 0, 0)
        if (coco) {
            SwapCocoToCrash()
        }
        else {
            if (mem47) {
                onstateexit(CheckDanceSkip)
                settrans(ResetRespawnFields)
                LoadAnim([CD10V], [Cr10G])
                ExtraAnimGroup = 15.0
                do {
                    PlayMoveFrame()
                } until (isloaded([CD10V]) && isloaded([Cr10G]))
                WillyPlayDance()
            }
        }
        changestate(Willy_Idle)
    }
}

sub SwapCocoToCrash() { // E5S-522
    save (statusb) {
        stateflag |= 0x100000
        GAMEFLAGS &= ~0x2
        setvel(6m)
        vely = 0
        statusb |= FLAG_PHYSICS_ENGINE
        statusb &= ~(FLAG_PHYSICS_TEST | FLAG_GRAVITY)
        do (var start = frametime) {
            if (animseq != getanim(SIS_WALK_WARP)) {
                setanim(SIS_WALK_WARP, -1.0)
            }
            playframe((animframe + 1.0) % 20.0)
        } while (frametime - start < 25)
        roty += 180deg
        troty = roty
        setvel(6m)
        do (var start = frametime) {
            if (animseq != getanim(WILLY_RUN)) {
                setanim(WILLY_RUN, -1.0)
            }
            playframe((animframe + 1.0) % 17.0)
        } while (frametime - start < 25)
        roty += 180deg
        troty = roty
        GAMEFLAGS |= 0x2
    }
}

sub SaveCollectedRewards() { // E5S-572
    SAVEDGEMPOOL1 = SAVEDGEMPOOL1 | GEMPOOL1
    SAVEDGEMPOOL2 = SAVEDGEMPOOL2 | GEMPOOL2
    SAVEDCRYSTALPOOL1 = SAVEDCRYSTALPOOL1 | CRYSTALPOOL1
    SAVEDCRYSTALPOOL2 = SAVEDCRYSTALPOOL2 | CRYSTALPOOL2
    GLOBAL_175 = (GLOBAL_175 & ~(GLOBAL_179 | GLOBAL_181)) | GLOBAL_179
    GLOBAL_176 = (GLOBAL_176 & ~(GLOBAL_180 | GLOBAL_182)) | GLOBAL_180
    GLOBAL_177 = (GLOBAL_177 & ~(GLOBAL_179 | GLOBAL_181)) | GLOBAL_181
    GLOBAL_178 = (GLOBAL_178 & ~(GLOBAL_180 | GLOBAL_182)) | GLOBAL_182
}

sub PlayerGiveRewards(coco, reward) { // E5S-625
    save (var0) {
        if (coco) {
            setanim(SIS_WARP_GIVE_REWARDS)
        }
        else {
            setanim(WILLY_STAND_1)
            playframe(0)
            setanim(WILLY_WARP_GIVE_REWARDS)
        }
        playframes(0.0, 6.0)
        playframe(animframe, 2)
        playframe(7.0)
        soundpitch(0x1F5)
        sounddecay(3.2s)
        soundplay([DSw0A], 0.8V)
        playframe(7.0)
        playframe(8.0)
        var0 = 0
        spawn2(FruiC, FruiC_S_FRUIT_WARP, 1, reward, -0xCCC, -0x800, 0, 0x80, 0, 0)
        animframe = 8.0
        do {
            animframe += 1.0
            if (animframe == 17.0) {
                soundpitch(3.12)
                sounddecay(3.2s)
                soundplay(SOUND_FOOTSTEP_DEFAULT, 0x999)
            }
            playframe()
        } while (animframe + 1.0 <= 20.0)
        interrupter = var0
        sendevent(EventTriggered, interrupter)
        soundpitch(0x45A)
        sounddecay(0xFA)
        soundplay([GSh2A], 1V)
        animframe = 20.0
        do {
            animframe += 1.0
            if (animframe == 22.0) {
                soundpitch(0x372)
                sounddecay(3.2s)
                soundplay(SOUND_FOOTSTEP_DEFAULT, 0x999)
            }
            playframe()
        } while (animframe + 1.0 <= 31.0)
        broadcastevent(Event79, 0, reward)
        playframe(animframe, 21)
        playframes(32.0, 38.0)
    }
}
#module default

state Willy_Null { // 152
    stateflag 0x0
    statusc 0x0
    code() {}
}

sub TryMountDino() { // S-6432
    if (interrupter -> spawn == 0x120001) {
        y = interrupter -> y
        vely = interrupter -> vely
        roty = interrupter -> roty
        troty = roty
        changestate(Willy_Dino_Mount)
        interrupter -> misc = 0
    }
}

state Coco_Trigger_Tiger { // 153
    stateflag 0x2000001
    statusc 0x822
    code(obj) {
        mem49 = entity
        interrupter = obj
        mem40 = interrupter -> id
        changestate(Coco_Tiger_Mount)
    }
}

#module [WiltC] // 2003I
#purge ah
state Coco_Tiger_Mount { // 154
    stateflag 0x52000001
    statusc 0x1822
    code() {
        mem39 = mem40
        do {
            player = objectget(mem39)
            playframe()
        } until (player)
        entity = player -> entity
        pathlen = player -> pathlen
        if (!CHECKPOINTCOUNT) {
            ResetSpeed()
            statusb = (FLAG_ROT_Y | FLAG_PHYSICS_TEST | FLAG_GRAVITY | FLAG_PHYSICS_ENGINE | FLAG_HAS_SHADOW | FLAG_STALL)
            trotx = 360deg
            troty = atan2(player -> trans)
            playframes(SIS_STAND_1, 0.0, 27.0)
            statusb = (FLAG_ROT_Y | FLAG_GRAVITY | FLAG_PHYSICS_ENGINE | FLAG_HAS_SHADOW | FLAG_STALL)
            vely = 20m
            setvel(distance(player, DIST_NO_Y | DIST_EXACT))
            groundy = player -> y + 2m
            SoundJumpDefault(14.4, 0.205, 0x40, 1V)
            playframes(SIS_JUMP, 0.0, 15.0)
            statusb |= FLAG_SOLID_GROUND
            troty = player -> troty
            until (STATUS_GROUNDLAND) {
                playframe()
            }
            vely = groundvel
            sendevent(EventTriggered, player)
            vecx = player -> x
            vecy = player -> y
            vecz = player -> z
            groundy = vecy
            velx = 0
            velz = 0
            playframe()
            SetTrans(vecx, vecy, vecz)
            soundpitch(0x399 + rand(0xCC))
            sounddecay(0x90)
            soundplay(SOUND_LAND_DEFAULT, 0x3998)
            soundpitch(3.263)
            sounddecay(0x91)
            soundplay([BsaaA], 1V)
            playframes(SIS_TIGER_MOUNT, 0.0, 3.0)
            soundpitch(0x399 + rand(0xCC))
            sounddecay(0x90)
            soundplay(SOUND_LAND_DEFAULT, 0x3998)
            spawn(9, 2, 1, -1.0, 7.0, 12m)
        }
        {
            var best = -1
            var dist = 0
            do (var pos = 0) {
                calcpath(pos, vvec)
                var0 = abs(z - vecz)
                if (best < 0 || var0 < dist) {
                    best = pos
                    dist = var0
                }
            } while ({ pos += 1.0 }; pos < pathlen)
            pathprog = best
        }
        scalex = abs(scalex)
        if (CHECKPOINTID > 0) {
            interrupter = objectget(CHECKPOINTID)
            if (interrupter) {
                save (entity) {
                    entity = interrupter -> entity
                    mem48 = fieldval(0x2A200)
                }
            }
        }
        else {
            mem48 = 0
        }
        vely = 0
        mem41 = 10.0
        mem42 = 0
        trotx = 180deg
        yzapproach = 180deg
        statusb = (FLAG_ROT_Y | FLAG_TRACK_PATH_SIGN | FLAG_PHYSICS_TEST | FLAG_GRAVITY | FLAG_PHYSICS_ENGINE | FLAG_NO_CAMERA_CLIP | FLAG_HAS_SHADOW | FLAG_STALL | 0x2800)
        calcpath(pathprog)
        roty = troty
        pathdist = 2.5m
        mem43 = roty
        mem50 = roty
        mem38 = 0
        mem46 = 0
        mem51 = 0
        changestate(Coco_Tiger_Start)
    }
}

state Coco_Tiger_Run { // 155
    stateflag 0x52000005
    statusc 0x2000
    code() {
        if (animseq == getanim(SIS_TIGER_JUMP_1)) {
            spawn(9, 2, 1, -1.0, 5.0, groundvel + 8m)
            GLOBAL_101 = 2
            GLOBAL_100 = 0xFF
            playframes(SIS_TIGER_JUMP_2, 0.0, 11.0)
        }
        else if (animseq == getanim(SIS_TIGER_RUN_FAST)) {
            setanim(SIS_TIGER_RUN)
        }
        do {
            if (animseq != getanim(SIS_TIGER_RUN)) {
                setanim(SIS_TIGER_RUN, -1.0)
            }
            playframe((animframe + 1.0) % 23.0)
            if (animframe == 3.0 || animframe == 15.0) {
                SoundPitchDefault(0.25)
                sounddecay(0x9E)
                soundplay([Bs0aA], 0.6V)
                GLOBAL_101 = 2
                GLOBAL_100 = 0x7F
            }
        } while (1)
    }
    event(e, a) {
        if (e == EventHit || e == Event24 || e == Event7) {
            rejevret((e == EventHit || e == Event24) && invincible == 4)
            if (interrupter) {
                sendevent(EventHit, creator, a[0])
                if (eventaccepted) {
                    stateflag &= ~0x8000000
                    if (!invincible) {
                        invincible = 4
                        invincibletime = frametime
                    }
                    accevret()
                }
            }
            accevcstate(Coco_Tiger_Death)
        }
        accevcstate(Willy_Death, e == Event61)
        accevcstate(Coco_Tiger_Death_Thrown, e == Event35)
        if (e == Event21) {
            accevcstate(Coco_Tiger_Jump, stateflag & 0x4 || vely <= 0)
            rejevret()
        }
        if (e == Event68) {
            accev()
            mem40 = mem39
        }
        rejevret(e == Event60 || e == Event34)
    }
    trans {
        changestateif(Coco_Tiger_Boost, (buttonhold(PAD_R1 | PAD_CIRCLE) || buttonhold(PAD_R2 | PAD_SQUARE)) && mem41 == 10.0 && frametime - mem38 >= 12, 1.0)
        CheckJump(Coco_Tiger_Jump, 13.2665m)
        UpdateTigerMovement()
    }
}

sub UpdateTigerMovement() { // ETS-240
    if (mem51) {
        unless (buttonhold(PAD_R1 | PAD_CIRCLE) || buttonhold(PAD_R2 | PAD_SQUARE)) {
            mem51 = 0
        }
        mem41 = seek(mem41, 18.0, spd(3.0))
    }
    else {
        mem41 = seek(mem41, 10.0, spd(13.2))
    }
    pathprog = spd(pathprog, mem41)
    GLOBAL_3 = pathprog
    GLOBAL_82 = pathprog
    changestateif(Coco_Tiger_Finish, ((pathprog >= 426.0 && LEVEL == LEVEL_OrientExpress) || (pathprog >= 396.0 && LEVEL == LEVEL_MidnightRun)) && mem39 == mem44)
    if (pathprog >= pathlen - 1.0) {
        mem39 += 1.0
        interrupter = objectget(mem39)
        entity = interrupter -> entity
        pathlen = interrupter -> pathlen
        pathprog = 0
    }
    if (stateflag & 0x80000) {
        if (dirhold(PAD_LEFT)) {
            mem42 = seek(mem42, (pathdist * -mem45), (4m * ANALOGAMT) >> 8)
        }
        else if (dirhold(PAD_RIGHT)) {
            mem42 = seek(mem42, (pathdist * mem45), (4m * ANALOGAMT) >> 8)
        }
        else {
            mem42 = seek(mem42, 0, 8m)
        }
        if (STATUS_GROUNDLAND) {
            mem48 += degdist(mem43, mem50) * 0x190
        }
    }
    else {
        if (dirhold(PAD_LEFT)) {
            mem42 = seek(mem42, (pathdist * -mem45), (4m * ANALOGAMT) >> 8)
        }
        else if (dirhold(PAD_RIGHT)) {
            mem42 = seek(mem42, (pathdist * mem45), (4m * ANALOGAMT) >> 8)
        }
        else {
            mem42 = seek(mem42, 0, 8m)
        }
        if (STATUS_GROUNDLAND) {
            mem48 += degdist(mem43, mem50) * 0x190
        }
    }
    save (vecx, vecy, vecz) {
        calcpath(pathprog, vvec)
        x = vecx
        groundy = vecy
        z = vecz
    }
    mem48 = spd(mem48, mem42)
    if (mem48 < -GLOBAL_164) {
        if ((y - groundy > GLOBAL_165) || mem46) {
            if (STATUS_GROUNDLAND && (y - groundy > 0.2m)) {
                mem46 = 2.0
                mem48 = spd(mem48, 12m)
            }
            else {
                mem46 = 1.0
            }
        }
        else {
            mem48 = -GLOBAL_164
        }
    }
    else if (mem48 > GLOBAL_166) {
        if ((y - groundy > GLOBAL_167) || mem46) {
            if (STATUS_GROUNDLAND && (y - groundy > 0.2m)) {
                mem46 = 2.0
                mem48 = spd(mem48, -12m)
            }
            else {
                mem46 = 1.0
            }
        }
        else {
            mem48 = GLOBAL_166
        }
    }
    else {
        mem46 = 0
    }
    unless (STATUS_GROUNDLAND) {
        trotz = 0
    }
    save (scalex) {
        scalex = abs(scalex)
        save (trotx, troty, trotz, vecx, vecy, vecz) {
            SetTRot(0, mem50, 0)
            SetVec(x, y, z)
            vectransf2(vvec, vtrans, 0, -mem48, 0)
        }
    }
    mem43 = mem50
    mem50 = degseek(mem43, troty, 60deg)
    unless (dirhold(PAD_NONE) || stateflag & 0x80000) {
        troty = degseek(troty, ANALOGDIR + GAMEDIR, 900deg)
    }
    if (mem41 > 0xA00) {
        sendevent(EventSlideHit, collider, 0)
        if (eventaccepted) {
            sounddecay(0x90)
            SoundPitchDefault(0.23)
            soundplay([sht0A], 0.4V)
        }
    }
    if (collider) {
        sendeventif(EventHitInvincible, collider, (collider -> spawn >> 16) == 34 || (collider -> spawn >> 16 == 3), 0)
    }
}

state Coco_Tiger_Start { // 156
    stateflag 0x52002005
    statusc 0x2000
    event => state Coco_Tiger_Run
    trans => sub UpdateTigerMovement
    code() {
        if (!CHECKPOINTCOUNT) {
            playframes(4.0, 21.0)
            spawn(9, 1, 3, -1.0)
        }
        else {
            settrans(UpdateTigerRespawn)
            statusb &= ~FLAG_ROT_Y
            do {
                playframes(SIS_TIGER_RUN, 0.0, 22.0)
            } until (GAMEFLAGS & 0x1000)
            playframes(SIS_TIGER_RUN, 0.0, 4.0)
            statusb |= FLAG_ROT_Y
        }
        settrans(UpdateTigerMovement)
        SoundPitchDefault(0.25)
        sounddecay(0x9E)
        soundplay([Bs0aA], 0.6V)
        GLOBAL_101 = 2
        GLOBAL_100 = 0x7F
        playanim(5, SIS_TIGER_RUN)
        changestate(Coco_Tiger_Run)
    }
}

sub UpdateTigerRespawn() { // ETS-510
    roty = spd(roty, 540deg)
    if (animseq == getanim(SIS_TIGER_RUN) && (animframe == 3.0 || animframe == 15.0)) {
        SoundPitchDefault(0.25)
        sounddecay(0x9E)
        soundplay([Bs0aA], 0.6V)
        GLOBAL_101 = 2
        GLOBAL_100 = 0x7F
    }
}

state Coco_Tiger_Boost { // 157
    stateflag 0x52080005
    statusc 0x2000
    code(hold) {
        mem51 = hold
        if (animseq == getanim(SIS_TIGER_RUN)) {
            setanim(SIS_TIGER_RUN_FAST, animframe % 12.0)
            soundpitch((0xB33 + rand(3.2)) * 0.205 >> 8)
            sounddecay(0x9F)
            soundplay([BsbaA], 1V)
        }
        do {
            if (animseq != getanim(SIS_TIGER_RUN_FAST)) {
                setanim(SIS_TIGER_RUN_FAST, -2.0)
            }
            playframe((animframe + 2.0) % 12.0)
        } until (frametime - statetime >= 15 && !mem51)
        mem41 = 10.0
        changestate(Coco_Tiger_Run)
    }
    event(e, a) {
        rejevret(e == EventHit || (e == Event24 && invincible == 4))
        if (e == Event24 || e == Event7) {
            if (interrupter) {
                sendevent(EventHit, creator, a[0])
                if (eventaccepted) {
                    stateflag &= ~0x8000000
                    if (!invincible) {
                        invincible = 4
                        invincibletime = frametime
                    }
                    accevret()
                }
            }
            accevcstate(Coco_Tiger_Death)
        }
        accevcstate(Willy_Death, e == Event61)
        accevcstate(Coco_Tiger_Death_Thrown, e == Event35)
        accevcstate(Coco_Tiger_Jump, e == Event21)
        accevif (e == Event68) {
            mem40 = mem39
        }
        accevif (e == Event60) {
            mem51 = 1.0
        }
    }
    trans {
        mem38 = frametime
        UpdateTigerMovement()
        CheckJump(Coco_Tiger_Jump, 16m)
        if (animseq == getanim(SIS_TIGER_RUN_FAST) && ((animframe >= 2.0 && animframe <= 3.0) || (animframe >= 3.0 && animframe <= 4.0))) {
            spawn(9, 1, 2, 0)
            soundpitch((0x1199 + rand(3.2)) * 0.25 >> 8)
            sounddecay(0x9E)
            soundplay([Bs0aA], 0.7V)
            GLOBAL_101 = 2
            GLOBAL_100 = 0x7F
        }
    }
}

state Coco_Tiger_Jump { // 158
    stateflag 0x52000009
    statusc 0x2000
    event => state Coco_Tiger_Run
    __transargs
    code(vy) {
        if (!rand(2)) {
            scalex = -scalex
        }
        SoundPitchDefault(0.25)
        sounddecay(0x9F)
        soundplay([Bs4aA], 0.7V)
        playframes(SIS_TIGER_JUMP_1, 0.0, 18.0)
        sleep()
    }
    trans {
        once {
            vely = abs(vy)
        }
        if (collider, vely <= 0) {
            sendevent(EventJumpedOn, collider, BounceCombo)
            if (eventaccepted) {
                BounceCombo += 1.0
                changestate(Coco_Tiger_Jump, 12.64912m)
            }
        }
        if (frametime - statetime >= 2 && STATUS_GROUNDLAND) {
            GLOBAL_101 = 2
            GLOBAL_100 = 0xFF
            SoundPitchDefault(0.25)
            sounddecay(0x9F)
            soundplay([Bs5aA], 0.3V)
            if (mem51) {
                changestate(Coco_Tiger_Boost, mem51)
            }
            else {
                changestate(Coco_Tiger_Run)
            }
        }
        UpdateTigerMovement()
        if ((buttonhold(PAD_X) && (!(statusa & 0x80) || statusa & 0x100000)) && vy > 0) {
            vely = spd(vely, 10.5m)
        }
    }
}

state Coco_Tiger_Death { // 159
    stateflag 0x52001020
    statusc 0x1C22
    code(arg) {
        BeginDeath(arg)
        SoundPitchDefault(0x45)
        sounddecay(0xC9)
        soundplay([Bs2aA], 1V)
        statusb |= (FLAG_PHYSICS_TEST | FLAG_GRAVITY | FLAG_PHYSICS_ENGINE | FLAG_SOLID_GROUND)
        GAMEFLAGS |= 0x2
        GAMEFLAGS |= 0x20002
        GLOBAL_128 = x
        GLOBAL_129 = y
        GLOBAL_130 = z
        SoundPitchDefault()
        sounddecay(0xC8)
        soundplay([Bs9aA], 1V)
        GLOBAL_101 = 2
        GLOBAL_100 = 0xFF
        playframes(SIS_TIGER_DEATH_3, 0.0, 13.0)
        if (GLOBAL_151 == 5.0) {
            SoundPitchDefault(0.25)
            sounddecay(0x91)
            soundplay([BscaA], 1V)
        }
        SoundPitchDefault()
        sounddecay(0xC8)
        soundplay([Bs9aA], 0.3V)
        GLOBAL_101 = 2
        GLOBAL_100 = 0xFF
        spawn(9, 2, 1, -1.0, 9.0, 8m)
        ResetSpeed()
        statusb &= ~FLAG_SOLID_GROUND
        soundpitch(4.0)
        sounddecay(0xC9)
        sounddelay(12)
        soundplay([BscaA], 1V)
        if (GLOBAL_151 == 5.0) {
            SoundPitchDefault(0.25)
            sounddecay(0x91)
            sounddelay(50)
            soundplay([BscaA], 1V)
        }
        playframes(13.0, 99.0)
        soundpitch(0x399 + rand(0xCC))
        sounddecay(0x90)
        soundplay(SOUND_LAND_DEFAULT, 0.7V)
        playframes(100.0, 100.0)
        FadeOutAndWait()
        GAMEFLAGS &= ~0x20000
        CrashDoRespawn()
    }
    trans {
        if (animframe <= 13.0) {
            mem41 = seek(mem41, 10.0, spd(13.2))
        }
        else {
            mem41 = seek(mem41, 0, spd(13.2))
        }
        pathprog = spd(pathprog, mem41)
        if (pathprog > pathlen) {
            pathprog = pathlen - 1
        }
        GLOBAL_3 = pathprog
        save (vecx, vecy, vecz) {
            calcpath(pathprog, vvec)
            x = vecx
            groundy = vecy
            z = vecz
        }
        unless (STATUS_GROUNDLAND) {
            trotz = 0
        }
        save (scalex) {
            scalex = abs(scalex)
            save (trotx, troty, trotz, vecx, vecy, vecz) {
                SetTRot(0, roty, 0)
                SetVec(x, y, z)
                vectransf2(vvec, vtrans, 0, -mem48, 0)
            }
        }
        if (GAMEFLAGS & 0x20000) {
            getvert(vvec, self, 1.0)
            GLOBAL_128 = vecx
            GLOBAL_129 = vecy
            GLOBAL_130 = vecz
        }
    }
}

state Coco_Tiger_Death_Thrown { // 160
    stateflag 0x52001020
    statusc 0x1C22
    code(arg) {
        BeginDeath(arg)
        SetVel(0, 0, 0)
        statusb |= FLAG_PHYSICS_ENGINE
        GAMEFLAGS |= 0x2
        SoundPitchDefault(0x45)
        sounddecay(0xC9)
        soundplay([Bs2aA], 1V)
        SoundPitchDefault()
        sounddecay(0xC8)
        soundplay([Bs9aA], 1V)
        GLOBAL_101 = 2
        GLOBAL_100 = 0xFF
        zindex = 64
        GAMEFLAGS |= 0x20000
        GLOBAL_128 = x
        GLOBAL_129 = y
        GLOBAL_130 = z
        spawn(10, 5)
        vely = 0
        velx = 0.45m
        velz = 1.049995m
        playanim(1, SIS_TIGER_DEATH_1)
        playanim(2, SIS_TIGER_DEATH_1)
        spawn(9, 21, 1, 2.0, 4m, 0, 0, 2S, 2.4, 24, 6)
        spawn(9, 21, 1, 2.0, -4m, 0, 0, 2S, 2.4, 24, 6)
        playframes(2.0, 38.0)
        SetVel(0, -9.5m, 0)
        statusb |= (FLAG_PHYSICS_TEST | FLAG_GRAVITY | FLAG_PHYSICS_ENGINE | FLAG_SOLID_GROUND)
        until (STATUS_GROUNDLAND) {
            playframe()
        }
        statusb &= ~(FLAG_PHYSICS_TEST | FLAG_GRAVITY | FLAG_PHYSICS_ENGINE)
        SoundPitchDefault(0.23)
        sounddecay(0x90)
        soundplay(SOUND_LAND_DEFAULT, 0.3V)
        if (GLOBAL_151 == 5.0) {
            SoundPitchDefault(0.25)
            sounddecay(0x91)
            sounddelay(25)
            soundplay([BscaA], 1V)
        }
        playframes(38.0, 99.0)
        do (var i = 0) {
            playframes(SIS_TIGER_DEATH_2, 0.0, 25.0)
        } while ({ i += 1.0 }; i < 3.0)
        FadeOutAndWait()
        GAMEFLAGS &= ~0x20000
        CrashDoRespawn()
    }
    trans {
        if (GAMEFLAGS & 0x20000) {
            getvert(vvec, self, 0.0)
            GLOBAL_128 = vecx
            GLOBAL_129 = vecy
            GLOBAL_130 = vecz
        }
    }
}

state Coco_Tiger_Finish { // 161
    stateflag 0x52000009
    statusc 0x2000
    code() {
        scalex = abs(scalex)
        vely = 6.32456m
        playframes(SIS_TIGER_JUMP_1, 0.0, 5.0)
        SoundJumpDefault(14.4, 0.205, 0x40, 1V)
        playframes(6.0, 18.0)
        until (STATUS_GROUNDLAND) {
            playframe()
        }
        spawn(9, 2, 1, 0, 5.0, 4m)
        soundpitch(0x399 + rand(0xCC))
        sounddecay(0x90)
        soundplay(SOUND_LAND_DEFAULT, 0.8V)
        GLOBAL_101 = 2
        GLOBAL_100 = 0xFF
        onstateexit(ResetMovement)
        ResetSpeed()
        if (GLOBAL_173) {
            broadcastevent(Event39, 0, self, 1)
        }
        playframes(SIS_TIGER_JUMP_2, 0.0, 4.0)
        GAMEFLAGS |= 0x20000
        setanim(SIS_TIGER_FINISH_1, -1.0) 
        do {
            animframe += 1.0
            if (animframe == 53.0) {
                soundpitch(3.263)
                soundplay([Bs6aA], 1V)
            }
            playframe()
        } while (animframe + 1.0 <= 104.0)
        save (stalltime) {
            statusb |= 0x100000
            stalltime = 2
            soundpitch(3.263)
            soundplay([Bs6aA], 1V)
            playframes(105.0, 117.0)
            playframes(SIS_TIGER_FINISH_2, 0.0, 13.0)
            statusb &= ~0x100000
        }
        stateflag &= ~0x8
        playframes(14.0, 21.0)
        spawn(10, 4, 1, 0x15A4)
        getvert(vtrans, self, 0)
        roty += 65deg
        changestate(Coco_Init)
    }
    trans {
        once {
            mem41 = 10.0
            statusb &= ~FLAG_GRAVITY
        }
        if (stateflag & 0x8) {
            if (STATUS_GROUNDLAND) {
                mem41 = seek(mem41, 0, spd(6.0))
            }
            pathprog = spd(pathprog, mem41)
            if (pathprog >= pathlen) {
                pathprog = pathlen - 1.0
            }
            calcpath(pathprog, vvec)
            mem48 = seek(mem48, 0, spd(2m))
            x = vecx
            z = vecz
            groundy = vecy
            save (scalex) {
                scalex = abs(scalex)
                save (trotx, troty, trotz, vecx, vecy, vecz) {
                    SetTRot(0, roty, 0)
                    SetVec(x, y, z)
                    vectransf2(vvec, vtrans, 0, -mem48, 0)
                }
            }            
        }
        getvert(vvec, self, 1.0)
        GLOBAL_128 = vecx
        GLOBAL_129 = vecy
        GLOBAL_130 = vecz
        vely = spd(vely, -10m)
    }
}
#module default