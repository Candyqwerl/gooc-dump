#module[WiliC] // 2010I
sub CleanupEgyptDeath() { // ES-752
    GLOBAL_3 = 0
    DeloadExtraAnims()
    RestoreAfterHit()
}

state Willy_Gate_Smash { // 132
    stateflag 0x431
    statusc 0xC22
    code(hit) {
        if (interrupter) {
            if (interrupter -> spawn == 0x280000) {
                statusc = 0
                changestate(Willy_Door_Smash)
            }
        }
        onstateexit(RestoreAfterHit)
        statusb &= ~(FLAG_ROT_Y | FLAG_DPAD_CONTROL | FLAG_HAS_SHADOW)
        ResetSpeed()
        PlayDeathArg(0.5V)
        GLOBAL_101 = 2
        GLOBAL_100 = 0xFF
        scaley = 0.75S
        playframe()
        scaley = 0.5S
        playframe()
        scaley = 0.25S
        playframe()
        scaley = 0.1S
        playframe()
        goto skipfirst
        do {
            playframe()
            skipfirst:
        } while (interrupter, interrupter -> stateflag & 0x40, frametime - statetime < 50)
        mem47 = 0
        sendevent(EventHit, creator, hit)
        if (eventaccepted) {
            stateflag &= ~0x8000000
            mem47 = 1.0
        }
        if (mem47) {
            roty += degdist(roty, GAMEDIR) >> 1
        }
        else {
            stateflag |= 0x8000020
            roty = GAMEDIR
        }
        scaley = 0.25S
        playanim2(WILLY_DEATH_SMASH_1, 2.0)
        scaley = 0.5S
        playanim2(WILLY_DEATH_SMASH_1, 2.0)
        scaley = 0.75S
        playanim2(WILLY_DEATH_SMASH_1, 3.0)
        scaley = 1S
        if (mem47) {
            do (var start = frametime) {
                playanim2(WILLY_DEATH_SMASH_1, 2.0)
                if (!rand(10)) {
                    playanim2(WILLY_DEATH_SMASH_1, 1.0)
                    setanim(WILLY_DEATH_SMASH_1)
                    playframe(0.0, 2)
                    playanim2(WILLY_DEATH_SMASH_1, 1.0)
                }
            } while (frametime - start < 50)
            scaley = 1S
            playframes(WILLY_DEATH_SMASH_RECOVER_1, 0.0, 15.0)
            zindex = 32
            changestate(Willy_Idle)
        }
        KillBonus()
        playframes(4.0, 95.0)
        FadeToBlack()
        playframes(95.0, 101.0)
        WaitFadeFrame()
        scaley = 1S
        zindex = 32
        CrashDoRespawn()
    }
}

state Willy_Door_Smash { // 133
    stateflag 0x431
    statusc 0xC22
    code(hit) {
        onstateexit(RestoreAfterHit)
        statusb &= ~(FLAG_DPAD_CONTROL | FLAG_HAS_SHADOW)
        ResetSpeed()
        PlayDeathArg(0.5V)
        if (interrupter) {
            troty = interrupter -> roty
            roty = troty
        }
        GLOBAL_101 = 2
        GLOBAL_100 = 0xFF
        scalex = 0xA8F
        playframe()
        scalex = 0x547
        playframe()
        goto skipfirst
        do {
            playanim2(WILLY_DEATH_SMASH_2, 0.0)
            skipfirst:
        } while (interrupter, interrupter -> stateflag & 0x40, frametime - statetime < 50)
        setanim(WILLY_DEATH_SMASH_2)
        playframe(0.0, 21)
        mem47 = 0
        sendevent(EventHit, creator, hit)
        if (eventaccepted) {
            stateflag &= ~0x8000001
            mem47 = 1.0
        }
        if (mem47) {
            tpc = 0
        }
        else {
            stateflag |= 0x8000020
        }
        zindex = 0x42
        scalex = 1S
        playframes(WILLY_DEATH_SMASH_2, 0.0, 8.0)
        statetime = frametime
        if (!mem47) {
            settrans(UpdateDoorDeath)
        }
        playframes(WILLY_DEATH_SMASH_3, 0.0, 11.0)
        if (mem47) {
            tpc = 0
            playframes(WILLY_DEATH_SMASH_RECOVER_2, 0.0, 13.0)
            zindex = 32
            changestate(Willy_Idle)
        }
        do (var i = 0) {
            playframes(WILLY_DEATH_SMASH_3, 0.0, 11.0)
        } while ({ i += 1.0 }; i < 2.0)
        FadeToBlack()
        playframes(0.0, 10.0)
        scaley = 1S
        zindex = 32
        CrashDoRespawn()
    }
    trans {
        if (interrupter) {
            x = seek(x, interrupter -> x, spd(40m))
        }
    }
}

sub UpdateDoorDeath() { // ES-996
    roty = spd(roty, 30deg)
    scaley = seek(scaley, 3.2, spd(0xCCC))
}

