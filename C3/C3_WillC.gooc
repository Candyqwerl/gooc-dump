sub PlayCocoIdle() { // EAS-3
    ResetCombos()
    playframes(SIS_STAND_1, 0.0, 27.0)
    mem47 = rand(0x4B)
    WaitFrame(mem47)
    mem48 = 1.0
    do {
        if (!rand(6) || mem48) {
            playframes(SIS_STAND_2, 0.0, 35.0)
            mem48 = 0
        }
        mem47 = 50 + rand(0x4B)
        WaitFrame(0, SIS_STAND_3, mem47)
        playframes(SIS_STAND_3, 0.0, 39.0)
        mem47 = 50 + rand(0x4B)
        do (var start = frametime) {
            playframes(SIS_STAND_4, 0.0, 37.0)
        } while (frametime - start < mem47)
        if (!rand(2)) {
            playanim(20, SIS_STAND_3)
            playframes(SIS_STAND_5, 0.0, 91.0)
        }
        playframesback(SIS_STAND_3, 20.0, 0.0)
    } while (1)
}

