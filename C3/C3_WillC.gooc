        GLOBAL_128 = x
        GLOBAL_129 = y
        GLOBAL_130 = z
        velx = 0
        velz = 0
        if (vely > 0) {
            vely = 0
        }
        playframes(WILLY_DEATH_FROG_1, 0.0, 21.0)
        playanim2(WILLY_DEATH_FROG_2, 0.0)
        playanim2(WILLY_DEATH_FROG_2, 1.0)
        playanim2(WILLY_DEATH_FROG_2, 2.0)
        playanim2(WILLY_DEATH_FROG_2, 3.0)
        playanim2(WILLY_DEATH_FROG_2, 3.0)
        playanim2(WILLY_DEATH_FROG_2, 4.0)
        settrans(UpdateFrogDeathCamera)
        playframe(animframe, 4)
        playanim2(WILLY_DEATH_FROG_3, 0.0)
        playanim2(WILLY_DEATH_FROG_3, 1.0)
        do (var i = 0) {
            playframesback(WILLY_DEATH_FROG_3, 0.0, 0.0)
            playanim2(WILLY_DEATH_FROG_3, 0.0)
            playanim2(WILLY_DEATH_FROG_3, 1.0)
        } while ({ i += 1.0 }; i < 4.0)
        playanim2(WILLY_DEATH_FROG_4, 0.0)
        playanim2(WILLY_DEATH_FROG_4, 1.0)
        playanim2(WILLY_DEATH_FROG_4, 1.0)
        playanim2(WILLY_DEATH_FROG_5, 0.0, 2)
        playanim2(WILLY_DEATH_FROG_5, 1.0)
        playanim2(WILLY_DEATH_FROG_5, 1.0, 2)
        playanim2(WILLY_DEATH_FROG_5, 1.0)
        playanim2(WILLY_DEATH_FROG_5, 1.0)
        playanim2(WILLY_DEATH_FROG_5, 1.0, 2)
        playanim2(WILLY_DEATH_FROG_6, 0.0)
        playanim2(WILLY_DEATH_FROG_6, 1.0)
        playanim2(WILLY_DEATH_FROG_6, 2.0)
        playanim2(WILLY_DEATH_FROG_6, 2.0)
        playframe(animframe, 31)
        FadeOutAndWait()
        CrashDoRespawn()
    }
}

sub UpdateFrogDeathCamera() { // EFS-271
    GLOBAL_128 = seek(GLOBAL_128, (x + CAMTRANSX) >> 1, spd(1m))
    GLOBAL_129 = seek(GLOBAL_129, (y + CAMTRANSY) >> 1, spd(1m))
    GLOBAL_130 = seek(GLOBAL_130, (z + CAMTRANSZ) >> 1, spd(1m))
}

state Willy_Death_Giant { // 128
    stateflag 0x433
    statusc 0xC22
    code(hit) {
        TryBeginDeath(hit)
        KillBonus()
        if (!rand(2)) {
            scalex = -scalex
        }
        GLOBAL_75 = 25
        GLOBAL_65 = -1
        soundpitch((8.0 + rand(0x199)) * 0.23 >> 8)
        sounddecay(0xC2)
        soundplay([sht0A], 0x4CCB)
        SoundPitchDefault()
        sounddecay(0xC1)
        soundplay([arg0A], 0.6V)
        SoundJumpDefault(14.4, 0.205, 0xC0, 1V)
        vecx = (CAMTRANSX - x) >> 3
        vecy = (CAMTRANSY - y) >> 3
        vecz = (CAMTRANSZ - z) >> 3
        roty = miscfunc(vecx, self, 1, 2)
        troty = roty
        setanim(WILLY_DEATH_BATON, -1.0)
        do {
            animframe += 1.0
            x += vecx
            y += vecy
            z += vecz
            playframe()
        } while (animframe + 1.0 <= 7.0)
        if (!SHAKEY) {
            SHAKEY = 8.0
        }
        soundpitch(0x3A0)
        sounddecay(0xC8)
        soundplay([de20A], 1V)
        vely = 0
        do (var start = frametime) {
            vely = spd(vely, -0.2m)
            y = spd(y, vely)
            scaley = spd(scaley, 0x666)
            if (frametime - statetime >= 52 && !FADECONTROL) {
                FadeToBlack()
            }
            playframe()
        } while (frametime - start < 62)
        CrashDoRespawn()
    }
}

state Willy_Death_Wizard { // 129
    stateflag 0x433
    statusc 0xC22
    code(hit) {
        TryBeginDeath(hit)
        KillBonus()
        statusb |= (FLAG_PHYSICS_TEST | FLAG_GRAVITY | FLAG_PHYSICS_ENGINE)
        playanim2(WILLY_DEATH_WIZARD_1, 0.0)
        playanim2(WILLY_DEATH_WIZARD_1, 1.0)
        playanim2(WILLY_DEATH_WIZARD_1, 2.0)
        playanim2(WILLY_DEATH_WIZARD_1, 2.0)
        spawn(9, 40, 1, getins(SetWizardExplosionColor), 0)
        statusb &= ~FLAG_HAS_SHADOW
        playframes(WILLY_DEATH_WIZARD_2, 17.0, 33.0)
        SoundPitchDefault(0.25)
        sounddecay(3.2s)
        soundplay([FCrbA], 0.6V)
        SoundPitchDefault(0.25)
        sounddecay(3.2s)
        sounddelay(25)
        soundplay([FCrbA], 0.6V)
        playframes(WILLY_DEATH_WIZARD_2, 0.0, 33.0)
        FadeOutAndWait()
        CrashDoRespawn()
    }
    trans {
        do (var i = 0) {
            var vx = !rand(2) ? 1m + rand(1m) : -(1m + rand(1m))
            var vy = !rand(2) ? 1m + rand(1m) : -(1m + rand(1m))
            var vz = !rand(2) ? 1m + rand(1m) : -(1m + rand(1m))
            spawn(25, 2, 1, -1.0, vx, vy, vz)
        } while ({ i += 1.0 }; i < 10.0)
        if (frametime - statetime >= 5) {
            tpc = 0
        }
    }
}

sub SetWizardExplosionColor() { // EFS-486
    if (var r = rand(4); r == 0) {
        SetColor1(0x39, 0x95, 0x28)
    }
    else if (r == 1) {
        SetColor1(0x39, 0x95, 0x28)
    }
    else if (r == 2) {
        SetColor1(0x52, 0xA3, 0x67)
    }
    else if (r == 3) {
        SetColor1(0x47, 0x9C, 0x1A)
    }
    SetScale(3S)
}
