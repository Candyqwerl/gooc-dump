sub PlayKnockback(vy, flags, proc) { // S-5484
    SoundJumpDefault(14.4, 0.205, 0x40, 0x666)
    vely = vy
    playframes(WILLY_MINE, 0.0, 17.0)
    do {

        playanim2(WILLY_MINE, 18.0)
    } until (STATUS_GROUNDLAND || (vely < 0 && spd(y, vely) <= field_63))
    if (!STATUS_GROUNDLAND) {
        playanim2(WILLY_MINE, 18.0)
        if (!STATUS_GROUNDLAND) {
            playanim2(WILLY_MINE, 19.0)
        }
    }
    if (flags & 0x1) {
        ResetSpeed()
    }
    if (proc) {
        tpc = proc
    }
    GLOBAL_101 = 2
    GLOBAL_100 = 0xFF
    spawn(9, 2, 1, 0, 5.0, 4m)
    unless (stateflag & 0x100000 || flags & 0x2) {
        playframes(WILLY_MINE, 20.0, 25.0)
    }
}

