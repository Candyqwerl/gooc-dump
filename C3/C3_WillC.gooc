sub PlayWarpOut(skip, result) { // S-5581
    var vspd = speed
    var rx = rotx
    var ry = roty
    var rz = rotz
    if (LEVEL == LEVEL_RingsOfPower || LEVEL == LEVEL_MadBombers || LEVEL == LEVEL_ByeByeBlimps || LEVEL == LEVEL_BossNGin2) {
        cascadeevent(Event12, self, 0)
        playnull(21)
        unless (GLOBAL_173) {
            soundstop()
        }
        playnull(21)
    }
    else {
        ResetSpeed()
        vely = 0
        statusb &= ~(FLAG_ROT_Y | FLAG_PHYSICS_TEST | FLAG_GRAVITY | FLAG_PHYSICS_ENGINE | FLAG_DPAD_CONTROL | FLAG_ROT_Y2 | 0x20002000)
        statusb |= (FLAG_ROT_Y | 0x2000)
        trotx = 720deg
        yzapproach = 360deg
        if (interrupter) {
            troty = atan2(self, interrupter -> x)
            trotz = atan2_3d(self, interrupter -> x) + 10deg
        }
        else {
            troty = roty
            trotz = 0
        }
        zindex = 100
        rotz = troty
        soundpitch(0x173)
        sounddecay(0xFA)
        soundplay([WSu2A], 1V)
        if (LEVEL == LEVEL_DeepTrouble || LEVEL == LEVEL_UnderPressure) {
            spawn2(20, 4)
        }
        unless (skip || GLOBAL_173) {
            soundstop()
        }
        unless (tpc) {
            settrans(SUB_5860)
        }
        if (LEVEL == LEVEL_MidnightRun || LEVEL == LEVEL_OrientExpress) {
            playframes(SIS_WARP_OUT, 0.0, 28.0)
            animseq = 0
        }
        else if (LEVEL == LEVEL_HotCoco || LEVEL == LEVEL_SkiCrazed || LEVEL == LEVEL_TellNoTales || LEVEL == LEVEL_MakinWaves) {
            vfx = 0
            speed = 0
            voice = ActionVoice
            soundsetup(5, voice, 6)
            soundsetup(0, voice, 3, 0)
            interrupter = GLOBAL_110
            sendevent(Event20, interrupter, 0)
            if (GLOBAL_151 == 5.0) {
                SoundPitchDefault(0.25)
                soundplay([1226I], 1V) // TODO: Find EID
            }
            spawn(15, 27, 1, vspd, rx, ry, rz)
            playframes(SIS_JETSKI_WARP_OUT, 0.0, 28.0)
            animseq = 0
        }
        else if (LEVEL == LEVEL_Area51 || LEVEL == LEVEL_OrangeAsphalt || LEVEL == LEVEL_RoadCrash || LEVEL == LEVEL_HogRide) {
            statusb &= ~(FLAG_ROT_Y | FLAG_HAS_SHADOW | 0x2000)
            rotz = 0
            playframe(animframe, 10)
            playframes(WILLY_BIKE_WIN_WARP_OUT, 0.0, 16.0)
            tpc = 0
            zindex = 40
        }
        else {
            playframes(WILLY_WARP_IN, 0.0, 28.0)
            animseq = 0
        }
    }
    if (GLOBAL_173 && result != 0x2B00) {
        var0 = 0
        broadcastevent(Event39, 0, self, 0)
        do {
            playframe()
        } until (var0)
    }
    GLOBAL_193 = 0
    cascadeevent(Event12, self, self)
}

#module [Wil3C] // 2014I
state Willy_Death_Freeze { // 143
    stateflag 0x33
    statusc 0xC22
    code(yaw) {
        TryBeginDeath(yaw)
        KillBonus()
        statusb |= FLAG_ROT_Y
        trotx = 720deg
        troty = yaw
        playanim2(ANIM_0x49700, 0.0, 3)
        do (var i = 0) {
            playframes(ANIM_0x49700, 0.0, 17.0)
            do (var start = frametime) {
                playframe()
                x += 0.1m
                playframe()
                x -= 0.1m
            } while (frametime - start < 15)
            playframes(ANIM_0x49C00, 0.0, 15.0)
            playframe(animframe, 3)
        } while ({ i += 1.0 }; i < 3.0)
        FadeOutAndWait()
        CrashDoRespawn()
    }
}

state Willy_Death_Squash_2 { // 144
    stateflag 0x33
    statusc 0xC22
    code(hit) {
        TryBeginDeath(hit)
        KillBonus()
        if (interrupter) {
            var0 = interrupter
            settrans(FollowCrusher)
        }
        GLOBAL_75 = 12
        GLOBAL_65 = 0x33333333
        GLOBAL_101 = 2
        GLOBAL_100 = 0xFF
        soundsetup(7, self, 8)
        sounddecay(7.7s)
        SoundPitchDefault(0x4B)
        soundplay([Sq10A], 1V)
        playanim2(WILLY_DEATH_SQUASHED, 0.0)
        playanim2(WILLY_DEATH_SQUASHED, 1.0)
        playanim2(WILLY_DEATH_SQUASHED, 2.0)
        playanim2(WILLY_DEATH_SQUASHED, 3.0)
        playanim2(WILLY_DEATH_SQUASHED, 4.0)
        playanim2(WILLY_DEATH_SQUASHED, 4.0)
        playanim2(WILLY_DEATH_SQUASHED, 5.0)
        playanim2(WILLY_DEATH_SQUASHED, 6.0)
        playframe(animframe, 42)
        FadeOutAndWait()
        CrashDoRespawn()
    }
}

sub FollowCrusher() { // E3S-235
    interrupter = var0
    x += (interrupter -> x - x) >> 1
    z += (interrupter -> z - z) >> 1
    interrupter -> zindex = zindex + 64
}
#module default

state Willy_Level_Complete { // 145
    stateflag 0x20
    statusc 0x422
    code(result) {
        onstateexit(CleanupLevelExit)
        preloadlevel(LEVEL_WarpRoom)
        if (var level = LEVEL; level == LEVEL_BossTiny || level == LEVEL_BossDingodile || level == LEVEL_BossNTropy || level == LEVEL_BossCortex2) {
            save (interrupter) {
                eventreceived = 0
                WillyPlayInvincible(0x43)
                GAMEFLAGS &= ~0x10000
                var0 = 1.0
                if (result % 2000.0 >= 700.0) {
                    var0 = 0
                    spawn2(BosBC, BosBC_S_REWARD_DESC, 1, result % 2000.0)
                }
                if (getpayload(&[CD20V], &[Cr10G], &[CD10V], &[Cr10G]) <= getfreepages()) {
                    LoadAnim([CD10V], [Cr10G])
                    ExtraAnimGroup = 15.0
                    do {
                        PlayMoveFrame()
                    } until ((isloaded([Cr10G]) && isloaded([CD10V])) && STATUS_GROUNDLAND)
                    statusb = (FLAG_HAS_SHADOW | FLAG_STALL)
                    do {
                        WillyPlayDance()  
                    } until (var0)
                }
                else {
                    do {
                        PlayMoveFrame()
                    } until (var0)
                }
                statusb = (FLAG_HAS_SHADOW | FLAG_STALL)
                PlayMoveFrame()
            }
            PlayWarpOut(0, result)
            if (result >= 2000.0) {
                SetLevelResult(3.0)
                SUB_5856(LEVEL)
                if (result >= 4000.0) {
                    loadlevel(LEVEL_GameWin2)
                }
                else {
                    loadlevel(LEVEL_GameEnd2)
                }
                sleep()
            }
        }
        else {
            statusb = (statusb & FLAG_INVISIBLE) | (FLAG_HAS_SHADOW | FLAG_STALL)
            PlayWarpOut(0, result)
        }
        if (var temp = result; temp == 0x2B00) {
            GLOBAL_150 |= 0x400000
            SetLevelResult(4.0)
            GLOBAL_193 = 0
            GLOBAL_131 = 0
            GLOBAL_191 = -1
            loadlevel(LEVEL_HotCoco)
        }
        else {
            SetLevelResult(3.0)
            SUB_5856(LEVEL)
            if (GLOBAL_191 >= 0) {
                loadlevel(LEVEL_IntermissionVortex)
            }
            else {
                loadlevel(LEVEL_WarpRoom)
            }
        }
        sleep()
    }
    event(e, a) {
        if (e == Event21) {
            accev()
            var0 = 1.0
        }
        rejevret(e == Event22)
    }
}

sub CleanupLevelExit() { // S-5853
    BounceCombo = 0
    ResetMovement()
}

sub SUB_5856(arg) { // S-5856
    var v1 = arg
    GLOBAL_131 = 1
}

sub SUB_5860() { // S-5860
    zindex = 200
}

#module [Wil2C] // 2009I
#purge 2
state Willy_Warp_Idle { // 146
    stateflag 0x801
    statusc 0x1C22
    code() {
        onstateexit(ResetMovement)
        statusb &= ~FLAG_DPAD_CONTROL
        ResetSpeed()
        var0 = 0
        animframe = 0
        setanim(WILLY_WARP_IDLE_1, -1.0)
        do {
            animframe += 1.0
            if (var0) {
                goto next
            }
            playframe()
        } while (animframe + 1.0 <= 24.0)
        do {
            playanim2(WILLY_WARP_IDLE_2, 0.0)
            if (var0) {
                next:
                if (animseq != getanim(WILLY_WARP_IDLE_1)) {
                    setanim(WILLY_WARP_IDLE_1, 24.0)
                }
                setanim(WILLY_WARP_IDLE_1, animframe + 4.0)
                do {
                    playframe(animframe - 4.0)
                } while (animframe - 4.0 >= 0)
                changestate(Willy_Idle)
            }
            if (!rand(100)) {
                playframes(WILLY_WARP_IDLE_2, 1.0, 7.0)
                do (var i = 0) {
                    playanim2(WILLY_WARP_IDLE_2, 8.0)
                    playanim2(WILLY_WARP_IDLE_2, 9.0)
                    playanim2(WILLY_WARP_IDLE_2, 10.0)
                    setanim(WILLY_WARP_IDLE_2)
                    playanim2(WILLY_WARP_IDLE_2, 11.0)
                    setanim(WILLY_WARP_IDLE_2)
                    playanim2(WILLY_WARP_IDLE_2, 10.0)
                    playanim2(WILLY_WARP_IDLE_2, 9.0)
                } while ({ i += 1.0 }; i < 4.0)
                playframesback(8.0, 1.0)
            }
        } while (1)
    }
    event(e, a) {
        if (e == Event21) {
            accev()
            var0 = 1.0
        }
    }
}

state Willy_Warp_In { // 147
    stateflag 0x801
    statusc 0x1C22
    code(obj, coco) {
        if (coco) {
            statusb &= ~FLAG_DPAD_CONTROL
            vely = 0
            playanim2(WILLY_FACE_SLAM_5, 0.0)
            playanim2(WILLY_FACE_SLAM_5, 1.0)
            playanim2(WILLY_FACE_SLAM_5, 1.0)
            do {
                playanim2(WILLY_FACE_SLAM_1, 0.0)
            } until (STATUS_GROUNDLAND)
            ResetSpeed()
            playframes(WILLY_FACE_SLAM_1, 1.0, 4.0)
            spawn(9, 2, 1, -1.0, 7.0, groundvel + 8m)
            soundpitch((0xA8F + rand(3.2)) * 0.23 >> 8)
            sounddecay(0x90)
            soundplay(SOUND_LAND_DEFAULT, 1V)
            playframe(animframe, 10)
            soundstop()
            sleep()
        }
        else {
            statusb &= ~(FLAG_PHYSICS_TEST | FLAG_GRAVITY | FLAG_PHYSICS_ENGINE | FLAG_DPAD_CONTROL)
            ResetSpeed()
            vely = 0
            statusb |= (FLAG_ROT_Y | 0x2000)
            trotx = 720deg
            yzapproach = 360deg
            interrupter = obj
            troty = atan2(interrupter -> trans)
            trotz = atan2_3d(self, interrupter -> trans) + 10deg
            zindex = 200
            rotz = troty
            soundpitch(0x173)
            sounddecay(0xFA)
            soundplay([WSu2A], 1V)
            soundstop()
            playframes(WILLY_WARP_IN, 0.0, 28.0)
        }
        sleepnull()
    }
}
#module default

state Willy_Respawn { // 148
    stateflag 0x2001
    statusc 0x1422
    code(arg) {
        onstateexit(ResetMovement)
        statusb = (FLAG_NO_CAMERA_CLIP | FLAG_HAS_SHADOW | FLAG_STALL)
        playnull()
        SetScale(1S)
        ResetRespawnFields()
        sendevent(Event15, creator, 4.0)
        {
            var dda
            var masks = var0
            if (LEVEL == LEVEL_HotCoco || LEVEL == LEVEL_BossCortex2 || LEVEL == LEVEL_BossNGin2 || LEVEL == LEVEL_RingsOfPower || LEVEL == LEVEL_MadBombers || LEVEL == LEVEL_ByeByeBlimps) {
                dda = 2.0
            }
            else if (LEVEL == 0x3D00) {
                dda = -2.0
            }
            else if (LEVEL == LEVEL_BossDingodile) {
                if (SECTIONDEATHCOUNT >= 12.0 && !masks) {
                    dda = -1.0
                    masks = 1.0
                }
                else {
                    dda = 2.0
                }
            }
            else if (CHECKPOINTID > 0) {
                interrupter = objectget(CHECKPOINTID)
                if (interrupter) {
                    save (entity) {
                        entity = interrupter -> entity
                        dda = fieldval(0x29800)
                    }
                }
            }
            else {
                dda = mem32
            }
            if (((SECTIONDEATHCOUNT >= 7.0 && dda < 2.0) || dda <= -1.0) && masks <= 1.0) {
                sendevent(Event6, creator, self, -SECTIONDEATHCOUNT)
                sendeventif(Event6, creator, ((SECTIONDEATHCOUNT >= 15.0 && dda < 1.0) || dda <= -2.0) && !masks, self, -2)
            }
        }
        if (DEATHCOUNT == 0) {
            GLOBAL_66 = frametime
        }
        if (var level = LEVEL; level == LEVEL_WarpRoom) {
            if (CURRENTLEVEL != 99) {
                {
                    var v4 = 0
                    if (CURRENTLEVEL == LEVEL_BossCortex2 || CURRENTLEVEL == LEVEL_BossNGin2 || CURRENTLEVEL == LEVEL_BossNTropy || CURRENTLEVEL == LEVEL_BossDingodile || CURRENTLEVEL == LEVEL_BossTiny) {
                        if (var index = CURRENTLEVEL >> 8; index < 32) {
                            misc = GLOBAL_27 & (1 << index)
                        }
                        else {
                            misc = GLOBAL_28 & (1 << (index - 32))
                        }
                        v4 = misc
                    }
                    else {
                        if (var index = CURRENTLEVEL >> 8; index < 32) {
                            misc = SAVEDCRYSTALPOOL1 & (1 << index)
                        }
                        else {
                            misc = SAVEDCRYSTALPOOL2 & (1 << (index - 32))
                        }
                        v4 = misc
                    }
                    if (!v4) {
                        var v5, v6, v7
                        getrank(CURRENTLEVEL + 3, v5, v6, v7)
                        v5 += GLOBAL_184
                        v6 += GLOBAL_185 >> 8
                        setrank(CURRENTLEVEL + 3, v7, v6, v5)
                    }
                }
                if (GLOBAL_10 == 3.0) {
                    if (var index = CURRENTLEVEL >> 8; index < 32) {
                        GLOBAL_27 = (1 << index) | GLOBAL_27
                    }
                    else {
                        GLOBAL_28 = (1 << (index - 32)) | GLOBAL_28
                    }
                }
                hpc = 0
                {
                    var coco = CURRENTLEVEL == LEVEL_BossNGin2 || CURRENTLEVEL == LEVEL_ByeByeBlimps || CURRENTLEVEL == LEVEL_HotCoco || CURRENTLEVEL == LEVEL_TellNoTales
                        || CURRENTLEVEL == LEVEL_SkiCrazed || CURRENTLEVEL == LEVEL_MakinWaves || CURRENTLEVEL == LEVEL_MidnightRun || CURRENTLEVEL == LEVEL_OrientExpress
                    if ((GEMPOOL1 || GEMPOOL2 || CRYSTALPOOL1 || CRYSTALPOOL2 || GLOBAL_179 || GLOBAL_180 || GLOBAL_181 || GLOBAL_182) && GLOBAL_10 == 3.0) {
                        changestate(Willy_Warp_Return_Win, coco)
                    }
                    else {
                        changestate(Willy_Warp_Return_Fail, coco)
                    }
                }
            }
            goto exit
        }
        else if (level == LEVEL_UnderPressure || level == LEVEL_DeepTrouble) {
            WillyRespawnFromOrb(0, 0, 0)
            changestate(Willy_Scuba_Init)
        }
        else if (level == LEVEL_HogRide || level == LEVEL_RoadCrash || level == LEVEL_OrangeAsphalt || level == LEVEL_Area51) {
            GLOBAL_11 = 0
            roty = 180deg
            troty = roty
            statusb |= FLAG_INVISIBLE
            setanim(WILLY_BIKE_MOUNT, 0)
            interrupter = GLOBAL_97
            sendevent(Event34, interrupter, 0)
            WillyRespawnFromOrb(-1, -1, -1)
            changestate(Willy_Bike_Start)
        }
        else if (level == LEVEL_ByeByeBlimps || level == LEVEL_MadBombers || level == LEVEL_RingsOfPower) {
            changestate(Willy_Biplane_Init)
        }
        else if (level == LEVEL_BossNGin2) {
            changestate(Coco_Spaceship_Init)
        }
        else if (level == LEVEL_OrientExpress || level == LEVEL_MidnightRun) {
            changestateif(Coco_Tiger_Mount, CHECKPOINTCOUNT)
        }
        else if (level == LEVEL_TombWader) {
            GLOBAL_3 = 0
        }
        else if (level == LEVEL_MakinWaves || level == LEVEL_TellNoTales || level == LEVEL_SkiCrazed || level == LEVEL_HotCoco) {
            troty = GLOBAL_164 + 180deg
            roty = troty
            if (!RESPAWNCOUNT) {
                spawn(15, 28)
            }
        }
        PrepareLevelArrival(RESPAWNCOUNT)
        exit:
        if (LEVEL == LEVEL_MidnightRun || LEVEL == LEVEL_OrientExpress) {
            changestate(Coco_Init)
        }
        else if (LEVEL == LEVEL_HotCoco || LEVEL == LEVEL_SkiCrazed || LEVEL == LEVEL_TellNoTales || LEVEL == LEVEL_MakinWaves) {
            changestate(Coco_Jetski_Init)
        }
        else if (STATUS_GROUNDLAND) {
            changestate(Willy_Idle)
        }
        else {
            changestate(Willy_Falling_Transition)
        }
    }
    event(e, a) {
        rejevret(e == Event19)
        if (e == Event11) {
            accev()
            var0 = a[0]
            vecx = a[1.0]
            vecy = a[2.0]
            vecz = a[3.0]
            roty = a[4.0]
        }
    }
}

sub CleanupExtraAnims() { // S-6216
    DeloadExtraAnims()
    ResetMovement()
}

sub CheckDanceSkip() { // S-6219
    changestateif(Willy_Idle, buttonpress(PAD_TRIANGLE))
}

sub ResetRespawnFields() { // S-6222
    zindex = 32
    SpinCooldownTime = 0
    AttackCombo = 0
    BoxCount = BOXCOUNT
    statusa &= ~0x2000000
    invincible = 0
    health = 100.0
}

sub WillyRespawnFromOrb(dx, dy, dz) { // S-6232
    if (!RESPAWNCOUNT) {
        save (statusb) {
            statusb &= ~FLAG_HAS_SHADOW
            var0 = 0
            vecx = roty
            vecy = 6m
            vecz = 6.32456m
            do {
                playframe()
            } until (var0 || (DEBUG && buttonpress(PAD_X)))
        }
        if (var0 && (dx != -1 || dy != -1 || dz != -1)) {
            interrupter = var0
            x = interrupter -> x + dx
            y = interrupter -> y + dy
            z = interrupter -> z + dz
        }
    }
    else if (!DEATHCOUNT) {
        ins72(0, 0x8000)
        ins72(0x400, 0x100)
    }
}

sub UpdateWarpFade() __trans { // S-6271
    once {
        vfx = (vfx & 0xFF00FFFF) | 0x20000
        moda = 16.0
        SetColor1(0, 0, 0)
    }
    moda = seek(moda, 0, 3.2)
    if (!moda) {
        vfx &= 0xFF00FFFF
    }
}

sub PrepareLevelArrival(respawns) { // S-6288
    if (LEVEL == LEVEL_HotCoco
        || LEVEL == LEVEL_SkiCrazed
        || LEVEL == LEVEL_TellNoTales 
        || LEVEL == LEVEL_MakinWaves
        || LEVEL == LEVEL_Area51
        || LEVEL == LEVEL_OrangeAsphalt
        || LEVEL == LEVEL_RoadCrash
        || LEVEL == LEVEL_HogRide) {
            WillyRespawnFromOrb(-1, -1, -1)
        }
    else {
        WillyRespawnFromOrb(0, 0, 0)
    }
    ExtraAnimGroup = 0
    if (!DEATHCOUNT) {
        GLOBAL_66 = frametime
    }
    changestateifn(Willy_Level_Arrive, respawns, vecx, vecy, vecz)
}

state Willy_Level_Arrive { // 149
    stateflag 0x2001
    statusc 0x423
    code(yaw, vspd, vy) {
        ResetSpeed()
        statusb &= ~(FLAG_ROT_Y | FLAG_DPAD_CONTROL | FLAG_SOLID_GROUND)
        trotz = 0
        vely = vy
        troty = yaw
        setvel(vspd)
        if (LEVEL == LEVEL_MidnightRun || LEVEL == LEVEL_OrientExpress) {
            settrans(UpdateOrbLaunchSpin)
            playframes(SIS_JUMP, 0.0, 15.0)
            do {
                playframe()
            } until (STATUS_GROUNDLAND)
        }
        else if (LEVEL == LEVEL_HotCoco || LEVEL == LEVEL_SkiCrazed || LEVEL == LEVEL_TellNoTales || LEVEL == LEVEL_MakinWaves) {
            roty = yaw
            statusb &= ~(FLAG_ROT_Y | FLAG_PHYSICS_ENGINE | 0x2000)
            stateflag |= 0x100000
            save (zindex) {
                zindex = 100
                playframes(SIS_JETSKI_MOUNT, 0.0, 33.0)
            }
        }
        else {
            settrans(UpdateOrbLaunchSpin)
            playframes(WILLY_JUMP_HIGH, 0.0, 17.0)
            do {
                setanim(WILLY_JUMP_FLIP)
                playframe(13.0)
            } until (STATUS_GROUNDLAND)
        }
        ResetSpeed()
        onstateexit(ResetMovement)
        statusc &= ~0x1
        GLOBAL_101 = 2
        GLOBAL_100 = 0xFF
        ins72(0, 0x4000)
        if (LEVEL == LEVEL_MidnightRun || LEVEL == LEVEL_OrientExpress) {
            changestate(Coco_Init)
        }
        else if (LEVEL == LEVEL_HotCoco || LEVEL == LEVEL_SkiCrazed || LEVEL == LEVEL_TellNoTales || LEVEL == LEVEL_MakinWaves) {
            changestate(Coco_Jetski_Init)
        }
        else {
            changestate(Willy_Land)
        }
    }
}

sub UpdateOrbLaunchSpin() { // S-6428
    roty = spd(roty, 720deg)
}

