    code() {
        onstateexit(StopAndRestoreControl)
        statusb &= ~FLAG_DPAD_CONTROL
        playframes(WILLY_DINO_MOUNT, 0.0, 15.0)
        changestate(Willy_Dino_Idle)
    }
    trans {
        once {
            if (groundvel < -10m && y > GLOBAL_118 && !(statusa & 0x800000)) {
                spawn(9, 2, 1, -1.0, 5.0, groundvel + 8m)
            }
            if (collider, vely <= 0, statusa & 0x4000, !(statusa & 0x40000)) {
                sendevent(EventJumpedOn, collider, 100)
                changestateif(Coco_Jump, eventaccepted, 12.64912m)
            }
            ResetCombos()
            soundpitch(0x399 + rand(0xCC))
            sounddecay(0x90)
            soundplay([De3cA], 0.5V)
            soundpitch(0x399 + rand(0xCC))
            sounddecay(0x90)
            soundplay(SOUND_LAND_DEFAULT, 0.3V)
            if (GLOBAL_119 & 0x800 && !(statusa & 0x2000000) && statusa & 0x40000) {
                spawn(88, 13, 1, 0.2m, roty, abs(scalex) / 3)
            }
            if (GLOBAL_119 & 0x800 && !(statusa & 0x2000000) && statusa & 0x40000) {
                spawn(88, 13, 1, -0.2m, roty, abs(scalex) / -3)
            }
            GLOBAL_101 = 2
            GLOBAL_100 = 0x7F
        }
        CheckJump(Willy_Dino_Jump, 15.49194m)
        changestateifn(Willy_Dino_Run, dirhold(PAD_NONE))
        if (!STATUS_GROUNDLAND && frametime - groundtime >= 8 && field_63 < y - 1m) {
            groundtime = frametime
            if (vely <= 0) {
                changestate(Willy_Dino_Fall)
            }
            else {
                changestate(Willy_Dino_Rise)
            }
        }
        if (!(statusa & 0x2000000)) {
            ResetSpeed()
        }
    }
}

