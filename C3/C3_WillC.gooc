inline sub ResetCombos() {
    AirSpinCount = 0
    BounceCombo = 0
    AttackCombo = 0
    SpinPulseTime = 0
}

inline sub ResetSpeed() {
    velx = 0
    velz = 0
    speed = 0
}

inline sub CrashDoRespawn() {
    PrepareRespawn()
    loadcheckpoint(misc)
    changestate(Willy_Respawn)
}

inline sub FadeOutAndWait() {
    FadeToBlack()
    WaitFadeFrame()
}

inline sub playanim2(anim, frame, len) {
    setanim(anim)
    playframe(frame, len)
}

inline sub playanim2(anim, frame) {
    setanim(anim)
    playframe(frame)
}

inline sub SoundJumpDefault(r, p, d, vol) {
    soundpitch((r + rand(3.2)) * p >> 8)
    sounddecay(d)
    soundplay([jmp0A], vol)
}

inline sub PlayDeathArg(vol) {
    SoundPitchDefault()
    sounddecay(7.7s)
    soundplay([arg0A], vol)
}

inline sub CrashEventCommon(e, a) {
    if (collider == interrupter && (e == EventHit || e == Event14 || e == Event20 || e == Event35 || e == Event30 || e == Event31 || e == Event63 || e == Event62 || e == Event74)) {
        rejevret(vely < 0 && statusa & 0x4000 && collider -> y < y)
    }
}

inline sub CheckJump(s, v) {
    changestateif(s, buttonbuffer(PAD_X) && (!(statusa & 0x80) || statusa & 0x100000), v)
}

inline sub CheckSlide(s) {
    changestateif(s, buttonhold(PAD_R1 | PAD_CIRCLE) && (buttonbuffer(PAD_R1 | PAD_CIRCLE) || dirhold(PAD_NONE)))
}

inline sub CheckSpin(t, s) {
    if (buttonbuffer(PAD_SQUARE)) {
        if (frametime - SpinCooldownTime >= t) {
            changestate(s)
        }
        else {
            SoundPitchDefault()
            sounddecay(0.5625)
            soundplay([!sp0A], 0.3V)
        }
    }
}

inline sub CheckFall(t) {
    if (!STATUS_GROUNDLAND && frametime - groundtime >= t && field_63 < y - 1m) {
        groundtime = frametime
        if (vely <= 0) {
            changestate(Willy_Falling)
        }
        else {
            changestate(Willy_Rise)
        }
    }
}

inline sub KillBonus() {
    if (BONUSSTATE == BONUS_CURRENT) {
        SetBonusState(BONUS_KILLED)
    }
}

sub SetLevelResult(result) { // S-0
    if (LEVEL != LEVEL_WarpRoom) {
        GLOBAL_184 += frametime - GLOBAL_183
        GLOBAL_183 = 0
    }
    GLOBAL_17 = result
    if (var temp = result; temp == 2.0) {
        LIFECOUNT = 0
        FRUITCOUNT = 0
        HEALTH = 0
        GLOBAL_89 = LEVEL
    }
    else if (temp == 3.0 || temp == 4.0 || temp == 1.0 || temp == 5.0) {
        if ((result == 4.0 || result == 3.0) && (!(SAVEDCRYSTALPOOL1 | (SAVEDCRYSTALPOOL2 | (CRYSTALPOOL1 | CRYSTALPOOL2))) && !(LEVEL == LEVEL_EggipusRex || (LEVEL == LEVEL_Area51 || (LEVEL == LEVEL_HotCoco || (LEVEL == LEVEL_SkiCrazed || LEVEL == LEVEL_RingsOfPower)))))) {
            if (!(PREVBOXCOUNT & 0x2)) {
                if (SFXVOL) {
                    GLOBAL_190 = 2.0
                    GLOBAL_191 = 2
                }
            }
            else if (!(PREVBOXCOUNT & 0x4)) {
                if (SFXVOL) {
                    GLOBAL_190 = 2.0
                    GLOBAL_191 = 2
                }
            }
        }
        GLOBAL_89 = 0x63
        LIFECOUNT = LifeCount
        FRUITCOUNT = FruitCount
        save (var0) {
            sendevent(Event15, creator, 4.0)
            if (GLOBAL_17 != 4.0 || var0 < HEALTH) {
                HEALTH = var0
            }
        }
    }
}

sub DeloadExtraAnims() { // S-102
    BreathMode = 0
    if (var group = ExtraAnimGroup; group == 1.0) {
        DeloadAnim([Ce10V], [Cr10G])
        DeloadAnim([Ce30V], [Cr10G])
    }
    else if (group == 15.0) {
        DeloadAnim([CD10V], [Cr10G])
    }
    else if (group == 16.0) {
        DeloadAnim([CD10V], [Cr10G])
        DeloadAnim([CD20V], [Cr10G])
    }
    else if (group == 17.0) {
        DeloadAnim([CD20V], [Cr10G])
        DeloadAnim([CD30V], [Cr10G])
    }
    else if (group == 18.0) {
        DeloadAnim([CC10V], [Cr10G])
    }
    else if (group == 19.0) {
        DeloadAnim([CC20V], [Cr10G])
    }
    else if (group == 21.0) {
        DeloadAnim([Cr20V], [Cr10G])
    }
    else if (group == 22.0) {
        DeloadAnim([Cy10V], [Cr10G])
        DeloadAnim([Cy00V], [Cy00G])
    }
    else if (group == 20.0) {
        DeloadAnim([Cs6kV], [Cr10G])
    }
    else if (group == 14.0) {
        DeloadAnim([Cs3kV], [Cr10G])
    }
    else if (group == 23.0) {
        DeloadAnim([CE10V], [CE10G])
    }
    else if (group == 24.0) {
        DeloadAnim([WF10V], [WF10G])
    }
    ExtraAnimGroup = 0
}

sub CleanupDeathAnims() { // S-174
    DeloadExtraAnims()
    RestoreAfterHit()
}

sub TryBeginDeath(hit) { // S-177
    onstateexit(RestoreAfterHit)
    if (eventreceived != Event38) {
        sendevent(EventHit, creator, hit)
        changestateif(Willy_Hit, eventaccepted)
    }
    health = 0
    statusb &= ~(FLAG_ROT_Y | FLAG_PHYSICS_TEST | FLAG_GRAVITY | FLAG_PHYSICS_ENGINE | FLAG_DPAD_CONTROL | 0x2000)
    ResetSpeed()
    stateflag |= 0x8000020
    GAMEFLAGS &= ~0x2
}

sub BeginDeath(arg) { // S-195
    onstateexit(RestoreAfterHit)
    health = 0
    statusb &= ~(FLAG_ROT_Y | FLAG_PHYSICS_TEST | FLAG_GRAVITY | FLAG_PHYSICS_ENGINE | FLAG_DPAD_CONTROL)
    ResetSpeed()
    stateflag |= 0x8000020
    GAMEFLAGS &= ~0x2
}

sub PrepareRespawn() { // S-208
    if (LEVEL == LEVEL_WarpRoom) {
        misc = 0
    }
    else if (GLOBAL_119 & 0x2000 && BONUSSTATE != BONUS_COMPLETED) {
        health = 100.0
        misc = 1.0
    }
    else if (GLOBAL_173) {
        health = 100.0
        misc = 0
    }
    else {
        GLOBAL_139 |= 0x4
        if (getfield(self, offsetof(LifeCount))) {
            LifeCount -= 1.0
        }
        else {
            GAMEFLAGS = 0x20
            SetLevelResult(2.0)
        }
        misc = 0
    }
    if (DEBUG && buttonhold(PAD_R1)) {
        health = 100.0
        FADECONTROL = 0
        changestate(Willy_Hit)
    }
}

state Willy_Init { // 0
    stateflag 0x2001
    statusc 0x2402
    code() {
        GLOBAL_183 = frametime
        SpinDuration = 10
        ExtraAnimGroup = 0
        BONUSSTATE = BONUS_UNVISITED
        FruitCount = FRUITCOUNT
        health = 100.0
        LifeCount = LIFECOUNT
        CrystalCount = 0
        CollectedReward = 0
        CollectedLevelGem = 0
        CollectedSpecialGem = 0
        AttackCombo = 0
        SpinCooldownTime = 0
        mem3 = 0x4B
        mem13 = 0
        ActionVoice = 0
        GLOBAL_148 = fieldval(ENTITY_FIELD_BOXCOUNT)
        GLOBAL_188 = fieldval(ENTITY_FIELD_BONUS_BOXCOUNT)
        mem32 = fieldval(0x29800)
        ResetCombos()
        if (LEVEL == LEVEL_HotCoco || LEVEL == LEVEL_BossCortex2 || LEVEL == LEVEL_BossNGin2 || LEVEL == LEVEL_RingsOfPower || LEVEL == LEVEL_MadBombers || LEVEL == LEVEL_ByeByeBlimps) {
            HEALTH = 0
        }
        ResetMovement()
        spawn2(5, 0, 1, HEALTH) // DoctC-0
        if (LEVEL == LEVEL_TombWader || LEVEL == LEVEL_DinoMight || LEVEL == LEVEL_BoneYard || LEVEL == LEVEL_DoubleHeader || LEVEL == LEVEL_GeeWiz || LEVEL == LEVEL_ToadVillage) {
            spawn(9, 7, 1, 0x1E000) // PartC-7
        }
        if (LEVEL == LEVEL_DinoMight || LEVEL == LEVEL_BoneYard || LEVEL == LEVEL_DoubleHeader || LEVEL == LEVEL_GeeWiz || LEVEL == LEVEL_ToadVillage) {
            vfx = (vfx & 0xFFFF00FF) | 0xE00
        }
        if (LEVEL == LEVEL_GoneTomorrow || LEVEL == LEVEL_FutureFrenzy) {
            spawn(77, 11) // FutOC-11
        }
        if (LEVEL != LEVEL_WarpRoom) {
            GLOBAL_184 = 0
        }
        if (LEVEL == LEVEL_DoubleHeader) {
            spawn(11, 9, 1, 0, 20) // MeoOC-9 (Weather)
        }
        statusc &= ~0x2000
        if (var level = LEVEL; level == LEVEL_WarpRoom) {
            spawn(26, 1) // WObOC-1
        }
        else if (level == LEVEL_HangEmHigh || level == LEVEL_HighTime || level == LEVEL_FlamingPassion) {
            spawn(54, 1) // AraOC-1
        }
        else if (level == LEVEL_GoneTomorrow) {
            spawn(77, 25) // FutOC-25
        }
        else if (level == LEVEL_MakinWaves || level == LEVEL_TellNoTales || level == LEVEL_SkiCrazed || level == LEVEL_HotCoco) {
            mem21 = &mem41
            roty = 133deg
            troty = roty
            spawn(15, 3) // OcoOC-3
            spawn(15, 4) // OcoOC-4
            spawn(15, 8) // OcoOC-8
        }
        else if (level == LEVEL_BossTiny) {
            spawn(52, 5) // TigOC-5
        }
        else if (level == LEVEL_HogRide || level == LEVEL_RoadCrash || level == LEVEL_OrangeAsphalt || level == LEVEL_Area51) {
            movetolist(1.0, self)
            spawn(43, 0) // BikOC-0
            spawn(43, 5) // BikOC-5
            if (LEVEL == LEVEL_Area51) {
                spawn(43, 17) // BikOC-17
            }
            GLOBAL_11 = 0
        }
        else if (level == LEVEL_ByeByeBlimps || level == LEVEL_MadBombers || level == LEVEL_RingsOfPower) {
            if (LEVEL == LEVEL_ByeByeBlimps) {
                mem50 = 1.0
            }
            else {
                mem50 = 0
            }
            movetolist(0, self)
            roty = 0deg
            troty = roty
            spawn(32, 0) // BarOC-0
            spawn(32, 1) // BarOC-1
            spawn(32, 8) // BarOC-8
            if (LEVEL != LEVEL_RingsOfPower) {
                spawn(32, 9) // BarOC-9
            }
        }
        else if (level == LEVEL_BossNGin2) {
            movetolist(0, self)
            roty = 0deg
            troty = roty
            spawn(24, 0) // NgiOC-0
            spawn(24, 3) // NgiOC-1
            spawn(32, 9) // NgiOC-8
        }
        else if (level == LEVEL_OrientExpress || level == LEVEL_MidnightRun) {
            GLOBAL_3 = 0
            mem45 = 2
            mem44 = 11.0
        }
        else if (level == LEVEL_TombTime || level == LEVEL_Sphynxinator || level == LEVEL_TombWader || level == LEVEL_BugLite) {
            GLOBAL_3 = 0
            GLOBAL_11 = frametime
            GLOBAL_60 = 0
            mem50 = 0
        }
        else if (level == LEVEL_UnderPressure || level == LEVEL_DeepTrouble) {
            soundpitch(4.0)
            soundcount(0xFFFF)
            sounddecay(0xFF)
            soundplay([CS6eA], 0.5V)
            spawn(ShadC, ShadC_S_SHADOW_ZONE)
        }
        else if (level == LEVEL_BossCortex2) {
            spawn(94, 1) // NCorC-1
        }
        else if (level == LEVEL_BossDingodile) {
            BreathMode = 0
            spawn(88, 14, 1, 1.0) // DingC-14
        }
        else if (level == LEVEL_GameEnd2) {
            statusb = 0
            sleepnull()
        }
        if (LEVEL == LEVEL_BugLite) {
            GLOBAL_55 = 0
            GLOBAL_54 = 0
            GLOBAL_120 = 0
        }
        unless (LEVEL == LEVEL_Area51 || LEVEL == LEVEL_OrangeAsphalt || LEVEL == LEVEL_RoadCrash || LEVEL == LEVEL_HogRide || LEVEL == LEVEL_BossNGin2 || LEVEL == LEVEL_RingsOfPower || LEVEL == LEVEL_MadBombers || LEVEL == LEVEL_ByeByeBlimps) {
            entity = 0
            pathlen = 1.0
        }
        unless (LEVEL == LEVEL_Area51 || LEVEL == LEVEL_BossNGin2 || LEVEL == LEVEL_RingsOfPower || LEVEL == LEVEL_MadBombers || LEVEL == LEVEL_ByeByeBlimps || LEVEL == LEVEL_HotCoco || LEVEL == LEVEL_SkiCrazed || LEVEL == LEVEL_TellNoTales || LEVEL == LEVEL_MakinWaves || LEVEL == LEVEL_DeepTrouble || LEVEL == LEVEL_UnderPressure) {
            spawn(ShadC, ShadC_S_WILLY_VIDO, 1, 0, 2.2S, 0)
        }
        changestate(Willy_Respawn)
    }
}

sub ResetMovement() { // S-556
    GAMEFLAGS = 0xC01FFFF
    statusb = (FLAG_ROT_Y | FLAG_PHYSICS_TEST | FLAG_GRAVITY | FLAG_PHYSICS_ENGINE | FLAG_DPAD_CONTROL | FLAG_NO_CAMERA_CLIP | FLAG_HAS_SHADOW | FLAG_STALL | 0x2000)
    GLOBAL_75 = 0
    GLOBAL_101 = 0
    collider = 0
    moda = 0
    if (!(statusa & 0x2000000)) {
        SetVel(0m)
    }
    rotx = 0
    trotz = 0
    rotz = 0
    troty = roty
    trotx = 720deg
    yzapproach = 75deg
    field_60 = 0x400
    if (invincible == 6) {
        invincible = 0
        invincibletime = frametime
    }
    BreathMode = 0
}

sub RestoreAfterHit() { // S-580
    ResetMovement()
    BounceCombo = 0
    if (!invincible) {
        invincible = 4
        invincibletime = frametime
    }
}

sub CleanupSpin() { // S-586
    save (troty, vely) {
        ResetMovement()
    }
    roty = troty
    SpinCooldownTime = frametime
    if (scalex < 0S) {
        scalex = -1S
    }
    else {
        scalex = 1S
    }
    scaley = 1S
    scalez = 1S
    voice = ActionVoice
    soundsetup(2, voice, 6)
    soundsetup(0, voice, 3, 0)
}

sub StopAndRestoreControl() { // S-603
    if (!(statusa & 0x2000000)) {
        speed = 0
    }
    RestoreControl()
}

sub RestoreControl() { // S-608
    statusb |= FLAG_DPAD_CONTROL
    trotx = 720deg
    ResetStance()
}

sub ResetStance() { // S-613
    scalex = abs(scalex)
    field_60 = 0x400
}

sub SUB_617() {} // S-617

state Willy_Idle { // 1
    stateflag 0x5
    statusc 0x0
    trans => sub UpdateIdle
    code() {
        ResetCombos()
        if (animseq == getanim(WILLY_WADE_2)) {
            playframesback(WILLY_WADE_4, 2.0, 0.0)
        }
        else if (animseq == getanim(WILLY_WALK)) {
            if (animframe >= 1.0 && animframe <= 3.0) {
                setanim(WILLY_WALK_STOP_1)
                playframe(0.0)
                setanim(WILLY_WALK_STOP_1)
                playframe(1.0)
                setanim(WILLY_WALK_STOP_1)
                playframe(2.0)
            }
            else if (animframe >= 11.0 && animframe <= 13.0) {
                scalex = -scalex
                setanim(WILLY_WALK_STOP_1)
                playframe(0.0)
                setanim(WILLY_WALK_STOP_1)
                playframe(1.0)
                setanim(WILLY_WALK_STOP_1)
                playframe(2.0)
                scalex = -scalex
            }
            else if (animframe >= 6.0 && animframe <= 7.0) {
                setanim(WILLY_WALK_STOP_2)
                playframe(0.0)
                setanim(WILLY_WALK_STOP_2)
                playframe(1.0)
                setanim(WILLY_WALK_STOP_2)
                playframe(2.0)
            }
            else if (animframe >= 16.0 && animframe <= 17.0) {
                scalex = -scalex
                setanim(WILLY_WALK_STOP_2)
                playframe(0.0)
                setanim(WILLY_WALK_STOP_2)
                playframe(1.0)
                setanim(WILLY_WALK_STOP_2)
                playframe(2.0)
                scalex = -scalex
            }
        }
        if (LEVEL != LEVEL_WarpRoom) {
            if (getpayload(&[Ce10V], &[Cr10G], &[Ce30V], &[Cr10G]) + 2 <= getfreepages()) {
                onstateexit(DeloadExtraAnims)
                ExtraAnimGroup = 1.0
                loadfile([Ce10V])
                loadfile([Cr10G])
                loadfile([Ce30V])
                loadfile([Cr10G])
            }
        }
        if (!hpc) {
            onstateexit(SUB_1219)
        }
        statetime = frametime
        mem47 = 0
        if (ExtraAnimGroup == 1.0) {
            DeloadExtraAnims()
        }
        do {
            setanim(WILLY_STAND_1)
            do (var i = 0) {
                playframes(0.0, 1.0)
                BreathMode = 2
                playframes(2.0, 4.0)
                BreathMode = 0
                playframes(5.0, 19.0)
            } while ({ i += 1.0 }; i < 4.0)
            playframes(0.0, 1.0)
            BreathMode = 2
            playframes(2.0, 4.0)
            BreathMode = 0
            playframes(5.0, 10.0)
            if (!ExtraAnimGroup && frametime - statetime >= 5s && GLOBAL_74 && !invincible && statusa & 0x40000) {
                if (!mem47) {
                    if (getpayload(&[Cr20V], &[Cr10G]) + 2 <= getfreepages()) {
                        onstateexit(DeloadExtraAnims)
                        LoadAnim([Cr20V], [Cr10G])
                        ExtraAnimGroup = 21.0
                        mem47 = 1.0
                    }
                }
                else if (!rand(2) && LEVEL == LEVEL_WarpRoom) {
                    if (getpayload(&[CD20V], &[Cr10G], &[CD10V], &[Cr10G]) <= getfreepages()) {
                        onstateexit(DeloadExtraAnims)
                        LoadAnim([CD10V], [Cr10G])
                        ExtraAnimGroup = 15.0
                    }
                }
                else if (!!rand(3)) {
                    if (getpayload(&[Cy10V], &[Cr10G], &[Cy00V], &[Cy00G]) <= getfreepages()) {
                        onstateexit(DeloadExtraAnims)
                        LoadAnim([Cy00V], [Cy00G])
                        LoadAnim([Cy10V], [Cr10G])
                        ExtraAnimGroup = 22.0
                    }
                }
                else if ((LEVEL == LEVEL_BossDingodile || LEVEL == LEVEL_DoubleHeader) || GLOBAL_119 & 0x10) {
                    if (getpayload(&[CC10V], &[Cr10G]) + 2 <= getfreepages()) {
                        onstateexit(DeloadExtraAnims)
                        LoadAnim([CC10V], [Cr10G])
                        ExtraAnimGroup = 18.0
                    }
                }
                else {
                    if (getpayload(&[CC20V], &[Cr10G]) + 2 <= getfreepages()) {
                        onstateexit(DeloadExtraAnims)
                        LoadAnim([CC20V], [Cr10G])
                        ExtraAnimGroup = 19.0
                    }
                }
            }
            if (ExtraAnimGroup == 15.0, isloaded([CD10V]) && isloaded([Cr10G])) {
                stateflag = (stateflag & 0xFFFFFFF) | 0x10000000
                WillyPlayDance()
                stateflag &= 0xFFFFFFF
                statetime = frametime
            }
            else if (ExtraAnimGroup == 22.0, isloaded([Cy00V]) && isloaded([Cy00G]) && isloaded([Cy10V]) && isloaded([Cr10G])) {
                WillyPlayYoyo()
                statetime = frametime
            }
            else if (ExtraAnimGroup == 18.0, isloaded([CC10V]) && isloaded([Cr10G])) {
                playframes(WILLY_COLD, 0.0, 7.0)
                do {
                    var0 = 50 + rand(100)
                    do (var start = frametime) {
                        setanim(WILLY_COLD)
                        playframe(8.0)
                        setanim(WILLY_COLD)
                        playframe(9.0)
                        setanim(WILLY_COLD)
                        playframe(10.0)
                        setanim(WILLY_COLD)
                        playframe(9.0)
                    } while (frametime - start < var0)
                    playframes(8.0, 17.0)
                    var0 = 4.0 + rand(6.0)
                    do (var shivers = 0) {
                        BreathMode = 2
                        playframes(18.0, 26.0)
                        BreathMode = 0
                        playframesback(25.0, 19.0)
                    } while ({ shivers += 1.0 }; shivers < var0)
                    BreathMode = 2
                    playframes(18.0, 26.0)
                    BreathMode = 0
                    playframes(27.0, 33.0)
                } while (1)
            }
            else if (ExtraAnimGroup == 19.0, isloaded([CC20V]) && isloaded([Cr10G])) {
                playframes(WILLY_CONFUSED, 0.0, 10.0)
                var0 = (3 + rand(5) << 8)
                do (var i = 0) {
                    playframes(11.0, 17.0)
                    playframesback(16.0, 10.0)
                } while ({ i += 1.0 }; i < var0)
                playframesback(9.0, 0.0)
                DeloadExtraAnims()
                statetime = frametime
            }
            else if (ExtraAnimGroup == 21.0, isloaded([Cr20V]) && isloaded([Cr10G])) {
                playframes(WILLY_STAND_2, 0.0, 17.0)
                playframes(18.0, 27.0)
                BreathMode = 2
                playframes(28.0, 49.0)
                playframe(animframe, 7)
                BreathMode = 0
                playframes(50.0, 54.0)
                playframes(55.0, 69.0)
                DeloadExtraAnims()
                statetime = frametime
            }
            playframes(WILLY_STAND_1, 11.0, 19.0)
        } while (1)
    }
    event(e, a) {
        CrashEventCommon(e, a)
        accevcstate(Willy_Wade_Enter, e == Event18)
        if (LEVEL != LEVEL_WarpRoom) {
            if (e == Event64 && ExtraAnimGroup == 1.0 && isloaded([Ce30V]) && isloaded([Cr10G]) && isloaded([Ce10V]) && isloaded([Cr10G])) {
                onstateexit(CleanupEdge)
                accevcstate(Willy_Edge)
            }
        }
    }
}

sub GroundEvent(e, a) { // S-1107
    CrashEventCommon(e, a)
    accevcstate(Willy_Wade_Enter, e == Event18)
}

sub UpdateIdle() __trans { // S-1136
    once {
        DoubleJumpUsed = 0
    }
    if (!!GLOBAL_17) {
        if (!dirhold(PAD_NONE)) {
            stateflag &= 0xFFFFFFF
        }
        changestateif(Willy_Bazooka, GLOBAL_160 & 0x8 && buttonhold(PAD_L2) && !buttonhold(PAD_R2) && LEVEL > LEVEL_BossCortex2 && !invincible)
        CheckJump(Willy_Jump_Start, 10.469m)
        CheckSpin(7, Willy_Spin_Start)
        CheckSlide(Willy_Slide)
        changestateif(Willy_Move, abs(speed) & ~0x3)
    }
    changestateif(Willy_Ice_Idle, statusa & 0x2000000)
    CheckFall(0.2s)
    if (DEBUG) {
        if (buttonhold(PAD_L1) && buttonpress(PAD_SELECT)) {
            invincible = 2
            invincibletime = frametime
        }
        sendeventif(Event6, creator, buttonpress(PAD_L1) && dirpress(PAD_N), self, -2)
    }
}

sub SUB_1219() { // S-1219
    BreathMode = 0
}

sub CleanupEdge() { // S-1221
    BreathMode = 0
    onstateexit(DeloadExtraAnims)
}

sub CleanupYoyo() { // S-1224
    sendevent(Event14, child, 0)
    DeloadExtraAnims()
}

sub WillyPlayYoyo() { // S-1228
    save (hpc) {
        spawn2(9, 62, 1, 0, 1.0, 3.0)
        onstateexit(CleanupYoyo)
        playframes(WILLY_YOYO, 0.0, 13.0)
        var0 = rand(5) << 8
        do {
            playframes(14.0, 17.0)
            if (!var0) {
                goto exit
            }
            setanim(WILLY_YOYO)
            playframe(16.0)
            setanim(WILLY_YOYO)
            playframe(15.0)
            var0 -= 1.0
        } while (1)
        exit :
        playframes(18.0, 30.0)
        do (var start = frametime) {
            var0 = 3.0 + (rand(10) << 8)
            do (var i = 0) {
                playframes(31.0, 47.0)
                misc = rand(3)
                if (!misc && i >= 3.0) {
                    playframes(148.0, 174.0)
                    if (!rand(3)) {
                        playframes(176.0, 179.0)
                        sendevent(EventTriggered, child)
                        playframes(180.0, 186.0)
                        do (var j = 0) {
                            playframes(188.0, 196.0)
                            playframesback(195.0, 189.0)
                        } while ({ j += 1.0 }; j < 15.0)
                        changestate(Willy_Spin_Start)
                    }
                }
                else {
                    goto skip
                    if (misc == 1) {
                        playframe(animframe, 7)
                    }
                    skip :
                    playframes(48.0, 62.0)
                }
            } while ({ i += 1.0 }; i < var0)
            playframes(64.0, 70.0)
            var0 = 4.0 + (rand(11) << 8)
            do (var i = 0) {
                if (!rand(2) && i >= 3.0) {
                    playframes(100.0, 146.0)
                }
                else {
                    playframes(71.0, 98.0)
                }
            } while ({ i += 1.0 }; i < var0)
            playframesback(71.0, 64.0)
        } while (frametime - start < 0x1F4)
        playframesback(31.0, 0.0)
    }
    sendevent(Event14, child, 0)
    DeloadExtraAnims()
}

sub WillyPlayDance() { // S-1392
    LoadAnim([CD20V], [Cr10G])
    ExtraAnimGroup = 16.0
    setanim(WILLY_DANCE_1, -1.0)
    do {
        animframe += 1.0
        if (animframe == 11.0 || animframe == 29.0) {
            soundpitch(3.12)
            sounddecay(3.2s)
            soundplay(SOUND_FOOTSTEP_DEFAULT, 0.3V)
        }
        if (animframe == 43.0 || animframe == 59.0) {
            soundpitch(0x272)
            sounddecay(3.2s)
            soundplay([DSw0A], 0.4V)
            sounddelay(3)
            soundpitch(3.263)
            sounddecay(3.2s)
            soundplay(SOUND_FOOTSTEP_DEFAULT, 0.6V)
        }
        if (animframe == 81.0) {
            soundpitch(0x372)
            sounddecay(3.2s)
            soundplay(SOUND_FOOTSTEP_DEFAULT, 0x999)
            soundpitch(3.263)
            sounddecay(3.2s)
            soundplay([DSw0A], 0.6V)
            soundpitch(3.263)
            sounddelay(5)
            sounddecay(3.2s)
            soundplay([DSw0A], 0.6V)
        }
        playframe()
    } while (animframe + 1.0 <= 86.0)
    DeloadAnim([CD10V], [Cr10G])
    LoadAnim([CD30V], [Cr10G])
    ExtraAnimGroup = 17.0
    setanim(WILLY_DANCE_2, -1.0)
    do {
        animframe += 1.0
        if (animframe == 13.0) {
            soundpitch(3.263)
            sounddecay(3.2s)
            soundplay(SOUND_FOOTSTEP_DEFAULT, 0x999)
        }
        if (animframe == 4.0 || animframe == 15.0 || animframe == 20.0 || animframe == 25.0) {
            soundpitch(3.263)
            sounddecay(3.2s)
            soundplay([DSw0A], 0.6V)
        }
        if (animframe == 35.0 || animframe == 48.0 || animframe == 56.0 || animframe == 64.0 || animframe == 73.0) {
            soundpitch(3.263)
            sounddecay(3.2s)
            soundplay(SOUND_FOOTSTEP_DEFAULT, 0.6V)
        }
        if (animframe == 84.0) {
            sounddelay(3)
            soundpitch(0x272)
            sounddecay(3.2s)
            soundplay([DSw0A], 0.6V)
        }
        playframe()
    } while (animframe + 1.0 <= 86.0)
    setanim(WILLY_DANCE_3)
    playframe(0.0)
    setanim(WILLY_DANCE_3)
    playframe(1.0, 14)
    playframes(WILLY_DANCE_3, 0.0, 8.0)
    roty += 180deg
    troty = roty
    DeloadExtraAnims()
}

state Willy_Edge { // 2
    stateflag 0x100005
    statusc 0x100000
    event => sub GroundEvent
    trans => sub UpdateIdle
    code() {
        ResetCombos()
        if (animseq == getanim(WILLY_DUCK_START)) {
            setanim(WILLY_EDGE_2)
            playframe(0.0)
            setanim(WILLY_EDGE_2)
            playframe(1.0)
        }
        else if (animseq == getanim(WILLY_STAND_1)) {
            playframesback(WILLY_EDGE_3, 5.0, 0.0)
            playframes(WILLY_EDGE_1, 23.0, 39.0)
        }
        sleepframes(WILLY_EDGE_1, 0.0, 37.0)
    }
}

sub PlayMoveFrame() { // S-1535
    if (dirhold(PAD_NONE) && ((animseq == getanim(WILLY_RUN) && (animframe == 6.0 || animframe == 14.0)) || animseq != getanim(WILLY_RUN))) {
        speed = 0
        if (animseq != getanim(WILLY_STAND_1)) {
            setanim(WILLY_STAND_1, -1.0)
        }
        playframe((animframe + 1.0) % 20.0)
    }
    else {
        if (animseq != getanim(WILLY_RUN)) { 
            setanim(WILLY_RUN, -1.0)
        }
        playframe((animframe + 1.0) % 17.0)
    }
}

sub SUB_1567(obj) { // S-1567
    interrupter = obj
    misc = 0xB2 - (abs(z - interrupter -> z) / 0xFA0)
    if (misc <= 0) {
        GLOBAL_101 = 0
    }
    else {
        GLOBAL_101 = 25
        GLOBAL_100 = 0x4C + misc
    }
}

sub WillyPlayMovement(f) { // S-1581
    ResetCombos()
    unless (animseq == getanim(WILLY_RUN) || animseq == getanim(WILLY_WALK) || animseq == getanim(WILLY_SPRINT)) {
        if ((stateflag & -0x10000000) == 0x30000000) {
            setanim(WILLY_SPRINT)
            playframe(1.0)
        }
        else if (ANALOGAMT < 0xCC) {
            setanim(WILLY_WALK)
            playframe(3.0)
        }
        else {
            setanim(WILLY_RUN)
            playframe(0.0)
        }
    }
    do {
        if (animseq == getanim(WILLY_WALK)) {
            playframe((animframe + f) % 20.0)
            if (animframe == 9.0) {
                if (statusa & 0x800000) {
                    soundpitch((0xDC2 + rand(3.2)) * 58 >> 8)
                    sounddecay(3.2s)
                    soundplay(SOUND_FOOTSTEP_ALTERNATE, 0.2V)
                }
                else {
                    soundpitch((0xDC2 + rand(3.2)) * 58 >> 8)
                    sounddecay(3.2s)
                    soundplay(SOUND_FOOTSTEP_DEFAULT, 0.2V)
                }
                if (ANALOGAMT > 0xF3) {
                    setanim(WILLY_RUN)
                    playframe(15.0)
                }
            }
            else if (animframe == 0) {
                if (statusa & 0x800000) {
                    SoundPitchDefault(0.23)
                    sounddecay(3.2s)
                    soundplay(SOUND_FOOTSTEP_ALTERNATE, 0.2V)
                }
                else {
                    SoundPitchDefault(0.23)
                    sounddecay(3.2s)
                    soundplay(SOUND_FOOTSTEP_DEFAULT, 0.2V)
                }
                if (ANALOGAMT > 0xF3) {
                    setanim(WILLY_RUN)
                    playframe(7.0)
                }
            }
            else if (animframe == 3.0) {
                if (GLOBAL_119 & 0x800 && !(statusa & 0x2000000) && statusa & 0x40000) {
                    spawn(88, 13, 1, 0.2m, roty, abs(scalex) / 3)
                }
            }
            else if (animframe == 13.0) {
                if (GLOBAL_119 & 0x800 && !(statusa & 0x2000000) && statusa & 0x40000) {
                    spawn(88, 13, 1, -0.2m, roty, abs(scalex) / -3)
                }
            }
        }
        else if ((stateflag & -0x10000000) == 0x30000000) {
            setanim(WILLY_SPRINT)
            playframe((animframe + f) % 11.0)
            if (animframe == 0 || animframe == 6.0) {
                if (FRAMETIME < 36) {
                    spawn(9, 21, 1, 0, randi(-2m, 2m), 1m, randi(-2m, 2m), 2S, 0, 32 - (sin(4.0 - abs(degdist(CAMROTY, roty))) >> 8), 3)
                }
                if (statusa & 0x800000) {
                    soundpitch((0xDC2 + rand(3.2)) * 58 >> 8)
                    sounddecay(3.2s)
                    soundplay(SOUND_FOOTSTEP_ALTERNATE, 0.3V)
                }
                else {
                    soundpitch((0xDC2 + rand(3.2)) * 58 >> 8)
                    sounddecay(3.2s)
                    soundplay(SOUND_FOOTSTEP_DEFAULT, 0.3V)
                }
            }
        }
        else {
            setanim(WILLY_RUN)
            playframe((animframe + f) % 17.0)
            if (animframe == 8.0) {
                if (statusa & 0x800000) {
                    soundpitch((0xDC2 + rand(3.2)) * 58 >> 8)
                    sounddecay(3.2s)
                    soundplay(SOUND_FOOTSTEP_ALTERNATE, 0.3V)
                }
                else {
                    soundpitch((0xDC2 + rand(3.2)) * 58 >> 8)
                    sounddecay(3.2s)
                    soundplay(SOUND_FOOTSTEP_DEFAULT, 0.3V)
                }
                if (ANALOGAMT < 0xC0 && ANALOGAMT > 51) {
                    setanim(WILLY_WALK)
                    playframe(10.0)
                }
            }
            else if (animframe == 16.0) {
                if (statusa & 0x800000) {
                    SoundPitchDefault(0.23)
                    sounddecay(3.2s)
                    soundplay(SOUND_FOOTSTEP_ALTERNATE, 0.2V)
                }
                else {
                    SoundPitchDefault(0.23)
                    sounddecay(3.2s)
                    soundplay(SOUND_FOOTSTEP_DEFAULT, 0.2V)
                }
                if (ANALOGAMT < 0xC0 && ANALOGAMT > 51) {
                    setanim(WILLY_WALK)
                    playframe(1.0)
                }
            }
            else if (animframe == 1.0) {
                if (GLOBAL_119 & 0x800 && !(statusa & 0x2000000) && statusa & 0x40000) {
                    spawn(88, 13, 1, -0.2m, roty, abs(scalex) / -3)
                }
            }
            else if (animframe == 9.0) {
                if (GLOBAL_119 & 0x800 && !(statusa & 0x2000000) && statusa & 0x40000) {
                    spawn(88, 13, 1, 0.2m, roty, abs(scalex) / 3)
                }
            }
            else if (LEVEL == 0x3D00 && GLOBAL_126 && !(ZONEFLAGS & 0x800)) {
                SUB_1567(GLOBAL_126) {
                    if (!rand(3)) {
                        interrupter = GLOBAL_126
                        if (animframe == 3.0) {
                            playframes(WILLY_0x31B00, 0.0, 57.0)
                            setanim(WILLY_RUN, 10.0)
                        }
                        else if (animframe == 11.0) {
                            scalex = -scalex
                            playframes(WILLY_0x31B00, 0.0, 57.0)
                            scalex = -scalex
                            setanim(WILLY_RUN, 2.0)
                        }
                    }
                }
            }
        }
    } while (1)
}

state Willy_Move { // 3
    stateflag 0x5
    statusc 0x0
    trans => sub WillyUpdateMovement
    code() {
        onstateexit(ResetStance)
        WillyPlayMovement(1.0)
    }
    event(e, a) {
        CrashEventCommon(e, a)
    }
}

sub MovementEvent(e, a) { // S-1904
    CrashEventCommon(e, a)
}

sub WillyUpdateMovement() __trans { // S-1931
    once {
        mem47 = 1.0
        mem48 = mem12
        DoubleJumpUsed = 0
    }
    if (statusa & 0x2000000) {
        changestateif(Willy_Ice_Move, (animseq == getanim(WILLY_RUN) && (animframe == 4.0 || animframe == 13.0))
            || (animseq == getanim(WILLY_WALK) && (animframe == 3.0 || animframe == 13.0))
            || !(animseq == getanim(WILLY_RUN) || animseq == getanim(WILLY_WALK)))
    }
    CheckJump(Willy_Jump_Run, 10.469m)
    CheckSpin(7, Willy_Spin_Start)
    changestateif(Willy_Slide, buttonbuffer(PAD_CIRCLE | PAD_R1))
    if (GLOBAL_160 & 0x10 && buttonhold(PAD_R2)) {
        stateflag = (stateflag & 0xFFFFFFF) | 0x30000000
    }
    else {
        stateflag &= 0xFFFFFFF
    }
    if (dirhold(PAD_NONE) || (GLOBAL_160 & 0x8 && buttonhold(PAD_L2) && !buttonhold(PAD_R2) && LEVEL > LEVEL_BossCortex2 && !invincible)) { 
        if (((animseq == getanim(WILLY_RUN) || animseq == getanim(WILLY_SPRINT)) && (animframe == 6.0 || animframe == 14.0))
            || animseq == getanim(WILLY_0x31B00) || (animseq == getanim(WILLY_WALK)) && (animframe == 3.0 || animframe == 13.0)) {
                speed = 0
                changestate(Willy_Idle)
            }
    }
    CheckFall(0.2s)
    if (abs(speed) > 6m && y > GLOBAL_118 && STATUS_GROUNDLAND && !STATUS_FIRSTFRAME && !(statusa & 0x800000)) {
        if (mem47) {
            mem47 = 0
            spawn(9, 1, 6, 0) // PartC-1
        }
        else {
            if (abs(degdist(mem48, mem12)) >= 60deg) {
                spawn(9, 1, 8, 0) // PartC-1
            }
        }
        mem48 = mem12
    }
}

sub RecordEventTime() { // S-2072
    mem13 = frametime
}

#module [WiliC] // 2010I
#purge iouA
state Willy_Ice_Move { // 4
    stateflag 0x5
    statusc 0x0
    code() {
        ResetCombos()
        if (animseq == getanim(WILLY_RUN)) {
            if (animframe == 13.0) {
                scalex = -scalex
            }
            playanim2(WILLY_ICE_6, 0.0)
            playanim2(WILLY_ICE_6, 1.0)
            playframes(WILLY_ICE_4, 6.0, 9.0)
            scalex = -scalex
        }
        else if (animseq == getanim(WILLY_ICE_2)) {
            playanim2(WILLY_ICE_7, 0.0)
            playanim2(WILLY_ICE_7, 1.0)
            playanim2(WILLY_ICE_7, 2.0)
            playanim2(WILLY_ICE_7, 3.0)
            playanim2(WILLY_ICE_7, 3.0)
            playanim2(WILLY_ICE_7, 4.0)
            playframes(WILLY_ICE_4, 3.0, 9.0)
            scalex = -scalex
        }
        else if (animseq == getanim(WILLY_ICE_1)) {
            playanim2(WILLY_ICE_9, 0.0)
            playanim2(WILLY_ICE_9, 1.0)
            playanim2(WILLY_ICE_9, 2.0)
            playanim2(WILLY_ICE_9, 3.0)
            playanim2(WILLY_ICE_9, 3.0)
            playanim2(WILLY_ICE_9, 4.0)
            playframes(WILLY_ICE_4, 5.0, 9.0)
            scalex = -scalex
        }
        do {
            playanim2(WILLY_ICE_4, 1.0)
            if (statusa & 0x2000000) {
                if (scalex < 0S) {
                    soundpitch((0xC00 + rand(0xCC)) * 0.25 >> 8)
                    sounddecay(0xB4)
                    soundplay([Sk1GA], 0.3V + rand(0.05V))
                }
                else {
                    soundpitch((0xA66 + rand(0xCC)) * 0.25 >> 8)
                    sounddecay(0xB4)
                    soundplay([Sk1GA], 0.3V + rand(0.05V))
                }
                if (abs(degdist(troty, atan(velx, velz))) > 90deg) {
                    if (!ActionVoice) {
                        soundpitch((0xB33 + rand(3.2)) * 0x6E >> 8)
                        sounddecay(0xFA)
                        soundplay([SSlGA], (0x320 + (abs(speed) >> 9)) + (rand((abs(speed) >> 10) + 1)))
                        ActionVoice = voice
                        onstateexit(StopIceSlideSound)
                    }
                    voice = ActionVoice
                    soundfadet(0.1s, voice)
                    soundfadev((0x320 + (abs(speed) >> 9)) + (rand((abs(speed) >> 10) + 1)), voice, 2)
                    soundpitch(0x4CC + rand(0x147), voice, 2)
                }
                else {
                    StopIceSlideSound()
                    hpc = 0
                }
            }
            playframes(WILLY_ICE_4, 1.0, 9.0)
            scalex = -scalex
        } while (1)
    }
    trans {
        once {
            onstateexit(StopIceSlideSound)
            DoubleJumpUsed = 0
        }
        if (statusa & 0x2000000) {
            statetime = frametime
        }
        else {
            changestateif(Willy_Move, frametime - statetime >= 2)
        }
        CheckJump(Willy_Jump_Run, 10.469m)
        CheckSpin(7, Willy_Spin_Start)
        changestateif(Willy_Slide, buttonbuffer(PAD_R1 | PAD_CIRCLE))
        if (dirhold(PAD_NONE) && ((animseq == getanim(WILLY_ICE_4) && animframe == 7.0) || animseq != getanim(WILLY_ICE_4))) {
            scalex = -scalex
            hpc = 0
            changestate(Willy_Ice_Idle)
        }
        CheckFall(0.2s)
    }
}
    
state Willy_Ice_Idle { // 5
    stateflag 0x5
    statusc 0x0
    code() {
        ResetCombos()
        if (animseq == getanim(WILLY_ICE_4)) {
            if (!ActionVoice) {
                soundpitch((0xB33 + rand(3.2)) * 0x6E >> 8)
                sounddecay(40)
                soundplay([SSlGA], (0x320 + (abs(speed) >> 9)) + (rand((abs(speed) >> 10) + 1)))
                ActionVoice = voice
            }
            playanim2(WILLY_ICE_8, 0.0)
            playanim2(WILLY_ICE_8, 1.0)
            playanim2(WILLY_ICE_8, 2.0)
            playanim2(WILLY_ICE_8, 3.0)
            playanim2(WILLY_ICE_8, 3.0)
            playanim2(WILLY_ICE_8, 4.0)
            playanim2(WILLY_ICE_1, 6.0)
        }
        else if ((animseq == getanim(WILLY_ICE_5) || animseq == getanim(WILLY_DUCK_START)) && (abs(speed) & ~0xFF)) {
            playframesback(WILLY_ICE_3, 3.0, 0.0)
        }
        while (abs(speed) & ~0xFF && statusa & 0x2000000) {
            if (!ActionVoice) {
                soundpitch((0xB33 + rand(3.2)) * 0x6E >> 8)
                sounddecay(40)
                soundplay([SSlGA], (0x320 + (abs(speed) >> 9)) + (rand((abs(speed) >> 10) + 1)))
                ActionVoice = voice
            }
            if (animseq != getanim(WILLY_ICE_1)) {
                setanim(WILLY_ICE_1, -1.0)
            }
            playframe((animframe + 1.0) % 13.0)
            voice = ActionVoice
            soundfadet(0.1s, voice)
            soundfadev((0x320 + (abs(speed) >> 9)) + (rand((abs(speed) >> 10) + 1)), voice, 2)
            soundpitch(0x4CC + rand(0x147), voice, 2)
        }
        StopIceSlideSound()
        hpc = 0
        if (animseq == getanim(WILLY_ICE_1)) {
            playanim2(WILLY_ICE_3, 0.0)
            playanim2(WILLY_ICE_3, 1.0)
            playanim2(WILLY_ICE_3, 2.0)
            playanim2(WILLY_ICE_3, 2.0)
        } 
        do {
            if (!rand(60)) {
                playanim2(WILLY_ICE_2, 1.0)
            }
            else {
                playanim2(WILLY_ICE_2, 0.0)
            }
        } while (1)
    }
    trans {
        once {
            onstateexit(StopIceSlideSound)
            mem47 = 0
            DoubleJumpUsed = 0
        }
        if (!!GLOBAL_17) {
            CheckJump(Willy_Jump_Start, 10.469m)
            CheckSpin(7, Willy_Spin_Start)
            CheckSlide(Willy_Slide)
            if (!dirhold(PAD_NONE)) {
                hpc = 0
                changestate(Willy_Ice_Move)
            }
            if (statusa & 0x2000000) {
                statetime = frametime
            }
            else {
                changestateif(Willy_Idle, frametime - statetime >= 2 && !(abs(speed) & ~0xFF))
            }
        }
        CheckFall(0.2s)
    }
}

sub StopIceSlideSound() { // EIS-406
    if (ActionVoice) {
        voice = ActionVoice
        soundfadet(0.1s, voice)
        soundfadev(0, voice, 3)
        ActionVoice = 0
    }
}
#module default

state Willy_Bazooka { // 6
    stateflag 0x82000005
    statusc 0x0
    code() {
        onstateexit(CleanupBazooka)
        spawn2(FruiC, FruiC_S_WILLY_BAZOOKA)
        mem16 = objectspawned
        vecy = 0
        mem48 = 0
        mem49 = 0
        trotz = 0
        trotx = 720deg
        statusb &= ~0x2000
        if (!(statusa & 0x2000000)) {
            ResetSpeed()
        }
        playframes(WILLY_BAZOOKA_EQUIP, 0.0, 8.0)
        statusb &= ~FLAG_ROT_Y
        setanim(WILLY_BAZOOKA, 0.0)
        playframe()
        while (mem16) {
            var0 = degdist(roty, troty)
            if (var0 < -45deg) {
                scalex = abs(scalex)
                roty = degseek(roty, troty, 180deg)
            }
            else {
                if (var0 > 45deg) {
                    scale = -abs(scalex)
                    roty = degseek(roty, troty, 180deg)
                }
                else {
                    var0 = 0
                }
            }
            animframe += 1.0
            if (animframe > 8.0) {
                animframe = 2.0
            }
            if (var0 == 0 && animframe <= 2.0) {
                animframe = seek(animframe, 0.0, 2.0)
            }
            playframe()
        }
        changestate(Willy_Idle)
    }
    trans {
        once {
            mem16 = 0
            mem15 = 0
        }
        if (mem15) {
            settrans(UpdateBazooka)
        }
    }
}

sub CleanupBazooka() { // S-2146
    save (interrupter) {
        trotz = 0
        rotx = 0
        interrupter = mem15
        sendevent(Event12, interrupter, self)
        interrupter = mem16
        sendevent(Event12, interrupter, self)
        ResetMovement()
    }
}

sub UpdateBazooka() { // S-2158
    unless (GLOBAL_160 & 0x8 && buttonhold(PAD_L2) && !buttonhold(PAD_R2) && LEVEL > LEVEL_BossCortex2 && !invincible) {
        interrupter = mem15
        sendevent(Event12, interrupter, self)
        mem15 = 0
        interrupter = mem16
        sendevent(Event14, interrupter, self)
        settrans(UpdateBazookaExit)
        UpdateBazookaExit()
        return
    }
    if (mem15) {
        interrupter = mem15
        troty = interrupter -> troty
    }
}

sub UpdateBazookaExit() { // S-2185
    CheckJump(Willy_Jump_Start, 10.469m)
    CheckSpin(7, Willy_Spin_Start)
    CheckSlide(Willy_Slide)
    changestateif(Willy_Move, !dirhold(PAD_NONE))
}

#module [WileC] // 2001I
#purge es
state Willy_Scuba_Init { // 7
    stateflag 0x92000001
    statusc 0x0
    code() {
        GAMEFLAGS |= 0x20000000
        zindex = 0
        vfx = (vfx & 0xFFFFFF00) | 0x5
        trotx = 270deg
        yzapproach = 60deg
        trotz = 0
        mem48 = -1.0
        mem43 = z
        mem35 = x
        mem36 = y
        mem37 = z
        mem46 = frametime
        mem39 = 0
        mem42 = 4m
        ResetScubaMovement()
        statusb &= ~FLAG_HAS_SHADOW
        SetScale(0S)
        zindex = 300
        rotx = 0
        rotz = 0
        troty = 90deg
        roty = troty
        setanim(WILLY_SCUBA_IDLE, -1.0)
        do {
            animframe += 1.0
            scalex = seek(scalex, 1S, spd(6S))
            scaley = seek(scaley, 1S, spd(6S))
            scalez = seek(scalez, 1S, spd(6S))
            playframe()
        } while (animframe + 1.0 <= 8.0)
        statusb |= FLAG_HAS_SHADOW
        SetVel(0, 0, 0)
        mem49 = 0
        changestate(Willy_Scuba_Swim)
    }
    event(e, a) {
        if (e == Event34) {
            statusb |= FLAG_HAS_SHADOW
            SetVel(0, 0, 0)
            mem49 = 0
            SetScale(1S)
            accevcstate(Willy_Scuba_Hold)
        }
    }
}

sub ResetScubaMovement() { // EES-70
    mem48 = -1.0
    statusb = (FLAG_PHYSICS_TEST | FLAG_PHYSICS_ENGINE | FLAG_DPAD_CONTROL | FLAG_NO_CAMERA_CLIP | FLAG_ROT_Y2 | FLAG_HAS_SHADOW | FLAG_STALL | 0x2000)
}

sub PlayScubaMovement() { // EES-73
    start:
    if (mem41) {
        playframes(WILLY_SCUBA_TURN, 0.0, 15.0)
        playanim(1, WILLY_SCUBA_IDLE)
        playanim(2, WILLY_SCUBA_IDLE)
    }
    cycle:
    if (animseq == getanim(WILLY_SCUBA_SWIM) || animseq == getanim(WILLY_SCUBA_SWIM_STOP)) {
        unless (animseq == getanim(WILLY_SCUBA_SWIM_STOP)) {
            setanim(WILLY_SCUBA_SWIM_STOP, -1.0)
        }
        do {
            if (mem41) {
                goto start
            }
            playframe(seek(animframe, 23.0))
        } until (animframe >= 23.0 || mem50)
    }
    goto check

    idle:
    if (mem41) {
        goto start
    }
    unless (animseq == getanim(WILLY_SCUBA_IDLE)) {
        setanim(WILLY_SCUBA_IDLE, 0 - mem47)
    }
    playframe((animframe + mem47) % 50.0)
    check:
    unless (mem50) {
        goto idle
    }

    if (animseq == getanim(WILLY_SCUBA_IDLE) || animseq == getanim(WILLY_SCUBA_SWIM_STOP)) {
        unless (animseq == getanim(WILLY_SCUBA_SWIM_STOP)) {
            setanim(WILLY_SCUBA_SWIM_STOP, 26.0)
        }
        do {
            if (mem41) {
                goto start
            }
            playframe(seek(animframe, 0, 3.0))
        } until (animframe <= 0 || !mem50)
    }
    if (mem50) {
        unless (animseq == getanim(WILLY_SCUBA_SWIM)) {
            setanim(WILLY_SCUBA_SWIM, 0)
        }
        while (mem50 || animframe <= 24.0) {
            if (mem41) {
                goto start
            }
            playframe(animframe % 25.0)
            animframe += mem47
        }
    }
    goto cycle
}

state Willy_Scuba_Swim { // 8
    stateflag 0x92000001
    statusc 0x0
    code => sub PlayScubaMovement
    trans => sub UpdateScuba
    event(e, a) {
        if (e == EventHit || e == Event24 || e == Event31 || e == Event12 || e == Event30 || e == Event63 || e == Event14 || e == Event25) {
            sendevent(EventHit, creator, a[0])
            if (eventaccepted) {
                stateflag &= ~0x8000000
                if (!invincible) {
                    invincible = 4
                    invincibletime = frametime
                }
                accevret()
            }
            accevcstate(Willy_Scuba_Death_Explode, e == Event30 || e == Event63)
            accevcstate(Willy_Scuba_Death_Inflate, e == Event14 || e == Event25)
            accevcstate(Willy_Scuba_Death)
        }
        if (e == Event50) {
            accev()
            mem39 = a[1.0]
        }
        accevcstate(Willy_Sub_Mount, e == Event58)
        accevcstate(Willy_Scuba_Hold, e == Event34)
    }
}

sub UpdateScuba() __trans { // EES-198
    once {
        ResetScubaMovement()
        stateflag &= ~0x100
    }
    if (buttonpress(PAD_X)) {
        settrans(UpdateScubaKick)
        UpdateScubaKick()
        return
    }
    if (buttonbuffer(PAD_SQUARE) || buttonbuffer(PAD_R1 | PAD_CIRCLE)) {
        if (frametime - SpinCooldownTime >= 7) {
            changestate(Willy_Scuba_Spin)
        }
        else {
            SoundPitchDefault()
            sounddecay(0x90)
            soundplay([!sp0A], 0.3V)
        }
    }
    if (vely < -1m) {
        sendevent(EventJumpedOn, collider, BounceCombo)
        if (eventaccepted) {
            BounceCombo += 1.0
        }
    }
    MoveScuba()
    ClampScubaVelocity()
    if (DEBUG) {
        if (buttonhold(PAD_L1) && buttonpress(PAD_SELECT)) {
            invincible = 2
            invincibletime = frametime
        }
        sendeventif(Event6, creator, buttonpress(PAD_L1) && dirpress(PAD_N), self, -2)
    }
}

sub ClampScubaVelocity() { // EES-246
    if (velx < -mem42) {
        velx = -mem42
    }
    else if (velx > mem42) {
        velx = mem42
    }
    if (vely < mem39 - mem42) {
        vely = mem39 - mem42
    }
    else if (vely > mem42 + mem39) {
        vely = mem42 + mem39
    }
}

sub UpdateScubaKick() __trans { // EES-267
    once {
        stateflag |= 0x100
        statetime = frametime
        SoundPitchDefault(0.25)
        sounddecay(0xC8)
        soundplay([CS5eA], 0.2V)
    }
    velx = spd(velx, (cos(rotx) * (sin(roty) * 0x4E)) >> 7)
    vely = spd(vely, sin(rotx) * -0x3E8)
    if (frametime - statetime >= 5) {
        settrans(UpdateScuba)
        UpdateScuba()
        return
    }
    if (buttonbuffer(PAD_SQUARE) || buttonbuffer(PAD_R1 | PAD_CIRCLE)) {
        if (frametime - SpinCooldownTime >= 7) {
            changestate(Willy_Scuba_Spin)
        }
        else {
            SoundPitchDefault()
            sounddecay(0x90)
            soundplay([!sp0A], 0.3V)
        }
    }
    MoveScuba()
    mem42 = 6m
    ClampScubaVelocity()
    mem50 = 1.0
}

sub MoveScuba() { // EES-316
    if (!dirhold(PAD_NONE)) {
        velx = spd(velx, (GLOBAL_161 * 10m) >> 8)
        vely = spd(vely, ((GLOBAL_162 * 10m) >> 8) + mem39)
        mem48 = -1.0
    }
    else {
        vely = seek(vely, mem39 - 0.5m, spd(8m))
    }
    mem39 = seek(mem39, 0, spd(8m))
    if (dirhold(PAD_LEFT)) {
        troty = -90deg
        trotx = abs(trotx)
        mem50 = 1.0
    }
    else if (dirhold(PAD_RIGHT)) {
        troty = 90deg
        trotx = abs(trotx)
        mem50 = 1.0
    }
    else if (((dirhold(PAD_DOWN) && GLOBAL_124 > 0x99) || vely > 1m) && !(STATUS_GROUNDLAND)) {
        mem50 = 1.0
    }
    else {
        mem50 = 0
    }
    if (stateflag & 0x100) {
        mem47 = 2.0
    }
    else {
        mem47 = 1.0
    }
    if (!(stateflag & 0x80000)) {
        velx = (velx * 0xF8) >> 8
        vely = (vely * 0xF8) >> 8
    }
    rotz = cos(frametime << 4) >> 4
    if (STATUS_GROUNDLAND) {
        trotz = 0
        rotx = degseek(rotx, trotz, yzapproach)
    }
    else if (dirhold(PAD_NONE)) {
        trotz = degseek(0deg, -((vely * (abs(vely) >> 9)) / 16m) - 15deg, 1125deg)
    }
    else if (ANALOGAMT < 0xB3) {
        trotz = (cos(ANALOGDIR) * (ANALOGAMT * 80deg)) >> 20
    }
    else {
        trotz = (cos(ANALOGDIR) * 80deg) >> 12
    }
    yzapproach = (abs(degdist(rotx, trotz)) * 25) >> 4
    if (yzapproach < 22) {
        yzapproach = 22
    }
    mem41 = abs(degdist(roty, troty)) > 160deg && abs(rotx) < 50deg
    z = mem43
    mem42 = seek(mem42, 4m, spd(8m, 0x10E))
    if (FRAMETIME < 34) {
        if ((animseq == getanim(WILLY_SCUBA_IDLE) && (animframe >= 25.0 && animframe <= 28.0)) || (animseq == getanim(WILLY_SCUBA_SWIM) && (animframe >= 12.0 && animframe <= 17.0))) {
            spawn(9, 8, 1, 0, 0, x + randi(-0.3m, 0.3m), y + 5m, z + randi(-0.3m, 0.3m), 0x199, 3.2, 1m)
        }
        if (animseq == getanim(WILLY_SCUBA_SWIM) && ((animframe >= 0.0 && animframe <= 2.0) || (animframe >= 12.0 && animframe <= 14.0)) || (stateflag & 0x100 && !rand(4))) {
            do (var i = 0) {
                spawn(9, 8, 1, 1.0 + i, 0, x + randi(-0.3m, 0.3m), y + 5m, z + randi(-0.3m, 0.3m), 0x147, 0x1EB, 1m)
            } while ({ i += 1.0 }; i < 2.0)
        }
    }
}

state Willy_Scuba_Spin { // 9
    stateflag 0x92000015
    code() {
        InitSpin()
        soundpitch(0x3A0)
        sounddecay(0xC8)
        soundplay([CS4eA], 1V)
        stateflag |= 0x80000
        if (troty == -90deg) {
            velx = cos(rotx) * -0xC8
        }
        else {
            velx = cos(rotx) * 0xC8
        }
        vely = sin(rotx) * -0xC8
        setanim(WILLY_SCUBA_SPIN, 9.0)
        do {
            playframe((animframe + 1.0) % 10.0)
        } until (frametime - SpinPulseTime >= SpinDuration)
        mem42 = 8m
        SpinCooldownTime = frametime
        changestate(Willy_Scuba_Swim)
    }
    event(e, a) {
        if (e == Event42) {
            rejev()
            sendevent(EventSpinHit, interrupter, 1)
        }
        if (e == Event40) {
            rejev()
            save (interrupter) {
                interrupter = a[0]
                sendevent(EventSpinHit, interrupter, 1)
            }
        }
        rejevret(e == EventHit || e == Event14 || e == Event35 || e == Event58)
        if (e == Event24 || e == Event31 || e == Event12 || e == Event25 || e == Event30 || e == Event63) {
            sendevent(EventHit, creator, a[0])
            if (eventaccepted) {
                stateflag &= ~0x8000000
                if (!invincible) {
                    invincible = 4
                    invincibletime = frametime
                }
                accevret()
            }
            accevcstate(Willy_Scuba_Death_Inflate, e == Event25)
            accevcstate(Willy_Scuba_Death_Explode, e == Event30 || e == Event63)
            accevcstate(Willy_Scuba_Death)
        }
        if (e == Event50) {
            accev()
            mem39 = a[1.0]
        }
        accevcstate(Willy_Scuba_Hold, e == Event34)
    }
    trans {
        once {
            AttackCombo = 0
        }
        sendevent(EventSpinHit, collider, AttackCombo)
        if (eventaccepted) {
            sounddecay(0x90)
            soundpitch((0xE66 + (rand(3.2) + (1.6 * AttackCombo >> 8))) * 0.23 >> 8)
            soundplay([sht0A], 0.4V)
            AttackCombo += 1.0
        }
        MoveScuba()
    }
}

state Willy_Scuba_Hold { // 10
    stateflag 0x90010805
    statusc 0x800
    code => sub PlayScubaMovement
    event(e, a) {
        accevcstate(Willy_Scuba_Swim, e == Event21)
    }
    trans {
        velx = (velx * 0xCC) >> 8
        vely = (vely * 0xCC) >> 8
        velz = (velz * 0xCC) >> 8
        mem50 = 0
    }
}

state Willy_Sub_Mount { // 11
    stateflag 0x92100001
    statusc 0x402
    code() {
        soundpitch(0x6E4)
        sounddecay(0xFD)
        soundcount(0xFFFF)
        soundplay([CS1eA], 0.35V)
        ActionVoice = voice
        trotz = 0
        yzapproach = 60deg
        trotx = 270deg
        mem47 = 1.0
        mem50 = 0
        PlayScubaMovement()
    }
    event(e, a) {
        accevcstate(Willy_Sub_Move, e == Event58)
    }
}

state Willy_Sub_Move { // 12
    stateflag 0x92100001
    statusc 0x0
    code() {
        trotz = 0
        trotx = 270deg
        do {
            if (dirhold(PAD_UP)) {
                if (animseq == getanim(WILLY_SUB_IDLE) && (animframe >= 3.0 && animframe <= 12.0)) {
                    playframes(WILLY_SUB_UP_3, 0.0, 10.0)
                }
                else if (animseq == getanim(WILLY_SUB_IDLE) && (animframe >= 12.0 && animframe <= 21.0)) {
                    setanim(WILLY_SUB_UP_4, 11.0)
                    do {
                        playframe(animframe + -1.0)
                    } while (animframe + -1.0 >= 0)
                }
                else if (animseq == getanim(WILLY_SUB_IDLE) && (animframe >= 21.0 && animframe <= 31.0)) {
                    playframes(WILLY_SUB_UP_5, 0.0, 10.0)
                }
                else {
                    playframesback(WILLY_SUB_UP_1, 10.0, 0.0)
                }
                up:
                while (dirhold(PAD_UP)) {
                    unless (animseq == getanim(WILLY_SUB_UP_2)) {
                        setanim(WILLY_SUB_UP_2, -1.0)
                    }
                    playframe((animframe + 1.0) % 33.0)
                }
                if (dirhold(PAD_DOWN)) {
                    playframesback(WILLY_SUB_DOWN_3, 10.0, 0.0)
                    setanim(WILLY_SUB_DOWN_1)
                    playframe(10.0)
                    goto down
                }
                else {
                    playframes(WILLY_SUB_UP_1, 1.0, 10.0)
                }
            }
            else if (dirhold(PAD_DOWN)) {
                if (animseq == getanim(WILLY_SUB_IDLE) && (animframe >= 3.0 && animframe <= 12.0)) {
                    playframesback(WILLY_SUB_DOWN_4, 10.0, 0.0)
                }
                else if (animseq == getanim(WILLY_SUB_IDLE) && (animframe >= 12.0 && animframe <= 21.0)) {
                    playframes(WILLY_SUB_DOWN_5, 0.0, 10.0)
                }
                else if (animseq == getanim(WILLY_SUB_IDLE) && (animframe >= 21.0 && animframe <= 31.0)) {
                    playframesback(WILLY_SUB_DOWN_6, 10.0, 0.0)
                }
                else {
                    playframes(WILLY_SUB_DOWN_1, 0.0, 10.0)
                }
                down:
                while (dirhold(PAD_DOWN)) {
                    unless (animseq == getanim(WILLY_SUB_DOWN_2)) {
                        setanim(WILLY_SUB_DOWN_2, -1.0)
                    }
                    playframe((animframe + 1.0) % 33.0)
                }
                if (dirhold(PAD_UP)) {
                    playframes(WILLY_SUB_DOWN_3, 0.0, 10.0)
                    playanim(0, WILLY_SUB_UP_1)
                    goto up
                }
                else {
                    playframesback(WILLY_SUB_DOWN_1, 9.0, 0.0)
                }
            }
            else {
                unless (animseq == getanim(WILLY_SUB_IDLE)) {
                    setanim(WILLY_SUB_IDLE, -1.0)
                }
                playframe((animframe + 1.0) % 38.0)
            }
        } while (1)
    }
    event(e, a) {
        if (e == Event19 || e == Event80) {
            StopSubmarineSound()
        }
        accevcstate(Willy_Sub_Hold, e == Event34)
        if (e == EventHit || e == Event24 || e == Event31 || e == Event12 || e == Event30 || e == Event63 || e == Event35 || e == Event44 || e == Event14 || e == Event25) {
            sendevent(EventHitInvincible, interrupter, 100.0)
            invincible = 4
            invincibletime = frametime
            accevcstate(Willy_Sub_Destroyed)
        }
        accevcstate(Willy_Sub_Dismount, e == Event58)
        rejevret(e == Event50)
    }
    trans {
        changestateif(Willy_Sub_Turn, abs(degdist(roty, troty)) > 160deg)
        changestateif(Willy_Sub_Boost, buttonbuffer(PAD_R1 | PAD_CIRCLE) && frametime - statetime >= 5)
        if (FRAMETIME < 34) {
            if ((animseq == getanim(WILLY_SUB_IDLE) && (animframe >= 21.0 && animframe <= 24.0)) || (animseq == getanim(WILLY_SUB_UP_2) && (animframe >= 28.0 && animframe <= 30.0)) || (animseq == getanim(WILLY_SUB_DOWN_2) && (animframe >= 21.0 && animframe <= 22.0))) {
                spawn(9, 8, 1, 0, 0, x + randi(-0.3m, 0.3m), y + 5m, z + randi(-0.3m, 0.3m), 0x199, 3.2, 1m)
            }
            if (!rand(30)) {
                do (var i = 0) {
                    spawn(9, 8, 1, 1.0 + i, 0, x + randi(-0.3m, 0.3m), y + 5m, z + randi(-0.3m, 0.3m), 0x147, 0x1EB, 1m)
                } while ({ i += 1.0 }; i < 2.0)
            }
        }
        mem42 = 6m
        UpdateSubmarine()
    }
}

sub UpdateSubmarine() { // EES-914
    velx = spd(velx, sin(ANALOGDIR) * ANALOGAMT)
    vely = spd(vely, (-cos(ANALOGDIR) * ANALOGAMT >> 1) + mem39)
    mem48 = -1.0
    if (dirhold(PAD_LEFT)) {
        trotx = abs(trotx)
        troty = -90deg
    }
    else if (dirhold(PAD_RIGHT)) {
        trotx = abs(trotx)
        troty = 90deg
    }
    vely = (vely * 0xF8) >> 8
    mem39 = seek(mem39, 0, spd(8m))
    if (troty == -90deg) {
        velx = spd(velx, -2m)
        if (buttonbuffer(PAD_SQUARE) || buttonpress(PAD_X), frametime - mem46 >= 10, abs(degdist(roty, 90deg)) < 60deg || abs(degdist(roty, -90deg)) < 60deg) {
            mem46 = frametime
            GLOBAL_75 = 2
            GLOBAL_65 = -1
            if (abs(degdist(roty, troty)) < 90deg) {
                spawn(20, 0, 1, 2.0, 16m, troty)
            }
            else {
                spawn(20, 0, 1, 2.0, 16m, troty + 180deg)
            }
        }
    }
    else if (troty == 90deg) {
        velx = spd(velx, 2m)
        if (buttonbuffer(PAD_SQUARE) || buttonpress(PAD_X), frametime - mem46 >= 10, abs(degdist(roty, 90deg)) < 60deg || abs(degdist(roty, -90deg)) < 60deg) {
            mem46 = frametime
            GLOBAL_75 = 2
            GLOBAL_65 = -1
            if (abs(degdist(roty, troty)) < 90deg) {
                spawn(20, 0, 1, 2.0, 16m, troty)
            }
            else {
                spawn(20, 0, 1, 2.0, 16m, troty + 180deg)
            }
        }
    }
    if (velx < -mem42) {
        velx = -mem42
    }
    else if (velx > mem42) {
        velx = mem42
    }
    if (vely < mem39 - 4m) {
        vely = mem39 - 4m
    }
    else if (vely > 4m + mem39) {
        vely = 4m + mem39
    }
    rotz = degseek(rotz, 0, 360deg)
    if (SFXVOL) {
        if (ActionVoice > 0) {
            sp = ActionVoice
            soundcheck(sp)
        }
        else {
            misc = -1
        }
        if (misc != -1) {
            voice = ActionVoice
            soundsetup(0.35V, voice, 0, 0)
            soundsetup(25, voice, 6)
            soundpitch(3.0 + ((abs(ANALOGAMT) << 1) + (rand(abs(ANALOGAMT) + 1))), voice, 2)
        }
        else {
            soundpitch(0x6E4)
            sounddecay(0xFA)
            soundcount(0xFFFF)
            soundplay([CS1eA], 0.35V)
            ActionVoice = voice
        }
    }
    else {
        voice = ActionVoice
        soundsetup(0, voice, 15)
    }
    if (!GLOBAL_101) {
        GLOBAL_101 = 3
        GLOBAL_100 = 63 + (ANALOGAMT >> 2)
    }
    z = mem43
}

sub StopSubmarineSound() { // EES-1092
    if (ActionVoice) {
        voice = ActionVoice
        soundsetup(25, voice, 6)
        soundsetup(0, voice, 3, 0)
        ActionVoice = 0
    }
}

state Willy_Sub_Turn { // 13
    stateflag 0x92100001
    statusc 0x0
    event => state Willy_Sub_Move
    code() {
        trotz = 0
        playframes(WILLY_SUB_TURN, 0.0, 15.0)
        playanim(0, WILLY_SUB_IDLE)
        changestate(Willy_Sub_Move)
    }
    trans {
        changestateif(Willy_Sub_Boost, buttonbuffer(PAD_R1 | PAD_CIRCLE) && frametime - statetime >= 5)
        UpdateSubmarine()
    }
}

state Willy_Sub_Boost { // 14
    stateflag 0x92180001
    statusc 0x22
    event => state Willy_Sub_Move
    code() {
        SoundPitchDefault(0x57)
        sounddecay(0xE6)
        soundplay([CS2eA], 1V)
        playframes(WILLY_SUB_BOOST, 0.0, 29.0)
        changestate(Willy_Sub_Move)
    }
    trans {
        once {
            AttackCombo = 0
        }
        misc = collider && (collider -> spawn >> 16) == 34
        sendeventif(EventHitInvincible, collider, misc, 100.0)
        vely = spd(vely, ((-cos(ANALOGDIR) * ANALOGAMT) >> 1) + mem39)
        if (frametime - statetime >= 17) {
            velx = seek(velx, 6m, spd(16m))
        }
        else {
            if (FRAMETIME < 34) {
                spawn(9, 8, 1, 0, 0, x + velx, y + 2m, z + randi(-0.3m, 0.3m), 0x199, 3.2, 1m)
            }
            if (troty == -90deg) {
                velx = -14m
            }
            else if (troty == 90deg) {
                velx = 14m
            }
        }
        vely = (vely * 0xF8) >> 8
        mem39 = seek(mem39, 0, spd(8m))
        rotz = degseek(rotz, 0, 360deg)
        if (!GLOBAL_101) {
            GLOBAL_101 = 3
            GLOBAL_100 = 0xBF
        }
        z = mem43
    }
}

state Willy_Sub_Hold { // 15
    stateflag 0x90010805
    statusc 0x800
    code => state Willy_Sub_Move
    event(e, a) {
        accevcstate(Willy_Sub_Move, e == Event21)
    }
    trans {
        velx = (velx * 0xCC) >> 8
        vely = (vely * 0xCC) >> 8
        velz = (velz * 0xCC) >> 8
        z = mem43
    }
}

state Willy_Sub_Dismount { // 16
    stateflag 0x92000001
    statusc 0x422
    code() {
        StopSubmarineSound()
        playframes(WILLY_SUB_DISMOUNT, 0.0, 35.0)
        spawn(20, 3)
        spawn(9, 10, 1, 2.0, getins(SetSubExplosionColor), 0)
        playframe()
        changestate(Willy_Scuba_Swim)
    }
    trans {
        velx = (velx * 0xE6) >> 8
        vely = (vely * 0xE6) >> 8
        velz = (velz * 0xE6) >> 8
        if (!time(2)) {
            if (animseq == getanim(WILLY_SUB_DISMOUNT) && (animframe >= 11.0 && animframe <= 14.0)) {
                spawn(9, 8, 1, 0, 0, x + velx, y + 2m, z + randi(-0.3m, 0.3m), 0x199, 3.2, 1m)
            }
        }
    }
}

sub SetSubExplosionColor() { // EES-1252
    if (var r = rand(4); r == 0) {
        SetColor1(42, 0x65, 0x62)
    }
    else if (r == 1) {
        SetColor1(57, 0x95, 40)
    }
    else if (r == 2) {
        SetColor1(0x52, 0xA3, 0x67)
    }
    else if (r == 3) {
        SetColor1(0x47, 0x9C, 26)
    }
}

state Willy_Sub_Destroyed { // 17
    stateflag 0x92000001
    statusc 0x422
    code() {
        GLOBAL_75 = 25
        GLOBAL_65 = -1
        SetVel(0, 0, 0)
        StopSubmarineSound()
        spawn(20, 3)
        playframes(WILLY_SCUBA_DISMOUNT, 0.0, 32.0)
        changestate(Willy_Scuba_Swim)
    }
    trans {
        if (!time(2)) {
            spawn(9, 8, 1, 0, 0, x + velx, y + 2m, z + randi(-0.3m, 0.3m), 0x199, 3.2, 1m)
        }
    }
}

state Willy_Scuba_Death { // 18
    stateflag 0x23
    statusc 0xC02
    code(arg) {
        StopSubmarineSound()
        BeginDeath(arg)
        KillBonus()
        statusb &= ~(FLAG_ROT_Y | FLAG_ROT_Y2 | 0x2000)
        if (interrupter) {
            if (interrupter -> spawn == 0x460001) {
                vecx = interrupter -> x
                vecz = interrupter -> z
                settrans(UpdateScubaVortex)
                if (GLOBAL_151 == 5.0) {
                    soundpitch(3.263)
                    sounddecay(0xC8)
                    soundplay([1056I], 1V) // TODO: Find EID, region specific?
                }
                playframes(WILLY_SCUBA_DEATH_VORTEX_1, 0.0, 37.0)
                playframes(WILLY_SCUBA_DEATH_VORTEX_2, 0.0, 16.0)
                FadeToBlack()
                WaitFadeNull()
            }
            else if (interrupter -> spawn == 0x20001) {
                playframe(animframe, 42)
                playframe(animframe, 42)
                playframe(animframe, 25)
            }
            else if (interrupter -> spawn == 0x20002) {
                mem47 = interrupter
                statusb |= (FLAG_ROT_Y | 0x2000)
                trotz = 0
                trotx = 720deg
                yzapproach = 360deg
                settrans(FollowScubaCaptor)
                while (var0) {
                    if (var phase = var0; phase == -1.0) {
                        playanim2(WILLY_DEATH_SCUBA_EXPLODE, 7.0)
                    }
                    else if (phase == 1.0) {
                        playframesback(WILLY_DEATH_SCUBA_EXPLODE, 7.0, 0.0)
                        playframe()
                    }
                    else if (phase == 2.0) {
                        playframesback(WILLY_DEATH_SCUBA_EXPLODE, 7.0, 0.0)
                    }
                    else if (phase == 4.0) {
                        playanim2(ANIM_0x47400, 1.0)
                        playanim2(ANIM_0x47400, 0.0, 4)
                        playframesback(ANIM_0x47900, 4.0, 0.0)
                        playanim2(WILLY_DEATH_SCUBA_EXPLODE, 5.0)
                        playanim2(WILLY_DEATH_SCUBA_EXPLODE, 4.0)
                        playanim2(WILLY_DEATH_SCUBA_EXPLODE, 2.0)
                    }
                    else if (phase == 5.0) {
                        playnull()
                    }
                    else if (phase == 6.0) {
                        scaley = seek(scaley, 0S, spd(16S))
                        scalex = scaley
                        scalez = scaley
                        playframe()
                    }
                }
            }
        }
        CrashDoRespawn()
    }
}

sub FollowScubaCaptor() { // EES-1431
    interrupter = mem47
    getvert(vtrans, interrupter, 0.0)
}

sub UpdateScubaVortex() { // EES-1434
    rotx = degseek(rotx, 0deg, 360deg)
    rotz = degseek(rotz, 0deg, 360deg)
    x = seek(x, vecx, spd(4m))
    z = seek(z, vecz, spd(4m))
}

state Willy_Scuba_Death_Inflate { // 19
    stateflag 0x421
    statusc 0xC02
    code(arg) {
        BeginDeath(arg)
        KillBonus()
        statusb &= ~(FLAG_ROT_Y | FLAG_ROT_Y2 | 0x2000)
        SetRot(0deg)
        groundy = y
        GLOBAL_75 = 50
        GLOBAL_65 = -1
        SoundPitchDefault(0.25)
        sounddecay(7.7s)
        soundplay([CS3eA], 0.5V)
        playframes(WILLY_DEATH_SCUBA_INFLATE, 0.0, 12.0)
        playframe(animframe, 31)
        FadeOutAndWait()
        CrashDoRespawn()
    }
    trans {
        nofirst {
            y = groundy + (cos(frametime << 5) << 2)
            roty = cos(frametime << 5) >> 4
        }
    }
}

state Willy_Scuba_Death_Explode { // 20
    stateflag 0x420
    statusc 0x1C22
    code(arg) {
        BeginDeath(arg)
        KillBonus()
        statusb &= ~(FLAG_ROT_Y | FLAG_ROT_Y2 | 0x2000)
        GLOBAL_75 = 50
        GLOBAL_65 = -1
        PlayDeathArg(0.5V)
        SetRot(0deg)
        spawn(9, 4, 1, getins(SetSubExplosionColor), 0)
        spawn2(20, 4)
        playnull(19)
        FadeToBlack()
        WaitFadeNull()
        CrashDoRespawn()
    }
}
#module default

#module [WilcC] // 2004I
#purge cgC
state Willy_Dino_Mount { // 21
    stateflag 0xB2000005
    statusc 0x0
    code() {
        onstateexit(RestoreControl)
        ins72(0x100, 0x200)
        statusb &= ~FLAG_DPAD_CONTROL
        ResetSpeed()
        soundpitch(3.263)
        soundplay([De3cA], 1V)
        playframes(WILLY_DINO_MOUNT, 0.0, 15.0)
        mem48 = 0
        changestate(Willy_Dino_Idle)
    }
}

sub PlayDinoIdle() { // ECS-19
    ResetCombos()
    if (speed < 3m) {
        nop() // nop in the wild! :o
    }
    else {
        if (animseq == getanim(WILLY_DINO_RUN) && (animframe >= 19.0 && animframe <= 21.0)) {
            scalex = -scalex
            GLOBAL_101 = 10
            GLOBAL_100 = 51
            playframes(WILLY_DINO_RUN_STOP, 0.0, 12.0)
        }
        else if (animseq == getanim(WILLY_DINO_RUN)) {
            GLOBAL_101 = 10
            GLOBAL_100 = 51
            playframes(WILLY_DINO_RUN_STOP, 0.0, 12.0)
        }
    }
    sleepanim(0, WILLY_DINO_STAND)
}

state Willy_Dino_Idle { // 22
    stateflag 0xB2000005
    statusc 0x0
    code => sub PlayDinoIdle
    event(e, a) {
        if (e == Event58) {
            accev()
            mem48 = -1
        }
        misc = e == EventHit || e == Event14 || e == Event20 || e == Event35 || e == Event30 || e == Event31 || e == Event63 || e == Event62 || e == Event74
        if (misc) {
            sendevent(Event15, creator, 4.0)
        }
        if (e == Event6 || (misc && var0 >= 3.0)) {
            soundpitch(3.263)
            soundplay([De8cA], 1V)
            setvel(5m)
            spawn(18, 1, 1, self)
            vely = 15.49194m
            statusa &= ~FLAG_GROUNDLAND
            if (!invincible) {
                invincible = 4
                invincibletime = frametime
            }
            ins72(0x100, 0x100)
            if (e != Event6) {
                rejevcstate(Willy_Jump_Flip)
            }
        }
        if (e == Event22) {
            soundpitch(3.263)
            soundplay([De8cA], 1V)
            spawn(18, 1, 1, self)
            ins72(0x100, 0x100)
        }
        accevcstate(Willy_Dino_Hold, e == Event34)
        accevcstate(Willy_Dino_Jump, e == Event21)
        CrashEventCommon(e, a)
    }
    trans {
        if (!!GLOBAL_17) {
            CheckJump(Willy_Dino_Jump, 15.49194m)
            if ((buttonbuffer(PAD_R1 | PAD_CIRCLE) || mem48) && STATUS_GROUNDLAND) {
                soundpitch(3.263)
                soundplay([De8cA], 1V)
                setvel(5m)
                spawn(18, 1, 1, mem48)
                vely = 15.49194m
                statusa &= ~FLAG_GROUNDLAND
                ins72(0x100, 0x100)
                changestate(Willy_Jump_Flip)
            }
            changestateif(Willy_Dino_Run, !(dirhold(PAD_NONE)))
        }
        if (!STATUS_GROUNDLAND && frametime - groundtime >= 8 && field_63 < y - 1m) {
            groundtime = frametime
            if (vely <= 0) {
                changestate(Willy_Dino_Fall)
            }
            else {
                changestate(Willy_Dino_Rise)
            }
        }
        if (DEBUG) {
            if (buttonhold(PAD_L1) && buttonpress(PAD_SELECT)) {
                invincible = 2
                invincibletime = frametime
            }
            sendeventif(Event6, creator, buttonpress(PAD_L1) && dirpress(PAD_N), self, -2)
        }
    }
}

state Willy_Dino_Run { // 23
    stateflag 0xB2000005
    statusc 0x0
    event => state Willy_Dino_Idle
    code() {
        ResetCombos()
        if (animseq == getanim(WILLY_DINO_STAND)) {
            playanim(0, WILLY_DINO_RUN_START)
            playanim(1, WILLY_DINO_RUN_START)
            playanim(2, WILLY_DINO_RUN)
        }
        do {
            if (animseq != getanim(WILLY_DINO_RUN)) {
                setanim(WILLY_DINO_RUN, -1.0)
            }
            playframe((animframe + 1.0) % 23.0)
        } while (1)
    }
    trans {
        CheckJump(Willy_Dino_Jump, 15.49194m)
        if ((buttonbuffer(PAD_R1 | PAD_CIRCLE) || mem48) && STATUS_GROUNDLAND) {
            soundpitch(3.263)
            soundplay([De8cA], 1V)
            setvel(5m)
            spawn(18, 1, 1, mem48)
            vely = 15.49194m
            statusa &= ~FLAG_GROUNDLAND
            ins72(0x100, 0x100)
            changestate(Willy_Jump_Flip)
        }
        if (dirhold(PAD_NONE)) {
            changestateif(Willy_Dino_Idle, animseq == getanim(WILLY_DINO_RUN) && ((animframe >= 7.0 && animframe <= 10.0) || (animframe >= 19.0 && animframe <= 21.0)))
        }
        if (animseq == getanim(WILLY_DINO_RUN) && (animframe >= 7.0 && animframe <= 10.0)) {
            GLOBAL_101 = 2
            GLOBAL_100 = 0x66
            if (statusa & 0x800000) {
                soundpitch((0xDC2 + rand(3.2)) * 0.25 >> 8)
                sounddecay(3.2s)
                soundplay([Cd2cA], 0.2V)
            }
            else {
                soundpitch((0xDC2 + rand(3.2)) * 0.205 >> 8)
                sounddecay(3.2s)
                soundplay([Cd1cA], 0.2V)
            }
        }
        if (animseq == getanim(WILLY_DINO_RUN) && (animframe >= 19.0 && animframe <= 21.0)) {
            GLOBAL_101 = 2
            GLOBAL_100 = 0x66
            if (statusa & 0x800000) {
                soundpitch((0x999 + rand(3.2)) * 0.25 >> 8)
                sounddecay(3.2s)
                soundplay([Cd2cA], 0.2V)
            }
            else {
                soundpitch((0x999 + rand(3.2)) * 0.205 >> 8)
                sounddecay(3.2s)
                soundplay([Cd1cA], 0.2V)
            }
        }
        if (!STATUS_GROUNDLAND && frametime - groundtime >= 8 && field_63 < y - 1m) {
            groundtime = frametime
            if (vely <= 0) {
                changestate(Willy_Dino_Fall)
            }
            else {
                changestate(Willy_Dino_Rise)
            }
        }
        if (collider) {
            sendeventif(EventHitInvincible, collider, (collider -> spawn >> 16) == 34, 100.0)
        }
    }
}

state Willy_Dino_Jump { // 24
    stateflag 0xB200000D
    statusc 0x100001
    code(vy) {
        SoundJumpDefault(14.4, 0.205, 0x40, 0x666)
        if (LEVEL == LEVEL_EggipusRex) {
            vy = (vy * 0x114) >> 8
        }
        vely = vy
        onstateexit(ResetStance)
        statusc &= ~0x3
        playframes(WILLY_DINO_JUMP, 0.0, 28.0)
        statusc &= ~0x100000
        sleepframe(29.0)
    }
    event(e, a) {
        if (interrupter) {
            rejevret(vely < 0 && (e == EventHit || e == Event14 || e == Event20 || e == Event35 || e == Event30 || e == Event31 || e == Event63 || e == Event62 || e == Event74) && !(interrupter -> statusc & 0x2))
        }
        rejevret(e == Event47)
        if (e == Event58) {
            accev()
            mem48 = interrupter
        }
        if (e == EventHit || e == Event14 || e == Event20 || e == Event35 || e == Event30 || e == Event31 || e == Event63 || e == Event62 || e == Event74) {
            if (!invincible) {
                invincible = 4
                invincibletime = frametime
            }
            ins72(0x100, 0x100)
            rejevcstate(Willy_Hit)
        }
        if (e == Event21) {
            rejevret(vely > 0)
            accevcstate(Willy_Dino_Jump)
        }
        accevcstate(Willy_Dino_Hold, e == Event34)
    }
    trans {
        if (frametime - statetime >= 2) {
            if (collider, vely <= 0) {
                sendevent(EventJumpedOn, collider, BounceCombo)
                if (eventaccepted) {
                    BounceCombo += 1.0
                    changestate(Willy_Dino_Jump, 12.64912m)
                }
            }
        }
        changestateif(Willy_Dino_Land, STATUS_GROUNDLAND)
        if (buttonbuffer(PAD_X) && (!(statusa & 0x80) || statusa & 0x100000)) {
            if (vely > 0) {
                vely = spd(vely, 14m)
            }
            else {
                vely = spd(vely, 7m)
            }
        }
    }
}

state Willy_Dino_Land { // 25
    stateflag 0xB2000005
    statusc 0x0
