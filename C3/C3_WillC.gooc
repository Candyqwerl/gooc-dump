#module [WileC] // 2001I
state Willy_Scuba_Shock { // 120
    stateflag 0x420
    statusc 0x0
    code(arg) {
        changestate(Willy_Scuba_Shocked, arg)
    }
}

state Willy_Scuba_Shocked { // 121
    stateflag 0x22
    statusc 0xC22
    code(hit) {
        BeginDeath(hit)
        var0 = 0
        sendevent(EventHit, creator, hit)
        if (eventaccepted) {
            stateflag &= ~0x8000000
            var0 = 1.0
        }
        if (!var0) {
            stateflag |= 0x8000020
        }
        SetRot(0deg)
        statusb &= ~(FLAG_ROT_Y | FLAG_PHYSICS_TEST | FLAG_GRAVITY | FLAG_PHYSICS_ENGINE | FLAG_DPAD_CONTROL | FLAG_ROT_Y2 | FLAG_HAS_SHADOW | 0x2000)
        spawn(9, 25, 1, 0.0, 1.0)
        spawn(9, 25, 1, 2.0, 3.0)
        spawn(9, 25, 1, 4.0, 5.0)
        spawn(9, 25, 1, 6.0, 8.0)
        spawn(9, 25, 1, 8.0, 9.0)
        GLOBAL_75 = 0x64
        GLOBAL_65 = 0x33333333
        do (var start = frametime) {
            PlayScubaShock()
        } while (frametime - start < 17)
        if (var0) {
            tpc = 0
            unless (LEVEL == LEVEL_DeepTrouble || LEVEL == LEVEL_UnderPressure) {
                statusb |= (FLAG_PHYSICS_TEST | FLAG_GRAVITY | FLAG_PHYSICS_ENGINE | FLAG_HAS_SHADOW)
            }
            do (var start = frametime) {
                PlayScubaShock()
            } while (frametime - start < 32)
            if (!invincible) {
                invincible = 4
                invincibletime = frametime
            }
            if (LEVEL == LEVEL_DeepTrouble || LEVEL == LEVEL_UnderPressure) {
                changestate(Willy_Scuba_Swim)
            }
            else {
                changestate(Willy_Hit)
            }
        }
        KillBonus()
        do (var start = frametime) {
            PlayScubaShock()
        } while (frametime - start < 25)
        FadeToBlack()
        do {
            PlayScubaShock()
        } until (FADECONTROL == -1)
        CrashDoRespawn()
    }
}

sub UpdateShockFlash() { // EES-1624
    if (var r = rand(3); r == 0) {
        moda = 0
    }
    else if (r == 1) {
        moda = 16.0
        SetColor1(0, 0, 0)
    }
    else if (r == 2) {
        moda = 8.0
        SetColor1(0x80, 0x80, 0x80)
    }
}

sub PlayScubaShock() { // EES-1644
    playanim2(WILLY_SCUBA_DEATH_SHOCK_2, 0.0)
    playanim2(WILLY_SCUBA_DEATH_SHOCK_1, 0.0, 2)
    if (!rand(2)) {
        playanim2(WILLY_SCUBA_DEATH_SHOCK_1, 0.0)
        if (!rand(2)) {
            playanim2(WILLY_SCUBA_DEATH_SHOCK_1, 0.0)
        }
    }
}
#module default

state Willy_Death_Fire { // 122
    stateflag 0x420
    statusc 0xC22
    code(hit) {
        TryBeginDeath(hit)
        KillBonus()
        if (LEVEL == LEVEL_DinoMight || LEVEL == LEVEL_BoneYard || (interrupter && (interrupter -> spawn == 0x530000 || interrupter -> spawn == 0x4F0000 || interrupter -> spawn == 0x520000))) {
            if (LEVEL == LEVEL_DinoMight || LEVEL == LEVEL_BoneYard) {
                mem47 = 0x75
            }
            else {
                mem47 = 0
                moda = 0
            }
            statusb = (FLAG_ROT_Y | FLAG_PHYSICS_TEST | FLAG_GRAVITY | FLAG_PHYSICS_ENGINE | FLAG_NO_CAMERA_CLIP | FLAG_HAS_SHADOW | FLAG_STALL)
            GAMEFLAGS |= 0x2
            rotx = 0
            setevent(BurningEvent)
            do {
                PlayDeathArg(0.5V)
                stateflag &= ~0x100000
                field_61 = 0
                statetime = frametime
                vecx = CAMTRANSX
                vecy = CAMTRANSY
                vecz = CAMTRANSZ
                troty = atan2(self, vecx)
                setvel(5.5m)
                PlayKnockback(15.49194m, 1, getins(SpawnBurnParticle))
                var0 += 1.0
            } until (!field_61 || var0 > 4.0)
            playframe(animframe, 4)
            FadeOutAndWait()
        }
        else {
            statusb &= ~(FLAG_ROT_Y | FLAG_HAS_SHADOW)
            GAMEFLAGS &= ~0x2
            statusb |= (FLAG_PHYSICS_TEST | FLAG_GRAVITY | FLAG_PHYSICS_ENGINE)
            if (getpayload(&[WF10G], &[WF10V]) <= getfreepages()) {
                field_61 = 1.0
                LoadAnim([WF10V], [WF10G])
                ExtraAnimGroup = 24.0
                onstateexit(CleanupDeathAnims)
            }
            else {
                field_61 = 0
            }
            GLOBAL_75 = 50
            GLOBAL_65 = -1
            PlayDeathArg(0.5V)

            sounddecay(0.75)
            soundpitch((17.92 + rand(3.2)) * 0.23 >> 8)
            soundfadet(1.5s)
            soundfadev(0, 0, 2)
            soundplay([BDC0A], 0.75V)
            setanim(WILLY_STAND_1)
            playframe(2.0, 15)
            do {
                setanim(WILLY_STAND_1)
                playframe(2.0)
                if (!field_61) {
                    break
                }
            } until (isloaded([WF10G]) && isloaded([WF10V]))
            if (field_61) {
                v0 = 1.0
                soundfadet(0.1334s, voice)
                soundfadev(0, voice, 2)
                sounddecay(0.75)
                soundpitch((14.4 + rand(3.2)) * 0.23 >> 8)
                soundplay([BDA0A], 0.5V)
                playframes(WILLY_DEATH_FIRE, 0.0, 39.0)
                playframe(animframe, 33)
                while ((GLOBAL_119 & 0x2000 && BONUSSTATE != BONUS_COMPLETED) && (BONUSSTATE == BONUS_KILLED && !(frametime - BONUSDEATHTIME >= 1.2s))) {
                    playframe()
                }
                FadeOutAndWait()
                DeloadExtraAnims()
            }
        }
        CrashDoRespawn()
    }
    trans {
        once {
            trotx = 720deg
            SetColor1(0, 0, 0)
            moda = 0
            mem47 = 0x222
            v0 = 0
        }
        unless (frametime - statetime >= 10 || !mem47) {
            spawn(9, 21, 1, -1.0, randi(-4m, 4m), 8m, randi(-4m, 4m), 2S, 0.8, 24, 1) // PartC-21
        }
        moda = seek(moda, 16.0, mem47)
        if (v0 && !rand(4)) {
            spawn(9, 0, 1, 0, 0xF5, 0) // PartC-0
        }
    }
}

sub BurningEvent(e, a) { // S-5301
    if (e == Event31 && frametime - statetime >= 7) {
        accev()
        field_61 = 1.0
        stateflag |= 0x100000
    }
}

sub SpawnBurnParticle() { // S-5310
    spawn(9, 2, 1, -1.0, 7.0, 8m)
    tpc = 0
}

state Willy_Death_Explode { // 123
    stateflag 0x420
    statusc 0x1C22
    code(hit) {
        unless (getpayload(&[CE10V], &[CE10G]) <= getfreepages()) {
            statusc = 0
            changestate(Willy_Death, hit)
        }
        TryBeginDeath(hit)
        KillBonus()
        field_61 = 0
        statusb |= FLAG_INVISIBLE | FLAG_GRAVITY | FLAG_PHYSICS_ENGINE | FLAG_PHYSICS_TEST
        statusb &= ~(FLAG_HAS_SHADOW | FLAG_ROT_Y | 0x2000)
        GLOBAL_75 = 50
        GLOBAL_65 = -1
        PlayDeathArg(0.5V)
        loadfile([CE10V])
        loadfile([CE10G])
        ExtraAnimGroup = 0x1700
        onstateexit(CleanupDeathAnims)
        rotx = 0
        rotz = 0
        playnull(15)
        do { playnull() } until (isloaded([CE10V]) && isloaded([CE10G]))
        statusb &= ~(FLAG_INVISIBLE | FLAG_GRAVITY | FLAG_PHYSICS_TEST)
        statusb |= FLAG_PHYSICS_ENGINE | FLAG_SOLID_GROUND
        velx = 0
        vely = -8.399995m
        velz = 0
        v0 = 1.0
        groundy = y
        y += 10m
        do {
            setanim(WILLY_DEATH_EXPLODE)
            playframe(0.0)
        } until (STATUS_GROUNDLAND || y <= groundy)
        playframes(WILLY_DEATH_EXPLODE, 1.0, 44.0)
        playframe(animframe, 21)
        while ((GLOBAL_119 & 0x2000 && BONUSSTATE != BONUS_COMPLETED) && (BONUSSTATE == BONUS_KILLED && !(frametime - BONUSDEATHTIME >= 1.2s))) {
            playframe()
        }
        FadeToBlack()
        v0 = 0
        WaitFadeFrame()
        DeloadExtraAnims()
        CrashDoRespawn()
    }
    trans {
        once {
            v0 = 0
        }
        roty = GAMEDIR
        if (v0) {
            if (!rand(8)) {
                spawn(9, 21, 1, 0, -rand(0.4m), 0.4m + rand(0.4m), randi(-0.2m, 0.2m), 16.0, 0.8, 24, 32) // PartC-21
            }
            if (!rand(8)) {
                spawn(9, 21, 1, 1.0, -rand(0.4m), 0.4m + rand(0.4m), randi(-0.2m, 0.2m), 16.0, 0.8, 24, 32) // PartC-21
            }
        }
    }
}

state Willy_Death_Hide { // 124
