state Willy_Bike_Boost { // 53
    stateflag 0xE2080005
    statusc 0x0
    event => state Willy_Bike_Ride
    code(yaw) {
        soundpitch(4.0)
        sounddecay(0xF9)
        soundsetup(6, self, 8)
        soundplay([CM5kA], 1V)
        soundpitch(0x4B7)
        sounddecay(0xFA)
        soundsetup(6, self, 8)
        soundplay([CM6kA], 1V)
        roty = yaw
        if (animseq != getanim(WILLY_BIKE_9)) {
            playframes(WILLY_BIKE_1, 0.0, 13.0)
        }
        mem48 = 0
        setanim(WILLY_BIKE_9)
        while ((buttonhold(PAD_X) || !(frametime - statetime >= 2)) && speed > 28m) {
            animframe = 10.0 + ((mem48 * -0xA80) / 10deg)
            if (animframe < 0) {
                animframe = 0
            }
            else if (animframe > 20.0) {
                animframe = 20.0
            }
            playframe()
        }
        playframes(WILLY_BIKE_8, 0.0, 7.0)
        settrans(UpdateBikeSteering)
        hpc = 0
        playframes(8.0, 19.0)
        soundpitch(0x399 + rand(0xCC))
        sounddecay(0x90)
        soundplay(SOUND_LAND_DEFAULT, 0.3V)
        mem48 = 0
        if (speed) {
            changestate(Willy_Bike_Ride)
        }
        else {
            changestate(Willy_Bike_Idle)
        }
    }
    trans {
        once {
            speed = 40m
            mem48 = 0
        }
        var turn = (GLOBAL_161 * -20deg) >> 7
        if (abs(GLOBAL_161) < 32 || !(frametime - statetime >= 2)) {
            turn = 0
        }
        mem48 = seek(mem48, turn, spd(40deg))
        roty = spd(roty, mem48)
        roty = degseek(GAMEDIR + 180deg, roty, 2500deg)
        UpdateBikeSpeed()
        rotz = degseek(rotz, 0deg, 40deg)
        troty = roty
        setvel(speed)
    }
}

state Willy_Bike_Fall { // 54
    stateflag 0xE2000022
    statusc 0x1402
    event => state Willy_Bike_Reset
    code() {
        voice = ActionVoice
        soundsetup(12, voice, 6)
        soundpitch(3.2, voice, 2)
        voice = mem51
        soundsetup(0, voice, 0, 15)
        sounddecay(7.7s)
        SoundPitchDefault(46)
        soundplay([fal0A], 0.4V)
        save (zindex, statusb) {
            statusb &= ~(FLAG_PHYSICS_TEST | FLAG_GRAVITY | FLAG_PHYSICS_ENGINE | FLAG_HAS_SHADOW)
            zindex = -0x190
            playframes(WILLY_BIKE_FALL, 0.0, 14.0)
            soundpitch(0x4B7)
            soundplay([CM3kA], 1V)
            playnull(6)
        }
        ResetBikeToRoad()
    }
    trans {
        rotx = degseek(rotx, 0, 720deg)
        rotz = degseek(rotz, 0, 720deg)
    }
}

state Willy_Bike_Reset { // 55
    stateflag 0xE2000022
    statusc 0x1402
    code() {
        voice = ActionVoice
        soundsetup(12, voice, 6)
        soundpitch(3.2, voice, 2)
        if (mem51) {
            voice = mem51
            soundsetup(0, voice, 0, 15)
        }
        groundy = y
        statusb |= FLAG_SOLID_GROUND
        playanim(0, WILLY_BIKE_7)
        playanim(1, WILLY_BIKE_7)
        playanim(2, WILLY_BIKE_7)
        playanim(2, WILLY_BIKE_7)
        playanim(3, WILLY_BIKE_7)
        playanim(4, WILLY_BIKE_7)
        playanim(5, WILLY_BIKE_7)
        playanim(6, WILLY_BIKE_7)
        playframesback(WILLY_BIKE_7, 6.0, 0.0)
        ResetBikeToRoad()
    }
    event(e, a) {
        if (e == Event19 || e == Event80) {
            voice = ActionVoice
            soundsetup(0, voice, 0, 15)
            if (mem51) {
                voice = mem51
                soundsetup(0, voice, 0, 15)
            }
        }
        if (e == Event50) {
            troty = GAMEDIR
            save (statusa, statusb) {
                statusb = (FLAG_TRACK_PATH_SIGN | FLAG_PATH_CALCS)
                field_61 = 20m
                calcpath(0, vvec)
                roty = troty
            }
            vecx = a[0]
            vecy = a[1.0]
            vecz = a[2.0]
            accevret()
        }
        rejevret(e == Event76 || e == Event27 || e == Event21 || e == Event34) 
        if (e == Event14) {
            statusc = 0
            accevcstate(Willy_Bike_Fail)
        }
        if (e == Event22) {
            statusc = 0
            accevcstate(Willy_Bike_Win)
        }
    }
    trans {
        once {
            var0 = speed / 12
        }
        speed = seek(speed, 0, var0)
        setvel(speed)
        rotx = degseek(rotx, 0, 180deg)
        rotz = degseek(rotz, 0, 180deg)
    }
}

sub ResetBikeToRoad() { // EKS-1359
    if (!invincible) {
        invincible = 4
        invincibletime = frametime
    }
    ResetSpeed()
    vely = 0
    statusb |= FLAG_SOLID_GROUND
    statusb &= ~FLAG_HAS_SHADOW
    groundy = 0
    y = groundy
    rotx = 0
    roty = GAMEDIR
    rotz = 0
    troty = roty
    save (statusa, statusb) {
        var px = x
        var py = y
        var pz = z + 100m
        var best = 100m
        var dist = 0
        var yaw = 0
        save (scalex, scaley, scalez) {
            statusb = FLAG_TRACK_PATH_SIGN
            do (var pos = 0) {
                calcpath(pos, vscale)
                dist = distance(scalex, self, DIST_NO_Y)
                if (dist < best) {
                    px = scalex
                    py = scaley
                    pz = scalez
                    best = dist
                    yaw = troty
                }
            } while ({ pos += 1.0 }; pos < pathlen)
        }
        statusb = (FLAG_TRACK_PATH_SIGN | FLAG_PATH_CALCS)
        field_61 = 20m
        calcpath(0, vvec)
        roty = troty
        if (best + 10m < distance(vecx, self, DIST_NO_Y)) {
            vecx = px
            vecy = py
            vecz = pz
            troty = yaw
            roty = troty
        }
        vecy = 0
    }
    broadcastevent(Event76, 0, 0)
    do {
        x = seek(x, vecx, spd(10m))
        z = seek(z, vecz, spd(10m))
        playnull()
    } until (vecx == x && vecz == z)
    statusb &= ~FLAG_SOLID_GROUND
    statusb |= FLAG_HAS_SHADOW
    changestate(Willy_Bike_Idle)
}

state Willy_Bike_Fail { // 56
    stateflag 0xE2000020
    statusc 0x1402
    trans => state Willy_Bike_Reset
    code() {
        voice = ActionVoice
        soundsetup(12, voice, 6)
        soundpitch(3.2, voice, 2)
        if (mem51) {
            voice = mem51
            soundsetup(0, voice, 0, 15)
        }
        statusb &= ~(FLAG_ROT_Y | 0x2000)
        soundpitch(4.0)
        soundsetup(25, self, 6)
        soundsetup(0, self, 3, 0)
        soundplay([CM4kA], 0.8V)
        playanim(0, WILLY_BIKE_7)
        playanim(1, WILLY_BIKE_7)
        playanim(2, WILLY_BIKE_7)
        playanim(2, WILLY_BIKE_7)
        playanim(3, WILLY_BIKE_7)
        playanim(4, WILLY_BIKE_7)
        playanim(5, WILLY_BIKE_7)
        playanim(6, WILLY_BIKE_7)
        playframesback(WILLY_BIKE_7, 6.0, 0.0)
        playframes(WILLY_BIKE_FAIL, 0.0, 37.0)
        playframes(24.0, 37.0)
        playframe(animframe, 10)
        interrupter = GLOBAL_97
        sendevent(Event34, interrupter, 1.0)
        playframes(WILLY_BIKE_FAIL_WARP_OUT, 0.0, 15.0)
        miscfunc(null, player, 23, 12)
        voice = ActionVoice
        soundsetup(5, voice, 6)
        soundsetup(0, voice, 3, 0)
        save (x, y, z) {
            getvert(vtrans, self, 0)
            spawn(WEfOC, WEfOC_S_WARP_OUT, 1, 0, 0, 9.5m, 16m, 0x999, 0)
        }
        statusb |= FLAG_INVISIBLE
        sleep()
    }
}

state Willy_Bike_Win { // 57
    stateflag 0xE2000020
    statusc 0x1402
    code(gem) {
        voice = ActionVoice
        soundsetup(12, voice, 6)
        soundpitch(3.2, voice, 2)
        if (mem51) {
            voice = mem51
            soundsetup(0, voice, 0, 15)
        }
        statusb &= ~(FLAG_ROT_Y | 0x2000)
        if (!gem) {
            var0 = speed / 12
        }
        soundpitch(4.0)
        soundplay([CM4kA], 0.8V)
        playframes(WILLY_BIKE_6, 45.0, 60.0)
        playframe(animframe, 10)
        interrupter = GLOBAL_97
        sendevent(Event22, interrupter, 0)
        tpc = 0
        troty = GAMEDIR
        roty = troty
        rotz = 0
        ResetSpeed()
        if (GLOBAL_151 == 5.0) {
            soundpitch(0x514)
            sounddecay(0xFB)
            soundplay([1193I], 1V) // TODO: Find EID, region specific?
        }
        save (x, y, z) {
            getvert(vtrans, self, 1.0)
            y += 1m
            if (!!gem) {
                if (LEVEL == LEVEL_Area51) {
                    spawn2(FruiC, FruiC_S_GEM, 1, 0x800, -0xCCC, -0x800, 0)
                    player = objectspawned
                }
                else {
                    spawn2(FruiC, FruiC_S_GEM, 1, 0, -0xCCC, -0x800, 0, 0x80, 0x80, 0x80)
                    player = objectspawned
                }
            }
            player -> vecx = 0x666
        }
        playframes(WILLY_BIKE_WIN, 0.0, 49.0)
        sendevent(Event2, player, 0)
        voice = ActionVoice
        soundsetup(5, voice, 6)
        soundsetup(0, voice, 3, 0)
        save (x, y, z) {
            getvert(vtrans, self, 1.0) {
                if (gem) {
                    var0 = 0
                }
                else {
                    var0 = 0x2B00
                }
                spawn(WEfOC, WEfOC_S_WARP_OUT, 1, 0, 0, 9.5m, 16m, 0x666, var0)
            }
        }
        sleep()
    }
    trans {
        once {
            var0 = speed / 25
        }
        speed = seek(speed, 0m, var0)
        setvel(speed)
        rotx = degseek(rotx, 0deg, 180deg)
        roty = degseek(roty, GAMEDIR - 90deg, 180deg)
        rotz = degseek(rotz, 50deg, 100deg)
    }
}
#module default

#module [WildC] // 2008I
#purge dpxD
state Coco_Jetski_Init { // 58
    stateflag 0xA2000005
    statusc 0x0
    code() {
        statusb &= ~(FLAG_ROT_Y | FLAG_TRACK_PATH_SIGN | FLAG_GRAVITY | FLAG_HAS_SHADOW | 0x3800)
        ResetJetskiMovement()
        GAMEFLAGS &= ~0x1
        GAMEFLAGS |= 0x20000000
        statusb |= (FLAG_PHYSICS_TEST | FLAG_PHYSICS_ENGINE | FLAG_SOLID_GROUND | -0x80000000)
        SetTRot(0, 0, 0)
        GLOBAL_161 = 0
        GLOBAL_162 = 0 
        speed = 0
        if (y < 0) {
            y = 0
        }
        mem35 = x
        mem36 = y
        mem37 = z
        field_63 = -0x80000000
        groundtime = frametime
        roty = GLOBAL_164 + 180deg
        interrupter = GLOBAL_97
        sendevent(Event76, interrupter, 0)
        soundpitch(0x4B7)
        sounddecay(0xC8)
        soundplay([SfSdA], 0.6V)
        soundpitch(0x571)
        sounddecay(0xFD)
        soundplay([SfsdA], 0.6V)
        ActionVoice = voice
        changestate(Coco_Jetski_Ride)
    }
}

sub ResetJetskiMovement() { // EDS-41
    vfx = (vfx & 0xFFFFFF00) | 0x5
    statusb |= -0x80000000
    mem49 = 0
    mem48 = 0
    mem50 = 0
    mem15 = 0
    mem16 = 0
    mem44 = 0
    mem46 = 0
    rotx = 0
    rotz = 0
    y = ins79(x, null)
    groundy = y
    vfx = (vfx & 0xFFFF00FF) | 0xA00
}

state Coco_Jetski_Ride { // 59
    stateflag 0xA2000005
    statusc 0x0
    trans => sub UpdateJetski
    code() {
        if (animseq == getanim(SIS_JETSKI_JUMP) || animseq == getanim(SIS_JETSKI_BACKFLIP) || animseq == getanim(SIS_JETSKI_ROLL_RIGHT) || animseq == getanim(SIS_JETSKI_DIVE_1) || animseq == getanim(SIS_JETSKI_DIVE_2)) {
            if (groundvel < -8m && y < groundy - 0.2m && !(stateflag & 0x8)) {
                setanim(SIS_JETSKI_BACKFLIP_LAND, -1.0)
                do {
                    if (y < groundy) {
                        playframe(seek(animframe, 7.0))
                    }
                    else {
                        if (animframe == 0) {
                            break
                        }
                        playframe(seek(animframe, 0))
                    }
                } while (1)
            }
            else {
                playframes(SIS_JETSKI_LAND, 0.0, 14.0)
            }
        }
        do {
            if (!mem45) {
                PlayJetskiCoast()
            }
            else {
                PlayJetskiAccelerate()
            }
        } while (1)
    }
    event(e, a) {
        if (e == Event19 || e == Event80) {
            StopJetskiSound()
        }
        accevcstate(Coco_Jetski_Death, e == EventHit || e == Event24 || e == Event38 || e == Event63 || e == Event30)
        accevcstate(Coco_Jetski_Hold, e == Event34)
    }
}

sub UpdateJetski() { // EDS-130
    if (frametime - 10 >= groundtime) {
        if (stateflag & 0x4) {
            if (vely > 5m) {
                changestateif(Coco_Jetski_Backflip, dirhold(PAD_S))
                changestateif(Coco_Jetski_Dive, dirhold(PAD_N))
                changestateif(Coco_Jetski_Roll, dirhold(PAD_W) || dirhold(PAD_E))
            }
            changestateif(Coco_Jetski_Airborne, vely <= 0)
        }
    }
    else if (stateflag & 0x8) {
        spawn(15, 22, 1, groundvel)
        GLOBAL_101 = 5
        GLOBAL_100 = (0xFF * abs(groundvel)) / 10m
        changestate(Coco_Jetski_Ride)
    }
    if (collider, (collider -> spawn >> 16) == 34) {
        sendevent(EventHitInvincible, collider, 100.0)
        if (eventaccepted) {
            GLOBAL_101 = 5
            GLOBAL_100 = 0xFF
        }
    }
    {
        var tilt = mem49 < 0 ? mem49 : 0
        var sx = GLOBAL_161
        var yaw = 0
        var sy = GLOBAL_162 < 0 ? GLOBAL_162 : 0
        if (abs(sx) < 32) {
            sx = 0
        }
        vely = spd(vely, -35m + (((degdist(0, rotx) * -0x4B0) >> 8) << 8))
        troty = seek(troty, (sx * -180deg) >> 7, spd(360deg))
        troty = (troty * (0xCC + ((((50m - ((140m * sy) >> 8)) - speed) * 46) / 80m))) >> 8
        speed = distance(velx, self, 11)
        yaw = miscfunc(velx, self, 1, 2) // atan2
        unless (STATUS_GROUNDLAND) {
            mem16 = 0
        }
        save (troty) {
            troty = degseek(yaw, roty, spd(3000deg))
            setvel(speed)
        }
        if (buttonhold(PAD_X)) {
            trotx = seek(trotx, ((cos(tilt << 1) * -45deg) >> 12), spd(360deg))
            save (troty, speed) {
                troty = roty
                setvel(35m, vvec)
                velx = spd(velx, vecx)
                velz = spd(velz, vecz)
            }
        }
        {
            var damp = 0xFA
            if (!buttonhold(PAD_X) && dirhold(PAD_DOWN) && rotx < 0) {
                damp += (mem50 * 25) >> 9
                stateflag |= 0x100000
            }
            else {
                stateflag &= ~0x100000
            }
            damp = 1.0 - spd((1.0 - damp) * 25)
            velx = (velx * damp) >> 8
            velz = (velz * damp) >> 8
        }
        if (frametime - 10 >= groundtime || y < groundy) {
            mem50 = seek(mem50, GLOBAL_162 * 6, spd(45deg))
        }
        else {
            mem50 = seek(mem50, GLOBAL_162 << 1, spd(45deg))
        }
        if (velx < -20m) {
            velx = -20m
        }
        else if (velx > 20m) {
            velx = 20m
        }
            
        if (velz < -20m) {
            velz = -20m
        }
        else if (velz > 20m) {
            velz = 20m
        }
    }
    if (mem49 > 0) {
        trotx = spd(trotx, (sin(mem49) * (trotx > 0 ? -2000deg : -300deg)) >> 12)
    }
    else if (mem49 < 0) {
        trotx = spd(trotx, 270deg)
    }
    roty = spd(roty, troty)
    mem49 = spd(mem49, trotx)
    {
        var pitch = mem50
        var angle = abs(degdist(roty, mem42))
        if (pitch > 0) {
            pitch = (pitch + ((pitch * ((20m - speed) >> 8)) / (20m >> 8))) >> 1
        }
        mem44 = degseek(mem44, (mem41 * (90deg - angle)) >> 10, 30deg)
        rotx = pitch + mem44
        mem48 = seek(mem48, (troty * (32 + ((speed * 51) / 20m))) >> 8, spd(0, 120deg))
        angle = abs(degdist(roty + 90deg, mem42))
        mem46 = degseek(mem46, (mem41 * (90deg - angle)) >> 10, 30deg)
        rotz = mem48 + mem46
    }
    if (SFXVOL) {
        if (ActionVoice > 0) {
            sp = ActionVoice
            soundcheck(sp)
        }
        else {
            misc = -1
        }
        if (misc != -1) {
            var pitch = 3.2 + ((speed >> 8) * 0x1333 / (20m >> 8))
            unless (statusa & 0x800000 || y < groundy) {
                pitch = (pitch * 0x180) >> 8
            }
            voice = ActionVoice
            soundsetup(0.6V, voice, 0, 0)
            soundsetup(10, voice, 6)
            soundpitch(pitch, voice, 2)
        }
        else {
            soundpitch(0x571)
            sounddecay(0xFD)
            soundplay([SfsdA], 0.6V)
            ActionVoice = voice
        }
    }
    else {
        voice = ActionVoice
        soundsetup(0, voice, 15)
    }
    if (!GLOBAL_101) {
        var rumble = (abs(speed) >> 8) * 0x66 / (20m >> 8)
        if (statusa & 0x800000 || y < groundy) {
            GLOBAL_101 = 3
            GLOBAL_100 = 25 + rumble
        }
        else {
            GLOBAL_101 = 3
            GLOBAL_100 = 25 + (rumble >> 1)
        }
    }
    mem35 = x
    mem36 = y
    mem37 = z
    field_61 = &mem17
    if (collider, collider -> spawn == 0xF0011, collider -> stateflag & 0x40) {
        zindex = 64
        vfx &= 0xFFFF00FF
    }
    else {
        zindex = 24
        vfx = (vfx & 0xFFFF00FF) | 0xA00
    }
    mem17 = groundy
    mem18 = 2
    mem19 = 0x3F3F3F
    mem20 = 0
    mem21 = &mem41
    mem22 = 30
    mem23 = -0x52
    mem45 = buttonhold(PAD_X)
    if (DEBUG) {
        if (buttonhold(PAD_L1) && buttonpress(PAD_SELECT)) {
            invincible = 2
            invincibletime = frametime
        }
        sendeventif(Event6, creator, buttonpress(PAD_L1) && dirpress(PAD_N), self, -2)
    }
}

sub StopJetskiSound() { // EDS-469
    if (ActionVoice) {
        voice = ActionVoice
        soundsetup(25, voice, 6)
        soundsetup(0, voice, 3, 0)
        ActionVoice = 0
    }
}

sub PlayJetskiCoast() { // EDS-476
    if (animseq != getanim(SIS_JETSKI_TURN_1)) {
        CenterJetskiStance()
        if (animseq == getanim(SIS_JETSKI_TURN_2) || animseq == getanim(SIS_JETSKI_2)) {
            if (animseq != getanim(SIS_JETSKI_2)) {
                setanim(SIS_JETSKI_2, -1.0)
            }
            while (animframe < 12.0) {
                if (mem45) {
                    return
                }
                playframe(animframe + 1.0)
            }
        }
        setanim(SIS_JETSKI_TURN_1, 25.0)
    }
    until (mem45) {
        {
            var frame = seek(animframe, 25.0 + ((troty * -0x1100) >> 11), 1.0)
            if (frame < 10.0 && troty > 0) {
                frame = (animframe + 1.0) % 10.0
            } 
            else if (frame > 40.0 && troty < 0) {
                frame = 41.0 + (((animframe - 41.0) + 1.0) % 10.0)
            }
            playframe(frame)
        }
    }
}


sub PlayJetskiAccelerate() { // EDS-529
    if (animseq != getanim(SIS_JETSKI_TURN_2)) {
        CenterJetskiStance()
        if (animseq == getanim(SIS_JETSKI_TURN_1) || animseq == getanim(SIS_JETSKI_2)) {
            if (animseq != getanim(SIS_JETSKI_2)) {
                setanim(SIS_JETSKI_2, 13.0)
            }
            while (animframe > 0) {
                if (!mem45) {
                    return
                }
                playframe(animframe - 1.0)
            }
        }
        setanim(SIS_JETSKI_TURN_2, 25.0)
    }
    while (mem45) {
        {
            var frame = seek(animframe, 25.0 + (mem48 * -0x1100 / 30deg), 1.0)
            if (frame < 10.0 && troty > 0) {
                frame = (animframe + 1.0) % 10.0
            } 
            else if (frame > 40.0 && troty < 0) {
                frame = 41.0 + (((animframe - 41.0) + 1.0) % 10.0)
            }
            playframe(frame)
        }
        if (stateflag & 0x100000) {
            CenterJetskiStance()
            playframes(SIS_JETSKI_1, 0.0, 16.0)
            while (stateflag & 0x100000) {
                playframe()
            }
            return
        }
    }
}

sub CenterJetskiStance() { // EDS-597
    if (animseq == getanim(SIS_JETSKI_TURN_2)) {
        until (animframe == 25.0) {
            playframe(seek(animframe, 25.0, 2.0))
        } 
    }
    else if (animseq == getanim(SIS_JETSKI_TURN_1)) {
        until (animframe == 25.0) {
            playframe(seek(animframe, 25.0, 2.0))
        } 
    }
}

state Coco_Jetski_Airborne { // 60
    stateflag 0xA2000009
    statusc 0x0
    code() {
        CenterJetskiStance()
        playframes(SIS_JETSKI_JUMP, 0.0, 10.0)
        sleep()
    }
    event(e, a) {
        if (e == Event19 || e == Event80) {
            StopJetskiSound()
        }
        if (interrupter) {
            rejevret(vely < 0 && e == EventHit && interrupter -> spawn == 0x2E0000)
        }
        accevcstate(Coco_Jetski_Death, e == EventHit || e == Event24 || e == Event38 || e == Event63 || e == Event30)
        accevcstate(Coco_Jetski_Hold, e == Event34)
    }
    trans {
        unless (STATUS_GROUNDLAND) {
            if (collider, vely <= 0) {
                sendevent(EventJumpedOn, collider, BounceCombo)
                if (eventaccepted) {
                    BounceCombo += 1.0
                }
            }
        }
        UpdateJetski()
    }
}

state Coco_Jetski_Backflip { // 61
    stateflag 0xA2000019
    statusc 0x0
    event => state Coco_Jetski_Airborne
    trans => state Coco_Jetski_Airborne
    code() {
        CenterJetskiStance()
        PlayJetskiStuntVoice()
        playframes(SIS_JETSKI_BACKFLIP, 0.0, 18.0)
        sleep()
    }
}

sub PlayJetskiStuntVoice() { // EDS-681
    if (GLOBAL_151 == 5.0) {
        var r = rand(3)
        if (r == 0) {
            SoundPitchDefault(0.25)
            soundplay([1224I], 1V) // TODO: Find EID
        }
        else if (r == 1) {
            SoundPitchDefault(0.25)
            soundplay([1225I], 1V) // TODO: Find EID
        }
    }
}

state Coco_Jetski_Dive { // 62
    stateflag 0xA2000009
    statusc 0x0
    event => state Coco_Jetski_Airborne
    trans => state Coco_Jetski_Airborne
    code() {
        CenterJetskiStance()
        PlayJetskiStuntVoice()
        playframes(SIS_JETSKI_DIVE_1, 0.0, 13.0)
        do {
            playanim(0, SIS_JETSKI_DIVE_2)
            playanim(1, SIS_JETSKI_DIVE_2)
            playanim(2, SIS_JETSKI_DIVE_2)
            playanim(3, SIS_JETSKI_DIVE_2)
            playanim(4, SIS_JETSKI_DIVE_2)
            playanim(4, SIS_JETSKI_DIVE_2)
            playanim(5, SIS_JETSKI_DIVE_2)
            playanim(6, SIS_JETSKI_DIVE_2)
        } while (1)
    }
}

state Coco_Jetski_Roll { // 63
    stateflag 0xA2000009
    statusc 0x0
    event => state Coco_Jetski_Airborne
    trans => state Coco_Jetski_Airborne
    code() {
        var left = dirhold(PAD_LEFT)
        CenterJetskiStance()
        PlayJetskiStuntVoice()
        if (left) {
            playframes(SIS_JETSKI_ROLL_LEFT, 0.0, 18.0)
        }
        else {
            playframes(SIS_JETSKI_ROLL_RIGHT, 0.0, 18.0)
        }
        sleep()
    }
}

state Coco_Jetski_Hold { // 64
    stateflag 0xA0010805
    statusc 0x800
    code() {
        ResetJetskiMovement()
        if (ActionVoice) {
            voice = ActionVoice
            soundsetup(10, voice, 6)
            soundpitch(0x4CC, voice, 2)
        }
        speed = 0
        CenterJetskiStance()
        sleep()
    }
    event(e, a) {
        if (e == Event19 || e == Event80) {
            StopJetskiSound()
        }
        accevcstate(Coco_Jetski_Ride, e == Event21)
    }
    trans {
        velx = (velx * 0xCC) >> 8
        vely = (vely * 0xCC) >> 8
        velz = (velz * 0xCC) >> 8
        rotx = degseek(rotx, 0, 180deg)
        rotz = degseek(rotz, 0, 180deg)
        vely = spd(vely, -35m)
        mem17 = groundy
    }
}

state Coco_Jetski_Hit { // 65
    stateflag 0xA2000005
    statusc 0x8
    event => state Coco_Jetski_Ride
    trans => state Coco_Jetski_Ride
    code() {
        if (!invincible) {
            invincible = 4
            invincibletime = frametime
        }
        CenterJetskiStance()
        vely = 12.64912m
        playframes(SIS_JETSKI_HIT, 0.0, 24.0)
        changestate(Coco_Jetski_Ride)
    }
}

state Coco_Jetski_Death { // 66
    stateflag 0xA2000022
    statusc 0x1422
    code(arg) {
        sendevent(EventHit, creator, arg)
        if (eventaccepted) {
            stateflag &= ~0x8000000
            changestate(Coco_Jetski_Hit)
        }
        var vspd = speed
        var obj = interrupter
        var dist = 3m
        BeginDeath(arg)
        KillBonus()
        statusb |= (FLAG_PHYSICS_TEST | FLAG_GRAVITY | FLAG_PHYSICS_ENGINE | FLAG_SOLID_GROUND)
        GAMEFLAGS |= 0x2
        StopJetskiSound()
        if (interrupter) {
            if (interrupter -> spawn == 0x2F0000) {
                save (interrupter) {
                    interrupter = GLOBAL_97
                    sendevent(Event7, interrupter, 6m)
                }
                playframe(animframe, 42)
                playframe(animframe, 42)
                playframe(animframe, 25)
            }
            else if (interrupter -> spawn == 0x2A0000 || interrupter -> spawn == 0x2A0001 || interrupter -> spawn == 0x2E0000 || interrupter -> spawn == 0x220012) {
                if (interrupter -> spawn == 0x2E0000) {
                    dist = 6m
                }
                save (interrupter) {
                    interrupter = GLOBAL_97
                    sendevent(Event7, interrupter, dist)
                }
                statusb &= ~(FLAG_ROT_Y | 0x2000)
                spawn(15, 22, 1, 5m)
                spawn2(15, 37)
                setanim(SIS_JETSKI_DEATH_FLOAT_2, -1.0)
                do {
                    animframe += 1.0
                    rotx = degseek(rotx, 0deg, 360deg)
                    rotz = degseek(rotz, 0deg, 360deg)
                    if (animframe == 17.0) {
                        spawn(15, 22, 1, 5m)
                    }
                    if (animframe == 20.0) {
                        statusb |= FLAG_ROT_Y
                        save (interrupter) {
                            if (interrupter -> spawn == 0x2E0000) {
                                interrupter = obj
                            }
                            else {
                                interrupter = GLOBAL_97
                            }
                            troty = atan2(interrupter -> trans)
                            trotx = abs(troty * 25 / 21)
                        }
                    }
                    playframe()
                } while (animframe + 1.0 <= 48.0)
                playframes(SIS_JETSKI_DEATH_FLOAT_3, 0.0, 24.0)
                FadeToBlack()
                WaitFadeFrame((animframe + 1.0) % 25.0)
            }
            else if (interrupter -> spawn == 0x2C0000) {
                save (interrupter) {
                    interrupter = GLOBAL_97
                    sendevent(Event7, interrupter, 6m)
                }
                spawn(15, 31, 1, vspd, rotx, roty, rotz)
                setanim(SIS_JETSKI_DEATH_FLOAT_1, -1.0)
                do {
                    animframe += 1.0
                    if (animframe == 4.0) {
                        save (x, y, z) {
                            getvert(vtrans, self, 0.0)
                            spawn(15, 22, 1, 1m)
                        }
                    }
                    playframe()
                } while (animframe + 1.0 <= 32.0)
                do (var i = 0) {
                    playframes(32.0, 48.0)
                } while ({ i += 1.0 }; i < 3.0)
                FadeToBlack()
                playframes(32.0, 42.0)
            }
            else if (interrupter -> spawn == 0x2A0003 || interrupter -> spawn == 0x310001) {
                save (interrupter) {
                    interrupter = GLOBAL_97
                    sendevent(Event7, interrupter, dist)
                }
                if (interrupter -> spawn == 0x2A0003) {
                    spawn(15, 31, 1, vspd, rotx, roty, rotz)
                }
                else {
                    sounddecay(0xC8)
                    soundpitch(0x22D)
                    soundplay([sht0A], 1V)
                    spawn(15, 27, 1, vspd, rotx, roty, rotz)
                }
                statusb &= ~FLAG_ROT_Y
                rotx = 0
                rotz = 0
                troty = arg
                roty = troty + 180deg
                statusb |= FLAG_PHYSICS_ENGINE
                setvel(15m)
                speed = 0
                playframes(SIS_JETSKI_DEATH_SINK, 0.0, 7.0)
                spawn(15, 22, 1, 1m)
                playframes(7.0, 24.0)
                FadeToBlack()
                WaitFadeNull()
            }
        }
        CrashDoRespawn()
    }
}
#module default

#module[WiliC] // 2010I
sub PlayWadeIdle() { // ES-413
    ResetCombos()
    if (animseq == getanim(WILLY_WADE_1)) {
        playanim2(WILLY_WADE_3, 1.0)
        playanim2(WILLY_WADE_3, 0.0)
    }
    sleepframes(WILLY_WADE_2, 0.0, 19.0)
}

state Willy_Wade { // 67
    stateflag 0x40200005
    statusc 0x0
    code => sub PlayWadeIdle
    event(e, a) {
        CrashEventCommon(e, a)
    }
    trans {
        once {
            DoubleJumpUsed = 0
        }
        CheckJump(Willy_Jump_Start, 9.380835m)
        CheckSlide(Willy_Wade_Duck)
        changestateif(Willy_Wade_Move, abs(speed) & -4)
        changestateif(Willy_Idle, statusa & 0x1000000)
        SpinCooldownTime = frametime
    }
}

state Willy_Wade_Enter { // 68
    stateflag 0x40200005
    statusc 0x0
    event => state Willy_Wade
    trans => state Willy_Wade
    code() {
        ResetCombos()
        playanim2(WILLY_WADE_4, 0.0)
        playanim2(WILLY_WADE_4, 1.0)
        playanim2(WILLY_WADE_4, 2.0)
        PlayWadeIdle()
    }
}

state Willy_Wade_Move { // 69
    stateflag 0x40200005
    statusc 0x0
    event => state Willy_Wade
    code() {
        onstateexit(ResetStance)
        if (animseq == getanim(WILLY_WADE_2)) {
            playanim2(WILLY_WADE_3, 0.0)
            playanim2(WILLY_WADE_3, 1.0)
            playframes(WILLY_WADE_1, 9.0, 26.0)
        }
        do {
            SoundPitchDefault()
            sounddecay(3.2s)
            soundplay([Sw1SA], 0xFFF + rand(0x666))
            sounddelay(12)
            soundpitch((0xCCC + rand(3.2)) * 52 >> 8)
            sounddecay(3.2s)
            soundplay([Sw1SA], 0xFFF + rand(0x666))
            playframes(WILLY_WADE_1, 0.0, 26.0)
        } while (1)
    }
    trans {
        CheckJump(Willy_Jump_Run, 9.380835m)
        CheckSlide(Willy_Wade_Duck)
        if (dirhold(PAD_NONE)) {
            if (animseq == getanim(WILLY_WADE_1) && (animframe >= 8.0 && animframe <= 11.0)) {
                speed = 0
                changestate(Willy_Wade)
            }
            if (animseq == getanim(WILLY_WADE_1) && (animframe >= 21.0 && animframe <= 24.0)) {
                speed = 0
                scalex = -scalex
                changestate(Willy_Wade)
            }
        }
        changestateif(Willy_Move, statusa & 0x1000000)
        SpinCooldownTime = frametime
    }
}

state Willy_Wade_Duck { // 70
    stateflag 0x40300005
    statusc 0x0
    event => state Willy_Wade
    code() {
        onstateexit(StopAndRestoreControl)
        statusb &= ~FLAG_DPAD_CONTROL
        ResetSpeed()
        setanim(WILLY_DUCK_START, 0.0)
        if (buttonhold(PAD_R1 | PAD_CIRCLE)) {
            playframe(seek(animframe, 4.0, 1.0))
        }
        else if (animseq == getanim(WILLY_DUCK_START) && animframe <= 2.0) {
            changestateifn(Willy_Wade_Move, dirhold(PAD_NONE))
        }
        if (animframe == 0) {
            changestate(Willy_Wade)
        }
        else {
            playframe(seek(animframe, 0.0, 1.0))
        }
    }
}

state Willy_Death_Drown { // 71
    stateflag 0x1020
    statusc 0x1C02
    __transargs
    code(base) {
        onstateexit(ResetStance)
        statusb &= ~FLAG_HAS_SHADOW
        statusb &= ~(FLAG_ROT_Y | FLAG_GRAVITY | FLAG_PHYSICS_ENGINE | FLAG_DPAD_CONTROL)
        ResetSpeed()
        GAMEFLAGS &= ~0x2
        if (BONUSSTATE == BONUS_CURRENT) {
            SetBonusState(BONUS_KILLED)
        }
        PlayDeathArg(0.5V)
        GLOBAL_3 = GLOBAL_118
        var0 = 0
        if (interrupter) {
            var extra = getpayload(&[Cs6kV], &[Cr10G]) <= getfreepages()
            if (mem50) {
                extra = 0
            }
            if (extra) {
                LoadAnim([Cs6kV], [Cr10G])
                ExtraAnimGroup = 20.0
            }
            playframes(WILLY_DEATH_DROWN_1, 0.0, 42.0)
            if (!extra) {
                FadeToBlack()
                WaitFadeFrame((animframe + 1.0) % 51.0)
            }
            else {
                playframes(43.0, 50.0)
                playframes(WILLY_DEATH_DROWN_2, 0.0, 74.0)
                FadeToBlack()
                playframes(75.0, 82.0)
                mem50 = 1.0
                DeloadExtraAnims()
            }
        }
        else {
            var extra = getpayload(&[Cs3kV], &[Cr10G]) <= getfreepages()
            if (extra) { 
                LoadAnim([Cs3kV], [Cr10G])
                ExtraAnimGroup = 14.0
            }
            playframes(WILLY_DEATH_DROWN_3, 0.0, 41.0)
            if (extra) {
                playframes(WILLY_DEATH_DROWN_4, 0.0, 51.0)
                FadeToBlack()
                playframes(WILLY_DEATH_DROWN_4, 51.0, 57.0)
                WaitFadeFrame()
                DeloadExtraAnims()
            }
            else {
                FadeOutAndWait()
            }
        }
        CrashDoRespawn()
    }
    trans {
        base = GLOBAL_118
        if (animseq == getanim(WILLY_DEATH_DROWN_3) || animseq == getanim(WILLY_DEATH_DROWN_4)) {
            base += 2m
        }
        y = seek(y, base - 2m, spd(2m))
    }
}
#module default

#module [WilmC] // 2010I
#purge mqy
sub PlayHangIdle() { // EMS-0
    ResetCombos()
    if (animseq == getanim(WILLY_HANG_1)) {
        if (animframe <= 1.0 || animframe >= 21.0) {
            playanim2(WILLY_HANG_6, 0.0)
            playanim2(WILLY_HANG_6, 1.0)
            playanim2(WILLY_HANG_6, 2.0)
        }
        else if (animframe <= 5.0) {
            playanim2(WILLY_HANG_7, 0.0)
            playanim2(WILLY_HANG_7, 1.0)
            playanim2(WILLY_HANG_7, 2.0)
        }
        else if (animframe <= 9.0) {
            playanim2(WILLY_HANG_8, 0.0)
            playanim2(WILLY_HANG_8, 1.0)
            playanim2(WILLY_HANG_8, 2.0)
        }
        else if (animframe <= 12.0) {
            scalex = -scalex
            playanim2(WILLY_HANG_6, 0.0)
            playanim2(WILLY_HANG_6, 1.0)
            playanim2(WILLY_HANG_6, 2.0)
            scalex = -scalex
        }
        else if (animframe <= 16.0) {
            scalex = -scalex
            playanim2(WILLY_HANG_7, 0.0)
            playanim2(WILLY_HANG_7, 1.0)
            playanim2(WILLY_HANG_7, 2.0)
            scalex = -scalex
        }
        else if (animframe <= 21.0) {
            scalex = -scalex
            playanim2(WILLY_HANG_8, 0.0)
            playanim2(WILLY_HANG_8, 1.0)
            playanim2(WILLY_HANG_8, 2.0)
            scalex = -scalex
        }
    }
    if (animseq != getanim(WILLY_HANG_IDLE)) {
        setanim(WILLY_HANG_IDLE, -1.0)
    }
    do {
        animframe = (animframe + 1.0) % 25.0
        playframe()
    } while (1)
}

state Willy_Hang_Idle { // 72
    stateflag 0x20200005
    statusc 0x0
    code => sub PlayHangIdle
    event(e, a) {
        rejevif (e == Event51) {
            statetime = frametime
        }
        accevcstate(Willy_Hang_Hold, e == Event34)
        CrashEventCommon(e, a)
        if (e == EventHit || e == Event14 || e == Event20 || e == Event35 || e == Event30 || e == Event31 || e == Event63 || e == Event62 || e == Event74 || e == Event24 || e == Event25 || e == Event44 || e == Event61) {
            sendevent(EventHit, creator, a[0])
            if (eventaccepted) {
                stateflag &= ~0x8000000
                if (!invincible) {
                    invincible = 4
                    invincibletime = frametime
                }
                accevret()
            }
            accevcstate(Willy_Death_Hang_Fall, e == Event74)
        }
    }
    trans {
        once {
            statusb &= ~FLAG_GRAVITY
            DoubleJumpUsed = 0
        }
        changestateif(Willy_Hang_Drop, buttonpress(PAD_X) || statusa & 0x8000)
        if (buttonbuffer(PAD_SQUARE)) {
            if (frametime - SpinCooldownTime >= 7) {
                InitSpin()
                changestate(Willy_Hang_Spin)
            }
            else {
                SoundPitchDefault()
                sounddecay(0x90)
                soundplay([!sp0A], 0.3V)
            }
        }
        unless (buttonhold(PAD_X)) {
            changestateif(Willy_Hang_Tuck, buttonhold(PAD_R1 | PAD_CIRCLE))
        }
        changestateif(Willy_Hang_Move, abs(speed) & ~0x3)
        unless (frametime - statetime >= 2) {
            vely = 4m
        }
    }
}

state Willy_Hang_Move { // 73
    stateflag 0x20200005
    statusc 0x0
    event => state Willy_Hang_Idle
    code() {
        ResetCombos()
        playanim2(WILLY_HANG_5, 0.0)
        playanim2(WILLY_HANG_5, 1.0)
        playanim2(WILLY_HANG_5, 2.0)
        playanim2(WILLY_HANG_5, 3.0)
        soundpitch(0x1FF)
        sounddelay(2)
        soundplay([FGraA], 0.5V)
        playframes(WILLY_HANG_1, 8.0, 22.0)
        do {
            soundpitch(0x1FF)
            soundplay([FGraA], 0.5V)
            soundpitch(0x1FF)
            sounddelay(11)
            soundplay([FGraA], 0.5V)
            playframes(WILLY_HANG_1, 0.0, 22.0)
        } while (1)
    }
    trans {
        changestateif(Willy_Hang_Drop, buttonpress(PAD_X) || frametime - statetime >= 4 || statusa & 0x8000)
        if (buttonbuffer(PAD_SQUARE)) {
            if (frametime - SpinCooldownTime >= 7) {
                InitSpin()
                changestate(Willy_Hang_Spin)
            }
            else {
                SoundPitchDefault()
                sounddecay(0x90)
                soundplay([!sp0A], 0.3V)
            }
        }
        unless (frametime - statetime >= 2) {
            changestateif(Willy_Hang_Tuck, buttonbuffer(PAD_R1 | PAD_CIRCLE))
        }
        changestateifn(Willy_Hang_Idle, abs(speed) & ~0x3)
        if (frametime - statetime >= 7) {
            changestateif(Willy_Hang_Idle, (abs(x - mem35) + abs(z - mem37)) < 0.2m)
        }
        unless (frametime - statetime >= 4) {
            vely = 8m
        }
        mem35 = x
        mem37 = z
    }
}

state Willy_Hang_Spin { // 74
    stateflag 0x20200005
    statusc 0x0
    code() {
        onstateexit(RestoreHangControl)
        statusb &= ~(FLAG_ROT_Y | FLAG_DPAD_CONTROL)
        ResetSpeed()
        setanim(WILLY_HANG_SPIN, 9.0)
        do {

            playframe((animframe + 1.0) % 10.0)
        } until (frametime - SpinPulseTime >= SpinDuration)
        changestate(Willy_Hang_Idle)
    }
    event(e, a) {
        if (e == Event51) {
            rejev()
            statetime = frametime
        }
        accevcstate(Willy_Hang_Hold, e == Event34)
        if (e == Event42) {
            rejev()
            sendevent(EventSpinHit, interrupter, 1)
        }
        if (e == Event40) {
            rejev()
            save (interrupter) {
                interrupter = a[0]
                sendevent(EventSpinHit, interrupter, 1)
            }
        }
        rejevret(e == EventHit || e == Event14 || e == Event20 || e == Event35 || e == Event30 || e == Event31 || e == Event63 || e == Event62 || e == Event74)
    }
    trans {
        sendevent(EventSpinHit, collider, AttackCombo)
        if (eventaccepted) {
            sounddecay(0x90)
            soundpitch((14.4 + (rand(3.2) + (1.6 * AttackCombo >> 8))) * 0.23 >> 8)
            soundplay([sht0A], 0.4V)
            AttackCombo += 1.0
        }
        unless (frametime - statetime >= 5) {
            vely = 10m
        }
    }
}

sub RestoreHangControl() { // EMS-344
    statusb |= (FLAG_ROT_Y | FLAG_DPAD_CONTROL)
}

state Willy_Hang_Tuck { // 75
    stateflag 0x20000005
    statusc 0x0
    event => state Willy_Hang_Idle
    code() {
        ResetCombos()
        ResetSpeed()
        onstateexit(RestoreHangInput)
        statusb &= ~FLAG_DPAD_CONTROL
        playanim2(WILLY_HANG_TUCK, 0.0)
        playanim2(WILLY_HANG_TUCK, 1.0)
        playanim2(WILLY_HANG_TUCK, 2.0)
        playanim2(WILLY_HANG_TUCK, 3.0)
        playanim2(WILLY_HANG_TUCK, 3.0)
        playanim2(WILLY_HANG_TUCK, 4.0)
        playanim2(WILLY_HANG_TUCK, 5.0)
        while (buttonhold(PAD_R1 | PAD_CIRCLE)) {
            playframe()
        }
        playframesback(WILLY_HANG_TUCK, 6.0, 0.0)
        changestate(Willy_Hang_Idle)
    }
    trans {
        changestateif(Willy_Hang_Drop, buttonpress(PAD_X) || frametime - statetime >= 5 || statusa & 0x8000)
        if (buttonbuffer(PAD_SQUARE)) {
            if (frametime - SpinCooldownTime >= 7) {
                InitSpin()
                changestate(Willy_Hang_Spin)
            }
            else {
                SoundPitchDefault()
                sounddecay(0x90)
                soundplay([!sp0A], 0.3V)
            }
        }
        unless (frametime - statetime >= 5) {
            vely = 10m
        }
    }
}

sub RestoreHangInput() { // EMS-411
    statusb |= FLAG_DPAD_CONTROL
}

state Willy_Hang_Drop { // 76
    stateflag 0x20000009
    statusc 0x200000
    code() {
        statusb |= FLAG_GRAVITY
        if (animseq == getanim(WILLY_HANG_IDLE)) {
            playanim2(WILLY_HANG_2, 0.0)
            playanim2(WILLY_HANG_2, 1.0)
            playanim2(WILLY_HANG_2, 2.0)
        }
        else if (animseq == getanim(WILLY_HANG_1) && (animframe <= 2.0 || animframe >= 14.0)) {
            playframesback(WILLY_HANG_3, 2.0, 0.0)
        }
        else if (animseq == getanim(WILLY_HANG_1) && (animframe >= 9.0 && animframe <= 14.0)) {
            scalex = -abs(scalex)
            onstateexit(ResetHangMirror)
            playframesback(WILLY_HANG_3, 2.0, 0.0)
        }
        else if (animseq == getanim(WILLY_HANG_1) && (animframe >= 15.0 && animframe <= 20.0)) {
            scalex = -abs(scalex)
            onstateexit(ResetHangMirror)
            playframesback(WILLY_HANG_4, 2.0, 0.0)
            scalex = abs(scalex)
        }
        else {
            playframesback(WILLY_HANG_4, 2.0, 0.0)
        }
        changestate(Willy_Falling)
    }
}

sub ResetHangMirror() { // EMS-492
    scalex = abs(scalex)
}

state Willy_Hang_Hold { // 77
    stateflag 0x20010805
    statusc 0x800
    code() {
        onstateexit(ResetMovement)
        speed = 0
        SetVel(0, 0, 0)
        statusb &= ~FLAG_DPAD_CONTROL
        PlayHangIdle()
    }
    event(e, a) {
        accevcstate(Willy_Hang_Idle, e == Event21)
    }
}

state Willy_Death_Hang_Fall { // 78
    stateflag 0x8000022
    statusc 0xC22
    code(arg) {
        BeginDeath(arg)
        KillBonus()
        GLOBAL_75 = 25
        GLOBAL_65 = -1
        PlayDeathArg(0.5V)
        playframes(WILLY_HANG_FALL, 0.0, 9.0)
        animframe = 9.0
        do {
            animframe += 1.0
            y = spd(y, -10.5m)
            playframe()
        } while (animframe + 1.0 <= 11.0)
        playnull(10)
        FadeToBlack()
        WaitFadeNull()
        CrashDoRespawn()
    }
}

state Willy_Death_Knife { // 79
    stateflag 0x22
    statusc 0xC22
    code(arg) {
        BeginDeath(arg)
        KillBonus()
        GAMEFLAGS |= 0x20002
        GLOBAL_128 = x
        GLOBAL_129 = y
        GLOBAL_130 = z
        GLOBAL_75 = 25
        GLOBAL_65 = -1
        PlayDeathArg(0.5V)
        statusb |= (FLAG_ROT_Y | FLAG_PHYSICS_TEST | FLAG_GRAVITY | FLAG_PHYSICS_ENGINE)
        troty = atan2(interrupter -> trans)
        trotx = abs(degdist(roty, troty)) * 3
        playframes(WILLY_DEATH_KNIFE, 0.0, 62.0)
        FadeToBlack()
        playframes(63.0, 74.0)
        WaitFadeFrame()
        CrashDoRespawn()
    }
    trans {
        GLOBAL_130 = spd(GLOBAL_130, 1m)
    }
}

state Willy_Death_Vase { // 80
    stateflag 0x22
    statusc 0xC22
    code(arg) {
        save (interrupter) {
            BeginDeath(arg)
            KillBonus()
            statusb |= (FLAG_PHYSICS_TEST | FLAG_GRAVITY | FLAG_PHYSICS_ENGINE)
        }
        GLOBAL_75 = 25
        GLOBAL_65 = -1
        PlayDeathArg(0.5V)
        getvert(vvec, interrupter, 0.0)
        troty = atan2(self, vecx)
        roty = troty
        spawn(65, 2)
        playframes(WILLY_DEATH_VASE, 0.0, 39.0)
        FadeOutAndWait()
        CrashDoRespawn()
    }
}

state Willy_Death_Genie { // 81
    stateflag 0x22
    statusc 0xC22
    code(arg) {
        var obj = interrupter
        BeginDeath(arg)
        KillBonus()
        GLOBAL_75 = 25
        GLOBAL_65 = -1
        y += 2m
        interrupter = obj
        getvert(vvec, interrupter, 1.0)
        settrans(MoveToGenie)
        spawn(59, 3)
        playframes(WILLY_DEATH_GENIE_1, 0.0, 32.0)
        spawn(9, 10, 1, 0, getins(InitGenieEffect), 0)
        spawn(9, 10, 1, 1.0, getins(InitGenieEffectSmall), 1)
        interrupter = obj
        var0 = sin(4.0 - abs(degdist(CAMROTY, atan2(interrupter, x)))) >> 7
        setanim(WILLY_DEATH_GENIE_2, -1.0)
        do {
            animframe += 1.0
            zindex = var0
            playframe()
        } while (animframe + 1.0 <= 25.0)
        spawn(9, 10, 1, 0, getins(InitGenieEffect), 0)
        playnull(7)
        FadeToBlack()
        WaitFadeNull()
        CrashDoRespawn()
    }
}

sub MoveToGenie() { // EMS-714
    x = seek(x, vecx, spd(2m, 0x10E))
    z = seek(z, vecz, spd(2m, 0x10E))
}

sub InitGenieEffectSmall() { // EMS-723
    SetColor1(0x80, 0x80, 0x80)
    SetScale(0.5S)
    velx >>= 1
    vely >>= 1
    velz >>= 1
    y -= 0.75m
}

sub InitGenieEffect() { // EMS-738
    SetColor1(0x80, 0x80, 0x80)
    y -= 12m
}
#module default

state Willy_Duck { // 82
    stateflag 0x5
    statusc 0x0
    event => sub MovementEvent
    __transargs
    code(ready) {
        do {
            if (!rand(60)) {
                setanim(WILLY_DUCK)
                playframe(0.0, 2)
            }
            else {
                setanim(WILLY_DUCK_START)
                playframe(4.0)
            }
        } while (1)
    }
    trans {
        once {
            onstateexit(StopAndRestoreControl)
            statusb &= ~FLAG_DPAD_CONTROL
        }
        if (!(statusa & 0x2000000)) {
            ResetSpeed()
        }
        CheckHighJump()
        if (buttonhold(PAD_R1 | PAD_CIRCLE) || (mem48 && !(frametime - statetime >= 2))) {
            changestateif(Willy_Crawl, !dirhold(PAD_NONE) && ((frametime - statetime >= 5) || ready) && !(statusa & 0x2000000))
        }
        else {
            hpc = 0
            changestate(Willy_Duck_Transition, 0)
        }
        CheckFall(0.2s)
    }
}

state Willy_Duck_Transition { // 83
    stateflag 0x5
    statusc 0x0
    event => sub MovementEvent
    code(enter) {
        onstateexit(StopAndRestoreControl)
        statusb &= ~FLAG_DPAD_CONTROL
        if (!(statusa & 0x2000000)) {
            ResetSpeed()
        }
        SoundJumpDefault(14.4, 0.205, 0x40, 0x47A)
        if (animseq == getanim(WILLY_EDGE_1)) {
            enter = 0
            playframesback(WILLY_EDGE_2, 1.0, 0.0)
        }
        setanim(WILLY_DUCK_START)
        mem48 = 0
        if (enter) {
            animframe = 0
        }
        else {
            animframe = 4.0
        }
        do {
            start :
            if (buttonhold(PAD_R1 | PAD_CIRCLE) || (mem48 && !(statusa & 0x100000) && !(statusa & 0x2000000))) {
                if (animseq == getanim(WILLY_DUCK_START) && animframe >= 3.0) {
                    changestateifn(Willy_Crawl, dirhold(PAD_NONE) || statusa & 0x2000000)
                }
                if (animframe == 4.0) {
                    break
                }
                else {
                    playframe(seek(animframe, 4.0, 1.0))
                }
            }
            else {
                if (statusa & 0x80 && !(statusa & 0x100000) && !(statusa & 0x2000000)) {
                    mem48 = 1.0
                    goto start
                }
                if (animseq == getanim(WILLY_DUCK_START) && animframe <= 2.0) {
                    changestateifn(Willy_Move, dirhold(PAD_NONE))
                }
                if (animframe == 0) {
                    changestate(Willy_Idle)
                }
                else {
                    playframe(seek(animframe, 0.0, 1.0))
                }
            } 
        } while (1)
        hpc = 0
        changestate(Willy_Duck, 1.0)
    }
    trans {
        CheckHighJump()
        CheckFall(0.2s)
    }
}

sub CheckHighJump() { // S-2373
    changestateif(Willy_Jump_High, (buttonbuffer(PAD_X) && (!(statusa & 0x80) || statusa & 0x100000)) && !(statusa & 0x80) && !mem48, 14.20141m)
}

state Willy_Crawl { // 84
    stateflag 0x280005
    statusc 0x0
    event => sub MovementEvent
    code() {
        playanim2(WILLY_CRAWL_START, 0.0)
        playanim2(WILLY_CRAWL_START, 1.0)
        playanim2(WILLY_CRAWL_START, 1.0)
        setanim(WILLY_CRAWL, 15.0)
        do {

            animframe = (animframe + 1.0) % 16.0
            playframe()
            if (animframe == 15.0) {
                scalex = -scalex
            }
        } until (mem47 || ((animseq == getanim(WILLY_CRAWL) && animframe <= 3.0) && dirhold(PAD_NONE)))
        playframesback(WILLY_CRAWL_START, 2.0, 0.0)
        changestate(Willy_Duck_Transition, 0)
    }
    trans {
        once {
            onstateexit(StopAndRestoreControl)
            trotx = 180deg
            mem47 = 0
        }
        CheckHighJump()
        if (!buttonhold(PAD_R1 | PAD_CIRCLE) && !(statusa & 0x80) || statusa & 0x2000000) { // TODO: pad uses logical NOT here without setting the final pad param to 1..? Should yield the same result but flagging anyway
            mem47 = 1.0
        }
        CheckFall(0.2s)
    }
}

state Willy_Slide { // 85
    stateflag 0x80005
    event => sub MovementEvent
    code() {
        SoundPitchDefault()
        sounddecay(3.2s)
        soundplay([Sld0A], 0xCCC + rand(0x333))
        playframes(WILLY_SLIDE, 0.0, 3.0)
        playframes(WILLY_SLIDE, 5.0, 7.0)
        until (STATUS_GROUNDLAND) {
            playframe()
        }
        spawn(9, 2, 1, -1.0, 5.0, 4m) // PartC-2
        hpc = 0
        mem48 = 0
        changestate(Willy_Duck, 1.0)
    }
    trans {
        once {
            if (!rand(2)) {
                scalex = -scalex
            }
            changestateif(Willy_Duck_Transition, dirhold(PAD_NONE), 1.0)
            onstateexit(StopAndRestoreControl)
            roty = troty
            if (!(frametime - statetime >= 5)) {
                speed += 11m
                if (speed > 18m) {
                    speed = 18m
                }
                setvel(speed)
            }
        }
        unless (statusa & 0x80) {
            if (buttonbuffer(PAD_SQUARE)) {
                if (frametime - SpinCooldownTime >= 7) {
                    hpc = 0
                    InitSpin()
                    changestate(Willy_Slide_Spin)
                }
                else {
                    SoundPitchDefault()
                    sounddecay(0.5625)
                    soundplay([!sp0A], 0.3V)
                }
            }
            if ((buttonbuffer(PAD_X) && (!(statusa & 0x80) || statusa & 0x100000)) && !(frametime - groundtime >= 5)) {
                onstateexit(RestoreControl)
                changestate(Willy_Jump_High, 14.20141m)
            }
        }
        sendevent(EventSlideHit, collider, AttackCombo)
        if (eventaccepted) {
            sounddecay(0.5625)
            soundpitch((14.4 + (rand(3.2) + (1.6 * AttackCombo >> 8))) * 0.23 >> 8)
            soundplay([sht0A], 0.4V)
            AttackCombo += 1.0
        }
        if (FRAMETIME < 36) {
            spawn(9, 1, 2, 0) // PartC-1
        }
    }
}

state Willy_Slam { // 86
    stateflag 0x80009
    statusc 0xF0000000
    __transargs
    event => sub AirborneEvent
    code(vy, stop, len) {
        if (!rand(2)) {
            scalex = -scalex
        }
        if (GLOBAL_160 & 0x1) {
            if (animseq == getanim(WILLY_JUMP_FLIP) && animframe >= 1.0 && animframe <= 3.0) {
                playanim2(WILLY_SUPER_SLAM_1, 0.0)
                playanim2(WILLY_SUPER_SLAM_1, 1.0)
                playanim2(WILLY_SUPER_SLAM_1, 1.0)
            }
            else if (animseq == getanim(WILLY_JUMP_FLIP) && animframe <= 6.0) {
                playanim2(WILLY_SUPER_SLAM_2, 0.0)
                playanim2(WILLY_SUPER_SLAM_2, 1.0)
                playanim2(WILLY_SUPER_SLAM_2, 1.0)
            }
            else if (animseq == getanim(WILLY_JUMP_FLIP) && animframe <= 9.0) {
                playanim2(WILLY_SUPER_SLAM_3, 0.0)
                playanim2(WILLY_SUPER_SLAM_3, 1.0)
                playanim2(WILLY_SUPER_SLAM_3, 1.0)
            }
            else {
                playanim2(WILLY_SUPER_SLAM_4, 0.0)
                playanim2(WILLY_SUPER_SLAM_4, 1.0)
                playanim2(WILLY_SUPER_SLAM_4, 1.0)
            }
            do {
                setanim(WILLY_FACE_SLAM_1)
                playframe(0.0)
            } while (1)
        }
        else {
            if (animseq == getanim(WILLY_JUMP_FLIP) && animframe >= 1.0 && animframe <= 3.0) {
                playanim2(WILLY_FACE_SLAM_2, 0.0)
                playanim2(WILLY_FACE_SLAM_2, 1.0)
                playanim2(WILLY_FACE_SLAM_2, 1.0)
            }
            else if (animseq == getanim(WILLY_JUMP_FLIP) && animframe <= 6.0) {
                playanim2(WILLY_FACE_SLAM_3, 0.0)
                playanim2(WILLY_FACE_SLAM_3, 1.0)
                playanim2(WILLY_FACE_SLAM_3, 1.0)
            }
            else if (animseq == getanim(WILLY_JUMP_FLIP) && animframe <= 9.0) {
                playanim2(WILLY_FACE_SLAM_4, 0.0)
                playanim2(WILLY_FACE_SLAM_4, 1.0)
                playanim2(WILLY_FACE_SLAM_4, 1.0)
            }
            else {
                playanim2(WILLY_FACE_SLAM_5, 0.0)
                playanim2(WILLY_FACE_SLAM_5, 1.0)
                playanim2(WILLY_FACE_SLAM_5, 1.0)
            }
            do {
                setanim(WILLY_FACE_SLAM_1)
                playframe(0.0)
            } while (1)
        }
    }
    trans {
        once {
            onstateexit(StopAndRestoreControl)
            vely = vy
            roty = troty
            if (stop) {
                ResetSpeed()
            }
            mem47 = 0
        }
        if (vely <= 0) {
            broadcastevent(EventSlamHit, 1, 100)
            if (eventaccepted) {
                sounddecay(0xFA)
                soundpitch((0x4CC + (rand(3.2) + (0.8 * (BounceCombo - 1.0) >> 8))) * 0.23 >> 8)
                soundplay([bnk0A], 0.7V)
                return
            }
        }
        if (STATUS_GROUNDLAND) {
            hpc = 0
            changestate(Willy_Slam_Land, len, 0)
        }
        if (GLOBAL_160 & 0x1) {
            mem47 = spd(mem47, 3000deg)
            troty = spd(troty, mem47)
            roty = troty
            if (vely > 0) {
                vely = spd(vely, 16m)
            }
            else {
                vely = -30m
            }
        }
    }
}

state Willy_Slam_Land { // 87
    stateflag 0x80005
    statusc 0xF0000000
    __transargs
    code(len, quiet) {
        playframes(WILLY_FACE_SLAM_1, 1.0, 4.0)
        WaitFrame(len)
        playframes(WILLY_FACE_SLAM_RECOVER, 0.0, 12.0)
        changestate(Willy_Idle)
    }
    event(e, a) {
        rejevret(e == Event47)
        if (e == Event58 && !(LEVEL == LEVEL_HighTime || LEVEL == LEVEL_HangEmHigh)) {
            statusc = 0
        }
    }
    trans {
        once {
            onstateexit(StopAndRestoreControl)
            GLOBAL_101 = 2
            GLOBAL_100 = 0xFF
            if (groundvel < -10m && y > GLOBAL_118) {
                spawn(9, 2, 1, -1.0, 7.0, groundvel + 8m)
            }
            if (collider, vely <= 0, statusa & 0x4000, !(statusa & 0x40000)) {
                sendevent(EventSlamHit, collider, 100)
                changestateif(Willy_Bounce, eventaccepted) 
            }
            DoubleJumpUsed = 0
            ResetCombos()
            soundpitch((0xA8F + rand(3.2)) * 0.23 >> 8)
            sounddecay(0x90)
            soundplay(SOUND_LAND_DEFAULT, 1V)
            ResetSpeed()
            statusb &= ~FLAG_DPAD_CONTROL
            if (GLOBAL_160 & 0x1 && !quiet) {
                spawn(9, 43, 1, 0.5m, 0x80, 0x60, 0, 20.0, 1, 0)
                if (!SHAKEY) {
                    SHAKEY = 10.0
                }
            }
            if (!SHAKEY) {
                SHAKEY = 3.0
            }
        }
        if (statusa \ 0x2040000) {
            stateflag &= ~0x80000
        }
        if (!(frametime - statetime >= 0.1s)) {
            broadcastevent(EventSlamHit, 1, 100)
            if (eventaccepted) {
                sounddecay(0xFA)
                soundpitch((4.8 + (rand(3.2) + (0.8 * (BounceCombo - 1.0) >> 8))) * 0.23 >> 8)
                soundplay([bnk0A], 0.7V)
            }
        }
        CheckFall(0.3334s)
    }
}

state Willy_Slide_Spin { // 88
    stateflag 0x80051
    code => state Willy_Spin
    event => sub SpinEvent
    trans => sub UpdateSpin
}

sub PlayJumpStart(vy) { // S-2840
    SoundJumpDefault(14.4, 0.205, 0.25, 0.1V)
    vely = vy
    onstateexit(ResetStance)
    statusc &= ~0x3
    if (animseq == getanim(WILLY_EDGE_1)) {
        playanim2(WILLY_EDGE_4, 0)
        playanim2(WILLY_EDGE_4, 1.0)
        setanim(WILLY_JUMP_START)
    }
    else {
        playframes(WILLY_JUMP_START, 0.0, 2.0)
    }
    statusc &= ~0x100000
    field_60 = -91.0
    playframe(3.0)
    do {
        field_60 = -91.0
        playframe(animframe, 52)
    } while (1)
}

state Willy_Jump_Start { // 89
    stateflag 0x9
    statusc 0x100001
    code => sub PlayJumpStart
    trans => sub UpdateJumpStart
}

sub UpdateJumpStart() { // S-2875
    UpdateJumpCommon()
    unless (dirhold(PAD_NONE)) {
        settrans(UpdateJumpFlip)
    }
    changestateif(Willy_Jump_Up, vely < 11m)
}

sub UpdateJumpUpright() { // S-2882
    UpdateJumpCommon()
    changestateif(Willy_Jump_Up, vely < 11m)
}

sub UpdateJumpFlip() { // S-2886
    UpdateJumpCommon()
    changestateif(Willy_Jump_Flip, vely < 11m)
}

sub UpdateJumpCommon() { // S-2890
    CheckSpin(7, Willy_Spin_Air_Start)
    changestateif(Willy_Slam, buttonbuffer(PAD_CIRCLE | PAD_R1) && (vely < 6m && vely > -6m), 8.94427m, 1, 10, 0)
    if ((buttonbuffer(PAD_X) && (!(statusa & 0x80) || statusa & 0x100000)) && GLOBAL_160 & 0x2 && !DoubleJumpUsed && vely < 8m && vely > -8m && !(statusa & 0x20)) {
        ResetSpeed()
        DoubleJumpUsed = 1.0
        changestate(Willy_Jump_Double, 11.31371m)
    }
    changestateif(Willy_Land, STATUS_GROUNDLAND)
    if (buttonhold(PAD_X) && (!(statusa & 0x80) || statusa & 0x100000)) {
        if (vely > 0) {
            vely = spd(vely, 14m)
        }
        else {
            vely = spd(vely, 7m)
        }
    }
    unless ((buttonhold(PAD_X) && (!(statusa & 0x80) || statusa & 0x100000)) || vely > 10m || stateflag & 0x80) {
        settrans(UpdateJumpUpright)
    }
}

state Willy_Jump_High { // 90
    stateflag 0x9
    statusc 0x1
    code(vy) {
        SoundJumpDefault(14.4, 0.205, 0x40, 0x666)
        if (statusa & 0x2000000) {
            speed = 7m
        }
        vely = vy
        onstateexit(ResetStance)
        if (!rand(2)) {
            scalex = -scalex
        }
        statusc &= ~0x3
        playframes(WILLY_JUMP_HIGH, 0.0, 3.0)
        PlayHighJump()
    }
    trans {
        CheckSpin(7, Willy_Spin_Air_Start)
        changestateif(Willy_Land, STATUS_GROUNDLAND)
        if ((buttonbuffer(PAD_X) && (!(statusa & 0x80) || statusa & 0x100000)) && GLOBAL_160 & 0x2 && !DoubleJumpUsed && vely < 8m && vely > -8m && !(statusa & 0x20)) {
            ResetSpeed()
            DoubleJumpUsed = 1.0
            changestate(Willy_Jump_Double, 11.31371m)
        }
        if (buttonhold(PAD_X) && (!(statusa & 0x80) || statusa & 0x100000)) {
            vely = spd(vely, 8m)
        }
        if (collider, vely <= 0) {
            sendevent(EventJumpedOn, collider, BounceCombo)
            if (eventaccepted) {
                BounceCombo += 1.0
                changestate(Willy_Bounce)
            }
        }
    }
}

sub PlayHighJump() { // S-3057
    statusc &= ~0x100000
    setevent(AirborneEvent)
    playframe(3.0, 2)
    while (vely >= 11m) {
        playframe(3.0)
    }
    playframes(4.0, 17.0)
    do {
        setanim(WILLY_JUMP_FLIP)
        playframe(13.0, 52)
    } while (1)
}

state Willy_Jump_Double { // 91
    stateflag 0x4000009
    statusc 0x1
    trans => state Willy_Jump_High
    code(vy) {
        SoundJumpDefault(14.4, 0.205, 0x40, 0x666)
        vely = vy
        onstateexit(ResetStance)
        if (!rand(2)) {
            scalex = -scalex
        }
        spawn(9, 2, 1, -1.0, 5.0, 8m) // PartC-2
        statusc &= ~0x3
        if (animseq == getanim(WILLY_JUMP_FLIP)) {
            statusc &= ~0x100000
            setevent(AirborneEvent)
            PlayJumpFlip()
            PlayFall()
        }
        else {
            setanim(WILLY_DOUBLE_JUMP)
            PlayHighJump()
        }
    }
}

state Willy_Jump_Run { // 92
    stateflag 0x9
    statusc 0x100001
    trans => sub UpdateJumpStart
    code(vy) {
        if (GLOBAL_160 & 0x10 && buttonhold(PAD_R2)) {
            stateflag = (stateflag & 0xFFFFFFF) | 0x30000000
        }
        else {
            stateflag &= 0xFFFFFFF
        }
        SoundJumpDefault(14.4, 0.205, 0x40, 0x666)
        vely = vy
        onstateexit(ResetStance)
        statusc &= ~0x3
        if (animseq == getanim(WILLY_RUN)) {
            if (animframe <= 1.0 || animframe == 16.0) {
                playanim2(WILLY_JUMP_RUN_1, 0.0)
                playanim2(WILLY_JUMP_RUN_1, 1.0)
                playanim2(WILLY_JUMP_RUN_1, 1.0)
            }
            else if (animframe == 2.0 || animframe == 15.0) {
                playanim2(WILLY_JUMP_RUN_1, 1.0)
                setanim(WILLY_JUMP_RUN_1)
                playanim2(WILLY_JUMP_RUN_1, 2.0)
            }
            else if (animframe <= 6.0) {
                playanim2(WILLY_JUMP_RUN_2, 0.0)
                playanim2(WILLY_JUMP_RUN_2, 1.0)
            }
            else if (animframe == 7.0 || animframe == 10.0) {
                scalex = -abs(scalex)
                playanim2(WILLY_JUMP_RUN_1, 1.0)
                setanim(WILLY_JUMP_RUN_1)
                playanim2(WILLY_JUMP_RUN_1, 2.0)
            }
            else if (animframe <= 9.0) {
                scalex = -abs(scalex)
                playanim2(WILLY_JUMP_RUN_1, 0.0)
                playanim2(WILLY_JUMP_RUN_1, 1.0)
                playanim2(WILLY_JUMP_RUN_1, 1.0)
            }
            else if (animframe <= 14.0) {
                scalex = -abs(scalex)
                playanim2(WILLY_JUMP_RUN_2, 0.0)
                playanim2(WILLY_JUMP_RUN_2, 1.0)
            }
        }
        else {
            playanim2(WILLY_JUMP_RUN_1, 0.0)
            playanim2(WILLY_JUMP_RUN_1, 1.0)
            playanim2(WILLY_JUMP_RUN_1, 1.0)
        }
        scalex = abs(scalex)
        statusc &= ~0x100000
        do {
            field_60 = -91.0
            setanim(WILLY_JUMP_START)
            playframe(3.0, 52)
        } while (1)
    }
}

state Willy_Jump_Up { // 93
    stateflag 0x100009
    statusc 0x0
    event => sub AirborneEvent
    trans => sub UpdateAirborne
    code() {
        playframes(WILLY_JUMP_UP, 0.0, 11.0)
        PlayFall()
    }
}

sub PlayJumpFlip() { // S-3217
    playframes(WILLY_JUMP_FLIP, 0.0, 12.0)
}

sub PlayFall() { // S-3344
    do {
        field_60 = 0xFC700
        playanim2(WILLY_JUMP_FLIP, 13.0)
    } until (spd(y, vely) <= field_63) 
    field_60 = 0xFC700
    playanim2(WILLY_JUMP_LAND, 0.0)
    do {
        field_60 = 0xFC700
        playframe(animframe, 52)
    } while (1)
}

state Willy_Falling { // 94
    stateflag 0x100009
    statusc 0x0
    code => sub PlayFall
    event => sub AirborneEvent
    trans => sub UpdateAirborne
}

state Willy_Jump_Flip { // 95
    stateflag 0x100009
    statusc 0x0
    event => sub AirborneEvent
    trans => sub UpdateAirborne
    code() {
        onstateexit(ResetStance)
        PlayJumpFlip()
        PlayFall()
    }
}

sub AirborneEvent(e, a) { // S-3229
    if (interrupter) {
        rejevret(vely < 0 && (e == EventHit || e == Event14 || e == Event20 || e == Event35 || e == Event30 || e == Event31 || e == Event63 || e == Event62 || e == Event74) && !(interrupter -> statusc & 0x2))
    }
    rejevret(e == Event47)
}

sub UpdateAirborne() { // S-3256
    if (collider, vely <= 0) {
        sendevent(EventJumpedOn, collider, BounceCombo)
        if (eventaccepted) {
            BounceCombo += 1.0
            changestate(Willy_Bounce)
        }
    }
    changestateif(Willy_Land, STATUS_GROUNDLAND)
    CheckSpin(7, Willy_Spin_Air_Start)
    changestateif(Willy_Slam, buttonbuffer(PAD_CIRCLE | PAD_R1) && (vely < 6m && vely > -6m), 8.94427m, 1, 10, 0)
    if ((buttonbuffer(PAD_X) && (!(statusa & 0x80) || statusa & 0x100000)) && GLOBAL_160 & 0x2 && !DoubleJumpUsed && vely < 8m && vely > -8m && !(statusa & 0x20)) {
        ResetSpeed()
        DoubleJumpUsed = 1.0
        changestate(Willy_Jump_Double, 11.31371m)
    }
    if (buttonhold(PAD_X) && (!(statusa & 0x80) || statusa & 0x100000)) {
        if (vely > 0) {
            vely = spd(vely, 14m)
        }
        else {
            vely = spd(vely, 7m)
        }
    }
    if (GLOBAL_160 & 0x10 && buttonhold(PAD_R2)) {
        stateflag = (stateflag & 0xFFFFFFF) | 0x30000000
    }
    else {
        stateflag &= 0xFFFFFFF
    }
}

state Willy_Rise { // 96
    stateflag 0x9
    statusc 0x0
    trans => sub UpdateJumpStart
    code() {
        onstateexit(ResetStance)
        do {
            field_60 = -91.0
            setanim(WILLY_JUMP_START)
            playframe(3.0, 52)
        } while (1)
    }
}

state Willy_Bounce_External { // 97
    stateflag 0x908
    statusc 0x100801
    trans => sub UpdateJumpStart
    code(vy) {
        BounceCombo += 1.0
        DoubleJumpUsed = 0
        PlayJumpStart(vy)
    }
    event(e, a) {
        rejevret(vely > 0 && (e == Event21 || e == Event75))
    }
}

state Willy_Spin_Forced { // 98
    stateflag 0x908
    statusc 0x100800
    code(vy) {
        InitSpin()
        do (var i = 0) {
            AddSpinPulse()
        } while ({ i += 1.0 }; i < 4.0)
        changestate(Willy_Spin_Air, vy)
    }
}

state Willy_Pushed { // 99
    stateflag 0x807
    statusc 0x800
    code(yaw, vspd) {
        onstateexit(ResetMovement)
        troty = yaw
        trotx = abs(degdist(roty, troty)) * 3
        statusb |= FLAG_ROT_Y
        speed = vspd
        statusb &= ~FLAG_DPAD_CONTROL
        setvel()
        playanim2(WILLY_PUSHED, 0.0)
        playanim2(WILLY_PUSHED, 1.0)
        playanim2(WILLY_PUSHED, 2.0)
        playanim2(WILLY_PUSHED, 3.0)
        playanim2(WILLY_PUSHED, 4.0)
        playanim2(WILLY_PUSHED, 4.0)
        playanim2(WILLY_PUSHED, 5.0)
        playanim2(WILLY_PUSHED, 6.0)
        changestate(Willy_Land)
    }
    event(e, a) {
        accevcstate(Willy_Land, e == Event21)
    }
}

state Willy_Hold { // 100
    stateflag 0x10805
    statusc 0x800
    code() {
        onstateexit(ResetMovement)
        speed = 0
        SetVel(0)
        statusb &= ~FLAG_DPAD_CONTROL
        sleepframes(WILLY_STAND_1, 0.0, 19.0)
    }
    event(e, a) {
        accevcstate(Willy_Idle, e == Event21)
    }
}

#module [Wil3C] // 2014I
#purge 3467
state Willy_Mine_Launch { // 101
    stateflag 0x80D08
    statusc 0xF0000000
    event => state Willy_Slam
    __transargs
    code(vy, vspd, yaw) {
        playframes(WILLY_MINE, 0.0, 17.0)
        do {
            playanim2(WILLY_MINE, 18.0, 52)
        } while (1)
    }
    trans {
        once {
            sendevent(EventHit, creator, 100.0)
            if (eventaccepted) {
                stateflag &= ~0x8000000
            }
            else {
                changestate(Willy_Death_Fire, 100.0)
            }
            onstateexit(StopAndRestoreControl)
            statusa &= ~FLAG_GROUNDLAND
            vely = vy
            troty = yaw
            roty = troty
            setvel(vspd)
            GLOBAL_101 = 25
            GLOBAL_100 = 0xFF
        }
        if (collider, vely <= 0) {
            sendevent(EventSlamHit, collider, 100)
            if (eventaccepted) {
                sounddecay(0xFA)
                soundpitch((0x72B + (rand(3.2) + (0xCC * (BounceCombo - 1.0) >> 8))) * 0.23 >> 8)
                soundplay([bnk0A], 0.7V)
                collider -> statusb &= ~FLAG_COLLIDABLE
                return
            }
        }
        if (STATUS_GROUNDLAND || (vely < 0 && spd(y, vely) <= field_63)) {
            hpc = 0
            changestate(Willy_Mine_Land, 2)
        }
        if (vely > 0 && !time(2)) {
            spawn(9, 21, 1, 0, 0, -4m, 0, 2S, 2.4, 24, 1)
        }
    }
}

state Willy_Mine_Land { // 102
    stateflag 0x80005
    statusc 0xF0000000
    trans => state Willy_Slam_Land
    code() {
        unless (STATUS_GROUNDLAND) {
            playanim2(WILLY_MINE, 18.0)
            unless (STATUS_GROUNDLAND) {
                playanim2(WILLY_MINE, 19.0)
            }
        }
        GLOBAL_101 = 2
        GLOBAL_100 = 0xFF
        spawn(9, 2, 1, 0, 0x500, 4m)
        playframes(WILLY_MINE, 20.0, 25.0)
        changestate(Willy_Idle)
    }
}
#module default

state Willy_Trans_Elevator { // 103
    stateflag 0x10908
    statusc 0x923
    __transargs
    trans => sub UpdateElevatorTrans
    code(catcher, pointer, mode, tx, ty, tz, obj) {
        onstateexit(ResetMovement)
        statusb &= ~(FLAG_PHYSICS_TEST | FLAG_HAS_SHADOW)
        statusb |= FLAG_SOLID_GROUND
        mem47 = 0
        if (mode == 1.0) {
            stateflag |= 0x100000
        }
        player = obj
        if (player) {
            mem35 = player -> x
            mem37 = player -> z
            groundy = player -> y
        }
        ResetSpeed()
        BounceCombo += 1.0
        vely = 0
        SoundJumpDefault(14.4, 0.205, 0x40, 0x666)
        if (BONUSSTATE == BONUS_CURRENT) {
            SetBonusState(BONUS_COMPLETED)
        }
        ins72(0x200, 0x2000)
        do {
            PlayMoveFrame()
        } until (mem47)
        ins72(0, pointer)
        if (mode == 2.0) {
            mem47 = 0
            do {
                PlayMoveFrame()
            } until (mem47)
            ins72(0, pointer)
        }
        if (mode == 0 || mode == 2.0) {
            x = tx + vecx
            z = tz + vecz
            y = ty
            ins72(0x400, 0x100)
            save (statusb) {
                statusb &= ~(FLAG_PHYSICS_TEST | FLAG_GRAVITY | FLAG_PHYSICS_ENGINE | FLAG_DPAD_CONTROL)
                tpc = 0
                do {
                    player = objectget(catcher)
                    playnull()
                } until (player)
                mem47 = 0
                sendevent(EventTriggered, player)
                mem35 = player -> x
                mem37 = player -> z
                settrans(UpdateElevatorTrans)
                playnull()
                playnull()
            }
        }
        else {
            mem47 = 0
        }
        do {
            PlayMoveFrame()
        } until (mem47)
        ins72(0x300, 0x2000)
        ins72(0x100, 0x100)
        statusc &= ~0x101
        statusa |= FLAG_GROUNDLAND
        groundtime = frametime
        changestate(Willy_Idle)
    }
    event(e, a) {
        if (e == EventTriggered) {
            if (mode == 0) {
                player = 0
            }
            mem47 = 1.0
        }
    }
}

sub UpdateElevatorTrans(catcher, pointer, mode, tx, ty, tz, obj) __trans { // S-3534
    nofirst {
        if (player) {
            y = player -> y
            groundy = y
            x += player -> x - mem35
            vecx = x - player -> x
            if (vecx < -0.3m) {
                velx = 0
                x = player -> x - 0.3m
            }
            if (vecx > 0.3m) {
                velx = 0
                x = player -> x + 0.3m
            }
            mem35 = player -> x
            z += player -> z - mem37
            vecz = z - player -> z
            if (vecz < -0.3m) {
                velz = 0
                z = player -> z - 0.3m
            }
            if (vecz > 0.3m) {
                velz = 0
                z = player -> z + 0.3m
            }
            mem37 = player -> z
            if (player -> zindex < -10) {
                zindex = player -> zindex
            }
            else {
                zindex = player -> zindex + (CAMTRANSY - y) / 12.0
            }
        }
    }
}

state Willy_Trans_Warp { // 104
    stateflag 0x908
    statusc 0x902
    code(tx, ty, tz) {
        if (eventreceived == Event70) {
            TriggerBonus()
        }
        x = tx
        velx = 0
        y = ty
        vely = 0
        z = tz
        velz = 0
        ins72(0x400, 0x100)
        ins72(0x100, 0x100)
        changestate(Willy_Falling_Transition)
    }
}

state Willy_Hit { // 105
    stateflag 0x9
    statusc 0x403
    trans => sub UpdateJumpStart
    code() {
        soundpitch((14.4 + rand(3.2)) << 6 >> 8)
        sounddecay(0.625)
        soundplay([yip0A], 1.0V)
        SoundJumpDefault(14.4, 0.205, 0x40, 0x666)
        GLOBAL_75 = 50
        GLOBAL_65 = -0x77777778
        unless (statusa & 0x80) {
            vely = 12.64912m
        }
        onstateexit(ResetStance)
        field_60 = -91.0
        playanim2(WILLY_JUMP_FLIP, 13.0)
        statusc &= ~0x1
        do {
            field_60 = -91.0
            playframe(animframe, 52)
        } while (1)
    }
    event(e, a) {
        if (invincible == 5) {
            rejevret(e == EventHit)
            rejevret(e == Event30)
            rejevret(e == Event63)
            rejevret(e == Event14)
            rejevret(e == Event20)
            rejevret(e == Event25)
            rejevret(e == Event24)
            rejevret(e == Event35)
            rejevret(e == Event44)
            rejevret(e == Event61)
        }
    }
}

state Willy_Falling_Transition { // 106
    stateflag 0x9
    statusc 0x0
    event => sub AirborneEvent
    code() {
        onstateexit(ResetMovement)
        statusb &= ~FLAG_DPAD_CONTROL
        do {
            field_60 = 0xFC700
            setanim(WILLY_JUMP_FLIP)
            playframe(13.0, 52)
        } while (1)
    }
    trans {
        changestateif(Willy_Land, !STATUS_FIRSTFRAME && STATUS_GROUNDLAND)
    }
}

state Willy_Land { // 107
    stateflag 0x5
    statusc 0x0
    code() {
        onstateexit(StopAndRestoreControl)
        statusb &= ~FLAG_DPAD_CONTROL
        playanim2(WILLY_JUMP_LAND, 2.0)
        playframes(3.0, 7.0)
        if (statusa & 0x2000000) {
            playframes(WILLY_ICE_5, 0.0, 11.0)
        }
        else {
            playframes(7.0, 19.0)
        }
        changestate(Willy_Idle)
    }
    trans {
        once {
            changestateif(Willy_Slam_Land, groundvel < -27m, 0, 1.0)
            if (groundvel < -10m && y > GLOBAL_118 && !(statusa & 0x800000)) {
                spawn(9, 2, 1, -1.0, 5.0, groundvel + 8m) // PartC-2
            }
            if (collider, vely <= 0, statusa & 0x4000, !(statusa & 0x40000)) {
                sendevent(EventJumpedOn, collider, 100)
                changestateif(Willy_Bounce, eventaccepted)
            }
            DoubleJumpUsed = 0
            ResetCombos()
            soundpitch((14.4 + rand(3.2)) * 0.23 >> 8)
            sounddecay(0.5625)
            soundplay(SOUND_LAND_DEFAULT, 0.3V)
            if (GLOBAL_119 & 0x800 && !(statusa & 0x2000000) && statusa & 0x40000) {
                spawn(88, 13, 1, 0.2m, roty, abs(scalex) / 3)
            }
            if (GLOBAL_119 & 0x800 && !(statusa & 0x2000000) && statusa & 0x40000) {
                spawn(88, 13, 1, -0.2m, roty, abs(scalex) / -3)
            }
        }
        CheckJump(Willy_Jump_Start, 10.469m)
        CheckSpin(7, Willy_Spin_Start)
        CheckSlide(Willy_Slide)
        changestateifn(Willy_Move, dirhold(PAD_NONE))
        CheckFall(0.3334s)
        unless (statusa & 0x2000000) {
            ResetSpeed()
        }
    }
}

state Willy_Bounce { // 108
    stateflag 0x89
    statusc 0x100003
    code() {
        PlayJumpStart(14.20141m)
    }
    trans {
        once {
            DoubleJumpUsed = 0
            sounddecay(0x90)
            soundpitch((14.4 + (rand(3.2) + (1.6 * (BounceCombo - 1.0) >> 8))) * 0.23 >> 8)
            soundplay([bnk0A], 0.4V)
        }
        settrans(UpdateJumpStart)
        UpdateJumpStart()
    }
}

state Willy_Spin_Start { // 109
    stateflag 0x44
    statusc 0x0
    code() {
        InitSpin()
        changestate(Willy_Spin)
    }
}

state Willy_Spin_Air_Start { // 110
    stateflag 0x58
    event => sub SpinEvent
    code() {
        InitSpin()
        changestate(Willy_Spin_Air, 10.469m)
    }
}

state Willy_Spin { // 111
    stateflag 0x50
    event => sub SpinEvent
    trans => sub UpdateSpin
    code() {
        onstateexit(CleanupSpin)
        statusb |= (FLAG_DPAD_CONTROL | 0x2000)
        statusb &= ~FLAG_ROT_Y
        PlaySpin()
        changestate(Willy_Spin_End)
    }
}

sub SpinEvent(e, a) { // S-3841
    if (e == Event42) {
        rejev()
        sendevent(EventSpinHit, interrupter, 1)
    }
    if (e == Event40) {
        rejev()
        save (interrupter) {
            interrupter = a[0]
            sendevent(EventSpinHit, interrupter, 1)
        }
    }
}

sub UpdateSpin() { // S-3854
    sendevent(EventSpinHit, collider, AttackCombo)
    if (eventaccepted) {
        sounddecay(0x90)
        soundpitch((14.4 + (rand(3.2) + (1.6 * AttackCombo >> 8))) * 0.23 >> 8)
        soundplay([sht0A], 0.4V)
        AttackCombo += 1.0
    }
    if (buttonbuffer(PAD_X) && (!(statusa & 0x80) || statusa & 0x100000)) {
        hpc = 0
        changestate(Willy_Spin_Air, 10.469m)
    }
    if (stateflag & 0x80000) {
        rotz = troty
        rotx = 30deg
        spawn(9, 1, 2, -1.0) // PartC-1
    }
    unless (time(3) || statusa & 0x800000) {
        spawn(9, 2, 1, -1.0, 1.0, 1m)
    }
    if (GLOBAL_160 & 0x4) {
        UpdateTornado()
    }
}

sub InitSpin() { // S-3897
    SpinPulseCount = 0
    SpinPulseTime = frametime
    SpinDuration = 10
    TornadoStrength = 0
    AddSpinPulse()
}

sub AddSpinPulse() { // S-3903
    soundpitch(0x3A0)
    sounddecay(0xC8)
    soundplay(SOUND_SPIN_DEFAULT, 0.4V)
    ActionVoice = voice
    if (GLOBAL_160 & 0x4) {
        mem47 = getins(TornadoWaitRelease)
        var0 = abs(TornadoStrength) >> 8
        TornadoStrength = 1.0 * (var0 + 1)
        if (SpinPulseCount >= 1.0) {
            SpinDuration = 10
        }
    }
    else {
        mem47 = 0
    }
    SpinPulseCount += 1.0
}

sub TornadoWaitRelease() { // S-3926
    unless (buttonhold(PAD_SQUARE)) {
        if (SpinPulseCount >= 4.0) {
            mem47 = 0
        }
        else {
            mem47 = getins(TornadoWaitPress)
        }
    }
}

sub TornadoWaitPress() { // S-3935
    if (buttonpress(PAD_SQUARE)) {
        SpinPulseTime = frametime
        voice = ActionVoice
        soundsetup(2, voice, 6)
        soundsetup(0, voice, 3, 0)
        AddSpinPulse()
    }
}

sub UpdateTornado() { // S-3943
    call(mem47)
    if (frametime - SpinPulseTime >= SpinDuration) {
        TornadoStrength = seek(TornadoStrength, 0, spd(4.0))
    }
    scaley = seek(scaley, 1S - ((TornadoStrength * 0x180) >> 8), 0xCC)
    scalez = seek(scalez, 1S + (TornadoStrength << 1), 0xCC)
    if (scalex < 0) {
        scalex = -scalez
    }
    else {
        scalex = scalez
    }
    save (speed, x, y, z, troty) {
        y += 0.5m + rand(1m)
        troty = rand(360deg)
        setvel(3m + (TornadoStrength * 0x12C), vvec)
        spawn(9, 22, 1, vecx, -2m, vecz, sin(90deg - abs(degdist(CAMROTY, troty))) >> 6)
    }
    voice = ActionVoice
    soundpitch(0x199 + abs(TornadoStrength), voice)
    soundcount(2, voice)
    if (vely < -1m) {
        vely = spd(vely, (abs(TornadoStrength) << 11) + 23.8m)
        if (vely > -1m) {
            vely = -1m
        }
    }
}

sub PlaySpin() { // S-4010
    setanim(WILLY_SPIN, 9.0)
    do {
        playframe((animframe + 1.0) % 10.0)
    } until ((abs(TornadoStrength) < 45 || SpinPulseCount <= 1.0) && frametime - SpinPulseTime >= SpinDuration) 
}

state Willy_Spin_Air { // 112
    stateflag 0x58
    statusc 0x43
    event => sub SpinEvent
    code(vy) {
        if (STATUS_GROUNDLAND) {
            vely = vy
            playanim2(WILLY_SPIN, 0.0)
        }
        statusc &= ~0x41
        PlaySpin()
        changestate(Willy_Spin_Air_End)
    }
    trans {
        once {
            onstateexit(CleanupSpin)
            statusb |= (FLAG_DPAD_CONTROL | 0x2000)
            statusb &= ~FLAG_ROT_Y
            AirSpinCount += 1.0
        }
        sendevent(EventSpinHit, collider, AttackCombo)
        if (eventaccepted) {
            sounddecay(0x90)
            soundpitch((0xE66 + (rand(3.2) + (1.6 * AttackCombo >> 8))) * 0.23 >> 8)
            soundplay([sht0A], 0.4V)
            AttackCombo += 1.0
        }
        if (frametime - statetime >= 2 && STATUS_GROUNDLAND) {
            hpc = 0
            changestate(Willy_Spin)
        }
        if ((buttonhold(PAD_X) && (!(statusa & 0x80) || statusa & 0x100000)) && vely > 0) {
            vely = spd(vely, 14m)
        }
        if (GLOBAL_160 & 0x4) {
            UpdateTornado()
        }
    }
}

state Willy_Spin_End { // 113
    statusc 0x0
    code() {
        if (dirhold(PAD_NONE) && STATUS_GROUNDLAND && !(statusa & 0x2000000)) {
            if (!(statusa & 0x2000000)) {
                ResetSpeed()
            }
        }
        changestate(Willy_Idle)
    }
    trans {
        once {
            AttackCombo = 0
        }
        CheckJump(Willy_Jump_Start, 10.469m)
    }
}

state Willy_Spin_Air_End { // 114
    stateflag 0x9
    statusc 0x0
    code() {
        changestate(Willy_Falling)
    }
    trans {
        once {
            AttackCombo = 0
            onstateexit(CleanupSpin)
        }
    }
}

sub TriggerBonus() { // S-4111
    changestateifn(Willy_Death_Fall, BONUSSTATE)
    unless (BONUSSTATE == BONUS_CURRENT || BONUSSTATE == BONUS_COMPLETED) {
        ins72(0x200, 0x2000)
        savecheckpoint((1 << 16) | (1 << 8))
        BONUSSTATE = BONUS_CURRENT
        BonusFruitCount = 0
        BonusLifeCount = 0
        BonusBoxCount = 0
        spawn2(DispC, DispC_S_BONUS_WUMPA_DISPLAY)
        BONUSFRUITCOUNTER = objectspawned
        spawn2(DispC, DispC_S_BONUS_LIFE_DISPLAY)
        BONUSLIFECOUNTER = objectspawned
        spawn2(DispC, DispC_S_BONUS_BOX_DISPLAY)
        BONUSBOXCOUNTER = objectspawned
    }
}

sub SetBonusState(s) { // S-4132
    if (var temp = s; temp == BONUS_COMPLETED) {
        save (BOXCOUNT) {
            BOXCOUNT = BonusBoxCount
            savecheckpoint((2 << 16) | (0 << 8))
        }
        broadcastevent(Event73, 0, s)
    }
    else if (temp == BONUS_KILLED) {
        BONUSDEATHTIME = frametime
        broadcastevent(Event73, 0, s)
    }
    BONUSSTATE = s
}

sub AddFruit(count) { // S-4150
    if (GLOBAL_119 & 0x2000, interrupter, interrupter -> y < 0) {
        BonusFruitCount += count
    }
    else {
        FruitCount += count
        if (FruitCount >= 100.0) {
            save (interrupter) {
                interrupter = FRUITDISPLAY
                sendevent(Event17, interrupter, 1.0)
                FruitCount -= 100.0
            }
        }
    }
}

sub AddLife(count) { // S-4179
    if (GLOBAL_119 & 0x2000, interrupter, interrupter -> y < 0) {
        BonusLifeCount += count
    }
    else {
        LifeCount += count
        if (LifeCount > 99.0) {
            LifeCount = 99.0
        }
    }
}

sub AddBox() { // S-4199
    if (BONUSSTATE == BONUS_CURRENT) {
        BonusBoxCount += 1.0
    }
    else {
        BoxCount += 1.0
        BOXCOUNT = BoxCount
    }
}

sub AddDoctor() { // S-4209
    sendevent(Event15, creator, 4.0)
    if (v0 >= 3.0) {
        invincible = 5
        invincibletime = frametime
        changestateifn(Willy_Get_Invincible, GLOBAL_173, 0)
    }
}

sub WillyPlayInvincible(arg) { // S-4219
    onstateexit(ResetMovement)
    v0 = 10.0
    statusb &= ~(FLAG_DPAD_CONTROL | FLAG_ROT_Y)
    statusb |= FLAG_GRAVITY | FLAG_PHYSICS_ENGINE
    SoundJumpDefault(14.4, 0.205, 0x40, 0x666)
    ResetSpeed()
    vely = 14m
    setanim(WILLY_WITCH_DOCTOR, -1.0)
    do {
        animframe += 1.0
        if (v0) {
            do (var i = 0) {
                spawn(5, 4) // DoctC-4
                i += 1.0
            } while (i < v0 >> 1)
            v0 -= 1.0
        }
        playframe()
    } while (animframe + 1.0 <= 18.0)
}

state Willy_Get_Invincible { // 115
    stateflag 0x8
    statusc 0x422
    code() {
        WillyPlayInvincible(17)
        vely = 0
        statusb |= (FLAG_GRAVITY | FLAG_PHYSICS_ENGINE)
        changestate(Willy_Falling_Transition)
    }
    event(e, a) {
        rejevret(e == Event6 || e == Event40)
    }
}

expr REWARD_POWER = 700.0
expr RELIC_PLATINUM = 600.0
expr RELIC_GOLD = 500.0
expr RELIC_SAPPHIRE = 400.0
expr REWARD_GEM = 300.0
expr REWARD_CRYSTAL = 200.0
expr REWARD_TIME = 110.0

inline sub SetItemPool(id, pool1, pool2) {
    if (var index = id >> 8; index < 32) {
        pool1 = (1 << index) | pool1
    }
    else {
        pool2 = (1 << (index - 32)) | pool2
    }
}

inline sub ClearItemPool(id, pool1, pool2) {
    if (var index = id >> 8; index < 32) {
        pool1 = ~(1 << index) & pool1
    }
    else {
        pool2 = ~(1 << (index - 32)) & pool2
    }
}

sub WillyReward(reward) { // S-4268
    if (var combo = reward; combo == 1.0) {
        spawn2(FruiC, FruiC_S_FRUIT_AUTO, 1, 76.0, 0)
        child -> x = interrupter -> x
        child -> y = interrupter -> y
        child -> z = interrupter -> z
    }
    else if (combo == 2.0) {
        spawn2(FruiC, FruiC_S_FRUIT_AUTO, 1, 94.0, 0)
        child -> x = interrupter -> x
        child -> y = interrupter -> y
        child -> z = interrupter -> z
    }
    else if (combo == 3.0) {
        spawn2(FruiC, FruiC_S_FRUIT_AUTO, 1, 92.0, 0)
        child -> x = interrupter -> x
        child -> y = interrupter -> y
        child -> z = interrupter -> z
    }
    else if (combo == 4.0) {
        spawn2(FruiC, FruiC_S_FRUIT_AUTO, 1, 97.0, 0)
        child -> x = interrupter -> x
        child -> y = interrupter -> y
        child -> z = interrupter -> z
    }

    if (reward >= REWARD_POWER) {
        GLOBAL_160 |= 1 << ((reward - REWARD_POWER) >> 8)
        CollectedReward = reward
    }
    else if (reward >= RELIC_PLATINUM) {
        SetItemPool(reward - RELIC_PLATINUM, GLOBAL_179, GLOBAL_180)
        SetItemPool(reward - RELIC_PLATINUM, GLOBAL_181, GLOBAL_182)
        CollectedReward = RELIC_PLATINUM
    }
    else if (reward >= RELIC_GOLD) {
        ClearItemPool(reward - RELIC_GOLD, GLOBAL_179, GLOBAL_180)
        SetItemPool(reward - RELIC_GOLD, GLOBAL_181, GLOBAL_182)
        CollectedReward = RELIC_GOLD
    }
    else if (reward >= RELIC_SAPPHIRE) {
        SetItemPool(reward - RELIC_SAPPHIRE, GLOBAL_179, GLOBAL_180)
        ClearItemPool(reward - RELIC_SAPPHIRE, GLOBAL_181, GLOBAL_182)
        CollectedReward = RELIC_SAPPHIRE
    }
    else if (reward == 363.0) {
        SetItemPool(reward - REWARD_GEM, SAVEDGEMPOOL1, SAVEDGEMPOOL2)
    }
    else if (reward >= REWARD_GEM) {
        if (reward - REWARD_GEM < 10.0 || reward - REWARD_GEM >= 58.0) {
            CollectedSpecialGem = reward - REWARD_GEM
        }
        else {
            CollectedLevelGem = reward - REWARD_GEM
        }
        SetItemPool(reward - REWARD_GEM, GEMPOOL1, GEMPOOL2)
    }
    else if (reward >= REWARD_CRYSTAL) {
        CrystalCount += 1.0
        SetItemPool(reward - REWARD_CRYSTAL, CRYSTALPOOL1, CRYSTALPOOL2)
        sendeventif(EventWarp, self, LEVEL == LEVEL_RingsOfPower || LEVEL == LEVEL_MadBombers || LEVEL == LEVEL_ByeByeBlimps, 0)
    }
    else if (reward >= REWARD_TIME) {
        save (interrupter) {
            interrupter = GLOBAL_187
            sendevent(EventCombo, interrupter, (reward - REWARD_TIME) >> 8)
        }
    }
}

sub WillyStatus(status) { // S-4504
    if (interrupter) {
        if (var s = status; s == 0) {
            interrupter -> var0 = mem3
        }
        else if (s == 1.0) {
            interrupter -> var0 = 0
        }
        else if (s == 3.0) {
            if (BounceCombo > 0) {
                BounceCombo -= 1.0
            }
        }
        else if (s == 8.0) {
            BounceCombo = 0
        }
        else if (s == 5.0) {
            SetLevelResult(1.0)
        }
        else if (s == 9.0) {
            interrupter -> var0 = mem13
        }
        else if (s == 6.0) {
            SetLevelResult(4.0)
            SUB_5856(LEVEL)
        }
        else if (s == 4.0) {
            save (var0) {
                sendevent(Event15, creator, 4.0)
                interrupter -> var0 = var0
            }
        }
    }
}

state Willy_Restart { // 116
    stateflag 0x0
    statusc 0x1C22
    code(arg) {
        BeginDeath(arg)
        KillBonus()
        if (!FADECONTROL) {
            FadeToBlack()
        }
        while (FADECONTROL != -1 && !(frametime - statetime >= 12)) {
            playframe()
        }
        if (!GLOBAL_173) {
            GLOBAL_173 = 1
        }
        CrashDoRespawn()
    }
}

state Willy_Death_Fall { // 117
    stateflag 0x1009
    statusc 0x1C22
    code(clear) {
        save (vfx) {
            KillBonus()
            vfx &= 0xFFFF00FF
            mem35 = x
            mem36 = y
            mem37 = z
            onstateexit(RestoreAfterHit)
            stateflag |= 0x8000020
            if (clear) {
                GAMEFLAGS &= ~0x2
            }
            statusb &= ~(FLAG_PHYSICS_TEST | FLAG_DPAD_CONTROL | FLAG_HAS_SHADOW)
            sounddecay(7.7s)
            SoundPitchDefault(46)
            soundplay([fal0A], 0.4V)
            soundsetup(0, voice, 5)
            if (LEVEL == LEVEL_MidnightRun || LEVEL == LEVEL_OrientExpress) {
                if (animseq == getanim(SIS_STAND_1) || animseq == getanim(SIS_WALK) || animseq == getanim(SIS_JUMP)) {
                    playanim(14, SIS_JUMP, 4)
                }
                else {
                    playframe(animframe, 4)
                }
            }
            else {
                playframes(WILLY_JUMP_UP, 0.0, 11.0)
            }
            statusb &= ~(FLAG_GRAVITY | FLAG_PHYSICS_ENGINE)
            unless (ZONEFLAGS & 0x400000 || (LEVEL == LEVEL_WarpRoom || LEVEL == LEVEL_MidnightRun || LEVEL == LEVEL_OrientExpress) || rand(4)) {
                soundpitch(3.625)
                soundsetup(0, 9)
                sounddecay(0xFA)
                soundplay(SOUND_LAND_DEFAULT, 1.0V)
                if (!SHAKEY) { 
                    SHAKEY = 3.0
                }
                GLOBAL_101 = 2
                GLOBAL_100 = 0xFF
                spawn(9, 59, 1, mem35, mem36, mem37)
                playnull(31)
            }
            while ((GLOBAL_119 & 0x2000 && BONUSSTATE != BONUS_COMPLETED) && (BONUSSTATE == BONUS_KILLED && !(frametime - BONUSDEATHTIME >= 1.2s))) {
                playnull()
            }
            FadeToBlack()
            WaitFadeNull()
        }
        CrashDoRespawn()
    }
    trans {
        velx = (velx * 0xF3) >> 8
        velz = (velz * 0xF3) >> 8
    }
}

state Willy_Death { // 118
    stateflag 0x22
    statusc 0x1C22
    code(arg) {
        if (interrupter) {
            if (interrupter -> spawn == 0xB0002) {
                if (eventreceived == Event24) {
                    statusc = 0
                    changestate(Willy_Death_Knight, arg)
                }
            }
            else if (interrupter -> spawn == 0xB0000) {
                statusc = 0
                changestate(Willy_Death_Frog, arg)
            }
            else if (interrupter -> spawn == 0x510000) {
                statusc = 0
                changestate(Willy_Death_Giant, arg)
            }
            else if (interrupter -> spawn == 0x190001) {
                statusc = 0
                changestate(Willy_Death_Wizard, arg)
            }
            else if (interrupter -> spawn == 0x270002) {
                statusc = 0
                changestate(Willy_Death_Monkey, arg)
            }
            else if (interrupter -> spawn == 0x390000) {
                statusc = 0
                changestate(Willy_Death_Sarcophagass, arg)
            }
            else if (interrupter -> spawn == 0x390002) {
                statusc = 0
                changestate(Willy_Death_Mummy, arg)
            }
            else if (interrupter -> spawn == 0x250003 || interrupter -> spawn == 0x250007 || interrupter -> spawn == 0x250008) {
                statusc = 0
                changestate(Willy_Death_Dart, arg)
            }
            else if (interrupter -> spawn == 0xB0001) {
                statusc = 0
                changestate(Willy_Death_Goat, arg)
            }
            else if (interrupter -> spawn == 0x100002) {
                statusc = 0
                changestate(Willy_Death_Tery, arg)
            }
            else if (interrupter -> spawn == 0x250004) {
                statusc = 0
                changestate(Willy_Death_Spear, arg)
            }
            else if (interrupter -> spawn == 0x3A0000) {
                statusc = 0
                changestate(Willy_Death_Hang_Fall)
            }
            else if (interrupter -> spawn == 0x3D0000 || interrupter -> spawn == 0x3C0001 || interrupter -> spawn == 0x3C0000) {
                statusc = 0
                changestate(Willy_Death_Knife, arg)
            }
            else if (interrupter -> spawn == 0x410000) {
                statusc = 0
                changestate(Willy_Death_Vase, arg)
            }
            else if (interrupter -> spawn == 0x3B0000) {
                statusc = 0
                changestate(Willy_Death_Genie, arg)
            }
            else if (interrupter -> spawn == 0x520002) {
                statusc = 0
                changestate(Willy_Death_UFO, arg)
            }
            else if (interrupter -> spawn == 0x340002) {
                playframe(animframe, 2)
                statusc = 0
                changestate(Willy_Death_Hide, arg)
            }
            else if (interrupter -> spawn == 0x4C0000 || interrupter -> spawn == 0x530000) {
                statusc = 0
                if (arg == 100.0) {
                    changestate(Willy_Death_Balloon, arg)
                }
                else {
                    changestate(Willy_Death_Fire, arg)
                }
            }
            else if (interrupter -> spawn == 0x5A0002 || interrupter -> spawn == 0x5A0003 || interrupter -> spawn == 0x5A0005 || interrupter -> spawn == 0x590000) {
                statusc = 0
                changestate(Willy_Death_Vaporize_NTropy)
            }
            else if (interrupter -> spawn == 0x4D0006 || interrupter -> spawn == 0x4D000A || interrupter -> spawn == 0x4F0000 || interrupter -> spawn == 0x520000 || interrupter -> spawn == 0x5C0000 || interrupter -> spawn == 0x5C0001) {
                statusc = 0
                if (arg == 100.0) {
                    changestate(Willy_Death_Vaporize, arg)
                }
                else {
                    changestate(Willy_Death_Fire, arg)
                }
            }
            else if (interrupter -> spawn == 0x580006 || interrupter -> spawn == 0x580007) {
                statusc = 0
                changestate(Willy_Death_Freeze, arg)
            }
            else if (interrupter -> spawn == 0x340000) {
                if (var temp = arg; temp == 0) {
                    statusc = 0
                    changestate(Willy_Death_Squash_2, arg)
                }
            }
        }
        if (eventreceived == Event63) {
            settrans(SpawnDeathSmoke)
        }
        TryBeginDeath(arg)
        KillBonus()
        GLOBAL_75 = 25
        GLOBAL_65 = -1
        PlayDeathArg(0.5V)
        if (LEVEL == LEVEL_FutureFrenzy || LEVEL == LEVEL_BossNTropy || LEVEL == LEVEL_GoneTomorrow || LEVEL == LEVEL_FlamingPassion || LEVEL == LEVEL_HighTime || LEVEL == LEVEL_HangEmHigh || LEVEL == LEVEL_DinoMight || LEVEL == LEVEL_BoneYard) {
            FadeOutAndWait()
        }
        else {
            roty = CAMROTY
            playframes(WILLY_DEATH_ANGEL, 0.0, 7.0)
            tpc = 0
            velx = 0
            vely = 1m
            velz = 0
            statusb |= FLAG_PHYSICS_ENGINE
            do (var i = 0) {
                sounddelay(4)
                SoundJumpDefault(14.4, 0.205, 0xC0, 1V)
                sounddelay(4)
                SoundJumpDefault(14.4, 0.205, 0xC0, 1V)
                playframes(WILLY_DEATH_ANGEL, 7.0, 33.0)
            } while ({ i += 1.0 }; i < 3.0)
            FadeToBlack()
            playframes(7.0, 14.0)
            WaitFadeFrame()
        }
        CrashDoRespawn()
    }
    event(e, a) {
        rejevret(e == Event18)
    }
}

