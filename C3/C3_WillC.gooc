#module [Wil5C] // 2006I
#purge 5
state Coco_Spaceship_Init { // 37
    stateflag 0xD2000005
    statusc 0x0
    code() {
        statusb = 0
        GAMEFLAGS &= ~0x1
        GAMEFLAGS |= 0x20000000
        vfx = (vfx & 0xFFFFFF00) | 0x5
        trotx = 360deg
        rotx = 0
        roty = 180deg
        troty = roty
        rotz = 0
        SetVel(0, 0, 0)
        y = (mem38 + mem39) >> 1
        zindex = 0
        health = 100.0
        field_63 = 0
        mem48 = 0
        speed = -24m
        SetVec(x, y, z)
        vecy = 26m
        field_60 = 0
        field_61 = 0
        field_62 = 0
        soundpitch(0x4B7)
        sounddecay(0xFD)
        soundplay([CBl5A], 0xFFF)
        ActionVoice = voice
        spawn2(24, 2, 1, 0, 0, 0, 0)
        player = objectspawned
        changestate(Coco_Spaceship_Fly)
    }
}

state Coco_Spaceship_Fly { // 38
    stateflag 0xD2000005
    statusc 0x0
    code() {
        setanim(SIS_SPACESHIP, 9.0)
        do {
            animframe = 9.0 + ((velx * 9.0) / 2800.0)
            if (animframe < 0) {
                animframe = 0
            }
            else if (animframe > 17.0) {
                animframe = 17.0
            }
            playframe()
        } while (1)
    }
    event(e, a) {
        if (e == Event19 || e == Event80) {
            StopSpaceshipSound()
        }
        accevcstate(Coco_Spaceship_Finish, e == Event22)
        rejevret(e == Event34 || e == Event21)
        if (e == EventHit) {
            accev()
            spawn(24, 7, 1, interrupter)
            health -= a[0]
            GLOBAL_75 = 5
            GLOBAL_65 = -1
            GLOBAL_101 = (a[0] >> 1) * 1
            GLOBAL_100 = 0xCC
            if (health <= 0) {
                if (GAMEFLAGS & -0x80000000) {
                    health = 1.0
                }
                else {
                    health = 0
                    accevcstate(Coco_Spaceship_Death)
                }
            }
        }
        if (e == Event58) {
            accev()
            if (!field_63) {
                spawn(24, 4)
                field_63 = objectspawned
            }
        }
    }
    trans {
        vecz = spd(vecz, speed)
        {
            var sx = GLOBAL_161
            var sy = -GLOBAL_162
            if (abs(sx) < 40) {
                sx = 0
            }
            if (abs(sy) < 40) {
                sy = 0
            }
            rotz = seek(rotz, sx * -3, (degdist(rotz, sx * -4) >> 4) * 30 / 25)
            roty = troty + rotz
            rotx = seek(rotx, sy * -3, (degdist(rotx, sy * -4) >> 4) * 30 / 25)
            {
                var damp = 1.0 - spd(0x179)
                velx = spd(velx, (sx * 20m) >> 7)
                velx = (velx * damp) >> 8
                if (velx < -7m) {
                    velx = -7m
                }
                else if (velx > 7m) {
                    velx = 7m
                }
                vely = spd(vely, (sy * 20m) >> 7)
                vely = (vely * damp) >> 8
                if (vely < -4m) {
                    vely = -4m
                }
                else if (vely > 4m) {
                    vely = 4m
                }
            }
            field_60 = spd(field_60, velx)
            if (field_60 < -5m) {
                var0 = ((field_60 + 5m) * 0xAF) / 0
                if (velx < -var0) {
                    velx = -var0
                }
            }
            else if (field_60 > 5m) {
                var0 = ((5m - field_60) * 0xAF) / 0
                if (velx > var0) {
                    velx = var0
                }
            }
            field_61 = spd(field_61, vely)
            if (field_61 < -3m) {
                var0 = ((field_61 + 4m) * 0x64) / 25
                if (vely < -var0) {
                    vely = -var0
                }
            }
            else if (field_61 > 3m) {
                var0 = ((4m - field_61) * 0x64) / 25
                if (vely > var0) {
                    vely = var0
                }
            }
            save (trotx, troty, trotz, vecx, vecy, vecz) {
                SetTRot(0, 0, 0)
                vectransf2(vvec, vtrans, 0, field_60, field_61)
            }
        }
        save (vecx, vecy, vecz) {
            vectransf(vtrans, vvec, 1m, 0, 0)
            mem38 = (vecx - x) >> 1
            mem39 = (vecy - y) >> 1
            mem40 = vecz - z
            interrupter = GLOBAL_126
            if (interrupter) {
                var0 = interrupter -> groundy
            }
            else {
                var0 = 15m
            }
            var0 /= 1m
            sendevent(Event50, player, mem38 * var0, mem39 * var0, mem40 * var0)
        }
        if (buttonhold(PAD_R1) || buttonhold(PAD_CIRCLE)) {
            stateflag |= 0x40
            if (frametime - mem48 >= 2) {
                mem48 = frametime
                spawn(24, 1, 1, 0, (mem38 << 1) * 25, (mem39 << 1) * 25, ((mem40 << 1) * 25) + speed, 1.0)
            }
        }
        else {
            stateflag &= ~0x40
        }
        if (SFXVOL) {
            if (ActionVoice > 0) {
                sp = ActionVoice
                soundcheck(sp)
            }
            else {
                misc = -1
            }
            if (misc != -1) {
                voice = ActionVoice
                soundsetup(0xFFF, voice, 0, 0)
            }
            else {
                soundpitch(0x4B7)
                sounddecay(0xFD)
                soundplay([CBl5A], 0xFFF)
                ActionVoice = voice
            }
        }
        else {
            voice = ActionVoice
            soundsetup(2, voice, 6)
            soundsetup(0, voice, 3, 0)
        }
    }
}

sub StopSpaceshipSound() { // E5S-300
    if (ActionVoice) {
        voice = ActionVoice
        soundsetup(25, voice, 0, 6)
        soundsetup(0, voice, 3, 0)
        ActionVoice = 0
    }
}

state Coco_Spaceship_Death { // 39
    stateflag 0xD2000022
    statusc 0x1402
    code(arg) {
        BeginDeath(arg)
        KillBonus()
        GAMEFLAGS |= 0x2
        soundpitch((0x999 + rand(3.2)) * 0x4B >> 8)
        soundplay([VL2jA], 1V)
        trotz = 0
        speed = 0
        do {
            speed = seek(speed, 1.6m, 0.016m)
            vecx = degdist(rotx, 70deg) >> 3
            if (abs(vecx) > 23) {
                if (vecx >= 0) {
                    vecx = 23
                }
                else {
                    vecx = -23
                }
            }
            rotx += vecx
            trotz += 6
            if (trotz > 14.4deg) {
                trotz = 14.4deg
            }
            rotz = (rotz + trotz) % 360deg
            vectransf(vtrans, vtrans, speed, 0, 0)
            if (!(frametime & 1)) {
                spawn(9, 21, 1, 2.0, 0, 4m, 0, 1S, 2.4, 24, 1)
            }
            playframe()
        } until (y <= 0)
        StopSpaceshipSound()
        GLOBAL_75 = 0x64
        GLOBAL_65 = -1
        GLOBAL_101 = 0x64
        GLOBAL_100 = 0xFF
        do (var start = frametime) {
            spawn(9, 40, 1, 0, 1)
            playnull()
        } while (frametime - start < 5)
        CrashDoRespawn()
    }
}

state Coco_Spaceship_Finish { // 40
    stateflag 0xD2000020
    statusc 0x1C02
    code() {
        mem49 = 0
        mem48 = 0
        StopSpaceshipSound()
        spawn2(WEfOC, WEfOC_S_WARP_OUT, 1, 0, 0, 9.5m, 16m, 0x999, 0)
        changestate(Willy_Level_Complete)
    }
    event(e, a) {
        if (e == Event34) {
            accev()
            statusc &= ~0x800
        }
        if (e == Event21) {
            accev()
            statusc |= 0x800
        }
    }
}

