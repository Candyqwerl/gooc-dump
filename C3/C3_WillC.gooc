        if (animseq == getanim(WILLY_BIPLANE_ROLL_RIGHT) || animseq == getanim(WILLY_BIPLANE_ROLL_LEFT) || animseq == getanim(SIS_BIPLANE_ROLL_RIGHT) || animseq == getanim(SIS_BIPLANE_ROLL_LEFT)) {
            stateflag |= 24
            playframes(25.0, 48.0)
            stateflag &= ~24
        }
        if (mem50) {
            sleepframes(SIS_BIPLANE, 0.0, 49.0)
        }
        else {
            sleepframes(WILLY_BIPLANE, 0.0, 49.0)
        }
    }
    event(e, a) {
        if (e == Event19 || e == Event80) {
            StopBiplaneSound()
        }
        if (e == EventHit) {
            accev()
            if (!rand(2)) {
                SoundPitchDefault()
                soundplay([CB2jA], 1V)
            }
            else {
                SoundPitchDefault()
                soundplay([CB3jA], 1V)
            }
            health -= a[0]
            GLOBAL_75 = 2
            GLOBAL_65 = -1
            if (health < 1.0) {
                health = 0.0
                accevcstate(Willy_Biplane_Death)
            }
        }
        accevcstate(Willy_Biplane_Finish, e == Event22)
        rejevret(e == Event34)
        if (e == Event60) {
            accev()
            soundpitch(0x571)
            sounddecay(0xA0)
            soundplay([Br3jA], 1V)
            mem47 = 1
            mem40 = frametime
        }
    }
    trans {
        if (stateflag & 0x2000) {
            mem49 = 0
            mem48 = 0
            MoveBiplane(mem49, mem48)
        }
        else {
            changestateif(Willy_Biplane_Roll, buttonpress(PAD_SQUARE) && (LEVEL == LEVEL_RingsOfPower || frametime - statetime >= 12))
            UpdateBiplane()
        }
    }
}

sub UpdateBiplane() { // EJS-161
    {
        var sx = -GLOBAL_161
        var sy = GLOBAL_162
        var turn
        if (abs(sx) < 32) {
            sx = 0
        }
        if (abs(sy) < 32) {
            sy = 0
        }
        if (mem47) {
            sx = (sx << 1) / 3
            sy = (sy << 1) / 3
        }
        var0 = distance(x, self, 15)
        if (var0 > 180m) {
            if (var0 >= 220m) {
                roty = miscfunc(x, self, 1, 2) + 180deg // atan2
            }
            else {
                turn = (degdist(roty, miscfunc(x, self, 1, 2) + 180deg) * ((var0 - 180m) >> 8) / (40m >> 8)) * 25
            }
        }
        mem49 = (sy * 55deg) >> 7
        mem48 = ((sx << 11) >> 7) + turn
    }
    if (stateflag & 0x2) {
        if (frametime - statetime >= 7) {
            stateflag &= ~0x2
        }
        mem51 = 0
    }
    else if (buttonhold(PAD_X)) {
        mem51 = seek(mem51, 10m, spd(40m))
        mem47 = 0
    }
    else if (mem47 == 2) {
        mem51 = 60m
    }
    else if (mem47 == 1) {
        mem51 = 40m
    }
    else {
        mem51 = seek(mem51, 20m, spd(40m))
    }
    MoveBiplane(mem49, mem48)
    if (buttonhold(PAD_R1) || buttonhold(PAD_CIRCLE)) {
        stateflag |= 0x40
        if (!time(3)) {
            spawn2(32, 4, 1, 2.0, mem41 * 0xC0, mem42 * 0xC0, mem43 * 0xC0)
        }
    }
    else {
        stateflag &= ~0x40
    }
    if (mem47) {
        spawn(32, 13, 1, mem47 - 1, 5.0 + (time(2) << 8))
        if (frametime - mem40 >= 62) {
            mem47 = 0
        }
    }
    if (animseq == getanim(WILLY_BIPLANE_ROLL_LEFT) || animseq == getanim(SIS_BIPLANE_ROLL_LEFT)) {
        stateflag |= 0x200000
    }
    else {
        stateflag &= ~0x200000
    }
}

sub MoveBiplane(pitch, turn) { // EJS-278
    mem46 = seek(mem46, turn >> 1, (degdist(mem46, turn >> 1) >> 4) * 30 / 25)
    rotz = mem46 + mem45
    roty = spd(roty, mem46)
    if (pitch) {
        rotx = spd(rotx, pitch)
    }
    else {
        rotx = seek(rotx, 0, spd(36deg))
    }
    vectransf(vtrans, vvec, 180deg, 0, 0)
    mem41 = vecx - x
    mem42 = vecy - y
    mem43 = vecz - z
    if (collider && !(stateflag & 0x2)) {
        var nx = x - collider -> x
        var ny = y - collider -> y
        var nz = z - collider -> z
        var vx = -velx
        var vy = -vely
        var vz = -velz
        var dot = 0
        if (collider -> spawn == 0x240000) {
            nz /= 6
        }
        misc5(nx, 2.56m)
        misc5(vx, 2.56m)
        dot = (((nx >> 8) * (vx >> 8)) + ((ny >> 8) * (vy >> 8)) + ((nz >> 8) * (vz >> 8))) >> 10
        if (dot >= 0) {
            SoundPitchDefault()
            sounddecay(0xC9)
            soundplay([CB1jA], 1V)
            var0 = distance(velx, self, 9)
            velx = ((dot * nx) >> 9) - vx
            vely = ((dot * ny) >> 9) - vy
            velz = ((dot * nz) >> 9) - vz
            misc5(velx, var0)
            if (dot < 0x300) {
                save (rotz) {
                    ins80(velx, rotx)
                    rotx -= 90deg
                }
            }
            stateflag |= 0x2
            statetime = frametime
        }
    }
    velx = spd(velx, (mem51 >> 12) * mem41)
    vely = spd(vely, (mem51 >> 12) * mem42)
    velz = spd(velz, (mem51 >> 12) * mem43)
    {
        var damp = 1.0 - spd(0x179)
        velx = (velx * damp) >> 8
        vely = (vely * damp) >> 8
        velz = (velz * damp) >> 8
    }
    if (!(stateflag & 0x20)) {
        if (y < mem38 + 5m) {
            var0 = ((y - mem38) >> 8) * 35deg / (5m >> 8)
            if (rotx > var0) {
                rotx = var0
            }
            var0 = (y - mem38) * 0x64 / 0x7D
            if (vely < -var0) {
                vely = -var0
            }
        }
        else if (y > mem39 - 5m) {
            var0 = ((y - mem39) >> 8) * 35deg / (5m >> 8)
            if (rotx < var0) {
                rotx = var0
            }
            var0 = (y - mem39) * -0x64 / 0x7D
            if (vely > var0) {
                vely = var0
            }
        }
        if (rotx > 35deg) {
            rotx = 35deg
        }
        else if (rotx < -35deg) {
            rotx = -35deg
        }
    }
    if (!mem47) {
        speed = distance(velx, self, 11)
        if (speed > 10m) {
            misc5(velx, 10m)
            speed = 10m
        }
    }
    if (SFXVOL) {
        if (ActionVoice > 0) {
            sp = ActionVoice
            soundcheck(sp)
        }
        else {
            misc = -1
        }
        if (misc != -1) {
            voice = ActionVoice
            soundsetup(0x2998, voice, 0)
            soundsetup(25, voice, 6)
            soundpitch(0x68F + ((((mem51 >> 8) << 12) / (20m >> 8)) + (rotx * 0x666 / 35deg)), voice, 2)
        }
        else {
            soundpitch(16.0)
            sounddecay(0xFD)
            soundplay([CBLjA], 0x2998)
            ActionVoice = voice
        }
    }
    else {
        voice = ActionVoice
        soundsetup(0, voice, 15)
    }
    if (!GLOBAL_101) {
        GLOBAL_101 = 3
        GLOBAL_100 = ((mem51 * 0x51 / 20m) + (rotx * 30 / 35deg))
    }
    if (vely < -4m) {
        vely = -4m
    }
    else if (vely > 4m) {
        vely = 4m
    }
    collider = 0
    if (health < 100.0) {
        if (!rand((health >> 10) + 1)) {
            spawn(9, 21, 1, 3.0, (0 - velx) + rand(1m), (0.5m - vely) + rand(1m), -velz, 3.2, 2.4, 24, 0)
            if (!rand(4)) {
                if (!rand(2)) {
                    SoundPitchDefault()
                    soundplay([CB6jA], 1V)
                }
                else {
                    SoundPitchDefault()
                    soundplay([CB5jA], 1V)
                }
            }
        }
    }
}

sub StopBiplaneSound() { // EJS-541
    if (ActionVoice) {
        voice = ActionVoice
        soundsetup(25, voice, 6)
        soundsetup(0, voice, 3, 0)
        ActionVoice = 0
    }
}

state Willy_Biplane_Roll { // 43
    stateflag 0xD2000019
    statusc 0x0
    code() {
        soundpitch(3.263)
        sounddecay(0xA0)
        soundplay([CB4jA], 0x3998)
        soundpitch(0x3A0)
        sounddecay(0xA0)
        soundplay(SOUND_SPIN_DEFAULT, 0.4V)
        if (mem50) {
            if (rotz < 0) {
                setanim(SIS_BIPLANE_ROLL_RIGHT)
            }
            else {
                setanim(SIS_BIPLANE_ROLL_LEFT)
            }
        }
        else if (rotz < 0) {
            setanim(WILLY_BIPLANE_ROLL_LEFT)
        }
        else {
            setanim(WILLY_BIPLANE_ROLL_RIGHT)
        }
        playframes(0.0, 24.0)
        changestate(Willy_Biplane_Fly)
    }
    event(e, a) {
        if (e == Event19 || e == Event80) {
            StopBiplaneSound()
        }
        rejevret(e == EventHit)
        accevcstate(Willy_Biplane_Finish, e == Event22)
        rejevret(e == Event34)
        if (e == Event60) {
            accev()
            soundpitch(0x571)
            sounddecay(0xA0)
            soundplay([Br3jA], 1V)
            mem47 = 2
            mem40 = frametime
        }
    }
    trans {
        UpdateBiplane()
    }
}

state Willy_Biplane_Death { // 44
    stateflag 0xD2000022
    statusc 0x1402
    code(arg) {
        BeginDeath(arg)
        KillBonus()
        GAMEFLAGS |= 0x2
        trotz = 0
        mem51 = 0
        if (!rand(2)) {
            soundpitch((0x999 + rand(3.2)) * 0x4B >> 8)
            soundplay([VL1jA], 1V)
        }
        else {
            soundpitch((0x999 + rand(3.2)) * 0x4B >> 8)
            soundplay([VL2jA], 1V)
        }
        do {
            mem51 = seek(mem51, 1.6m, 0.016m)
            vecx = degdist(rotx, 70deg) >> 3
            if (abs(vecx) > 23) {
                if (vecx >= 0) {
                    vecx = 23
                }
                else {
                    vecx = -23
                }
            }
            rotx += vecx
            trotz += 6
            if (trotz > 14.4deg) {
                trotz = 14.4deg
            }
            rotz = (rotz + trotz) % 360deg
            vectransf(vtrans, vtrans, mem51, 0, 0)
            if (!(frametime & 1)) {
                spawn(9, 21, 1, 2.0, 0, 4m, 0, 1S, 2.4, 24, 1)
            }
            if (!(stateflag & 0x100000) && frametime - statetime >= 15) {
                cascadeevent(Event9, self, 0)
                stateflag |= 0x100000
            }
            if (mem50) {
                if (animseq != getanim(SIS_BIPLANE)) {
                    setanim(SIS_BIPLANE, -1.0)
                }
                playframe((animframe + 1.0) % 50.0)
            }
            else {
                if (animseq != getanim(WILLY_BIPLANE)) {
                    setanim(WILLY_BIPLANE, -1.0)
                }
                playframe((animframe + 1.0) % 50.0)
            }
        } until (y <= 0)
        StopBiplaneSound()
        GLOBAL_75 = 0x64
        GLOBAL_65 = -1
        GLOBAL_101 = 0x64
        GLOBAL_100 = 0xFF
        do (var start = frametime) {
            spawn(9, 40, 1, 0, 1)
            playnull()
        } while (frametime - start < 5)
        CrashDoRespawn()
    }
}

state Willy_Biplane_Finish { // 45
    stateflag 0xD2000020
    statusc 0x1C02
    code() {
        mem49 = 0
        mem48 = 0
        do {
            if (mem50) {
                do (var start = frametime) {
                    if (animseq != getanim(SIS_BIPLANE)) {
                        setanim(SIS_BIPLANE, -1.0)
                    }
                    playframe((animframe + 1.0) % 50.0)
                } while (frametime - start < 10)
            }
            else {
                do (var start = frametime) {
                    if (animseq != getanim(WILLY_BIPLANE)) {
                        setanim(WILLY_BIPLANE, -1.0)
                    }
                    playframe((animframe + 1.0) % 50.0)
                } while (frametime - start < 10)
            }
        } until (statusc & 0x800)
        player = GLOBAL_97
        sendevent(Event9, player, 0)
        if (GLOBAL_151 == 5.0 && !mem50) {
            soundpitch(0x571)
            sounddecay(0xFA)
            soundsetup(8, self, 8)
            soundplay([1149I], 1V) // TODO: Find EID
        }
        mem48 = 80deg
        WaitFrame((animframe + 1.0) % 50.0, 10)
        SoundPitchDefault(0.25)
        sounddecay(0xC8)
        soundplay([VL3jA], 1V)
        mem48 = -80deg
        WaitFrame((animframe + 1.0) % 50.0, 10)
        mem49 = -320deg
        mem48 = 0
        do {
            playframe((animframe + 1.0) % 50.0)
        } until (abs(degdist(rotx, 0)) >= 170deg)
        SoundPitchDefault(0.25)
        sounddecay(0xC8)
        soundplay([VL3jA], 1V)
        mem49 = 0
        do {
            mem45 = degseek(mem45, 180deg, 90deg)
            rotx = degseek(rotx, 180deg, 180deg)
            playframe((animframe + 1.0) % 50.0)
        } until (mem45 == 180deg)
        rotx = 0
        mem45 = 0
        rotz = 0
        roty += 180deg
        mem49 = 0
        mem48 = 0
        WaitFrame((animframe + 1.0) % 50.0, 50)
        StopBiplaneSound()
        spawn(WEfOC, WEfOC_S_WARP_OUT, 1, 0, 0, 9.5m, 16m, 0x999, 0)
        changestate(Willy_Level_Complete)
    }
    event(e, a) {
        if (e == Event34) {
            accev()
            statusc &= ~0x800
        }
        if (e == Event21) {
            accev()
            statusc |= 0x800
        }
    }
    trans {
        mem51 = seek(mem51, 20m, spd(40m))
        MoveBiplane(mem49, mem48)
    }
}
#module default

#module [WilkC] // 2007I
#purge klwB
state Willy_Bike_Start { // 46
    stateflag 0xE2002005
    statusc 0x0
    code() {
        spawn(63, 1)
        if (!RESPAWNCOUNT) {
            RESPAWNCOUNT += 1.0
        }
        statusb = (FLAG_PHYSICS_TEST | FLAG_GRAVITY | FLAG_PHYSICS_ENGINE | FLAG_INVISIBLE | FLAG_HAS_SHADOW | FLAG_STALL)
        vfx = (vfx & 0xFFFFFF00) | 0x5
        trotx = 90deg
        rotx = 0
        roty = 180deg
        troty = roty
        rotz = 0
        SetVel(0, 0, 0)
        speed = 0
        mem48 = 0
        mem41 = 0
        mem42 = 0
        field_61 = 10m
        interrupter = GLOBAL_97
        sendevent(Event34, interrupter, 0.0)
        playframe(animframe, 10)
        statusb &= ~FLAG_INVISIBLE
        save (zindex) {
            zindex = 0x320
            playframes(WILLY_BIKE_MOUNT, 0.0, 18.0)
        }
        playframe(animframe, 10)
        interrupter = GLOBAL_97
        sendevent(Event34, interrupter, -1.0)
        soundpitch(0x6E4)
        sounddecay(0xC8)
        soundplay([CM2kA], 0.7V)
        GLOBAL_101 = 7
        GLOBAL_100 = 0xCC
        soundpitch(0x6E4)
        sounddecay(0xFD)
        soundplay([CM1kA], 1V)
        ActionVoice = voice
        soundpitch(58)
        sounddecay(0xFD)
        soundcount(0xFFFF)
        soundplay([HR8kA], 0x999)
        mem51 = voice
        playframes(WILLY_BIKE_READY, 0.0, 9.0)
        soundpitch(0x6E4)
        sounddecay(0xC8)
        soundplay([CM2kA], 0.8V)
        GLOBAL_101 = 7
        GLOBAL_100 = 0xCC
        animframe = 8.0
        do {
            animframe += 1.0
            SpawnBikeSmoke()
            playframe()
        } while (animframe + 1.0 <= 17.0)
        playframe(animframe, 13)
        playanim(0, WILLY_BIKE_REV)
        var0 = 1.0
        do (var i = 0) {
            playanim(1, WILLY_BIKE_REV)
            playanim(2, WILLY_BIKE_REV)
            playanim(3, WILLY_BIKE_REV)
            soundpitch(0x6E4)
            sounddecay(0xC8)
            soundplay([CM2kA], 0.8V)
            GLOBAL_101 = 7
            GLOBAL_100 = 0xCC
            SpawnBikeSmoke()
            playanim(3, WILLY_BIKE_REV)
            SpawnBikeSmoke()
            playanim(4, WILLY_BIKE_REV)
            SpawnBikeSmoke()
            playanim(3, WILLY_BIKE_REV)
            SpawnBikeSmoke()
            playanim(3, WILLY_BIKE_REV)
            SpawnBikeSmoke()
            playanim(2, WILLY_BIKE_REV)
            playanim(1, WILLY_BIKE_REV)
            playanim(0, WILLY_BIKE_REV, 6)
        } while ({ i += 1.0 }; i < 10.0)
        changestate(Willy_Bike_Launch, var0)
    }
    event(e, a) {
        if (e == Event76) {
            if (a[0] == 2.0) {
                var0 = 1.0
                settrans(UpdateBikeStart)
            }
            if (a[0] == 3.0) {
                sp = var0
                a[0] = sp
                accevcstate(Willy_Bike_Launch)
            }
            rejevret()
        }
        if (e == Event19 || e == Event80) {
            voice = ActionVoice
            soundsetup(0, voice, 0, 15)
            if (mem51) {
                voice = mem51
                soundsetup(0, voice, 0, 15)
            }
        }
    }
}

sub UpdateBikeStart() { // EKS-136
    if (buttonpress(PAD_X)) {
        soundpitch(0x6E4)
        sounddecay(0xC8)
        soundplay([CM2kA], 0.8V)
        var0 = 0
    }
    if (!var0) {
        if (!(buttonhold(PAD_X))) {
            var0 = 1.0
        }
        SpawnBikeSmoke()
        SpawnBikeSmoke()
    }
}

sub SpawnBikeSmoke() { // EKS-149
    if (!rand(2)) {
        spawn(9, 21, 1, (time(2) << 9) + 1.0, randi(-1.5m, 1.5m), 4m + rand(1m), 8m + rand(4m), 0.5S, -3.2, 24, 0)
    }
    else {
        spawn(9, 21, 1, (time(2) << 9) + 1.0, randi(-1.5m, 1.5m), 4m + rand(1m), 8m + rand(4m), 0.5S, -3.2, 24, 2)
    }
}

state Willy_Bike_Launch { // 47
    stateflag 0xE2000005
    statusc 0x0
    event => state Willy_Bike_Idle
    trans => sub UpdateBikeSteering
    code(skip) {
        if (!skip) {
            stateflag |= 0x200000
            if (GLOBAL_151 == 5.0) {
                soundpitch(0x45A)
                sounddecay(0xFB)
                soundplay([1192I], 1V) // TODO: Find EID, region specific?
            }
            soundpitch(4.0)
            sounddecay(0xFA)
            soundplay([CM5kA], 1V)
            playframes(WILLY_BIKE_1, 0.0, 13.0)
            mem48 = 0
            playanim(10, WILLY_BIKE_9, 10)
            playframes(WILLY_BIKE_8, 0.0, 19.0)
            soundpitch(0x399 + rand(0xCC))
            sounddecay(0x90)
            soundplay(SOUND_LAND_DEFAULT, 0.3V)
        }
        mem48 = 0
        changestate(Willy_Bike_Ride)
    }
}

sub PlayBikeIdle() { // EKS-212
    mem42 = 0
    // TODO: Fix branching?
    if (animseq == getanim(WILLY_BIKE_5)) {
        until (animframe == 15.0) {
            playframe(seek(animframe, 15.0, 2.0))
        }
    }
    else if (animseq == getanim(WILLY_BIKE_4)) {
        if (animseq != getanim(WILLY_BIKE_4)) {
            setanim(WILLY_BIKE_4, 26.0)
        }
        while (animframe > 0) {
            playframe(animframe - 1.0)
        }
    }
    else if (animseq != getanim(WILLY_BIKE_REV)) {
        if (animseq != getanim(WILLY_BIKE_2)) {
            setanim(WILLY_BIKE_2, -1.0)
        }
        while (animframe < 11.0) {
            playframe(animframe + 1.0)
        }
    }
    setanim(WILLY_BIKE_3, 15.0)
    mem48 = 0
    do {
        if (!speed) {
            animframe = 15.0 + (mem48 * -0xF80) / 80deg
            if (animframe < 0) {
                animframe = 0
            }
            else if (animframe > 30.0) {
                animframe = 30.0
            }
            playframe()
        }
        else {
            if (speed && animframe == 15.0) {
                mem48 = 0
                changestate(Willy_Bike_Ride)
            }
            playframe(seek(animframe, 15.0, 1.0))
        }
    } while (1)
}

state Willy_Bike_Idle { // 48
    stateflag 0xE2000005
    statusc 0x0
    code => sub PlayBikeIdle
    event(e, a) {
        if (e == Event19 || e == Event80) {
            voice = ActionVoice
            soundsetup(0, voice, 0, 15)
            if (mem51) {
                voice = mem51
                soundsetup(0, voice, 0, 15)
            }
        }
        accevcstate(Willy_Bike_Fall, e == Event9)
        accevcstate(Willy_Bike_Reset, e == Event35 || e == Event3 || e == Event7)
        accevcstate(Willy_Bike_Fail, e == Event14)
        accevcstate(Willy_Bike_Win, e == Event22)
        accevcstate(Willy_Bike_Hold, e == Event34)
        rejevret(e == Event53 || e == Event64 || e == Event27 || e == Event60 || e == Event21 || e == Event50)
    }
    trans {
        if (STATUS_FIRSTFRAME && !(stateflag & 0x8)) {
            mem48 = 0
        }
        var turn = (GLOBAL_161 * -80deg) >> 7
        if (abs(GLOBAL_161) < 30) {
            turn = 0
        }
        rotz = degseek(rotz, turn >> 3, 20deg)
        mem48 = seek(mem48, turn, spd(160deg))
        roty = spd(roty, mem48)
        roty = degseek(GAMEDIR + 180deg, roty, 2500deg)
        UpdateBikeSpeed()
        troty = degseek(troty, roty, 180deg)
    }
}

sub UpdateBikeSpeed() { // EKS-348
    stateflag &= ~0x2
    if (!(statusa & 0x40000) && !buttonhold(PAD_X)) {
        speed = seek(speed, 4m, spd(4m))
    }
    else if (stateflag & 0x80000) {
        speed = seek(speed, 36m, spd(4m))
    }
    else if (stateflag & 0x200000) {
        speed = seek(speed, 40m, spd(15m))
    }
    else if (buttonhold(PAD_X)) {
        speed = seek(speed, 28m, spd(6m))
    }
    else {
        speed = seek(speed, 0, spd(4m))
    }
    if (buttonhold(PAD_R1 | PAD_CIRCLE | PAD_SQUARE) && statusa & 0x40000) {
        speed = seek(speed, 0, spd(12m))
        var damp = 1.0 - spd(3.0)
        velx = (velx * damp) >> 8
        velz = (velz * damp) >> 8
        mem43 = seek(mem43, 0, 5m)
    }
    if (SFXVOL) {
        if (ActionVoice > 0) {
            sp = ActionVoice
            soundcheck(sp)
        }
        else {
            misc = -1
        }
        if (misc != -1) {
            var pitch = 0x999 + (abs(speed) >> 8 << 13) / (28m >> 8)
            if (stateflag & 0x8) {
                pitch = (pitch * 0x180) >> 8
            }
            voice = ActionVoice
            soundsetup(1V, voice, 0, 0)
            soundsetup(5, voice, 6)
            soundpitch(pitch, voice, 2)
        }
        else {
            soundpitch(0x6E4)
            sounddecay(0xFD)
            soundplay([CM1kA], 1V)
            ActionVoice = voice
        }
        if (stateflag & 0x8 || !speed) {
            if (mem51) {
                voice = mem51
                soundsetup(2, voice, 6)
                soundsetup(0, voice, 3, 0)
                mem51 = 0
            }
        }
        else {
            if (mem51 > 0) {
                sp = mem51
                soundcheck(sp)
            }
            else {
                misc = -1
            }
            if (misc != -1) {
                var pitch = 0x999 + (abs(speed) >> 8 << 13) / (28m >> 8)
                voice = mem51
                soundsetup(0x999, voice, 0, 0)
                soundsetup(5, voice, 6)
                soundpitch(pitch >> 3, voice, 2)
            }
            else {
                soundpitch(0x1D0)
                sounddecay(0xFD)
                soundcount(0xFFFF)
                soundplay([HR8kA], 0x999)
                mem51 = voice
            }
        }
    }
    else {
        voice = ActionVoice
        soundsetup(0, voice, 15)
        if (mem51) {
            voice = mem51
            soundsetup(0, voice, 0, 15)
        }
    }
    if (!GLOBAL_101) {
        var rumble = ((abs(speed) >> 8) * 0x4C) / (28m >> 8)
        if (STATUS_GROUNDLAND) {
            GLOBAL_101 = 3
            GLOBAL_100 = 51 + rumble
        }
        else {
            GLOBAL_101 = 3
            GLOBAL_100 = 51 + (rumble >> 1)
        }
    }
    if (collider) {
        sendeventif(Event10, collider, (collider -> spawn >> 16) == 34, 100.0)
    }
    if (statusa & 0x40000) {
        rotx = 0
    }
    else {
        rotx = degseek(rotx, 0, 180deg)
    }
}

sub ResolveBikeCollision(obj, cx, cy, cz, radius, scale) { // EKS-514
    save (vecx, vecz) {
        vecx = cx
        vecz = cz
        var dist = distance(vecx, self, DIST_NO_Y | DIST_EXACT)
        x = cx + ((x - cx) * (radius >> 8) / (dist >> 8))
        z = cz + ((z - cz) * (radius >> 8) / (dist >> 8))
    }
    var nx = x - cx
    var ny = 0
    var nz = z - cz
    var vx = -velx
    var vy = 0
    var vz = -velz
    var dot = 0
    var mag = 0
    misc5(nx, 2.56m, 1)
    misc5(vx, 2.56m, 1)
    unless ((vx ^ -velx) >= 0 && (vz ^ -velz) >= 0) {
        print(vx, velx)
        print(vz, velz)
    }
    dot = (((nx >> 8) * (vx >> 8)) + ((nz >> 8) * (vz >> 8))) >> 10
    if (dot >= 0) {
        mag = distance(velx, self, 9)
        velx = ((dot * nx) >> 9) - vx
        velz = ((dot * nz) >> 9) - vz
        save (vely) {
            vely = 0
            misc5(velx, mag)
        }
        if (dot < 3.0 && speed > 1m) {
            var yaw = roty
            save (rotz, rotx) {
                ins80(velx, rotx)
                roty = yaw + (degdist(yaw, roty) >> 2)
            }
        }
        else {
            velx = 0
            velz = 0
            speed = (speed * scale) >> 8
            voice = ActionVoice
            soundsetup(7, voice, 6)
            soundpitch(8.0, voice, 2)
            if (mem51) {
                voice = mem51
                soundsetup(7, voice, 6)
                soundsetup(0, voice, 3, 0)
                mem51 = 0
            }
        }
        GLOBAL_101 = 5
        GLOBAL_100 = 0xFF
        stateflag |= 0x2
        if (stateflag & 0x8 && vely <= 0) {
            interrupter = obj
            sendevent(EventJumpedOn, interrupter, 0)
        }
    }
}

sub StopBikeSounds() { // EKS-624
    if (ActionVoice) {
        voice = ActionVoice
        soundsetup(25, voice, 6)
        soundsetup(0, voice, 3, 0)
        ActionVoice = 0
        if (mem51) {
            voice = mem51
            soundsetup(25, voice, 6)
            soundsetup(0, voice, 3, 0)
            mem51 = 0
        }
    }
}

state Willy_Bike_Ride { // EKS-637
    stateflag 0xE2000005
    statusc 0x0
    trans => sub UpdateBikeSteering
    code() {
        if (animseq == getanim(WILLY_BIKE_3) || animseq == getanim(WILLY_BIKE_4)) {
            if (animseq != getanim(WILLY_BIKE_4)) {
                setanim(WILLY_BIKE_4, -1.0)
            }
            while (animframe < 25.0) {
                playframe(animframe + 1.0)
            }
        }
        else if (animseq == getanim(WILLY_BIKE_2)) {
            if (animseq != getanim(WILLY_BIKE_2)) {
                setanim(WILLY_BIKE_2, 12.0)
            }
            while (animframe > 0) {
                playframe(animframe - 1.0)
            }
        }
        else if (animseq == getanim(WILLY_BIKE_7)) {
            if (animseq != getanim(WILLY_BIKE_7)) {
                setanim(WILLY_BIKE_7, 8.0)
            }
            while (animframe > 0) {
                playframe(animframe - 1.0)
            }
        }
        StopBikeSkidSound()
        do {
            var slip = degdist(troty, roty)
            var frame = 0
            if (speed <= 14m) {
                if (animseq != getanim(WILLY_BIKE_5)) {
                    playanim(15, WILLY_BIKE_5)
                }
                animframe = seek(animframe, 15.0 + (((mem48 * 0xF80) / 80deg) * ((14m - speed) >> 8)) / (14m >> 8), 1.0)
                if (animframe < 0) {
                    animframe = 0
                }
                else if (animframe > 30.0) {
                    animframe = 30.0
                }
                playframe()
                StopBikeSkidSound()
            }
            else {
                if (animseq != getanim(WILLY_BIKE_6)) {
                    StopBikeSkidSound()
                    playanim(30, WILLY_BIKE_6)
                }
                if (slip) {
                    if (abs(slip) > 56 && stateflag & 0x4) {
                        if (!mem50) {
                            soundpitch(4.0)
                            soundplay([CM4kA], 1V)
                            mem50 = voice
                        }
                    }
                    else {
                        StopBikeSkidSound()
                    }
                    var0 = -0x1E80
                }
                else {
                    StopBikeSkidSound()
                    var0 = -0xF40
                }
                frame = 30.0 + (((mem41 * var0) / 50deg) * ((speed - 14m) >> 8)) / (14m >> 8)
                animframe = seek(animframe, frame, 1.0)
                if (animframe < 0) {
                    animframe = 0
                }
                else if (animframe > 60.0) {
                    animframe = 60.0
                }
                playframe()
                if ((animframe >= 25.0 && animframe <= 35.0) && buttonhold(PAD_R1 | PAD_CIRCLE | PAD_SQUARE)) {
                    soundpitch(4.0)
                    soundsetup(25, self, 6)
                    soundsetup(0, self, 3, 0)
                    soundplay([CM4kA], 0.5V)
                    playanim(0, WILLY_BIKE_7)
                    playanim(1, WILLY_BIKE_7)
                    playanim(2, WILLY_BIKE_7)
                    playanim(2, WILLY_BIKE_7)
                    playanim(3, WILLY_BIKE_7)
                    playanim(4, WILLY_BIKE_7)
                    playanim(5, WILLY_BIKE_7)
                    playanim(6, WILLY_BIKE_7)
                    while (buttonhold(PAD_R1 | PAD_CIRCLE | PAD_SQUARE) && speed) {
                        playframe()
                    }
                    playframesback(WILLY_BIKE_7, 6.0, 0.0)
                }
            }
        } while (1)
    }
    event(e, a) { // EKS-785
        if (e == Event19 || e == Event80) {
            voice = ActionVoice
            soundsetup(0, voice, 0, 15)
            if (mem51) {
                voice = mem51
                soundsetup(0, voice, 0, 15)
            }
        }
        if (e == Event64) {
            accev()
            speed = seek(speed, 0, spd(6m))
            if (speed > 18.666665m) {
                speed = 18.666665m
            }
            GLOBAL_101 = 2
            GLOBAL_100 = 0xFF
            if (STATUS_GROUNDLAND) {
                vely = 2.82842m
            }
            mem41 = (mem41 * 0xEB) >> 8
            if (!SHAKEY) {
                SHAKEY = 2.0
            }
        }
        accevcstate(Willy_Bike_Fall, e == Event9)
        accevcstate(Willy_Bike_Reset, e == Event35 || e == Event3 || e == Event7)
        accevcstate(Willy_Bike_Fail, e == Event14)
        accevcstate(Willy_Bike_Win, e == Event22)
        accevcstate(Willy_Bike_Hold, e == Event34)
        if (e == Event27 && !(stateflag & 0x2)) {
            accev()
            var vspd = speed
            ResolveBikeCollision(interrupter, interrupter -> x, interrupter -> y, interrupter -> z, a[0], a[1.0])
            if (vspd > 10m && !speed && interrupter -> spawn == 0x3E0000) {
                accevcstate(Willy_Bike_Hit)
            }
        }
        if (e == Event60) {
            if (stateflag & 0x80000 && !(frametime - statetime >= 12)) {
                rejevret()
            }
            else if (stateflag & 0x2) {
                rejevret()
            }
            else {
                accevcstate(Willy_Bike_Boost)
            }
        }
        if (stateflag & 0x8 && !(stateflag & 0x100000)) {
            rejevret(e == Event21)
        }
        else {
            accevcstate(Willy_Bike_Jump, e == Event21)
        }
        rejevret(e == Event50 || e == Event53)
    }
}

sub UpdateBikeSteering() { // EKS-878
    mem43 = speed >> 8
    if (dirhold(PAD_LEFT) || dirhold(PAD_RIGHT)) {
        {
            var sx = -GLOBAL_161
            mem48 = (sx * 80deg) >> 7
            mem42 = sx * ((50deg * mem43) / (28m >> 8)) >> 7
        }
        mem49 = (mem48 * ((28m >> 8) - mem43)) / (28m >> 8)
        roty = spd(roty, mem49)
        unless (DEBUG && buttonhold(PAD_TRIANGLE)) {
            roty = degseek(GAMEDIR + 180deg, roty, 2500deg)
        }
        if ((mem41 ^ mem42) >= 0) {
            mem41 += degdist(mem41, mem42) / 10
        }
        else {
            mem41 += degdist(mem41, mem42) >> 2
        }
    }
    else {
        mem48 = 0
        mem42 = 0
        mem41 += degdist(mem41, mem42) >> 2
        statetime = frametime
    }
    rotz = mem41
    roty = spd(roty, mem41)
    UpdateBikeSpeed()
    {
        var damp = 1.0 - spd(0x280)
        velx = (velx * damp) >> 8
        velz = (velz * damp) >> 8
    }
    {
        var r = 30deg
        if (!buttonhold(PAD_X)) {
            r <<= 1
        }
        if (buttonhold(PAD_R1 | PAD_SQUARE)) {
            r >>= 2
        }
        troty = degseek(troty, roty, r + 50deg * (50deg - abs(mem41)) / 50deg)
        setvel(speed)
    }
    changestateifn(Willy_Bike_Idle, speed)
}

sub StopBikeSkidSound() { // EKS-964
    if (mem50) {
        voice = mem50
        soundsetup(7, voice, 6)
        soundsetup(0, voice, 3, 0)
    }
    mem50 = 0
}

state Willy_Bike_Jump { // 50
    stateflag 0xE2000009
    statusc 0x0
    event => state Willy_Bike_Ride
    trans => sub UpdateBikeSteering
    code() {
        SoundJumpDefault(14.4, 0.205, 0x40, 0x666)
        playframes(WILLY_BIKE_10, 0.0, 13.0)
        until (STATUS_GROUNDLAND) {
            stateflag |= 0x100000
            playframe()
        }
        GLOBAL_101 = 5
        GLOBAL_100 = 0xFF
        spawn(9, 2, 1, -1.0, 7.0, groundvel + 8m)
        spawn(9, 43, 1, 0.5m, 50, 50, 50, 24.0, getins(InitBikeLandingEffect), pushfunc(self, self))
        soundpitch((0xA8F + rand(3.2)) * 0x4B >> 8)
        sounddecay(0x90)
        soundplay([HR3kA], 1V)
        if (!SHAKEY) {
            SHAKEY = 5.0
        }
        stateflag &= ~0x8
        stateflag |= 0x4
        playframes(WILLY_BIKE_11, 0.0, 15.0)
        if (speed) {
            changestate(Willy_Bike_Ride)
        }
        else {
            changestate(Willy_Bike_Idle)
        }
    }
}

sub InitBikeLandingEffect() { // EKS-1028
    tpc = field_61
    SetColor1(50, 50, 50)
    statusb |= FLAG_PHYSICS_ENGINE
    velx = creator -> velx
    velz = creator -> velz
}

