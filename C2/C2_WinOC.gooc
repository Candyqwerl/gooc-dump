state FireBall { // 15
    stateflag 0x1
    statusc 0x2
    code() {
        statusb = FLAG_NO_CAMERA_CLIP
        zindex = 40
        vfx = (vfx & 0xFFFFFF00) | 0x2
        do (var i = 0) {
            SetVFX2D()
            soundpitch(4.353)
            sounddelay(3)
            sounddecay(10.2s)
            soundplay([SWaEA], 1V)
            vfx &= 0xFFFFFF00
            playframes(EXPLOSION, 0.0, 53.0)
            playframe(animframe, 10)
            settrans(__FireBall_TRANS)
            moda = 0
        } while ({ i += 1.0 }; i < 2.0)
        KillEntity()
    }
    trans {
        once {
            SetScale(0S)
        }
        scalex = seek(scalex, 1S, 0xF5)
        scaley = seek(scaley, 1S, 0xF5)
        scalez = seek(scalez, 1S, 0xF5)
        if (frametime - statetime >= 2s) {
            moda = seek(moda, 16.0, 0xF5)
        }
    }
}

state Ship_Explosions { // 16
    stateflag 0x1
    statusc 0x2
    code() {
        SetVec(x, y, z)
        playnull()
        do {
            x = vecx + randi(-2m, 2m)
            y = vecy + randi(-2m, 2m)
            z = vecz + randi(-2m, 2m)
            ExplosionDelay = 0.5s + rand(2s)
            if (!rand(3)) {
                spawn(9, 40, 1, 0, 0)
            }
            else {
                spawn(9, 4, 1, 0, 0)
            }
            WaitNull(ExplosionDelay)
        } while (1)
    }
}

state Willy_FireLazer { // 17
    stateflag 0x1
    statusc 0x2
    event => state Coco_FireLazer
    code() {
        zindex = 40
        roty = -80deg
        statusb = FLAG_ROT_Y | FLAG_NO_CAMERA_CLIP
        troty = roty
        trotx = 180deg
        do (EndingTriggered = false) {
            playframes(WILLY_STAND, 0.0, 17.0)
        } while (!EndingTriggered)
        troty = -250deg
        interrupter = objectget(SisEndingOBJ)
        sendevent(EventTriggered, interrupter)
        sendevent(EventTriggered, player)
        playframes(WILLY_JUMP, 0.0, 40.0)
        troty = -250deg
        playanim(0, WILLY_LOOK)
        playanim(1, WILLY_LOOK)
        playanim(2, WILLY_LOOK)
        playanim(3, WILLY_LOOK)
        playanim(4, WILLY_LOOK)
        playanim(4, WILLY_LOOK)
        playanim(5, WILLY_LOOK)
        sleep()
    }
}

state Coco_FireLazer { // 18
    stateflag 0x1
    statusc 0x2
    code() {
        roty = -50deg
        zindex = 40
        statusb = FLAG_NO_CAMERA_CLIP
        do (EndingTriggered = false) { 
            playanim(0, SIS_STAND) 
        } while (!EndingTriggered)
        playframes(SIS_STAND, 0.0, 17.0)
        sleep()
    }
    event(e,a) {
        accevif (e == EventTriggered) {
            EndingTriggered = true
        }
    }
}

state Brio_Ending { // 19
    stateflag 0x1
    statusc 0x2
    code() {
        SetVFX2D()
        soundpitch(3.263)
        sounddecay(10.2s)
        soundplay([EHBEA], 1V)
        vfx &= 0xFFFFFF00
        roty = 60deg
        statusb = FLAG_NO_CAMERA_CLIP
        do (var i = 0) {
