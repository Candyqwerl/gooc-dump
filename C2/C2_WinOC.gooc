    statusc 0x2
    code(id) {
        spawn(FruiC, FruiC_S_GEM, 1, id, -0xCCC, -8.0, 0)
        creator = objectspawned
        sleepnull()
    }
    event(e, a) {
        accevif (e == EventDespawn) {
            KillEntity()
            sendevent(Event12, creator)
        }
    }
}

