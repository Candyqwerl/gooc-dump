state Crab { // 22
    stateflag 0x5
    statusc 0x0
    code() {
        statusb = FLAG_TRACK_PATH_SIGN | 0x800 | 0x2000
        yzapproach = 90deg
        zindex = 14
        do {
            playanim(0, CRAB)
            playanim(1, CRAB)
            playanim(2, CRAB)
            playanim(3, CRAB)
            playanim(4, CRAB)
            playanim(5, CRAB)
            soundpitch(3.6 + rand(0.8))
            soundplay([CC1FA], 0.3V)
            playanim(6, CRAB)
            playanim(7, CRAB)
            playanim(8, CRAB)
            playanim(9, CRAB)
            playanim(10, CRAB)
            playanim(11, CRAB)
            playanim(12, CRAB)
            playanim(13, CRAB)
            playanim(14, CRAB)
            playanim(15, CRAB)
            soundpitch(3.6 + rand(0.8))
            soundplay([CC2FA], 0.3V)
            playanim(16, CRAB)
            playanim(17, CRAB)
            playanim(18, CRAB)
        } while (1)
