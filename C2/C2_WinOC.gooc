event Event12 => state Kill

var SeagullCall, SeagullCallDelay, SeagullOrbitRadius, SeagullOrbitSpeed

expr WillyEndingOBJ = 100.0
expr SisEndingOBJ = 101.0

expr CreditPhase = var0
expr CreditOffset = vely
expr ExplosionDelay = var0
expr EndingTriggered = var0

state Credit_Line_Init { // 0
    stateflag 0x1
    statusc 0x0
    code(frame, offset, mode) {
        SetVFX2D()
        statusb = FLAG_INVISIBLE | FLAG_STRING_CENTER
        zindex = 8000
        if (mode == 1) {
            SetScale(0xA3, 0x81, 0x1000)
            SetTextColor(0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF)
        }
        else if (mode == 2) {
            TextDefaultScale()
            SetTextColor(0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF)
        }
        else {
            SetTextColor(0x1FF, 0x1FF, 0x1FF, 0xC8, 0xC8, 0xC8)
            TextDefaultScale()
        }
        setanim(TEXT)
        CreditOffset = offset
        y = parent -> y - CreditOffset
        sleepframe(frame)
    }
    trans {
        nofirst {
            y = parent -> y - CreditOffset
            if (y > -140.0) {
                statusb &= ~FLAG_INVISIBLE
                changestateif(Kill, y > 140.0)
            }
        }
    }
}

state Credit_Line { // 1
    stateflag 0x1
    statusc 0x0
    code(skip) {
        CreditPhase = true
        SetVFX2D()
        statusb = FLAG_INVISIBLE
        SetTrans(0, -200.0, 0)
        SetRot(0deg)
        tpc = 0
        if (!skip) {
            settrans(__Credit_Line_TRANS)
            MakeCreditLines()
            CreditPhase = false
        }
        sleepnull()
    }
    event(e, a) {
        accevcstate(Kill, e == Event12)
    }
    trans {
        nofirst {
            y = spd(y, 50.0)
            unless (child || CreditPhase) {
                CreditPhase = 2
                FADEAMOUNT = 16
                FadeToBlack()
                statetime = frametime
            }
            if (CreditPhase == 2 && frametime - statetime >= 1s) {
                GLOBAL_17 = 3.0
                GLOBAL_131 = 0
                if (LEVEL == LEVEL_GameEnd) {
                    loadlevel(LEVEL_WarpRoom)
                }
                else {
                    loadlevel(LEVEL_Title)
                }
                CreditPhase = true
            }
        }
    }
}

inline sub SpawnCreditLine(frame, offset, mode) {
    spawn(WinOC, S_CREDIT_TEXT, 1, frame, offset, mode)
    playnull(10)
}

