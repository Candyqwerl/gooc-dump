        } while ({ i += 1.0 }; i < 16.0)

        if (var lang = GLOBAL_151; lang == LANG_FR) {
            spawn2(9, 44, 1, [W10FO], [W11FO], 2.0, 1000s, 8.0)
        }
        else if (lang == LANG_DE) {
