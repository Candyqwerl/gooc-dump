        }
        else if (lang == LANG_IT) {
            spawn2(9, 44, 1, [W10IO], [W11IO], 2.0, 1000s, 8.0)
        }
        else {
            spawn2(9, 44, 1, [W10EO], [W11EO], 2.0, 1000s, 8.0)
        }
        playanim(0, BRIO_1, 50)
        playanim(0, BRIO_1, 50)
        sendevent(EventTriggered, child)
        playframes(BRIO_1, 0.0, 165.0)
        interrupter = objectget(WillyEndingOBJ)
        sendevent(EventTriggered, interrupter)
        playframes(BRIO_2, 0.0, 49.0)
        sleep()
    }
}

