state Ship_Light { // 10
    stateflag 0x1
    statusc 0x2
    code() {
        changestateif(Ship_Explosions, LEVEL == LEVEL_GameWin)
        SetScale(0.5S)
        vfx = (vfx & 0xFFFFFF00) | 0x2
        zindex = 20
        do {
            playframes(SHIP_LIGHT, 0.0, 8.0)
            playframe(animframe, 23)
        } while (1)
    }
}

state Title_Gem { // 11
