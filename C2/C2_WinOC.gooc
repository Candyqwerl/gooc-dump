state Beach_Master { // 2
    stateflag 0x1
    statusc 0x2
    code() {
        spawn(WinOC, S_WAVES, 1, 6.0)
        spawn(WinOC, S_SEAGULL, 1, 1)
        spawn(WinOC, S_SEAGULL, 1, 2)
        spawn(WinOC, S_SEAGULL, 1, 1 + rand(2))
        zindex = 400
        statusb = FLAG_NO_CAMERA_CLIP
        do {
            soundpitch(3.6 + rand(0.8))
            soundplay([Su1FA], 0.3V + rand(0.4V))
            playframes(WAVES, 0.0, 127.0)
        } while (1)
    }
    trans {
        unless (STATUS_FIRSTFRAME) {
            calcpath(loopseek(pathprog, pathlen, 1.0))
            y += 40.0
        }
    }
}

state Waves { // 3
    stateflag 0x1
    statusc 0x2
    code(prog) {
        zindex = 300
        entity = parent -> entity
        pathlen = parent -> pathlen
        pathprog = prog
        statusb = FLAG_NO_CAMERA_CLIP
        playframes(WAVES, 124.0, 127.0)
        sleepframes(WAVES, 0.0, 127.0)
    }
    trans {
        unless (STATUS_FIRSTFRAME) {
            calcpath(loopseek(pathprog, pathlen, 1.0))
            y += 40.0
            x += 1m
        }
    }
}

state SeaGull_Sound { // 4
    stateflag 0x1
    statusc 0x2
    code(call) {
        SeagullCall = call
        vecx = parent -> x + randi(-10m, 10m)
        vecz = parent -> z + randi(-6m, 6m)
        vecy = parent -> y + 7m
        troty = rand(360deg)
        SeagullOrbitRadius = 10m + rand(6m)
        SeagullOrbitSpeed = 2deg + rand(5deg)
        if (!rand(2)) {
            SeagullOrbitSpeed = -SeagullOrbitSpeed
        }
        statusb = FLAG_INVISIBLE
        do {
            SeagullCallDelay = 3s + rand(6s)
            WaitNull(SeagullCallDelay)
            if (var kind = SeagullCall; kind == 1) {
                soundpitch(3.6 + rand(0.8))
                soundplay([SG2FA], 0.1V + rand(0.3V))
            }
            else if (kind == 2) {
                soundpitch(3.6 + rand(0.8))
                soundplay([SG4FA], 0.1V + rand(0.3V))
            }
        } while (1)
    }
    trans {
        nofirst {
            troty += SeagullOrbitSpeed
            vectransf2(vvec, vtrans, 0, SeagullOrbitRadius, 0)
        }
    }
}

state Sis_GameEnd { // 5
    stateflag 0x40001
    statusc 0x2
    code() {
        GLOBAL_74 = 0
        SetVFX2D()
        playnull(42)
        playnull(42)
        if (var lang = GLOBAL_151; lang == LANG_FR) {
            spawn(9, 44, 1, [W00FO], [W01FO], 2.0, 0x64, 8.0)
        }
        else if (lang == LANG_DE) {
            spawn(9, 44, 1, [W00GO], [W01GO], 2.0, 0x64, 8.0)
        }
        else if (lang == LANG_ES) {
            spawn(9, 44, 1, [W00SO], [W01SO], 2.0, 0x64, 8.0)
        }
        else if (lang == LANG_IT) {
            spawn(9, 44, 1, [W00IO], [W01IO], 2.0, 0x64, 8.0)
        }
        else {
            spawn(9, 44, 1, [W00EO], [W01EO], 2.0, 0x64, 8.0)
        }
        soundpitch(3.263)
        sounddelay(15s)
        soundplay([SBLFA], 1V)
        WaitNull(27s)
        soundfadet(1s, voice)
        soundfadev(0V, voice, 3)
        spawn(WinOC, S_CREDIT, 1, 0)
        WaitNull(13s)
        FADEAMOUNT = 8
        FadeToBlack()
        WaitFadeNull()
        GAMEFLAGS &= ~0x1
        sleepnull()
    }
}

state Win_Master { // 6
    stateflag 0x40001
    statusc 0x2
    code() {
        SetVFX2D()
        GLOBAL_74 = 0
        playnull(42)
        playnull(42)
        WaitNull(10s)
        WaitNull(32s)
        spawn2(WinOC, S_CREDIT, 1, 0)
        sleepnull()
    }
    event(e, a) {
        accevif (e == EventTriggered) {
            soundpitch(4.353)
            sounddelay(0.8s)
            sounddecay(10.2s)
            soundplay([RRSEA], 1V)
        }
        accevif (e == Event14) {
            soundfadet(0.5s, voice)
            soundfadev(0V, voice, 3)
        }
    }
}

state Kill { // 7
    stateflag 0x22
    statusc 0x0
    code() {}
}

state Sis_Ending { // 8
    stateflag 0x1
    statusc 0x2
    code() {
        changestateif(Coco_FireLazer, LEVEL == LEVEL_GameWin)
        roty = -20deg
        zindex = 40
        playframes(SIS_LAPTOP_1, 0.0, 132.0)
        playframes(SIS_LAPTOP_2, 0.0, 152.0)
        sleep()
    }
}

state Willy_Ending { // 9
