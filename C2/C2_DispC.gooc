var mem1, mem2, mem3, mem4, mem5, mem6, mem7, mem8, mem9, mem10,
    DisplayFrame, DisplayVarField, DisplayStatus,
    DisplayVar14, DisplayVar15, ClearGemCount, ActiveDisplayOBJCount

expr REWARD_GEM            = 300.0
expr REWARD_GEM_SPECIAL    = 301.0
expr REWARD_CRYSTAL        = 200.0
expr GEM_RED               = 58.0
expr GEM_GREEN             = 59.0
expr GEM_PURPLE            = 60.0
expr GEM_BLUE              = 61.0
expr GEM_YELLOW            = 62.0

expr DISPLAY_BOUND_Y       = 190.0
expr DISPLAY_BOUND_LOWER_Y = 102.0

expr DisplayRequestMode      = DisplayStatus
expr DisplaySlideY           = vecy
expr DisplayOffsetY          = vecz
expr BonusTargetY            = vely

expr TextFrame               = yzapproach
expr MenuButtonIndex         = stalltime
expr MenuButtonCount         = field_61
expr MenuLevelNumber         = DisplayFrame
expr MenuHasLevelNumber      = field_62

expr CompletionPercent       = DisplayVarField
expr CompletedLevelCount     = DisplayStatus
expr CrystalCount            = DisplayVar14
expr TotalGemCount           = DisplayVar15
expr ExtraCompletionCount    = groundy

expr PauseNameValue          = ActiveDisplayOBJCount
expr PauseSavedGameFlags     = stalltime

expr DisplayRewardType       = DisplayVar14
expr CollectedRewardID       = DisplayVar14
expr CollectedRewardParentID = DisplayVar15

expr TrialTimeLimit          = var0
expr TrialTriggerZ           = field_61
expr TrialStartWindow        = vecy
expr TrialRemainingTime      = vecx

state HUD_Life_Display { // 0
    code() {
        LIFEICONTRANSX = 100.0
        statusb = FLAG_NO_CAMERA_CLIP
        SetVFX2D()
        SetScale(3.2, 2.0, 2.0)
        x = 130.0
        DisplaySlideY = DISPLAY_BOUND_Y
        z = 0
        DisplayFrame = 0
        DisplayVarField = offsetof(mem2)
        DisplayRequestMode = 0
        DisplayOffsetY = 0
        playanim(0, LIFE_ICON, 0.18s)
        setfield(self, DisplayVarField, getfield(player, DisplayVarField))
        changestate(Display_Hidden)
    }
}

state HUD_Wumpa_Display { // 1
    code() {
        statusb = FLAG_NO_CAMERA_CLIP
        SetVFX2D()
        SetScale(1.6, 2.0, 2.0)
        x = -200.0
        DisplaySlideY = DISPLAY_BOUND_Y
        z = 0
        DisplayFrame = 0
        DisplayVarField = offsetof(mem1)
        DisplayRequestMode = 0
        DisplayOffsetY = 0
        playanim(0, FRUIT_WUMPA, 0.18s)
        setfield(self, DisplayVarField, getfield(player, DisplayVarField))
        changestate(Display_Hidden)
    }
}

state HUD_Box_Display { // 2
    code() {
        statusb = FLAG_NO_CAMERA_CLIP
        vfx = (vfx & 0xFFFFFF00) | 14
        vfx = (vfx & 0xFF00FFFF) | 0x40000
        SetScale(1.5, 1.2, 1.5)
        x = -40.0
        DisplaySlideY = DISPLAY_BOUND_Y
        z = 0
        setanim(BOX_DISPLAY)
        DisplayFrame = 0
        DisplayVarField = offsetof(mem10)
        DisplayRequestMode = 0
        DisplayOffsetY = -10.0
        rotx = 40deg
        moda = 4.0
        SetColor2(-0xDD8, 0x6D7, 0x432)
        SetColor1(0x80, 0x80, 0x80)
        playframe(DisplayFrame, 0.18s)
        setfield(self, DisplayVarField, getfield(player, DisplayVarField))
        changestate(Display_Hidden)
    }
}

inline sub DisplaySleep() {
    if (spawn == S_WUMPA_DISPLAY || spawn == S_BONUS_WUMPA_DISPLAY) {
        do {
            animframe = (animframe + 1.0) % 14.0
            playframe()
        } while (1)
    }
    else {
        sleepframe(DisplayFrame)
    }
}

state Display_Hidden { // 3
    statusc 0
    code() {
        statusb |= FLAG_INVISIBLE
        DisplaySleep()
    }
    event(e, a) {
        if (e == Event3 || e == Event32 || e == Event17) {
            if (DisplayRequestMode != 1) {
                DisplayRequestMode = 2
            } 
            statetime = frametime
            if (e == Event17) {
                DisplayRequestMode = 1
            }
        }
    }
    trans {
        sendeventif(Event12, child, STATUS_FIRSTFRAME, self)
        v0 = getfield(player, DisplayVarField)
        if (!(v0 == getfield(self, DisplayVarField) || spawn == S_BOX_DISPLAY) || (buttonhold(PAD_TRIANGLE) || DisplayRequestMode)) {
            spawn2(DispC, S_VARIABLE_DISPLAY, 1, 32, -12.0, 16.0 - DisplayOffsetY, 40.0)
            changestate(Display_Show)
        }
    }
}

state Display_Show { // 4
    statusc 0
    event => state Display_Hidden
    code() {
        statusb &= ~FLAG_INVISIBLE
        DisplaySleep()
    }
    trans {
        once {
            if (spawn == S_BOX_DISPLAY) {
                settrans(BoxDisplayTrans)
                BoxDisplayTrans()
                return
            }
        }
        changestateif(Display_Hide, frametime - statetime >= 1.5s)
        DisplaySlideY = seek(DisplaySlideY, DISPLAY_BOUND_LOWER_Y, 10.0)
        if (DisplaySlideY == DISPLAY_BOUND_LOWER_Y) {
            if (getfield(player, DisplayVarField) > getfield(self, DisplayVarField)) {
                unless (time(3)) {
                    statetime = frametime
                    if (spawn == S_WUMPA_DISPLAY) {
                        soundpitch(4.0)
                        soundsetup(0, 0, 11)
                        sounddecay(2.6s)
                        soundplay([tal0A], 0.2V)
                    }
                    setfield(self, DisplayVarField, getfield(self, DisplayVarField) + 1.0)
                }
            }
            else {
                setfield(self, DisplayVarField, getfield(player, DisplayVarField))
            }
            if (DisplayRequestMode == 1) {
                interrupter = child
                spawn2(FruiC, FruiC_S_1UP_GOTO_HUD, 1)
                if (interrupter == child) {
                    player -> mem2 += 1.0
                }
                DisplayRequestMode = 0
            }
            else {
                DisplayRequestMode = 0
            }
        }
        y = DisplaySlideY + DisplayOffsetY
    }
}

sub BoxDisplayTrans() {
    if (getfield(self, DisplayVarField) < 10.0) {
        x = -40.0
    }
    else if (getfield(self, DisplayVarField) < 100.0) {
        x = -66.0
    }
    else {
        x = -82.0
    }
    roty = spd(roty, 180deg)
    changestateif(Display_Hide, frametime - statetime >= 1.5s)
    DisplaySlideY = seek(DisplaySlideY, DISPLAY_BOUND_LOWER_Y, 10.0)
    setfield(self, DisplayVarField, getfield(player, DisplayVarField))
    if (DisplaySlideY == DISPLAY_BOUND_LOWER_Y) {
        DisplayRequestMode = 0
    }
    y = DisplaySlideY + DisplayOffsetY
}

state Display_Hide { // 5
    statusc 0
    code => state Display_Show
    event => state Display_Hidden
    trans {
        v0 = getfield(player, DisplayVarField)
        changestateif(Display_Show, v0 != getfield(self, DisplayVarField) || buttonhold(PAD_TRIANGLE) || DisplayRequestMode)
        if (DisplaySlideY < DISPLAY_BOUND_Y) {
            DisplaySlideY += 4.0
        }
        else {
            changestate(Display_Hidden)
        }
        y = DisplaySlideY + DisplayOffsetY
    }
}

state Variable_Display { // 6
    stateflag 0x40001
    event => state Menu_Button
    code(size, basex, yoff, xoff) {
        playnull()
        if (size == 0x10) {
            invincible = FONT_SMALL
            TextDefaultScale()
        }
        else {
            invincible = FONT_BIG
            SetScale(0x146, 0x207, 16.0)
        }
        velx = basex + xoff
        z = parent -> z
        SetVFX2D()
        SetRot(0deg)
        if (parent -> spawn == S_WUMPA_DISPLAY || parent -> spawn == S_BONUS_WUMPA_DISPLAY) {
            SetColor1(0x1FF, 0x000, 0x000)
            SetColor2(0x1FF, 0x1FF, 0x000)
            SetColor3(0x1FF, 0x1FF, 0x000)
            SetColor4(0x000, 0x17C, 0x000)
        }
        else if (parent -> spawn == S_BOX_DISPLAY || parent -> spawn == S_BONUS_BOX_DISPLAY) {
            SetColor1(0xAC, 0x4E, 0x0C)
            SetColor2(0x9D, 0x3F, 0x09)
            SetColor3(0x8E, 0x30, 0x06)
            SetColor4(0x78, 0x28, 0x06)
        }
        else {
            TextColorDefault()
        }
        do {
            statusb = parent -> statusb
            x = parent -> x + velx
            y = parent -> y + yoff
            var v1 = getfield(parent, parent -> DisplayVarField) >> 8
            setanim(TEXT)
            playframe(0)
        } while (1)
    }
}

state HUD_Bonus_Wumpa_Display { // 7
    stateflag 0x40001
    code() {
        movetolist(1.0)
        SetRot(0deg)
        statusb = FLAG_NO_CAMERA_CLIP
        SetVFX2D()
        SetScale(0.8, 1.0, 1.0)
        x = -200.0
        y = -DISPLAY_BOUND_Y
        BonusTargetY = -DISPLAY_BOUND_LOWER_Y
        z = 0
        setanim(FRUIT_WUMPA)
        DisplayFrame = 0
        DisplayVarField = offsetof(mem4)
        spawn(DispC, S_VARIABLE_DISPLAY, 1, 0x10, -8.0, 8.0, 20.0)
        setfield(self, DisplayVarField, getfield(player, DisplayVarField))
        changestate(Bonus_Variable_Update)
    }
}

state HUD_Bonus_Life_Display { // 8
    stateflag 0x40001
    code() {
        movetolist(1.0)
        SetRot(0deg)
        spawn(DispC, S_BONUS_TEXT, 1, 0, 0x7000)
        statusb = FLAG_NO_CAMERA_CLIP
        SetVFX2D()
        SetScale(1.6, 1.0, 1.0)
        x = 170.0
        y = -DISPLAY_BOUND_Y
        BonusTargetY = -DISPLAY_BOUND_LOWER_Y
        z = 0
        setanim(LIFE_ICON)
        DisplayFrame = 0
        DisplayVarField = offsetof(mem5)
        spawn(DispC, S_VARIABLE_DISPLAY, 1, 0x10, -8.0, 8.0, 20.0)
        setfield(self, DisplayVarField, getfield(player, DisplayVarField))
        changestate(Bonus_Variable_Update)
    }
}

