        vfx = (vfx & 0xFF00FFFF) | 0x40000
        moda = 4.0
        SetColor2(-0xDD8, 0x6D7, 0x432)
        SetColor1(0x80, 0x80, 0x80)
        SetScale(1.0, 0.8, 1.0)
        x = -20.0
        y = -DISPLAY_BOUND_Y
        BonusTargetY = -DISPLAY_BOUND_LOWER_Y
        z = 0
        setanim(BOX_DISPLAY)
        DisplayFrame = 0
        DisplayVarField = offsetof(mem6)
        spawn(DispC, S_VARIABLE_DISPLAY, 1, 0x10, 4.0, 8.0, 0x1400)
        setfield(self, DisplayVarField, getfield(player, DisplayVarField))
        changestate(Bonus_Variable_Update)
    }
}

state Bonus_Variable_Update { // 10
    stateflag 0x40001
    statusc 0
    code() {
        DisplaySleep()
    }
    event(e, a) {
        if (e == Event73) {
            if (a[0] == BONUS_COMPLETED) {
                accevcstate(Bonus_Reward_Items)
            }
            else {
                accevcstate(Bonus_Player_Death)
            }
        }
    }
    trans {
        y = seek(y, BonusTargetY, 10.0)
        if (y == BonusTargetY) {
            if (getfield(player, DisplayVarField) > getfield(self, DisplayVarField)) {
                if (!time(3)) {
                    statetime = frametime
                    if (spawn == S_BONUS_WUMPA_DISPLAY) {
                        soundpitch(4.0)
                        soundsetup(0, 0, 11)
                        sounddecay(2.6s)
                        soundplay([tal0A], 0.2V)
                    }
                    setfield(self, DisplayVarField, getfield(self, DisplayVarField) + 1.0)
                }
            }
            else {
                setfield(self, DisplayVarField, getfield(player, DisplayVarField))
            }
        }
        if (spawn == S_BONUS_BOX_DISPLAY) {
            roty = spd(roty, 180deg)
        }
    }
}

inline sub PlayDisplayFrame() {
    if (spawn == S_WUMPA_DISPLAY || spawn == S_BONUS_WUMPA_DISPLAY) {
        animframe = (animframe + 1.0) % 14.0
        playframe()
    }
    else {
        playframe(DisplayFrame)
    }
}

state Bonus_Reward_Items { // 11
    stateflag 0x40001
    statusc 0
    trans => state Bonus_Variable_Update
    code() {
        while (getfield(self, DisplayVarField) > 0) {
            if (spawn == S_BONUS_LIFE_DISPLAY) {
                interrupter = child
                save (scalex) {
                    scalex >>= 1
                    spawn2(FruiC, FruiC_S_1UP_GOTO_HUD, 1)
                }
                if (interrupter == child) {
                    player -> mem2 += 1.0
                }
                setfield(player, DisplayVarField, getfield(player, DisplayVarField) - 1.0)
                v0 = 0.35s
            }
            else {
                if (spawn == S_BONUS_WUMPA_DISPLAY) {
                    interrupter = child
                    spawn2(FruiC, FruiC_S_WUMPA_BONUS_GOTO_HUD, 1)
                    if (interrupter == child) {
                        player -> mem2 += 1.0
                    }
                    setfield(player, DisplayVarField, getfield(player, DisplayVarField) - 1.0)
                    v0 = 0.15s
                }
                else if (spawn == S_BONUS_BOX_DISPLAY) {
                    sendevent(EventBoxBreak, player, self)
                    setfield(player, DisplayVarField, getfield(player, DisplayVarField) - 1.0)
                    interrupter = BOXCOUNTER
                    sendevent(Event32, interrupter, 0)
                    v0 = 0.35s
                }
            }
            do (var startframe = frametime) {
                PlayDisplayFrame()
            } while (frametime - startframe < v0)
        }
        BonusTargetY = -DISPLAY_BOUND_Y
        do {
            PlayDisplayFrame()
        } while (y != BonusTargetY)
    }
}

state Bonus_Player_Death { // 12
    stateflag 0x40001
    statusc 0
    trans => state Bonus_Variable_Update
    code() {
        while (getfield(self, DisplayVarField) > 0) {
            if (spawn == S_BONUS_WUMPA_DISPLAY) {
                spawn(FruiC, FruiC_S_FRUIT_BONUS_DEAD, 1, 76.0)
            }
            else if (spawn == S_BONUS_LIFE_DISPLAY) {
                spawn(FruiC, FruiC_S_FRUIT_BONUS_DEAD, 1, 97.0)
            }
            setfield(self, DisplayVarField, getfield(self, DisplayVarField) - 1.0)
            PlayDisplayFrame()
            BONUSDEATHTIME = frametime
        }
        BonusTargetY = -DISPLAY_BOUND_Y
        do {
            BONUSDEATHTIME = frametime
            PlayDisplayFrame()
        } while (y != BonusTargetY)
    }
}

expr BONUS_B = 2.0
expr BONUS_BO = 3.0
expr BONUS_BON = 4.0
expr BONUS_BONU = 5.0
expr BONUS_BONUS = 1.0

inline sub DisplayBonusText(frame, t) {
    setanim(TEXT)
    playframe(frame, t)
}

state Bonus_Text { // 13
    code(px, py) {
        SetTrans(px, py, 0)
        SetScale(0x146, 0x207, 0x1000)
        invincible = FONT_BIG
        SetColor1(0x000, 0x1F4, 0x000)
        SetColor2(0x000, 0x1F4, 0x000)
        SetColor3(0x000, 0x190, 0x096)
        SetColor4(0x000, 0x190, 0x096)
        statusb = FLAG_STRING_CENTER
        zindex = 1000
        v0 = 0
        do {
            SetVFX2D()
            v0 = (v0 + 1) % 7
            if (v0 == 0 || v0 == 1) {
                setanim(TEXT)
                playframe(BONUS_BONUS, 0.4s)
                vfx = (vfx & 0xFFFFFF00) | 0x1
                setanim(TEXT)
                playframe(BONUS_BONUS, 0.18s)
            }
            else if (v0 == 2) DisplayBonusText(BONUS_B, 0.25s);
            else if (v0 == 3) DisplayBonusText(BONUS_BO, 0.25s);
            else if (v0 == 4) DisplayBonusText(BONUS_BON, 0.25s);
            else if (v0 == 5) DisplayBonusText(BONUS_BONU, 0.25s);
            else if (v0 == 6) DisplayBonusText(BONUS_BONUS, 0.25s);
            vfx = (vfx & 0xFFFFFF00) | 0x1
            DisplayBonusText(BONUS_BONUS, 2)
        } while (1)
    }
    event(e, a) {
        accevcstate(Display_Kill, e == Event73)
    }
}

sub SetLevelID(level) {
    misc = 0
    if (level == LEVEL_Intro)          misc = 0;
    if (level == LEVEL_WarpRoom)       misc = 0;
 
    if (level == LEVEL_TurtleWoods)    misc = 1;
    if (level == LEVEL_SnowGo)         misc = 2;
    if (level == LEVEL_HangEight)      misc = 3;
    if (level == LEVEL_ThePits)        misc = 4;
    if (level == LEVEL_CrashDash)      misc = 5;
 
    if (level == LEVEL_SnowBiz)        misc = 6;
    if (level == LEVEL_AirCrash)       misc = 7;
    if (level == LEVEL_BearIt)         misc = 8;
    if (level == LEVEL_CrashCrush)     misc = 9;
    if (level == LEVEL_TheEelDeal)     misc = 10;
 
    if (level == LEVEL_PlantFood)      misc = 11;
    if (level == LEVEL_SewerOrLater)   misc = 12;
    if (level == LEVEL_BearDown)       misc = 13;
    if (level == LEVEL_RoadToRuin)     misc = 14;
    if (level == LEVEL_Unbearable)     misc = 15;

    if (level == LEVEL_HanginOut)      misc = 16;
    if (level == LEVEL_DigginIt)       misc = 17;
    if (level == LEVEL_ColdHardCrash)  misc = 18;
    if (level == LEVEL_Ruination)      misc = 19;
    if (level == LEVEL_BeeHaving)      misc = 20;

    if (level == LEVEL_PistonItAway)   misc = 21;
    if (level == LEVEL_RockIt)         misc = 22;
    if (level == LEVEL_NightFight)     misc = 23;
    if (level == LEVEL_PackAttack)     misc = 24;
    if (level == LEVEL_SpacedOut)      misc = 25;

    if (level == LEVEL_TotallyBear)    misc = 26;
    if (level == LEVEL_TotallyFly)     misc = 27;

    if (level == LEVEL_BossRipperRoo)  misc = -1;
    if (level == LEVEL_BossKimodo)     misc = -2;
    if (level == LEVEL_BossTazTiger)   misc = -3;
    if (level == LEVEL_BossNGin)       misc = -4;
    if (level == LEVEL_BossCortex)     misc = -5;
}

