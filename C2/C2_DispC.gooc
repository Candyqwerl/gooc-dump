    if (level == LEVEL_WarpRoom)       misc = 8.0;
  
    if (level == LEVEL_TurtleWoods)    misc = 9.0;
    if (level == LEVEL_SnowGo)         misc = 10.0;
    if (level == LEVEL_HangEight)      misc = 11.0;
    if (level == LEVEL_ThePits)        misc = 12.0;
    if (level == LEVEL_CrashDash)      misc = 13.0;
  
    if (level == LEVEL_SnowBiz)        misc = 14.0;
    if (level == LEVEL_AirCrash)       misc = 15.0;
    if (level == LEVEL_BearIt)         misc = 16.0;
    if (level == LEVEL_CrashCrush)     misc = 17.0;
    if (level == LEVEL_TheEelDeal)     misc = 18.0;
  
    if (level == LEVEL_PlantFood)      misc = 19.0;
    if (level == LEVEL_SewerOrLater)   misc = 20.0;
    if (level == LEVEL_BearDown)       misc = 21.0;
    if (level == LEVEL_RoadToRuin)     misc = 22.0;
    if (level == LEVEL_Unbearable)     misc = 23.0;
  
    if (level == LEVEL_HanginOut)      misc = 24.0;
    if (level == LEVEL_DigginIt)       misc = 25.0;
    if (level == LEVEL_ColdHardCrash)  misc = 26.0;
    if (level == LEVEL_Ruination)      misc = 27.0;
    if (level == LEVEL_BeeHaving)      misc = 28.0;

    if (level == LEVEL_PistonItAway)   misc = 29.0;
    if (level == LEVEL_RockIt)         misc = 30.0;
    if (level == LEVEL_NightFight)     misc = 31.0;
    if (level == LEVEL_PackAttack)     misc = 32.0;
    if (level == LEVEL_SpacedOut)      misc = 33.0;

    if (level == LEVEL_TotallyBear)    misc = 34.0;
    if (level == LEVEL_TotallyFly)     misc = 35.0;
 
    if (level == LEVEL_BossRipperRoo)  misc = 36.0;
    if (level == LEVEL_BossKimodo)     misc = 37.0;
    if (level == LEVEL_BossTazTiger)   misc = 38.0;
    if (level == LEVEL_BossNGin)       misc = 39.0;
    if (level == LEVEL_BossCortex)     misc = 40.0;
}

inline sub SetTextLanguage1(german, spanish, italian, french, english) {
    if (var lang = GLOBAL_151; lang == LANG_DE) {
        TextFrame = german
    }
    else if (lang == LANG_ES) {
        TextFrame = spanish
    }
    else if (lang == LANG_IT) {
        TextFrame = italian
    }
    else if (lang == LANG_FR) {
        TextFrame = french
    }
    else {
        TextFrame = english
    }
}

inline sub SetTextLanguage2(german, spanish, italian, english) {
    if (var lang = GLOBAL_151; lang == LANG_DE) {
        TextFrame = german
    }
    else if (lang == LANG_ES) {
        TextFrame = spanish
    }
    else if (lang == LANG_IT) {
        TextFrame = italian
    }
    else {
        TextFrame = english
    }
}

inline sub KillDisplayChildren() {
    if (child) {
        cascadeevent(Event12, self)
        playnull()
    }
}

state Pause_Menu_Root { // 14
    stateflag 0x100001
    code() {
        KillDisplayChildren()
        TextColorDefault()
        zindex = creator -> zindex
        if (player -> stateflag & 0x20) {
            MenuButtonCount = 2.0
        }
        else {
            MenuButtonCount = 3.0
        }
        SetLevelName(LEVEL)
        spawn2(DispC, S_MENU_TEXT, 1, getanim(TEXT), misc, x - 80.0, -4.0, 0, 6.0, offsetof(MenuLevelNumber)) // Level name
        SetLevelID(LEVEL)
        MenuLevelNumber = misc
        if (MenuLevelNumber) {
            MenuHasLevelNumber = MenuLevelNumber > 0
            if (var lang = GLOBAL_151; lang == LANG_DE) {
                if (MenuHasLevelNumber) {
                    TextFrame = 41.0
                }
                else {
                    TextFrame = 42.0
                }
            }
            else if (lang == LANG_ES) {
                if (MenuHasLevelNumber) {
                    TextFrame = 43.0
                }
                else {
                    TextFrame = 44.0
                }                
            }
            else if (lang == LANG_IT) {
                if (MenuHasLevelNumber) {
                    TextFrame = 44.0
                }
                else {
                    TextFrame = 42.0
                }                   
            }
            else if (lang == LANG_FR) {
                if (MenuHasLevelNumber) {
                    TextFrame = 46.0
                }
                else {
                    TextFrame = 47.0
                }                   
            }
            else {
                if (MenuHasLevelNumber) {
                    TextFrame = 48.0
                }
                else {
                    TextFrame = 42.0
                }                   
            }
            spawn2(DispC, S_MENU_TEXT, 1, getanim(TEXT), TextFrame, x - 80.0, -23.0, 0, 0, offsetof(MenuLevelNumber)) // Level ID
            MenuLevelNumber = abs(MenuLevelNumber)
        }
        statusb = FLAG_NO_CAMERA_CLIP | FLAG_STRING_CENTER
        SetTextLanguage1(49.0, 50.0, 51.0, 52.0, 53.0)
        spawn(DispC, S_MENU_BUTTON, 1, 0, getanim(TEXT), TextFrame, 0, 0, 0) // Resume button
        SetTextLanguage2(54.0, 55.0, 56.0, 57.0)
        spawn2(DispC, S_MENU_BUTTON, 1, 1.0, getanim(TEXT), TextFrame, 0, -18.0, 0) // Options button
        if (MenuButtonCount >= 3.0) {
            SetTextLanguage1(58.0, 59.0, 60.0, 61.0, 62.0)
            if (LEVEL == LEVEL_WarpRoom) {
                spawn2(DispC, S_MENU_BUTTON, 1, 2.0, getanim(TEXT), TextFrame, 0, -36.0, 0) // Quit button
            }
            else {
                spawn2(DispC, S_MENU_BUTTON, 1, 2.0, getanim(TEXT), 8.0, 0, -36.0, 0) // Warp Room button
            }
        }
        sleepnull()
    }
    event(e, a) {
        accevcstate(Display_Kill, interrupter != self && e == Event12)
    }
    trans {
        once {
            TextDefaultScale()
            SetRot(0deg)
            MenuButtonIndex = 0
            MenuButtonCount = 2.0
        }
        unless (STATUS_FIRSTFRAME) {
            unless (stateflag & 0x400000) {
                if (dirpress(PAD_UP) && MenuButtonIndex > 0) {
                    MenuButtonIndex -= 1.0
                }
                if (dirpress(PAD_DOWN) && MenuButtonIndex < MenuButtonCount - 1.0) {
                    MenuButtonIndex += 1.0
                }
                if (buttonpress(PAD_X)) {
                    if (var index = MenuButtonIndex; index == 0) {
                        sendevent(Event12, parent)
                    }
                    else if (index == 1.0) {
                        changestate(Pause_Menu_Options, 0, 0, 0)
                    }
                    else if (index == 2.0) {
                        LevelExit()
                    }
                }
            }
        }
        if (buttonpress(PAD_SELECT) && LEVEL != LEVEL_WarpRoom && MenuButtonCount >= 3.0) {
            LevelExit()
        }
    }
}

sub LevelExit() {
    sendevent(Event15, player, 6.0)
    if (LEVEL == LEVEL_WarpRoom) {
        GLOBAL_114 = 0
        GLOBAL_131 = 0
        GAMEFLAGS &= ~0x2
        GLOBAL_17 = 6.0
        loadlevel(LEVEL_Title)
    }
    else {
        loadlevel(LEVEL_WarpRoom)
    }
}

state Pause_Menu_Options { // 15
    stateflag 0x100001
    event => state Pause_Menu_Root
    code(FlightControlOBJ, arg, CTR_OBJ) {
        KillDisplayChildren()
        SetVec(-100)
        field_63 = -100
        FlightControlOBJ = 0
        SetTextLanguage1(63.0, 64.0, 65.0, 66.0, 67.0)
        spawn2(DispC, S_MENU_BUTTON, 1, 0, getanim(TEXT), TextFrame, 0, 36.0, 0) // Sound options button
        MenuButtonCount = 1.0
        if (LEVEL == LEVEL_RockIt || LEVEL == LEVEL_PackAttack || LEVEL == LEVEL_BossCortex) {
            spawn2(DispC, S_MENU_BUTTON, 1, MenuButtonCount, getanim(TEXT), 68.0, 0, 18.0, 0) // Flight control button
            FlightControlOBJ = objectspawned
            vecx = MenuButtonCount
            MenuButtonCount += 1.0
        }
        if (var lang = GLOBAL_151; lang == LANG_DE) {
            TextFrame = 69.0
        }
        else if (lang == LANG_IT) {
            TextFrame = 70.0
        }
        else {
            TextFrame = 71.0
        }
        spawn2(DispC, S_MENU_BUTTON, 1, MenuButtonCount, getanim(TEXT), TextFrame, 0, ((MenuButtonCount >> 8) - 2) * -18.0, 0) // Screen centering button
        CTR_OBJ = objectspawned
        field_63 = MenuButtonCount
        MenuButtonCount += 1.0
        SetTextLanguage1(72.0, 73.0, 74.0, 75.0, 76.0)
        spawn2(DispC, S_MENU_BUTTON, 1, MenuButtonCount, getanim(TEXT), TextFrame, 0, ((MenuButtonCount >> 8) - 2) * -18.0, 0) // Calibrate button
        vecy = MenuButtonCount
        MenuButtonCount += 1.0
        SetTextLanguage1(77.0, 78.0, 79.0, 80.0, 81.0)
        spawn2(DispC, S_MENU_BUTTON, 1, MenuButtonCount, getanim(TEXT), TextFrame, 0, ((MenuButtonCount >> 8) - 2) * -18.0, 0) // Done button
        MenuButtonCount += 1.0
        UpdateOptionValue()
        sleepnull()
    }
    trans {
        once {
            TextDefaultScale()
            SetRot(0deg)
            MenuButtonIndex = 0
            MenuButtonCount = 2.0
        }
        unless (STATUS_FIRSTFRAME) {
            unless (stateflag & 0x400000) {
                if (dirpress(PAD_UP) && MenuButtonIndex > 0) {
                    MenuButtonIndex -= 1.0
                }
                if (dirpress(PAD_DOWN) && MenuButtonIndex < MenuButtonCount - 1.0) {
                    MenuButtonIndex += 1.0
                }
                if (buttonpress(PAD_X)) {
                    if (MenuButtonIndex == 0) {
                        changestate(Pause_Menu_Sound_Options, 0, 0, 0)
                    }
                    else if (MenuButtonIndex == vecx) {
                        GLOBAL_32 = GLOBAL_32 ^ 1
                    }
                    else if (MenuButtonIndex == vecz) {
                        GLOBAL_32 = GLOBAL_32 ^ 2
                    }
                    else if (MenuButtonIndex == vecy) {
                        changestate(Pause_Menu_Calibrate)
                    }
                    else {
                        changestateif(Pause_Menu_Root, MenuButtonIndex == MenuButtonCount - 1.0)
                    }
                }
            }
        }
        if (MenuButtonIndex == field_63) {
            if (dirhold(PAD_W) && GLOBAL_91 > -15) {
                GLOBAL_91 -= 1
            }
            if (dirhold(PAD_E) && GLOBAL_91 < 15) {
                GLOBAL_91 += 1
            }
        }
        unless (STATUS_FIRSTFRAME) {
            UpdateOptionValue()
        }
    }
}

sub UpdateOptionValue(FlightControlOBJ, arg, CTR_OBJ) __trans {
    interrupter = FlightControlOBJ
    field_62 = GLOBAL_32 & 1
    if (var lang = GLOBAL_151; lang == LANG_DE) {
        if (field_62) {
            interrupter -> animframe = 82.0
        }
        else {
            interrupter -> animframe = 68.0
        }
    }
    else if (lang == LANG_ES) {
        if (field_62) {
            interrupter -> animframe = 83.0
        }
        else {
            interrupter -> animframe = 84.0
        }
    }
    else if (lang == LANG_IT) {
        if (field_62) {
            interrupter -> animframe = 85.0
        }
        else {
            interrupter -> animframe = 86.0
        }
    }
    else if (lang == LANG_FR) {
        if (field_62) {
            interrupter -> animframe = 87.0
        }
        else {
            interrupter -> animframe = 88.0
        }
    }
    else {
        if (field_62) {
            interrupter -> animframe = 89.0
        }
        else {
            interrupter -> animframe = 68.0
        }
    }
    interrupter = CTR_OBJ
    interrupter -> v0 = GLOBAL_91
}

state Pause_Menu_Sound_Options { // 16
    stateflag 0x100001
    event => state Pause_Menu_Root
    code(MonoStereoOBJ, MusicVolOBJ, SFXVolOBJ) {
        KillDisplayChildren()
        if (MONOSOUND) {
            animframe = 90.0
        }
        else {
            animframe = 91.0
        }
        spawn2(DispC, S_MENU_BUTTON, 1, 0, getanim(TEXT), animframe, 0, 54.0, 0) // Mono/Stereo button
        MonoStereoOBJ = objectspawned
        spawn2(DispC, S_MENU_BUTTON, 1, 1.0, getanim(TEXT), 92.0, 0, 18.0, 0) // Music volume value
        MusicVolOBJ = objectspawned
        spawn2(DispC, S_MENU_BUTTON, 1, 2.0, getanim(TEXT), 92.0, 0, -18.0, 0) // Sound effects volume value
        SFXVolOBJ = objectspawned
        UpdateSoundOptionValue()
        if (var lang = GLOBAL_151; lang == LANG_DE) {
            TextFrame = 93.0
        }
        else if (lang == LANG_FR) {
            TextFrame = 94.0
        }
        else if (lang == LANG_ES || lang == LANG_IT) {
            TextFrame = 95.0
        }
        else {
            TextFrame = 96.0
        }
        spawn2(DispC, S_MENU_BUTTON, 1, -1.0, getanim(TEXT), TextFrame, 0, 36.0, 0) // Music volume label
        SetTextLanguage1(97.0, 98.0, 99.0, 100.0, 101.0)
        spawn2(DispC, S_MENU_BUTTON, 1, -1.0, getanim(TEXT), TextFrame, 0, 0, 0) // Sound effects volume label
        SetTextLanguage1(77.0, 78.0, 79.0, 80.0, 81.0)
        spawn2(DispC, S_MENU_BUTTON, 1, 3.0, getanim(TEXT), TextFrame, 0, -36.0, 0) // Done button
        sleepnull()
    }
    trans {
        once {
            TextDefaultScale()
            SetRot(0deg)
            MenuButtonIndex = 0
            MenuButtonCount = 4.0
        }
        unless (STATUS_FIRSTFRAME) {
            unless (stateflag & 0x400000) {
                if (dirpress(PAD_UP) && MenuButtonIndex > 0) {
                    MenuButtonIndex -= 1.0
                }
                if (dirpress(PAD_DOWN) && MenuButtonIndex < MenuButtonCount - 1.0) {
                    MenuButtonIndex += 1.0
                }
                if (buttonpress(PAD_X)) {
                    if (var index = MenuButtonIndex; index == 0) {
                        MONOSOUND = !MONOSOUND
                    }
                    else {
                        changestateif(Pause_Menu_Root, index == 3.0)
                    }
                }
            }
        }
        unless (STATUS_FIRSTFRAME) {
            if (var index = MenuButtonIndex; index == 0) {
                if (dirpress(PAD_W) || dirpress(PAD_E)) {
                    MONOSOUND = !MONOSOUND
                }
            }
            else if (index == 1.0) {
                if (dirhold(PAD_W) && MUSVOL > 0) {
                    MUSVOL -= 4
                }
                if (dirhold(PAD_E) && MUSVOL < 0xFF) {
                    MUSVOL += 4
                }
            }
            else if (index == 2.0) {
                if (dirhold(PAD_W) && SFXVOL > 0) {
                    SFXVOL -= 4
                }
                if (dirhold(PAD_E) && SFXVOL < 0xFF) {
                    SFXVOL += 4
                }
            }
            UpdateSoundOptionValue()
        }
    }
}

sub UpdateSoundOptionValue(MonoStereoOBJ, MusicVolOBJ, SFXVolOBJ) __trans {
    interrupter = MonoStereoOBJ
    if (!MONOSOUND) {
        if (var lang = GLOBAL_151; lang == LANG_ES) {
            interrupter -> animframe = 102.0
        }
        else {
            interrupter -> animframe = 91.0
        }
    }
    else {
        interrupter -> animframe = 90.0
    }
    interrupter = MusicVolOBJ
    interrupter -> v0 = MUSVOL * 100 / 255
    interrupter = SFXVolOBJ
    interrupter -> v0 = SFXVOL * 100 / 255
}

state Pause_Menu_Calibrate { // 17
    stateflag 0x100001
    event => state Pause_Menu_Root
    code() {
        KillDisplayChildren()
        trotx = x
        troty = y
        statusb = FLAG_NO_CAMERA_CLIP
        SetVFX2D()
        x -= 88.0
        y += 37.0
        {
            var joy_min_x = 1.0
            var joy_min_y = 1.0
            var joy_max_x = -1
            var joy_max_y = -1
            var joy_center_x = 0.5
            var joy_center_y = 0.5
            var step = 0.0
            do {
                if (var lang = GLOBAL_151; lang == LANG_DE) {
                    setanim(TEXT)
                    playframe(103.0)
                }
                else if (lang == LANG_FR) {
                    setanim(TEXT)
                    playframe(104.0)
                }
                else if (lang == LANG_IT) {
                    setanim(TEXT)
                    playframe(105.0)
                }
                else if (lang == LANG_ES) {
                    setanim(TEXT)
                    playframe(106.0)
                }
                else {
                    setanim(TEXT)
                    playframe(107.0)
                }
                if (buttonpress(PAD_SELECT)) {
                    GLOBAL_152 = 0.5
                    GLOBAL_153 = 0.5
                    GLOBAL_154 = 0.0
                    GLOBAL_155 = 0.0
                    GLOBAL_156 = 1.0
                    GLOBAL_157 = 1.0
                    y = troty
                    if (var lang = GLOBAL_151; lang == LANG_DE) {
                        setanim(TEXT)
                        playframe(108.0, 1.7s)
                    }
                    else if (lang == LANG_FR) {
                        setanim(TEXT)
                        playframe(109.0, 1.7s)
                    }
                    else if (lang == LANG_ES) {
                        setanim(TEXT)
                        playframe(110.0, 1.7s)
                    }
                    else {
                        setanim(TEXT)
                        playframe(111.0, 1.7s)
                    }
                    goto finish
                }

            } until (buttonpress(PAD_X))

            unless (miscfunc(joy_center_x, player, 20, 12) >= 83) { goto finish }

            while (step < 4.0) {
                playnull()
                do {
                    if (step == 0.0) {
                        if (var lang = GLOBAL_151; lang == LANG_DE) {
                            setanim(TEXT)
                            playframe(112.0)
                        }
                        else if (lang == LANG_FR) {
                            setanim(TEXT)
                            playframe(113.0)
                        }
                        else if (lang == LANG_IT) {
                            setanim(TEXT)
                            playframe(114.0)
                        }
                        else if (lang == LANG_ES) {
                            setanim(TEXT)
                            playframe(115.0)
                        }
                        else {
                            setanim(TEXT)
                            playframe(116.0)
                        }
                    }
                    else if (step == 1.0) {
                        if (var lang = GLOBAL_151; lang == LANG_DE) {
                            setanim(TEXT)
                            playframe(117.0)
                        }
                        else if (lang == LANG_FR) {
                            setanim(TEXT)
                            playframe(118.0)
                        }
                        else if (lang == LANG_IT) {
                            setanim(TEXT)
                            playframe(119.0)
                        }
                        else if (lang == LANG_ES) {
                            setanim(TEXT)
                            playframe(120.0)
                        }
                        else {
                            setanim(TEXT)
                            playframe(121.0)
                        }
                    }
                    else if (step == 2.0) {
                        if (var lang = GLOBAL_151; lang == LANG_DE) {
                            setanim(TEXT)
                            playframe(122.0)
                        }
                        else if (lang == LANG_FR) {
                            setanim(TEXT)
                            playframe(123.0)
                        }
                        else if (lang == LANG_IT) {
                            setanim(TEXT)
                            playframe(124.0)
                        }
                        else if (lang == LANG_ES) {
                            setanim(TEXT)
                            playframe(125.0)
                        }
                        else {
                            setanim(TEXT)
                            playframe(126.0)
                        }
                    }
                    else {
                        if (var lang = GLOBAL_151; lang == LANG_DE) {
                            setanim(TEXT)
                            playframe(127.0)
                        }
                        else if (lang == LANG_FR) {
                            setanim(TEXT)
                            playframe(128.0)
                        }
                        else if (lang == LANG_IT) {
                            setanim(TEXT)
                            playframe(129.0)
                        }
                        else if (lang == LANG_ES) {
                            setanim(TEXT)
                            playframe(130.0)
                        }
                        else {
                            setanim(TEXT)
                            playframe(131.0)
                        }
                    }
                } until (buttonpress(PAD_X))

                unless (miscfunc(joy_center_x, player, 20, 12) >= 83) { goto finish }

                if (vecx < joy_min_x) joy_min_x = vecx;
                if (vecy < joy_min_y) joy_min_y = vecy;
                if (vecx > joy_max_x) joy_max_x = vecx;
                if (vecy > joy_max_y) joy_max_y = vecy;
                step += 1.0
            }
            y = troty
            if (joy_max_x - joy_center_x > 64 && joy_center_x - joy_min_x > 64 && joy_max_y - joy_center_y > 64 && joy_center_y - joy_min_y > 64) {
                GLOBAL_152 = joy_center_x
                GLOBAL_153 = joy_center_y
                GLOBAL_154 = joy_min_x
                GLOBAL_155 = joy_min_y
                GLOBAL_156 = joy_max_x
                GLOBAL_157 = joy_max_y
                if (var lang = GLOBAL_151; lang == LANG_DE) {
                    setanim(TEXT)
                    playframe(132.0, 1.7s)
                }
                else if (lang == LANG_FR) {
                    setanim(TEXT)
                    playframe(133.0, 1.7s)
                }
                else if (lang == LANG_IT) {
                    setanim(TEXT)
                    playframe(134.0, 1.7s)
                }
                else if (lang == LANG_ES) {
                    setanim(TEXT)
                    playframe(135.0, 1.7s)
                }
                else {
                    setanim(TEXT)
                    playframe(136.0, 1.7s)
                }
            }
            else if (var lang = GLOBAL_151; lang == LANG_DE) {
                setanim(TEXT)
                playframe(137.0, 1.7s)
            }
            else if (lang == LANG_FR) {
                setanim(TEXT)
                playframe(138.0, 1.7s)
            }
            else if (lang == LANG_IT) {
                setanim(TEXT)
                playframe(139.0, 1.7s)
            }
            else if (lang == LANG_ES) {
                setanim(TEXT)
                playframe(140.0, 1.7s)
            }
            else {
                setanim(TEXT)
                playframe(141.0, 1.7s)
            }
        }
        finish :
        y = troty
        x = trotx
        statusb = FLAG_STRING_CENTER | FLAG_NO_CAMERA_CLIP
        changestate(Pause_Menu_Root)
    }
}

state Pause_Menu_Init { // 18
    stateflag 0x100001
    code() {
        PauseSavedGameFlags = GAMEFLAGS
        do {
            GLOBAL_73 = seek(GLOBAL_73, 8, 1)
            playnull()
        } until (GLOBAL_73 == 8)
        playnull()
        playnull()
        GAMEFLAGS &= ~0x8042001
        playnull()
        GLOBAL_73 = 0
        playnull()
        spawn2(DispC, S_PAUSE_BACKGROUND, 1)
        playnull()
        while (child -> stateflag & 0x8000) {
            playnull()
        }
        TextColorDefault()
        zindex = 100
        TextDefaultScale()
        PauseNameValue = GLOBAL_23
        if (PauseNameValue) {
            misc = 142.0
        }
        else {
            misc = 143.0
        }
        spawn2(DispC, S_MENU_TEXT, 1, getanim(TEXT), misc, 84.0, 118.0, 0, 0, offsetof(PauseNameValue)) // Name / CRASH B text
        spawn2(DispC, S_MENU_TEXT, 1, getanim(TEXT), 144.0, 100.0, 85.0, 0, 0, offsetof(CrystalCount)) // Crystal count
        spawn2(DispC, S_INVENTORY, 1, REWARD_CRYSTAL, 190.0, 67.0, 0)
        do (var v1 = SAVEDGEMPOOL1, v2 = SAVEDGEMPOOL2, i = 0) {
            CheckItemPool(58 + (i >> 8), v1, v2)
            if (misc) { misc = 4 }
            else { misc = 2 }
            spawn2(DispC, S_INVENTORY, 1, 358.0 + i, 84.0 + (i * 36) - 5.0, 23.0, misc)
            i += 1.0
        } while (i < 5.0)
        spawn2(DispC, S_MENU_TEXT, 1, getanim(TEXT), 145.0, 86.0, 11.0, 0, 0, offsetof(ClearGemCount)) // Clear gem count / Gems label
        spawn2(DispC, S_INVENTORY, 1, REWARD_GEM, 172.0, 0, 0)
        spawn2(DispC, S_MENU_TEXT, 1, getanim(TEXT), 146.0, 84.0, -17.0, 0, 0, offsetof(TotalGemCount)) // Gem count / total
        x = -144.0
        y = -61.0
        spawn2(DispC, S_PAUSE_MENU_ROOT, 1)
        creator = objectspawned
        SetScale(0x146, 0x207, 0x1000)
        {
            var v1 = SAVEDCRYSTALPOOL1
            var v2 = SAVEDCRYSTALPOOL2
            misc = 0
            CountPoolBits(GLOBAL_27)
            CountPoolBits(GLOBAL_28)
            CompletedLevelCount = misc 
            misc = 0 
            CountPoolBits(v1)
            CountPoolBits(v2)
            CrystalCount = misc 
            v1 = SAVEDGEMPOOL1
            v2 = SAVEDGEMPOOL2
            misc = 0
            CountPoolBits(v1)
            CountPoolBits(v2)
            TotalGemCount = misc
            v2 &= ~0x3FFFFFF
            misc = 0
            CountPoolBits(v2)
            ClearGemCount = TotalGemCount - misc
            misc = 0
            CountPoolBits(GLOBAL_150 & 31)
            ExtraCompletionCount = misc
            CompletionPercent = (CrystalCount << 1) + (TotalGemCount + ExtraCompletionCount)
            if (GLOBAL_27 & 0x80) { CompletionPercent += 3 }
        }
        spawn2(DispC, S_MENU_TEXT, 1, getanim(TEXT), 147.0, 148.0, -75.0, 6, 5.0, offsetof(CompletionPercent)) // Game completion percentage
        sleepnull()
    }
    event(e, a) {
        accevcstate(Pause_Menu_Close, e == Event12 && interrupter != self)
    }
}

state Pause_Menu_Close { // 19
    stateflag 0x100001
    statusc 0x3
    code() {
        cascadeevent(Event12, 0)
        WaitChildNull()
        GLOBAL_73 = 8
        GAMEFLAGS = PauseSavedGameFlags
        playnull()
        playnull()
        do {
            playnull()
            GLOBAL_73 = seek(GLOBAL_73, 0, 1)
        } while (GLOBAL_73)
        GLOBAL_12 = 0
    }
}

state HUD_Collectable_Display { // 20
    statusc 0
    code(reward, px, hide) {
        SetRewardAttributes(reward)
        if (hide) {
            if (animseq == getanim(GEM_1)) {
                animseq = 0
            }
            statusb = FLAG_INVISIBLE
            y = -DISPLAY_BOUND_LOWER_Y
            v0 = 0
        }
        else {
            y = -DISPLAY_BOUND_Y
            v0 = getfield(player, DisplayVarField)
        }
        x = px
        changestate(HUD_Collectable_Display_Show)
    }
}

state HUD_Collectable_Display_Show { // 21
    statusc 0
    code() {
        sleepframe(DisplayFrame)
    }
    trans {
        changestateif(HUD_Collectable_Display_Hide, frametime - statetime >= 1.5s)
        y = seek(y, -DISPLAY_BOUND_LOWER_Y, 10.0)
        roty = spd(roty, 180deg)
        if (DisplayRewardType >= REWARD_CRYSTAL && getfield(player, DisplayVarField) > v0) {
            statusb &= ~FLAG_INVISIBLE
            if (DisplayRewardType >= REWARD_GEM) {
                SetGemColor(getfield(player, DisplayVarField))
            }
        }
    }
}

state HUD_Collectable_Display_Hide { // 22
    statusc 0
    code() {
        do {
            y = seek(y, -DISPLAY_BOUND_Y, 4.0)
            playframe(DisplayFrame)
        } until (y == -DISPLAY_BOUND_Y)
        sendevent(Event1, parent)
    }
    trans {
        changestateif(HUD_Collectable_Display_Show, buttonhold(PAD_TRIANGLE) && v0 == getfield(player, DisplayVarField))
        roty = spd(roty, 180deg)
    }
}

sub SetGemColor(reward) {
    if (reward == GEM_RED) {
        SetColor1(0x6C, 0x08, 0x08)
        setanim(GEM_1)
    }
    else if (reward == GEM_GREEN) {
        SetColor1(0x08, 0x6C, 0x08)
        setanim(GEM_2)
    }
    else if (reward == GEM_PURPLE) {
        SetColor1(0x6C, 0x08, 0x6C)
        setanim(GEM_3)
    }
    else if (reward == GEM_BLUE) {
        SetColor1(0x00, 0x00, 0x80)
        if (animseq != getanim(GEM_1)) {
            scalex = scalex * 1.2 >> 8
            scaley = scaley * 0.6 >> 8
            scalez = scalez * 1.2 >> 8
        }
        setanim(GEM_1)
    }
    else if (reward == GEM_YELLOW) {
        SetColor1(0x80, 0x80, 0x00)
        if (animseq != getanim(GEM_1)) {
            scalex = scalex * 0.9 >> 8
            scaley = scaley * 1.2 >> 8
            scalez = scalez * 0.9 >> 8
        }
        setanim(GEM_1)
    }
    else {
        SetColor1(0x5A, 0x5A, 0x6C)
        setanim(GEM_1)
    }
    moda = 4.0
    SetColor2(0x00, 0xE77, 0x6D7)
}

sub SetRewardAttributes(reward) {
    DisplayRewardType = reward
    SetScale(0x147, 0x147, 0x147)
    vfx = (vfx & 0xFFFFFF00) | 11
    vfx = (vfx & 0xFF00FFFF) | 0x40000
    if (reward == REWARD_CRYSTAL) {
        SetColorC2Obj(4.0, 0x80, 0x80, 0x80, -0xCCC, -0x800, 0x00)
        setanim(CRYSTAL)
        DisplayFrame = 0
        DisplayVarField = offsetof(mem7)
        if (!child) {
            spawn2(9, 47, 1, 0)
        } 
    }
    else if (reward == REWARD_GEM) {
        animseq = 0
        DisplayFrame = 0
        DisplayVarField = offsetof(mem8)
        SetGemColor(player -> mem8)
    }
    else if (reward == REWARD_GEM_SPECIAL) {
        animseq = 0
        DisplayFrame = 0
        DisplayVarField = offsetof(mem9)
        SetGemColor(player -> mem9)
    }
}

sub CheckPlayerInventory(reward, px, hide) {
    var item = 0
    var prev = child
    if (hide) {
        x = px
        item = 1.0
    }
    else if (reward == REWARD_CRYSTAL) {
        item = player -> mem7
    }
    else if (reward == REWARD_GEM) {
        item = player -> mem8
    }
    else if (reward == REWARD_GEM_SPECIAL) {
        item = player -> mem9
    }
    if (item) {
        spawn2(DispC, S_COLLECTABLE_DISPLAY, 1, reward, px, hide)
        if (prev != child) {
            ActiveDisplayOBJCount += 1.0
        }
    }
}

state Collectable_Manager_Init { // 23
    code() {
        statusb = FLAG_INVISIBLE | FLAG_NO_CAMERA_CLIP
        SetVFX2D()
        x = 0
        z = 0
        DisplayStatus = 0
        ActiveDisplayOBJCount = 0
        changestate(Collectable_Manager)
    }
}

state Collectable_Manager { // 24
    code() {
        statusb |= FLAG_INVISIBLE
        y = DISPLAY_BOUND_Y
        sleepframe(DisplayFrame)
    }
    event(e, a) {
        if (e == Event32) {
            CollectedRewardID = a[0]
            CollectedRewardParentID = a[1.0]
            if (ActiveDisplayOBJCount == 0) {
                if (CollectedRewardID == REWARD_CRYSTAL) {
                    CheckPlayerInventory(REWARD_CRYSTAL, 0, 1.0)
                }
                else if (CollectedRewardID == REWARD_GEM) {
                    CheckPlayerInventory(REWARD_GEM, -40.0, 1.0)
                }
                else if (CollectedRewardID == REWARD_GEM_SPECIAL) {
                    CheckPlayerInventory(REWARD_GEM_SPECIAL, 40.0, 1.0)
                }
            }
            accevret()
        }
        if (e == Event1) {
            ActiveDisplayOBJCount -= 1.0
        }
    }
    trans {
        if (buttonhold(PAD_TRIANGLE)) {
            if (ActiveDisplayOBJCount == 0 && !(GLOBAL_119 & 0x2000 && BONUSSTATE != BONUS_COMPLETED)) {
                CheckPlayerInventory(REWARD_CRYSTAL, 0, 0)
                CheckPlayerInventory(REWARD_GEM, -40.0, 0)
                CheckPlayerInventory(REWARD_GEM_SPECIAL, 40.0, 0)
            }
        }
    }
}

state Demo_Text { // 25
    stateflag 0x40001
    code(px, py) {
        statusb = FLAG_STRING_CENTER
        SetVFX2D()
        zindex = 100
        DEMOTEXTOBJ = self
        SetTrans(px, py, 0)
        TextDefaultScale()
        TextColorDefault()
        do {
            setanim(TEXT)
            playframe(148.0, 0.4s)
            playnull(0.4s)
        } while (1)
    }
    event(e, a) {
        accevcstate(Demo_Text_Sleep, e == Event14)
    }
}

state Demo_Text_Sleep { // 26
    code() {
        if (LEVEL == LEVEL_WarpRoom) {
            sleepnull()
        }
        GAMEFLAGS &= ~0x2
        GLOBAL_17 = 6.0
        loadlevel(LEVEL_Title)
        sleepnull()
    }
}

state Display_Kill { // 27
    stateflag 0x100020
    statusc 0
    code() {}
}

state Box_Counter { // 28
    code() {
        vfx = (vfx & 0xFFFFFF00) | 5
        y += 1.5m
        statusb = FLAG_STRING_CENTER
        TextColorDefault()
        SetScale(8.0)
        invincible = FONT_BIG
        if (var v1 = SAVEDGEMPOOL1 | GEMPOOL1, v2 = SAVEDGEMPOOL2 | GEMPOOL2; LEVEL == LEVEL_TurtleWoods) {
            unless (0x20000000 & v2) {
                if (BOXCOUNT == 0) {
                    changestate(Box_Counter_Reward, 300.0 + GEM_BLUE)
                }
                else if (field_61) {
                    field_61 = 0
                    GLOBAL_148 = 0
                }
            }
        }
        else if (LEVEL == LEVEL_HangEight) {
            changestateif(Box_Counter_Reward, !(frametime - GLOBAL_66 >= 75s) && !(2 & v1), REWARD_GEM_SPECIAL)
        }
        else if (LEVEL == LEVEL_PlantFood) {
            changestateif(Box_Counter_Reward, !(frametime - GLOBAL_66 >= 85s) && !(0x40000000 & v2), 300.0 + GEM_YELLOW)
        }
        playnull()
        spawn2(DispC, S_HOLOGRAM, 1, x, y - 1m, z)
        do {
            var total = GLOBAL_148 >> 8
            var broken = BOXCOUNT >> 8
            setanim(TEXT)
            playframe(149.0)
        } while (1)
    }
    trans {
        once {
            CheckItemPool(LEVEL >> 8, SAVEDGEMPOOL1, SAVEDGEMPOOL2)
            field_61 = misc
            CheckItemPool(LEVEL >> 8, GEMPOOL1, GEMPOOL2)
            field_61 = field_61 || misc
        }
        changestateif(Box_Counter_Reward, (BOXCOUNT == GLOBAL_148 || entitygetstate(3) || field_61) && !STATUS_FIRSTFRAME, REWARD_GEM + LEVEL)
    }
}

state Box_Counter_Reward { // 29
    code(reward) {
        calcpath(0)
        cascadeevent(Event12, self)
        CheckItemPool((reward - REWARD_GEM) >> 8, SAVEDGEMPOOL1, SAVEDGEMPOOL2)
        field_61 = misc
        CheckItemPool((reward - REWARD_GEM) >> 8, GEMPOOL1, GEMPOOL2)
        field_61 = field_61 || misc
        if (entitygetstate(3) || field_61) {
            KillEntity()
        }
        else {
            spawn2(FruiC, FruiC_S_FRUIT_HOP, 1, reward, id)
            creator = objectspawned
            do {
                playnull(1.7s)
            } until (entitygetstate(3))
        }
    }
}

state River_TimeTrial { // 30
    stateflag 0x40001
    code() { 
        SetVFX2D()
        SetScale(0x146, 0x207, 0x1000)
        invincible = FONT_BIG
        TextColorDefault()
        zindex = 0x64
        {
            var v1 = SAVEDGEMPOOL1 | GEMPOOL1
            var v2 = SAVEDGEMPOOL2 | GEMPOOL2
            if (LEVEL == LEVEL_HangEight) {
                vecz = 1
                TrialTimeLimit = 75s
                TrialTriggerZ = 408.84m
                TrialStartWindow = 25s
            }
            else if (LEVEL == LEVEL_PlantFood) {
                vecz = 62
                TrialTimeLimit = 85s
                TrialTriggerZ = 507.1575m
                TrialStartWindow = 30s
            }
            CheckItemPool(vecz, v1, v2)
            if (misc) { return }
        }
        if (player -> z < TrialTriggerZ) { return }
        do { playnull() } until (frametime - GLOBAL_66 >= TrialTimeLimit || player -> z < TrialTriggerZ && !(frametime - GLOBAL_66 >= TrialStartWindow))
        SetTrans(100.0, -82.0, 0.0)
        do {
            TrialRemainingTime = TrialTimeLimit - (frametime - GLOBAL_66)
            var s = (TrialRemainingTime / 25) % 60
            var m = TrialRemainingTime / 1500
            setanim(TEXT)
            playframe(150.0)
            if (var itemoffs = vecz; vecz < 32) {
                misc = (GEMPOOL1 & 1) << itemoffs
            }
            else {
                misc = (GEMPOOL2 & 1) << itemoffs - 32
            }
        } while (!misc && !(GLOBAL_119 & 0x2000) && !(frametime - GLOBAL_66 >= TrialTimeLimit))
        creator = objectget(50.0)
        if (creator) {
            interrupter = creator -> creator
            sendevent(Event14, interrupter, 100.0)
        }
    }
    event(e, a) {
        accevcstate(Display_Kill, e == Event19)
    }
}

state Menu_Button { // 31
    stateflag 0x120001
    __transargs
    code(index, anim, frame, xoff, yoff, obj) {
        statusb = creator -> statusb
        zindex = creator -> zindex
        unless (creator -> stateflag & 0x100000) {
            stateflag &= ~0x100000
        }
        SetVFX2D()
        invincible = FONT_SMALL
        animseq = anim
        animframe = frame
        var value = v0
        do {
            value = v0
            playframe()
        } while (1)
    }
    event(e, a) {
        accevcstate(Display_Kill, e == Event12 || e == Event1)
    }
    trans {
        x = parent -> x + xoff
        if (obj == 1) {
            TextFlashFast()
            return
        }
        y = parent -> y + yoff
        if (parent -> MenuButtonIndex == index) {
            if (obj) {
                interrupter = obj
                interrupter -> y = y
            }
            TextFlashFast()
        }
        else if (index < 0) {
            TextFlashSlow()
        }
        else {
            SetTextColor(0xA0, 0x8B, 0x60, 0xA0, 0x60, 0x06)
        }
    }
}

state Menu_Text { // 32
    stateflag 0x100001
    event => state Menu_Button
    code(anim, frame, xoff, yoff, flags, mode, field) {
        if (mode == 0) {
            TextColorDefault()
        }
        else if (mode == 2.0) {
            SetTextColor(0xFF, 0xFF, 0xFF, 0x40, 0x40, 0x40)
        }
        else if (mode == 5.0) {
            SetTextColor(0x1FF, 0x190, 0x00, 0x1FF, 0x00, 0x00)
            settrans(TextFlashSlow)
        }
        else if (mode == 6.0) {
            SetTextColor(0x1FF, 0x190, 0x00, 0x1FF, 0x00, 0x00)
            settrans(TextFlashMedium)
        }
        if (flags & 0x1) {
            x = parent -> x + xoff
            y = parent -> y + yoff
        }
        else {
            x = xoff
            y = yoff
        }
        if (flags & 4) {
            invincible = FONT_BIG
        }
        else {
            invincible = FONT_SMALL
        }
        zindex = creator -> zindex
        if (flags & 0x2) {
            statusb |= FLAG_STRING_CENTER
        }
        else {
            statusb &= ~FLAG_STRING_CENTER
        }
        unless (creator -> stateflag & 0x100000) {
            stateflag &= ~0x100000
        }
        vfx = (vfx & 0xFFFFFF00) | 6
        animseq = anim
        do (var v1) {
            v1 = getfield(creator, field)
            playframe(frame)
        } while (1)
    }
}

sub TextFlashSlow() {
    if (frametime & 31) {
        SetTextColor(0x1FF, 0x190, 0x00, 0x1FF, 0x00, 0x00)
    }
    else {
        SetTextColor(0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF)
    }
} 

sub TextFlashMedium() {
    if ((frametime & 31) == 15) {
        SetTextColor(0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF)
    }
    else {
        SetTextColor(0x1FF, 0x190, 0x00, 0x1FF, 0x00, 0x00)
    }
}

sub TextFlashFast() {
    if (frametime & 3) {
        SetTextColor(0x1FF, 0x190, 0x00, 0x1FF, 0x00, 0x00)
    }
    else {
        SetTextColor(0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF, 0x1FF)
    }
}

state Pause_Menu_Inventory { // 33
    stateflag 0x100001
    event => state Menu_Button
    code(reward, xoff, yoff, flags) {
        if (flags & 1) {
            x = parent -> x + xoff
            y = parent -> y + yoff
        }
        else {
            x = xoff
            y = yoff
        }
        troty = 10deg + rand(10deg)
        trotx = 0deg
        statusb = creator -> statusb
        zindex = creator -> zindex
        zindex = 0
        unless (creator -> stateflag & 0x100000) {
            stateflag &= ~0x100000
        }
        vfx = (vfx & 0xFFFFFF00) | 14
        vfx = (vfx & 0xFF00FFFF) | 0x40000
        if (reward == 97.0) {
            tpc = 0
            setanim(LIFE_ICON)
            SetScale(0x146, 0x103, 0x1000)
        }
        else if (reward >= REWARD_GEM) {
            if (flags & 8) {
                SetScale(0x8F, 0x8F, 0x8F)
            }
            else if (flags & 4) {
                SetScale(0xA3, 0xA3, 0xA3)
            }
            else {
                SetScale(0x11E, 0x11E, 0x11E)
            }
            SetGemColor(reward - REWARD_GEM)
            if (flags & 8) {
                SetColor2(-0x2C1, 0x78B, 0xDD6)
                SetColor1(0xA0, 0xA0, 0xA0)
            }
            else {
                SetColor2(-0x2C1, 0x78B, 0xDD6)
            }
            rotx = 20deg
            rotz = 0
            if (flags & 2) {
                do {
                    SetScale(40, 40, 40)
                    do {
                        playframe(0)
                    } while (rand(0xC8))
                    SetScale(0x51, 0x51, 0x51)
                    playframe(0)
                    SetScale(0xA3, 0xA3, 0xA3)
                    playframe(0, 0.08s)
                    SetScale(0x51, 0x51, 0x51)
                    playframe(0)
                } while (1)
            }
        }
        else if (reward >= REWARD_CRYSTAL) {
            if (flags & 8) {
                SetScale(0x7A, 0x7A, 0x7A)
            }
            else {
                SetScale(1.0, 1.0, 1.0)
            }
            SetColorC2Obj(4.0, 0x80, 0x80, 0x80, -0x8B5, -0x83A, 0xA9B)
            setanim(CRYSTAL)
            spawn2(9, 47, 1, 0)
        }
        sleepframe(0)
    }
    trans {
        roty = spd(roty, 90deg)
    }
}

state Pause_Menu_Background { // 34
    stateflag 0x108001
    code() {
        statusb = FLAG_NO_CAMERA_CLIP
        SetVFX2D()
        vfx = (vfx & 0xFFFF00FF) | 0x100
        SetTrans(0, 0, 0)
        TextDefaultScale()
        zindex = -0x3E8
        moda = 16.0
        while (moda) {
            moda = seek(moda, 0, 0x555)
            playanim(0, PAUSE_BACKGROUND)
        }
        stateflag &= ~0x8000
        sleepanim(0, PAUSE_BACKGROUND)
    }
    event(e, a) {
        accevcstate(Pause_Menu_Background_Kill, e == Event12)
    }
}

state Pause_Menu_Background_Kill { // 35
    stateflag 0x100001
    code() {
        while (moda < 16.0) {
            moda = seek(moda, 16.0, 0x555)
            playanim(0, PAUSE_BACKGROUND)
        }
        playanim(0, PAUSE_BACKGROUND)
    }
}

state Box_Hologram { // 36
    event => state Pause_Menu_Root
    code(px, py, pz) {
        SetScale(1.8S)
        SetTrans(px, py, pz)
        vfx = (vfx & 0xFF00FFFF) | 0x20000
        moda = v0
        zindex = 20
        sleepanim(0, BOX_PICKUP)
    }
    trans {
        once {
            v0 = 6.4
        }
        unless (rand(10)) {
            v0 = 1.6 + rand(6.4)
        }
        field_61 = abs(z - CAMTRANSZ)
        if (field_61 < 4m) {
            if (field_61 <= 1m) {
                v0 = 16.0
            }
            else {
                v0 = 16.0 - 1.0 / (field_61 * 6.4)
            }
        }
        moda = seek(moda, v0, 0x111)
        roty = spd(roty, 180deg)
    }
}

sub TextColorDefault() {
    SetTextColor(0x1FF, 0x190, 0, 0x1FF, 0, 0)
}