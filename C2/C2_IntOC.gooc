state Branch { // 19
    stateflag 0x1
    statusc 0x2
    code(part) {
        statusb = FLAG_NO_CAMERA_CLIP
        zindex = 200
        if (part == 1) {
            setanim(BRANCH_1)
        }
        else if (part == 2) {
            setanim(BRANCH_2)
        }
        else if (part == 3) {
            setanim(BRANCH_3)
        }
        else if (part == 4) {
            setanim(BRANCH_4)
        }
        else if (part == 5) {
            setanim(BRANCH_5)
        }
        else if (part == 6) {
            setanim(BRANCH_6)
        }
        else if (part == 7) {
            setanim(BRANCH_7)
        }
        else if (part == 8) {
            setanim(BRANCH_8)
        }
        else if (part == 9) {
            setanim(BRANCH_9)
        }
        else if (part == 10) {
            setanim(BRANCH_10)
        }
        else if (part == 11) {
            setanim(BRANCH_11)
        }
        else if (part == 12) {
            setanim(BRANCH_12)
        }
        else if (part == 13) {
            setanim(BRANCH_13)
        }
        else if (part == 14) {
            setanim(BRANCH_14)
        }
        else if (part == 15) {
            setanim(BRANCH_15)
        }
        playframes(0.0, 102.0)
    }
}

state Intro_Sis { // 20
    stateflag 0x1
    statusc 0x0
    code() {
        statusb = FLAG_COLLIDABLE | FLAG_SOLID_SIDES
        zindex = 50
        if (entitygetstate(2)) {
            spawn(IntOC, S_LAPTOP, 1, 1)
            changestate(Sis_Body)
        }
        entitysetstate(1)
        spawn(IntOC, S_LAPTOP, 1, 0)
        playframes(SIS_INTRO_1, 0.0, 92.0)
        cascadeevent(Event14, self)
        animframe = 92.0
        do {
            animframe += 1.0
            sendeventif(EventTriggered, player, animframe == 97.0 || animframe == 148.0)
            playframe()
        } while (animframe + 1.0 <= 166.0)
        playframes(SIS_INTRO_2, 0.0, 141.0)
        changestate(Sis_Body)
    }
}

state Sis_Body { // 21
    stateflag 0x1
    statusc 0x0
    code() {
        statusb = FLAG_COLLIDABLE | FLAG_SOLID_SIDES
        zindex = 50
        spawn(IntOC, S_SIS_HEAD)
        playanim(0, SIS_BODY)
        playanim(1, SIS_BODY)
        playanim(2, SIS_BODY)
        playanim(3, SIS_BODY)
        playanim(4, SIS_BODY)
        playanim(4, SIS_BODY)
        playanim(5, SIS_BODY)
        playanim(6, SIS_BODY)
        sleep()
    }
}

state Sis_Head { // 22
    stateflag 0x1
    statusc 0x0
    code() {
        statusb = FLAG_COLLIDABLE | FLAG_SOLID_SIDES
        zindex = 50
        sleepanim(0, SIS_HEAD)
    }
    trans {
        once {
            LastPlayerX = player -> x
            LastPlayerY = player -> y
            LastPlayerZ = player -> z
            HeadLookMode = 1
            HeadSnapPending = 1
        }
        if (LastPlayerX != player -> x || LastPlayerY != player -> y || LastPlayerZ != player -> z) {
            HeadLookMode = 1
            statetime = frametime
            LastPlayerX = player -> x
            LastPlayerY = player -> y
            LastPlayerZ = player -> z
        }
        if (var mode = HeadLookMode; mode == 1) {
            if (frametime - statetime >= 5s) {
                HeadLookMode = 2
                statetime = frametime
            }
        }
        else if (mode == 2) {
            if (frametime - statetime >= 2.72s) {
                HeadLookMode = 1
                statetime = frametime
            }
        }
        if (var mode = HeadLookMode; mode == 1) {
            vecx = atan2_3d(self, player -> trans)
            vecy = (atan2(player -> trans) - 45deg) % 360deg
        }
        else if (mode == 2) {
            vecx = 0
            vecy = -45deg
        }
        var0 = vecx
        if (var0 > 0deg) {
            var0 = 0deg
        }
        if (var0 < -9.7deg) {
            var0 = -9.7deg
        }
        HeadAngleDelta = degdist(rotx, var0)
        if (HeadAngleDelta) {
            var0 = HeadAngleDelta >> 3
            if (!var0) {
                if (HeadAngleDelta > 0) {
                    var0 = 1
                }
                else {
                    var0 = -1
                }
            }
            rotx += var0
        }
        var0 = vecy
        if (var0 >= 180deg) {
            var0 -= 360deg
        }
        if (var0 > 52.75deg) {
            var0 = 52.75deg
        }
        if (var0 < -136deg - 1) {
            var0 = -136deg - 1
        }
        if (roty >= 180deg) {
            roty -= 360deg
        }
        if (HeadSnapPending) {
            HeadSnapPending = 0
            roty = var0
        }
        {
            var increment
            HeadAngleDelta = var0 - roty
            increment = HeadAngleDelta >> 2
            if (HeadAngleDelta && !increment) {
                if (HeadAngleDelta > 0) {
                    increment = 1
                }
                else {
                    increment = -1
                }
            }
            if (increment >= 0) {
                if (increment > 9.4deg + 1) {
                    increment = 9.4deg + 1
                }
            }
            else if (increment < -9.4deg - 1) {
                increment = -9.4deg - 1
            }
            roty = (roty + increment) % 360deg
        }
        rotz = (roty + 45deg) % 360deg
    }
}

state Laptop { // 23
    stateflag 0x1
    statusc 0x0
    code(off) {
        zindex = 50
        changestateif(Laptop_Off, off)
        sleepanim(0, LAPTOP_ON)
    }
    event(e, a) {
        accevcstate(Laptop_Off, e == Event14)
    }
}

state Laptop_Off { // 24
    stateflag 0x1
    statusc 0x0
    code() {
        sleepanim(0, LAPTOP_OFF)
    }
}

state Kill { // 25
    stateflag 0x1
    statusc 0x0
    code() {}
}
