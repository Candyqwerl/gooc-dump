var LightTargetX, LightTargetY, LightTargetZ
var LightOffsetX, LightOffsetY, LightOffsetZ
var LightBrightness, LightTargetBrightness, LightBaseBrightness
var IntroVar10, CaveFlameDimmed, TargetVertex, LightFadeSpeed
var TargetScaleX, TargetScaleY
var LastPlayerX, LastPlayerY, LastPlayerZ, HeadLookMode

expr SledBurstSpawned    = IntroVar10
expr CaveFlameStarted    = IntroVar10
expr LightFadePhase      = IntroVar10
expr HeadSnapPending     = IntroVar10

expr SavedMusicVolume    = var0
expr AnimationPhase      = var0
expr LightValue          = var0
expr CrystalLightAmount  = var0
expr HeadAngleDelta      = field_61

inline sub WaitIntroTime(len) {
    until (frametime - statetime >= len) {
        UpdateIntroTimeline()
        playnull()
    }
}

state Intro_Controller { // 0
    stateflag 0x40001
    statusc 0x2
    code() {
        SavedMusicVolume = MUSVOL
        GLOBAL_74 = 0
        settrans(HoldIntroFadeAndCheckSkip)
        HoldIntroFadeAndCheckSkip()
        if (var lang = GLOBAL_151; lang == LANG_FR) {
            spawn(9, 44, 1, [I00FO], [I01FO], [I02FO], [I03FO], [I04FO], [I05FO], [I06FO], [I07FO], [I08FO], [I09FO], [I0aFO], [I0bFO], 12.0, 1000s, 0x6E4)
        }
        else if (lang == LANG_ES) {
            spawn(9, 44, 1, [I00SO], [I01SO], [I02SO], [I03SO], [I04SO], [I05SO], [I06SO], [I07SO], [I08SO], [I09SO], [I0aSO], [I0bSO], 12.0, 1000s, 0x6E4)
        }
        else if (lang == LANG_DE) {
            spawn(9, 44, 1, [I00GO], [I01GO], [I02GO], [I03GO], [I04GO], [I05GO], [I06GO], [I07GO], [I08GO], [I09GO], [I0aGO], [I0bGO], 12.0, 1000s, 0x6E4)
        }
        else if (lang == LANG_IT) {
            spawn(9, 44, 1, [I00IO], [I01IO], [I02IO], [I03IO], [I04IO], [I05IO], [I06IO], [I07IO], [I08IO], [I09IO], [I0aIO], [I0bIO], 12.0, 1000s, 0x6E4)
        }
        else {
            spawn(9, 44, 1, [I00sO], [I01sO], [I02sO], [I03sO], [I04sO], [I05sO], [I06sO], [I07sO], [I08sO], [I09sO], [I0asO], [I0bsO], 12.0, 1000s, 0x6E4)
        }
        playnull()
        GAMEFLAGS &= ~0x100
        playnull(13)
        sendevent(EventTriggered, child)
        statetime = frametime
        settrans(__Intro_Controller_TRANS)
        GAMEFLAGS |= 0x2
        WaitIntroTime(5s)
        ins72(0, 0x100)
        ins72(0x400, 0x100)
        statetime = frametime - 20s
        settrans(HoldIntroFadeAndCheckSkip)
        WaitIntroTime(24s)
        GAMEFLAGS |= 0x2
        settrans(__Intro_Controller_TRANS)
        UpdateIntroTimeline()
        playnull()
        WaitIntroTime(0x36C)
        FadeToBlack()
        WaitFadeNull()
        GAMEFLAGS &= ~0x1
        WaitIntroTime(0x3A3)
        GAMEFLAGS |= 0x1
        ins72(0, 0x100)
        ins72(0x400, 0x100)
        GLOBAL_50 = 0xFFFFFF
        GLOBAL_51 = 0xFFFFFF
        statetime = frametime - 40s
        FadeFromBlack(16)
        WaitIntroTime(0x432)
        FadeToBlack(16)
        WaitIntroTime(0x43F)
        ins72(0, 0x100)
        ins72(0x400, 0x100)
        statetime = frametime - 60s
        FadeFromBlack(16)
        WaitIntroTime(0x68B)
        statetime = frametime - 67s
        WaitIntroTime(0x8B9)
        FadeToBlack(16)
        WaitIntroTime(0x8D3)
        while (FADECONTROL != -1) {
            UpdateIntroTimeline()
            playnull()
        }
        playnull(10)
        ins72(0, 0x100)
        ins72(0x400, 0x100)
        FadeFromBlack()
        do {
            UpdateIntroTimeline()
            playnull()
        } until (child -> stateflag & 0x20)
    }
    trans {
        CheckIntroSkip()
    }
}

sub HoldIntroFadeAndCheckSkip() {
    GAMEFLAGS &= ~0x800002
    FADECONTROL = 0x120
    CheckIntroSkip()
}

sub UpdateIntroTimeline() {
    pathprog = frametime - statetime
}

sub CheckIntroSkip() {
    if (frametime - statetime >= 4.5s, pad(0x940, 3, 0, 8)) {
        changestate(Skip_Intro)
    }
}

state Skip_Intro { // 1
    stateflag 0x40001
    statusc 0x2
    code() {
        voice = -2
        soundfadet(0.1s, voice)
        soundfadev(0V, voice, 3)
        FadeToBlack()
        WaitFadeNull()
        loadlevel(LEVEL_WarpRoom)
    }
}

state Intro_Cortex { // 2
    stateflag 0x1
    statusc 0x2
    code() {
        statusb = FLAG_NO_CAMERA_CLIP
        zindex = 26
        playnull()
        creator = GLOBAL_126
        setanim(CORTEX_FALLING)
        do {
            if (creator -> pathprog < 0) {
                animframe = 0
            }
            else if (creator -> pathprog >= 126) {
                animframe = 125.0
            }
            else {
                animframe = creator -> pathprog << 8
            }
            playframe()
            if (animframe >= 75.0) {
                zindex = 400
            }
        } while (1)
    }
}

state Intro_Sled { // 3
    stateflag 0x1
    statusc 0x2
    code() {
        statusb = FLAG_NO_CAMERA_CLIP
        zindex = 200
        playnull()
        creator = GLOBAL_126
        setanim(INTRO_SLED)
        SledBurstSpawned = 0
        do {
            if (creator -> pathprog < 0) {
                AnimationPhase = -1
                animframe = 0
            }
            else if (creator -> pathprog >= 32) {
                AnimationPhase = 1
                animframe = 31.0
            }
            else {
                AnimationPhase = 0
                animframe = creator -> pathprog << 8
            }
            if (AnimationPhase > 0) {
                break
            }
            if (AnimationPhase == 0) {
                if (animframe <= 31.0) {
                    spawn(9, 21, 1, 0, 0, 0, 0, 0.6S, 0, 24, 0)
                }
                if (!SledBurstSpawned && animframe >= 25.0) {
                    SledBurstSpawned = 1
                    SetVec(x, y, z)
                    getvert(vtrans, self, 0)
                    spawn(9, 40, 1, 0, 4)
                    getvert(vtrans, self, 1.0)
                    spawn(9, 40, 1, 0, 4)
                    getvert(vtrans, self, 2.0)
                    spawn(9, 40, 1, 0, 4)
                    SetTrans(vecx, vecy, vecz)
                }
            }
            playframe()
        } while (1)
        playnull(21)
        playnull(21)
        playnull(21)
        playnull(21)
    }
}

state Cortex_Cave { // 4
    stateflag 0x1
    statusc 0x2
    code() {
        SetScale(0.6S)
        roty = -60deg
        zindex = 140
        spawn(IntOC, S_CAVE_LIGHT, 1, 0)
        creator = GLOBAL_126
        vfx = (vfx & 0xFFFF00FF) | 0xC00
        groundy = -3.9m
        CaveFlameStarted = 0
        CaveFlameDimmed = 0
        do {
            if (creator -> pathprog < 0x258) {
                AnimationPhase = -1
                animframe = 0
            }
            else if (creator -> pathprog >= 0x359) {
                AnimationPhase = 1
                animframe = 256.0
            }
            else {
                AnimationPhase = 0
                animframe = (creator -> pathprog - 0x258) << 8
            }
            if (animframe < 129.0) {
                setanim(CORTEX_CAVE_1)
                if (!CaveFlameStarted && animframe >= 3.0) {
                    CaveFlameStarted = 1
                    cascadeevent(EventTriggered, self)
                    spawn(IntOC, S_FLARE, 1, 0)
                    spawn(IntOC, S_FLAME, 1, 0)
                }
            }
            else {
                animframe -= 129.0
                setanim(CORTEX_CAVE_2)
                if (!CaveFlameDimmed && animframe >= 82.0) {
                    CaveFlameDimmed = 1
                    cascadeevent(Event14, self)
                }
            }
            playframe()
        } while (1)
    }
    trans {
        once {
            moda = 16.0
        }
        unless (STATUS_FIRSTFRAME) {
            moda = 16.0 - ((GLOBAL_51 & 0xFF) << 12 >> 8)
        }
    }
}

state Cave_Light_Init { // 5
    stateflag 0x1
    statusc 0x2
    code(vertex) {
        TargetVertex = vertex
        GLOBAL_54 = self
        GLOBAL_120 = 0
        GLOBAL_55 = 1.0
        GLOBAL_50 = 0
        GLOBAL_51 = 0
        sleepnull()
    }
    event(e, a) {
        accevcstate(Cave_Light_Flicker, e == EventTriggered)
    }
}

state Cave_Light_Flicker { // 6
    stateflag 0x1
    statusc 0x2
    code() {
        sleep()
    }
    event(e, a) {
        accevif (e == Event14) {
            LightFadePhase = 1
            LightTargetBrightness = 2.0
        }
    }
    trans {
        once {
            LightTargetX = 0
            LightTargetY = 0
            LightTargetZ = 0
            LightOffsetX = 0
            LightOffsetY = 0
            LightOffsetZ = 0
            LightBrightness = 0
            LightTargetBrightness = 16.0
            LightFadeSpeed = 136
            LightFadePhase = 0
            LightBaseBrightness = 8.0
        }
        if (LightFadePhase > 0) {
            LightBaseBrightness = seek(LightBaseBrightness, 0, 40)
            if (!LightBaseBrightness) {
                LightFadePhase = -1
                LightTargetBrightness = 0
            }
        }
        if (LightBrightness == LightTargetBrightness) {
            changestateif(Kill, !LightBrightness && LightFadePhase == -1)
            LightFadeSpeed = 182
            LightValue = rand(LightBaseBrightness >> 1)
            if (LightBrightness >= LightBaseBrightness) {
                LightValue = -LightValue
            }
            LightTargetBrightness = LightBaseBrightness + LightValue
            if (LightTargetBrightness < 0) {
                LightTargetBrightness = 0
            }
            if (LightTargetBrightness > 16.0) {
                LightTargetBrightness = 16.0
            }
        }
        LightBrightness = seek(LightBrightness, LightTargetBrightness, LightFadeSpeed)
        LightValue = (0x10 * LightBrightness) >> 12
        GLOBAL_50 = LightValue | ((LightValue << 8) | (LightValue << 16))
        LightValue = (0xFF * LightBrightness) >> 12
        GLOBAL_51 = LightValue | ((LightValue << 8) | (LightValue << 16))
        if (LightTargetX == LightOffsetX && LightTargetY == LightOffsetY && LightTargetZ == LightOffsetZ) {
            LightTargetX = -0.5m + rand(1m)
            LightTargetY = -0.5m + rand(1m)
            LightTargetZ = -0.5m + rand(1m)
        }
        LightOffsetX = seek(LightOffsetX, LightTargetX, 2S)
        LightOffsetY = seek(LightOffsetY, LightTargetY, 2S)
        LightOffsetZ = seek(LightOffsetZ, LightTargetZ, 2S)
        getvert(vtrans, creator, TargetVertex)
        x += LightOffsetX
        y += LightOffsetY
        z += LightOffsetZ
    }
}

state Flare { // 7
    stateflag 0x1
    statusc 0x2
    code(vertex) {
        TargetVertex = vertex
        zindex = 165
        SetVFX2D()
        SetRot(0deg)
        setanim(FLARE)
        sleepframe(0)
    }
    event(e, a) {
        accevif (e == Event14) {
            TargetScaleY = 0x9B
        }
    }
    trans {
        once {
            moda = 16.0
            TargetScaleY = 0x30B
            scaley = TargetScaleY
            scalex = scaley
        }
        unless (STATUS_FIRSTFRAME) {
            moda = 16.0 - ((GLOBAL_51 & 0xFF) << 12 >> 8)
            getvert(vtrans, creator, TargetVertex)
            moveto2d(null, 0, 0)
        }
        rotz = (rotz + 2.4deg) % 360deg
        scaley = seek(scaley, TargetScaleY, 24)
        scalex = scaley
    }
}

state Flame { // 8
    stateflag 0x1
    statusc 0x2
    code(vertex) {
        TargetVertex = vertex
        SetVFX2D()
        SetRot(0deg)
        setanim(FLAME)
        do {
            playframe(0.0)
            playframe(1.0)
            playframe(2.0)
            playframe(3.0)
            playframe(4.0)
            playframe(5.0)
            playframe(6.0)
            playframe(7.0)
        } while (1)
    }
    event(e, a) {
        accevif (e == Event14) {
            TargetScaleX = 40
            TargetScaleY = 31
        }
    }
    trans {
        once {
            moda = 16.0
            TargetScaleX = 0x47
            TargetScaleY = 0x92
            scalex = TargetScaleX
            scaley = TargetScaleY
        }
        unless (STATUS_FIRSTFRAME) {
            moda = 16.0 - ((GLOBAL_51 & 0xFF) << 12 >> 8)
            getvert(vtrans, creator, TargetVertex)
            moveto2d(null, 0, 0)
        }
        scalex = seek(scalex, TargetScaleX, 1)
        scaley = seek(scaley, TargetScaleY, 4)
    }
}

state Master_Crystal { // 9
    stateflag 0x1
    statusc 0x2
    code(scale) {
        spawn(FruiC, FruiC_S_CRYSTAL, 1, 0, -0xCCC, -0x800, 0, 0xE9, 0x5F, 0xFF)
        creator = objectspawned
        playnull()
        creator -> scalex = scale
        creator -> scaley = scale
        creator -> scalez = scale
        do {
            CrystalLightAmount = (GLOBAL_51 & 0xFF) << 12 >> 7
            if (CrystalLightAmount > 12.0) {
                CrystalLightAmount = 12.0
            }
            creator -> moda = 16.0 - CrystalLightAmount
            playnull()
        } while (1)
    }
}

state Text { // 10
    stateflag 0x1
    statusc 0x2
    code() {
        statusb = FLAG_NO_CAMERA_CLIP
        SetTrans(0, 0, 0)
        TextDefaultScale()
        statusb = FLAG_STRING_CENTER
        if (var lang = GLOBAL_151; lang == LANG_FR) {
            spawn2(DispC, DispC_S_MENU_BUTTON, 1, -1.0, getanim(TEXT), 0.0, 0, 0, 0)
        }
        else if (lang == LANG_DE) {
            spawn2(DispC, DispC_S_MENU_BUTTON, 1, -1.0, getanim(TEXT), 1.0, 0, 0, 0)
        }
        else if (lang == LANG_ES) {
            spawn2(DispC, DispC_S_MENU_BUTTON, 1, -1.0, getanim(TEXT), 2.0, 0, 0, 0)
        }
        else if (lang == LANG_IT) {
            spawn2(DispC, DispC_S_MENU_BUTTON, 1, -1.0, getanim(TEXT), 3.0, 0, 0, 0)
        }
        else {
            spawn2(DispC, DispC_S_MENU_BUTTON, 1, -1.0, getanim(TEXT), 4.0, 0, 0, 0)
        }
        sleepnull()
    }
}

