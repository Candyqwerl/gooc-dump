#gool BerOC 48 5

#include "..\\Includes\\goolstdlib.gooc"
#include "..\\Includes\\C2_FruiC.gooh"
//gooc -c 2 -r pal "C2\C2_BerOC.gooc" "C2\Out\C2_BerOC.nsentry"

#anim BEAR_1 [Be1tV] 16 1
#anim BEAR_2 [Be2tV] 20 1
#anim BEAR_3 [Be3tV] 40 1
#anim BEAR_4 [Be4tV] 31 1
#anim ORCA   [Or1tV] 50 0
#anim LIFTER [Ll1tV] 50 1

#spawn S_BEAR         Bear_Init
#spawn S_1            __s_1
#spawn S_ORCA         Orca_Init
#spawn S_ORCA_TWIN    Orca
#spawn S_4            __s_4
#spawn S_LIFTER       Lifter_Init
#spawn S_LIFTER_TWIN  Lifter_Init
#spawn S_BEAR_SLIDE   Bear_Slide
#spawn S_BEAR_WARP    WarpBear_Init
#spawn S_BEAR_SECRET  WarpBear_Init
#spawn S_LIGHT        LightSource

state Bear_Init { // 0
    stateflag 0x1
    statusc 0x2
    code() {
        changestateifn(Bear_Sleep, id == 10.0 && ((!CHECKPOINTCOUNT || LEVEL == LEVEL_Unbearable) && !(player -> stateflag & 0x20000000)))
        statusb = FLAG_TRACK_PATH_SIGN
        calcpath(0)
        BearWaitAnimate()
    }
    trans {
        nofirst {
            if (distance(player) < 4m || abs(degdist(atan2(player -> trans), troty)) < 90deg || abs(z - player -> z) < 2m) {
                sendevent(EventTriggerBear, player, self)
                if (eventaccepted) {
                    settrans(BearTransWait)
                }
            }
        }
    }
}

sub BearTransWait() { // S-35
    if (((player -> z < z && (LEVEL == LEVEL_BearIt || LEVEL == LEVEL_BearDown || LEVEL == LEVEL_TotallyBear)) || (player -> z > z && LEVEL == LEVEL_Unbearable)) && abs(degdist(player -> troty, atan2(player -> trans))) < 90deg) {
        player -> var0 = true
        changestate(Bear_Sleep)
    }        
}

sub BearWaitAnimate() { // S-59
    do {
        unless (rand(2)) {
            sounddelay(0.4s - 1)
            SoundPitchDefault(0.122)
            sounddecay(7.7s)
            soundplay([BG1tA], 1V)
            playframes(BEAR_3, 0.0, 34.0)
            playframe(animframe, 10)
        }
        playframes(BEAR_1, 0.0, 15.0)
        var0 = 0.5s + rand(1.5s)
        WaitFrame(var0)
        unless (rand(2)) {
            playframes(BEAR_2, 0.0, 19.0)
            playframe(animframe, 10)
            playframesback(BEAR_2, 19.0, 0.0)
            playframe(animframe, 10)
        }
        playframesback(BEAR_1, 15.0, 0.0)
        var0 = 0.5s + rand(1.5s)
        WaitFrame(var0)
    } while (1)
}

state WarpBear_Init { // 1
    stateflag 0x1
    statusc 0x2
    code() {
        health = 0
        roty = 180deg
        zindex = 24
        statusb = FLAG_COLLIDABLE | FLAG_SOLID_ALL
        if (spawn == S_BEAR_SECRET) {
            roty = 0deg
            if (player -> stateflag & 0x20000000) {
                statusb = FLAG_INVISIBLE
            }
            else {
                spawn(1, 9, 1, 0, 0) // WarpC-9
            }
        }
        changestate(WarpBear_Stand)
    }
}

sub BlockPlayerZ() {
    changestateif(WarpBear_Squashed, collider)
    if (spawn == S_BEAR_SECRET) {
        if (player -> z < z) {
            player -> z = z
        }
    }
}

state WarpBear_Stand { // 2
    stateflag 0x1
    statusc 0x2
    code => sub BearWaitAnimate
    trans => sub BlockPlayerZ
}

state WarpBear_Squashed { // 3
    stateflag 0x1
    statusc 0x2
    code() {
        playanim(34, BEAR_3)
        SoundPitchDefault(0.122)
        soundplay([BG1tA], 0.2V + rand(0.3V))
        if (collider) {
            statetime = frametime
        }
        else unless (frametime - statetime >= 0.1s) {
            collider = player
        }
        goto check
        do {
            if (collider) {
                statetime = frametime
            }
            else unless (frametime - statetime >= 0.1s) {
                collider = player
            }
            if (collider) {
                playframe(seek(animframe, 39.0))
                if (animframe == 38.0) {
                    health += 1.0
                    if (health == 10.0 && !(0x20 & GLOBAL_150)) {
                        GLOBAL_150 |= 0x20
                        do (var lives = 0) {
                            spawn(FruiC, FruiC_S_FRUIT_AUTO, 1, 97.0, 0)
                            playframe(animframe, 10)
                            LIFECOUNT = getfield(player, 0x4100) // player->mem2
                        } while ({ lives += 1.0 }; lives < 10.0)
                        playframe(animframe, 42)
                        playframe(animframe, 42)
                        LIFECOUNT = getfield(player, 0x4100) // player->mem2
                    }
                }
            }
            else {
                playframe(seek(animframe, 34.0))
            }
            check:
        } while (collider || animframe != 34.0)
        changestate(WarpBear_Stand)
    }
}

state Kill { // 4
    stateflag 0x21
    statusc 0x2
    code() {}
}

state Bear_Sleep { // 5
    stateflag 0x21
    statusc 0x2
    code() {
        sleepnull()
    }
}

state Bear_Slide { // 6
    stateflag 0x1
    statusc 0x2
    __transargs
    code(yaw) {
        entity = creator -> entity
        pathprog = creator -> pathprog
        pathlen = creator -> pathlen
        zindex = creator -> zindex
        speed = 8.0
        scalex = abs(scalex)
        statusb = FLAG_TRACK_PATH_SIGN | FLAG_ROT_Y2
        trotx = 213.35deg
        troty = roty + 320deg
        playanim(0, BEAR_4, 7)
        playframes(BEAR_4, 0.0, 30.0)
        sleep()
    }
    event(e, a) {
        accevcstate(Kill, e == Event19)
    }
    trans {
        nofirst {
            speed = seek(speed, 0, spd(2.0))
            pathprog = spd(pathprog, speed)
            save (troty) {
                calcpath(pathprog)
                save (rotx, roty, rotz, vecx, vecy, vecz) {
                    SetRot(0deg, troty, 0deg)
                    SetVec(x, y, z)
                    vectransf(vvec, vtrans, 0, -yaw, 0)
                }
            }
        }
    }
}

inline sub SetOrcaVFX() {
    if (abs(z - player -> z) < 10m) {
        vfx = (vfx & 0xFFFF00FF) | 0x600
    }
    else {
        vfx &= 0xFFFF00FF
    }
}

state Orca_Init { // 7
    stateflag 0x1
    statusc 0x2
    code(range, delay, twin, yaw, xoff) {
        if (LEVEL != LEVEL_BearIt) {
            range += player -> pathprog
        }
        while (player -> pathprog < range) { 
            playnull() 
        }
        roty = yaw
        x -= 2.2m
        if (twin == 2.0) {
            x += xoff
            spawn(BerOC, S_ORCA_TWIN, 1, 1s + (delay >> 1), delay)
            x -= xoff << 1
        }
        changestate(Orca, 0s, delay)
    }
    trans {
        SetOrcaVFX()
    }
}

state Orca { // 8
    stateflag 0x1
    statusc 0x2
    code(submerged, breach) {
        zindex = 0
        WaitNull(submerged)
        statusb = FLAG_COLLIDABLE | FLAG_SOLID_ALL
        do {
            WaitNull(breach)
            WaitNullUntil(!(player -> stateflag & 0x20) && !player -> invincible)
            sounddelay(0.18s)
            SoundPitchDefault()
            sounddecay(10.2s)
            soundplay([WhEGA], 0.8V)
            sounddelay(1.1s)
            SoundPitchDefault()
            sounddecay(10.2s)
            soundplay([WhSGA], 0.8V)
            playframes(ORCA, 0.0, 49.0)
        } while (1)
    }
    trans {
        sendevent(Event61, collider, 100.0)
        SetOrcaVFX()
    }
}

state Lifter_Init { // 9
    stateflag 0x3
    statusc 0x0
    code(yaw, range, drop, lift) {
        roty = yaw
        if (spawn == S_LIFTER_TWIN) {
            scalex = -scalex
        }
        else {
            spawn(BerOC, S_LIFTER_TWIN, 1, yaw, range, drop, lift)
        }
        statusb = FLAG_COLLIDABLE | FLAG_SOLID_ALL
        range += player -> pathprog
        while (player -> pathprog < range) {
            playanim(0, LIFTER) 
        }
        changestate(Lifter, 2s + ((drop * 1s / 1.2s) + (lift * 1s / 1.2s)), 0, lift * 1s / 1.2s, drop * 1s / 1.2s)
    }
}

state Lifter { // 10
    stateflag 0x3
    statusc 0x0
    code(ua, ub, drop, lift) {
        do {
            WaitFrame(lift)
            soundpitch(3.263)
            sounddecay(10.2s)
            soundplay([MBLyA], 2.25V)
            playframes(LIFTER, 0.0, 24.0)
            WaitFrame(drop)
            soundpitch(3.263)
            sounddelay(0.35s)
            sounddecay(10.2s)
            soundplay([MBDyA], 0.8V)
            playframes(LIFTER, 25.0, 49.0)
        } while (1)
    }
    trans {
        sendevent(Event24, collider, 100.0)
    }
}

state LightSource { // 11
    stateflag 0x40003
    statusc 0x22
    code() {
        GLOBAL_55 = 1.0
        GLOBAL_54 = self
        GLOBAL_120 = parent
        do {
            x = parent -> x
            z = parent -> z
            if (parent -> stateflag & 0x20000000) {
                y = parent -> groundy + 2m
            } 
            else {
                y = parent -> y + 2m
            }
            save (rotx, roty, rotz, vecx, vecy, vecz) {
                SetRot(0deg, CAMROTY, 0deg)
                SetVec(x, y, z)
                vectransf(vvec, vtrans, -4m, 0, 0)
            }
            playnull()
        } while (1)
    }
}
