        playframes(WILLY_JUMP_UP, 0.0, 11.0)
        PlayFall()
    }
}

sub PlayJumpFlip() {
    playframes(WILLY_JUMP_FLIP, 0.0, 12.0)
}

sub PlayJumpFlipAndFall() {
    onstateexit(ResetStance)
    PlayJumpFlip()
    PlayFall()
}

sub AirborneEvent(e, a) {
    if (interrupter) {
        rejevret(vely < 0 && (e == EventHit || e == Event14 || e == Event20 || e == Event35 || e == Event30 || e == Event31 || e == Event62 || e == Event74) && !(interrupter -> statusc & 0x2))
    }
    rejevret(e == Event47)
}

sub UpdateAirborne() {
    if (collider, vely <= 0) {
        sendevent(EventJumpedOn, collider, BounceCombo)
        if (eventaccepted) {
            BounceCombo += 1.0
            changestate(Willy_Bounce)
        }
    }
    changestateif(Willy_Land, STATUS_GROUNDLAND)
    if (buttonbuffer(PAD_SQUARE)) {
        if (frametime - SpinCooldownTime >= 0.68s) {
            changestate(Willy_Spin_Air_Start)
        }
        else {
            SoundSpinBlocked()
        }
    }
    changestateif(Willy_Slam, buttonbuffer(PAD_CIRCLE | PAD_R1) && (vely < 6m && vely > -6m), 8.94427m, 1, 10, 0)
    if (buttonhold(PAD_X) && (!(statusa & 0x80) || statusa & 0x100000)) {
        if (vely > 0) {
            vely = spd(vely, 14m)
        }
        else {
            vely = spd(vely, 7m)
        }
    }
}

sub PlayFall() {
    do {
        field_60 = 0xFC700
        playanim(13, WILLY_JUMP_FLIP)
    } until (spd(y, vely) <= field_63)
    field_60 = 0xFC700
    playanim(0, WILLY_JUMP_LAND)
    HoldAirborneFrame(0xFC700)
}

state Willy_Falling { // 27
    stateflag 0x400009
    statusc 0x0
    code => sub PlayFall
    event => sub AirborneEvent
    trans => sub UpdateAirborne
}

state Willy_Jump_Flip { // 28
    stateflag 0x400009
    statusc 0x0
    code => sub PlayJumpFlipAndFall
    event => sub AirborneEvent
    trans => sub UpdateAirborne
}

state Willy_Rise { // 29
    stateflag 0x9
    statusc 0x0
    trans => sub UpdateJumpStart
