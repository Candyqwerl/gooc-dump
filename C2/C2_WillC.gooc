state Warp_Particle_Controller { // 73
    stateflag 0x1
    statusc 0x8023
    code(mode) {
        zindex = 48
        statusb = FLAG_PHYSICS_ENGINE | FLAG_INVISIBLE
        playnull()
        if (var temp = mode; temp == 0) {
            vely = 1m
            soundpitch(3.2)
            soundplay([WRO0A], 1V)
        }
        else if (temp == 2.0) {
            vely = 7m
            vecy = 7m
            vecz = 0.1s
            soundpitch(4.0)
            soundplay([WRO0A], 1.0V)
        }
        else {
            vely = 4m
            soundpitch(4.0)
            soundplay([WRO0A], 1.0V)
            soundsetup(0, voice, 5)
        }
        playnull()
        playnull()
        do { playnull() } until (y >= vecy)
        playnull()
        parent -> var0 = 100000
        tpc = 0
        WaitChildNull()
    }
    trans {
        if (STATUS_FIRSTFRAME) {
            vecy = 2m
            vecz = 4
            y = 0
        }
        mem26 = y
        y = parent -> vecx
        parent -> var0 = (50 * mem26) / vecy
        stalltime = parent -> var0
        if (mem26 < vecy - 0.5m) {
            if (!time(vecz)) {
                if (var color = rand(5); color == 0) {
                    spawn(9, 52, 1, 0, 16, 32, 1.0, 0xB33)
                }
                else if (color == 1) {
                    spawn(9, 52, 1, 0, 8, 24, 1.0, 0xB33)
                }
                else if (color == 2) {
                    spawn(9, 52, 1, 0, 0, 16, 1.0, 0xB33)
                }
                else if (color == 3) {
                    spawn(9, 52, 1, 0, 24, 64, 1.0, 0xB33)
                }
                else if (color == 4) {
                    spawn(9, 52, 1, 0, 24, 0x80, 1.0, 0xB33)
                }
            }
        }
        else if (!time(vecz - 2)) {
            spawn(9, 52, 1, 0, 24, 0xC0, 0x200, 0xB33)
        }
        y = mem26
    }
}

