state Willy_Warp_Elevator { // 68
    stateflag 0x2001
    statusc 0x7022
    __transargs
    code(dirs) {
        onstateexit(ResetMovement)
        statusb &= ~FLAG_DPAD_CONTROL
        ResetSpeed()
        setanim(WILLY_WARP_ELEVATOR)
        if (dirs & 0x1) {
            animframe = 0
            var0 = 8.0
        }
        else {
            animframe = 24.0
            var0 = 16.0
        }
        playframe()
        do {
            playframe(seek(animframe, var0, 1.0))
            if (animframe == var0) {
                if (var0 == 8.0 && (dirs & 0x2)) {
                    playframe(animframe, 42)
                    var0 = 16.0
                }
                else if (var0 == 16.0 && (dirs & 0x1)) {
                    playframe(animframe, 42)
                    var0 = 8.0
                }
            }
        } while (1)
    }
    event(e, a) {
        accevcstate(Willy_Jump_Start, e == Event21)
        accevif (e == Event77) {
            dirs = a[0]
        }
    }
}
#module default

sub CleanupLevelExit() {
    BounceCombo = 0
    ResetMovement()
    GAMEFLAGS |= 0x800000
}

sub MarkLevelExit(level) {
    var saved = level
    GLOBAL_131 = 1
}

state Willy_Respawn { // 69
    stateflag 0x8001
    statusc 0x5022
    code() {
        onstateexit(ResetMovement)
        statusb = FLAG_HAS_SHADOW | FLAG_NO_CAMERA_CLIP
        playnull()
        SetScale(1S)
        ResetRespawnFields()
        sendevent(Event15, creator, 4.0)
        {
            var dda, masks = var0
            if (LEVEL == LEVEL_BearIt
                || LEVEL == LEVEL_BearDown
                || LEVEL == LEVEL_TotallyBear
                || LEVEL == LEVEL_CrashDash
                || LEVEL == LEVEL_CrashCrush
                || LEVEL == LEVEL_Unbearable
                || LEVEL == LEVEL_BossCortex
                || LEVEL == LEVEL_BossRipperRoo 
                || LEVEL == LEVEL_BossNGin
                || LEVEL == LEVEL_BossTazTiger 
                || LEVEL == LEVEL_WarpRoom) {
                    dda = 2.0
                }
            else if (LEVEL == LEVEL_BossKimodo) {
                dda = -2.0
            }
            else if (CHECKPOINTID > 0) {
                interrupter = objectget(CHECKPOINTID)
                if (interrupter) {
                    save (entity) {
                        entity = interrupter -> entity
                        dda = fieldval(0x29800)
                    }
                }
            }
            else {
                dda = mem22
            }
            if (((SECTIONDEATHCOUNT >= 7.0 && dda < 2.0) || dda <= -1.0) && masks <= 1.0) {
                sendevent(Event6, creator, self, -SECTIONDEATHCOUNT)
                sendeventif(Event6, creator, ((SECTIONDEATHCOUNT >= 15.0 && dda < 1.0) || dda <= -2.0) && !masks, self, -2)
            }
        }
        if (DEATHCOUNT == 0) {
            GLOBAL_66 = frametime
        }
        if (var level = LEVEL; level == LEVEL_WarpRoom) {
            GLOBAL_90 = 0
            if (CURRENTLEVEL != 99) {
                if (GLOBAL_10 == 3.0) {
                    var bit = CURRENTLEVEL >> 8
                    if (bit < 32) {
                        GLOBAL_27 |= 1 << bit
                    }
                    else {
                        GLOBAL_28 |= 1 << (bit - 32)
                    }
                }
                hpc = 0
                if ((GEMPOOL1 || GEMPOOL2 || CRYSTALPOOL1 || CRYSTALPOOL2) && GLOBAL_10 == 3.0) {
                    changestate(Willy_Warp_Return_Win)
                }
                else {
                    changestate(Willy_Warp_Return_Fail)
                }
            }
        }
        else if (level == LEVEL_Intro) {
            changestateifn(Willy_Intro, CHECKPOINTCOUNT)
        }
        else if (level == LEVEL_RockIt || level == LEVEL_PackAttack) {
            changestateif(Willy_Jetpack_Mount, CHECKPOINTCOUNT)
        }
        else if (level == LEVEL_BearIt || level == LEVEL_BearDown || level == LEVEL_TotallyBear) {
            changestateif(Willy_Bear_Mount, CHECKPOINTCOUNT)
        }
        else if (level == LEVEL_BossCortex) {
            changestate(Willy_Jetpack_Mount)
        }
        else if (level == LEVEL_HangEight || level == LEVEL_PlantFood) {
            if (!GLOBAL_108) {
                spawn(DispC, DispC_S_TIMETRIAL)
            }
        }
        else if (level == LEVEL_BossNGin) {
            mem39 = 0
            changestate(Willy_NGin_Idle)
        }
        else if (level == LEVEL_BossKimodo) {
            troty += 180deg
            roty = troty
        }
        PrepareLevelArrival(RESPAWNCOUNT)
        if (DEATHCOUNT == 0) {
            GLOBAL_66 = frametime
        }
        changestateif(Willy_Idle, STATUS_GROUNDLAND)
        changestate(Willy_Falling_Transition)
    }
    event(e, a) {
        rejevret(e == Event19)
    }
}

sub CleanupExtraAnims() {
    DeloadExtraAnims()
    ResetMovement()
}

sub CheckDanceSkip() {
    changestateif(Willy_Idle, buttonpress(PAD_TRIANGLE))
}

sub ResetRespawnFields() {
    zindex = 24
    SpinCooldownTime = 0
    SpinCooldownLimit = 0.76s
    SpinPulseTime = 0
    BoxCount = BOXCOUNT
    statusa &= ~0x2000000
    invincible = 0
}

sub UpdateWarpFade() __trans {
    once {
        vfx = (vfx & 0xFF00FFFF) | 0x20000
        moda = 16.0
        SetColor1(0, 0, 0)
    }
    moda = seek(moda, 0, 3.2)
    if (!moda) {
        vfx &= 0xFF00FFFF
    }
}

#module [Wil2C]
state Willy_Warp_Return_Fail { // 70
    stateflag 0x8001
    statusc 0x5022
    event => state Willy_Respawn
    code() {
        onstateexit(ResetMovement)
        CRYSTALPOOL1 = 0
        CRYSTALPOOL2 = 0
        GEMPOOL1 = 0
        GEMPOOL2 = 0
        roty = 180deg
        troty = 180deg
        if (getpayload(&[Cw12V], &[Cr10G]) <= getfreepages()) {
            LoadAnim([Cw12V], [Cr10G])
            playnull(21)
            do { playnull() } until (isloaded([Cw12V]) && isloaded([Cr10G]))
            statusb = FLAG_PHYSICS_TEST | FLAG_GRAVITY | FLAG_PHYSICS_ENGINE | FLAG_NO_CAMERA_CLIP | FLAG_HAS_SHADOW
            settrans(UpdateWarpFade)
            playframes(WILLY_WARP_RETURN_FAIL, 0.0, 12.0)
            spawn(9, 2, 1, 0, 5.0, 4m)
            soundpitch(5.19)
            sounddecay(3.2s)
            soundplay([BRltA], 0.3V)
            playframes(13.0, 43.0)
            playanim(44, WILLY_WARP_RETURN_FAIL, 21)
            setanim(WILLY_WARP_RETURN_FAIL, 46.0)
            do {
                animframe += 1.0
                if (animframe == 54.0 || animframe == 59.0) {
                    soundpitch(3.12)
                    sounddecay(3.2s)
                    soundplay(SOUND_FOOTSTEP_DEFAULT, 0.15V)
                }
                playframe()
            } while (animframe + 1.0 <= 70.0)
            DeloadAnim([Cw12V], [Cr10G])
        }
        changestate(Willy_Idle)
    }
}

inline sub AdvancePool() {
    field_61 = field_61 >> 1 & 0x7FFFFFFF
    v0 += 1.0
}

state Willy_Warp_Return_Win { // 71
    stateflag 0x8001
    statusc 0x5022
    event => state Willy_Respawn
    code() {
        onstateexit(ResetMovement)
        roty = 180deg
        troty = 180deg
        if (getpayload(&[Cw52V], &[Cr10G], &[Cw22V], &[Cr10G]) <= getfreepages()) {
            LoadAnim([Cw22V], [Cr10G])
            LoadAnim([Cw52V], [Cr10G])
            playnull(21)
            statusb = FLAG_PHYSICS_TEST | FLAG_GRAVITY | FLAG_PHYSICS_ENGINE | FLAG_NO_CAMERA_CLIP | FLAG_HAS_SHADOW
            settrans(UpdateWarpFade)
            playframes(WILLY_WARP_RETURN_WIN, 0.0, 17.0)
            spawn(9, 2, 1, 0, 5.0, 4m)
            setanim(WILLY_WARP_RETURN_WIN, 17.0)
            do {
                animframe += 1.0
                if (animframe == 18.0 || animframe == 23.0 || animframe == 41.0) {
                    soundpitch(3.12)
                    sounddecay(3.2s)
                    soundplay(SOUND_FOOTSTEP_DEFAULT, 0.15V)
                }
                playframe()
            } while (animframe + 1.0 <= 55.0)
            mem37 = 0
            if (GLOBAL_10 == 3.0) {
                SAVEDGEMPOOL1 |= GEMPOOL1
                SAVEDGEMPOOL2 |= GEMPOOL2
                SAVEDCRYSTALPOOL1 |= CRYSTALPOOL1
                SAVEDCRYSTALPOOL2 |= CRYSTALPOOL2
                v0 = 200.0
                field_61 = CRYSTALPOOL1
                while (field_61) {
                    until (field_61 & 1) { AdvancePool() }
                    WillyGiveRewards(v0)
                    AdvancePool()
                }
                v0 = 232.0
                field_61 = CRYSTALPOOL2
                while (field_61) {
                    until (field_61 & 1) { AdvancePool() }
                    WillyGiveRewards(v0)
                    AdvancePool()
                }
                v0 = 300.0
                field_61 = GEMPOOL1
                while (field_61) {
                    until (field_61 & 1) { AdvancePool() }
                    WillyGiveRewards(v0)
                    mem37 = 1.0
                    AdvancePool()
                }
                v0 = 332.0
                field_61 = GEMPOOL2
                while (field_61) {
                    until (field_61 & 1) { AdvancePool() }
                    WillyGiveRewards(v0)
                    mem37 = 1.0
                    AdvancePool()
                }
            }
            DeloadAnim([Cw22V], [Cr10G])
            DeloadAnim([Cw52V], [Cr10G])
        }
        CRYSTALPOOL1 = 0
        CRYSTALPOOL2 = 0
        GEMPOOL1 = 0
        GEMPOOL2 = 0
        if (mem37) {
            onstateexit(CleanupExtraAnims)
            settrans(CheckDanceSkip)
            LoadAnim([CD10V], [Cr10G])
            ExtraAnimGroup = 15.0
            do { PlayMoveFrame() } until (isloaded([CD10V]) && isloaded([Cr10G]))
            WillyPlayDance()
        }
        changestate(Willy_Idle)
    }
}

sub WillyGiveRewards(reward) {
    save (var0) {
        playanim(0, WILLY_STAND_1)
        playframes(WILLY_WARP_GIVE_REWARDS, 0.0, 6.0)
        playframe(animframe, 2)
        var0 = 0
        broadcastevent(Event79, 0, reward)
        if (!var0) {
            save (y) {
                y += 20m
                spawn2(FruiC, FruiC_S_GEM_WARP, 1, reward, -0xCCC, -0x800, 0, 0x80, 0, 0)
            }
            playframe()
            playframe()
            broadcastevent(Event79, 0, reward)
        }
        soundpitch(1.96)
        sounddecay(3.2s)
        soundplay([DSw0A], 0.8V)
        animframe = 6.0
        do {
            animframe += 1.0
            if (animframe == 17.0) {
                soundpitch(3.12)
                sounddecay(3.2s)
                soundplay(SOUND_FOOTSTEP_DEFAULT, 0.15V)
            }
            playframe()
        } while (animframe + 1.0 <= 20.0)
        interrupter = var0
        sendevent(EventTriggered, interrupter)
        soundpitch(4.352)
        sounddecay(10s)
        soundplay([GSh2A], 1V)
        animframe = 20.0
        do {
            animframe += 1.0
            if (animframe == 22.0) {
                soundpitch(3.446)
                sounddecay(3.2s)
                soundplay(SOUND_FOOTSTEP_DEFAULT, 0.15V)
            }
            playframe()
        } while (animframe + 1.0 <= 31.0)
        playframe(animframe, 21)
        playframes(32.0, 38.0)
    }
}
