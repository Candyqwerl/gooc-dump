                playanim(19, WILLY_MINE)
            }
        }
        spawn(9, 2, 1, 0, 5.0, 4m)
        playframes(WILLY_MINE, 20.0, 25.0)
        changestate(Willy_Idle)
    }
}

state Willy_Boulder_Door { // 35
    stateflag 0x5
    statusc 0x0
    event => sub MovementEvent
    code() {
        if (animframe == 9.0) {
            scalex = -scalex
        }
        save (statusb) {
            statusb &= ~(FLAG_ROT_Y | FLAG_DPAD_CONTROL)
            ResetSpeed()
            roty = 0deg
            troty = 0deg
            var0 = 100.0
            setanim(WILLY_DIVE_BOULDER, -1.0)
            do {
                animframe += 1.0
                z += var0
                playframe()
            } while (animframe + 1.0 <= 13.0)
            animframe = 12.0
            do {
                animframe += 1.0
                var0 = (var0 * 14) >> 4
                z += var0
                playframe()
            } while (animframe + 1.0 <= 30.0)
            playframes(31.0, 44.0)
            playframes(47.0, 70.0)
        }
        changestate(Willy_Idle)
    }
    trans {
        sendevent(EventHitInvincible, collider, 0)
    }
}
#module default

state Willy_Accelerate { // 36
    stateflag 0x210105
    statusc 0x0
    __transargs
    code(yaw) {
        do {
            unless (animseq == getanim(WILLY_RUN) || animseq == getanim(WILLY_ACCELERATE)) {
                animframe = -1.0
            }
            setanim(WILLY_ACCELERATE)
            playframe((animframe + 1.0) % 17.0)
            if (animframe == 8.0) {
                SoundFootstepDefault()
            }
            else if (animframe == 16.0) {
                SoundPitchDefault(0.23)
                sounddecay(3.2s)
                soundplay(SOUND_FOOTSTEP_DEFAULT, 0.1V)
            }
        } while (1)
    }
    trans {
        once {
            troty = yaw
            mem31 = (interrupter -> x - x) << 1
            mem33 = (interrupter -> z - z) << 1
            onstateexit(ResetMovement)
            statusb &= ~FLAG_DPAD_CONTROL
            SoundPitchDefault(0.122)
            sounddecay(6.4s)
            soundplay([TPdoA], 0.4V)
        }
        unless (frametime - statetime >= 0.2s) {
            speed += 11m
            if (speed > 18m) {
                speed = 18m
            }
            setvel(speed)
        }
        if (frametime - statetime >= 0.24s) {
            statusb |= FLAG_DPAD_CONTROL
        }
        x = spd(x, mem31)
        z = spd(z, mem33)
        if (FRAMETIME < 36) {
            spawn(9, 21, 1, 0, randi(-2m, 2m), 4m, -rand(1m), 2S, 0, 24, 3)
        }
        sendevent(Event10, collider, 100.0)
        changestateif(Willy_Jump_Accelerate, buttonbuffer(PAD_X) && (!(statusa & 0x80) || statusa & 0x100000), 10.469m)
        if (frametime - statetime >= 0.48s) {
            setanim(WILLY_RUN)
            changestate(Willy_Move)
        }
    }
}

state Willy_Jump_Accelerate { // 37
    stateflag 0x200109
    statusc 0x400001
    code => state Willy_Jump_Run
    trans {
        unless (frametime - statetime >= 0.2s) {
            speed += 11m
            if (speed > 18m) {
                speed = 18m
            }
        }
        UpdateJumpStart()
    }
}

state Willy_Trans_Elevator { // 38
    stateflag 0x42408
    statusc 0x2423
    __transargs
    trans => sub UpdateElevatorTrans
    code(catcher, pointer, mode, tx, ty, tz, obj) {
        onstateexit(ResetMovement)
        statusb &= ~FLAG_PHYSICS_TEST
        statusb |= FLAG_SOLID_GROUND
        mem37 = 0
        if (mode == 1.0) {
            stateflag |= 0x400000
        }
        player = obj
        if (player) {
            mem25 = player -> x
            mem27 = player -> z
            groundy = player -> y
        }
        ResetSpeed()
        BounceCombo += 1.0
        vely = 0
        SoundJumpDefault()
        if (BONUSSTATE == BONUS_CURRENT) {
            SetBonusState(BONUS_COMPLETED)
        }
        ins72(0x200, 0x2000)
        do {
            PlayMoveFrame() 
        } until (mem37)
        ins72(0, pointer)
        if (mode == 2.0) {
            mem37 = 0
            do { 
                PlayMoveFrame()
            } until (mem37)
            ins72(0, pointer)
        }
        if (mode == 0.0 || mode == 2.0) {
            x = tx + vecx
            z = tz + vecz
            y = ty
            ins72(0x400, 0x100)
            save (statusb) {
                statusb &= ~(FLAG_PHYSICS_TEST | FLAG_GRAVITY | FLAG_PHYSICS_ENGINE | FLAG_DPAD_CONTROL)
                tpc = 0
                do {
                    player = objectget(catcher)
                    playnull()
                } until (player)
                mem37 = 0
                sendevent(EventTriggered, player)
                mem25 = player -> x
                mem27 = player -> z
                settrans(UpdateElevatorTrans)
                playnull()
                playnull()
            }
        }
        else {
            mem37 = 0
        }
        do { PlayMoveFrame() } until (mem37)
        ins72(0x300, 0x2000)
        ins72(0x100, 0x100)
        statusc &= ~0x401
        statusa |= FLAG_GROUNDLAND
        groundtime = frametime
        changestate(Willy_Idle)
    }
    event(e, a) {
        if (e == EventTriggered) {
            if (mode == 0) {
                player = 0
            }
            mem37 = 1.0
        }
    }
}

sub UpdateElevatorTrans(catcher, pointer, mode, tx, ty, tz, obj) __trans {
    nofirst {
        if (player) {
            y = player -> y
            groundy = y
            x += player -> x - mem25
            vecx = x - player -> x
            if (vecx < -0.3m) {
                velx = 0
                x = player -> x - 0.3m
            }
            if (vecx > 0.3m) {
                velx = 0
                x = player -> x + 0.3m
            }
            mem25 = player -> x
            z += player -> z - mem27
            vecz = z - player -> z
            if (vecz < -0.3m) {
                velz = 0
                z = player -> z - 0.3m
            }
            if (vecz > 0.3m) {
                velz = 0
                z = player -> z + 0.3m
            }
            mem27 = player -> z
        }
    }
}

state Willy_Trans_Warp { // 39
