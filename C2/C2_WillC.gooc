        spawn(WillC, S_PARTICLE_2, 1, 2.0)
        if (animframe > 37.5) {
            tpc = 0
        }
    }
}

sub PrepareLevelArrival(respawns) {
    if (getpayload(&[Cr10G], &[Cwa0V], &[WWP3G], &[WWP3V], &[WWP1G], &[WWP1V]) <= getfreepages()) {
        GAMEFLAGS &= ~0x2
        if (!GLOBAL_105) {
            LoadAnim([WWP1V], [WWP1G])
            LoadAnim([WWP3V], [WWP3G])
            LoadAnim([Cwa0V], [Cr10G])
        }
        else {
            loadfile2([WWP1V])
            loadfile2([WWP1G])
            loadfile2([WWP3V])
            loadfile2([WWP3G])
            loadfile2([Cwa0V])
            loadfile2([Cr10G])
        }
        ExtraAnimGroup = 8.0
        statusb = FLAG_PHYSICS_TEST | FLAG_INVISIBLE | FLAG_NO_CAMERA_CLIP
        do {
            playnull()
        } until (isloaded([Cr10G]) && isloaded([Cwa0V]) && isloaded([WWP3G]) && isloaded([WWP3V]) && isloaded([WWP1G]) && isloaded([WWP1V]))
        GAMEFLAGS |= 0x2
        spawn2(WillC, S_WARP_CONTROLLER, 1, respawns)
        if (objectspawned) {
            if (!respawns) {
                spawn(WillC, S_PARTICLE_1)
            }
            var0 = 0
            groundy = y
            settrans(SpawnWarpInParticles)
            playnull()
            statusb = FLAG_PHYSICS_TEST | FLAG_PHYSICS_ENGINE | FLAG_GRAVITY | FLAG_NO_CAMERA_CLIP
            save (vfx, statusb) {
                vecy = 0
                vfx = (vfx & 0xFFFF00FF) | 0x1300
                setanim(WILLY_WARP, 0)
                statetime = frametime
                statusb |= 0x80000000 | FLAG_GRAVITY | FLAG_PHYSICS_ENGINE
                vecx = groundy - 1m
                while (var0 << 8 <= 49.0 && !(frametime - statetime >= 2.5s)) {
                    playframe(var0 << 8)
                    save (x, y, z) {
                        getvert(vtrans, self, 0)
                        vecx = y
                    }
                }
                tpc = 0
            }
        }
        DeloadAnim([WWP1V], [WWP1G])
        DeloadAnim([WWP3V], [WWP3G])
        DeloadAnim([Cwa0V], [Cr10G])
        ExtraAnimGroup = 0
    }
}

