state Willy_Dig_Dive { // 116
    stateflag 0x5
    statusc 0x2
    trans => sub BroadcastDigAttack
    code() {
        stateflag |= 0x400000
        statusb &= ~(FLAG_DPAD_CONTROL | FLAG_GRAVITY)
        SetVel(0m)
        playframes(WILLY_DIG_DIVE_1, 0.0, 11.0)
        playframes(WILLY_DIG_DIVE_2, 0.0, 5.0)
        animframe = 5.0
        do {
            animframe += 1.0
            spawn(9, 1, 2, 0)
            playframe()
        } while (animframe + 1.0 <= 7.0)
        GAMEFLAGS |= GFLAG_DIRT_MOUND
        stateflag |= 0x20000000
        statusb &= ~FLAG_HAS_SHADOW
        statusb |= FLAG_DPAD_CONTROL
        GLOBAL_144 = -1.0
        animframe = 7.0
        do {
            animframe += 1.0
            GLOBAL_144 += 1.0
            spawn(9, 1, 2, 0)
            playframe()
        } while (animframe + 1.0 <= 14.0)
        GLOBAL_144 = 7.0
        changestate(Willy_Dig_Move)
    }
}

sub BroadcastDigAttack() {
    broadcastevent(EventSpinHit, 4, AttackCombo)
    if (eventaccepted) {
        SoundAttackCombo()
    }
}

state Willy_Dig_Move { // 117
    stateflag 0x30000005
    statusc 0x0
    code() {
        statusb |= FLAG_INVISIBLE | FLAG_GRAVITY
        sleepanim(0, WILLY_DUCK)
    }
    event(e, a) {
        accevret(e == Event59)
        rejevret(e == EventHit
            || e == Event9
            || e == Event12
            || e == Event20
            || e == Event24
            || e == Event25
            || e == Event30
            || e == Event31
            || e == Event33
            || e == Event35
            || e == Event37
            || e == Event38
            || e == Event44
            || e == Event62
            || e == Event61
            || e == Event74)
        accevcstate(Willy_Dig_Death, e == Event14 || e == Event25 || e == Event63)
    }
    trans {
        once {
            ResetCombos()
        }
        changestateif(Willy_Dig_Jump_Out, buttonbuffer(PAD_X) && (!(statusa & 0x80) || statusa & 0x100000))
        if (buttonbuffer(PAD_SQUARE)) {
            if (frametime - SpinCooldownTime >= 0.7s) {
                changestate(Willy_Dig_Spin)
            }
            else {
                SoundSpinBlocked()
            }
        }
    }
}

state Willy_Dig_Spin { // 118
    stateflag 0x20000015
    statusc 0x0
    code() {
        statusc |= 0x1002
        SpinPulseTime = frametime
        statusb &= ~FLAG_INVISIBLE
        SoundSpinDefault()
        setanim(WILLY_DIG_SPIN)
        do (var f = 0) {
            GLOBAL_144 = 5.0 + (((GLOBAL_144 - 5.0) + 1.0) % 3.0)
            playframe(loopseek(f, 10.0))
        } until (frametime - SpinPulseTime >= SpinDuration)
        statusc &= ~0x1002
        statusb |= FLAG_INVISIBLE
        GLOBAL_144 = 7.0
        changestate(Willy_Dig_Move)
    }
    event(e, a) {
        rejevif (e == Event42) {
            sendevent(EventSpinHit, interrupter, 1)
        }
        rejevif (e == Event40) {
            save (interrupter) {
                interrupter = a[0]
                sendevent(EventSpinHit, interrupter, 1)
            }
        }
        accevret(e == Event59)
        rejevret(e == EventHit
            || e == Event9
            || e == Event12
            || e == Event14
            || e == Event20
            || e == Event24
            || e == Event30
            || e == Event31
            || e == Event33
            || e == Event35
            || e == Event37
            || e == Event38
            || e == Event44
            || e == Event61
            || e == Event62
            || e == Event63
            || e == Event74)
        accevcstate(Willy_Dig_Death, e == Event25)
    }
    trans {
        sendevent(EventSpinHit, collider, AttackCombo)
        if (eventaccepted) {
            SoundAttackCombo()
        }
    }
}

state Willy_Dig_Jump_Out { // 119
    stateflag 0x20000005
    statusc 0x2
    code() {
        onstateexit(ResetMovement)
        statusb &= ~(FLAG_INVISIBLE | FLAG_GRAVITY | FLAG_DPAD_CONTROL)
        SetVel(0m)
        GLOBAL_144 = 6.0
        playnull(1)
        GLOBAL_144 = 5.0
        playnull(1)
        GLOBAL_144 = 4.0
        playnull(1)
        GLOBAL_144 = 3.0
        playnull(2)
        GLOBAL_144 = 4.0
        playnull(1)
        GLOBAL_144 = 5.0
        playnull(1)
        GLOBAL_144 = 6.0
        playnull(1)
        GLOBAL_144 = 5.0
        playanim(0, WILLY_DIG_JUMP_OUT_1)
        GLOBAL_144 = 4.0
        playanim(1, WILLY_DIG_JUMP_OUT_1)
        GLOBAL_144 = 3.0
        playanim(2, WILLY_DIG_JUMP_OUT_1)
        GAMEFLAGS &= ~GFLAG_DIRT_MOUND
        stateflag &= ~0x20000004
        stateflag |= 0x8
        settrans(BroadcastDigAttack)
        setanim(WILLY_DIG_JUMP_OUT_1, 2.0)
        do {
            animframe += 1.0
            spawn(9, 1, 2, 0)
            playframe()
        } while (animframe + 1.0 <= 4.0)
        setevent(SpinEvent)
        playanim(0, WILLY_DIG_JUMP_OUT_2)
        playanim(1, WILLY_DIG_JUMP_OUT_2)
        playanim(2, WILLY_DIG_JUMP_OUT_2)
        playanim(3, WILLY_DIG_JUMP_OUT_2)
        playanim(4, WILLY_DIG_JUMP_OUT_2)
        playanim(5, WILLY_DIG_JUMP_OUT_2)
        playanim(6, WILLY_DIG_JUMP_OUT_2)
        playanim(7, WILLY_DIG_JUMP_OUT_2)
        statusc &= ~0x2
        tpc = 0
        playanim(0, WILLY_DIG_UP)
        playanim(1, WILLY_DIG_UP)
        playanim(2, WILLY_DIG_UP)
        playanim(2, WILLY_DIG_UP)
        playanim(3, WILLY_DIG_UP)
        playanim(4, WILLY_DIG_UP)
        playanim(5, WILLY_DIG_UP)
        playanim(6, WILLY_DIG_UP)
        SetVel(0m)
        statusb |= FLAG_DPAD_CONTROL
        changestate(Willy_Falling)
    }
}

state Willy_Dig_Death { // 120
    stateflag 0x30004027
    statusc 0x7002
    code(hit) {
        var flags = statusb, game = GAMEFLAGS
        BeginDeath(hit)
        var0 = false
        sendevent(EventHit, creator, hit)
        if (eventaccepted) {
            var0 = true
        }
        KillBonus()
        SoundDeathArg()
        if (var0) {
            do (var start = frametime) {
                GLOBAL_144 = 5.0 + (((GLOBAL_144 - 5.0) + 1.0) % 3.0)
                playframe()
            } while (frametime - start < 1s)
            hpc = 0
            statusb = flags
            GAMEFLAGS = game
            CheckInvincible()
            changestate(Willy_Dig_Move)
        }
        do (var f = 0) {
            GLOBAL_144 = f
            playframe()
            f += 1.0
        } while (f < 8.0)
        statusb &= ~FLAG_INVISIBLE
        troty = GAMEDIR
        roty = troty
        playframes(WILLY_DEATH_TOMBSTONE, 0.0, 16.0)
        playframe(animframe, 21)
        FadeToBlack()
        WaitFadeFrame()
        CrashDoRespawn()
    }
}

state Willy_Death_Tombstone { // 121
    stateflag 0x30004027
    statusc 0x7002
    code(hit) {
        TryBeginDeath(hit)
        KillBonus()
        SoundDeathArg()
        scaley = 0.5S
        playframe()
        scaley = 0.1S
        playframe()
        statusb |= FLAG_INVISIBLE
        SetScale(1S)
        if (statusa & 0x4000000) {
            GAMEFLAGS |= GFLAG_DIRT_MOUND
            statusb &= ~FLAG_HAS_SHADOW
            do (var f = 2.0) {
                GLOBAL_144 = f
                playframe()
                f += 1.0
            } while (f <= 7.0)
        }
        else {
            y -= 0.6m
        }
        playframe(animframe, 8)
        statusb &= ~FLAG_INVISIBLE
        troty = GAMEDIR
        roty = troty
        playframes(WILLY_DEATH_TOMBSTONE, 0.0, 16.0)
        playframe(animframe, 21)
        FadeToBlack()
        WaitFadeFrame()
        CrashDoRespawn()
    }
}

state Willy_Death_Bee { // 122
    stateflag 0x22
    statusc 0x7022
    event => sub AirborneEvent
    code(hit) {
        TryBeginDeath(hit)
        KillBonus()
        statusb |= FLAG_ROT_Y | FLAG_GRAVITY | FLAG_PHYSICS_ENGINE | FLAG_PHYSICS_TEST
        trotx = 180deg
        troty = CAMROTY
        SetColor1(0x40, 0x40, 0x60)
        SoundDeathArg()
        playframes(WILLY_MINE, 0.0, 17.0)
        while (tpc) {
            playanim(18, WILLY_MINE)
        }
        if (!STATUS_GROUNDLAND) {
            playanim(18, WILLY_MINE)
            if (!STATUS_GROUNDLAND) {
                playanim(19, WILLY_MINE)
            }
        }
        spawn(9, 2, 1, 0, 5.0, 4m) // PartC-2
        playframes(20.0, 22.0)
        playframes(WILLY_DEATH_BEE_1, 0.0, 68.0)
        playanim(0, WILLY_DEATH_BEE_2)
        playanim(1, WILLY_DEATH_BEE_2)
        playanim(2, WILLY_DEATH_BEE_2)
        playanim(2, WILLY_DEATH_BEE_2)
        playanim(3, WILLY_DEATH_BEE_2)
        playanim(4, WILLY_DEATH_BEE_2)
        playanim(5, WILLY_DEATH_BEE_2)
        playanim(6, WILLY_DEATH_BEE_2)
        playframe(animframe, 21)
        FadeToBlack()
        WaitFadeFrame()
        CrashDoRespawn()
    }
    trans {
        once {
            onstateexit(StopAndRestoreControl)
            statusa &= ~FLAG_GROUNDLAND
            vely = 17.88854m
            roty = troty
            velx = (velx * 0.6) >> 8
            velz = (velz * 0.6) >> 8
        }
        moda = seek(moda, 0x4CC, 0xA3)
        if (STATUS_GROUNDLAND || (vely < 0m && spd(y, vely) <= field_63) || frametime - statetime >= 2s) {
            tpc = 0
        }
    }
}
#module default

#module [Wil9C]
#purge 9
inline sub CheckNGinFruit() {
    if (buttonpress(PAD_SQUARE | PAD_CIRCLE) && frametime - mem39 >= 0.3s) {
        mem39 = frametime
        spawn(58, 5, 1, 1.0)
    }
}

state Willy_NGin_Idle { // 123
    stateflag 0x5
    statusc 0x0
    code() {
        ResetCombos()
        if (animseq == getanim(WILLY_WALK)) {
            if (animframe >= 1.0 && animframe <= 3.0) {
                playanim(0, WILLY_WALK_STOP_1)
                playanim(1, WILLY_WALK_STOP_1)
            }
            else if (animframe >= 11.0 && animframe <= 13.0) {
                scalex = -scalex
                playanim(0, WILLY_WALK_STOP_1)
                playanim(1, WILLY_WALK_STOP_1)
                scalex = -scalex
            }
            else if (animframe >= 6.0 && animframe <= 7.0) {
                playanim(0, WILLY_WALK_STOP_2)
                playanim(1, WILLY_WALK_STOP_2)
            }
            else if (animframe >= 16.0 && animframe <= 17.0) {
                scalex = -scalex
                playanim(0, WILLY_WALK_STOP_2)
                playanim(1, WILLY_WALK_STOP_2)
                scalex = -scalex
            }
        }
        setanim(WILLY_STAND_1)
        do (var i = 0) {
            playframes(0.0, 1.0)
            playframes(2.0, 4.0)
            playframes(5.0, 19.0)
            i += 1.0
        } while (i < 4.0)
        playframes(0.0, 1.0)
        playframes(2.0, 4.0)
        playframes(5.0, 10.0)
        playframes(WILLY_STAND_2, 0.0, 17.0)
        playframes(18.0, 27.0)
        playframes(28.0, 49.0)
        playframe(animframe, 7)
        playframes(50.0, 54.0)
        playframes(55.0, 69.0)
        sleepanim(69, WILLY_STAND_2)
    }
    event(e, a) {
        CrashEventCommon(e, a)
    }
    trans {
        if (!!GLOBAL_17) {
            CheckJump(Willy_NGin_Jump_Start, 10.469m)
            changestateif(Willy_NGin_Move, abs(speed) & ~0x3)
        }
        CheckNGinFruit()
        CheckFall(Willy_NGin_Falling, Willy_NGin_Rise, 0.2s)
        if (DEBUG) {
            if (buttonhold(PAD_L2) && buttonpress(PAD_L1)) {
                invincible = 2
                invincibletime = frametime
            }
            sendeventif(Event6, creator, buttonhold(PAD_L2) && dirpress(PAD_N), self, -2)
        }
    }
}

state Willy_NGin_Move { // 124
    stateflag 0x5
    statusc 0x0
    event => state Willy_NGin_Idle
    code() {
        onstateexit(ResetStance)
        WillyPlayMovement(1.0)
    }
    trans {
        once {
            mem37 = 1.0
            mem38 = mem11
            mem23 = 1.0
        }
        if (abs(speed) > 6m && y > GLOBAL_118 && STATUS_GROUNDLAND) {
            if (mem37) {
                mem37 = 0
                spawn(9, 1, 6, 0)
            }
            else {
                if (abs(degdist(mem38, mem11)) >= 60deg) {
                    spawn(9, 1, 8, 0)
                }
            }
            mem38 = mem11
        } 
        CheckJump(Willy_NGin_Jump_Run, 10.469m)
        if (dirhold(PAD_NONE)) {
            if ((animseq == getanim(WILLY_RUN) && (animframe == 6.0 || animframe == 14.0)) || (animseq == getanim(WILLY_WALK) && (animframe == 3.0 || animframe == 13.0))) {
                speed = 0
                changestate(Willy_NGin_Idle)
            }
        }
        CheckNGinFruit()
        CheckFall(Willy_NGin_Falling, Willy_NGin_Rise, 0.2s)
    }
}

state Willy_NGin_Jump_Start { // 125
    stateflag 0x9
    statusc 0x400001
    code(vy) {
        SoundJumpDefault()
        vely = vy    
        onstateexit(ResetStance)
        statusc &= ~0x3
        if (animseq == getanim(WILLY_EDGE_1)) {
            playanim(0, WILLY_EDGE_4)
            playanim(1, WILLY_EDGE_4)
            setanim(WILLY_JUMP_START)
        }
        else {
            playframes(WILLY_JUMP_START, 0.0, 2.0)
        }
        statusc &= ~0x400000
        field_60 = -91.0
        playframe(3.0)
        HoldAirborneFrame(-91.0)
    }
    trans {
        UpdateNGinJump()
        changestateif(Willy_NGin_Jump_Up, vely < 11m)
    }
}

sub UpdateNGinJump() {
    changestateif(Willy_NGin_Land, STATUS_GROUNDLAND)
    CheckNGinFruit()
    if (buttonhold(PAD_X) && (!(statusa & 0x80) || statusa & 0x100000)) {
        if (vely > 0) {
            vely = spd(vely, 14m)
        }
        else {
            vely = spd(vely, 7m)
        }
    }
}

state Willy_NGin_Jump_Run { // 126
    stateflag 0x9
    statusc 0x400001
    trans => state Willy_NGin_Jump_Start
    code(vy) {
        SoundJumpDefault()
        vely = vy
        onstateexit(ResetStance)
        statusc &= ~0x3
        if (animseq == getanim(WILLY_RUN)) {
            if (animframe <= 1.0 || animframe == 16.0) {
                playanim(0, WILLY_JUMP_RUN_1)
                playanim(1, WILLY_JUMP_RUN_1)
                playanim(1, WILLY_JUMP_RUN_1)
            }
            else if (animframe == 2.0 || animframe == 15.0) {
                playanim(1, WILLY_JUMP_RUN_1)
                playanim(2, WILLY_JUMP_RUN_1)
            }
            else if (animframe <= 6.0) {
                playanim(0, WILLY_JUMP_RUN_2)
                playanim(1, WILLY_JUMP_RUN_2)
            }
            else if (animframe == 7.0 || animframe == 10.0) {
                scalex = -abs(scalex)
                playanim(1, WILLY_JUMP_RUN_1)
                playanim(2, WILLY_JUMP_RUN_1)
            }
            else if (animframe <= 9.0) {
                scalex = -abs(scalex)
                playanim(0, WILLY_JUMP_RUN_1)
                playanim(1, WILLY_JUMP_RUN_1)
                playanim(1, WILLY_JUMP_RUN_1)
            }
            else if (animframe <= 14.0) {
                scalex = -abs(scalex)
                playanim(0, WILLY_JUMP_RUN_2)
                playanim(1, WILLY_JUMP_RUN_2)
            }
        }
        else {
            playanim(0, WILLY_JUMP_RUN_1)
            playanim(1, WILLY_JUMP_RUN_1)
            playanim(1, WILLY_JUMP_RUN_1)
        }
        scalex = abs(scalex)
        statusc &= ~0x400000
        HoldJumpStartFrame()
    }
}

state Willy_NGin_Jump_Up { // 127
    stateflag 0x400009
    statusc 0x0
    event => state AirborneEvent
    code() {
        playframes(WILLY_JUMP_UP, 0.0, 11.0)
        PlayNGinFall()
    }
    trans {
        if (collider, vely <= 0) {
            sendevent(EventJumpedOn, collider, BounceCombo)
            if (eventaccepted) {
                BounceCombo += 1.0
                changestate(Willy_Bounce)
            }
        }
        changestateif(Willy_NGin_Land, STATUS_GROUNDLAND)
        CheckNGinFruit()
        if (buttonhold(PAD_X) && (!(statusa & 0x80) || statusa & 0x100000)) {
            if (vely > 0) {
                vely = spd(vely, 14m)
            }
            else {
                vely = spd(vely, 7m)
            }
        }
    }
}

sub PlayNGinFall() {
    do {
        field_60 = 0xFC700
        playanim(13, WILLY_JUMP_FLIP)
    } until (spd(y, vely) <= field_63)
    field_60 = 0xFC700
    playanim(0, WILLY_JUMP_LAND)
    HoldAirborneFrame(0xFC700)
}

state Willy_NGin_Land { // 128
    stateflag 0x5
    statusc 0x0
    code() {
        onstateexit(StopAndRestoreControl)
        statusb &= ~FLAG_DPAD_CONTROL
        playanim(2, WILLY_JUMP_LAND)
        playframes(3.0, 7.0)
        if (statusa & 0x2000000) {
            playframes(WILLY_ICE_5, 0.0, 11.0)
        }
        else {
            playframes(7.0, 19.0)
        }
        changestate(Willy_NGin_Idle)
    }
    trans {
        once {
            if (groundvel < -10m && y > GLOBAL_118) {
                spawn(9, 2, 1, -1.0, 5.0, groundvel + 8m)
            }
            if (collider, vely <= 0, statusa & 0x4000) {
                unless (statusa & 0x40000) {
                    sendevent(EventJumpedOn, collider, 100)
                    changestateif(Willy_Bounce, eventaccepted)
                }
            }
            ResetCombos()
            soundpitch(3.6 + rand(0.8))
            sounddecay(5.76s)
            soundplay(SOUND_LAND_DEFAULT, 0.3V)
            if (GLOBAL_119 & 0x800 && !(statusa & 0x2000000) && statusa & 0x40000) {
                spawn(9, 37, 1, 0.2m, roty, abs(scalex) / 3)
            }
            if (GLOBAL_119 & 0x800 && !(statusa & 0x2000000) && statusa & 0x40000) {
                spawn(9, 37, 1, -0.2m, roty, abs(scalex) / -3)
            }
        }
        CheckJump(Willy_NGin_Jump_Start, 10.469m)
        changestateifn(Willy_NGin_Move, dirhold(PAD_NONE))
        CheckNGinFruit()
        CheckFall(Willy_NGin_Falling, Willy_NGin_Rise, 0.32s)
        unless (statusa & 0x2000000) {
            ResetSpeed()
        }
    }
}

state Willy_NGin_Rise { // 129
    stateflag 0x9
    statusc 0x0
    trans => state Willy_NGin_Jump_Start
    code() {
        onstateexit(ResetStance)
        HoldJumpStartFrame()
    }
}

state Willy_NGin_Falling { // 130
    stateflag 0x400009
    statusc 0x0
    code => sub PlayNGinFall
    event => state AirborneEvent
    trans => state Willy_NGin_Jump_Up
}

state Willy_NGin_Bounce { // 131
    stateflag 0x1000009
    statusc 0x400003
    code() {
        __Willy_NGin_Jump_Start_CODE(14.20141m)
    }
    trans {
        once {
            sounddecay(5.76s)
            soundpitch(3.6 + (rand(0.8) + (0.4 * (BounceCombo - 1.0) >> 8)))
            soundplay([bnk0A], 0.4V)
        }
        settrans(__Willy_NGin_Jump_Start_TRANS)
        __Willy_NGin_Jump_Start_TRANS()
    }
}
#module default

#module [WilsC]
#purge s
state Willy_Intro { // 132
    stateflag 0x8001
    statusc 0x5022
    code() {
        var0 = false
        onstateexit(ResetMovement)
        troty = 68deg
        roty = troty
        trotx = 360deg
        statusb = 0
        while (GLOBAL_119 & 0x400) {
            playnull()
        }
        statusb = (FLAG_ROT_Y | FLAG_PHYSICS_TEST | FLAG_GRAVITY | FLAG_PHYSICS_ENGINE | FLAG_HAS_SHADOW)
        SetTrans(66m, 9m, 284.25m)
        do { playframes(WILLY_INTRO_SLEEP, 0.0, 49.0) } until (var0)
        var0 = false
        playframes(WILLY_INTRO_WAKE, 0.0, 3.0)
        do { playframe() } until (var0)
        var0 = false
        playframes(WILLY_INTRO_WAKE, animframe, 16.0)
        playframe(animframe, 42)
        playframe(animframe, 42)
        playframe(animframe, 42)
        playframe(animframe, 21)
        playframes(WILLY_INTRO_STAND, 0.0, 11.0)
        troty = 180deg
        SoundSpinDefault()
        playframes(WILY_INTRO_JUMP_1, 0.0, 19.0)
        playframes(WILY_INTRO_JUMP_2, 0.0, 10.0)
        GLOBAL_74 = 1.0
        save (CHECKPOINTID) {
            CHECKPOINTID = id
            SPAWNTRANSX = x
            SPAWNTRANSY = y
            SPAWNTRANSZ = z
            miscfunc(0, player, 0, 12) // TODO: loadcheckpoint params?
        }
        changestate(Willy_Land)
    }
    event(e, a) {
        accevif (e == EventTriggered) {
            var0 = true
        }
    }
}
