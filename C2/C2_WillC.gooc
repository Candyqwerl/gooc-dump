            playframe(animframe, 33)
            WaitBonusDead()
            FadeToBlack()
            WaitFadeFrame()
            DeloadAnim([WF10V], [WF10G])
        }
        CrashDoRespawn()
    }
    trans {
        once {
            trotx = 720deg
            SetColor1(0, 0, 0)
            moda = 0
            var0 = 0
        }
        unless (frametime - statetime >= 0.4s) {
            spawn(9, 21, 1, -1.0, randi(-4m, 4m), 8m, randi(-4m, 4m), 2S, 0.8, 24, 1)
        }
        moda = seek(moda, 16.0, 0x222)
        if (var0 && !rand(4)) {
            spawn(9, 0, 1, 0)
        }
    }
}

