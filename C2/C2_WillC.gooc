    }
    trans {
        once {
            mem31 = 8.0
        }
        if ((animseq == getanim(WILLY_BEAR_LAUNCH) && animframe >= 0.0 && animframe <= 11.0) || (animseq == getanim(WILLY_BEAR_LAUNCH_LAND) && animframe >= 5.0 && animframe <= 8.0)) {
