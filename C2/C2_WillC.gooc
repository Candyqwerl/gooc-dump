        ins72(0x400, 0x100)
        ins72(0x100, 0x100)
        changestate(Willy_Falling_Transition)
    }
}

state Willy_Hit { // 40
    stateflag 0x9
    statusc 0x1003
    trans => sub UpdateJumpStart
    code() {
        SoundPitchDefault(0.25)
        sounddecay(6.4s)
        soundplay([yip0A], 1V)
        SoundJumpDefault()
        unless (statusa & 0x80) {
            vely = 12.64912m
        }
        onstateexit(ResetStance)
        field_60 = -91.0
        playanim(13, WILLY_JUMP_FLIP)
        statusc &= ~0x1
        HoldAirborneFrame(-91.0)
    }
    event(e, a) {
        if (invincible == 5) {
            rejevret(e == EventHit)
            rejevret(e == Event30)
            rejevret(e == Event63)
            rejevret(e == Event14)
            rejevret(e == Event20)
            rejevret(e == Event25)
            rejevret(e == Event24)
            rejevret(e == Event35)
            rejevret(e == Event44)
            rejevret(e == Event61)
        }
        if (e == Event51) {
            statusc &= ~0x1
            accevcstate(Willy_Hang_Idle)
        }
    }
}

state Willy_Falling_Transition { // 41
    stateflag 0x9
    statusc 0x0
    event => sub AirborneEvent
    code() {
        onstateexit(ResetMovement)
        statusb &= ~FLAG_DPAD_CONTROL
        do {
            field_60 = 0xFC700
            playanim(13, WILLY_JUMP_FLIP, 52)
        } while (1)
    }
    trans {
        changestateif(Willy_Land, !STATUS_FIRSTFRAME && STATUS_GROUNDLAND)
    }
}

state Willy_Land { // 42
    stateflag 0x5
    statusc 0x0
    code() {
        onstateexit(StopAndRestoreControl)
        statusb &= ~FLAG_DPAD_CONTROL
        playanim(2, WILLY_JUMP_LAND)
        playframes(3.0, 7.0)
        if (statusa & 0x2000000) {
            playframes(WILLY_ICE_5, 0.0, 11.0)
        }
        else {
            playframes(7.0, 19.0)
        }
        changestate(Willy_Idle)
    }
    trans {
        once {
            if (groundvel < -10m && y > GLOBAL_118) {
                spawn(9, 2, 1, -1.0, 5.0, groundvel + 8m)
            }
            if (collider, vely <= 0, statusa & 0x4000) {
                unless (statusa & 0x40000) {
                    sendevent(EventJumpedOn, collider, 100)
                    changestateif(Willy_Bounce, eventaccepted)
                }
            }
            ResetCombos()
            soundpitch((14.4 + rand(3.2)) * 0.23 >> 8)
            sounddecay(5.76s)
            soundplay(SOUND_LAND_DEFAULT, 0.3V)
            if (GLOBAL_119 & 0x800 && !(statusa & 0x2000000) && statusa & 0x40000) {
                spawn(9, 37, 1, 0.2m, roty, abs(scalex) / 3)
            }
            if (GLOBAL_119 & 0x800 && !(statusa & 0x2000000) && statusa & 0x40000) {
                spawn(9, 37, 1, -0.2m, roty, abs(scalex) / -3)
            }
        }
        if (mem23) {
            CheckJump(Willy_Jump_Start, 10.469m)
            CheckSpin()
            CheckSlide()
            changestateifn(Willy_Move, dirhold(PAD_NONE))
        }
        CheckFall(Willy_Falling, Willy_Rise, 0.32s)
        unless (statusa & 0x2000000) {
            ResetSpeed()
        }
    }
}

state Willy_Bounce { // 43
    stateflag 0x1000009
    statusc 0x400003
    code() {
        PlayJumpStart(14.20141m)
    }
    trans {
        once {
            changestateif(Willy_NGin_Bounce, LEVEL == LEVEL_BossNGin)
            sounddecay(5.76s)
            soundpitch((14.4 + (rand(3.2) + (1.6 * (BounceCombo - 1.0) >> 8))) * 0.23 >> 8)
            soundplay([bnk0A], 0.4V)
        }
        settrans(UpdateJumpStart)
        UpdateJumpStart()
    }
}

state Willy_Spin_Start { // 44
    stateflag 0x84
    statusc 0x0
    code() {
        SoundSpinDefault()
        SpinPulseTime = frametime
        if (frametime - SpinCooldownTime >= SpinCooldownLimit) {
            SpinCooldownTime = frametime - (SpinCooldownLimit - 0.68s)
        }
        else {
            SpinCooldownTime += 0.68s
        }
        changestate(Willy_Spin)
    }
}

state Willy_Spin_Air_Start { // 45
    stateflag 0x98
    statusc 0x2
    event => sub SpinEvent
    code() {
        SoundSpinDefault()
        SpinPulseTime = frametime
        if (frametime - SpinCooldownTime >= SpinCooldownLimit) {
            SpinCooldownTime = frametime - (SpinCooldownLimit - 0.68s)
        }
        else {
            SpinCooldownTime += 0.68s
        }
        changestate(Willy_Spin_Air)
    }
}

state Willy_Spin { // 46
    stateflag 0x90
    statusc 0x2
    event => sub SpinEvent
    trans => sub UpdateSpin
    code() {
        onstateexit(CleanupSpin)
        statusb |= FLAG_DPAD_CONTROL | 0x2000
        statusb &= ~FLAG_ROT_Y
        setanim(WILLY_SPIN, 9.0)
        do {
            playframe((animframe + 1.0) % 10.0)
        } until (frametime - SpinPulseTime >= SpinDuration)
        changestate(Willy_Spin_End)
    }
}

sub SpinEvent(e, a) {
    if (e == Event42) {
        rejev()
        sendevent(EventSpinHit, interrupter, 1)
    }
    if (e == Event40) {
        rejev()
        save (interrupter) {
            interrupter = a[0]
            sendevent(EventSpinHit, interrupter, 1)
        }
    }
}

sub UpdateSpin() {
    sendevent(EventSpinHit, collider, AttackCombo)
    if (eventaccepted) {
        SoundAttackCombo()
        AttackCombo += 1.0
    }
    if (buttonbuffer(PAD_X) && (!(statusa & 0x80) || statusa & 0x100000)) {
        hpc = 0
        changestate(Willy_Spin_Air)
    }
    if (STATUS_FIRSTFRAME) {
        if (scalex < 0) {
            mem16 = 1.0
        }
        else {
            mem16 = -1.0
        }
    }
    if (stateflag & 0x200000) {
        rotz = troty
        rotx = 30deg
        spawn(9, 1, 2, -1.0)
    }
    if (!time(3)) {
        spawn(9, 2, 1, -1.0, 1.0, 1m)
    }
}

state Willy_Spin_Air { // 47
    stateflag 0x98
    statusc 0x83
    event => sub SpinEvent
    code() {
        if (STATUS_GROUNDLAND) {
            vely = 10.469m
            playanim(0, WILLY_SPIN)
        }
        statusc &= ~0x81
        setanim(WILLY_SPIN, 9.0)
        do {
            playframe((animframe + 1.0) % 10.0)
        } until (frametime - SpinPulseTime >= SpinDuration)
        changestate(Willy_Spin_Air_End)
    }
    trans {
        once {
            onstateexit(CleanupSpin)
            statusb |= FLAG_DPAD_CONTROL | 0x2000
            statusb &= ~FLAG_ROT_Y
            AirSpinCount += 1.0
        }
        sendevent(EventSpinHit, collider, AttackCombo)
        if (eventaccepted) {
            SoundAttackCombo()
            AttackCombo += 1.0
        }
        changestateif(Willy_Spin, frametime - statetime >= 0.08s && STATUS_GROUNDLAND)
        if (STATUS_FIRSTFRAME) {
            if (scalex < 0S) {
                mem16 = 60deg
            }
            else {
                mem16 = -60deg
            }
        }
        if ((buttonhold(PAD_X) && (!(statusa & 0x80) || statusa & 0x100000)) && vely > 0) {
            vely = spd(vely, 14m)
        }
    }
}

state Willy_Spin_End { // 48
    stateflag 0x1
    statusc 0x0
    code() {
        changestate(Willy_Idle)
    }
    trans {
        once {
            AttackCombo = 0
        }
        CheckJump(Willy_Jump_Start, 10.469m)
    }
}

state Willy_Spin_Air_End { // 49
    stateflag 0x9
    statusc 0x0
    code() {
        changestate(Willy_Falling)
    }
    trans {
        once {
            AttackCombo = 0
            onstateexit(CleanupSpin)
        }
    }
}

sub TriggerBonus() {
    changestateifn(Willy_Death_Fall, BONUSSTATE)
    unless (BONUSSTATE == BONUS_CURRENT || BONUSSTATE == BONUS_COMPLETED) {
        ins72(0x200, 0x2000)
        savecheckpoint((1 << 16) | (1 << 8))
        BONUSSTATE = BONUS_CURRENT
        BonusFruitCount = 0
        BonusLifeCount = 0
        BonusBoxCount = 0
        spawn2(DispC, DispC_S_BONUS_WUMPA_DISPLAY)
        BONUSFRUITCOUNTER = objectspawned
        spawn2(DispC, DispC_S_BONUS_LIFE_DISPLAY)
        BONUSLIFECOUNTER = objectspawned
        spawn2(DispC, DispC_S_BONUS_BOX_DISPLAY)
        BONUSBOXCOUNTER = objectspawned
    }
}

sub SetBonusState(status) {
    if (LEVEL == LEVEL_NightFight || LEVEL == LEVEL_TotallyFly) {
        GLOBAL_126 = 0
    }
    if (var temp = status; temp == BONUS_COMPLETED) {
        save (BOXCOUNT) {
            BOXCOUNT = BonusBoxCount
            savecheckpoint((2 << 16) | (0 << 8))
        }
        broadcastevent(Event73, 0, status)
    }
    else if (temp == BONUS_KILLED) {
        BONUSDEATHTIME = frametime
        broadcastevent(Event73, 0, status)
    }
    BONUSSTATE = status
}

sub AddFruit(count) {
    if (GLOBAL_119 & 0x2000, interrupter, interrupter -> y < 0) {
        BonusFruitCount += count
    }
    else {
        FruitCount += count
        if (FruitCount >= 100.0) {
            interrupter = FRUITDISPLAY
            sendevent(Event17, interrupter, 1.0)
            FruitCount -= 100.0
        }
    }
}

sub AddLife(count) {
    if (GLOBAL_119 & 0x2000, interrupter, interrupter -> y < 0) {
        BonusLifeCount += count
    }
    else {
        LifeCount += count
        if (LifeCount > 99.0) {
            LifeCount = 99.0
        }
    }
}

sub AddBox() {
    if (BONUSSTATE == BONUS_CURRENT) {
        BonusBoxCount += 1.0
    }
    else {
        BoxCount += 1.0
        BOXCOUNT = BoxCount
    }
}

sub AddDoctor() {
    sendevent(Event15, creator, 4.0)
    if (var0 >= 3.0) {
        invincible = 5
        invincibletime = frametime
        changestate(Willy_Get_Invincible, 0)
    }
}

sub WillyPlayInvincible(arg) {
    onstateexit(ResetMovement)
    var0 = 10.0
    statusb &= ~(FLAG_DPAD_CONTROL | FLAG_ROT_Y)
    statusb |= FLAG_GRAVITY | FLAG_PHYSICS_ENGINE
    SoundJumpDefault()
    ResetSpeed()
    vely = 14m
    setanim(WILLY_WITCH_DOCTOR, -1.0)
    do {
        animframe += 1.0
        if (var0) {
            do (var sparkles = 0) {
                spawn(DoctC, DoctC_S_DOCTOR_PARTICLE)
                sparkles += 1.0
            } while (sparkles < var0 >> 1)
            var0 -= 1.0
        }
        playframe()
    } while (animframe + 1.0 <= 18.0)
}

state Willy_Get_Invincible { // 50
    stateflag 0x8
    statusc 0x1022
    code() {
        if (eventreceived == Event39) {
            field_61 = 1.0
        }
        else {
            field_61 = 0.0
        }
        WillyPlayInvincible(0.7s)
        if (field_61) {
            sleep()
        }
        vely = 0
        statusb |= FLAG_GRAVITY | FLAG_PHYSICS_ENGINE
        changestate(Willy_Falling_Transition)
    }
    event(e, a) {
        rejevret(e == Event6 || e == Event40)
    }
}

inline sub SetItemPool(id, pool1, pool2) {
    if (var index = id; index < 32) {
        pool1 = (1 << index) | pool1
    }
    else {
        pool2 = (1 << (index - 32)) | pool2
    }
}

sub WillyReward(reward) {
    if (var combo = reward; combo == 1.0) {
        spawn2(FruiC, FruiC_S_FRUIT_AUTO, 1, 76.0, 0)
        child -> x = interrupter -> x
        child -> y = interrupter -> y
        child -> z = interrupter -> z
    }
    else if (combo == 2.0) {
        spawn2(FruiC, FruiC_S_FRUIT_AUTO, 1, 94.0, 0)
        child -> x = interrupter -> x
        child -> y = interrupter -> y
        child -> z = interrupter -> z
    }
    else if (combo == 3.0) {
        spawn2(FruiC, FruiC_S_FRUIT_AUTO, 1, 92.0, 0)
        child -> x = interrupter -> x
        child -> y = interrupter -> y
        child -> z = interrupter -> z
    }
    else if (combo == 4.0) {
        spawn2(FruiC, FruiC_S_FRUIT_AUTO, 1, 97.0, 0)
        child -> x = interrupter -> x
        child -> y = interrupter -> y
        child -> z = interrupter -> z
    }
    if (reward >= 300.0) {
        if (reward - 300.0 < 10.0 || reward - 300.0 >= 57.0) {
            CollectedSpecialGem = reward - 300.0
        }
        else {
            CollectedLevelGem = reward - 300.0
        }
        SetItemPool((reward - 300.0) >> 8, GEMPOOL1, GEMPOOL2)
    }
    else if (reward >= 200.0) {
        CrystalCount += 1.0
        SetItemPool((reward - 200.0) >> 8, CRYSTALPOOL1, CRYSTALPOOL2)
    }
}

sub WillyStatus(request) {
    if (interrupter) {
        if (var req = request; req == 0) {
            interrupter -> var0 = mem3
        }
        else if (req == 1.0) {
            interrupter -> var0 = 0
        }
        else if (req == 3.0) {
            if (BounceCombo > 0) {
                BounceCombo -= 1.0
            }
        }
        else if (req == 8.0) {
            BounceCombo = 0
        }
        else if (req == 5.0) {
            SetLevelResult(1.0)
        }
        else if (req == 9.0) {
            interrupter -> var0 = mem12
        }
        else if (req == 6.0) {
            SetLevelResult(4.0)
            MarkLevelExit(LEVEL)
        }
        else if (req == 4.0) {
            sendevent(Event15, creator, 4.0)
            interrupter -> var0 = var0
        }
    }
}

sub TryBeginDeath(hit) {
    onstateexit(RestoreAfterHit)
    if (eventreceived != Event38) {
        sendevent(EventHit, creator, hit)
        changestateif(Willy_Hit, eventaccepted)
    }
    health -= hit
    statusb &= ~(0x2000 | FLAG_PHYSICS_ENGINE | FLAG_GRAVITY | FLAG_DPAD_CONTROL | FLAG_PHYSICS_TEST | FLAG_ROT_Y)
    ResetSpeed()
    GAMEFLAGS &= ~0x2
    sendevent(Event28, interrupter, 0)
}

sub BeginDeath(arg) {
    onstateexit(RestoreAfterHit)
    health -= arg
    statusb &= ~(FLAG_PHYSICS_ENGINE | FLAG_GRAVITY | FLAG_DPAD_CONTROL | FLAG_PHYSICS_TEST | FLAG_ROT_Y)
    ResetSpeed()
    GAMEFLAGS &= ~0x2
    sendevent(Event28, interrupter, 0)
}

sub PrepareRespawn() {
    if (LEVEL == LEVEL_WarpRoom) {
        misc = false
    }
    else if (GLOBAL_119 & 0x2000 && BONUSSTATE != BONUS_COMPLETED) {
        health = 100.0
        misc = true
    }
    else {
        if (getfield(self, offsetof(LifeCount))) {
            LifeCount -= 1.0
        }
        else {
            GAMEFLAGS = 0x20
            SetLevelResult(2.0)
        }
        misc = false
    }
    if (DEBUG && buttonhold(PAD_R1)) {
        FADECONTROL = 0
        changestate(Willy_Hit)
    }
}

state Willy_Death_Fall { // 51
    stateflag 0x4009
    statusc 0x7002
    code(a) {
        save (vfx) {
            KillBonus()
            vfx &= 0xFFFF00FF
            mem25 = x
            mem26 = y
            mem27 = z
            onstateexit(RestoreAfterHit)
            stateflag |= 0x20
            if (a) {
                GAMEFLAGS &= ~0x2
            }
            statusb &= ~(FLAG_PHYSICS_TEST | FLAG_DPAD_CONTROL | FLAG_HAS_SHADOW)
            sounddecay(7.68s)
            SoundPitchDefault(0.18)
            soundplay([fal0A], 0.4V)
            soundsetup(0, voice, 5)
            playframes(WILLY_JUMP_UP, 0.0, 11.0)
            statusb &= ~(FLAG_GRAVITY | FLAG_PHYSICS_ENGINE)
            unless (ZONEFLAGS & 0x400000 || LEVEL == LEVEL_WarpRoom || rand(4)) {
                soundpitch(3.625)
                soundsetup(0, self, 9)
                sounddecay(10.2s)
                soundplay(SOUND_LAND_DEFAULT, 1V)
                if (!SHAKEY) { SHAKEY = 3.0 }
                spawn(WillC, S_SHOES, 1, mem25, mem26, mem27)
                playnull(31)
            }
            while ((GLOBAL_119 & 0x2000 && BONUSSTATE != BONUS_COMPLETED) && (BONUSSTATE == BONUS_KILLED && !(frametime - BONUSDEATHTIME >= 1.2s))) {
                playnull()
            }
            FadeToBlack()
            WaitFadeNull()
        }
        CrashDoRespawn()
    }
}

state Shoes { // 52
    stateflag 0x0
    statusc 0xF002
    code(px, py, pz) {
        SetTrans(px, py, pz)
        playframes(WILLY_DEATH_FALL, 0.0, 44.0)
    }
}

state Willy_Death { // 53
    stateflag 0x22
    statusc 0x7022
    code(hit) {
        if (eventreceived == EventDidgeridoo) {
            settrans(SpawnDeathSmoke)
        }
        TryBeginDeath(hit)
        KillBonus()
        SoundDeathArg()
        roty = CAMROTY
        playframes(WILLY_DEATH_ANGEL, 0.0, 7.0)
        tpc = 0
        SetVel(0m, 1m, 0m)
        statusb |= FLAG_PHYSICS_ENGINE
        do (var i = 0) {
            sounddelay(4)
            SoundPitchDefault(0.23)
            sounddecay(7.68s)
            soundplay([AFl0A], 0.5V)
            playframes(WILLY_DEATH_ANGEL, 7.0, 33.0)
        } while ({ i += 1.0 }; i < 3.0)
        FadeToBlack()
        playframes(7.0, 14.0)
        WaitFadeFrame()
        CrashDoRespawn()
    }
}

state Willy_Death_Didgeridoo { // 54
    stateflag 0x1020
    statusc 0x7022
    trans => sub SpawnDeathSmoke
    code(hit) {
        unless (isloaded([Cda0V]) && isloaded([Cda0G])) {
            statusc &= ~0x7022
            changestate(Willy_Death, hit)
        }
        TryBeginDeath(hit)
        KillBonus()
        SetVel(0m)
        SetColor1(0, 0, 0)
        moda = 12.8
        SoundDeathArg()
        if (abs(degdist(roty, GAMEDIR + 180deg)) < 90deg) {
            roty += 180deg
        }
        playanim(0, WILLY_DEATH_DIDGERIDOO, 8)
        tpc = 0
        playanim(0, WILLY_DEATH_DIDGERIDOO, 2)
        vely = 0.8m
        settrans(ResetBrightness)
        statusb |= FLAG_PHYSICS_ENGINE
        soundpitch(1.45)
        sounddecay(10.2s)
        soundplay([Dig0A], 0.5V)
        soundpitch(1.45)
        sounddelay(2.7s)
        sounddecay(10.2s)
        soundplay([Dig0A], 0.5V)
        playframes(1.0, 13.0)
        tpc = 0
        playframes(14.0, 69.0)
        FadeToBlack()
        playframes(70.0, 76.0)
        WaitFadeFrame()
        CrashDoRespawn()
    }
}

sub SpawnDeathSmoke() {
    spawn(9, 21, 1, -1.0, randi(-4m, 4m), 8m, randi(-4m, 4m), 2S, 0.8, 24, 1)
}

sub ResetBrightness() {
    moda = seek(moda, 0, 0x147)
}

state Willy_Shock { // 55
    stateflag 0x1020
    statusc 0x0
    code(hit) {
        changestate(Willy_Shocked, hit)
    }
}

state Willy_Shocked { // 56
    stateflag 0x22
    statusc 0x3022
    code(hit) {
        if (LEVEL == LEVEL_Unbearable && statusb & 0x800) {
            spawn2(48, 7, 1, mem38)
        }
        BeginDeath(hit)
        var0 = false
        sendevent(EventHit, creator, hit)
        if (eventaccepted) {
            var0 = true
        }
        statusb &= ~(FLAG_HAS_SHADOW | 0x2000 | FLAG_GRAVITY | FLAG_PHYSICS_ENGINE | FLAG_GRAVITY | FLAG_ROT_Y | FLAG_PHYSICS_TEST | FLAG_DPAD_CONTROL)
        spawn(9, 25, 1, 0.0, 1.0)
        spawn(9, 25, 1, 2.0, 3.0)
        spawn(9, 25, 1, 4.0, 5.0)
        spawn(9, 25, 1, 6.0, 7.0)
        spawn(9, 25, 1, 8.0, 9.0) 
        do (var start = frametime) { 
            PlayShock() 
        } while (frametime - start < 0.68s)
        if (var0) {
            tpc = 0
            statusb |= FLAG_HAS_SHADOW | FLAG_GRAVITY | FLAG_PHYSICS_TEST | FLAG_PHYSICS_ENGINE
            do (var start = frametime) {
                PlayShock()
            } while (frametime - start < 1.28s)
            CheckInvincible()
            changestate(Willy_Hit)
        }
        KillBonus()
        do (var start = frametime) {
            PlayShock()
        } while (frametime - start < 1s)
        FadeToBlack() 
        do { 
            PlayShock()
        } until (FADECONTROL == -1)
        CrashDoRespawn()
    }
    trans {
        if (var r = rand(3); r == 0) {
            moda = 0
        }
        else if (r == 1) {
            moda = 16.0
            SetColor1(0x00, 0x00, 0x00)
        }
        else if (r == 2) {
            moda = 8.0
            SetColor1(0x80, 0x80, 0x80)
        }
    }
}

sub PlayShock() {
    playanim(0, WILLY_DEATH_SHOCK_2)
    playanim(0, WILLY_DEATH_SHOCK_1, 2)
    if (!rand(2)) {
        playanim(0, WILLY_DEATH_SHOCK_1)
        if (!rand(2)) {
            playanim(0, WILLY_DEATH_SHOCK_1)
        }
    }
}

