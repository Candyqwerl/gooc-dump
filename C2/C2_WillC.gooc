state Willy_Death_Boulder { // 63
    stateflag 0x1033
    statusc 0x3002
    code(obj) {
        if (LEVEL == LEVEL_DigginIt || LEVEL == LEVEL_BeeHaving) {
            statusc &= ~0x1002
            changestate(Willy_Death_Tombstone)
        }
        if (eventreceived == Event37) {
            BeginDeath(obj)
        }
        else {
            TryBeginDeath(obj)
        }
        KillBonus()
        player = obj
        GAMEFLAGS |= 0x2
        zindex = 10
        misc = ((roty + (180deg + -CAMROTY) + 22.5deg) & ~0x1FF) & 0xFFF
        if (misc > 90deg && misc <= 180deg) {
            misc = 180deg - misc
        }
        else if (misc > 180deg && misc < 270deg) {
            misc = 540deg - misc
        }
        if (misc <= 180deg) {
            misc >>= 1
        }
        else {
            misc = 360deg - ((360deg - misc) >> 1)
        }
        roty = misc
        statusb &= ~(FLAG_HAS_SHADOW | 0x2000 | FLAG_DPAD_CONTROL | FLAG_ROT_Y)
        ResetSpeed()
        SoundDeathArg()
        sounddecay(7.68s)
        SoundPitchDefault(0.23)
        soundplay([de20A], 0.7V)
        playanim(0, WILLY_DEATH_BOULDER_1)
        playanim(1, WILLY_DEATH_BOULDER_1)
        playanim(2, WILLY_DEATH_BOULDER_1)
        playanim(2, WILLY_DEATH_BOULDER_1)
        zindex = 60
        {
            var roll = 90deg
            var dx = x
            var dy = y
            var dz = z
            var start = frametime
            var elapsed, gap, previous, sent, pitch, next
            x = player -> x
            y = player -> y
            z = player -> z
            rotx = player -> rotx
            dx -= x
            dy -= y
            dz -= z
            pitch = rotx
            GAMEFLAGS |= 0x20000
            do {
                x = player -> x
                y = player -> y
                z = player -> z
                rotx = player -> rotx
                roty = player -> roty
                rotz = player -> rotz
                next = rotx
                GLOBAL_128 = x + dx
                GLOBAL_129 = y + dy
                GLOBAL_130 = z + dz
                elapsed = frametime - start
                if (elapsed < 0) {
                    elapsed = 0
                }
                if (elapsed > 2.4s) {
                    elapsed = 2.4s
                }
                gap = CAMTRANSZ - GLOBAL_130 - 2m
                GLOBAL_130 -= elapsed * gap / 2.4s
                if (!!previous) {
                    GLOBAL_130 += (previous - GLOBAL_130) >> 1
                }
                previous = GLOBAL_130
                roll += degdist(pitch, next)
                rotx = roll & 0xFFF
                playanim(0, WILLY_DEATH_BOULDER_2)
                if (roll >= 1070deg || player -> stateflag & 0x20) {
                    if (sent) {
                        break
                    }
                    else {
                        sent = 1
                        sendevent(EventTriggered, player)
                    }
                }
                pitch = next
            } while (1)
            GAMEFLAGS &= ~0x20000
        }
        GAMEFLAGS &= ~0x2
        playframe(animframe, 31)
        FadeToBlack()
        WaitFadeFrame()
        CrashDoRespawn()
    }
}

state Willy_Smash { // 64
    stateflag 0x1031
    statusc 0x3022
    code(hit) {
        onstateexit(RestoreAfterHit)
        statusb &= ~(FLAG_DPAD_CONTROL | FLAG_ROT_Y)
        ResetSpeed()
        SoundDeathArg()
        scaley = 0.75S
        playframe()
        scaley = 0.5S
        playframe()
        scaley = 0.25S
        playframe()
        scaley = 0.1S
        playframe()
        while (interrupter, interrupter -> stateflag & 0x80, !(frametime - statetime >= 2s)) {
            playframe()
        }
        mem37 = false
        sendevent(EventHit, creator, hit)
        if (eventaccepted) {
            mem37 = true
        }
        if (mem37) {
            roty += degdist(roty, GAMEDIR) >> 1
        }
        else {
            roty = GAMEDIR
        }
        zindex = 50
        scaley = 0.25S
        playanim(2, WILLY_SMASH_RECOVER)
        scaley = 0.5S
        playanim(2, WILLY_SMASH_RECOVER)
        scaley = 0.75S
        playanim(3, WILLY_SMASH_RECOVER)
        scaley = 1S
        if (mem37) {
            do (var start = frametime) {
                playanim(2, WILLY_SMASH_RECOVER)
                if (!rand(10)) {
                    playanim(1, WILLY_SMASH_RECOVER, 1)
                    playanim(0, WILLY_SMASH_RECOVER, 2)
                    playanim(1, WILLY_SMASH_RECOVER, 1)
                }
            } while (frametime - start < 2s)
            scaley = 1S
            playframes(WILLY_DEATH_SMASH, 0.0, 15.0)
            zindex = 24
            changestate(Willy_Idle)
        }
        KillBonus()
        playframes(4.0, 95.0)
        FadeToBlack()
        playframes(95.0, 101.0)
        WaitFadeFrame()
        scaley = 1S
        zindex = 24
        CrashDoRespawn()
    }
}

sub PlayWarpOut(keep) {
    if (getpayload(&[Cr10G], &[Cwa0V], &[WWP3G], &[WWP3V]) <= getfreepages()) {
        spawn2(WillC, S_WARP_CONTROLLER, 1, 2.0)
    }
    if (objectspawned) {
        LoadAnim([WWP3V], [WWP3G])
        LoadAnim([Cwa0V], [Cr10G])
        var0 = 0
        groundy = y
        settrans(SpawnWarpoutParticles)
        playframe()
        save (vfx, statusb) {
            vecy = -1
            vfx = (vfx & 0xFFFF00FF) | 0x1300
            setanim(WILLY_WARP, 49.0)
            statetime = frametime
            statusb |= 0x80000000
            GLOBAL_128 = x
            GLOBAL_130 = z
            GAMEFLAGS |= 0x20000
            while (var0 << 8 <= 49.0 && !(frametime - statetime >= 1.5s)) {
                save (x, y, z) {
                    getvert(vtrans, self, 1.0)
                    vecx = y
                    GLOBAL_129 = y
                }
                playframe(49.0 - (var0 << 8))
            }
            tpc = 0
        }
        DeloadAnim([WWP3V], [WWP3G])
        DeloadAnim([Cwa0V], [Cr10G])
    }
    playnull(8)
    GAMEFLAGS |= GFLAG_WHITE_FADE
    FadeToBlack()
    if (!keep) {
        soundstop()
    }
    WaitFadeNull()
    cascadeevent(Event12, self)
}


state Willy_Level_Complete { // 65
    stateflag 0x20
    statusc 0x1022
    code(dest) {
        onstateexit(CleanupLevelExit) 
        if (var level = LEVEL; level == LEVEL_BossTazTiger || level == LEVEL_BossRipperRoo || level == LEVEL_BossCortex || level == LEVEL_BossNGin || level == LEVEL_BossKimodo) {
            eventreceived = 0
            WillyPlayInvincible(0x43)
            GAMEFLAGS &= ~0x10000
            if (getpayload(&[Cr10G], &[CD20V], &[Cr10G], &[CD10V]) <= getfreepages()) {
                loadfile([CD10V])
                loadfile([Cr10G])
                ExtraAnimGroup = 15.0
                do { PlayMoveFrame() } until ((isloaded([Cr10G]) && isloaded([CD10V])) && STATUS_GROUNDLAND) 
                statusb = FLAG_HAS_SHADOW
                WillyPlayDance()
            }
            statusb = FLAG_HAS_SHADOW
            PlayMoveFrame()
            PlayWarpOut(0)
        }
        else {
            statusb = FLAG_HAS_SHADOW
            PlayWarpOut(dest == LEVEL_BeeHaving || dest == LEVEL_AirCrash)
        }
        if (var level = dest; level == LEVEL_BeeHaving || level == LEVEL_AirCrash) {
            ins72(0, 0x1000)
            GAMEFLAGS |= GFLAG_WHITE_FADE
            FADECONTROL = 1.0
            playnull()
            changestate(Willy_Idle)
        }
        else if (level == 43.0 || level == 47.0 || level == 44.0 || level == 45.0 || level == 46.0) {
            if (level == 43.0) {
                GLOBAL_150 |= 0x10
            }
            else if (level == 47.0) {
                GLOBAL_150 |= 0x4
            }
            else if (level == 44.0) {
                GLOBAL_150 |= 0x8
            }
            else if (level == 45.0) {
                GLOBAL_150 |= 0x1
            }
            else if (level == 46.0) {
                GLOBAL_150 |= 0x2
            }
            SetLevelResult(3.0)
            CURRENTLEVEL = dest
            MarkLevelExit(LEVEL)
            loadlevel(LEVEL_WarpRoom)
        }
        else {
            SetLevelResult(3.0)
            MarkLevelExit(LEVEL)
            loadlevel(LEVEL_WarpRoom)
        }
        sleep()
    }
}

#module [Wil2C]
