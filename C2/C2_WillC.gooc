        troty = yaw
        trotx = abs(degdist(roty, troty)) * 3
        statusb |= FLAG_ROT_Y
        speed = velocity
        statusb &= ~FLAG_DPAD_CONTROL
        setvel()
        playanim(0, WILLY_PUSHED)
        playanim(1, WILLY_PUSHED)
        playanim(2, WILLY_PUSHED)
        playanim(3, WILLY_PUSHED)
        playanim(4, WILLY_PUSHED)
        playanim(4, WILLY_PUSHED)
        playanim(5, WILLY_PUSHED)
        playanim(6, WILLY_PUSHED)
        sleep()
    }
    event(e, a) {
        accevcstate(Willy_Land, e == Event21)
    }
}

state Willy_Hold { // 32
    stateflag 0x2005
    statusc 0x2000
    code() {
        onstateexit(ResetMovement)
        speed = 0
        SetVel(0m)
        statusb &= ~FLAG_DPAD_CONTROL
        sleepframes(WILLY_STAND_1, 0.0, 19.0)
    }
    event(e, a) {
        accevcstate(Willy_Idle, e == Event21)
    }
}

#module [WiloC]
#purge lonr
state Willy_Mine_Launch { // 33
    stateflag 0x203408
    statusc 0x40
    event => sub AirborneEvent
    __transargs
    code(vy, v) {
        playframes(WILLY_MINE, 0.0, 17.0)
        sleepanim(18, WILLY_MINE)
    }
    trans {
        once {
            onstateexit(StopAndRestoreControl)
            statusa &= ~FLAG_GROUNDLAND
            vely = vy
            roty = troty
            velx = (velx * v) >> 8
            velz = (velz * v) >> 8
        }
        if (collider && vely <= 0) {
            sendevent(EventSlamHit, collider, 100)
            if (eventaccepted) {
                SoundSlamBounce(7.17)
                collider -> statusb &= ~FLAG_COLLIDABLE
                return
            }
        }
        if (STATUS_GROUNDLAND || (vely < 0 && spd(y, vely) <= field_63)) {
            hpc = 0
            changestate(Willy_Mine_Land, 2)
        }
        if (vely > 0 && !time(2)) {
            spawn(9, 21, 1, 0, 0, -4m, 0, 2S, 0x266, 24, 1)
        }
    }
}

state Willy_Mine_Land { // 34
