        x = seek(x, GLOBAL_121, spd(5m))
        y = seek(y, GLOBAL_122, spd(5m))
        z = seek(z, GLOBAL_123, spd(5m))
    }
}

#module [WiliC]
#purge iq7
expr SpaceJetPackOBJ = 101.0
expr SpaceLockOBJ = 100.0

inline sub SoundJetpackThrust() {
    SoundPitchDefault()
    sounddecay(10.2s)
    soundplay([JstTA], 0.4V)
}

state Willy_Jetpack_Mount { // 77
    stateflag 0x44000001
    statusc 0x22
    code() {
        scalex = abs(scalex)
        mem38 = -1.0
        mem37 = 1.0
        var0 = 1.0
        if (LEVEL == LEVEL_BossCortex) {
            pathprog = 0.0
            mem31 = 0
            mem32 = 0
            mem33 = getins(MoveJetpackCortexIntro)
            mem35 = 180deg
            troty = 180deg
            mem34 = 0
            statusb |= FLAG_TRACK_PATH_SIGN | 0x800
        }
        else {
            mem33 = getins(MoveJetpack)
        }
        SetVel(0)
        mem28 = 0
        mem29 = 0
        mem30 = 0
        statusb &= ~(FLAG_GRAVITY | 0x2000)
        statusb |= 0x1000
        trotx = 360deg
        trotz = 8m
        ResetSpeed()
        JetpackFacing = GAMEDIR + 180deg
        unless (CHECKPOINTCOUNT || LEVEL == LEVEL_BossCortex) {
            interrupter = objectget(SpaceJetPackOBJ)
            vecx = interrupter -> x
            vecy = interrupter -> y
            vecz = interrupter -> z
            vecz += 1m
            if (!RESPAWNCOUNT) {
                playframes(WILLY_ROCKET_MOUNT_1, 0, 90.0)
                troty = 180deg
                {
                    var sx = x
                    var sy = y
                    var sz = z
                    var tx = vecx
                    var ty = vecy
                    var tz = vecz
                    setanim(WILLY_ROCKET_MOUNT_2)
                    do (var i = 1.0) {
                        x = sx + (tx - sx) * (i >> 8) / 11
                        z = sz + (tz - sz) * (i >> 8) / 11
                        playframe((i - 1.0) * 11 / 11)
                    } while ({ i += 1.0 }; i <= 11.0)
                }
            }
            else {
                playframes(WILLY_ROCKET_MOUNT_FAST, 0, 9.0)
                troty = 180deg
                {
                    var sx = x
                    var sy = y
                    var sz = z
                    var tx = vecx
                    var ty = vecy
                    var tz = vecz
                    setanim(WILLY_ROCKET_MOUNT_FAST)
                    do (var i = 1.0) {
                        x = sx + (tx - sx) * (i >> 8) / 9
                        z = sz + (tz - sz) * (i >> 8) / 9
                        playframe((i - 1.0) * 9 / 9 + 10.0)
                    } while ({ i += 1.0 }; i <= 9.0)
                }
            }
            playanim(8, WILLY_ROCKET_MOUNT_2)
            playframes(9.0, 25.0)
            interrupter = objectget(SpaceJetPackOBJ)
            sendevent(EventTriggered, interrupter)
            playframes(26.0, 53.0)
            interrupter = objectget(SpaceLockOBJ)
            sendevent(EventTriggered, interrupter)
            SoundJetpackThrust()
            mem41 = voice
            voice = mem41
            soundfadet(1s, voice)
            soundfadev(0, voice, 3)
            mem41 = 0
            spawn(35, 5, 1, 8, 0, 0x5000, 0)
            playframes(WILLY_ROCKET_MOUNTED, 0, 53.0)
        }
        setanim(WILLY_ROCKET)
        GAMEFLAGS |= 0x10000
        mem25 = x
        mem26 = y
        mem27 = z
        changestate(Willy_Jetpack_Idle)
    }
}

sub ApplyJetpackThrust(ax, ay, az) {
    if (LEVEL != LEVEL_BossCortex) {
        ins46(ax, ax)
    }
    spawn(9, 19, 1, 0.0, ax * -10, ay * -10, az * -10)
    spawn(9, 19, 1, 1.0, ax * -10, ay * -10, az * -10)
    mem28 += ax
    mem29 += ay
    mem30 += az
    mem38 = -1.0
    var0 = 1.0
    if (!mem41) {
        SoundJetpackThrust()
        mem41 = voice
    }
    else {
        voice = mem41
        soundfadet(0.1s, voice, 0)
        soundfadev(0.35V + rand(0.1V), voice, 2)
        soundpitch(2.88 + rand(0.64))
    }
}

state Willy_Jetpack_Idle { // 78
    stateflag 0x44000001
    statusc 0x0
    code() {
        PlayJetpackIdleTransition()
        playanim(33, WILLY_ROCKET)
        do {
            animframe = (animframe + 1.0) % 50.0
            playframe()
        } while (1)
    }
    event(e, a) {
        if (e == Event30 
            || e == Event63
            || e == Event31
            || e == Event7 
            || e == Event35 
            || e == Event44 
            || e == Event3 
            || e == Event24) {
                rejevret(invincible == 4)
                sendevent(EventHit, creator, a[0])
                if (eventaccepted) {
                    mem28 = -mem28
                    mem30 = -mem30
                    mem29 = 0
                    CheckInvincible()
                    accevret()
                }
            }
        accevcstate(Willy_Jetpack_Dismount, e == Event58)
        accevcstate(Willy_Jetpack_Death_Explode, e == Event30 || e == Event63)
        accevcstate(Willy_Jetpack_Death_Fire, e == Event31 || e == Event7 || e == Event9)
        accevcstate(Willy_Jetpack_Shock, e == Event44)
        accevcstate(Willy_Jetpack_Shocked, e == Event35)
        accevcstate(Willy_Jetpack_Death, e == EventHit || e == Event24 || e == Event38)
        accevcstate(Willy_Jetpack_Recover, e == Event18)
    }
    trans {
        if (buttonhold(PAD_X | PAD_R1)) {
            changestate(Willy_Jetpack_Forward)
        }
        else {
            changestateif(Willy_Jetpack_Backward, buttonhold(PAD_CIRCLE | PAD_L1))
        }
        if (animseq == getanim(WILLY_ROCKET)) {
            if ((mem39 > 0 && dirhold(PAD_DOWN)) || (mem39 < 0 && dirhold(PAD_UP))) {
                changestate(Willy_Jetpack_Up)
            }
            else if ((mem39 > 0 && dirhold(PAD_UP)) || (mem39 < 0 && dirhold(PAD_DOWN))) {
                changestate(Willy_Jetpack_Down)
            }
            else if (dirhold(PAD_RIGHT)) {
                if (abs(degdist(troty, GAMEDIR + 180deg)) < 90deg) {
                    changestate(Willy_Jetpack_Right)
                }
                else {
                    changestate(Willy_Jetpack_Right_Reversed)
                }
            }
            else if (dirhold(PAD_LEFT)) {
                if (abs(degdist(troty, GAMEDIR + 180deg)) < 90deg) {
                    changestate(Willy_Jetpack_Left)
                }
                else {
                    changestate(Willy_Jetpack_Left_Reversed)
                }
            }
        }
        if (animseq == getanim(WILLY_ROCKET_RIGHT_STOP_1) || animseq == getanim(WILLY_ROCKET_LEFT_STOP_1)) {
            if ((mem39 > 0 && dirhold(PAD_DOWN)) || (mem39 < 0 && dirhold(PAD_UP))) {
                changestate(Willy_Jetpack_Up)
            }
            else {
                changestateif(Willy_Jetpack_Down, (mem39 > 0 && dirhold(PAD_UP)) || (mem39 < 0 && dirhold(PAD_DOWN)))
            }
        }
        if (animseq == getanim(WILLY_ROCKET_UP_START_1) || animseq == getanim(WILLY_ROCKET_DOWN_START_1)) {
            if (dirhold(PAD_RIGHT)) {
                if (abs(degdist(troty, GAMEDIR + 180deg)) < 90deg) {
                    changestate(Willy_Jetpack_Right)
                }
                else {
                    changestate(Willy_Jetpack_Right_Reversed)
                }
            }
            else if (dirhold(PAD_LEFT)) {
                if (abs(degdist(troty, GAMEDIR + 180deg)) < 90deg) {
                    changestate(Willy_Jetpack_Left)
                }
                else {
                    changestate(Willy_Jetpack_Left_Reversed)
                }
            }
        }
        if (dirhold(PAD_NONE) && !buttonhold(PAD_CIRCLE | PAD_L1) && !buttonhold(PAD_X | PAD_R1)) {
            mem37 = 1.0
        }
        UpdateJetpack()
    }
}

sub UpdateJetpack() {
    if (!(GLOBAL_32 & 0x1)) {
        mem39 = 8
    }
    else {
        mem39 = -8
    }
    unless (dirhold(PAD_NONE)) {
        if (buttonhold(PAD_X | PAD_R1)) {
            ApplyJetpackThrust(sin(ANALOGDIR) << 3, cos(ANALOGDIR) * mem39, -0.6m)
        }
        else if (buttonhold(PAD_CIRCLE | PAD_L1)) {
            ApplyJetpackThrust(sin(ANALOGDIR) << 3, cos(ANALOGDIR) * mem39, 0.6m)
        }
        else {
            ApplyJetpackThrust(sin(ANALOGDIR) << 3, cos(ANALOGDIR) * mem39, 0)
        }
        if (dirhold(PAD_LEFT) || dirhold(PAD_RIGHT)) {
            troty = degseek(JetpackFacing, ANALOGDIR + GAMEDIR, 1350deg)
        }
    }
    else if (dirhold(PAD_NONE) && !buttonhold(PAD_X | PAD_R1) && !buttonhold(PAD_CIRCLE | PAD_L1)) {
        if (mem41) {
            voice = mem41
            soundfadet(0.5s, voice)
            soundfadev(0, voice, 3)
            mem41 = 0
        }
        if (time(1s) < 0.2s) {
            if (!time(1s)) {
                soundpitch((15.36 + rand(1.28)) * 0.23 >> 8)
                sounddelay(rand(3) + 1)
                sounddecay(2.56s)
                soundplay([JPfTA], 0.07V + rand(0.03V))
            }
            spawn(9, 21, 1, time(2) << 8, 0, -1m, 0, 0.4S, 0, 24, 0)
        }
    }
    if (buttonbuffer(PAD_SQUARE)) {
        if (frametime - SpinCooldownTime >= 0.7s) {
            SoundSpinDefault()
            SpinPulseTime = frametime
            if (frametime - SpinCooldownTime >= SpinCooldownLimit) {
                SpinCooldownTime = frametime - (SpinCooldownLimit - 0.68s)
            }
            else {
                SpinCooldownTime += 0.68s
            }
            changestate(Willy_Jetpack_Spin)
        }
        else {
            SoundSpinBlocked()
        }
    }
    mem28 = (mem28 * 0.97) >> 8
    mem29 = (mem29 * 0.97) >> 8
    mem30 = (mem30 * 0.97) >> 8
    call(mem33)
}

sub MoveJetpack() {
    if (!(abs(mem28) & ~0x3FFF) && !(abs(mem29) & ~0x3FFF) && !(abs(mem30) & ~0x3FFF) && mem38 == -1.0 && !STATUS_FIRSTFRAME) {
        mem25 = x
        mem26 = y
        mem27 = z
        mem38 = 0
    }
    unless (mem38 == -1.0 || v0 == 0) {
        var target = mem26 + sin(loopseek(mem38, 100.0, 3.125), 24800)
        mem29 = (target - y) * 1s
    }
    if (mem28 > trotz) {
        mem28 = trotz
    }
    else if (mem28 < -trotz) {
        mem28 = -trotz
    }
    if (mem29 > trotz) {
        mem29 = trotz
    }
    else if (mem29 < -trotz) {
        mem29 = -trotz
    }
    if (mem30 > trotz) {
        mem30 = trotz
    }
    else if (mem30 < -trotz) {
        mem30 = -trotz
    }
    velx = mem28
    vely = mem29
    velz = mem30
}

sub MoveJetpackCortexIntro() {
    mem25 = x
    mem26 = y
    mem27 = z
    save (troty, trotz, scalex, x, y, z) {
        if (pathprog < 60.0) {
            pathprog = spd(pathprog, 30.0)
        }
        else {
            mem33 = getins(MoveJetpackCortex)
        }
        mem28 = 0
        mem29 = 0
        mem30 = 0
        calcpath()
        mem35 = degseek(mem35, troty, 10deg)
        mem34 = degseek(mem34, trotz, 10deg)
        scalex = abs(scalex)
        save (rotx, roty, rotz, vecx, vecy, vecz) {
            SetRot(mem34, mem35, mem35)
            SetVec(x, y, z)
            vectransf(vvec, vtrans, 0, mem31, mem32)
        }
        velx = (x - mem25) * 25
        vely = (y - mem26) * 25
        velz = (z - mem27) * 25
    }
}

sub MoveJetpackCortex() {
    mem25 = x
    mem26 = y
    mem27 = z
    save (troty, trotz, scalex, x, y, z) {
        pathprog = spd(pathprog, mem30 / -60)
        if (pathprog >= pathlen) {
            pathprog = pathlen - (1.0 >> 8)
        }
        if (pathprog < 60.0) {
            pathprog = 60.0
        }
        mem31 = spd(mem31, -mem28 << 1)
        if (mem31 > 4m) {
            mem28 = 0
            mem31 = 4m
        }
        else if (mem31 < -4m) {
            mem28 = 0
            mem31 = -4m
        }
        mem32 = spd(mem32, mem29 << 1)
        if (mem32 > 4m) {
            mem29 = 0
            mem32 = 4m
        }
        else if (mem32 < -4m) {
            mem29 = 0
            mem32 = -4m
        }
        calcpath()
        mem35 = degseek(mem35, troty, 10deg)
        mem34 = degseek(mem34, trotz, 10deg)
        scalex = abs(scalex)
        save (rotx, roty, rotz, vecx, vecy, vecz) {
            SetRot(mem34, mem35, mem35)
            SetVec(x, y, z)
            vectransf(vvec, vtrans, 0, mem31, mem32)
        }
        velx = (x - mem25) * 25
        vely = (y - mem26) * 25
        velz = (z - mem27) * 25
    }
}

sub PlayJetpackIdleTransition() {
    if (animseq == getanim(WILLY_ROCKET_UP_START_1) && animframe == 6.0) {
        playframesback(WILLY_ROCKET_UP_START_2, 5.0, 0.0)
    }
    else if (animseq == getanim(WILLY_ROCKET_DOWN_START_1) && animframe == 6.0) {
        playframesback(WILLY_ROCKET_DOWN_START_2, 5.0, 0.0)
    }
    else if (animseq == getanim(WILLY_ROCKET_LEFT_STOP_1) && animframe == 0.0) {
        playanim(0, WILLY_ROCKET_LEFT_STOP_2)
        playanim(1, WILLY_ROCKET_LEFT_STOP_2)
        playanim(2, WILLY_ROCKET_LEFT_STOP_2)
        playanim(3, WILLY_ROCKET_LEFT_STOP_2)
        playanim(3, WILLY_ROCKET_LEFT_STOP_2)
        playanim(4, WILLY_ROCKET_LEFT_STOP_2)
    }
    else if (animseq == getanim(WILLY_ROCKET_RIGHT_STOP_1) && animframe == 0.0) {
        playanim(0, WILLY_ROCKET_RIGHT_STOP_2)
        playanim(1, WILLY_ROCKET_RIGHT_STOP_2)
        playanim(2, WILLY_ROCKET_RIGHT_STOP_2)
        playanim(3, WILLY_ROCKET_RIGHT_STOP_2)
        playanim(3, WILLY_ROCKET_RIGHT_STOP_2)
        playanim(4, WILLY_ROCKET_RIGHT_STOP_2)
    }
    else if (animseq == getanim(WILLY_ROCKET_FORWARD)) {
        playframesback(WILLY_ROCKET_FORWARD_START, 9.0, 0.0)
    }
    else if (animseq == getanim(WILLY_ROCKET_FORWARD_START) || animseq == getanim(WILLY_ROCKET_FORWARD_STOP) || animseq == getanim(WILLY_ROCKET_UP_START_1) || animseq == getanim(WILLY_ROCKET_DOWN_START_1)) {
        while (animframe) {
            playframe(seek(animframe, 0.0, 1.0))
        }
    }
    else if (animseq == getanim(WILLY_ROCKET_RIGHT_STOP_1) || animseq == getanim(WILLY_ROCKET_LEFT_STOP_1)) {
        playframes(animframe, 6.0)
    }
}

state Willy_Jetpack_Spin { // 79
    stateflag 0x44000010
    statusc 0x2
    code() {
        if (animseq == getanim(WILLY_ROCKET_FORWARD_START) || animseq == getanim(WILLY_ROCKET_FORWARD)) {
            onstateexit(ResetJetpackPitch)
            rotx = 30deg
        }
        setanim(WILLY_ROCKET_SPIN, 9.0) 
        do { playframe((animframe + 1.0) % 10.0) } until (frametime - SpinPulseTime >= SpinDuration)
        setanim(WILLY_ROCKET, 0)
        changestate(Willy_Jetpack_Idle)
    }
    event(e, a) {
        rejevif (e == Event42) {
            sendevent(EventSpinHit, interrupter, 1)
        }
        rejevif (e == Event40) {
            save (interrupter) {
                interrupter = a[0]
                sendevent(EventSpinHit, interrupter, 1)
            }
        }
        rejevret(e == EventHit || e == Event35 || e == Event7 || e == Event9)
        if (e == Event44 || e == Event24 || e == Event31 || e == Event30 || e == Event63) {
            rejevret(invincible == 4)
            sendevent(EventHit, creator, a[0])
            if (eventaccepted) {
                mem28 = -mem28
                mem30 = -mem30
                mem29 = 0
                CheckInvincible()
                accevret()
            }
        }
        accevcstate(Willy_Jetpack_Shock, e == Event44)
        accevcstate(Willy_Jetpack_Shocked, e == Event35)
        accevcstate(Willy_Jetpack_Death, e == Event24 || e == Event38)
        accevcstate(Willy_Jetpack_Death_Explode, e == Event31 || e == Event30 || e == Event63)
        accevcstate(Willy_Jetpack_Recover, e == Event18)
    }
    trans {
        sendevent(EventSpinHit, collider, AttackCombo)
        if (eventaccepted) {
            SoundAttackCombo()
            AttackCombo += 1.0
        }
        rotz = roty
        save (vecx, vecy, vecz) {
            getvert(vvec, self, 0)
            spawn(9, 19, 1, 0, (vecx - x) << 4, 0, (vecz - z) << 4)
            spawn(9, 19, 1, 2.0, -(vecx - x) << 4, 0, -(vecz - z) << 4)
        }
        UpdateJetpack()
    }
}

sub ResetJetpackPitch() {
    rotx = 0
}

state Willy_Jetpack_Forward { // 80
    stateflag 0x44000001
    statusc 0x0
    event => state Willy_Jetpack_Idle
    code() {
        if (animseq == getanim(WILLY_ROCKET_UP_START_1) || animseq == getanim(WILLY_ROCKET_DOWN_START_1)) {
            while (animframe) { playframe(seek(animframe, 0.0, 1.0)) }
        }
        else if (animseq == getanim(WILLY_ROCKET_RIGHT_STOP_1) || animseq == getanim(WILLY_ROCKET_LEFT_STOP_1)) {
            playframes(animframe, 6.0)
        }
        else if ((animseq == getanim(WILLY_ROCKET_FORWARD) || (animseq == getanim(WILLY_ROCKET_FORWARD_START) && animframe > 5.0)) && !(abs(degdist(troty, JetpackFacing)) < 90deg) || animseq == getanim(WILLY_ROCKET_FORWARD_STOP)) {
            setanimifn(WILLY_ROCKET_FORWARD_STOP, 18.0)
            playframesback(animframe, 0.0)
        }
        if (animseq != getanim(WILLY_ROCKET_FORWARD)) {
            setanimifn(WILLY_ROCKET_FORWARD_START, 0.0)
            playframes(animframe, 9.0)
        }
        do {
            troty = JetpackFacing
            playanimifn(WILLY_ROCKET_FORWARD, -1.0, 31.0)
        } while (1)
    }
    trans {
        once {
            if (mem37) {
                spawn(9, 27, 1, 0, 0, -0.6m, 0, 2.0)
                mem37 = 0
            }
        }
        changestateifn(Willy_Jetpack_Idle, buttonhold(PAD_X | PAD_R1))
        if (dirhold(PAD_NONE)) {
            ApplyJetpackThrust(0, 0, -0.6m)
        }
        JetpackFacing = GAMEDIR + 180deg
        unless (STATUS_FIRSTFRAME || animseq == getanim(WILLY_ROCKET_FORWARD_STOP)) {
            troty = JetpackFacing
        }
        UpdateJetpack()
    }
}
state Willy_Jetpack_Backward { // 81
    stateflag 0x44000001
    statusc 0x0
    code => state Willy_Jetpack_Forward
    event => state Willy_Jetpack_Idle
    trans {
        once {
            if (mem37) {
                spawn(9, 27, 1, 0, 0, 0.6m, 0, 2.0)
                mem37 = 0
            }
        }
        changestateif(Willy_Jetpack_Idle, !buttonhold(PAD_CIRCLE | PAD_L1) || buttonhold(PAD_X | PAD_R1))
        if (dirhold(PAD_NONE)) {
            ApplyJetpackThrust(0, 0, 0.6m)
        }
        JetpackFacing = GLOBAL_15
        unless (STATUS_FIRSTFRAME || animseq == getanim(WILLY_ROCKET_FORWARD_STOP)) {
            troty = JetpackFacing
        }
        UpdateJetpack()
    }
}

inline sub FinishJetpackTransition() {
    if (animframe < 3.0) {
        while (animframe) { playframe(animframe - 1.0) }
    }
    else {
        until (animframe == 6.0) { playframe(animframe + 1.0) }
    }
}

sub PlayJetpackRight() {
    if (animseq == getanim(WILLY_ROCKET_UP_START_1)) {
        FinishJetpackTransition()
        if (animframe) {
            statusc |= 0x1
            playanim(0, WILLY_ROCKET_UP_TO_RIGHT)
            playanim(1, WILLY_ROCKET_UP_TO_RIGHT)
            playanim(2, WILLY_ROCKET_UP_TO_RIGHT)
            playanim(3, WILLY_ROCKET_UP_TO_RIGHT)
            playanim(3, WILLY_ROCKET_UP_TO_RIGHT)
            playanim(4, WILLY_ROCKET_UP_TO_RIGHT)
            statusc &= ~0x1
        }
        else {
            playanim(33, WILLY_ROCKET)
            goto exit
        }
    }
    else if (animseq == getanim(WILLY_ROCKET_DOWN_START_1)) {
        FinishJetpackTransition()
        if (animframe) {
            statusc |= 0x1
            playanim(0, WILLY_ROCKET_DOWN_TO_RIGHT)
            playanim(1, WILLY_ROCKET_DOWN_TO_RIGHT)
            playanim(2, WILLY_ROCKET_DOWN_TO_RIGHT)
            playanim(3, WILLY_ROCKET_DOWN_TO_RIGHT)
            playanim(3, WILLY_ROCKET_DOWN_TO_RIGHT)
            playanim(4, WILLY_ROCKET_DOWN_TO_RIGHT)
            statusc &= ~0x1
        }
        else {
            playanim(33, WILLY_ROCKET)
            goto exit
        }
    }
    else {
        exit :
        playframesback(WILLY_ROCKET_RIGHT_STOP_1, 6.0, 0.0)
    }
    sleepanim(0, WILLY_ROCKET_RIGHT_STOP_1)
}

state Willy_Jetpack_Right { // 82
    stateflag 0x44000001
    statusc 0x0
    code => sub PlayJetpackRight
    event => state Willy_Jetpack_Idle
    trans {
        once {
            if (mem37) {
                spawn(9, 27, 1, sin(ANALOGDIR) << 3, cos(ANALOGDIR) * mem39, 0, 0, 2.0)
                mem37 = 0
            }
        }
        changestateif(Willy_Jetpack_Idle, !dirhold(PAD_RIGHT) || buttonhold(PAD_X | PAD_R1) || buttonhold(PAD_CIRCLE | PAD_L1))
        UpdateJetpack()

    }
}

