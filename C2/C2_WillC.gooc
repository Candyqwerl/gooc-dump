state Willy_Death_Fire { // 58
    stateflag 0x1020
    statusc 0x3022
    code(hit) {
        TryBeginDeath(hit)
        KillBonus()
        statusb &= ~(FLAG_HAS_SHADOW | FLAG_ROT_Y)
        GAMEFLAGS &= ~0x2
        if (getpayload(&[WF10G], &[WF10V]) <= getfreepages()) {
            field_61 = true
            LoadAnim([WF10V], [WF10G])
        }
        else {
            field_61 = false
        }
        SoundDeathArg()
        sounddecay(7.68s)
        soundpitch((17.92 + rand(3.2)) * 0.23 >> 8)
        soundfadet(1.5s)
        soundfadev(0, 0, 2)
        soundplay([BDC0A], 0.75V)
        playanim(2, WILLY_STAND_1, 15)
        do { playanim(2, WILLY_STAND_1) } until (!field_61, isloaded([WF10G]) && isloaded([WF10V]))
        if (field_61) {
            var0 = 1.0
