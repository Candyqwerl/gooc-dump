state Willy_Jetpack_Death { // 88
    stateflag 0x60004022
    statusc 0x7002
    code(hit) {
        BeginDeath(hit)
        KillBonus()
        SoundDeathArg()
        if (mem41) {
            voice = mem41
            soundfadet(0.5s, voice, 0)
            soundfadev(0V, voice, 3)
            mem41 = 0
        }
        FadeToBlack()
        WaitFadeFrame()
        CrashDoRespawn()
    }
}
state Willy_Jetpack_Recover { // 89
    stateflag 0x44000002
    statusc 0x2
    event => state Willy_Jetpack_Idle
    code() {
        mem28 = 0
        mem29 = 0
        mem30 = 0
        playframes(WILLY_ROCKET_RECOVER, 0, 31.0)
        sleepanim(17, WILLY_ROCKET_FORWARD)
    }
    trans {
        nofirst {
            changestateif(Willy_Jetpack_Forward, animseq == getanim(WILLY_ROCKET_FORWARD))
        }
        UpdateJetpack()
    }
}
state Willy_Jetpack_Death_Fire { // 90
    stateflag 0x60001020
    statusc 0x3022
    trans => state Willy_Death_Fire
    code(hit) {
        BeginDeath(hit)
        KillBonus()
        statusb &= ~(FLAG_ROT_Y | FLAG_HAS_SHADOW)
        GAMEFLAGS &= ~0x2
        SoundDeathArg()
        if (mem41) {
            voice = mem41
            soundfadet(0.5s, voice)
            soundfadev(0V, voice, 3)
            mem41 = 0
        }
        sounddecay(7.68s)
        soundpitch((17.92 + rand(3.2)) * 0.23 >> 8)
        soundfadet(1.5s)
        soundfadev(0v, 0, 2)
        soundplay([BDC0A], 0.75V)
        playanim(0, WILLY_DEATH_ROCKET_FIRE_1, 27)
        v0 = 1.0
        soundfadet(0.15s, voice)
        soundfadev(0, voice, 2)
        sounddecay(7.68s)
        SoundPitchDefault(0.23)
        soundplay([BDA0A], 0.5V)
        playframes(WILLY_DEATH_ROCKET_FIRE_2, 0, 49.0)
        playframes(WILLY_DEATH_ROCKET_FIRE_3, 0, 17.0)
        FadeToBlack()
        WaitFadeFrame()
        CrashDoRespawn()
    }
}
state Willy_Jetpack_Death_Explode { // 91
    stateflag 0x60001020
    statusc 0x3022
    code(hit) {
        BeginDeath(hit)
        KillBonus()
        statusb &= ~(FLAG_ROT_Y | FLAG_HAS_SHADOW)
        GAMEFLAGS &= ~0x2
        SoundDeathArg()
        if (mem41) {
            voice = mem41
            soundfadet(0.5s, voice)
            soundfadev(0V, voice, 3)
            mem41 = 0
        }
        playframes(WILLY_DEATH_ROCKET_EXPLODE, 0, 75.0)
        FadeToBlack()
        WaitFadeNull()
        CrashDoRespawn()
    }
    trans {
        spawn(9, 21, 1, -1.0, randi(-4m, 4m), 8m, randi(-4m, 4m), 2S, 0.8, 24, 3)
        spawn(9, 21, 1, -1.0, randi(-4m, 4m), 8m, randi(-4m, 4m), 2S, 0.8, 24, 1)
        if (frametime - statetime >= 0.28s) {
            tpc = 0
        }
    }
}
state Willy_Jetpack_Shock { // 92
    stateflag 0x60001020
    statusc 0x0
    code(hit) {
        statusc = 0
        changestate(Willy_Jetpack_Shocked, hit)
    }
}
state Willy_Jetpack_Shocked { // 93
    stateflag 0x40000022
    statusc 0x3022
    trans => state Willy_Shocked
    code(hit) {
        if (mem41) {
            voice = mem41
            soundfadet(0.5s, voice)
            soundfadev(0V, voice, 3)
            mem41 = 0
        }
        if (animseq == getanim(WILLY_ROCKET_FORWARD_START) || animseq == getanim(WILLY_ROCKET_FORWARD)) {
            playanim(0, WILLY_DEATH_ROCKET_SHOCK_2)
            playanim(1, WILLY_DEATH_ROCKET_SHOCK_2)
            playanim(2, WILLY_DEATH_ROCKET_SHOCK_2)
            playanim(2, WILLY_DEATH_ROCKET_SHOCK_2)
        }
        BeginDeath(hit)
        v0 = 0
        statusb &= ~(FLAG_PHYSICS_TEST | FLAG_ROT_Y | FLAG_GRAVITY | FLAG_PHYSICS_ENGINE | FLAG_DPAD_CONTROL | 0x2000 | FLAG_HAS_SHADOW)
        spawn(9, 25, 1, 0.0, 1.0)
        spawn(9, 25, 1, 2.0, 3.0)
        spawn(9, 25, 1, 4.0, 5.0)
        spawn(9, 25, 1, 6.0, 7.0)
        spawn(9, 25, 1, 8.0, 9.0)
        do (var start = frametime) { PlayJetpackShock() } while (frametime - start < 0.7s)
        KillBonus()
        do (var start = frametime) { PlayJetpackShock() } while (frametime - start < 1s)
        FadeToBlack()
        do { PlayJetpackShock() } until (FADECONTROL == -1)
        CrashDoRespawn()
    }
}

sub PlayJetpackShock() {
    playanim(3, WILLY_DEATH_ROCKET_SHOCK_2, 1)
    playanim(0, WILLY_DEATH_ROCKET_SHOCK_1, 2)
    if (!rand(2)) {
        playanim(0, WILLY_DEATH_ROCKET_SHOCK_1)
        if (!rand(2)) {
            playanim(0, WILLY_DEATH_ROCKET_SHOCK_1)
        }
    }
}

state Willy_Jetpack_Dismount { // 94
    stateflag 0x40000001
    statusc 0x22
    code() {
        statusb &= ~FLAG_DPAD_CONTROL
        statusb |= FLAG_PHYSICS_ENGINE | FLAG_GRAVITY
        ResetSpeed()
        PlayJetpackIdleTransition()
        playframes(WILLY_ROCKET_DISMOUNT_1, 0, 4.0)
        do { playanim(5, WILLY_ROCKET_DISMOUNT_1) } until (STATUS_GROUNDLAND)
        playframes(WILLY_ROCKET_DISMOUNT_1, 6.0, 24.0)
        spawn(35, 9)
        if (mem41) {
            voice = mem41
            soundfadet(0.5s, voice)
            soundfadev(0V, voice, 3)
            mem41 = 0
        }
        playframes(WILLY_ROCKET_DISMOUNT_2, 0, 25.0)
        ResetMovement()
        changestate(Willy_Idle)
    }
}
#module default

sub ClearVehicleMode() {
    unless (stateflag & 0x4000000) {
        GAMEFLAGS &= ~0x10000
    }
}

state Willy_Trigger_Jetboard { // 95
    stateflag 0x20000001
    statusc 0x22
    code(obj) {
        changestate(Willy_Jetboard_Mount, obj)
    }
}

#module [WilkC]
#purge kpwx
inline sub SoundJetboardSplash() {
    sounddecay(8.8s)
    SoundPitchDefault(0.23)
    soundplay([SplSA], 0.5V)
}

state Willy_Jetboard_Mount { // 96
    stateflag 0x20000001
    statusc 0x22
    code(obj) {
        interrupter = obj
        scalex = abs(scalex)
        statusb |= FLAG_SOLID_GROUND | 0x2000 | 0x20000000
        groundy = GLOBAL_118
        mem38 = 0
        zindex = 40
        ResetSpeed()
        statusb &= ~(FLAG_DPAD_CONTROL | FLAG_PHYSICS_TEST)
        trotx = 180deg
        yzapproach = 90deg
        troty = 180deg
        setanim(WILLY_SURF_MOUNT, -1.0)
        do (var vx = (interrupter -> x - x) / 10, vz = (interrupter -> z - z) / 10) {
            animframe += 1.0
            x += vx
            z += vz
            playframe()
        } while (animframe + 1.0 <= 7.0)
        soundpitch(3.625)
        sounddecay(8s)
        soundplay([SfSRA], 0.6V)
        soundpitch(3.625)
        sounddecay(10.2s)
        soundplay([SfsRA], 0.35V)
        mem41 = voice
        playframes(WILLY_SURF_MOUNT, 8.0, 23.0)
        stateflag |= 0x4000000
        statusb |= FLAG_PHYSICS_TEST | FLAG_DPAD_CONTROL
        ResetSpeed()
        SetVec(0)
        trotz = 0deg
        mem40 = troty
        JetboardLastYaw = roty
        JetboardLean = 0
        mem31 = x
        mem28 = x
        mem25 = x
        mem32 = y
        mem29 = y
        mem26 = y
        mem33 = z
        mem30 = z
        mem27 = z
        setanim(WILLY_SURF, 0.0)
        changestate(Willy_Jetboard_Ride)
    }
    event(e, a) {
        rejevret(e == Event66)
    }
}

state Willy_Jetboard_Ride { // 97
    stateflag 0x24000001
    statusc 0x0
    code() {
        do {
            PlayJetboardRide()
        } while (1)
    }
    event(e, a) {
        accevcstate(Willy_Jetboard_Jump, e == Event21)
        accevcstate(Willy_Jetboard_Dismount, e == Event66)
        accevcstate(Willy_Jetboard_Death_Explode, e == Event30 || e == Event63)
        accevcstate(Willy_Jetboard_Death_Whirlpool, e == EventSpinHit)
        accevcstate(Willy_Jetboard_Death_Eaten, e == Event20)
        rejevret(e == Event33)
    }
    trans {
        changestateif(Willy_Jetboard_Boost, mem38 == 6m && buttonpress(PAD_CIRCLE | PAD_X | PAD_SQUARE))
        UpdateJetboard()
        mem38 = seek(mem38, 6m, spd(12m))
        if (!time(2) && FRAMETIME < 36 && mem37) {
            spawn(9, 11, 1, roty, 2)
        }
    }
}

sub UpdateJetboard() {
    groundy = GLOBAL_118
    var0 = degdist(roty, mem40) + (degdist(JetboardLastYaw, mem40) << 2)
    if (var0 < -15deg) {
        JetboardLean = var0 * -20 >> 2
        if (JetboardLean > 675deg) {
            JetboardLean = 675deg
        }
    }
    else if (var0 > 15deg) {
        JetboardLean = var0 * -20 >> 2
        if (JetboardLean < -675deg) {
            JetboardLean = -675deg
        }
    }
    else {
        JetboardLean = 0
    }
    if (dirhold(PAD_NONE)) {
        var0 = 0
    }
    else {
        {
            var ax = sin(ANALOGDIR) << 3
            var ay = 0
            var az = cos(ANALOGDIR) << 3
            if (abs(degdist(ANALOGDIR + GAMEDIR, roty)) < 120deg) {
                ins46(ax, ax)
                vecx += ax
                vecz += az
            }
            else if (mem38 == 6m) {
                vecx = vecx * 0.9 >> 8
                vecz = vecz * 0.9 >> 8
            }
            if (mem38 == 6m) {
                mem40 = ANALOGDIR + GAMEDIR
            }
            else {
                mem40 = seek(mem40, ANALOGDIR + GAMEDIR, 90deg)
            }
        }
        var0 = degdist(roty, mem40)
    }
    setvel(3m)
    vecx = (vecx * 0.97) >> 8
    vecz = (vecz * 0.97) >> 8
    if (vecx > mem38) {
        vecx = mem38
    }
    if (vecx < -mem38) {
        vecx = -mem38
    }
    velx += vecx
    if (vecz > mem38) {
        vecz = mem38
    }
    if (vecz < -mem38) {
        vecz = -mem38
    }
    velz += vecz
    {
        var travel = distance(mem25, self, DIST_NO_Y)
        var turn = abs(degdist(roty, mem40))
        trotz = 0
        if (turn > 30deg) {
            trotx = 60deg + travel / 6
        }
        else if (turn > 15deg) {
            trotx = 60deg
        }
        else {
            trotx = 60deg
        }
        rotz = roty
        if (mem38 > 6m) {
            trotx = 90deg
        }
        troty = degseek(troty, mem40, trotx)
        mem37 = travel > 180deg
    }
    if (FRAMETIME < 36 && (animframe % 4.0) >= 2.0) {
        do (var i = 0) {
            var0 = (i << 1) + (time(2) << 8)
            spawn(9, 21, 1, var0, 0, 1.5m, 0, 0.7S, 0, 70, 3)
        } while ({ i += 1.0 }; i < 2.0)
    }
    UpdateJetboardTrail()
}

sub UpdateJetboardTrail() {
    mem31 = mem28
    mem28 = mem25
    mem25 = x
    mem32 = mem29
    mem29 = mem26
    mem26 = y
    mem33 = mem30
    mem30 = mem27
    mem27 = z
    JetboardLastYaw = mem40
    sendevent(EventHitInvincible, collider, 0)
    voice = mem41
    soundfadet(0.1s, voice)
    soundfadet(1s, voice)
    soundpitch(3.0 + ((abs(ANALOGAMT) << 1) + rand(abs(ANALOGAMT) + 1)), voice, 2)
}

sub PlayJetboardRide() {
    playanimifn(WILLY_SURF, 6.0, 63.0)
    until (animseq == getanim(WILLY_SURF) && animframe == 62.0) {
        while (JetboardLean || (animseq == getanim(WILLY_SURF_TURN) && animframe != 30.0)) {
            if (animseq == getanim(WILLY_SURF_TURN)) {
                playframe(seek(animframe, JetboardLean + 30.0, 6.0))
            }
            else {
                playanim(30, WILLY_SURF_TURN)
            }
        }
        playanimifn(WILLY_SURF, -1.0, 63.0)
    }
}

state Willy_Jetboard_Boost { // 98
    stateflag 0x24200001
    statusc 0x0
    event => state Willy_Jetboard_Ride
    code() {
        mem39 = frametime
        mem40 = roty
        setvel(mem38, vvec)
        SoundPitchDefault(0.23)
        sounddecay(9.2s)
        soundplay([SfTRA], 1V)
        if (mem37) {
            playanim(0, WILLY_SURF_BOOST)
            if (mem37) {
                playframes(WILLY_SURF_BOOST, 1.0, 27.0)
                playanim(0, WILLY_SURF)
            }
        }
        do (var start = frametime) {
            PlayJetboardRide()
        } while (frametime - start < 0.5s)
        changestate(Willy_Jetboard_Ride)
    }
    trans {
        unless (frametime - statetime >= 0.48s) {
            mem38 = 12m
            if (FRAMETIME < 32) {
                if (STATUS_FIRSTFRAME) {
                    spawn(9, 26, 1, velx / 40, 0.5m, velz / 40, 0, 4.0)
                }
                var0 = 1.0
            }
            else {
                var0 = 2.0
            }
            do (var i = 0) {
                spawn(9, 21, 1, i, velx / -2, 0.5m, velz / -2, 0.9S, -0x50, 0x46, 15)
                i += var0
            } while (i < 4.0)
        }
        __Willy_Jetboard_Ride_TRANS()
    }
}

state Willy_Jetboard_Jump { // 99
    stateflag 0x24000409
    statusc 0x0
    __transargs
    stateflag 0x24000409
    statusc 0
    code(vy) {
        soundpitch((7.2 + rand(1.6)) * 0.205 >> 8)
        sounddecay(2.56s)
        soundplay([jmp0A], 0.3V)
        if (!(frametime - mem39 >= 0.2s) && mem38 > 6m) {
            playframes(WILLY_SURF_JUMP_FLIP, 0.0, 19.0)
            SoundJetboardSplash()
            playframes(WILLY_SURF_JUMP_LAND, 0.0, 14.0)
            playanim(4, WILLY_SURF)
        }
        else if (mem38 > 6m) {
            sounddelay(19)
            SoundJetboardSplash()
            playframes(WILLY_SURF_JUMP_BIG, 0.0, 31.0)
            playanim(0, WILLY_SURF)
        }
        else {
            sounddelay(19)
            SoundJetboardSplash()
            playframes(WILLY_SURF_JUMP_SMALL, 0.0, 29.0)
            playanim(0, WILLY_SURF)
        }
        changestate(Willy_Jetboard_Ride)
    }
    event(e, a) {
        rejevret(e == Event21 || e == Event66 || e == Event33)
        accevcstate(Willy_Jetboard_Death_Explode, e == Event30 || e == Event63)
        accevcstate(Willy_Jetboard_Death_Eaten, e == Event20)
    }
    trans {
        once {
            vely = vy
        }
        UpdateJetboard()
        if (mem38 > 6m) {
            mem38 = seek(mem38, 6m, spd(12m))
        }
    }
}

state Willy_Jetboard_Dismount { // 100
    stateflag 0x24400001
    statusc 0x4001023
    code(obj) {
        interrupter = obj
        ResetSpeed()
        statusb &= ~(FLAG_ROT_Y | FLAG_DPAD_CONTROL | FLAG_SOLID_GROUND)
        trotz = 0
        SetVel(0m, 14.96663m, -6m)
        StopJetboardSound()
        playframes(WILLY_JUMP_HIGH, 0.0, 3.0)
        playframes(4.0, 17.0) 
        do { playanim(13, WILLY_JUMP_FLIP) } until (STATUS_GROUNDLAND)
        ResetSpeed()
        onstateexit(ResetMovement)
        statusc &= ~0x1
        changestate(Willy_Land)
    }
    event(e, a) {
        rejevret(e == Event21 || e == Event66 || e == Event33 || e == Event30 || e == Event63)
    }
    trans {
        roty = spd(roty, 720deg)
    }
}

sub StopJetboardSound() {
    if (mem41) {
        voice = mem41
        soundfadet(1s, voice)
        soundfadev(0V, voice, 3)
        mem41 = 0
    }
}

state Willy_Jetboard_Death_Eaten { // 101
    stateflag 0x20000022
    statusc 0x20407022
    code(len) {
        sendevent(EventHit, creator, len)
        if (eventaccepted) {
            CheckInvincible()
            mem38 = 6m
            statusc &= ~0x20000000
            changestate(Willy_Jetboard_Ride)
        }
        BeginDeath(len)
        KillBonus()
        statusb &= ~FLAG_HAS_SHADOW
        StopJetboardSound()
        spawn2(47, 3, 1, 2.0)
        WaitNull(len)
        FadeToBlack()
        WaitFadeNull()
        CrashDoRespawn()
    }
}

state Willy_Jetboard_Death_Explode { // 102
    stateflag 0x24001021
    statusc 0x20401022
    event => state Willy_Jetboard_Dismount
    code(hit) {
        sendevent(EventHit, creator, hit)
        if (eventaccepted) {
            CheckInvincible()
            mem38 = 6m
            statusc &= ~0x20000000
            changestate(Willy_Jetboard_Jump, 18m)
        }
        BeginDeath(hit)
        KillBonus()
        GAMEFLAGS |= 0x2
        SoundDeathArg()
        trotz = 0deg
        statusb |= 0x2000
        StopJetboardSound()
        spawn(47, 3, 1, 2.0)
        playframe()
        playframes(WILLY_DEATH_SURF_EXPLODE, 0.0, 35.0)
        tpc = 0
        PlayDrown(6.0, GLOBAL_118)
    }
    trans {
        if (animframe <= 6.0 && !time(2)) {
            spawn(9, 21, 1, 0, 0, -4m, 0, 2S, 2.4, 24, 3)
        }
        y = seek(y, GLOBAL_118, spd(1m))
    }
}

state Willy_Jetboard_Death_Whirlpool { // 103
    stateflag 0x20004020
    statusc 0x7002
    code(hit) {
        BeginDeath(hit)
        KillBonus()
        SoundDeathArg()
        statusb |= FLAG_PHYSICS_ENGINE | FLAG_GRAVITY | FLAG_PHYSICS_TEST
        GAMEFLAGS |= 0x2
        statusb &= ~FLAG_ROT_Y
        zindex = 48
        do (var start = frametime) {
            playanimifn(WILLY_SURF, -1.0, 63.0)
        } while (frametime - start < 0.8s)
        settrans(UpdateJetboardWhirlpool)
        StopJetboardSound()
        SoundPitchDefault(0.23)
        soundplay([SSiRA], 1.0V)
        playframes(WILLY_DEATH_WHIRLPOOL, 0.0, 31.0)
        FadeToBlack()
        playnull(31)
        CrashDoRespawn()
    }
    trans {
        once {
            JetboardLean = 0
            troty = 180deg
        }
        groundy = spd(groundy, -2m)
        roty = spd(roty, troty)
        troty = spd(troty, 1500deg)
    }
}

sub UpdateJetboardWhirlpool() __trans {
    roty = spd(roty, troty)
    troty = spd(troty, 1500deg)
}

#module default

state Willy_Trigger_Bear { // 104
    stateflag 0x20000001
    statusc 0x22
    code(obj) {
        mem39 = entity
        interrupter = obj
        mem30 = interrupter -> id
        changestate(Willy_Bear_Mount)
    }
}

#module [WiltC]
#purge tyB

inline sub SoundBearImpact() {
    SoundPitchDefault(0.23)
    sounddecay(7.68s)
    soundplay(SOUND_FOOTSTEP_DEFAULT, 0.5V)
}

state Willy_Bear_Mount { // 105
    stateflag 0x1
    statusc 0x22
    code() {
        sendevent(EventHit, creator, 100.0)
        sendevent(EventHit, creator, 100.0)
        mem29 = mem30
        do {
            player = objectget(mem29)
            playframe()
        } until (player)
        entity = player -> entity
        pathlen = player -> pathlen
        if (!CHECKPOINTCOUNT || LEVEL == LEVEL_Unbearable) {
            ResetSpeed()
            statusb &= ~FLAG_DPAD_CONTROL
            playframes(WILLY_BEAR_MOUNT_START_1, 0.0, 12.0)
            do (var i = 0) {
                playanim(0, WILLY_BEAR_MOUNT_START_2, 2)
                playanim(12, WILLY_BEAR_MOUNT_START_1, 2)
            } while ({ i += 1.0 }; i < 4.0)
            troty = atan2(player -> trans)
            mem31 = 10m
            var0 = 0
            playframes(WILLY_BEAR_MOUNT_START_2, 0.0, 10.0)
            do {
                mem31 = spd(mem31, 50m)
                setvel(mem31)
                animframe += 1.0
                if (animframe > 17.0) {
                    animframe = 17.0
                }
                playframe()
            } until (var0)
        }
        {
            var nearest = -1
            var gap = 0
            do (var point = 0) {
                calcpath(point, vvec)
                var0 = abs(z - vecz)
                if (nearest < 0 || var0 < gap) {
                    nearest = point
                    gap = var0
                }
            } while ({ point += 1.0 }; point < pathlen)
            pathprog = nearest
        }
        scalex = abs(scalex)
        if (CHECKPOINTID > 0) {
            interrupter = objectget(CHECKPOINTID)
            if (interrupter) {
                save (entity) {
                    entity = interrupter -> entity
                    mem38 = fieldval(0x2A200)
                }
            }
        }
        else {
            mem38 = 0
        }
        mem31 = 8.0
        mem32 = 0
        trotx = 180deg
        yzapproach = 180deg
        statusb = (FLAG_ROT_Y | FLAG_TRACK_PATH_SIGN | FLAG_PHYSICS_TEST | FLAG_GRAVITY | FLAG_PHYSICS_ENGINE | FLAG_NO_CAMERA_CLIP | FLAG_HAS_SHADOW | 0x2800)
        calcpath(pathprog, vtrans)
        roty = troty
        pathdist = 2.5m
        mem33 = roty
        mem40 = roty
        mem28 = 0
        changestate(Willy_Bear_Start)
    }
}

state Willy_Bear_Run { // 106
    stateflag 0x20000005
    statusc 0x8000
    code() {
        if (animseq == getanim(WILLY_BEAR_ICE)) {
            playframes(17.0, 20.0)
        }
        else if (animseq == getanim(WILLY_BEAR_JUMP)) {
            SoundPitchDefault(0.23)
            sounddecay(3.2s)
            soundplay(SOUND_FOOTSTEP_DEFAULT, 0.8V)
            sounddelay(2)
            SoundPitchDefault(13.76, 0.23)
            sounddecay(3.2s)
            soundplay(SOUND_FOOTSTEP_DEFAULT, 0.4V)
            SoundPitchDefault(12.8, 0.25)
            sounddecay(3.2s)
            soundplay([BSktA], 0.15V + rand(0.05V))
            playframes(WILLY_BEAR_JUMP_LAND, 0.0, 8.0)
        }
        else if (animseq == getanim(WILLY_BEAR_BOOST)) {
            setanim(WILLY_BEAR)
        }
        do {
            playanimifn(WILLY_BEAR, -1.0, 8.0)
            if (animframe == 7.0) {
                SoundPitchDefault()
                sounddecay(3.2s)
                soundplay([BGatA], 0.6V)
                if (GLOBAL_119 & 0x800 && !(statusa & 0x2000000) && statusa & 0x40000) {
                    spawn(9, 37, 1, 0.2m, roty, abs(scalex) / 3)
                }
                if (GLOBAL_119 & 0x800 && !(statusa & 0x2000000) && statusa & 0x40000) {
                    spawn(9, 37, 1, -0.2m, roty, abs(scalex) / -3)
                }
                scalex = -scalex
            }
            if (animframe == 1.0) {
                if (GLOBAL_119 & 0x800 && !(statusa & 0x2000000) && statusa & 0x40000) {
                    spawn(9, 37, 1, 0.2m, roty, abs(scalex) / 3)
                }
                if (GLOBAL_119 & 0x800 && !(statusa & 0x2000000) && statusa & 0x40000) {
                    spawn(9, 37, 1, -0.2m, roty, abs(scalex) / -3)
                }
            }
        } while (1)
    }
    event(e, a) {
        accevcstate(Willy_Death, e == Event61)
        accevcstate(Willy_Bear_Death_Fall, e == EventHit || e == Event24 || e == Event7)
        accevcstate(Willy_Bear_Death_Ice, e == Event33)
        accevcstate(Willy_Bear_Death_Explode, e == Event30 || e == Event63)
        accevcstate(Willy_Bear_Death_Slam, e == Event35)
        if (e == Event60) {
            if (STATUS_GROUNDLAND) {
                accevcstate(Willy_Bear_Boost)
            }
            else {
                rejevret()
            }
        }
        accevif (e == Event68) {
            mem30 = mem29
        }
    }
    trans {
        if (animseq == getanim(WILLY_BEAR)) {
            changestateif(Willy_Bear_Ice, statusa & 0x2000000 && animseq == getanim(WILLY_BEAR) && animframe == 7.0)
        }
        changestateif(Willy_Bear_Boost, buttonbuffer(PAD_CIRCLE | PAD_R1) && mem31 == 8.0 && frametime - mem28 >= 1s)
        if (!(statusa & 0x2000000)) {
            if (frametime - statetime >= 0.08s && !(frametime - groundtime >= 0.28s)) {
                changestateif(Willy_Bear_Jump, (buttonbuffer(PAD_X) && (!(statusa & 0x80) || statusa & 0x100000)) || (!(frametime - statetime >= 0.2s) && (buttonhold(PAD_X) && (!(statusa & 0x80) || statusa & 0x100000))), 13.2665m)
            }
        }
        UpdateBearMovement()
    }
}

sub UpdateBearMovement() {
    mem31 = seek(mem31, 8.0, spd(13.2))
    if (mem29 == 11.0) {
        pathprog = spd(pathprog, (mem31 * 1.27) >> 8)
    }
    else {
        pathprog = spd(pathprog, mem31)
    }
    GLOBAL_3 = pathprog
    GLOBAL_82 = pathprog
    changestateif(Willy_Bear_Finish, ((LEVEL == LEVEL_BearIt && pathprog >= 240.5)
        || (LEVEL == LEVEL_BearDown && pathprog >= 338.0) 
        || (LEVEL == LEVEL_TotallyBear && pathprog >= 298.5) 
        || (LEVEL == LEVEL_Unbearable && pathprog >= 144.0)) && mem29 == mem34)
    if (pathprog >= pathlen - 1.0) {
        mem29 += 1.0
        interrupter = objectget(mem29)
        entity = interrupter -> entity
        pathlen = interrupter -> pathlen
        pathprog = 0.0
    }
    if (statusa & 0x2000000) {
        if (dirhold(PAD_LEFT)) {
            mem32 = seek(mem32, pathdist * -mem35, 0.5m * ANALOGAMT >> 8)
        }
        else if (dirhold(PAD_RIGHT)) {
            mem32 = seek(mem32, pathdist * mem35, 0.5m * ANALOGAMT >> 8)
        }
    }
    else {
        if (dirhold(PAD_LEFT)) {
            mem32 = seek(mem32, pathdist * -mem35, 4m * ANALOGAMT >> 8)
        }
        else if (dirhold(PAD_RIGHT)) {
            mem32 = seek(mem32, pathdist * mem35, 4m * ANALOGAMT >> 8)
        }
        else {
            mem32 = seek(mem32, 0, 8m)
        }
        if (STATUS_GROUNDLAND) {
            mem38 += degdist(mem33, mem40) * 400
        }
    }
    if (mem32) {
        mem38 = spd(mem38, mem32)
        if (mem38 < -pathdist) {
            mem38 = -pathdist
        }
        else if (mem38 > pathdist) {
            mem38 = pathdist
        }
    }
    save (vecx, vecy, vecz) {
        calcpath(pathprog, vvec)
        x = vecx
        groundy = vecy
        z = vecz
    }
    unless (STATUS_GROUNDLAND) {
        trotz = 0deg
    }
    save (scalex) {
        scalex = abs(scalex)
        save (rotx, roty, rotz, vecx, vecy, vecz) {
            SetRot(0deg, mem40, 0deg)
            SetVec(x, y, z)
            vectransf(vvec, vtrans, 0, -mem38, 0)
        }
    }
    mem33 = mem40
    mem40 = degseek(mem33, troty, 60deg)
    unless (dirhold(PAD_NONE) || stateflag & 0x8000000) {
        troty = degseek(troty, ANALOGDIR + GAMEDIR, 900deg)
    }
    if (mem31 > 8.0) {
        sendevent(EventSlideHit, collider, AttackCombo)
        if (eventaccepted) {
            SoundAttackCombo()
            AttackCombo += 1.0
        }
    }
    sendevent(EventHitInvincible, collider, 0)
}

state Willy_Bear_Start { // 107
    stateflag 0x20000005
    statusc 0x8000
    event => state Willy_Bear_Run
    trans => sub UpdateBearMovement
    code() {
        if (!CHECKPOINTCOUNT || LEVEL == LEVEL_Unbearable) {
            soundpitch(3.625)
            sounddecay(10.2s)
            soundplay([BRltA], 0.7V)
            playframes(WILLY_BEAR_MOUNT, 0.0, 24.0)
        }
        else {
            settrans(UpdateBearRespawn)
            statusb &= ~FLAG_ROT_Y
            do (var i = 0) {
                playframes(WILLY_BEAR, 5.0, 7.0)
                playframes(WILLY_BEAR, 0.0, 3.0)
            } while ({ i += 1.0 }; i < 4.0)
            statusb |= FLAG_ROT_Y
        }
        settrans(UpdateBearMovement)
        playanim(4, WILLY_BEAR)
        changestate(Willy_Bear_Run)
    }
}

sub UpdateBearRespawn() {
    roty = spd(roty, 540deg)
}

state Willy_Bear_Ice { // 108
    stateflag 0x28000005
    statusc 0x8000
    event => state Willy_Bear_Run
    code() {
        if (!mem41) {
            SoundPitchDefault(4.8, 0.43)
            sounddecay(1.6s)
            soundplay([SSlGA], 0.01221V + ((0.04884V + (abs(speed) >> 9)) + (rand((abs(speed) >> 10) + 1))))
            mem41 = voice
            onstateexit(StopBearIceSound)
        }
        playframes(WILLY_BEAR_ICE, 0.0, 16.0)
        sleep()
    }
    trans {
        changestateifn(Willy_Bear_Run, statusa & 0x2000000)
        UpdateBearMovement()
        if (mem41) {
            voice = mem41
            soundfadet(0.1s, voice)
            soundfadev(0.01221V + ((0.04884V + (abs(speed) >> 9)) + (rand((abs(speed) >> 10) + 1))), voice, 2)
            soundpitch(4.8 + rand(1.28), voice, 2)
        }
    }
}

sub StopBearIceSound() {
    if (mem41) {
        voice = mem41
        soundfadet(0.1s, voice)
        soundfadev(0V, voice, 3)
        mem41 = 0
    }
}

state Willy_Bear_Boost { // 109
    stateflag 0x20200005
    statusc 0x8000
    code() {
        mem31 = 16.0
        do (var start = frametime) {
            if (animframe == 7.0 || animframe == 6.0) {
                SoundPitchDefault()
                sounddecay(3.2s)
                soundplay([BGFtA], 0.7V)
                if (GLOBAL_119 & 0x800 && !(statusa & 0x2000000) && statusa & 0x40000) {
                    spawn(9, 37, 1, 0.2m, roty, abs(scalex) / 3)
                }
                if (GLOBAL_119 & 0x800 && !(statusa & 0x2000000) && statusa & 0x40000) {
                    spawn(9, 37, 1, -0.2m, roty, abs(scalex) / -3)
                }
                scalex = -scalex
            }
            setanimif(WILLY_BEAR, WILLY_BEAR_BOOST)
            playanimifn(WILLY_BEAR_BOOST, -2.0, 2.0, 8.0)
            if (animframe == 1.0 || animframe == 2.0) {
                if (GLOBAL_119 & 0x800 && !(statusa & 0x2000000) && statusa & 0x40000) {
                    spawn(9, 37, 1, 0.2m, roty, abs(scalex) / 3)
                }
                if (GLOBAL_119 & 0x800 && !(statusa & 0x2000000) && statusa & 0x40000) {
                    spawn(9, 37, 1, -0.2m, roty, abs(scalex) / -3)
                }
            }
        } while (frametime - start < 0.6s)
        mem31 = 8.0
        changestate(Willy_Bear_Run)
    }
    event(e, a) {
        rejevret(e == EventHit || e == Event60)
        accevcstate(Willy_Death, e == Event61)
        accevcstate(Willy_Bear_Death_Fall, e == Event24 || e == Event7)
        accevcstate(Willy_Bear_Death_Ice, e == Event33)
        accevcstate(Willy_Bear_Death_Explode, e == Event30 || e == Event63)
        accevcstate(Willy_Bear_Death_Slam, e == Event35)
        accevif (e == Event68) {
            mem30 = mem29
        }
    }
    trans {
        mem28 = frametime
        UpdateBearMovement()
        if (frametime - statetime >= 0.08s && !(frametime - groundtime >= 0.28s)) {
            changestateif(Willy_Bear_Jump, buttonbuffer(PAD_X) && (!(statusa & 0x80) || statusa & 0x100000), 16m)
        }
        if (animseq == getanim(WILLY_BEAR_BOOST) && ((animframe >= 0 && animframe <= 1.0) || (animframe >= 6.0 && animframe <= 7.0))) {
            spawn(9, 1, 2, 0)
        }
    }
}

state Willy_Bear_Jump { // 110
    stateflag 0x20000009
    statusc 0x8000
    event => state Willy_Bear_Run
    __transargs
    code(vy) {
        if (animseq == getanim(WILLY_BEAR) && animframe >= 1.0 && animframe <= 2.0) {
            playanim(0, WILLY_BEAR_JUMP_START_2)
            playanim(1, WILLY_BEAR_JUMP_START_2)
            playanim(2, WILLY_BEAR_JUMP_START_2)
            playanim(3, WILLY_BEAR_JUMP_START_2)
            playanim(3, WILLY_BEAR_JUMP_START_2)
            playanim(4, WILLY_BEAR_JUMP_START_2)
        }
        else if (animseq == getanim(WILLY_BEAR) && animframe >= 3.0 && animframe <= 6.0) {
            playanim(0, WILLY_BEAR_JUMP_START_3)
            playanim(1, WILLY_BEAR_JUMP_START_3)
            playanim(2, WILLY_BEAR_JUMP_START_3)
            playanim(3, WILLY_BEAR_JUMP_START_3)
            playanim(3, WILLY_BEAR_JUMP_START_3)
            playanim(4, WILLY_BEAR_JUMP_START_3)
        }
        else {
            playanim(0, WILLY_BEAR_JUMP_START_1)
            playanim(1, WILLY_BEAR_JUMP_START_1)
            playanim(2, WILLY_BEAR_JUMP_START_1)
            playanim(3, WILLY_BEAR_JUMP_START_1)
            playanim(3, WILLY_BEAR_JUMP_START_1)
            playanim(4, WILLY_BEAR_JUMP_START_1)
        }
        SoundPitchDefault()
        sounddecay(2.56s)
        soundplay([jmp0A], 0.7V)
        playanim(0, WILLY_BEAR_JUMP)
        playanim(1, WILLY_BEAR_JUMP)
        playanim(2, WILLY_BEAR_JUMP)
        playanim(2, WILLY_BEAR_JUMP)
        playanim(3, WILLY_BEAR_JUMP)
        playanim(4, WILLY_BEAR_JUMP)
        playanim(5, WILLY_BEAR_JUMP)
        playanim(6, WILLY_BEAR_JUMP)
        sleep()
    }
    trans {
        once {
            vely = vy
        }
        if (collider && vely <= 0) {
            sendevent(EventJumpedOn, collider, BounceCombo)
            if (eventaccepted) {
                BounceCombo += 1.0
                changestate(Willy_Bear_Jump, 12.64912m)
            }
        }
        changestateif(Willy_Bear_Run, frametime - statetime >= 0.08s && STATUS_GROUNDLAND)
        UpdateBearMovement()
        if (buttonhold(PAD_X) && (!(statusa & 0x80) || statusa & 0x100000)) {
            vely = spd(vely, 10.5m)
        }
    }
}

state Willy_Bear_Death_Ice { // 111
    stateflag 0x20004020
    statusc 0x7002
    trans => state Willy_Bear_Death_Fall
    code(hit) {
        BeginDeath(hit)
        mem25 = x
        mem26 = y
        mem27 = z
        SetVec(x, y - 1m, z)
        statetime = frametime
        GLOBAL_128 = x
        GLOBAL_129 = y
        GLOBAL_130 = z
        GAMEFLAGS |= 0x20002
        statusb |= FLAG_GRAVITY | FLAG_PHYSICS_ENGINE
        SoundDeathArg()
        sounddelay(3)
        sounddecay(7.68s)
        SoundPitchDefault(0.23)
        soundplay([SplSA], 0.5V)
        save (vfx) {
            vfx = (vfx & 0xFFFF00FF) | 0x600
            statusb &= ~FLAG_HAS_SHADOW
            KillBonus()
            if (getpayload(&[Cb5tV], &[Cb2tG], &[Cb6tV], &[Cb2tG]) <= getfreepages()) {
                LoadAnim([Cb5tV], [Cb2tG])
                playframe()
                playframe()
                settrans(UpdateBearDeathCamera)
                do { playframe() } until (y < mem26 - 5m)
                roty = CAMROTY
                y = mem26
                statusb &= ~(FLAG_GRAVITY | FLAG_PHYSICS_ENGINE)
                LoadAnim([Cb6tV], [Cb2tG])
                do { playnull() } until (isloaded([Cb5tV]) && isloaded([Cb2tG]))
                playframes(WILLY_DEATH_BEAR_ICE_1, 0.0, 75.0)
                sounddelay(14)
                SoundPitchDefault(0.122)
                sounddecay(7.68s)
                soundplay([BG1tA], 1V)
                sounddelay(43)
                SoundPitchDefault(0.122)
                sounddecay(7.68s)
                soundplay([BG1tA], 1V)
                playframes(WILLY_DEATH_BEAR_ICE_2, 0.0, 67.0)
                FadeToBlack()
                playframes(WILLY_DEATH_BEAR_ICE_2, 68.0, 74.0)
                WaitFadeFrame()
                DeloadAnim([Cb5tV], [Cb2tG])
                DeloadAnim([Cb6tV], [Cb2tG])
            }
        }
        GAMEFLAGS &= ~0x20000
        CrashDoRespawn()
    }
}

sub UpdateBearDeathCamera() {
    if (GAMEFLAGS & 0x20000) {
        v0 = (frametime - statetime) - 2s
        if (v0 < 0s) {
            v0 = 0s
        }
        if (v0 > 2s) {
            v0 = 2s
        }
        v0 = (v0 << 8) / 2s
        GLOBAL_128 = ((vecx - mem25) * v0 >> 8) + mem25
        GLOBAL_129 = ((vecy - mem26) * v0 >> 8) + mem26
        GLOBAL_130 = ((vecz - mem27) * v0 >> 8) + mem27
    }
}

