        if (animframe) {
            statusc |= 0x1
            playanim(0, WILLY_ROCKET_DOWN_TO_LEFT)
            playanim(1, WILLY_ROCKET_DOWN_TO_LEFT)
            playanim(2, WILLY_ROCKET_DOWN_TO_LEFT)
            playanim(3, WILLY_ROCKET_DOWN_TO_LEFT)
            playanim(4, WILLY_ROCKET_DOWN_TO_LEFT)
            playanim(4, WILLY_ROCKET_DOWN_TO_LEFT)
            playanim(5, WILLY_ROCKET_DOWN_TO_LEFT)
            playanim(6, WILLY_ROCKET_DOWN_TO_LEFT)
            statusc &= ~0x1
