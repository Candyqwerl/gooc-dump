}


state Willy_Jetpack_Right_Reversed { // 83
    stateflag 0x44000001
    statusc 0x0
    code => sub PlayJetpackLeft
    event => state Willy_Jetpack_Idle
    trans => state Willy_Jetpack_Right
}
