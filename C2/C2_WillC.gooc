        changestateif(Willy_Jetpack_Idle, !((mem39 > 0 && dirhold(PAD_DOWN)) || (mem39 < 0 && dirhold(PAD_UP))) || buttonhold(PAD_X | PAD_R1) || buttonhold(PAD_CIRCLE | PAD_L1))
        UpdateJetpack()
