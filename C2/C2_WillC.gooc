state Willy_Jetpack_Down { // 86
    stateflag 0x44000001
    statusc 0x0
    event => state Willy_Jetpack_Idle
    code() {
        if (animseq == getanim(WILLY_ROCKET_RIGHT_STOP_1)) {
            FinishJetpackTransition()
            if (!animframe) {
                statusc |= 0x1
                playframesback(WILLY_ROCKET_DOWN_TO_RIGHT, 5.0, 0.0)
                statusc &= ~0x1
            }
            else {
                playanim(33, WILLY_ROCKET)
                goto exit
            }
        }
        else if (animseq == getanim(WILLY_ROCKET_LEFT_STOP_1)) {
            FinishJetpackTransition()
            if (!animframe) {
                statusc |= 0x1
                playframesback(WILLY_ROCKET_DOWN_TO_LEFT, 7.0, 0.0)
                statusc &= ~0x1
            }
            else {
                playanim(33, WILLY_ROCKET)
                goto exit
            }
        }
        else {
            exit :
            playanim(0, WILLY_ROCKET_DOWN_START_1)
            playanim(1, WILLY_ROCKET_DOWN_START_1)
            playanim(2, WILLY_ROCKET_DOWN_START_1)
            playanim(3, WILLY_ROCKET_DOWN_START_1)
            playanim(3, WILLY_ROCKET_DOWN_START_1)
            playanim(4, WILLY_ROCKET_DOWN_START_1)
            playanim(5, WILLY_ROCKET_DOWN_START_1)
        }
        sleepanim(6, WILLY_ROCKET_DOWN_START_1)
    }
    trans {
        once {
            if (mem37) {
                spawn(9, 27, 1, sin(ANALOGDIR) << 3, cos(ANALOGDIR) * mem39, 0, 0, 2.0)
                mem37 = 0
            }
        }
        changestateif(Willy_Jetpack_Idle, !((mem39 > 0 && dirhold(PAD_UP)) || (mem39 < 0 && dirhold(PAD_DOWN))) || buttonhold(PAD_X | PAD_R1) || buttonhold(PAD_CIRCLE | PAD_L1))
        save (y) {
            y += 0.5m
            sendevent(EventJumpedOn, collider, 100)
        }
        UpdateJetpack()
    }
}

