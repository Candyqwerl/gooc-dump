    if (animseq == getanim(WILLY_ROCKET_UP_START_1)) {
        FinishJetpackTransition()
        if (animframe) {
            statusc |= 0x1
            playanim(0, WILLY_ROCKET_UP_TO_LEFT)
            playanim(1, WILLY_ROCKET_UP_TO_LEFT)
            playanim(2, WILLY_ROCKET_UP_TO_LEFT)
            playanim(3, WILLY_ROCKET_UP_TO_LEFT)
            playanim(3, WILLY_ROCKET_UP_TO_LEFT)
            playanim(4, WILLY_ROCKET_UP_TO_LEFT)
            statusc &= ~0x1
        }
        else {
            playanim(33, WILLY_ROCKET)
            goto exit
        }
    }
    else if (animseq == getanim(WILLY_ROCKET_DOWN_START_1)) {
