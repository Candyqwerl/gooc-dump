        }
        if ((animseq == getanim(WILLY_BEAR_LAUNCH) && animframe == 73.0) || (animseq == getanim(WILLY_BEAR_LAUNCH_LAND) && animframe == 4.0)) {
            mem31 >>= 1
            statusb |= FLAG_HAS_SHADOW
            spawn(9, 2, 1, 0, 5.0, 4m)
        }
        if (stateflag & 0x100) {
            pathprog = spd(pathprog, mem31)
            if (pathprog >= pathlen) {
                pathprog = pathlen - 1.0
            }
            calcpath(pathprog, vvec)
            mem38 = seek(mem38, 0, spd(2m))
            x = vecx
            z = vecz
            groundy = vecy
            save (scalex) {
                scalex = abs(scalex)
                save (rotx, roty, rotz, vecx, vecy, vecz) {
                    rotx = 0deg
                    rotz = 0deg
