state Willy_Death_Drown { // 61
    stateflag 0x4020
    statusc 0x7002
    __transargs
    code(depth) {
        onstateexit(RestoreAfterHit)
        statusb &= ~FLAG_HAS_SHADOW
        statusb &= ~(FLAG_ROT_Y | FLAG_GRAVITY | FLAG_PHYSICS_ENGINE | FLAG_DPAD_CONTROL)
        ResetSpeed()
        GAMEFLAGS &= ~0x2
        sendevent(Event28, interrupter, 0)
        KillBonus()
        SoundDeathArg()
        if ((LEVEL == LEVEL_HangEight || LEVEL == LEVEL_AirCrash || LEVEL == LEVEL_PlantFood) && !(frametime - GLOBAL_3 >= 1s)) {
            groundy = depth - 2m
            statusb |= FLAG_SOLID_GROUND
            settrans(UpdateDrowning)
            spawn(9, 14, 1, -1.0, depth, 7.0, 1.5m)
            playframes(WILLY_DEATH_DROWN_1, 0.0, 90.0)
            playframes(WILLY_DEATH_DROWN_2, 0.0, 42.0)
            CrashDoRespawn()
        }
        else {
            PlayDrown(0, depth)
        }
    }
    trans {
        y = seek(y, depth, spd(1m))
        if (!STATUS_FIRSTFRAME) {
            unless (time(2) || LEVEL == LEVEL_BearIt || LEVEL == LEVEL_BearDown || LEVEL == LEVEL_TotallyBear) {
                spawn(9, 29, 1, depth, depth, 0, 0, 0)
            }
        }
        if (y == depth) {
            tpc = 0
        }
    }
}

sub UpdateDrowning(depth) __trans {
    if (animseq == getanim(WILLY_DEATH_DROWN_2) && animframe == 35.0) {
        FadeToBlack()
    }
    y -= (y - groundy) << 6 >> 8
    if ((animseq == getanim(WILLY_DEATH_DROWN_1) && animframe >= 81.0) || (animseq == getanim(WILLY_DEATH_DROWN_2) && animframe <= 3.0)) {
        if (!time(2)) {
            spawn(9, 29, 1, depth, depth, 0, 0, 0)
        }
    }
}

sub PlayDrown(frame, depth) {
    KillBonus()
    spawn(9, 14, 1, -1.0, depth, 9.0, 2m)
    {
        var loaded = getpayload(&[Cr10G], &[Cs3kV]) <= getfreepages()
        if (loaded) {
            LoadAnim([Cs3kV], [Cr10G])
            ExtraAnimGroup = 14.0
            var0 = true
        }
        setanim(WILLY_DEATH_DROWN_3)
        animframe = frame - 1.0
        playframes3(41.0)
        if (loaded) {
            playframes(WILLY_DEATH_DROWN_4, 0.0, 51.0)
            FadeToBlack()
            playframes(WILLY_DEATH_DROWN_4, 51.0, 57.0)
            WaitFadeFrame()
            DeloadAnim([Cs3kV], [Cr10G])
            ExtraAnimGroup = 0
        }
        else {
            FadeToBlack()
            WaitFadeFrame()
        }
    }
    CrashDoRespawn()
}


