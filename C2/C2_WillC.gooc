inline sub SoundDeathArg() {
    SoundPitchDefault()
    sounddecay(7.68s)
    soundplay([arg0A], 0.5V)
}

inline sub SoundSlamBounce(pitch) {
    sounddecay(10.2s)
    soundpitch((pitch + (rand(3.2) + (0.8 * (BounceCombo - 1.0) >> 8))) * 0.23 >> 8)
    soundplay([bnk0A], 0.7V)
}

inline sub SoundAttackCombo() {
    sounddecay(5.76s)
    soundpitch((14.4 + (rand(3.2) + (1.6 * AttackCombo >> 8))) * 0.23 >> 8)
    soundplay([sht0A], 0.4V)
}

inline sub SoundSpinBlocked() {
    SoundPitchDefault()
    sounddecay(5.76s)
    soundplay([!sp0A], 0.3V)
}

inline sub SoundSpinDefault() {
    soundpitch(3.625)
    sounddecay(6.4s)
    soundplay([spn0A], 0.4V)
}

inline sub SoundJumpDefault() {
    SoundPitchDefault()
    sounddecay(2.56s)
    soundplay([jmp0A], 0.1V)
}

inline sub SoundFootstepDefault() {
    soundpitch((13.76 + rand(3.2)) * 0.23 >> 8)
    sounddecay(3.2s)
    soundplay(SOUND_FOOTSTEP_DEFAULT, 0.2V)
}

inline sub CrashEventCommon(e, a) {
    if (collider == interrupter && (e == EventHit || e == Event14 || e == Event20 || e == Event35 || e == Event30 || e == Event31 || e == Event62 || e == Event74)) {
        rejevret(vely < 0 && statusa & 0x4000 && collider -> y < y)
    }
}

inline sub CheckJump(target, vy) {
    changestateif(target, buttonbuffer(PAD_X) && (!(statusa & 0x80) || statusa & 0x100000), vy)
}

inline sub CheckSlide() {
    changestateif(Willy_Slide, buttonhold(PAD_R1 | PAD_CIRCLE) && (buttonbuffer(PAD_R1 | PAD_CIRCLE) || dirhold(PAD_NONE)))
}

inline sub CheckSpinNoDig() {
    if (buttonbuffer(PAD_SQUARE)) {
        if (frametime - SpinCooldownTime >= 0.68s) {
            changestate(Willy_Spin_Start)
        }
        else {
            SoundSpinBlocked()
        }
    }
}

inline sub CheckSpin() {
    if (buttonbuffer(PAD_SQUARE)) {
        if ((LEVEL == LEVEL_DigginIt || LEVEL == LEVEL_BeeHaving) && statusa \ 0x4000001) {
            changestate(Willy_Dig_Dive)
        }
        else {
            CheckSpinNoDig()
        }
    }
}

inline sub CheckFall(fall, rise, len) {
    if (!STATUS_GROUNDLAND && frametime - groundtime >= len && field_63 < y - 1m) {
        groundtime = frametime
        if (vely <= 0) {
            changestate(fall)
        }
        else {
            changestate(rise)
        }
    }
}

inline sub CheckInvincible() {
    if (!invincible) {
        SetInvincible(4, frametime)
    }
}

inline sub HoldAirborneFrame(offset) {
    do {
        field_60 = offset
        playframe(animframe, 52)
    } while (1)
}

inline sub HoldJumpStartFrame() {
    do {
        field_60 = -91.0
        playanim(3, WILLY_JUMP_START, 52)
    } while (1)
}


inline sub ResetSpeed() {
    velx = 0
    velz = 0
    speed = 0
}

inline sub ResetCombos() {
    AirSpinCount = 0
    BounceCombo = 0
    AttackCombo = 0
    SpinPulseTime = 0
}

inline sub WaitBonusDead() {
    while ((GLOBAL_119 & 0x2000 && BONUSSTATE != BONUS_COMPLETED) && (BONUSSTATE == BONUS_KILLED && !(frametime - BONUSDEATHTIME >= 1.2s))) {
        playframe()
    }
}

inline sub CrashDoRespawn() {
    PrepareRespawn()
    loadcheckpoint(misc)
    changestate(Willy_Respawn)
}

inline sub KillBonus() {
    if (BONUSSTATE == BONUS_CURRENT) {
        SetBonusState(BONUS_KILLED)
    }
}

sub SetLevelResult(result) {
    GLOBAL_17 = result
    if (var temp = result; temp == 2.0) {
        LIFECOUNT = 0
        FRUITCOUNT = 0
        HEALTH = 0
        GLOBAL_89 = LEVEL
    }
    else if (temp == 3.0 || temp == 4.0 || temp == 1.0 || temp == 5.0) {
        GLOBAL_89 = 99
        LIFECOUNT = LifeCount
        FRUITCOUNT = FruitCount
        sendevent(Event15, creator, 4.0)
        if (GLOBAL_17 != 4.0 || var0 < HEALTH) {
            HEALTH = var0
        }
    }
}

sub DeloadExtraAnims() {
    BreathMode = 0
    if (var group = ExtraAnimGroup; group == 1.0) {
        DeloadAnim([Ce10V], [Cr10G])
        DeloadAnim([Ce30V], [Cr10G])
    }
    else if (group == 15.0) {
        DeloadAnim([CD10V], [Cr10G])
    }
    else if (group == 16.0) {
        DeloadAnim([CD10V], [Cr10G])
        DeloadAnim([CD20V], [Cr10G])
    }
    else if (group == 17.0) {
        DeloadAnim([CD20V], [Cr10G])
        DeloadAnim([CD30V], [Cr10G])
    }
    else if (group == 18.0) {
        DeloadAnim([CC10V], [Cr10G])
    }
    else if (group == 19.0) {
        DeloadAnim([CC20V], [Cr10G])
    }
    ExtraAnimGroup = 0
}

state Willy_Init { // 0
    stateflag 0x8001
    statusc 0x9002
    code() {
        SpinDuration = 0.4s
        ExtraAnimGroup = 0
        BONUSSTATE = BONUS_UNVISITED
        FruitCount = FRUITCOUNT
        health = 100.0
        LifeCount = LIFECOUNT 
        CrystalCount = 0
        CollectedLevelGem = 0
        CollectedSpecialGem = 0
        SpinCooldownTime = 0
        mem3 = 0x4B
        SpinCooldownLimit = 0.76s
        SpinPulseTime = 0
        mem12 = 0
        mem41 = 0
        LEVELBOXCOUNT = fieldval(ENTITY_FIELD_BOXCOUNT)
        mem22 = fieldval(0x29800)
        ResetCombos()
        if (var level = LEVEL; level == LEVEL_BearIt
            || level == LEVEL_BearDown
            || level == LEVEL_TotallyBear
            || level == LEVEL_CrashDash
            || level == LEVEL_CrashCrush 
            || level == LEVEL_Unbearable
            || level == LEVEL_BossCortex
            || level == LEVEL_BossTazTiger
            || level == LEVEL_GameEnd 
            || level == LEVEL_BossRipperRoo
            || level == LEVEL_BossNGin) {
                HEALTH = 0
            }
        ResetMovement()
        spawn(DoctC, DoctC_S_DOCTOR, 1, HEALTH)
        statusc &= ~0x8000
        if (var level = LEVEL; level == LEVEL_SewerOrLater || level == LEVEL_TheEelDeal || level == LEVEL_HanginOut) {
            spawn(9, 7, 1, 0x12C00)
        }
        else if (level == LEVEL_Ruination) {
            spawn(60, 0, 1, 1.0, 18)
        }
        else if (level == LEVEL_TurtleWoods) {
            spawn(9, 7, 1, 0x2800)
            spawn(60, 0, 1, 0, 4)
        }
        else if (level == LEVEL_NightFight || level == LEVEL_TotallyFly) {
            GLOBAL_55 = 0
            GLOBAL_54 = 0
            GLOBAL_120 = 0
        }
        else if (level == LEVEL_RockIt || level == LEVEL_PackAttack) {
            spawn(9, 20)
            mem39 = 8
            save (vfx) {
                SetVFX2D()
                soundpitch(3.262)
                sounddecay(10.2s)
                soundplay([SBLEA], 0.64V)
            }
        }
        else if (level == LEVEL_BossNGin) {
            spawn(58, 6, 1, 1.0)
            save (vfx) {
                SetVFX2D()
                soundpitch(3.262)
                sounddecay(10.2s)
                soundplay([SBLEA], 0.64V)
            }
        }
        else if (level == LEVEL_BossTazTiger) {
            spawn(43, 6)
        }
        else if (level == LEVEL_HangEight || level == LEVEL_AirCrash || level == LEVEL_PlantFood) {
            GLOBAL_3 = 0
            soundpitch(5.805)
            soundsetup(FRUITDISPLAY, 5)
            soundsetup(0, 9)
            sounddecay(10.2s)
            soundplay([RbkRA], 0.1V)
        }
        else if (level == LEVEL_BearIt || level == LEVEL_BearDown || level == LEVEL_TotallyBear) {
            vfx = vfx & 0xFFFF00FF | 0xC00
            if (LEVEL == LEVEL_TotallyBear) {
                vfx = vfx & 0xFFFF00FF | 0x600
                spawn(48, 10, 1)
            }
            GLOBAL_3 = 0
            mem35 = 2
            mem34 = 11.0
        }
        else if (level == LEVEL_Unbearable || level == LEVEL_CrashDash || level == LEVEL_CrashCrush) {
            GLOBAL_3 = 0
            mem35 = -2
            mem34 = 10.0
        }
        else if (level == LEVEL_Intro) {
            GLOBAL_74 = 0
            spawn(50, 0)
            GLOBAL_126 = objectspawned
        }
        else if (level == LEVEL_BossCortex) {
            mem39 = 8
            ResetRespawnFields()
            changestate(Willy_Jetpack_Mount)
        }
        else if (level == LEVEL_SnowGo || level == LEVEL_ColdHardCrash || level == LEVEL_SnowBiz) {
            spawn(9, 28)
            vfx = vfx & 0xFFFF00FF | 0xC00
            BreathMode = 0
            spawn(9, 36, 1, 1.0)
        }
        else if (level == LEVEL_GameEnd) {
            statusb = 0
            sleepnull()
        }
        if (LEVEL != LEVEL_BossCortex) {
            entity = 0
            pathlen = 1.0
        }
        spawn(ShadC, ShadC_S_SHADOW, 1, 0, 1S, 0)
        GAMEFLAGS |= 0x800000
        changestate(Willy_Respawn)
    }
}

sub ResetMovement() {
    GAMEFLAGS = 0xC01FFFF
    statusb = (FLAG_ROT_Y | FLAG_PHYSICS_TEST | FLAG_GRAVITY | FLAG_PHYSICS_ENGINE | FLAG_DPAD_CONTROL | FLAG_NO_CAMERA_CLIP | FLAG_HAS_SHADOW | 0x2000)
    collider = 0
    moda = 0
    unless (statusa & 0x2000000) {
        SetVel(0m)
    }
    rotx = 0
    trotz = 0
    rotz = 0
    troty = roty
    trotx = 720deg
    yzapproach = 75deg
    field_60 = 4.0
    if (invincible == 6) {
        invincible = 0
        invincibletime = frametime
    }
    BreathMode = 0
}

sub RestoreAfterHit() {
    ResetMovement()
    BounceCombo = 0
    CheckInvincible()
}

sub CleanupSpin() {
    save (troty, vely) {
        ResetMovement()
    }
    roty = troty
}

sub StopAndRestoreControl() {
    unless (statusa & 0x2000000) {
        speed = 0
    }
    RestoreControl()
}

sub RestoreControl() {
    statusb |= FLAG_DPAD_CONTROL
    trotx = 720deg
    ResetStance()
}

sub ResetStance() {
    scalex = abs(scalex)
    field_60 = 4.0
}

sub UnusedRoutine() {}

sub PlayScriptedSpin() {
    statusc |= 0x1002
    SpinPulseTime = frametime
    statusb &= ~FLAG_ROT_Y
    if (scalex < 0S) {
        mem16 = 40deg
    }
    else {
        mem16 = -40deg
    }
    SoundSpinDefault()
    setanim(WILLY_SPIN)
    do (var i = 0) {
        roty += mem16
        playframe(loopseek(i, 9.0))
    } until (frametime - SpinPulseTime >= SpinDuration)
    roty = GAMEDIR
    troty = roty
    statusc &= ~0x1002
}

state Willy_Idle { // 1
    stateflag 0x5
    statusc 0x0
    trans => sub UpdateIdle
    code() {
        ResetCombos()
        if (animseq == getanim(WILLY_WALK)) {
            if (animframe >= 1.0 && animframe <= 3.0) {
                playanim(0, WILLY_WALK_STOP_1)
                playanim(1, WILLY_WALK_STOP_1)
            }
            else if (animframe >= 11.0 && animframe <= 13.0) {
                scalex = -scalex
                playanim(0, WILLY_WALK_STOP_1)
                playanim(1, WILLY_WALK_STOP_1)
                scalex = -scalex
            }
            else if (animframe >= 6.0 && animframe <= 7.0) {
                playanim(0, WILLY_WALK_STOP_2)
                playanim(1, WILLY_WALK_STOP_2)
            }
            else if (animframe >= 16.0 && animframe <= 17.0) {
                scalex = -scalex
                playanim(0, WILLY_WALK_STOP_2)
                playanim(1, WILLY_WALK_STOP_2)
                scalex = -scalex
            }
        }
        unless (LEVEL == LEVEL_WarpRoom 
            || LEVEL == LEVEL_BearIt
            || LEVEL == LEVEL_BearDown
            || LEVEL == LEVEL_TotallyBear
            || LEVEL == LEVEL_RockIt 
            || LEVEL == LEVEL_PackAttack
            || LEVEL == LEVEL_BossCortex) {
                if (getpayload(&[Ce10V], &[Cr10G], &[Ce30V], &[Cr10G]) + 2 <= getfreepages()) {
                    onstateexit(DeloadExtraAnims)
                    ExtraAnimGroup = 1.0
                    LoadAnim([Ce10V], [Cr10G])
                    LoadAnim([Ce30V], [Cr10G])
                }
            }
        setanim(WILLY_STAND_1)
        if (!hpc) {
            onstateexit(ResetBreath)
        }
        do (var i = 0) {
            playframes(0.0, 1.0)
            BreathMode = 2
            playframes(2.0, 4.0)
            BreathMode = 0
            playframes(5.0, 19.0)
        } while ({ i += 1.0 }; i < 4.0)
        playframes(0.0, 1.0)
        BreathMode = 2
        playframes(2.0, 4.0)
        BreathMode = 0
        playframes(5.0, 10.0)
        setanim(WILLY_STAND_2)
        playframes(0.0, 17.0)
        playframes(18.0, 27.0)
        BreathMode = 2
        playframes(28.0, 49.0)
        playframe(animframe, 7)
        BreathMode = 0
        playframes(50.0, 54.0)
        playframes(55.0, 69.0)
        statetime = frametime
        if (ExtraAnimGroup == 1.0) {
            DeloadExtraAnims()
        }
        do {
            if (!ExtraAnimGroup && frametime - statetime >= 5s) {
                if ((LEVEL == LEVEL_SnowGo || LEVEL == LEVEL_ColdHardCrash || LEVEL == LEVEL_SnowBiz) || GLOBAL_119 & 0x10) {
                    if (getpayload(&[CC10V], &[Cr10G]) + 2 <= getfreepages()) {
                        onstateexit(DeloadExtraAnims)
                        LoadAnim([CC10V], [Cr10G])
                        ExtraAnimGroup = 18.0
                    }
                }
                else {
                    if (getpayload(&[CC20V], &[Cr10G]) + 2 <= getfreepages()) {
                        onstateexit(DeloadExtraAnims)
                        LoadAnim([CC20V], [Cr10G])
                        ExtraAnimGroup = 19.0
                    }
                }
            }
            if (ExtraAnimGroup == 18.0, isloaded([CC10V]) && isloaded([Cr10G])) {
                playframes(WILLY_COLD, 0.0, 7.0)
                do {
                    var0 = 2s + rand(4s)
                    do (var start = frametime) {
                        playanim(8, WILLY_COLD)
                        playanim(9, WILLY_COLD)
                        playanim(10, WILLY_COLD)
                        playanim(9, WILLY_COLD)
                    } while (frametime - start < var0)
                    playframes(8.0, 17.0)
                    var0 = 4.0 + rand(6.0)
                    do (var blows = 0) {
                        BreathMode = 2
                        playframes(18.0, 26.0)
                        BreathMode = 0
                        playframesback(25.0, 19.0)
                    } while ({ blows += 1.0 }; blows < var0)
                    BreathMode = 2
                    playframes(18.0, 26.0)
                    BreathMode = 0
                    playframes(25.0, 33.0)
                } while (1)
            }
            else if (ExtraAnimGroup == 19.0, isloaded([CC20V]) && isloaded([Cr10G])) {
                playframes(WILLY_LOOK, 0.0, 6.0)
                do {
                    var0 = 1 + rand(24)
                    WaitFrame(7, WILLY_LOOK, var0)
                    playframes(8.0, 12.0)
                    var0 = 12 + rand(12)
                    WaitFrame(13, WILLY_LOOK, var0)
                    playframes(14.0, 18.0)
                    if (var0 & 1) {
                        scalex = -scalex
                        playframesback(24.0, 20.0)
                        playframe(animframe, 10)
                    }
                } while (1)
            }
            playanim(69, WILLY_STAND_2)
        } while (1)
    }
    event(e, a) {
        CrashEventCommon(e, a)
        accevcstate(Willy_Wade_Enter, e == Event18)
        accevcstate(Willy_Slip, e == Event57)
        unless (LEVEL == LEVEL_WarpRoom || LEVEL == LEVEL_BearIt || LEVEL == LEVEL_BearDown || LEVEL == LEVEL_TotallyBear || LEVEL == LEVEL_RockIt || LEVEL == LEVEL_PackAttack || LEVEL == LEVEL_BossCortex) {
            if (e == Event64 && ExtraAnimGroup == 1.0 && isloaded([Cr10G]) && isloaded([Ce30V]) && isloaded([Cr10G]) && isloaded([Ce10V])) {
                onstateexit(CleanupEdge)
                accevcstate(Willy_Edge)
            }
        }
        accevcstate(Willy_Jetpack_Mount, e == Event58)
    }
}

sub GroundEvent(e, a) {
    CrashEventCommon(e, a)
    accevcstate(Willy_Wade_Enter, e == Event18)
    accevcstate(Willy_Slip, e == Event57)
    accevcstate(Willy_Jetpack_Mount, e == Event58)
}

sub UpdateIdle() __trans {
    once {
        mem23 = 1.0
    }
    if (!!GLOBAL_17) {
        CheckJump(Willy_Jump_Start, 10.469m)
        CheckSpin()
        CheckSlide()
        changestateif(Willy_Move, abs(speed) & ~0x3)
    }
    changestateif(Willy_Ice_Idle, statusa & 0x2000000)
    CheckFall(Willy_Falling, Willy_Rise, 0.2s)
    if (DEBUG) {
        if (buttonhold(PAD_L2) && buttonpress(PAD_L1)) {
            invincible = 2
            invincibletime = frametime
        }
        sendeventif(Event6, creator, buttonhold(PAD_L2) && dirpress(PAD_N), self, -2)
    }
}

sub ResetBreath() {
    BreathMode = 0
}

sub CleanupEdge() {
    BreathMode = 0
    onstateexit(DeloadExtraAnims)
}

sub WillyPlayDance() {
    LoadAnim([CD20V], [Cr10G]) {
        ExtraAnimGroup = 16.0
        setanim(WILLY_DANCE_1, -1.0)
        do {
            animframe += 1.0
            if (animframe == 11.0 || animframe == 29.0) {
                soundpitch(3.12)
                sounddecay(3.2s)
                soundplay(SOUND_FOOTSTEP_DEFAULT, 0.3V)
            }
            if (animframe == 43.0 || animframe == 59.0) {
                soundpitch(2.446)
                sounddecay(3.2s)
                soundplay([DSw0A], 0.4V)
                sounddelay(3)
                soundpitch(3.263)
                sounddecay(3.2s)
                soundplay(SOUND_FOOTSTEP_DEFAULT, 0.6V)
            }
            if (animframe == 81.0) {
                soundpitch(3.446)
                sounddecay(3.2s)
                soundplay(SOUND_FOOTSTEP_DEFAULT, 0.15V)
                soundpitch(3.263)
                sounddecay(3.2s)
                soundplay([DSw0A], 0.6V)
                soundpitch(3.263)
                sounddelay(5)
                sounddecay(3.2s)
                soundplay([DSw0A], 0.6V)
            }
            playframe()
        } while (animframe + 1.0 <= 86.0)
        DeloadAnim([CD20V], [Cr10G])
        LoadAnim([CD30V], [Cr10G])
        ExtraAnimGroup = 17.0
        setanim(WILLY_DANCE_2, -1.0)
        do {
            animframe += 1.0
            if (animframe == 13.0) {
                soundpitch(3.262)
                sounddecay(3.2s)
                soundplay(SOUND_FOOTSTEP_DEFAULT, 0.15V)
            }
            if (animframe == 4.0 || animframe == 15.0 || animframe == 20.0 || animframe == 25.0) {
                soundpitch(3.265)
                sounddecay(3.2s)
                soundplay([DSw0A], 0.6V)
            }
            if (animframe == 35.0 || animframe == 48.0 || animframe == 56.0 || animframe == 64.0 || animframe == 73.0) {
                soundpitch(3.265)
                sounddecay(3.2s)
                soundplay(SOUND_FOOTSTEP_DEFAULT, 0.3V)
            }
            if (animframe == 84.0) {
                sounddelay(3)
                soundpitch(2.448)
                sounddecay(3.2s)
                soundplay([DSw0A], 0.6V)
            }
            playframe()
        } while (animframe + 1.0 <= 86.0)
        playanim(0, WILLY_DANCE_3)
        playanim(1, WILLY_DANCE_3, 14)
        playframes(WILLY_DANCE_3, 0.0, 8.0)
        roty += 180deg
        troty = roty
        DeloadExtraAnims()
    }
}

state Willy_Edge { // 2
    stateflag 0x400005
    statusc 0x400000
    event => sub GroundEvent
    trans => sub UpdateIdle
    code() {
        ResetCombos()
        if (animseq == getanim(WILLY_DUCK_START)) {
            playanim(0, WILLY_EDGE_2)
            playanim(1, WILLY_EDGE_2)
        }
        else if (animseq == getanim(WILLY_STAND_1)) {
            playframesback(WILLY_EDGE_3, 5.0, 0.0)
            playframes(WILLY_EDGE_1, 23.0, 39.0)
        }
        sleepframes(WILLY_EDGE_1, 0.0, 39.0)
    }
}

state Willy_Slip { // 3
    stateflag 0x5
    statusc 0x0
    code(yaw) {
        onstateexit(ResetMovement)
        trotx = 180deg
        troty = yaw + 180deg
        ResetCombos()
        playframes(WILLY_SLIP, 0.0, 8.0)
        sleep()
    }
    event(e, a) {
        CrashEventCommon(e, a)
        accevcstate(Willy_Wade_Enter, e == Event18)
        accevif (e == Event57) {
            troty = a[0] + 180deg
        }
    }
    trans {
        spawn(9, 1, 1, 0.0)
        spawn(9, 1, 1, 2.0)
        UpdateIdle()
    }
}

sub PlayMoveFrame() {
    if (dirhold(PAD_NONE) && ((animseq == getanim(WILLY_RUN) && (animframe == 6.0 || animframe == 14.0)) || animseq != getanim(WILLY_RUN))) {
        speed = 0
        setanimifn(WILLY_STAND_1, -1.0)
        playframe((animframe + 1.0) % 20.0)
    }
    else {
        setanimifn(WILLY_RUN, -1.0)
        playframe((animframe + 1.0) % 17.0)
    }
}

sub WillyPlayMovement(f) {
    ResetCombos()
    unless (animseq == getanim(WILLY_RUN) || animseq == getanim(WILLY_WALK)) {
        if (ANALOGAMT < 0xCC) {
            playanim(3, WILLY_WALK)
        }
        else {
            playanim(0, WILLY_RUN)
        }
    }
    do {
        if (animseq == getanim(WILLY_WALK)) {
            playframe((animframe + f) % 20.0)
            if (animframe == 9.0) {
                SoundFootstepDefault()
                if (ANALOGAMT > 0xF3) {
                    playanim(15, WILLY_RUN)
                }
            }
            else if (animframe == 0) {
                SoundPitchDefault(0.23)
                sounddecay(3.2s)
                soundplay(SOUND_FOOTSTEP_DEFAULT, 0.2V)
                if (ANALOGAMT > 0xF3) {
                    playanim(7, WILLY_RUN)
                }
            }
            else if (animframe == 3.0) {
                if (GLOBAL_119 & 0x800 && !(statusa & 0x2000000) && statusa & 0x40000) {
                    spawn(9, 37, 1, 0.2m, roty, abs(scalex) / 3)
                }
            }
            else if (animframe == 13.0) {
                if (GLOBAL_119 & 0x800 && !(statusa & 0x2000000) && statusa & 0x40000) {
                    spawn(9, 37, 1, -0.2m, roty, abs(scalex) / -3)
                }
            }
        }
        else {
            playframe((animframe + f) % 17.0)
            if (animframe == 8.0) {
                SoundFootstepDefault()
                if (ANALOGAMT < 0xC0 && ANALOGAMT > 51) {
                    playanim(10, WILLY_WALK)
                }
            }
            else if (animframe == 16.0) {
                SoundPitchDefault(0.23)
                sounddecay(3.2s)
                soundplay(SOUND_FOOTSTEP_DEFAULT, 0.3V)
                if (ANALOGAMT < 0xC0 && ANALOGAMT > 51) {
                    playanim(1, WILLY_WALK)
                }
            }
            else if (animframe == 1.0) {
                if (GLOBAL_119 & 0x800 && !(statusa & 0x2000000) && statusa & 0x40000) {
                    spawn(9, 37, 1, -0.2m, roty, abs(scalex) / -3)
                }
            }
            else if (animframe == 9.0) {
                if (GLOBAL_119 & 0x800 && !(statusa & 0x2000000) && statusa & 0x40000) {
                    spawn(9, 37, 1, 0.2m, roty, abs(scalex) / 3)
                }
            }
            else if ((LEVEL == LEVEL_CrashDash || LEVEL == LEVEL_CrashCrush || LEVEL == LEVEL_Unbearable) && !rand(3) && GLOBAL_126 && !(ZONEFLAGS & 0x800)) { // TODO: !rand(3) only present in some levels??
                interrupter = GLOBAL_126
                if (animframe == 3.0) {
                    playframes(WILLY_RUN_BOULDER, 0.0, 57.0)
                    setanim(WILLY_RUN, 10.0)
                }
                else if (animframe == 11.0) {
                    scalex = -scalex
                    playframes(WILLY_RUN_BOULDER, 0.0, 57.0)
                    scalex = -scalex
                    setanim(WILLY_RUN, 2.0)
                }
            }
        }
    } while (1)
}

state Willy_Move { // 4
    stateflag 0x5
    statusc 0x0
    trans => sub WillyUpdateMovement
    code() {
        onstateexit(ResetStance)
        WillyPlayMovement(1.0)
    }
    event(e, a) {
        CrashEventCommon(e, a)
        accevcstate(Willy_Boulder_Door, e == Event45 && (animseq == getanim(WILLY_RUN) || animseq == getanim(WILLY_ACCELERATE)) && (animframe == 1.0 || animframe == 9.0))
    }
}

sub MovementEvent(e, a) {
    CrashEventCommon(e, a)
}

sub WillyUpdateMovement() __trans {
    once {
        mem37 = 1.0
        mem38 = mem11
        mem23 = 1.0
    }
    if (statusa & 0x2000000) {
        changestateif(Willy_Ice_Move, (animseq == getanim(WILLY_RUN) && (animframe == 4.0 || animframe == 13.0))
            || (animseq == getanim(WILLY_WALK) && (animframe == 3.0 || animframe == 13.0))
            || !(animseq == getanim(WILLY_RUN) || animseq == getanim(WILLY_WALK)))
    }
    CheckJump(Willy_Jump_Run, 10.469m)
    CheckSpin()
    changestateif(Willy_Slide, buttonbuffer(PAD_CIRCLE | PAD_R1))
    if (dirhold(PAD_NONE)) {
        if ((animseq == getanim(WILLY_RUN) && (animframe == 6.0 || animframe == 14.0))
            || animseq == getanim(WILLY_RUN_BOULDER)
            || (animseq == getanim(WILLY_WALK) && (animframe == 3.0 || animframe == 13.0))) {
                speed = 0
                changestate(Willy_Idle)
            }
    }
    CheckFall(Willy_Falling, Willy_Rise, 0.2s)
    if (abs(speed) > 6m && y > GLOBAL_118 && STATUS_GROUNDLAND && !STATUS_FIRSTFRAME) {
        if (mem37) {
            mem37 = 0
            spawn(9, 1, 6, 0)
        }
        else {
            if (abs(degdist(mem38, mem11)) >= 60deg) {
                spawn(9, 1, 8, 0)
            }
        }
        mem38 = mem11
    }
}

#module [WileC]
#purge ehjtyBwrz
inline sub SoundIceSlide() {
    soundpitch((11.2 + rand(3.2)) * 0.43 >> 8)
    sounddecay(1.6s)
    soundplay([SSlGA], (0.04884V + (abs(speed) >> 9)) + (rand((abs(speed) >> 10) + 1)))
}

state Willy_Ice_Move { // 5
    stateflag 0x5
    statusc 0x0
    event => sub MovementEvent
    code() {
        ResetCombos()
        if (animseq == getanim(WILLY_RUN)) {
            if (animframe == 13.0) {
                scalex = -scalex
            }
            playanim(0, WILLY_ICE_6)
            playanim(1, WILLY_ICE_6)
            playframes(WILLY_ICE_4, 6.0, 9.0)
            scalex = -scalex
        }
        else if (animseq == getanim(WILLY_ICE_2)) {
            playanim(0, WILLY_ICE_7)
            playanim(1, WILLY_ICE_7)
            playanim(2, WILLY_ICE_7)
            playanim(3, WILLY_ICE_7)
            playanim(3, WILLY_ICE_7)
            playanim(4, WILLY_ICE_7)
            playframes(WILLY_ICE_4, 3.0, 9.0)
            scalex = -scalex
        }
        else if (animseq == getanim(WILLY_ICE_1)) {
            playanim(0, WILLY_ICE_9)
            playanim(1, WILLY_ICE_9)
            playanim(2, WILLY_ICE_9)
            playanim(3, WILLY_ICE_9)
            playanim(3, WILLY_ICE_9)
            playanim(4, WILLY_ICE_9)
            playframes(WILLY_ICE_4, 5.0, 9.0)
            scalex = -scalex
        }
        do {
            playanim(1, WILLY_ICE_4)
            if (statusa & 0x2000000) {
                if (scalex < 0) {
                    soundpitch((13.6 + rand(0.8)) * 0.43 >> 8)
                    sounddecay(1.6s)
                    soundplay([Sk1GA], 0.3V + rand(0.05V))
                }
                else {
                    soundpitch((12.0 + rand(0.8)) * 0.43 >> 8)
                    sounddecay(1.6s)
                    soundplay([Sk1GA], 0.3V + rand(0.05V))
                }
                if (abs(degdist(troty, atan(velx, velz))) > 90deg) {
                    if (!mem41) {
                        SoundIceSlide()
                        mem41 = voice
                        onstateexit(StopIceSlideSound)
                    }
                    voice = mem41
                    soundfadet(0.1s, voice)
                    soundfadev((0.04884V + (abs(speed) >> 9)) + (rand((abs(speed) >> 10) + 1)), voice, 2)
                    soundpitch(4.8 + rand(1.28), voice, 2)
                }
                else {
                    StopIceSlideSound()
                    hpc = 0
                }
            }
            playframes(WILLY_ICE_4, 1.0, 9.0)
            scalex = -scalex
        } while (1)
    }
    trans {
        once {
            onstateexit(StopIceSlideSound)
            mem23 = 1.0
        }
        if (statusa & 0x2000000) {
            statetime = frametime
        }
        else {
            changestateif(Willy_Move, frametime - statetime >= 0.1s)
        }
        CheckJump(Willy_Jump_Run, 10.469m)
        CheckSpinNoDig()
        changestateif(Willy_Slide, buttonbuffer(PAD_R1 | PAD_CIRCLE))
        if (dirhold(PAD_NONE) && ((animseq == getanim(WILLY_ICE_4) && animframe == 7.0) || animseq != getanim(WILLY_ICE_4))) {
            scalex = -scalex
            hpc = 0
            changestate(Willy_Ice_Idle)
        }
        CheckFall(Willy_Falling, Willy_Rise, 0.2s)
    }
}

state Willy_Ice_Idle { // 6
    stateflag 0x5
    statusc 0x0
    event => state Willy_Edge
    code() {
        ResetCombos()
        if (animseq == getanim(WILLY_ICE_4)) {
            if (!mem41) {
                SoundIceSlide()
                mem41 = voice
            }
            playanim(0, WILLY_ICE_8)
            playanim(1, WILLY_ICE_8)
            playanim(2, WILLY_ICE_8)
            playanim(3, WILLY_ICE_8)
            playanim(3, WILLY_ICE_8)
            playanim(4, WILLY_ICE_8)
            playanim(6, WILLY_ICE_1)
        }
        else if ((animseq == getanim(WILLY_ICE_5) || animseq == getanim(WILLY_DUCK_START)) && (abs(speed) & ~0xFF)) {
            playframesback(WILLY_ICE_3, 3.0, 0.0)
        }
        while (abs(speed) & ~0xFF && statusa & 0x2000000) {
            if (!mem41) {
                SoundIceSlide()
                mem41 = voice
            }
            playanimifn(WILLY_ICE_1, -1.0, 13.0)
            voice = mem41
            soundfadet(0.1s, voice)
            soundfadev((0.04884V + (abs(speed) >> 9)) + (rand((abs(speed) >> 10) + 1)), voice, 2)
            soundpitch(4.8 + rand(1.28), voice, 2)
        }
        StopIceSlideSound()
        hpc = 0
        if (animseq == getanim(WILLY_ICE_1)) {
            playanim(0, WILLY_ICE_3)
            playanim(1, WILLY_ICE_3)
            playanim(2, WILLY_ICE_3)
            playanim(2, WILLY_ICE_3)
        }
        do {
            if (!rand(60)) {
                playanim(1, WILLY_ICE_2)
            }
            else {
                playanim(0, WILLY_ICE_2)
            }
        } while (1)
    }
    trans {
        once {
            onstateexit(StopIceSlideSound)
            mem37 = 0
            mem23 = 1.0
        }
        if (!!GLOBAL_17) {
            CheckJump(Willy_Jump_Start, 10.469m)
            CheckSpinNoDig()
            CheckSlide()
            if (!dirhold(PAD_NONE)) {
                hpc = 0
                changestate(Willy_Ice_Move)
            }
            if (statusa & 0x2000000) {
                statetime = frametime
            }
            else {
                changestateif(Willy_Idle, frametime - statetime >= 0.1s && !(abs(speed) & ~0xff))
            }
        }
        CheckFall(Willy_Falling, Willy_Rise, 0.2s)
    }
}

sub StopIceSlideSound() {
    if (mem41) {
        voice = mem41
        soundfadet(0.1s, voice)
        soundfadev(0V, voice, 3)
        mem41 = 0
    }
}
#module default

#module [WilaC]
#purge adzu
state Willy_Wade { // 7
    stateflag 0x8800005
    statusc 0x0
    code() {
        ResetCombos()
        if (animseq == getanim(WILLY_WADE)) {
            playanim(1, WILLY_WADE_START)
            playanim(0, WILLY_WADE_START)
        }
        sleepframes(WILLY_WADE_IDLE, 0.0, 19.0)
    }
    event(e, a) {
        CrashEventCommon(e, a)
        rejevret(e == Event18)
    }
    trans {
        once {
            mem23 = 1.0
        }
        CheckJump(Willy_Jump_Start, 8.48528m)
        changestateif(Willy_Wade_Duck, buttonhold(PAD_R1 | PAD_CIRCLE) && (buttonbuffer(PAD_R1 | PAD_CIRCLE) || dirhold(PAD_NONE)))
        changestateif(Willy_Wade_Move, abs(speed) & ~0x3)
        SpinCooldownTime = frametime
    }
}

state Willy_Wade_Enter { // 8
    stateflag 0x8800005
    statusc 0x0
    event => state Willy_Wade
    trans => state Willy_Wade
    code() {
        ResetCombos()
        playanim(0, WILLY_WADE_IDLE_START)
        playanim(1, WILLY_WADE_IDLE_START)
        playanim(2, WILLY_WADE_IDLE_START)
        __Willy_Wade_Enter_CODE()
    }
}

state Willy_Wade_Move { // 9
    stateflag 0x8800005
    statusc 0x0
    event => state Willy_Wade
    code() {
        onstateexit(StopAndRestoreControl)
        if (animseq == getanim(WILLY_WADE_IDLE)) {
            playanim(0, WILLY_WADE_START)
            playanim(1, WILLY_WADE_START)
            playframes(WILLY_WADE, 9.0, 26.0)
        }
        do {
            SoundPitchDefault()
            sounddecay(3.2s)
            soundplay(SOUND_WADE_DEFAULT, 0.25V + rand(0.05V))
            sounddelay(0.5s)
            soundpitch((12.8 + rand(3.2)) * 0.205 >> 8)
            sounddecay(3.2s)
            soundplay(SOUND_WADE_DEFAULT, 0.25V + rand(0.05V))
            playframes(WILLY_WADE, 0.0, 26.0)
        } while (1)
    }
    trans {
        CheckJump(Willy_Jump_Run, 8.48528m)
        changestateif(Willy_Wade_Duck, buttonhold(PAD_R1 | PAD_CIRCLE) && (buttonbuffer(PAD_R1 | PAD_CIRCLE) || dirhold(PAD_NONE)))
        if (dirhold(PAD_NONE)) {
            if (animseq == getanim(WILLY_WADE) && (animframe >= 8.0 && animframe <= 11.0)) {
                speed = 0
                changestate(Willy_Wade)
            }
            if (animseq == getanim(WILLY_WADE) && (animframe >= 21.0 && animframe <= 24.0)) {
                speed = 0
                scalex = -scalex
                changestate(Willy_Wade)
            }
        }
        changestateif(Willy_Move, statusa & 0x1000000)
        SpinCooldownTime = frametime
    }
}

state Willy_Wade_Duck { // 10
    stateflag 0x8C00005
    statusc 0x0
    event => state Willy_Wade
    code() {
        onstateexit(StopAndRestoreControl)
        statusb &= ~FLAG_DPAD_CONTROL
        ResetSpeed()
        setanim(WILLY_DUCK_START, 0)
        do {
            if (buttonhold(PAD_CIRCLE | PAD_R1)) {
                playframe(seek(animframe, 4.0))
            }
            else {
                if (animseq == getanim(WILLY_DUCK_START) && animframe <= 2.0) {
                    changestateifn(Willy_Wade_Move, dirhold(PAD_NONE))
                }
                if (animframe == 0) {
                    changestate(Willy_Wade)
                }
                else {
                    playframe(seek(animframe, 0.0))
                }
            }
        } while (1)
    }
    trans {
        if (time(2) && FRAMETIME < 38 && LEVEL == LEVEL_SewerOrLater) {
            spawn(9, 9, 1, 0, x + randi(-0.4m, 0.4m), y + 5m, z + randi(-0.4m, 0.4m), 0.1S, 3.2, 1m)
        }
    }
}
#module default

#module [WildC]
#purge adz
inline sub CheckHangSpin() {
    if (buttonbuffer(PAD_SQUARE)) {
        if (frametime - SpinCooldownTime >= 0.7s) {
            soundpitch(3.625)
            sounddecay(6.4s)
            soundplay([spn0A], 0.4V)
            SpinPulseTime = frametime
            if (frametime - SpinCooldownTime >= SpinCooldownLimit) {
                SpinCooldownTime = frametime - (SpinCooldownLimit - 0.7s)
            }
            else {
                SpinCooldownTime += 0.7s
            }
            changestate(Willy_Hang_Spin)
        }
        else {
            SoundSpinBlocked()
        }
    }
}

inline sub CheckHangDuck() {
    unless (frametime - statetime >= 0.08s) {
        changestateif(Willy_Hang_Tuck, buttonbuffer(PAD_CIRCLE | PAD_R1))
    }
}

state Willy_Hang_Idle { // 11
    stateflag 0x800045
    statusc 0x0
    code() {
        ResetCombos()
        if (animseq == getanim(WILLY_HANG_1)) {
            if (animframe <= 1.0 || animframe >= 21.0) {
                playanim(0, WILLY_HANG_6)
                playanim(1, WILLY_HANG_6)
                playanim(2, WILLY_HANG_6)
            }
            else if (animframe <= 5.0) {
                playanim(0, WILLY_HANG_7)
                playanim(1, WILLY_HANG_7)
                playanim(2, WILLY_HANG_7)
            }
            else if (animframe <= 9.0) {
                playanim(0, WILLY_HANG_8)
                playanim(1, WILLY_HANG_8)
                playanim(2, WILLY_HANG_8)
            }
            else if (animframe <= 12.0) {
                scalex = -scalex
                playanim(0, WILLY_HANG_6)
                playanim(1, WILLY_HANG_6)
                playanim(2, WILLY_HANG_6)
                scalex = -scalex
            }
            else if (animframe <= 16.0) {
                scalex = -scalex
                playanim(0, WILLY_HANG_7)
                playanim(1, WILLY_HANG_7)
                playanim(2, WILLY_HANG_7)
                scalex = -scalex
            }
            else if (animframe <= 21.0) {
                scalex = -scalex
                playanim(0, WILLY_HANG_8)
                playanim(1, WILLY_HANG_8)
                playanim(2, WILLY_HANG_8)
                scalex = -scalex
            }
        }
        setanimifn(WILLY_HANG_IDLE, -1.0)
        do {
            animframe = (animframe + 1.0) % 25.0
            playframe()
        } while (1)
    }
    event(e, a) {
        CrashEventCommon(e, a)
        rejevif (e == Event51) {
            statetime = frametime
        }
        if (e == EventHit || e == Event14 || e == Event20 || e == Event35 || e == Event30 || e == Event31 || e == Event62 || e == Event74) {
            sendevent(EventHit, creator, a[0])
            if (eventaccepted) {
                CheckInvincible()
                accevret()
            }
        }
    }
    trans {
        once {
            statusb &= ~FLAG_GRAVITY
            mem23 = 1.0
        }
        changestateif(Willy_Hang_Drop, buttonpress(PAD_X) || statusa & 0x8000)
        CheckHangSpin()
        unless (buttonhold(PAD_X)) {
            changestateif(Willy_Hang_Tuck, buttonhold(PAD_R1 | PAD_CIRCLE))
        }
        changestateif(Willy_Hang_Move, abs(speed) & ~0x3)
        unless (frametime - statetime >= 0.1s) {
            vely = 4m
        }
    }
}

state Willy_Hang_Move { // 12
    stateflag 0x800045
    statusc 0x0
    event => state Willy_Hang_Idle
    code() {
        ResetCombos()
        playanim(0, WILLY_HANG_5)
        playanim(1, WILLY_HANG_5)
        playanim(2, WILLY_HANG_5)
        playanim(3, WILLY_HANG_5)
        soundpitch(1.997)
        sounddelay(2)
        soundplay([FGraA], 0.5V)
        playframes(WILLY_HANG_1, 8.0, 22.0)
        do {
            soundpitch(1.997)
            soundplay([FGraA], 0.5V)
            soundpitch(1.997)
            sounddelay(11)
            soundplay([FGraA], 0.5V)
            playframes(WILLY_HANG_1, 0.0, 22.0)
        } while (1)
    }
    trans {
        changestateif(Willy_Hang_Drop, buttonpress(PAD_X) || (frametime - statetime >= 0.16s) || (statusa & 0x8000))
        CheckHangSpin()
        CheckHangDuck()
        changestateifn(Willy_Hang_Idle, abs(speed) & ~0x3)
        if (frametime - statetime >= 0.3s) {
            changestateif(Willy_Hang_Idle, abs(x - mem25) + abs(z - mem27) < 0.2m)
        }
        unless (frametime - statetime >= 0.16s) {
            vely = 8m
        }
        mem25 = x
        mem27 = z
    }
}

state Willy_Hang_Spin { // 13
    stateflag 0x800045
    statusc 0x0
    code() {
        onstateexit(RestoreHangControl)
        statusb &= ~(FLAG_ROT_Y | FLAG_DPAD_CONTROL)
        ResetSpeed()
        setanim(WILLY_HANG_SPIN, 9.0)
        do { playframe((animframe + 1.0) % 10.0) } until (frametime - SpinPulseTime >= SpinDuration)
        changestate(Willy_Hang_Idle)
    }
    event(e, a) {
        rejevif (e == Event42) {
            sendevent(EventSpinHit, interrupter, 1)
        }
        rejevif (e == Event40) {
            save (interrupter) {
                interrupter = a[0]
                sendevent(EventSpinHit, interrupter, 1)
            }
        }
        rejevif (e == Event51) {
            statetime = frametime
        }
        rejevret(e == EventHit || e == Event14 || e == Event20 || e == Event35 || e == Event30 || e == Event31 || e == Event62 || e == Event74)
    }
    trans {
        sendevent(EventSpinHit, collider, AttackCombo)
        if (eventaccepted) {
            SoundAttackCombo()
            AttackCombo += 1.0
        }
        unless (frametime - statetime >= 0.2s) {
            vely = 10m
        }
    }
}

sub RestoreHangControl() {
    statusb |= (FLAG_DPAD_CONTROL | FLAG_ROT_Y)
}

state Willy_Hang_Tuck { // 14
    stateflag 0x45
    statusc 0x0
    event => state Willy_Hang_Idle
    code() {
        ResetCombos()
        ResetSpeed()
        onstateexit(RestoreHangInput)
        statusb &= ~FLAG_DPAD_CONTROL
        playanim(0, WILLY_HANG_TUCK)
        playanim(1, WILLY_HANG_TUCK)
        playanim(2, WILLY_HANG_TUCK)
        playanim(3, WILLY_HANG_TUCK)
        playanim(3, WILLY_HANG_TUCK)
        playanim(4, WILLY_HANG_TUCK)
        playanim(5, WILLY_HANG_TUCK)
        while (buttonhold(PAD_CIRCLE | PAD_R1)) { playframe() }
        playframesback(WILLY_HANG_TUCK, 6.0, 0.0)
        changestate(Willy_Hang_Idle)
    }
    trans {
        changestateif(Willy_Hang_Drop, buttonpress(PAD_X) || (frametime - statetime >= 0.2s) || (statusa & 0x8000))
        CheckHangSpin()
        unless (frametime - statetime >= 0.2s) {
            vely = 10m
        }
    }
}

sub RestoreHangInput() {
    statusb |= FLAG_DPAD_CONTROL 
}

state Willy_Hang_Drop { // 15
    stateflag 0x49
    statusc 0x800000
    code() {
        statusb |= FLAG_GRAVITY
        if (animseq == getanim(WILLY_HANG_IDLE)) {
            playanim(0, WILLY_HANG_2)
            playanim(1, WILLY_HANG_2)
            playanim(2, WILLY_HANG_2)
        }
        else if (animseq == getanim(WILLY_HANG_1) && (animframe <= 2.0 || animframe >= 14.0)) {
            playframesback(WILLY_HANG_3, 2.0, 0.0)
        }
        else if (animseq == getanim(WILLY_HANG_1) && (animframe >= 9.0 && animframe <= 14.0)) {
            scalex = -abs(scalex)
            onstateexit(ResetHangMirror)
            playframesback(WILLY_HANG_3, 2.0, 0.0)
            scalex = abs(scalex)
        }
        else if (animseq == getanim(WILLY_HANG_1) && (animframe >= 15.0 && animframe <= 20.0)) {
            scalex = -abs(scalex)
            onstateexit(ResetHangMirror)
            playframesback(WILLY_HANG_4, 2.0, 0.0)
            scalex = abs(scalex)
        }
        else {
            playframesback(WILLY_HANG_4, 2.0, 0.0)
        }
        changestate(Willy_Falling)
    }
}

sub ResetHangMirror() {
    scalex = abs(scalex)
}
#module default

sub RecordEventTime() {
    mem12 = frametime
}

state Willy_Duck { // 16
    stateflag 0x5
    statusc 0x0
    __transargs
    event => sub MovementEvent
    code(ready) {
        do {
            if (!rand(60)) {
                playanim(0, WILLY_DUCK, 2)
            }
            else {
                playanim(4, WILLY_DUCK_START)
            }
        } while (1)
    }
    trans {
        once {
            onstateexit(StopAndRestoreControl)
            statusb &= ~FLAG_DPAD_CONTROL
        }
        unless (statusa & 0x2000000) {
            ResetSpeed()
        }
        CheckHighJump()
        if (buttonhold(PAD_CIRCLE | PAD_R1) || (mem38 && !(frametime - statetime >= 0.08s))) {
            changestateif(Willy_Crawl, !dirhold(PAD_NONE) && (frametime - statetime >= 0.2s || ready) && !(statusa & 0x2000000))
        }
        else {
            hpc = 0
            changestate(Willy_Duck_Transition, 0)
        }
        CheckFall(Willy_Falling, Willy_Rise, 0.2s)
    }
}

state Willy_Duck_Transition { // 17
    stateflag 0x5
    statusc 0x0
    event => sub MovementEvent
    code(duck) {
        onstateexit(StopAndRestoreControl)
        statusb &= ~FLAG_DPAD_CONTROL
        unless (statusa & 0x2000000) {
            ResetSpeed()
        }
        SoundPitchDefault()
        sounddecay(2.56s)
        soundplay([jmp0A], 0.07V)
        if (animseq == getanim(WILLY_EDGE_1)) {
            duck = 0
            playframesback(WILLY_EDGE_2, 1.0, 0.0)
        }
        setanim(WILLY_DUCK_START)
        mem38 = 0
        if (duck) {
            animframe = 0
        }
        else {
            animframe = 4.0
        }
        do {
            start :
            if (buttonhold(PAD_CIRCLE | PAD_R1) || (mem38 && !(statusa & 0x100000) && !(statusa & 0x2000000))) {
                if (animseq == getanim(WILLY_DUCK_START) && animframe >= 3.0) {
                    changestateifn(Willy_Crawl, dirhold(PAD_NONE) || statusa & 0x2000000)
                }
                if (animframe == 4.0) {
                    break
                }
                else {
                    playframe(seek(animframe, 4.0))
                }
            }
            else {
                if (statusa & 0x80 && !(statusa & 0x100000) && !(statusa & 0x2000000)) {
                    mem38 = 1.0
                    goto start
                }
                if (animseq == getanim(WILLY_DUCK_START) && animframe <= 2.0) {
                    changestateifn(Willy_Move, dirhold(PAD_NONE))
                }
                if (animframe == 0) {
                    changestate(Willy_Idle)
                }
                else {
                    playframe(seek(animframe, 0.0))
                }
            }
        } while (1)
        hpc = 0
        changestate(Willy_Duck, 1.0)
    }
    trans {
        CheckHighJump()
        CheckFall(Willy_Falling, Willy_Rise, 0.2s)
    }
}

sub CheckHighJump() {
    changestateif(Willy_Jump_High, (buttonbuffer(PAD_X) && (!(statusa & 0x80) || statusa & 0x100000)) && (!(statusa & 0x80) && !mem38), 14.20141m)
}
     
state Willy_Crawl { // 18
    stateflag 0xA00005
    statusc 0x0
    event => sub MovementEvent
    code() {
        playanim(0, WILLY_CRAWL_START)
        playanim(1, WILLY_CRAWL_START)
        playanim(1, WILLY_CRAWL_START)
        setanim(WILLY_CRAWL, 15.0)
        do {
            animframe = (animframe + 1.0) % 16.0
            playframe()
            if (animframe == 15.0) {
                scalex = -scalex
            }
        } until (mem37 || (animseq == getanim(WILLY_CRAWL) && animframe <= 3.0) && dirhold(PAD_NONE))
        playframesback(WILLY_CRAWL_START, 2.0, 0.0)
        changestate(Willy_Duck_Transition, 0)
    }
    trans {
        once {
            onstateexit(StopAndRestoreControl)
            trotx = 180deg
            mem37 = 0
        }
        CheckHighJump()
        if ((!buttonhold(PAD_R1 | PAD_CIRCLE) && !(statusa & 0x80)) || statusa & 0x2000000) {
            mem37 = 1.0
        }
        CheckFall(Willy_Falling, Willy_Rise, 0.2s)
    }
}

state Willy_Slide { // 19
    stateflag 0x200005
    statusc 0x2
    event => sub MovementEvent
    code() {
        SoundPitchDefault()
        sounddecay(3.2s)
        soundplay([Sld0A], 0.2V + rand(0.05V))
        playanim(0, WILLY_SLIDE)
        playanim(1, WILLY_SLIDE)
        playanim(2, WILLY_SLIDE)
        playanim(3, WILLY_SLIDE)
        playanim(4, WILLY_SLIDE)
        playanim(4, WILLY_SLIDE)
        playanim(5, WILLY_SLIDE)
        playanim(6, WILLY_SLIDE)
        until (STATUS_GROUNDLAND) { playframe() }
        spawn(9, 2, 1, -1.0, 5.0, 4m)
        hpc = 0
        mem38 = 0
        changestate(Willy_Duck, 1.0)
    }
    trans {
        once {
            if (!rand(2)) {
                scalex = -scalex
            }
            changestateif(Willy_Duck_Transition, dirhold(PAD_NONE), 1.0)
            onstateexit(StopAndRestoreControl)
            roty = troty
            unless (frametime - statetime >= 0.2s) {
                speed += 11m
                if (speed > 18m) {
                    speed = 18m
                }
                setvel(speed)
            }
        }
        unless (statusa & 0x80) {
            if (buttonbuffer(PAD_SQUARE)) {
                if (frametime - SpinCooldownTime >= 0.7s) {
                    hpc = 0
                    SoundSpinDefault()
                    SpinPulseTime = frametime
                    if (frametime - SpinCooldownTime >= SpinCooldownLimit) {
                        SpinCooldownTime = frametime - (SpinCooldownLimit - 0.68s)
                    }
                    else {
                        SpinCooldownTime += 0.68s
                    }
                    changestate(Willy_Slide_Spin)
                }
                else {
                    SoundSpinBlocked()
                }
            }
            if ((buttonbuffer(PAD_X) && (!(statusa & 0x80) || statusa & 0x100000)) && !(frametime - groundtime >= 0.2s)) {
                onstateexit(RestoreControl)
                changestate(Willy_Jump_High, 14.20141m)
            }
        }
        sendevent(EventSlideHit, collider, AttackCombo)
        if (eventaccepted) {
            SoundAttackCombo()
            AttackCombo += 1.0
        }
        if (FRAMETIME < 36) {
            spawn(9, 1, 2, 0)
        }
    }
}

state Willy_Slam { // 20
    stateflag 0x200009
    statusc 0x40
    __transargs
    event => sub AirborneEvent
    code(vy, reset, arg) {
        if (!rand(2)) {
            scalex = -scalex
        }
        if (animseq == getanim(WILLY_JUMP_FLIP) && animframe >= 1.0 && animframe <= 3.0) {
            playanim(0, WILLY_FACE_SLAM_2)
            playanim(1, WILLY_FACE_SLAM_2)
            playanim(1, WILLY_FACE_SLAM_2)
        }
        else if (animseq == getanim(WILLY_JUMP_FLIP) && animframe <= 6.0) {
            playanim(0, WILLY_FACE_SLAM_3)
            playanim(1, WILLY_FACE_SLAM_3)
            playanim(1, WILLY_FACE_SLAM_3)
        }
        else if (animseq == getanim(WILLY_JUMP_FLIP) && animframe <= 9.0) {
            playanim(0, WILLY_FACE_SLAM_4)
            playanim(1, WILLY_FACE_SLAM_4)
            playanim(1, WILLY_FACE_SLAM_4)
        }
        else {
            playanim(0, WILLY_FACE_SLAM_5)
            playanim(1, WILLY_FACE_SLAM_5)
            playanim(1, WILLY_FACE_SLAM_5)
        }
        sleepanim(0, WILLY_FACE_SLAM_1)
    }
    trans {
        once {
            onstateexit(StopAndRestoreControl)
            vely = vy
            roty = troty
            if (reset) {
                ResetSpeed()
            }
        }
        if (vely <= 0) {
            broadcastevent(EventSlamHit, 1, 100)
            if (eventaccepted) {
                SoundSlamBounce(4.8)
                return
            }
        }
        if (STATUS_GROUNDLAND) {
            hpc = 0
            changestate(Willy_Slam_Land, arg)
        }
    }
}

state Willy_Slam_Land { // 21
    stateflag 0x200005
    statusc 0x40
    code(len) {
        playframes(WILLY_FACE_SLAM_1, 1.0, 4.0)
        WaitFrame(len)
        playframes(WILLY_FACE_SLAM_RECOVER, 0.0, 12.0)
        changestate(Willy_Idle)
    }
    event(e,a) {
        rejevret(e == Event47)
    }
    trans {
        once {
            onstateexit(StopAndRestoreControl)
            if (!SHAKEY) {
                SHAKEY = 3.0
            }
            if (groundvel < -10m && y > GLOBAL_118) {
                spawn(9, 2, 1, -1.0, 7.0, groundvel + 8m)
            }
            if (collider, vely <= 0, statusa & 0x4000) {
                unless (statusa & 0x40000) {
                    sendevent(EventJumpedOn, collider, 100)
                    changestateif(Willy_Bounce, eventaccepted)
                }
            }
            ResetCombos()
            soundpitch((10.56 + rand(3.2)) * 0.23 >> 8)
            sounddecay(5.76s)
            soundplay(SOUND_LAND_DEFAULT, 1.0V)
            ResetSpeed()
            statusb &= ~FLAG_DPAD_CONTROL
        }
        if (statusa \ 0x2040000) {
            stateflag &= ~0x200000
        }
        if (!(frametime - statetime >= 0.08s)) {
            broadcastevent(Event46, 1, 100)
            if (eventaccepted) {
                SoundSlamBounce(4.8)
            }
        }
        CheckFall(Willy_Falling, Willy_Rise, 0.32s)
    }
}

state Willy_Slide_Spin { // 22
    stateflag 0x200091
    statusc 0x2
    code => state Willy_Spin
    event => state Willy_Spin
    trans => state Willy_Spin
}

sub PlayJumpStart(vy) {
    SoundJumpDefault()
    vely = vy
    onstateexit(ResetStance)
    statusc &= ~0x3
    if (animseq == getanim(WILLY_EDGE_1)) {
        playanim(0, WILLY_EDGE_4)
        playanim(1, WILLY_EDGE_4)
        setanim(WILLY_JUMP_START)
    }
    else {
        playframes(WILLY_JUMP_START, 0.0, 2.0)
    }
    statusc &= ~0x400000
    field_60 = -91.0
    playframe(3.0)
    HoldAirborneFrame(-91.0)
}

state Willy_Jump_Start { // 23
    stateflag 0x9
    statusc 0x400001
    code => sub PlayJumpStart
    trans => sub UpdateJumpStart
}

sub UpdateJumpStart() {
    UpdateJumpCommon()
    unless (dirhold(PAD_NONE)) {
        settrans(UpdateJumpFlip)
    }
    changestateif(Willy_Jump_Up, vely < 11m)
}

sub UpdateJumpUpright() {
    UpdateJumpCommon()
    changestateif(Willy_Jump_Up, vely < 11m)
}

sub UpdateJumpFlip() {
    UpdateJumpCommon()
    changestateif(Willy_Jump_Flip, vely < 11m)
}

sub UpdateJumpCommon() {
    if (buttonbuffer(PAD_SQUARE)) {
        if (frametime - SpinCooldownTime >= 0.68s) {
            changestate(Willy_Spin_Air_Start)
        }
        else {
            SoundSpinBlocked()
        }
    }
    changestateif(Willy_Slam, buttonbuffer(PAD_CIRCLE | PAD_R1) && (vely < 6m && vely > -6m), 8.94427m, 1, 10, 0)
    changestateif(Willy_Land, STATUS_GROUNDLAND)
    if (buttonhold(PAD_X) && (!(statusa & 0x80) || statusa & 0x100000)) {
        if (vely > 0m) {
            vely = spd(vely, 14m)
        }
        else {
            vely = spd(vely, 7m)
        }
    }
    unless ((buttonhold(PAD_X) && (!(statusa & 0x80) || statusa & 0x100000)) || vely > 10m || stateflag & 0x1000000) {
        settrans(UpdateJumpUpright)
    }
}

state Willy_Jump_High { // 24
    stateflag 0x9
    statusc 0x1
    code(vy) {
        SoundJumpDefault()
        if (statusa & 0x2000000) {
            speed = 7m
        }
        vely = vy
        onstateexit(ResetStance)
        statusc &= ~0x3
        playframes(WILLY_JUMP_HIGH, 0.0, 3.0)
        statusc &= ~0x400000
        setevent(AirborneEvent)
        playanim(3, WILLY_JUMP_HIGH, 2)
        setevent(AirborneEvent)
        while (vely >= 11m) {
            playanim(3, WILLY_JUMP_HIGH)
        }
        playframes(4.0, 17.0)
        sleepanim(13, WILLY_JUMP_FLIP)
    }
    trans {
        if (buttonbuffer(PAD_SQUARE)) {
            if (frametime - SpinCooldownTime >= 0.68s) {
                changestate(Willy_Spin_Air_Start)
            }
            else {
                SoundSpinBlocked()
            }
        }
        changestateif(Willy_Land, STATUS_GROUNDLAND)
        if (buttonhold(PAD_X) && (!(statusa & 0x80) || statusa & 0x100000)) {
            vely = spd(vely, 8m)
        }
        if (collider, vely <= 0) {
            sendevent(EventJumpedOn, collider, BounceCombo)
            if (eventaccepted) {
                BounceCombo += 1.0
                changestate(Willy_Bounce)
            }
        }
    }
}

state Willy_Jump_Run { // 25
    stateflag 0x9
    statusc 0x400001
    trans => sub UpdateJumpStart
    code(vy) {
        SoundJumpDefault()
        vely = vy
        onstateexit(ResetStance)
        statusc &= ~0x3
        if (animseq == getanim(WILLY_RUN)) {
            if (animframe <= 1.0 || animframe == 16.0) {
                playanim(0, WILLY_JUMP_RUN_1)
                playanim(1, WILLY_JUMP_RUN_1)
                playanim(1, WILLY_JUMP_RUN_1)
            }
            else if (animframe == 2.0 || animframe == 15.0) {
                playanim(1, WILLY_JUMP_RUN_1)
                playanim(2, WILLY_JUMP_RUN_1)
            }
            else if (animframe <= 6.0) {
                playanim(0, WILLY_JUMP_RUN_2)
                playanim(1, WILLY_JUMP_RUN_2)
            }
            else if (animframe == 7.0 || animframe == 10.0) {
                scalex = -abs(scalex)
                playanim(1, WILLY_JUMP_RUN_1)
                playanim(2, WILLY_JUMP_RUN_1)
            }
            else if (animframe <= 9.0) {
                scalex = -abs(scalex)
                playanim(0, WILLY_JUMP_RUN_1)
                playanim(1, WILLY_JUMP_RUN_1)
                playanim(1, WILLY_JUMP_RUN_1)
            }
            else if (animframe <= 14.0) {
                scalex = -abs(scalex)
                playanim(0, WILLY_JUMP_RUN_2)
                playanim(1, WILLY_JUMP_RUN_2)
            }
        }
        else {
            playanim(0, WILLY_JUMP_RUN_1)
            playanim(1, WILLY_JUMP_RUN_1)
            playanim(1, WILLY_JUMP_RUN_1)
        }
        scalex = abs(scalex)
        statusc &= ~0x400000
        HoldJumpStartFrame()
    }
}


state Willy_Jump_Up { // 26
    stateflag 0x400009
    statusc 0x0
    event => sub AirborneEvent
    trans => sub UpdateAirborne
