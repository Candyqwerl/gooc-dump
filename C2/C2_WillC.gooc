        statusb &= ~FLAG_DPAD_CONTROL
        ResetSpeed()
        var0 = 0
        animframe = 0
        setanim(WILLY_WARP_BROADCAST_1, -1.0)
        do {
            animframe += 1.0
            if (var0) { goto next }
            playframe()
        } while (animframe + 1.0 <= 24.0)
        do {
            playanim(0, WILLY_WARP_BROADCAST_2)
            if (var0) {
                next :
                setanimifn(WILLY_WARP_BROADCAST_1, 24.0)
                playframesback(WILLY_WARP_BROADCAST_1, 4.0, animframe, 0.0)
                changestate(Willy_Idle)
            }
            if (!rand(100)) {
                playframes(WILLY_WARP_BROADCAST_2, 1.0, 7.0)
                do (var i = 0) {
                    playanim(8, WILLY_WARP_BROADCAST_2)
                    playanim(9, WILLY_WARP_BROADCAST_2)
                    playanim(10, WILLY_WARP_BROADCAST_2)
                    playanim(11, WILLY_WARP_BROADCAST_2)
                    playanim(10, WILLY_WARP_BROADCAST_2)
                    playanim(9, WILLY_WARP_BROADCAST_2)
                } while ({ i += 1.0 }; i < 4.0)
                playframesback(8.0, 1.0)
            }
        } while (1)
    }
    event(e, a) {
        accevif (e == Event21) {
            var0 = true
        }
    }
}

